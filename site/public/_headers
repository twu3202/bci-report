# Response headers for Cloudflare Workers Static Assets. Parsed by the host and
# never served as a file itself.
#
# Forcing HTTPS is NOT done here, and cannot be: Cloudflare's redirects file
# matches on path only, and lists domain-level redirects as unsupported (a
# `_redirects` rule was tried and removed). It is a zone setting (SSL/TLS ->
# Edge Certificates -> Always Use HTTPS), outside this file and the deploy
# token. Plain http:// used to answer 200; on 2026-10-02 it answers 301 to
# https://. The HSTS header below only protects visitors who have already
# arrived over HTTPS once.
#
# The policy is as tight as it is because the site earns it: no third-party
# script, style, font or beacon, no inline <script>, no inline event handler, no
# style="" attribute, and — via build.inlineStylesheets:'never' in
# astro.config.mjs — no inline <style> block either. So every source can be
# 'self' and nothing needs 'unsafe-inline'. Re-check this if that ever changes.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Content-hashed filenames, so the bytes behind a given URL never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Markdown copies and the llms.txt files carry Chinese as well as English. The
# host serves text/* without a charset, which leaves decoding to guesswork, so
# declare UTF-8 explicitly.
/*.md
  Content-Type: text/markdown; charset=utf-8
/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
/releases.xml
  Content-Type: application/atom+xml; charset=utf-8

# The data API (/api/) promises "no key, no account", which a browser notebook
# (Observable, JupyterLite, a page on another site) could not use while every
# response said Cross-Origin-Resource-Policy: same-origin and none sent
# Access-Control-Allow-Origin. The downloads are public, cookie-free static
# files, so any origin may read them. Only /data/*: the pages keep the
# same-origin policy above. `! Header` detaches the broader rule's value first
# (headers from several matching rules are otherwise joined into one, and
# "same-origin, cross-origin" is no policy at all).
/data/*
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
  Access-Control-Allow-Origin: *
