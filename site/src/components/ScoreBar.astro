---
interface Props { value: number; label: string; max?: number; tone?: 'rust' | 'olive' | 'ink' }
const { value, label, max = 1, tone = 'rust' } = Astro.props;
const width = Math.max(0, Math.min(100, value / max * 100));
---
<svg class={`score-bar-svg ${tone}`} viewBox="0 0 100 7" preserveAspectRatio="none" aria-hidden="true"><rect class="track" x="0" y="0" width="100" height="7"></rect><rect class="fill" x="0" y="0" width={width.toFixed(3)} height="7"></rect></svg>
<span class="visually-hidden">{label}</span>
