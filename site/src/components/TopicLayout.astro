---
import { site } from '../data/site';
import { topicGroups, topicPages, topicsIn } from '../data/topics';
import { breadcrumbList, topicDataset, topicFaq, topicFiles } from '../data/structured';
import { answerParts } from '../data/answer';
import { topicEntities } from '../data/entities';
import { alternates, chrome, hrefFor, htmlLang, localizePath, ogLocale, questionPhrases, topicCards, topicChrome,
         topicGroupLabels, type Locale } from '../data/i18n';
import SiteHeader from './SiteHeader.astro';
import AgentLinks from './AgentLinks.astro';
import ShareImage from './ShareImage.astro';
import CiteMeta from './CiteMeta.astro';
import CitePage from './CitePage.astro';
import FooterElsewhere from './FooterElsewhere.astro';
import '../styles/global.css';
import '../styles/topics.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path without a locale prefix, e.g. `/topics/on-the-move/`. */
  path: string;
  eyebrow: string;
  dek: string;
  activeSlug: typeof topicPages[number]['slug'];
  /** The reviewed export holding this page's figures; the first is the hero download. */
  dataFiles?: string[];
  /** A fuller <title> and share title than the h1, when the page has two parts. */
  documentTitle?: string;
  /**
   * The short answer to the page's question, figures marked [[…]] (see
   * src/data/answer.ts). Two or three sentences: the figure, the cohort, the
   * caveat that bounds it.
   */
  answer?: string;
}
const { locale, title, description, path, eyebrow, dek, activeSlug,
        dataFiles = ['/data/deployment-topics.json'], documentTitle, answer } = Astro.props;
const t = chrome[locale];
const c = topicChrome[locale];
// The h1 is the question as someone would ask it; `title` stays the short label
// the breadcrumb, the cards and the Dataset name use.
const question = topicCards[locale][activeSlug].question;
// The same question, with the phrase breaks a Chinese heading needs on a phone.
const phrases = questionPhrases(activeSlug, locale);
const pageTitle = `${documentTitle ?? question} · ${site.name}`;
const origin = Astro.site ?? site.origin;
const canonical = new URL(localizePath(path, locale), origin).href;
const links = alternates(path, String(origin));
// Every reviewed export the page's figures come from; the cite block names their releases.
const citeFiles = topicFiles(activeSlug);
// The dataset and method pages whose figures this page prints (entities.ts):
// derived from the same served files the cite block names, including core-matrix
// rows reached through a protocol (the idle table on when-not-to-act). Until
// 2026-10-02 no topic linked to any of them, so the links ran one way.
const drawsOn = topicEntities(activeSlug, citeFiles);
const nameLang = locale === 'zh' ? 'en' : undefined;
const labelGap = locale === 'zh' ? '' : ' ';
// One Dataset entity per dataset, on the English canonical. The Chinese page is
// the same data; a second entry would be a duplicate to Dataset Search, and
// hreflang already tells crawlers the two pages are one resource.
// One graph: the Dataset the page measures, the question it answers, and the
// breadcrumb the page prints (Home / Questions / this topic).
const { '@context': _context, ...datasetNode } = topicDataset(activeSlug, title, description, path);
const { '@context': _crumbContext, ...crumbNode } = breadcrumbList([
  { name: topicChrome.en.home, path: '/' }, { name: topicChrome.en.questions, path: '/topics/' }, { name: title, path },
]);
const structured = locale === 'en'
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': [
      datasetNode,
      ...(answer ? [topicFaq(question, answer, path)] : []),
      crumbNode,
    ] })
  : null;
---
<!doctype html>
<html lang={htmlLang[locale]}>
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="description" content={description}/>
  <meta name="theme-color" content="#b3450e"/>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
  <link rel="icon" href="/favicon.ico" sizes="32x32"/>
  <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
  <link rel="canonical" href={canonical}/>
  <AgentLinks href={localizePath(path, locale)}/>
  {links.map(l => <link rel="alternate" hreflang={l.hreflang} href={l.href}/>)}
  <title>{pageTitle}</title>
  <meta property="og:type" content="article"/>
  <meta property="og:site_name" content={site.name}/>
  <meta property="og:locale" content={ogLocale[locale]}/>
  <meta property="og:title" content={pageTitle}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical}/>
  <ShareImage locale={locale}/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={pageTitle}/>
  <meta name="twitter:description" content={description}/>
  <CiteMeta locale={locale} title={question} canonical={canonical} files={citeFiles}/>
  {structured && <script type="application/ld+json" set:html={structured}/>}
</head>
<body>
  <a class="skip" href="#topic-content">{t.skipToEvidence}</a>
  <SiteHeader locale={locale} path={path} active="topics" />
  <main class="topic-page" id="topic-content">
    <nav class="breadcrumbs" aria-label={c.breadcrumb}><ol><li><a href={hrefFor('/', locale)}>{c.home}</a></li><li><a href={hrefFor('/topics/', locale)}>{c.questions}</a></li><li aria-current="page">{title}</li></ol></nav>
    <section class="topic-hero">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{phrases.map((p, i) => <>{i > 0 && <wbr/>}{p}</>)}</h1>
      <p class="topic-dek">{dek}</p>
      <div class="topic-actions"><a class="button primary" href={dataFiles[0]} download>{c.reviewedJson}</a><a class="button" href="#methods-and-limits">{c.methodsLimits}</a></div>
    </section>
    {(drawsOn.datasets.length > 0 || drawsOn.methods.length > 0) && <p class="topic-entities">
      {drawsOn.datasets.length > 0 && <><span class="topic-entities-label">{c.measuredOn}</span>{labelGap}{drawsOn.datasets.map((d, i) => <>{i > 0 && c.listSep}<a href={hrefFor(`/datasets/${d.slug}/`, locale)} lang={nameLang}>{d.name}</a></>)}</>}
      {drawsOn.datasets.length > 0 && drawsOn.methods.length > 0 && ' · '}
      {drawsOn.methods.length > 0 && <><span class="topic-entities-label">{c.methodsUsed}</span>{labelGap}{drawsOn.methods.map((m, i) => <>{i > 0 && c.listSep}<a href={hrefFor(`/methods/${m.slug}/`, locale)} lang={nameLang}>{m.name}</a></>)}</>}
    </p>}
    {answer && <section class="short-answer" aria-labelledby="short-answer-heading">
      <h2 id="short-answer-heading">{c.shortAnswer}</h2>
      <p>{answerParts(answer).map(p => p.fig ? <strong class="fig">{p.text}</strong> : p.text)}</p>
    </section>}
    <slot />
    <nav class="topic-switcher" aria-label={c.exploreNav}>
      <p class="eyebrow">{c.keepExploring}</p>
      <div class="switcher-groups">{topicGroups.map(group => <div class="switcher-group"><p>{topicGroupLabels[locale][group].title}</p><div>{topicsIn(group).map(topic => <a href={hrefFor(`/topics/${topic.slug}/`, locale)} aria-current={topic.slug === activeSlug ? 'page' : undefined}><small>{topicCards[locale][topic.slug].kicker}</small><strong>{topicCards[locale][topic.slug].title}</strong></a>)}</div></div>)}</div>
      <p class="citation-note"><a href={hrefFor('/topics/', locale)}>{c.allQuestions}</a></p>
    </nav>
    <CitePage locale={locale} title={question} canonical={canonical} files={citeFiles} upstream="page"/>
  </main>
  <footer><a class="brand" href={hrefFor('/', locale)}>{site.name}</a><p>{t.footerTagline}</p><a href={dataFiles[0]} download>{t.downloadData}</a><a href={hrefFor('/releases/', locale)}>{t.footerReleases}</a><a href="/data-use/">{t.footerDataUse}{t.englishMark}</a><a href="#topic-content">{t.footerTop}</a><FooterElsewhere locale={locale}/></footer>
</body>
</html>
