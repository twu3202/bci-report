---
/**
 * Highwire `citation_*` tags, which Zotero and Google Scholar read from a
 * page's <head> (Zotero ignores Open Graph and JSON-LD for this). Without them
 * "Save to Zotero" on a topic page gave a bare web page with no date and no
 * release. The date is that of the newest release whose files hold the page's
 * figures — the same release the "Cite this page" block names.
 */
import { site } from '../data/site';
import { releasesFor } from '../data/releases';
import { htmlLang, type Locale } from '../data/i18n';

interface Props {
  locale: Locale;
  /** The page's h1, which is what a reader would cite it by. */
  title: string;
  canonical: string;
  /** Served files the page's figures come from (see releasesFor). */
  files: string[];
}
const { locale, title, canonical, files } = Astro.props;
const date = releasesFor(files)[0].date.replaceAll('-', '/');
---
<meta name="citation_title" content={title}/>
<meta name="citation_author" content={site.name}/>
<meta name="citation_publication_date" content={date}/>
<meta name="citation_online_date" content={date}/>
<meta name="citation_public_url" content={canonical}/>
<meta name="citation_language" content={htmlLang[locale]}/>
