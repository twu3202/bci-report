interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const pc = protocolCopy[locale];
const date = fmRelease.date;
const track = (id: string) => data.tracks.find(t => t.id === id)!;
const protocolName = (id: string) => trackTitle(track(id).title, locale);
// A protocol's cohort and chance level, as the v9 export states them.
const people = (id: string): FigValue => protocolFacts(id).people;
const chanceOf = (id: string): FigValue => protocolFacts(id).chance;
const words = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen'];
// A count the page states in words in English and in digits in Chinese, as the site's Chinese does.
const list = (xs: string[]) => zh ? xs.join('、') : xs.length < 3 ? xs.join(' and ') : `${xs.slice(0, -1).join(', ')} and ${xs.at(-1)}`;
const nameLang = zh ? 'en' : undefined;
const idNames = (ids: string[]) => ids.map(id => fmModelById[id].name);
/** A protocol as a sentence names it. */
const inSentence: Record<string, { en: string; zh: string }> = {
  'mi-rest': { en: 'motor imagery and rest', zh: '运动想象与静息' }, 'beta-8ch': { en: 'BETA at eight electrodes', zh: 'BETA 8 个电极' },
  'beta-4ch': { en: 'BETA at four electrodes', zh: 'BETA 4 个电极' }, 'arithmetic-rest': { en: 'arithmetic and rest', zh: '心算与静息' },
  'p300-target': { en: 'the P300 target ERP', zh: 'P300 目标 ERP' }, 'semantic-target': { en: 'the semantic target ERP', zh: '语义目标 ERP' },
  'sleep-scalp': { en: 'sleep staging', zh: '睡眠分期' },
};
const sepName = (ids: string[]) => list(ids.map(id => inSentence[id][locale]));
/** Chinese typesetting: a space where Chinese meets a Latin name or a figure, none between Chinese words. */
const zhSpace = (t: string) => zh ? t.replace(/([\u4e00-\u9fff])([A-Za-z0-9])/g, '$1 $2').replace(/([A-Za-z0-9%)])([\u4e00-\u9fff])/g, '$1 $2') : t;

// The released row a relation is read against, as a sentence names it.
const refName = (row: string, name: string) => row === 'labram' ? 'LaBraM' : row === 'cbramod' ? 'CBraMod'
  : zh ? ({ 'Standard CCA': '标准 CCA', 'Spectral ridge': 'spectral ridge' } as Record<string, string>)[name] ?? name
  : name[0].toLowerCase() + name.slice(1);
const relWord = { en: { above: 'Above', overlap: 'Overlaps', below: 'Below' }, zh: { above: '高于', overlap: '与', below: '低于' } };
/** The export's three relations as one reading: "Above all three", or each relation with the rows it holds for. */
function relText(vs: VsPublished): string {
  const refs: [string, Relation][] = [['LaBraM', vs.labram], ['CBraMod', vs.cbramod], [refName(vs.bestRow, vs.bestName), vs.best]];
  if (refs.every(r => r[1] === refs[0][1]))
    return zh ? { above: '高于三者', overlap: '与三者都重叠', below: '低于三者' }[refs[0][1]] : `${relWord.en[refs[0][1]]} all three`;
  const parts = (['above', 'overlap', 'below'] as Relation[]).map(rel => [rel, refs.filter(r => r[1] === rel).map(r => r[0])] as const).filter(([, xs]) => xs.length);
  return zhSpace(parts.map(([rel, xs], i) => zh
    ? (rel === 'overlap' ? `与${list(xs)}重叠` : `${relWord.zh[rel]}${list(xs)}`)
    : `${i === 0 ? relWord.en[rel] : relWord.en[rel].toLowerCase()} ${list(xs)}`).join(zh ? '；' : '; '));
}
const exposureText = (st: string) => zh ? fmZh[st] : st;
/**
 * The other released non-foundation rows whose interval overlaps the one with the highest point estimate: that row
 * is named by its point estimate only, never as the best (review of 2026-10-05).
 */
const bestOverlaps = (track: string, best: { id: string; interval: [FigValue, FigValue] }) => data.tracks.find(t => t.id === track)!.rows
  .filter(r => r.id !== best.id && r.family !== 'foundation' && r.interval && r.interval[0] <= best.interval[1].raw && best.interval[0].raw <= r.interval[1])
  .map(r => zh ? ({ 'Standard CCA': '标准 CCA' } as Record<string, string>)[r.name] ?? r.name : /^[A-Z][a-z]/.test(r.name) ? r.name[0].toLowerCase() + r.name.slice(1) : r.name);
const say = (en: string) => fmText(en, locale);

