  },
}[locale];

type Part = string | FigValue;
const P = (xs: Part[]) => xs;

// Limitations, each the page's own words for one of the export's required limitations.
const mi = people('mi-rest'), p300 = people('p300-target'), sleepN = people(SLEEP);
const limits: [string, Part[]][] = zh ? [
  ['一个固定方案，不是上限', ['冻结探针就是已发布的线性分类头，只换了编码器；适配是一项任务上一个未调参、训练 5 轮的方案。这里没有任何分数是模型能达到的最好结果。']],
  ['小队列，描述性区间', ['运动想象 ', mi, ' 名被试，P300 ', p300, ' 名，睡眠分期 ', sleepN, ' 名。区间是被试 bootstrap，没有计入交叉验证带来的相关性，也没有做多重比较校正。']],
  ['分组列出，从不排名', ['各行保持导出文件的模型类别顺序。只有区间不重叠时，才说一行高于或低于另一行；同一批被试在两个编码器下的结果没有作为配对来检验。']],
  ['方法比较，不是部署时的比率', ['类别平衡或类别匹配的设计（P300、语义目标、运动想象对静息、抽样的睡眠数据帧）用来比较方法，不是实际使用中检出率、误报率或延迟的估计。']],
  ['新被试、同一任务与设置', ['折留出的是被试。这里没有跨天、跨设备或跨数据集的证据，也不做任何临床方面的声明。']],
  ['时间窗很短', ['每个编码器看到的都是已发布的 1–2 秒时间窗（睡眠为 15 个 2 秒片段），通常比它预训练时的上下文更短；各模型的输入处理写在协议页面上各行的脚注中。']],
  ['是否出现在预训练数据中：看作者的清单', ['BETA 在 ST-EEGFormer 作者公开的预训练数据清单中，TMNRED 在 SingLEM 的清单中；ZUNA 1.1 没有公开清单，所以它的每个单元格都是未知；EEGMamba 的清单读自其官方代码，把握程度为中等。其余单元格——包括 LaBraM 与 CBraMod 的——都不在作者公开的预训练数据清单中（2026-10-04 核查），这并不证明这些记录从未被模型见过。']],
  ['不代表作者认可', ['任何模型的作者都没有为这些结果背书。没有保留或分享任何适配后的权重或 LoRA 增量；每个模型的权重许可随它的行一起列出。计算耗时在共享 GPU 上测得，只作参考，所以不发布。']],
] : [
  ['One fixed recipe, not a ceiling', ['The frozen probe is the published linear head with only the encoder swapped; the adaptation is one untuned five-epoch recipe on one task. No score here is any model’s best.']],
  ['Small cohorts, descriptive intervals', ['Motor imagery has ', mi, ' people, P300 ', p300, ', sleep staging ', sleepN, '. The intervals are participant bootstraps that ignore cross-validation dependence and carry no multiplicity correction.']],
  ['Grouped, never ranked', ['Rows keep the export’s family order. A row is above or below another only where the intervals do not overlap; the same people under two encoders are not tested as a pair.']],
  ['Method comparisons, not deployment rates', ['Balanced or class-matched designs (P300, semantic target, motor imagery against rest, sampled sleep epochs) compare methods; they are not detection, false-alarm or latency estimates for real use.']],
  ['New people, same task and setup', ['The folds hold out people. Nothing here is cross-day, cross-device or cross-dataset evidence, and nothing is a clinical claim.']],
  ['Short windows', ['Every encoder sees the published 1–2 s windows (sleep as 15 two-second segments), usually shorter than its pretraining context; each model’s input handling is in its row footnote on the protocol pages.']],
  ['Pretraining exposure: the authors’ lists', ['BETA is in ST-EEGFormer’s published pretraining list and TMNRED in SingLEM’s; ZUNA 1.1 publishes none, so every ZUNA 1.1 cell is unknown; EEGMamba’s list is read from its official code, with medium confidence. Every other cell, LaBraM’s and CBraMod’s included, is not in the authors’ published pretraining list (checked 2026-10-04) — not proof that the recordings were never seen.']],
  ['No endorsement', ['No model’s authors endorse these results. No adapted weights or LoRA deltas were kept or shared, and each model’s weights licence travels with its rows. Timings were measured on a shared GPU and are not published.']],
];

// One licence entry per family printed in this section.
const families = [...new Map([...fmMatrixModels, ...fmAblation.checkpoints.map(id => fmModelById[id])].map(m => [m.slug, m])).values()];
const familyModels = (slug: string) => [...fmMatrixModels, ...fmAblation.checkpoints.map(id => fmModelById[id])].filter((m, i, xs) => m.slug === slug && xs.indexOf(m) === i);
const colon = zh ? '：' : ': ';
const singlem = adaptRows.find(r => r.id === 'singlem')!;
const reveSeparated = revePairs.filter(p => !p.overlap).map(p => p.track);
const separatedMasking = maskingRows.filter(r => r.separated.length);
const nScored = SCORED_TRACKS.length;
// The encoders not adapted, grouped by the export's reason (the four masking checkpoints share one).
const notAdaptedGroups = [...new Map(fmNotAdapted.map(m => [m.adaptation, fmNotAdapted.filter(x => x.adaptation === m.adaptation)])).entries()];
---
<section class="topic-section fm-topic" id="v9-encoders" aria-labelledby="v9-heading" data-release={fmRelease.id}>
  <div class="topic-heading"><div><p class="eyebrow">{c.eyebrow}</p><h2 id="v9-heading">{c.h2}</h2></div><p>{c.lede}</p></div>
  <p class="protocol-note fm-reading-rule">{c.rule}</p>

  <h3 class="roadmap-h3" id="v9-sleep">{c.sleepH3(sleepAboveAll.length)}</h3>
  <p class="roadmap-p" data-claim="sleep-above-all" data-models={sleepAboveAll.map(r => r.cell.model.id).join(' ')}>{c.sleepP(nScored)[0]}<Fig f={people(SLEEP)}/>{c.sleepP(nScored)[1]}<Fig f={chanceOf(SLEEP)}/>{c.sleepP(nScored)[2]}<NameList names={sleepAboveAll.map(r => r.cell.model.name)} locale={locale}/>{c.sleepP(nScored)[3]}<span data-core-topic={`${SLEEP}|${sleepBest.id}`}><Fig f={sleepBest.ba}/>{c.sleepP(nScored)[4]}<Fig f={sleepBest.interval[0]}/>{c.sleepP(nScored)[5]}<Fig f={sleepBest.interval[1]}/></span>{c.sleepP(nScored)[6]}</p>
  <p class="protocol-note fm-published"><strong>{c.published(inSentence[SLEEP][locale])}</strong>{zh ? '' : ' '}{sleepPublished.map((p, i) => <>{i > 0 && ' · '}<span data-core-topic={`${SLEEP}|${p.id}`}><span lang="en">{p.name}</span> <Fig f={p.ba}/>{zh ? '（' : ' ('}<Fig f={p.interval[0]}/>–<Fig f={p.interval[1]}/>{zh ? '）' : ')'}</span></>)}</p>
  <div class="topic-table topic-table-spaced scroll" tabindex="0" role="region" aria-label={c.sleepRegion}>
    <table class="fm-results fm-topic-table"><caption>{c.sleepCaption}</caption>
      <thead><tr><th scope="col">{c.colEncoder}</th><th scope="col">{c.colBa}</th><th scope="col">{c.colVs}</th></tr></thead>
      <tbody>{sleepRows.map(r => <tr data-fm-topic={`${SLEEP}|${r.cell.model.id}`} data-rel={`${r.vs.labram} ${r.vs.cbramod} ${r.vs.best}`}>
        <th scope="row"><span lang="en"><a href={hrefFor(`/methods/${r.cell.model.slug}/`, locale)}>{r.cell.model.name}</a></span>{fmResearchUse(r.cell.model) && <small class="fm-research-use">{pc.researchUse}</small>}</th>
        <td><FmTopicBa ba={r.cell.primary!} interval={r.cell.interval!} flag={r.cell.chanceFlag} exposure={r.cell.exposure} locale={locale}/></td>
        <td class="fm-rel">{relText(r.vs)}</td>
      </tr>)}</tbody>
    </table>
  </div>
  <p class="citation-note fm-exposure-key">{c.vsLegend(refName(sleepBest.id, sleepBest.name), bestOverlaps(SLEEP, sleepBest))} {c.key(fmExposure.checkedOn)}</p>

  <h3 class="roadmap-h3" id="v9-beta">{c.betaH3}</h3>
  <p class="roadmap-p" data-claim="beta-above-cbramod" data-models={betaAboveCbramod.map(r => r.cell.model.id).join(' ')} data-ablation={betaAblationAboveCbramod.join(' ')}>{c.betaP[0]}<Fig f={people(BETA8)}/>{c.betaP[1]}<Fig f={chanceOf(BETA8)}/>{c.betaP[2]}<NameList names={betaAboveCbramod.map(r => r.cell.model.name)} locale={locale}/>{c.betaP[3]}<span data-core-topic={`${BETA8}|cbramod`}><Fig f={betaPublished(BETA8).find(p => p.id === 'cbramod')!.ba}/></span>{c.betaP[4]}<span data-core-topic={`${BETA8}|${betaBest.id}`}><Fig f={betaBest.ba}/></span>{c.betaP[5]}</p>
  <p class="protocol-note fm-published"><strong>{c.published(inSentence[BETA8][locale])}</strong>{zh ? '' : ' '}{betaPublished(BETA8).map((p, i) => <>{i > 0 && ' · '}<span data-core-topic={`${BETA8}|${p.id}`}><span lang="en">{p.name}</span> <Fig f={p.ba}/>{zh ? '（' : ' ('}<Fig f={p.interval[0]}/>–<Fig f={p.interval[1]}/>{zh ? '）' : ')'}</span></>)}</p>
  <div class="topic-table topic-table-spaced scroll" tabindex="0" role="region" aria-label={c.betaRegion}>
    <table class="fm-results fm-topic-table"><caption>{c.betaCaption}</caption>
      <thead><tr><th scope="col">{c.colEncoder}</th><th scope="col">{c.colBa}</th><th scope="col">{c.colVs}</th></tr></thead>
      <tbody>{betaRows.map(r => <tr data-fm-topic={`${BETA8}|${r.cell.model.id}`} data-rel={`${r.vs.labram} ${r.vs.cbramod} ${r.vs.best}`}>
        <th scope="row"><span lang="en"><a href={hrefFor(`/methods/${r.cell.model.slug}/`, locale)}>{r.cell.model.name}</a></span>{fmResearchUse(r.cell.model) && <small class="fm-research-use">{pc.researchUse}</small>}</th>
        <td><FmTopicBa ba={r.cell.primary!} interval={r.cell.interval!} flag={r.cell.chanceFlag} exposure={r.cell.exposure} locale={locale}/></td>
        <td class="fm-rel">{relText(r.vs)}</td>
      </tr>)}</tbody>
    </table>
  </div>
  <p class="citation-note fm-exposure-key">{c.vsLegend(refName(betaBest.id, betaBest.name), bestOverlaps(BETA8, betaBest))} {c.key(fmExposure.checkedOn)}</p>

  <h3 class="roadmap-h3" id="v9-adaptation">{c.adaptH3}</h3>
  <p class="roadmap-p">{c.adaptP[0]}<Fig f={fmAdaptationMeta.people}/>{c.adaptP[1]}<Fig f={fmAdaptationMeta.folds}/>{c.adaptP[2]}<Fig f={fmAdaptationMeta.chance}/>{c.adaptP[3]}<Fig f={fmAdaptationMeta.loraRange[0]}/>{c.adaptP[4]}<Fig f={fmAdaptationMeta.loraRange[1]}/>{c.adaptP[5]}</p>
  <p class="roadmap-p" data-claim="adaptation-verdicts" data-models={adaptResolved.join(' ')} data-open={adaptOpen.join(' ')}>{c.adaptRead[0]}<NameList names={idNames(adaptResolved)} locale={locale}/>{c.adaptRead[1]}<NameList names={idNames(adaptOpen)} locale={locale}/>{c.adaptRead[2]}</p>
  <p class="roadmap-p" data-fm-topic="arithmetic-rest|singlem">{c.adaptSinglem[0]}<Fig f={singlem.ridge.ba}/>{c.adaptSinglem[1]}<Fig f={singlem.frozen.ba}/>{c.adaptSinglem[2]}<Fig f={singlem.lora.ba}/>{c.adaptSinglem[3]}</p>
  <div class="topic-table topic-table-spaced scroll" tabindex="0" role="region" aria-label={c.adaptRegion}>
    <table class="fm-adaptation fm-topic-table"><caption>{c.adaptCaption}</caption>
      <thead><tr><th scope="col">{c.colEncoder}</th><th scope="col">{c.colRidge}</th><th scope="col">{c.colFrozen}</th><th scope="col">{c.colLora}</th><th scope="col">{c.colChange}</th><th scope="col">{c.colTrainable}</th></tr></thead>
      <tbody>{adaptRows.map(a => <tr data-adapt-row={a.id} {...(a.context ? { 'data-core-topic': 'arithmetic-rest|labram' } : { 'data-fm-topic': `arithmetic-rest|${a.id}` })}>
        <th scope="row"><span lang="en"><a href={hrefFor(`/methods/${a.slug}/`, locale)}>{a.name}</a></span>{a.context && <small>{pc.labramContext}</small>}{a.exposure === 'unknown' && <span class="flag fm-badge" data-exposure="unknown">{pc.unknown}</span>}{a.model && fmResearchUse(a.model) && <small class="fm-research-use">{pc.researchUse}</small>}</th>
        <td><FmTopicBa ba={a.ridge.ba} interval={a.ridge.interval} flag={a.ridge.chanceFlag} locale={locale}/></td>
        <td><FmTopicBa ba={a.frozen.ba} interval={a.frozen.interval} flag={a.frozen.chanceFlag} locale={locale}/></td>
        <td><FmTopicBa ba={a.lora.ba} interval={a.lora.interval} flag={a.lora.chanceFlag} locale={locale}/></td>
        <td><Fig f={a.change.mean} cls="metric"/><span class="interval"><Fig f={{ ...a.change.interval[0], fmt: 'sgn1' as const }}/>{zh ? ' 至 ' : ' to '}<Fig f={a.change.interval[1]}/></span><small>{c.moved[0]}<Fig f={a.change.helped}/>{c.moved[1]}<Fig f={a.change.harmed}/>{c.moved[2]}<Fig f={a.change.tied}/>{c.moved[3]}</small><span class="verdict" data-resolved={a.change.excludesZero ? 'true' : 'false'}>{a.change.excludesZero ? pc.excludesZero : pc.includesZero}</span></td>
        <td><Fig f={a.frozen.trainable}/> · <Fig f={a.lora.trainable}/></td>
      </tr>)}</tbody>
    </table>
  </div>
  <p class="protocol-note" data-claim="not-adapted"><strong>{c.notAdapted}</strong>{zh ? '' : ' '}{notAdaptedGroups.map(([reason, ms], i) => <>{i > 0 && (zh ? '；' : '; ')}<NameList names={ms.map(m => m.name)} locale={locale}/>{zh ? '（' : ' ('}{say(reason).text}{zh ? '）' : ')'}</>)}{zh ? '。' : '.'}</p>

  <h3 class="roadmap-h3" id="v9-size">{c.sizeH3}</h3>
  <p class="roadmap-p" data-claim="reve-separated" data-tracks={reveSeparated.join(' ')}>{zhSpace(c.sizeP(sepName(reveSeparated), nScored))}</p>
  <details class="rd-panel fm-panel" id="v9-size-table">
  <summary>{c.sizeSummary}</summary>
  <div class="topic-table topic-table-spaced scroll" tabindex="0" role="region" aria-label={c.sizeRegion}>
    <table class="fm-results fm-topic-table"><caption>{c.sizeCaption}</caption>
      <thead><tr><th scope="col">{c.colProtocol}</th><th scope="col">{c.colBase}</th><th scope="col">{c.colLarge}</th><th scope="col">{c.colDiff}</th><th scope="col">{c.colOverlap}</th></tr></thead>
      <tbody>{revePairs.map(p => <tr data-size-pair={p.track} data-overlap={p.overlap ? 'true' : 'false'}>
        <th scope="row"><a href={`${hrefFor(`/protocols/${p.track}/`, locale)}#${FM_ANCHOR}`}>{protocolName(p.track)}</a><small><Fig f={people(p.track)}/>{zh ? ' 名被试' : ' people'}</small></th>
        <td data-fm-topic={`${p.track}|${p.base}`}><FmTopicBa ba={p.baseCell.primary!} interval={p.baseCell.interval!} flag={p.baseCell.chanceFlag} exposure={p.baseCell.exposure} locale={locale}/></td>
        <td data-fm-topic={`${p.track}|${p.large}`}><FmTopicBa ba={p.largeCell.primary!} interval={p.largeCell.interval!} flag={p.largeCell.chanceFlag} exposure={p.largeCell.exposure} locale={locale}/></td>
        <td><Fig f={p.diff} cls="metric"/></td>
        <td class="fm-word">{p.overlap ? c.overlapYes : <strong class="fm-sep">{c.overlapNo}</strong>}</td>
      </tr>)}</tbody>
    </table>
  </div>
  </details>
  <p class="protocol-note" data-claim="other-size-pairs" data-luna={separatedOn('luna-base').join(' ')} data-st={separatedOn('steegformer-base').join(' ')}>{zhSpace(c.sizeOthers(sepName(separatedOn('luna-base')), sepName(separatedOn('steegformer-base'))))}</p>

  <h3 class="roadmap-h3" id="v9-masking">{c.maskH3(maskingInseparable, maskingRows.length)}</h3>
  <p class="roadmap-p">{c.maskP(maskingInseparable, maskingRows.length)}{separatedMasking.map(r => <>{zh ? '' : ' '}{zhSpace(c.maskSep(c.maskShort[r.separated[0][0]], c.maskShort[r.separated[0][1]], inSentence[r.track][locale]))}</>)}</p>
  <details class="rd-panel fm-panel" id="v9-masking-table">
  <summary>{c.maskSummary}</summary>
  <div class="topic-table topic-table-spaced scroll" tabindex="0" role="region" aria-label={c.maskRegion}>
    <table class="fm-results fm-topic-table fm-masking"><caption>{c.maskCaption}</caption>
      <thead><tr><th scope="col">{c.colProtocol}</th>{fmAblation.checkpoints.map(id => <th scope="col">{c.maskCols[id]}</th>)}<th scope="col">{c.colPairs}</th></tr></thead>
      <tbody>{maskingRows.map(r => <tr data-masking={r.track} data-separated={r.separated.map(p => p.join('+')).join(' ') || 'none'}>
        <th scope="row"><a href={`${hrefFor(`/protocols/${r.track}/`, locale)}#${FM_ANCHOR}`}>{protocolName(r.track)}</a></th>
        {r.cells.map(cell => <td data-fm-topic={`${r.track}|${cell.model.id}`}><FmTopicBa ba={cell.primary!} interval={cell.interval!} flag={cell.chanceFlag} exposure={cell.exposure} locale={locale}/></td>)}
        <td class="fm-word">{r.separated.length ? r.separated.map(([a, b]) => <strong class="fm-sep">{c.maskShort[a]}{zh ? ' 对 ' : ' vs. '}{c.maskShort[b]}</strong>) : c.noPair}</td>
      </tr>)}</tbody>
    </table>
  </div>
  </details>

  <h3 class="roadmap-h3" id="v9-limits">{c.limitsH3}</h3>
  <div class="method-grid-wide fm-limits">{limits.map(([h, parts]) => <article><h3>{h}</h3><p>{parts.map(x => typeof x === 'string' ? x : <Fig f={x}/>)}</p></article>)}</div>
  <h3 class="roadmap-h3" id="v9-licences">{c.licencesH3}</h3>
  <ul class="entity-links protocol-prose fm-licences">{families.map(m0 => {
    const ms = familyModels(m0.slug), w = say(ms[0].weightsLicence), n = say(ms[0].licenceNote);
    const restates = ms[0].licenceNote.replace(/\.$/, '') === ms[0].weightsLicence;
    return <li data-licence={ms[0].slug}><strong lang="en">{ms.map(m => m.name).join(' · ')}</strong>{colon}<span>{w.text}</span>{w.original && <span class="note-original" lang="en">{w.original}</span>}{!restates && <><span class="fm-licence-note">{n.text}</span>{n.original && <span class="note-original" lang="en">{n.original}</span>}</>} <a href={ms[0].paper} target="_blank" rel="noreferrer">{zh ? '论文 ↗' : 'paper ↗'}</a></li>;
  })}</ul>
  <p class="citation-note">{c.files[0]}{SCORED_TRACKS.map((id, i) => <>{i > 0 && c.protocolLinkSep}<a href={`${hrefFor(`/protocols/${id}/`, locale)}#${FM_ANCHOR}`}>{protocolName(id)}</a></>)}{c.files[1]}<a href={`/data/${FM_JSON}`} download>{FM_JSON}</a>{c.files[2]}<a href={hrefFor(`/releases/#${fmRelease.id}`, locale)}><code>{fmRelease.id}</code></a>{c.files[3]}</p>
</section>
