         fmResearchUse, type FmModel, type FmRow } from '../data/foundation-models';
import { fmText, fmZh } from '../data/foundation-models-zh';
import { adaptOpen, adaptResolved, adaptRows, betaAblationAboveCbramod, betaAboveCbramod, betaBest, betaPublished, betaRows, BETA8,
         maskingInseparable, maskingRows, protocolFacts, revePairs, SCORED_TRACKS, separatedOn, SLEEP, sleepAboveAll, sleepBest, sleepPublished,
         sleepRows, type ChanceFlag, type Relation, type VsPublished } from '../data/foundation-topics';
