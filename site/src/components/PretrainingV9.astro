/**
 * does-pretraining-help, #v9-encoders (2026-10-04, owner approved): eleven further
 * foundation models swapped into the published LaBraM/CBraMod frozen recipe. A
 * narrower question than the page's own — which pretrained encoders read out
 * better, with no random-initialization control — so it has its own section,
 * after the controls and before their methods and limits.
 *
 * What it prints, all from foundation-topics.ts: the sleep result (the new rows
 * above every released one), BETA (above CBraMod, not above training-free CCA), the
 * EEGMAT adaptation (one fixed recipe on one task, not a ranking; LoRA budgets
 * differ), REVE Base against Large (marginal intervals, no paired test) and the
 * masking ablation. Every figure is a `Fig` re-read by check-workbench.mjs; every
 * relation word is the export's; rows keep the export's family order. Exposure is
 * the owner's sourced statement: a badge where the dataset is in the authors' list
 * or the list is unknown, the plain statement in the key under each table.
 */
import Fig from './Fig.astro';
import NameList from './NameList.astro';
import FmTopicBa from './FmTopicBa.astro';
