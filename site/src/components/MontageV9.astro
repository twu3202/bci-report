---
/**
 * fewer-electrodes, #v9-montage (2026-10-04, owner approved): BETA at eight and at
 * four posterior electrodes, and sleep staging on six scalp channels, for the new
 * frozen encoders beside the released rows (standard CCA, spectral ridge, EEGNet,
 * LaBraM, CBraMod). A third comparison on the page, with nothing shared with the
 * two above it: each montage is its own core-matrix protocol, trained and tested
 * on its own.
 *
 * What it prints, all from foundation-topics.ts: every row's figures as `Fig`s
 * (v9 cells from the protocol CSVs, released rows from experiments.json); for a new
 * row, the export's four-minus-eight change and whether the two intervals
 * overlap; for a released row, only whether its two intervals overlap (no released
 * file states that difference). The two readings the handoff asks for: the
 * single-channel and channel-wise encoders show no small-montage advantage, and
 * standard CCA keeps the highest four-electrode score with no new row above it.
 */
import Fig from './Fig.astro';
import NameList from './NameList.astro';
import FmTopicBa from './FmTopicBa.astro';
import { protocolCopy } from '../data/entity-copy';
import { hrefFor, type Locale } from '../data/i18n';
import data from '../data/mvp.json';
import { FM_ANCHOR, FM_JSON, fmExposure, fmRelease, fmResearchUse } from '../data/foundation-models';
import { BETA4, BETA8, protocolFacts, cca4, cca4Overlapping, montageAboveCbramod, montageNonMontage, montagePublished, montageRows, SLEEP } from '../data/foundation-topics';
import type { Fig as FigValue } from '../data/entities';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const pc = protocolCopy[locale];
const track = (id: string) => data.tracks.find(t => t.id === id)!;
// A protocol's cohort and chance level, as the v9 export states them.
const people = (id: string): FigValue => protocolFacts(id).people;
const chanceOf = (id: string): FigValue => protocolFacts(id).chance;
const singlem = montageRows.find(r => r.model.id === 'singlem')!;
const zuna = montageRows.find(r => r.model.id === 'zuna')!;
if (montageNonMontage.map(r => r.model.id).sort().join() !== 'singlem,zuna')
  throw new Error('MontageV9.astro: the paragraph names SingLEM and ZUNA 1.1 as the non-montage encoders; the export names others');
// SingLEM is the lowest new sleep row, and below every released one: its interval lies under every other row's.
const sleepLows = [...montageRows.filter(r => r !== singlem).map(r => r.sleep.interval![0].raw), ...montagePublished.filter(p => p.sleep).map(p => p.sleep!.interval[0].raw)];
if (!sleepLows.every(lo => singlem.sleep.interval![1].raw < lo))
  throw new Error('MontageV9.astro: SingLEM is no longer below every other sleep row');
const family = { en: { montage: 'multi-channel montage', 'single-channel': 'single-channel', 'channel-wise': 'channel-wise' },
                 zh: { montage: '多通道电极布局', 'single-channel': '单通道', 'channel-wise': '逐通道' } }[locale] as Record<string, string>;

const c = {
  en: {
    eyebrow: `Third comparison · core-matrix protocols · added ${fmRelease.date}`,
    h2: 'Eight or four electrodes on BETA, and six-channel sleep: the new frozen encoders',
    lede: ['The core matrix scores BETA’s 40-target SSVEP twice, with eight and with four posterior electrodes selected from the same 64-channel recordings (', ' people, chance ', '), and sleep staging on six scalp channels (EESM19 scalp subset, ', ' people, chance ', '). On 4 October 2026 eleven further foundation models joined these protocols as frozen probes, with the published recipe and only the encoder swapped. Unlike the two comparisons above, each montage here is trained and tested on its own — nothing is carried from one to the other — and the released and the new rows share the people and folds.'],
    noAdvantageH3: 'No small-montage advantage for single-channel or channel-wise encoders',
    noAdvantage: ['SingLEM, which encodes each channel on its own, went from ', ' with eight electrodes to ', ' with four (', '); ZUNA 1.1, a channel-wise encoder, from ', ' to ', ' (', '). For both, the two intervals do not overlap. SingLEM lost about as much as the montage encoders that lie above CBraMod at both montages (', '); ZUNA 1.1 started from a much lower score. On six-channel sleep SingLEM is the lowest new row (', ', ', '–', '), below every other row, released or new.'],
    ccaH3: 'Standard CCA keeps the highest four-electrode score',
    cca: ['Standard CCA, which needs no training, scores ', ' with four electrodes (', '–', '). No new row lies above it; only ', ' has an interval that overlaps it (', ').'],
    region: 'BETA at eight and four electrodes and sleep on six channels, released and new rows, scrolls horizontally',
    caption: 'Frozen encoders with a ridge head beside the released rows · balanced accuracy with its descriptive 95% interval.',
    colEncoder: 'Method', col8: 'BETA, 8 electrodes', col4: 'BETA, 4 electrodes', colChange: 'Eight to four', colSleep: 'Sleep, 6 channels',
    released: 'Released rows · core matrix, 20 September 2026',
    newRows: `New frozen encoders · ${fmRelease.date}`,
    input: (f: string) => `Input: ${f}`,
    overlapYes: 'Intervals overlap', overlapNo: 'Intervals do not overlap',
    notInSleep: 'Not in the sleep protocol',
    note: (d: string) => `Eight to four: for a new row, the change and whether the two intervals overlap, as the v9 export states them; for a released row only whether its two intervals overlap, because no released file states that difference. The changes are differences of marginal means, with no paired test. Unless a row is marked, its dataset is not in the model authors’ published pretraining list (checked ${d}): what the lists show, not proof that the recordings were never seen.`,
    limitsLabel: 'BETA and sleep · the new frozen encoders',
    limits: [
      ['Subsets of one recording, not two headsets', 'The eight and four electrodes are channels selected in software from the same 64-channel laboratory recordings. As the core protocol itself says, a subset picked this way does not validate a physical low-channel cap, and near-floor scores are not ordered reliably between the two subsets.'],
      ['Not the in-ear comparison', 'The six-channel column is the core matrix’s sleep protocol, a balanced, quality-screened scalp sample of EESM19 — not EESM23 above and not ear-EEG. The two sleep results do not share a ranking.'],
      ['One fixed recipe, grouped, not ranked', 'Every new row is the published frozen probe with only the encoder swapped. Rows keep the export’s family order; a row is above or below another only where the intervals do not overlap.'],
      ['Pretraining exposure', 'BETA is in ST-EEGFormer’s published pretraining list, so its BETA cells are marked; ZUNA 1.1 publishes no list, so every ZUNA 1.1 cell is unknown. The other cells are not in the authors’ published lists (checked 2026-10-04), which is not proof that the recordings were never seen.'],
    ],
    files: ['The full rows, with footnotes and exposure sources, are on the protocol pages: ', '. The four-minus-eight comparison is in ', '.'],
  },
  zh: {
    eyebrow: `第三项比较 · 核心矩阵协议 · ${fmRelease.date} 新增`,
    h2: 'BETA 的 8 个或 4 个电极，以及 6 通道睡眠分期：新的冻结编码器',
    lede: ['核心矩阵对 BETA 的 40 目标 SSVEP 评了两次，分别用从同一套 64 通道记录中选出的 8 个和 4 个后部电极（', ' 名被试，随机水平 ', '）；睡眠分期则用 6 个头皮通道（EESM19 头皮子集，', ' 名被试，随机水平 ', '）。2026 年 10 月 4 日，另外 11 个基础模型以冻结探针的方式加入这些协议，沿用已发布的方案，只替换编码器。与上面两项比较不同，这里每种电极布局都各自训练、各自测试，彼此之间不做任何迁移；已发布的行与新行用的是同一批被试和同样的折。'],
    noAdvantageH3: '电极更少时，单通道与逐通道编码器没有优势',
    noAdvantage: ['SingLEM 对每个通道单独编码，从 8 个电极的 ', ' 降到 4 个电极的 ', '（', '）；逐通道编码器 ZUNA 1.1 从 ', ' 降到 ', '（', '）。两者的两个区间都不重叠。SingLEM 的降幅与在两种电极布局上都高于 CBraMod 的多通道编码器相当（', '），而 ZUNA 1.1 的起点要低得多。在 6 通道睡眠分期上，SingLEM 是最低的一个新行（', '，', '–', '），低于其他所有行，无论已发布的还是新的。'],
    ccaH3: '标准 CCA 仍是 4 个电极上的最高分',
    cca: ['完全不需要训练的标准 CCA 在 4 个电极上得 ', '（', '–', '）。没有任何新行高于它；只有 ', ' 的区间与它重叠（', '）。'],
    region: 'BETA 的 8 个与 4 个电极，以及 6 通道睡眠分期，已发布的行与新行，可横向滚动',
    caption: '冻结编码器加岭回归分类头，与已发布的行并列 · 平衡准确率及其描述性 95% 区间。',
    colEncoder: '方法', col8: 'BETA，8 个电极', col4: 'BETA，4 个电极', colChange: '从 8 个到 4 个', colSleep: '睡眠分期，6 通道',
    released: '已发布的行 · 核心矩阵，2026 年 9 月 20 日',
    newRows: `新的冻结编码器 · ${fmRelease.date}`,
    input: (f: string) => `输入：${f}`,
    overlapYes: '区间重叠', overlapNo: '区间不重叠',
    notInSleep: '不在睡眠协议中',
    note: (d: string) => `从 8 个到 4 个：新行给出第九轮导出文件中的变化量以及两个区间是否重叠；已发布的行只给出两个区间是否重叠，因为没有任何已发布的文件写出这个差值。这些变化是边际均值之差，没有做配对检验。未加标记的行，其数据集都不在模型作者公开的预训练数据清单中（${d} 核查）：这是清单所显示的情况，并不证明这些记录从未被模型见过。`,
    limitsLabel: 'BETA 与睡眠分期 · 新的冻结编码器',
    limits: [
      ['同一记录的子集，不是两款设备', '8 个和 4 个电极都是从同一套 64 通道实验室记录中用软件选出的通道。正如核心协议自己所说，这样选出的子集不能验证一顶实体的少通道电极帽，而且接近下限的分数在两个子集之间的先后并不可靠。'],
      ['不是耳道内的那项比较', '6 通道这一列是核心矩阵的睡眠协议：EESM19 中类别平衡、经过质量筛选的头皮样本——不是上面的 EESM23，也不是耳部 EEG。两个睡眠结果不能放进同一个排名。'],
      ['一个固定方案，分组列出，不排名', '每个新行都是已发布的冻结探针，只换了编码器。各行保持导出文件的模型类别顺序；只有区间不重叠时，才说一行高于或低于另一行。'],
      ['是否出现在预训练数据中', 'BETA 在 ST-EEGFormer 作者公开的预训练数据清单中，所以它在 BETA 上的单元格都已标出；ZUNA 1.1 没有公开清单，所以它的每个单元格都是未知。其余单元格都不在作者公开的清单中（2026-10-04 核查），这并不证明这些记录从未被模型见过。'],
    ],
    files: ['完整的行连同脚注与预训练数据来源，见各协议页面：', '。从 8 个到 4 个电极的比较在 ', ' 中。'],
  },
}[locale];
const protocolLinks = [BETA8, BETA4, SLEEP];
const protocolLabel = { en: { 'beta-8ch': 'SSVEP · 8 channels', 'beta-4ch': 'SSVEP · 4 channels', 'sleep-scalp': 'Sleep staging' },
                        zh: { 'beta-8ch': 'SSVEP · 8 通道', 'beta-4ch': 'SSVEP · 4 通道', 'sleep-scalp': '睡眠分期' } }[locale] as Record<string, string>;
const aboveNames = montageAboveCbramod;
---
<section class="topic-section fm-topic" id="v9-montage" aria-labelledby="v9-montage-heading" data-release={fmRelease.id}>
  <div class="topic-heading"><div><p class="eyebrow">{c.eyebrow}</p><h2 id="v9-montage-heading">{c.h2}</h2></div><p>{c.lede[0]}<Fig f={people(BETA8)}/>{c.lede[1]}<Fig f={chanceOf(BETA8)}/>{c.lede[2]}<Fig f={people(SLEEP)}/>{c.lede[3]}<Fig f={chanceOf(SLEEP)}/>{c.lede[4]}</p></div>

  <h3 class="roadmap-h3" id="v9-no-advantage">{c.noAdvantageH3}</h3>
  <p class="roadmap-p" data-claim="no-small-montage-advantage" data-models={montageAboveCbramod.map(r => r.model.id).join(' ')}>
    <span data-fm-topic={`${BETA8}|singlem`}>{c.noAdvantage[0]}<Fig f={singlem.cell8.primary!}/></span><span data-fm-topic={`${BETA4}|singlem`}>{c.noAdvantage[1]}<Fig f={singlem.cell4.primary!}/></span>{c.noAdvantage[2]}<Fig f={singlem.diff}/><span data-fm-topic={`${BETA8}|zuna`}>{c.noAdvantage[3]}<Fig f={zuna.cell8.primary!}/></span><span data-fm-topic={`${BETA4}|zuna`}>{c.noAdvantage[4]}<Fig f={zuna.cell4.primary!}/></span>{c.noAdvantage[5]}<Fig f={zuna.diff}/>{c.noAdvantage[6]}{aboveNames.map((r, i) => <>{i > 0 && (zh ? '；' : ', ')}<span lang={zh ? 'en' : undefined}>{r.model.name}</span> <Fig f={r.diff}/></>)}{c.noAdvantage[7]}<span data-fm-topic={`${SLEEP}|singlem`}><Fig f={singlem.sleep.primary!}/>{c.noAdvantage[8]}<Fig f={singlem.sleep.interval![0]}/>{c.noAdvantage[9]}<Fig f={singlem.sleep.interval![1]}/></span>{c.noAdvantage[10]}
  </p>
  <h3 class="roadmap-h3" id="v9-cca">{c.ccaH3}</h3>
  <p class="roadmap-p" data-claim="cca-four-electrodes" data-models={cca4Overlapping.map(r => r.model.id).join(' ')}><span data-core-topic={`${BETA4}|cca`}>{c.cca[0]}<Fig f={cca4.ba}/>{c.cca[1]}<Fig f={cca4.interval[0]}/>{c.cca[2]}<Fig f={cca4.interval[1]}/></span>{c.cca[3]}<NameList names={cca4Overlapping.map(r => r.model.name)} locale={locale}/>{c.cca[4]}{cca4Overlapping.map((r, i) => <>{i > 0 && (zh ? '、' : ', ')}<span data-fm-topic={`${BETA4}|${r.model.id}`}><Fig f={r.cell4.primary!}/></span></>)}{c.cca[5]}</p>

  <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={c.region}>
    <table class="fm-results fm-topic-table fm-montage"><caption>{c.caption}</caption>
      <thead><tr><th scope="col">{c.colEncoder}</th><th scope="col">{c.col8}</th><th scope="col">{c.col4}</th><th scope="col">{c.colChange}</th><th scope="col">{c.colSleep}</th></tr></thead>
      <tbody>
        <tr class="subhead"><th colspan="5" scope="colgroup">{c.released}</th></tr>
        {montagePublished.map(p => <tr data-montage-row={p.id} data-released="true" data-overlap={p.overlap ? 'true' : 'false'}>
          <th scope="row"><span lang="en">{p.slug ? <a href={hrefFor(`/methods/${p.slug}/`, locale)}>{p.name}</a> : p.name}</span></th>
          <td data-core-topic={`${BETA8}|${p.id}`}><FmTopicBa ba={p.r8.ba} interval={p.r8.interval} flag={p.r8.chanceFlag} locale={locale}/></td>
          <td data-core-topic={`${BETA4}|${p.id}`}><FmTopicBa ba={p.r4.ba} interval={p.r4.interval} flag={p.r4.chanceFlag} locale={locale}/></td>
          <td class="fm-word">{p.overlap ? c.overlapYes : <strong class="fm-sep">{c.overlapNo}</strong>}</td>
          {p.sleep ? <td data-core-topic={`${SLEEP}|${p.id}`}><FmTopicBa ba={p.sleep.ba} interval={p.sleep.interval} flag={p.sleep.chanceFlag} locale={locale}/></td> : <td class="fm-na"><small>{c.notInSleep}</small></td>}
        </tr>)}
        <tr class="subhead"><th colspan="5" scope="colgroup">{c.newRows}</th></tr>
        {montageRows.map(r => <tr data-montage-row={r.model.id} data-released="false" data-overlap={r.overlap ? 'true' : 'false'} data-input={r.inputFamily}>
          <th scope="row"><span lang="en"><a href={hrefFor(`/methods/${r.model.slug}/`, locale)}>{r.model.name}</a></span><small>{c.input(family[r.inputFamily])}</small>{fmResearchUse(r.model) && <small class="fm-research-use">{pc.researchUse}</small>}</th>
          <td data-fm-topic={`${BETA8}|${r.model.id}`}><FmTopicBa ba={r.cell8.primary!} interval={r.cell8.interval!} flag={r.cell8.chanceFlag} exposure={r.cell8.exposure} locale={locale}/></td>
          <td data-fm-topic={`${BETA4}|${r.model.id}`}><FmTopicBa ba={r.cell4.primary!} interval={r.cell4.interval!} flag={r.cell4.chanceFlag} exposure={r.cell4.exposure} locale={locale}/></td>
          <td><Fig f={r.diff} cls="metric"/>{r.overlap ? <small>{c.overlapYes}</small> : <strong class="fm-sep">{c.overlapNo}</strong>}</td>
          <td data-fm-topic={`${SLEEP}|${r.model.id}`}><FmTopicBa ba={r.sleep.primary!} interval={r.sleep.interval!} flag={r.sleep.chanceFlag} exposure={r.sleep.exposure} locale={locale}/></td>
        </tr>)}
      </tbody>
    </table>
  </div>
  <p class="citation-note fm-exposure-key">{c.note(fmExposure.checkedOn)}</p>
  <p class="eyebrow limits-label">{c.limitsLabel}</p>
  <div class="method-grid-wide fm-limits">{c.limits.map(([h, p]) => <article><h3>{h}</h3><p>{p}</p></article>)}</div>
  <p class="citation-note">{c.files[0]}{protocolLinks.map((id, i) => <>{i > 0 && (zh ? '、' : ', ')}<a href={`${hrefFor(`/protocols/${id}/`, locale)}#${FM_ANCHOR}`}>{protocolLabel[id]}</a></>)}{c.files[1]}<a href={`/data/${FM_JSON}`} download>{FM_JSON}</a>{c.files[2]}</p>
</section>
