---
/**
 * Shell for the dataset, method and protocol pages: same head, header and
 * footer as the topic pages, without the topic switcher.
 */
import { site } from '../data/site';
import { alternates, chrome, hrefFor, htmlLang, localizePath, ogLocale, topicChrome, type Locale } from '../data/i18n';
import SiteHeader from './SiteHeader.astro';
import AgentLinks from './AgentLinks.astro';
import ShareImage from './ShareImage.astro';
import CiteMeta from './CiteMeta.astro';
import CitePage from './CitePage.astro';
import FooterElsewhere from './FooterElsewhere.astro';
import '../styles/global.css';
import '../styles/topics.css';

interface Props {
  locale: Locale;
  /** Path without a locale prefix, e.g. `/datasets/beta/`. */
  path: string;
  documentTitle: string;
  h1: string;
  description: string;
  eyebrow: string;
  dek: string;
  /** `en`: the label is the entity's English name, marked lang="en" on a Chinese page. */
  crumbs: { label: string; href?: string; en?: boolean }[];
  /**
   * The entity's own name, which stays English on every locale. Where it sits
   * inside `h1` it is wrapped and marked lang="en" on a Chinese page, so a
   * screen reader switches voice for "Wearable SSVEP BCI dataset …" and back.
   */
  name?: string;
  structured?: object | null;
  active: 'models' | 'datasets' | 'protocols';
  /**
   * Pages that print figures (one dataset, one method) get a "Cite this page"
   * block and citation_* tags naming the releases those figures come from.
   * `files` are the served files the figures are leaves of.
   */
  cite?: { files: string[]; upstream: 'page' | 'datasets' };
}
const { locale, path, documentTitle, h1, description, eyebrow, dek, crumbs, structured, active, name, cite } = Astro.props;
const nameLang = locale === 'zh' ? 'en' : undefined;
const at = name && nameLang ? h1.indexOf(name) : -1;
const t = chrome[locale];
const tc = topicChrome[locale];
const origin = Astro.site ?? site.origin;
const canonical = new URL(localizePath(path, locale), origin).href;
// "EEG datasets with results on BCI Report · BCI Report" said the name twice.
const pageTitle = documentTitle.includes(site.name) ? documentTitle : `${documentTitle} · ${site.name}`;
// Structured data on the English canonical only, as on the topic pages.
const ld = locale === 'en' && structured ? JSON.stringify(structured) : null;
---
<!doctype html>
<html lang={htmlLang[locale]}>
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="description" content={description}/>
  <meta name="theme-color" content="#b3450e"/>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
  <link rel="icon" href="/favicon.ico" sizes="32x32"/>
  <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
  <link rel="canonical" href={canonical}/>
  {alternates(path, String(origin)).map(l => <link rel="alternate" hreflang={l.hreflang} href={l.href}/>)}
  <AgentLinks href={localizePath(path, locale)}/>
  <title>{pageTitle}</title>
  <meta property="og:type" content="article"/>
  <meta property="og:site_name" content={site.name}/>
  <meta property="og:locale" content={ogLocale[locale]}/>
  <meta property="og:title" content={pageTitle}/>
  <meta property="og:description" content={description}/>
  <meta property="og:url" content={canonical}/>
  <ShareImage locale={locale}/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={pageTitle}/>
  <meta name="twitter:description" content={description}/>
  {cite && <CiteMeta locale={locale} title={h1} canonical={canonical} files={cite.files}/>}
  {ld && <script type="application/ld+json" set:html={ld}/>}
</head>
<body>
  <a class="skip" href="#entity-content">{t.skipToEvidence}</a>
  <SiteHeader locale={locale} path={path} active={active}/>
  <main class="topic-page entity-page" id="entity-content">
    <nav class="breadcrumbs" aria-label={tc.breadcrumb}><ol>{crumbs.map((c, i) => <li aria-current={i === crumbs.length - 1 ? 'page' : undefined} lang={c.en ? nameLang : undefined}>{c.href ? <a href={c.href}>{c.label}</a> : c.label}</li>)}</ol></nav>
    <section class="topic-hero">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{at < 0 ? h1 : <>{h1.slice(0, at)}<span lang={nameLang}>{name}</span>{h1.slice(at + name!.length)}</>}</h1>
      <p class="topic-dek">{dek}</p>
    </section>
    <slot />
    {cite && <CitePage locale={locale} title={h1} canonical={canonical} files={cite.files} upstream={cite.upstream}/>}
  </main>
  <footer><a class="brand" href={hrefFor('/', locale)}>{site.name}</a><p>{t.footerTagline}</p><a href={hrefFor('/releases/', locale)}>{t.footerReleases}</a><a href="/data-use/">{t.footerDataUse}{t.englishMark}</a><a href="#entity-content">{t.footerTop}</a><FooterElsewhere locale={locale}/></footer>
</body>
</html>
