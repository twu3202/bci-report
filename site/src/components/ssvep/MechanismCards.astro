        <caption>{copy.c12ContrastsCaption}</caption>
        <thead><tr><th scope="col">{copy.colContrast}</th><th scope="col">{copy.colTask}</th><th scope="col">{copy.colRole}</th><th scope="col">{copy.colDiff}</th></tr></thead>
        <tbody>{c12Rows.map(r => <tr data-contrast={r.k}><th scope="row">{r.name}</th><td>{r.task}</td><td>{r.role}</td><td set:html={r.cell}/></tr>)}</tbody>
      </table>
    </div>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.region(12, R.gap)}>
      <table data-ssvep-table="c12-gap">
        <caption>{copy.c12GapCaption}</caption>
        <thead><tr><th scope="col">{copy.colQuantity}</th><th scope="col">{copy.colBeta}</th><th scope="col">{copy.colDry}</th><th scope="col">{copy.colWet}</th></tr></thead>
        <tbody>{gapRows.map(r => <tr data-gap={r.k}><th scope="row">{r.name}</th>{r.cells.map(c => <td set:html={c}/>)}</tr>)}
          <tr data-gap="win fraction"><th scope="row">{copy.winName}</th>{winRow.map(c => <td set:html={c}/>)}</tr></tbody>
      </table>
    </div>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.region(12, R.alloc)}>
      <table data-ssvep-table="c12-allocation">
        <caption>{copy.c12AllocCaption}</caption>
        <thead><tr><th scope="col">{copy.colQuantity}</th><th scope="col">{copy.colBeta}</th><th scope="col">{copy.colDry}</th><th scope="col">{copy.colWet}</th></tr></thead>
        <tbody>{allocRows.map(r => <tr data-allocation={r.q}><th scope="row">{copy.allocName[r.q]}</th>{r.cells.map(c => <td set:html={c}/>)}</tr>)}</tbody>
      </table>
    </div>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.region(12, R.trans)}>
      <table data-ssvep-table="c12-transitions">
        <caption set:html={H(copy.c12TransCaption())}/>
        <thead><tr><th scope="col">{copy.colStep}</th>{copy.edgeHeads.map(h => <th scope="col">{h}</th>)}</tr></thead>
        <tbody>{edgeRows.map(r => <tr data-transition={r.k}><th scope="row">{r.name}</th>{r.cells.map(f => <td set:html={H([f])}/>)}</tr>)}</tbody>
      </table>
    </div>
    <p class="protocol-note" data-ssvep-note="reference-check" set:html={H(copy.refcheck12())}/>
  </details>
  <p class="protocol-note" data-ssvep-caption="12" set:html={H(copy.cap12())}/>
</section>}

<style is:global>
  /* Global, not scoped (the page's contract: a scoped style would add data-astro-cid-* to every element, and
     check-workbench.mjs reads figures by their exact markup). Every selector starts from one of these cards. */
  :is([data-ssvep-card="8"],[data-ssvep-card="9"],[data-ssvep-card="12"]) .topic-table th[scope=row] small{display:block;margin-top:3px;font-size:.7rem;font-weight:400;color:var(--muted);line-height:1.4}
  :is([data-ssvep-card="8"],[data-ssvep-card="9"],[data-ssvep-card="12"]) .topic-table code{font-family:var(--mono);font-size:.72rem}
  :is([data-ssvep-card="8"],[data-ssvep-card="9"],[data-ssvep-card="12"]) p.roadmap-p a,:is([data-ssvep-card="8"],[data-ssvep-card="9"],[data-ssvep-card="12"]) p.protocol-note a{color:var(--accent)}
  :is([data-ssvep-card="8"],[data-ssvep-card="9"],[data-ssvep-card="12"]) .topic-table .interval a{color:inherit;text-decoration:underline}
</style>
