---
/**
 * Cards 8, 9 and 12 of /topics/new-ssvep-frequencies/ (plan §2.1, package P-SS): #cross-spectral (the cross-spectral
 * scorer, whose results take the place of the released status entry, D28), #eigenvalue-pooling (coherence and
 * eigenvalue heads) and #harmonic-gap (where the harmonic sum's gain over joint CCA comes from).
 *
 * Every figure is a field of ssvep-followups-update.json, made by src/data/ssvep-followups.ts from its path and
 * printed with data-at and data-fig; scripts/checks/ssvep-followups.mjs holds each to its field and format. A level
 * that several cards share prints its interval on its home card only and links that card elsewhere; every contrast
 * prints its own interval. The cards state their prespecified criteria only (D23); each caveat sits once, beside its
 * evidence, and every caveat sentence is guarded on the study's own limitation key.
 *
 * Props
 *   locale: Locale — 'en' or 'zh'.
 *   cards: number[] — which of its cards (8, 9, 12) to render here; the page interleaves the two components so
 *     the cards run in number order.
 */
import type { Locale } from '../../data/i18n';
import { hrefFor } from '../../data/i18n';
import {
  need, figAt, countAt, st, scChrome, level, contrast, spansZero, lvBits, ctBits, levelCell, contrastCell, figCell, toHtml,
  nameOf, trainingWords, roleWords, taskWords, contrastName, intervalText, cardLink, keyed, codeOf, said, bonferroni,
  type Bit, type AnyBit, type ScStudy, type ContrastFigs,
} from '../../data/ssvep-followups';

interface Props { locale: Locale; cards?: number[] }
const { locale, cards = [8, 9, 12] } = Astro.props;
const show = (n: number) => cards.includes(n);
const zh = locale === 'zh';
const H = (bits: AnyBit[]) => toHtml(bits);
const to = zh ? ' 至 ' : ' to ';
const [c8, c9, c12] = ([8, 9, 12] as const).map(n => scChrome(n, locale));
const X: ScStudy = 'xspec', E: ScStudy = 'coherence_eigen', G: ScStudy = 'harmonic_gap';
const nm = (id: ScStudy, code: string) => nameOf(id, code, locale);
const ln = (n: number) => cardLink(n, locale);
const lnC = (n: number) => cardLink(n, locale, false, true);

// --- Card 8: the cross-spectral scorer ------------------------------------------------------------------------------
const x = st(X);
need(x.design.harmonics === 3 && x.design.arms.map((a: any) => a.code).join() === 'XS-RIDGE,XS-RIDGE-W,XS-MLP,XS-RIDGE-Q'
  && x.design.comparators.every((c: any) => c.card === 5), 'card 8: four new arms on the fundamental and two harmonics; four comparators from card 5');
const xRidge = level(X, 'XS-RIDGE/u8'), xShared = level(X, 'SHARED-RIDGE/u8'), xMlp = level(X, 'XS-MLP/u8'), xCca = level(X, 'CCA-RAW/u8');
const xW = level(X, 'XS-RIDGE-W/u8'), xCcaSeen = level(X, 'CCA-RAW/seen_ba');
const xP1 = contrast(X, 'XS-RIDGE minus SHARED-RIDGE/u8'), xP2 = contrast(X, 'XS-MLP minus CCA-RAW/u8'), xQ = contrast(X, 'XS-RIDGE-Q minus XS-RIDGE/u8');
need(Object.values(x.contrasts).filter((c: any) => c.role === 'primary').length === 2 && xP1.role === 'primary' && xP2.role === 'primary'
  && xP1.lo.raw > 0 && xP2.hi.raw < 0 && xP2.flags.prespecified_noninferiority_to_CCA === false,
  'card 8: two primary contrasts, the ridge above the shared ridge scorer, the MLP below CCA and short of its non-inferiority test');
need(x.design.arms.every((a: any) => x.levels[`${a.code}/seen_ba`].estimate < x.levels['CCA-RAW/seen_ba'].estimate), 'card 8: every new arm is below CCA on the seen task');
need(spansZero(xQ) && xQ.role === 'secondary', 'card 8: the quadrature contrast’s interval includes zero');
const gapU8 = figAt(['studies', X, 'descriptive_gaps', 'XS-RIDGE-W minus CCA-RAW/u8', 'estimate'], 'pp2');
const gapSeen = figAt(['studies', X, 'descriptive_gaps', 'XS-RIDGE-W minus CCA-RAW/seen_ba', 'estimate'], 'pp2');
need(Object.values(x.descriptive_gaps).every((g: any) => g.basis === 'difference of the two levels; no planned contrast and no interval'
  && Math.abs(g.estimate - (x.levels[g.left].estimate - x.levels[g.right].estimate)) < 1e-12)
  && x.undefined.some((u: any) => u.contrast === 'XS-RIDGE-W minus CCA-RAW' && u.reason === 'not_a_planned_contrast'),
  'card 8: the whitened readout against CCA is the difference of two levels, with no planned contrast and no interval');
keyed(X, 'whitened_vs_cca_descriptive', 'not_a_fixed_quadratic_form', 'whitening_composite_recipe', 'mlp_ridge_bundled_changes', 'mlp_seeds_averaged',
  'spectral_coordinates_vs_raw_cca', 'within_harmonic_matrices_only', 'quadrature_direction_unresolved', 'cropped_match_not_a_ceiling',
  'comparators_reused', 'nested_gain_scope', 'release_audit_scope');
need(x.checks.same_scores_as_card_5.passed === true && x.checks.same_scores_as_card_5.max_absolute_difference === 0
  && x.checks.same_scores_as_card_5.codes.join() === x.design.comparators.map((c: any) => c.code).join(), 'card 8: the comparators are card 5’s scores, unchanged');
need(x.checks.release_audit.passed && x.checks.fits.total === x.checks.fits.main + x.checks.fits.additional && x.levels['XS-MLP/u8'].seeds === 3,
  'card 8: the fit counts add up; the MLP has three seeds');
const c8Arms = [...x.design.arms, ...x.design.comparators].map((a: any) => ({
  code: a.code, name: nm(X, a.code),
  training: [trainingWords(a.training, locale), ...(a.code === 'XS-MLP' ? (zh ? ['，', countAt('studies', X, 'levels', 'XS-MLP/u8', 'seeds'), ' 个种子取平均'] : [', ', countAt('studies', X, 'levels', 'XS-MLP/u8', 'seeds'), ' seeds averaged']) : [])] as Bit[],
  cells: ['u8', 'seen_ba'].map(t => levelCell(level(X, `${a.code}/${t}`), locale)),
}));
const contrastRows = (id: ScStudy, ivFor: (c: ContrastFigs) => Bit[] = () => ['95%']) => Object.keys(st(id).contrasts).map(k => {
  const c = contrast(id, k);
  return { k, name: contrastName(id, c, locale), task: taskWords(k, locale), role: roleWords(c.role, locale), cell: contrastCell(c, locale, ivFor(c)) };
});
const c8Rows = contrastRows(X);

// --- Card 9: coherence and eigenvalue heads ----------------------------------------------------------------------------
const e = st(E);
const eRaw = level(E, 'EIG-RAW/u8'), eCca = level(E, 'CCA-RAW/u8'), eSum = level(E, 'RAW-HARM-SUM/u8');
const eCoh = level(E, 'COH-ABS/u8'), eXs = level(E, 'XS-RIDGE/u8'), eSpec = level(E, 'EIG-SPEC/u8'), eXsW = level(E, 'XS-RIDGE-W/u8');
const eP1 = contrast(E, 'EIG-RAW minus CCA-RAW/u8'), eHS = contrast(E, 'EIG-RAW minus RAW-HARM-SUM/u8');
const eP2 = contrast(E, 'COH-ABS minus XS-RIDGE/u8'), eP3 = contrast(E, 'EIG-SPEC minus XS-RIDGE-W/u8'), eSS = contrast(E, 'EIG-SPEC minus SPEC-HARM-SUM/u8');
need(Object.values(e.contrasts).filter((c: any) => c.role === 'primary').length === 3 && [eP1, eP2, eP3].every(c => c.role === 'primary')
  && eP1.lo.raw > 0 && eP1.flags.strict_5pp_equivalence === true && eP1.flags.strict_5pp_noninferiority === true && eP2.hi.raw < 0 && eP3.hi.raw < 0,
  'card 9: three primary contrasts; the eigenvalue head above CCA inside both prespecified margins, the coherence and spectral heads below their comparators');
need(spansZero(eHS) && eHS.role === 'secondary' && spansZero(eSS) && eSS.lo.fmt === 'sgn5' && eSS.flags.bound_below_two_decimals?.join() === 'lower',
  'card 9: the head minus the sum is unresolved; the spectral head minus the spectral sum has a lower bound below two decimals');
need(eCca.home === 5 && eXs.home === 8 && eXsW.home === 8 && eSum.home === 9 && eRaw.home === 9, 'card 9: CCA from card 5, the cross-spectral readouts from card 8, its own heads and sum');
keyed(E, 'cca_statistics_supplied', 'coherence_is_projection_cosine', 'no_general_coherence_claim', 'sign_and_normalization', 'spectral_vs_whitened_bundled',
  'spectral_not_validated_by_raw', 'raw_vs_spectral_bundled', 'harmonic_sum_vs_joint_bundled', 'per_harmonic_discards_subspace', 'lower_bound_not_rounded',
  'learned_head_gain_unresolved', 'held_and_seen_separate', 'comparators_reused', 'release_audit_scope');
const ans9 = e.answers_not_run[0];
need(e.answers_not_run.length === 1 && ans9.card === 6 && ans9.item === 'simpler learned head on the CCA features' && ans9.same_inputs_as_card_6 === false
  && ans9.arms.join() === 'EIG-RAW,EIG-JOINT' && ans9.inputs === 'squared canonical correlations between the raw window and the harmonic references'
  && st(E).levels['EIG-JOINT/u8'] && (st(E) as any).design.arms.some((a: any) => a.code === 'EIG-JOINT'),
  'card 9 runs a simpler learned head on CCA statistics, which card 6 did not run, on other inputs');
need(e.checks.fits.total === 361 && e.checks.fits.main + e.checks.fits.independent_refits + e.checks.fits.bridges + e.checks.fits.canaries === e.checks.fits.total
  && e.checks.cca_identity.decisions_identical === true && e.checks.joint_top_equals_cca.passed && e.checks.same_scores_as_card_5.passed
  && e.checks.same_scores_as_card_8.passed && e.checks.coherence_zero_gate.gated_pairs === 0, 'card 9: the checks');
const c9Arms = [...e.design.arms, ...e.design.controls, ...e.design.comparators].map((a: any) => ({
  code: a.code, name: nm(E, a.code), training: [trainingWords(a.training, locale)] as Bit[],
  cells: ['u8', 'seen_ba'].map(t => levelCell(level(E, `${a.code}/${t}`), locale)),
}));
const c9Rows = contrastRows(E);

// --- Card 12: the harmonic gap ---------------------------------------------------------------------------------------
const g = st(G);
const gl = (code: string, t: string) => level(G, `${code}/${t}`);
const gJB = contrast(G, 'B minus J/u8'), gBS = contrast(G, 'S minus B/u8');
const gJBd = contrast(G, 'B minus J/dry'), gBSd = contrast(G, 'S minus B/dry'), gJBw = contrast(G, 'B minus J/wet'), gBSw = contrast(G, 'S minus B/wet');
need(g.family.members.join() === ['G true minus mean distractor/u8', 'B minus J/u8', 'S minus B/u8', 'G true minus mean distractor/dry', 'B minus J/dry', 'S minus B/dry',
  'G true minus mean distractor/wet', 'B minus J/wet', 'S minus B/wet'].join() && g.family.comparisons === bonferroni.comparisons
  && [gJB, gBS, gJBd, gBSd, gJBw, gBSw].every(c => c.role === 'primary' && c.flags.family_member === true && g.contrasts[c.key].interval_level === g.family.interval_level),
  'card 12: the nine-member primary family, its contrasts at the family level');
need(spansZero(gJB) && gBS.lo.raw > 0 && spansZero(gBSd) && gBSw.lo.raw > 0 && gJBd.lo.raw <= 0 && gJBd.hi.raw >= 0 && spansZero(gJBw)
  && g.family.resolved.join() === 'G true minus mean distractor/u8,S minus B/u8,G true minus mean distractor/dry,G true minus mean distractor/wet,S minus B/wet',
  'card 12: J to B unresolved in every cohort; B to S resolved on BETA and wet, not dry');
const gap = (k: string, t: string, fmtLo = 'sig3') => {
  const base = ['studies', G, 'gap', `${k}/${t}`];
  return { est: figAt([...base, 'estimate'], 'sig3'), lo: figAt([...base, 'interval', 0], 'sig3'), hi: figAt([...base, 'interval', 1], 'sig3'),
           level: g.gap[`${k}/${t}`].interval_level as number, base };
};
const T3 = ['u8', 'dry', 'wet'] as const;
need(T3.every(t => g.gap[`G true minus mean distractor/${t}`].role === 'primary' && g.gap[`G true minus mean distractor/${t}`].interval[0] > 0
  && g.gap[`G true minus mean distractor/${t}`].unit === 'difference of squared correlations') && g.family.all_gap_intervals_above_zero === true,
  'card 12: the true candidate’s gap exceeds the distractors’ mean in all three cohorts, in squared-correlation units');
need(g.identity.joint_cca_equals_top_eigenvalue_of_sum === false && g.identity.residual_reported_beside_gap === true
  && g.identity.reason === 'separate harmonic reference subspaces are generally not orthogonal over a finite window', 'card 12: the identity line');
need(g.transitions.decisions === 11200 && g.transitions.unit === 'share of all decisions on the task'
  && Object.values(g.transitions.edges).every((x: any) => Math.abs(x.wrong_to_right + x.right_to_wrong + x.unchanged_right + x.wrong_both - 1) < 1e-12
    && x.changed >= x.wrong_to_right + x.right_to_wrong - 1e-12), 'card 12: decision changes as shares of the 11,200 held-out decisions');
need(g.reference_check.BETA.candidates === 40 && g.reference_check.BETA.at_or_below_threshold === 8 && g.reference_check['Wearable-102'].at_or_below_threshold === 0
  && g.reference_check.label_free === true && g.reference_check.outcome_subgroups === false
  && g.reference_check.measure === 'cross-block Frobenius norm between the harmonic reference blocks' && g.reference_check.threshold <= 1e-10
  && g.reference_check.BETA.at_or_below_threshold + g.reference_check.BETA.above_threshold === g.reference_check.BETA.candidates
  && g.reference_check['Wearable-102'].at_or_below_threshold + g.reference_check['Wearable-102'].above_threshold === g.reference_check['Wearable-102'].candidates,
  'card 12: the reference check as counts, on the cross-block norm at a numerical-precision threshold; the other candidates above it');
need(Object.values(g.win_fractions).every((w: any) => w.accuracy === false && w.label === 'pairwise win fraction (not an accuracy)')
  && g.allocation.label === 'descriptive accounting', 'card 12: win fractions are not accuracies; the allocation is descriptive accounting');
keyed(G, 'family_intervals_govern', 'dry_bridge_unresolved', 'no_b_over_j_resolved', 'allocation_not_a_cause', 'no_training', 'joint_cca_not_top_eigenvalue_of_sum',
  'residual_signed', 'gap_in_score_units', 'win_fractions_not_accuracies', 'allocation_descriptive', 'secondary_intervals_descriptive', 'transitions_not_disjoint',
  'mean_distractor_not_strongest', 'gap_is_an_association', 'same_people_dry_wet', 'no_wet_dry_test', 'reference_check_label_free');
need(g.design.training_fits === 0 && g.design.scores.every((s: any) => s.training === 'no training'), 'card 12: no score is trained');
const famLevel = (k: string) => figAt(['studies', G, 'contrasts', k, 'interval_level'], 'pct2');
const c12Levels = ['J', 'B', 'S', 'JplusG'].map(code => ({ code, name: nm(G, code), cells: T3.map(t => levelCell(gl(code, t), locale)) }));
const c12Rows = contrastRows(G, c => c.flags.family_member ? [famLevel(c.key)] : ['95%']).map(r => ({ ...r,
  role: g.contrasts[r.k].flags.family_member ? (zh ? '主要（比较族）' : 'primary (family)') : r.role }));
need(Object.values(g.contrasts).every((c: any) => c.interval_level === (c.flags.family_member ? g.family.interval_level : 0.95)), 'card 12: family intervals at 99.44%, the rest at 95%');
const GAP_ROWS: [string, Record<'en' | 'zh', string>][] = [
  ['G true', { en: 'G, true candidate', zh: 'G，真实候选' }],
  ['G mean distractor', { en: 'G, mean of the distractors', zh: 'G，干扰项均值' }],
  ['G true minus mean distractor', { en: 'G, true minus mean distractor', zh: 'G，真实减去干扰项均值' }],
  ['R true minus mean distractor', { en: 'R, true minus mean distractor', zh: 'R，真实减去干扰项均值' }],
];
const gapRows = GAP_ROWS.map(([k, w]) => ({ k, name: w[locale], cells: T3.map(t => { const q = gap(k, t);
  return figCell(q.est, q.lo, q.hi, locale, [q.level === g.family.interval_level ? figAt([...q.base, 'interval_level'], 'pct2') : '95%'], to); }) }));
need(T3.every(t => g.gap[`R true minus mean distractor/${t}`].interval_level === 0.95 && g.gap[`G true/${t}`].interval_level === 0.95), 'card 12: the other gap rows at 95%');
const winRow = T3.map(t => { const b = ['studies', G, 'win_fractions', t]; return figCell(figAt([...b, 'estimate'], 'auc3'), figAt([...b, 'interval', 0], 'auc3'), figAt([...b, 'interval', 1], 'auc3'), locale, ['95%'], to); });
need(T3.every(t => g.win_fractions[t].interval_level === 0.95 && g.allocation[t].G.interval_level === 0.95 && g.allocation[t].R.interval_level === 0.95), 'card 12: 95% intervals on win fractions and the allocation');
const allocRows = (['G', 'R'] as const).map(q => ({ q, cells: T3.map(t => { const b = ['studies', G, 'allocation', t, q];
  return figCell(figAt([...b, 'estimate'], 'pp2'), figAt([...b, 'interval', 0], 'sgn2'), figAt([...b, 'interval', 1], 'sgn2'), locale, ['95%'], to); }) }));
const EDGE_FIELDS = ['wrong_to_right', 'right_to_wrong', 'changed', 'unchanged_right', 'wrong_both'] as const;
const edgeRows = Object.entries(g.transitions.edges as Record<string, any>).map(([k, x]) => ({ k,
  name: `${nm(G, x.from)} → ${nm(G, x.to)}`, cells: EDGE_FIELDS.map(f => figAt(['studies', G, 'transitions', 'edges', k, f], 'pct2')) }));
need(edgeRows.map(r => r.k).join() === 'J to B,B to S,J to S,J to JplusG,JplusG to S', 'card 12: the five steps');

const copy = {
  en: {
    q8: 'One set of learned weights, shared by every candidate frequency, scores each candidate’s channel-by-channel matrices at the fundamental and two harmonics. How far does that get?',
    lead8a: (): Bit[] => ['The cross-spectral ridge, one ridge readout over those matrices, reached ', ...lvBits(xRidge, locale), ' on held-out frequencies against ',
      ...lvBits(xShared, locale), ' for the shared ridge scorer: ', ...ctBits(xP1, locale), ', the first primary contrast. The cross-spectral MLP reached ',
      ...lvBits(xMlp, locale), ' against CCA’s ', ...lvBits(xCca, locale), ': ', ...ctBits(xP2, locale),
      ', the second primary contrast; it did not pass its prespecified non-inferiority test against CCA.'],
    lead8b: (): Bit[] => ['The whitened cross-spectral ridge reached ', ...lvBits(xW, locale), ': ', gapU8, ' from CCA on held-out frequencies and ', gapSeen,
      ' on seen ones. Each is the difference of two levels, with no planned contrast and no interval, so neither shows equivalence or non-inferiority. On the seen 32-way task every new arm is below CCA’s ',
      ...lvBits(xCcaSeen, locale), '.'],
    c8Summary: 'Every set-up on both tasks, and the contrasts with their roles',
    c8LevelsCaption: 'Card 8: accuracy on held-out frequencies and balanced accuracy on seen ones. The last four rows are card 5’s scores, which carry their intervals there.',
    c8ContrastsCaption: 'Card 8: paired differences, each with its own interval.',
    cap8: (): Bit[] => ['The scorer is not a fixed quadratic form of the raw EEG: its diagonals are logged and its normalisation depends on the trial. The MLP differs from the ridge in nonlinearity, loss, regularisation, optimiser and capacity at once, and its seeds are averaged, not ensembled. Whitening changes the features and what the scorer is given at the same time. The cross-spectral arms keep the Hann-tapered, cropped spectral coordinates while CCA reads the raw window, so a contrast against CCA changes the representation as well. The matrices hold within-harmonic terms only, not every second-order interaction across harmonics. The quadrature arm minus the plain ridge is ',
      ...ctBits(xQ, locale), ': the interval includes zero, so the direction is unresolved, which does not show quadrature information is useless to every model. The gain over the shared ridge scorer does not explain every earlier head’s failure. The cropped-spectrum match is context, not a ceiling for learned scorers. CCA, the shared ridge scorer, the cropped-spectrum match and the channel-energy average are ',
      ln(5), '’s scores, reused unchanged. ', ...intervalText(X, locale), '.'],
    checks8: (): Bit[] => ['Checks: ', countAt('studies', X, 'checks', 'fits', 'total'), ' fits (', countAt('studies', X, 'checks', 'fits', 'main'), ' main); CCA’s identity reproduced over ',
      countAt('studies', X, 'checks', 'cca_identity', 'pairs'), ' pairs; the release audit recomputed ', countAt('studies', X, 'checks', 'release_audit', 'metric_entries_recomputed'),
      ' metric entries without repeating the supervised fits.'],
    q9: 'A head on the eigenvalues of each harmonic’s matrix, learned or simply summed: what does learning add?',
    lead9a: (): Bit[] => ['A ridge head on the eigenvalues of the raw harmonic matrices, the eigenvalue head, reached ', ...lvBits(eRaw, locale),
      ' on held-out frequencies against CCA’s ', ...lvBits(eCca, locale), ': ', ...ctBits(eP1, locale),
      ', the first primary contrast, above zero and inside the equivalence and non-inferiority margins the protocol set in advance. The harmonic sum of the same statistics, with no training, reached ',
      ...lvBits(eSum, locale), '; the head minus the sum is ', ...ctBits(eHS, locale), ', unresolved.'],
    lead9b: (): Bit[] => ['The other two primary contrasts are negative. The coherence head reached ', ...lvBits(eCoh, locale), ' against the cross-spectral ridge’s ',
      ...lvBits(eXs, locale), ': ', ...ctBits(eP2, locale), '. The spectral eigenvalue head reached ', ...lvBits(eSpec, locale), ' against the whitened cross-spectral ridge’s ',
      ...lvBits(eXsW, locale), ': ', ...ctBits(eP3, locale), '.'],
    answers9: (): Bit[] => [lnC(6), ' listed a simpler learned head on the CCA features among the things it did not run. The eigenvalue head and the joint eigenvalue head are such heads; they read the squared canonical correlations between the raw window and the harmonic references, not card 6’s inputs.'],
    c9Summary: 'Every set-up on both tasks, and the contrasts with their roles',
    c9LevelsCaption: 'Card 9: accuracy on held-out frequencies and balanced accuracy on seen ones, a separate task. Comparators from cards 5 and 8 carry their intervals there.',
    c9ContrastsCaption: 'Card 9: paired differences, each with its own interval.',
    cap9: (): Bit[] => ['The eigenvalue head and the joint eigenvalue head are given statistics derived from CCA for each trial, so their contrasts against CCA and joint CCA do not isolate what learning adds. The coherence arms use normalised projection cosines, not a conventional (Welch) coherence estimate, so they say nothing about coherence in general. The coherence head against the signed one isolates sign removal; against the cross-spectral ridge it changes normalisation and sign handling together. The spectral eigenvalue head against the whitened ridge also changes the feature dimension and the effective regularisation, and it differs from the raw eigenvalue head in more than whitening, so the raw head’s result does not validate the spectral one. The harmonic sum against joint CCA changes pooling, spatial weights and overlapping subspaces together, and eigenvalues taken harmonic by harmonic discard how the harmonic subspaces relate. The spectral head minus the spectral harmonic sum is ',
      ...ctBits(eSS, locale), ': its lower bound is printed to five decimals because at two it would read as zero. ', ...intervalText(E, locale), '.'],
    checks9: (): Bit[] => ['Checks: ', countAt('studies', E, 'checks', 'fits', 'total'), ' fit operations (', countAt('studies', E, 'checks', 'fits', 'main'), ' main, ',
      countAt('studies', E, 'checks', 'fits', 'independent_refits'), ' independent refits); the eigenvalue identity reproduces CCA’s squared correlation, with identical decisions, over ',
      countAt('studies', E, 'checks', 'cca_identity', 'pairs'), ' pairs; the zero-energy rule gated ', countAt('studies', E, 'checks', 'coherence_zero_gate', 'gated_pairs'), ' of ',
      countAt('studies', E, 'checks', 'coherence_zero_gate', 'of'), ' pairs. The comparators equal the scores of ', ln(5), ' and ', ln(8), '.'],
    q12: 'Joint CCA and the harmonic sum read the same three harmonic references. Which step gives the sum its gain?',
    lead12a: (): Bit[] => ['On BETA’s held-out frequencies the path runs from joint CCA, ', ...lvBits(gl('J', 'u8'), locale), ', to the common-direction sum, ', ...lvBits(gl('B', 'u8'), locale),
      ', to the harmonic sum, ', ...lvBits(gl('S', 'u8'), locale), '. Joint CCA to the common-direction sum: ', ...ctBits(gJB, locale), '; the common-direction sum to the harmonic sum: ',
      ...ctBits(gBS, locale), '. Both are ', famLevel(gJB.key), ' intervals of a Bonferroni family over ', said(g.family.comparisons, locale), ' comparisons, the primary family.'],
    lead12b: (): Bit[] => { const q = (t: string) => gap('G true minus mean distractor', t);
      return ['The true candidate’s relaxation gap G exceeds the distractors’ mean in all three cohorts, in squared-correlation units, not percentages: BETA ', q('u8').est, ' (', q('u8').lo, to, q('u8').hi,
        '), Wearable-102 dry ', q('dry').est, ' (', q('dry').lo, to, q('dry').hi, ') and wet ', q('wet').est, ' (', q('wet').lo, to, q('wet').hi, ').']; },
