    colName: 'Set-up', colTraining: 'Training', colHeld: 'Held-out 8-way', colSeen: 'Seen 32-way, balanced', colContrast: 'Contrast', colTask: 'Task', colRole: 'Role',
    colDiff: 'Difference', colScore: 'Score', colQuantity: 'Quantity', colStep: 'Step', colShare: 'Share',
    colBeta: 'BETA held-out', colDry: 'Wearable-102 dry', colWet: 'Wearable-102 wet',
    region: (n: number, what: string) => `Card ${n}: ${what}, scrolls horizontally`,
  },
  zh: {
    q8: '一组由所有候选频率共享的学习权重，给每个候选频率在基频与两个谐波上的通道×通道矩阵打分，能走多远？',
    lead8a: (): Bit[] => ['互谱矩阵岭回归，即在这些矩阵上的一个岭回归读出，在留出频率上达到 ', ...lvBits(xRidge, locale), '，共享岭回归打分器为 ',
      ...lvBits(xShared, locale), '：', ...ctBits(xP1, locale), '，这是第一项主要对比。互谱 MLP 达到 ',
      ...lvBits(xMlp, locale), '，CCA 为 ', ...lvBits(xCca, locale), '：', ...ctBits(xP2, locale),
      '，这是第二项主要对比；它没有通过预先设定的相对 CCA 的非劣效检验。'],
    lead8b: (): Bit[] => ['白化互谱矩阵岭回归达到 ', ...lvBits(xW, locale), '：在留出频率上与 CCA 相差 ', gapU8, '，在见过的频率上相差 ', gapSeen,
      '。两者都是两个水平之差，没有计划内的对比，也没有区间，因此都不说明等效或非劣效。在见过频率的 32 选 1 任务上，每个新设置都低于 CCA 的 ',
      ...lvBits(xCcaSeen, locale), '。'],
    c8Summary: '两项任务上的全部设置，以及各对比及其角色',
    c8LevelsCaption: '卡片 8：留出频率上的准确率与见过频率上的平衡准确率。最后四行是卡片 5 的分数，区间在卡片 5 上。',
    c8ContrastsCaption: '卡片 8：配对差值，各带自己的区间。',
    cap8: (): Bit[] => ['这个打分器不是原始 EEG 的固定二次型：对角项取了对数，归一化随试次而变。MLP 与岭回归同时在非线性、损失函数、正则化、优化器和容量上不同，它的各随机种子取平均，而不是做集成。白化同时改变了特征和打分器得到的信息。互谱各组保留 Hann 窗、裁剪后的频谱坐标，而 CCA 读的是原始时间窗，所以相对 CCA 的对比同时也改变了表示方式。这些矩阵只含谐波内部的项，并非跨谐波的全部二阶交互。带正交分量的岭回归减去普通岭回归为 ',
      ...ctBits(xQ, locale), '：区间包含零，方向未定，这并不说明正交分量的信息对所有模型都无用。相对共享岭回归打分器的增益也不能解释此前每个分类头的失败。裁剪谱匹配只作参照，不是学习型打分器的上限。CCA、共享岭回归打分器、裁剪谱匹配和通道能量平均是',
      ln(5), ' 的分数，原样沿用。', ...intervalText(X, locale), '。'],
    checks8: (): Bit[] => ['检查：共 ', countAt('studies', X, 'checks', 'fits', 'total'), ' 次拟合（主要拟合 ', countAt('studies', X, 'checks', 'fits', 'main'), ' 次）；CCA 的恒等式在 ',
      countAt('studies', X, 'checks', 'cca_identity', 'pairs'), ' 个配对上得到复现；发布审计重新计算了 ', countAt('studies', X, 'checks', 'release_audit', 'metric_entries_recomputed'),
      ' 项指标，没有重做有监督的拟合。'],
    q9: '在每个谐波矩阵的特征值上，学习一个分类头或直接求和：学习多带来了什么？',
    lead9a: (): Bit[] => ['在原始谐波矩阵的特征值上的岭回归分类头，即特征值分类头，在留出频率上达到 ', ...lvBits(eRaw, locale),
      '，CCA 为 ', ...lvBits(eCca, locale), '：', ...ctBits(eP1, locale),
      '，这是第一项主要对比，高于零，且落在协议事先设定的等效界值与非劣效界值之内。对同样的统计量直接求和、无需训练的谐波求和达到 ',
      ...lvBits(eSum, locale), '；分类头减去求和为 ', ...ctBits(eHS, locale), '，方向未定。'],
    lead9b: (): Bit[] => ['另外两项主要对比为负。相干分类头达到 ', ...lvBits(eCoh, locale), '，互谱矩阵岭回归为 ',
      ...lvBits(eXs, locale), '：', ...ctBits(eP2, locale), '。频谱特征值分类头达到 ', ...lvBits(eSpec, locale), '，白化互谱矩阵岭回归为 ',
      ...lvBits(eXsW, locale), '：', ...ctBits(eP3, locale), '。'],
    answers9: (): Bit[] => [ln(6), ' 把“在 CCA 特征上更简单的学习型分类头”列为没有运行的部分。特征值分类头与联合特征值分类头正是这样的分类头；它们读取原始时间窗与谐波参考之间的典型相关平方，而不是卡片 6 的输入。'],
    c9Summary: '两项任务上的全部设置，以及各对比及其角色',
    c9LevelsCaption: '卡片 9：留出频率上的准确率与见过频率上的平衡准确率，后者是另一项任务。来自卡片 5 和 8 的对照，区间在原卡片上。',
    c9ContrastsCaption: '卡片 9：配对差值，各带自己的区间。',
    cap9: (): Bit[] => ['特征值分类头与联合特征值分类头得到的是逐试次从 CCA 导出的统计量，所以它们相对 CCA 与联合 CCA 的对比不能单独说明学习的作用。相干各组用的是归一化的投影余弦，不是常规的（Welch）相干估计，因此不涉及一般意义上的相干。相干分类头与带符号的相干分类头相比，只去掉了符号；与互谱矩阵岭回归相比，则同时改变了归一化和符号处理。频谱特征值分类头与白化岭回归相比，还改变了特征维度和实际的正则化强度；它与原始特征值分类头的差别也不止白化，所以原始分类头的结果不能验证频谱分类头。谐波求和与联合 CCA 相比，同时改变了汇总方式、空间权重和相互重叠的子空间；逐个谐波取特征值，会丢掉各谐波子空间之间的关系。频谱分类头减去频谱谐波求和为 ',
      ...ctBits(eSS, locale), '：下界印到五位小数，因为保留两位时会显示为零。', ...intervalText(E, locale), '。'],
    checks9: (): Bit[] => ['检查：共 ', countAt('studies', E, 'checks', 'fits', 'total'), ' 次拟合操作（主要拟合 ', countAt('studies', E, 'checks', 'fits', 'main'), ' 次，独立重新拟合 ',
      countAt('studies', E, 'checks', 'fits', 'independent_refits'), ' 次）；特征值恒等式在 ',
      countAt('studies', E, 'checks', 'cca_identity', 'pairs'), ' 个配对上复现了 CCA 的相关平方，决策完全一致；零能量规则在 ', countAt('studies', E, 'checks', 'coherence_zero_gate', 'of'), ' 个配对中拦下 ',
      countAt('studies', E, 'checks', 'coherence_zero_gate', 'gated_pairs'), ' 个。各对照与', ln(5), ' 和', ln(8), ' 的分数一致。'],
    q12: '联合 CCA 与谐波求和读取的是同样三个谐波参考。谐波求和的增益来自哪一步？',
    lead12a: (): Bit[] => ['在 BETA 的留出频率上，路径从联合 CCA 的 ', ...lvBits(gl('J', 'u8'), locale), '，到共同方向求和的 ', ...lvBits(gl('B', 'u8'), locale),
