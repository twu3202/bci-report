    diag7: (): Bit[] => [nm(W, 'CCA-CROP'), '的干电极为 ', L7('CCA-CROP/dry'), '、湿电极为 ', L7('CCA-CROP/wet'), '；它只作为诊断列出。'],
    c7Caption: (): Bit[] => ['卡片 7：在 Wearable-102 的 ', count(wearable.targets), ' 个目标之间选择的准确率，按电极类型列出，附 95% 区间。'],
    c7Region: '卡片 7 的 Wearable-102 结果，可横向滚动',
    colStratum: 'Wearable-102 电极类型', colChange: '相对匹配 CCA 的变化', colCrop: '裁剪谱检查（Wearable-102），仅作诊断',
    stratum: { dry: 'Wearable-102，干电极', wet: 'Wearable-102，湿电极', all: 'Wearable-102，两种电极合并' },
    role: { primary: '主要对比', secondary: '次要对比' }, windowsWord: ' 个时间窗',
    limitsLabel: '局限：',
    limits7: (): Bit[] => ['Wearable-102 存储的幅值单位没有文档说明，而修正项读取的是幅度谱，所以这些数字都基于原样存储的记录。它的时间窗从刺激开始后 ', dec2(wd.dataset.window_s[0]),
      ' s 起，BETA 的时间窗从刺激开始时起；硬件、参考电极、被试和频率网格也同时改变，因此无法分离出单一因素。两种方法都获得这 ', count(wearable.targets),
      ' 个候选频率。每名被试的准确率对 ', count(wsm.models), ' 个模型分别计算，先在模型上平均，再在被试上平均；没有集成、重新拟合或模型挑选。这一任务基于另一批记录，与卡片 1 至 6 的 BETA 结果分开看待。'],
    cap7: (): Bit[] => ['干电极与湿电极为两个主要对比，两种电极合并为次要对比。', ...intervalText(W, locale), '；未做多重比较校正。'],

    colContrast: '对比', colHeld: '留出频率，8 选 1', colSeen: '见过的频率，32 类平衡', colNote: '说明', colName: '本页名称', colCode: '导出代码',
    colOutcome: '判断的变化', colCounts: '统计的是什么',
    outcome: {
      wrong_to_right: ['由错改对', 'CCA 单独时选错了频率，加修正后判断正确。'],
      right_to_wrong: ['由对改错', 'CCA 单独时选对了频率，加修正后判断错误。'],
      wrong_to_different_wrong: ['由错改为另一个错', '两次判断都错，但选的频率不同。'],
      unchanged_right: ['未变，正确', '两者都选对了频率。'],
      unchanged_wrong: ['未变，错误', '两者选了同一个错误频率。'],
      changed: ['共改变', '前三行之和。'],
    } as Record<(typeof OUTCOMES)[number], [string, string]>,
  },
}[locale];
need(siteName('matched CCA', 'en') === wz.display_names['CCA-RAW'] && wz.display_names['RAW-RESIDUAL'] === az.display_names['RAW-RESIDUAL'],
  'card 7’s names: matched CCA, and the card 6 model');
const transRows = OUTCOMES.map(k => ({ k, words: copy.outcome[k], cells: TASKS.map(t => pct2(tr[t][k])) }));
const heads7 = [copy.colStratum, cap(nm(W, 'RAW-RESIDUAL')), cap(nm(W, 'CCA-RAW')), copy.colChange, copy.colCrop];
const [c5, c6, c7] = sections;
---
<section class="topic-section ssvep-card" id={c5.anchor} aria-labelledby={c5.headingId} data-ssvep-card={c5.card}>
  <div class="topic-heading"><div><p class="eyebrow">{c5.eyebrow}</p><h2 id={c5.headingId}>{c5.title}</h2></div><p data-ssvep-note="question">{copy.q5}</p></div>
  <p class="roadmap-p" data-ssvep-note="lead">{copy.lead5a().map(b => typeof b === 'string' ? b : isLink(b) ? <a href={b.href}>{b.text}</a> : <span data-fig={figAttr(b)}>{show(b)}</span>)}</p>
  <p class="roadmap-p" data-ssvep-note="lead">{copy.lead5b().map(b => typeof b === 'string' ? b : isLink(b) ? <a href={b.href}>{b.text}</a> : <span data-fig={figAttr(b)}>{show(b)}</span>)}</p>
  <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.c5Region}>
    <table data-ssvep-table="c5-contrasts">
      <caption>{copy.c5Caption}</caption>
      <thead><tr><th scope="col">{copy.colContrast}</th><th scope="col">{copy.colHeld}</th><th scope="col">{copy.colSeen}</th><th scope="col">{copy.colNote}</th></tr></thead>
      <tbody>{c5Rows.map(r => <tr data-contrast={r.stem}>
        <th scope="row">{r.name}</th>
        {r.cells.map(c => <td><span data-fig={figAttr(c.est)} class="metric">{show(c.est)}</span><span class="interval">{tc.interval95} {c.iv.map(p => typeof p === 'string' ? p : <span data-fig={figAttr(p)}>{show(p)}</span>)}</span></td>)}
        <td>{r.notes.length ? r.notes.join(zh ? '' : ' ') : '—'}</td>
      </tr>)}</tbody>
    </table>
  </div>
  <details class="rd-panel" data-ssvep-details="c5-levels">
    <summary>{copy.c5Summary}</summary>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.c5LevelsRegion}>
      <table data-ssvep-table="c5-levels">
        <caption>{copy.c5LevelsCaption}</caption>
        <thead><tr><th scope="col">{copy.colName}</th><th scope="col">{copy.colCode}</th><th scope="col">{copy.colHeld}</th><th scope="col">{copy.colSeen}</th></tr></thead>
        <tbody>{c5Levels.map(r => <tr data-arm={r.code}>
          <th scope="row">{r.name}{r.training && <small>{r.training}</small>}</th>
          <td><code>{r.code}</code></td>
          {r.cells.map(c => <td><span data-fig={figAttr(c.est)} class="metric">{show(c.est)}</span><span class="interval">{tc.interval95} {c.iv.map(p => typeof p === 'string' ? p : <span data-fig={figAttr(p)}>{show(p)}</span>)}</span></td>)}
        </tr>)}</tbody>
      </table>
    </div>
  </details>
  <p class="protocol-note" data-ssvep-note="caption">{copy.cap5().map(b => typeof b === 'string' ? b : isLink(b) ? <a href={b.href}>{b.text}</a> : <span data-fig={figAttr(b)}>{show(b)}</span>)}</p>
  <p class="protocol-note" data-ssvep-note="checks">{copy.scale5().map(b => typeof b === 'string' ? b : isLink(b) ? <a href={b.href}>{b.text}</a> : <span data-fig={figAttr(b)}>{show(b)}</span>)}</p>
</section>

<section class="topic-section ssvep-card" id={c6.anchor} aria-labelledby={c6.headingId} data-ssvep-card={c6.card}>
  <div class="topic-heading"><div><p class="eyebrow">{c6.eyebrow}</p><h2 id={c6.headingId}>{c6.title}</h2></div><p data-ssvep-note="question">{copy.q6}</p></div>
  <p class="roadmap-p" data-ssvep-note="lead">{copy.lead6().map(b => typeof b === 'string' ? b : isLink(b) ? <a href={b.href}>{b.text}</a> : <span data-fig={figAttr(b)}>{show(b)}</span>)}</p>
  <p class="protocol-note" data-ssvep-note="caption">{copy.cap6().map(b => typeof b === 'string' ? b : isLink(b) ? <a href={b.href}>{b.text}</a> : <span data-fig={figAttr(b)}>{show(b)}</span>)}</p>
  <details class="rd-panel" data-ssvep-details="c6-tables">
    <summary>{copy.c6Summary}</summary>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.c6ArmsRegion}>
      <table data-ssvep-table="c6-arms">
        <caption>{copy.c6ArmsCaption}</caption>
        <thead><tr><th scope="col">{copy.colName}</th><th scope="col">{copy.colCode}</th><th scope="col">{copy.colHeld}</th><th scope="col">{copy.colSeen}</th></tr></thead>
        <tbody>{c6Arms.map(r => <tr data-arm={r.code}>
          <th scope="row">{r.name}{r.training && <small>{r.training}</small>}</th>
          <td><code>{r.code}</code></td>
          {r.cells.map(c => <td><span data-fig={figAttr(c.est)} class="metric">{show(c.est)}</span><span class="interval">{tc.interval95} {c.iv.map(p => typeof p === 'string' ? p : <span data-fig={figAttr(p)}>{show(p)}</span>)}</span></td>)}
        </tr>)}</tbody>
      </table>
    </div>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.c6ContrastsRegion}>
      <table data-ssvep-table="c6-contrasts">
        <caption>{copy.c6ContrastsCaption}</caption>
        <thead><tr><th scope="col">{copy.colContrast}</th><th scope="col">{copy.colHeld}</th><th scope="col">{copy.colSeen}</th><th scope="col">{copy.colNote}</th></tr></thead>
        <tbody>{c6Rows.map(r => <tr data-contrast={r.stem}>
          <th scope="row">{r.name}</th>
          {r.cells.map(c => <td><span data-fig={figAttr(c.est)} class="metric">{show(c.est)}</span><span class="interval">{tc.interval95} {c.iv.map(p => typeof p === 'string' ? p : <span data-fig={figAttr(p)}>{show(p)}</span>)}</span></td>)}
          <td>{r.notes.length ? r.notes.join(zh ? '' : ' ') : '—'}</td>
        </tr>)}</tbody>
      </table>
    </div>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.c6TransRegion}>
      <table data-ssvep-table="c6-transitions">
        <caption>{copy.c6TransCaption().map(b => typeof b === 'string' ? b : isLink(b) ? <a href={b.href}>{b.text}</a> : <span data-fig={figAttr(b)}>{show(b)}</span>)}</caption>
        <thead><tr><th scope="col">{copy.colOutcome}</th><th scope="col">{copy.colHeld}</th><th scope="col">{copy.colSeen}</th><th scope="col">{copy.colCounts}</th></tr></thead>
        <tbody>{transRows.map(r => <tr data-transition={r.k}>
          <th scope="row">{r.words[0]}</th>
          {r.cells.map(f => <td><span data-fig={figAttr(f)} class="metric">{show(f)}</span></td>)}
          <td>{r.words[1]}</td>
        </tr>)}</tbody>
      </table>
    </div>
    <p class="protocol-note" data-ssvep-note="protected">{copy.protected6().map(b => typeof b === 'string' ? b : isLink(b) ? <a href={b.href}>{b.text}</a> : <span data-fig={figAttr(b)}>{show(b)}</span>)}</p>
  </details>
</section>

<section class="topic-section ssvep-card" id={c7.anchor} aria-labelledby={c7.headingId} data-ssvep-card={c7.card}>
  <div class="topic-heading"><div><p class="eyebrow">{c7.eyebrow}</p><h2 id={c7.headingId}>{c7.title}</h2></div><p data-ssvep-note="question">{copy.q7}</p></div>
  <p class="roadmap-p ssvep-scope" data-ssvep-scope="card-7">{copy.scope7().map(b => typeof b === 'string' ? b : isLink(b) ? <a href={b.href}>{b.text}</a> : <span data-fig={figAttr(b)}>{show(b)}</span>)}</p>
  <p class="roadmap-p" data-ssvep-note="lead">{copy.lead7().map(b => typeof b === 'string' ? b : isLink(b) ? <a href={b.href}>{b.text}</a> : <span data-fig={figAttr(b)}>{show(b)}</span>)}</p>
  <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.c7Region}>
    <table data-ssvep-table="c7-wearable">
      <caption>{copy.c7Caption().map(b => typeof b === 'string' ? b : isLink(b) ? <a href={b.href}>{b.text}</a> : <span data-fig={figAttr(b)}>{show(b)}</span>)}</caption>
      <thead><tr>{heads7.map(h => <th scope="col">{h}</th>)}</tr></thead>
      <tbody>{wRows.map(r => <tr data-stratum={r.k} data-role={r.role}>
        <th scope="row">{copy.stratum[r.k]}<small>{copy.role[r.role]} · <span data-fig={figAttr(r.windows)}>{show(r.windows)}</span>{copy.windowsWord}</small></th>
        {[r.model, r.cca, r.change, r.crop].map(c => <td><span data-fig={figAttr(c.est)} class="metric">{show(c.est)}</span><span class="interval">{tc.interval95} {c.iv.map(p => typeof p === 'string' ? p : <span data-fig={figAttr(p)}>{show(p)}</span>)}</span></td>)}
      </tr>)}</tbody>
    </table>
  </div>
  <p class="roadmap-p" data-ssvep-note="a2-cca">{copy.a2().map(b => typeof b === 'string' ? b : isLink(b) ? <a href={b.href}>{b.text}</a> : <span data-fig={figAttr(b)}>{show(b)}</span>)}</p>
  <p class="roadmap-p" data-ssvep-note="wearable-diagnostic">{copy.diag7().map(b => typeof b === 'string' ? b : isLink(b) ? <a href={b.href}>{b.text}</a> : <span data-fig={figAttr(b)}>{show(b)}</span>)}</p>
  <p class="protocol-note" data-ssvep-note="limits"><strong>{copy.limitsLabel}</strong>{zh ? '' : ' '}{copy.limits7().map(b => typeof b === 'string' ? b : isLink(b) ? <a href={b.href}>{b.text}</a> : <span data-fig={figAttr(b)}>{show(b)}</span>)}</p>
  <p class="protocol-note" data-ssvep-note="caption">{copy.cap7().map(b => typeof b === 'string' ? b : isLink(b) ? <a href={b.href}>{b.text}</a> : <span data-fig={figAttr(b)}>{show(b)}</span>)}</p>
</section>

<style is:global>
  /* Global, not scoped (the page's contract: a scoped style would add data-astro-cid-* to every element, and
     check-workbench.mjs reads figures by their exact markup). Every selector starts from one of these cards. */
  :is([data-ssvep-card="5"],[data-ssvep-card="6"],[data-ssvep-card="7"]) .topic-table th[scope=row] small{display:block;margin-top:3px;font-size:.7rem;font-weight:400;color:var(--muted);line-height:1.4}
  :is([data-ssvep-card="5"],[data-ssvep-card="6"]) .topic-table td code{font-family:var(--mono);font-size:.72rem}
  :is([data-ssvep-card="5"],[data-ssvep-card="6"],[data-ssvep-card="7"]) .topic-table td:last-child:not(:has(.metric)){font-size:.8rem;color:var(--muted)}
  /* The column floor is for wide screens; phones stack the table (stack-tables.ts). */
  @media (min-width:641px){:is([data-ssvep-card="5"],[data-ssvep-card="6"],[data-ssvep-card="7"]) .topic-table td:last-child:not(:has(.metric)){min-width:220px}}
  :is([data-ssvep-card="5"],[data-ssvep-card="6"],[data-ssvep-card="7"]) p.roadmap-p a{color:var(--accent)}
</style>
