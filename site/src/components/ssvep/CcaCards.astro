---
/**
 * Cards 5, 6 and 7 of /topics/new-ssvep-frequencies/ (package P-SS4): #cca-mechanism (the CCA diagnostics),
 * #cca-correction (the CCA adapter) and #wearable-transfer (the card 6 models run unchanged on Wearable-102).
 *
 * Copy: plan §2.1 cards 5–7 as the adapter binding review (§3) corrects it, with card 5's lower bound for the cropped
 * match minus Hann-tapered CCA as the export prints it, card 7's CCA sentence from the Wearable-102 CCA definition note
 * (A2), and the reading's caveat block. Every figure is a leaf of new-ssvep-frequencies-update.json printed with
 * data-fig; the adapter's gain prints from its own field, never as a difference of printed levels; transitions are
 * shares of all decisions on the task; every 73.2x value carries its study and task, and every Wearable value
 * "Wearable-102". The cards name the interval method in their captions; the page's #methods-and-limits lists what was
 * not run. No link to the thread (the page's intro line has it).
 *
 * Props
 *   locale: Locale — 'en' or 'zh'. Every word is in the copy map below (Chinese beside English); words for the
 *     export's own strings (variants, training, limitation keys, bundled changes) are keyed by the export's English,
 *     so a changed export fails the build instead of printing other words.
 *
 * One format is local: num1, the adapter's protected margin (0.200001) at one decimal, "0.2" (plan §2.1 card 6; F4).
 * new-ssvep-frequencies.ts formatSsvep and the page's check do not know it yet; show() prints it here.
 *
 * Styles: the existing classes (topics.css) and the page's p.ssvep-scope; the small global block at the end starts
 * every selector from this component's own card attribute, as the page's contract asks.
 */
import type { Locale } from '../../data/i18n';
import { hrefFor, topicCards, topicChrome } from '../../data/i18n';
import {
  SSVEP, needFor, pct2, count, fig, formatSsvep, figAttr, study, level, contrast, levelFig, contrastFig, levelIv,
  contrastIv, undefinedReason, cardChrome, cardOfStudy, cohort, wearable, siteName, nameOf, intervalText,
  type Part, type SsvepFig, type SsvepFmt, type StudyId,
} from '../../data/new-ssvep-frequencies';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const tc = topicChrome[locale];
const need = needFor('new-ssvep-frequencies cards 5–7');
const sections = ([5, 6, 7] as const).map(n => cardChrome(n, locale));

// --- Figures, words, links ---------------------------------------------------------------------------------------
type Link = { href: string; text: string };
type Bit = string | SsvepFig | Link;
const isLink = (b: Bit): b is Link => typeof b === 'object' && 'href' in b;
/** The protected margin at one decimal ("0.2"): the one figure on these cards outside formatSsvep's formats. */
const num1 = (raw: number): SsvepFig => {
  need(typeof raw === 'number' && Number.isFinite(raw), 'a finite margin');
  return { raw, fmt: 'num1' as unknown as SsvepFmt, src: SSVEP };
};
const show = (f: SsvepFig): string => (f.fmt as string) === 'num1' ? f.raw.toFixed(1).replace(/^-/, '−') : formatSsvep(f);
/** A plain number at two decimals (Hz, seconds): entities.ts auc2 is raw.toFixed(2). */
const dec2 = (raw: number) => fig(raw, 'auc2');
const to = zh ? ' 至 ' : ' to ';
const liv = (id: StudyId, key: string): Part[] => levelIv(id, key, '–');
const civ = (id: StudyId, key: string): Part[] => contrastIv(id, key, to);
const cap = (s: string) => zh ? s : s.charAt(0).toUpperCase() + s.slice(1);
const nm = (id: StudyId, code: string) => nameOf(id, code, locale);
// By the page's path, not a bare '#': the Markdown copy drops in-page jump links with their text.
const cardLink = (n: 2 | 6, text: string): Link => ({ href: hrefFor(`/topics/new-ssvep-frequencies/#${cardChrome(n, locale).anchor}`, locale), text });
const words = (m: Record<string, Record<Locale, string>>, key: string, what: string): string => {
  need(key in m, `words for ${what} "${key}"`);
  return m[key][locale];
};
const D: StudyId = 'cca_diagnostics', A: StudyId = 'cca_adapter', W: StudyId = 'wearable_transfer';
need(cardOfStudy(D) === 5 && cardOfStudy(A) === 6 && cardOfStudy(W) === 7 && cardOfStudy('ref2') === 2, 'cards 5, 6 and 7 read the CCA studies; card 2 the earlier heads');
const dz = study(D), az = study(A), wz = study(W);

// The export's English, in both languages.
const VARIANT: Record<string, Record<Locale, string>> = {
  'centred': { en: 'centred', zh: '中心化' },
  'uncentred': { en: 'uncentred', zh: '未中心化' },
  'joint reference span': { en: 'joint reference span', zh: '联合参考子空间' },
  'per-harmonic spans': { en: 'per-harmonic spans', zh: '逐谐波子空间' },
};
const TRAINING: Record<string, Record<Locale, string>> = {
  'no training': { en: 'no training', zh: '无需训练' },
  'ridge fitted on source people': { en: 'ridge fitted on the source people', zh: '在源被试上拟合的岭回归' },
  'trained on source people and seen frequencies': { en: 'trained on the source people and seen frequencies', zh: '在源被试与见过的频率上训练' },
};
const BUNDLE: Record<string, Record<Locale, string>> = {
  'cross-channel mixing': { en: 'cross-channel mixing', zh: '跨通道混合' },
  'fitting the reference coefficients': { en: 'fitting the reference coefficients', zh: '拟合参考系数' },
  'aggregation': { en: 'aggregation', zh: '聚合方式' },
  'several matching operations': { en: 'several matching operations', zh: '多项匹配运算' },
};
const bundleList = (items: string[], l: Locale): string => {
  const w = items.map(x => { need(x in BUNDLE, `words for the bundled change "${x}"`); return BUNDLE[x][l]; });
  return l === 'zh' ? w.join('、') : w.length > 2 ? `${w.slice(0, -1).join(', ')}, and ${w.at(-1)}` : w.join(' and ');
};

// --- Card 5: the CCA diagnostics -----------------------------------------------------------------------------------
const HANN = 'CCA-HANN-C minus CCA-RAW', HANN_UC = 'CCA-HANN-U minus CCA-HANN-C', CROP_HANN = 'SUBSPACE-CROP minus CCA-HANN-U',
  CROP_ENERGY = 'SUBSPACE-CROP minus CHANNEL-JOINT', ENERGY_HJ = 'CHANNEL-HARMONIC minus CHANNEL-JOINT',
  RIDGE_AVG = 'SHARED-RIDGE minus CHANNEL-HARMONIC', RIDGE_CCA = 'SHARED-RIDGE minus CCA-RAW';
const STEMS5 = [HANN, HANN_UC, CROP_HANN, CROP_ENERGY, ENERGY_HJ, RIDGE_AVG, RIDGE_CCA];
const TASKS = ['u8', 'seen_ba'] as const;
const below = (x: { interval: [number, number] }) => x.interval[1] < 0, above = (x: { interval: [number, number] }) => x.interval[0] > 0;
const spans = (x: { interval: [number, number] }) => x.interval[0] < 0 && x.interval[1] > 0;
const sidesOf = (id: StudyId, key: string) => { const c = contrast(id, key); return [c.left.split('/')[0], c.right.split('/')[0]]; };

need(Object.keys(dz.contrasts).join('|') === STEMS5.flatMap(s => TASKS.map(t => `${s}/${t}`)).join('|')
  && Object.values(dz.contrasts).every(c => c.role === 'prespecified' && c.people === cohort.people),
  'seven prespecified contrasts on each of the two tasks, 70 people');
need(dz.interval_method.method === 'paired person bootstrap, percentile interval' && dz.interval_method.conditional_on === undefined,
  'card 5: a person bootstrap');
need(level(D, 'CCA-RAW/u8').seeds === 'no training' && sidesOf(D, `${HANN}/u8`).join() === 'CCA-HANN-C,CCA-RAW'
  && below(contrast(D, `${HANN}/u8`)) && contrast(D, `${HANN}/u8`).estimate < 0, 'the Hann taper lowered CCA on held-out frequencies');
need(sidesOf(D, `${CROP_HANN}/u8`).join() === 'SUBSPACE-CROP,CCA-HANN-U' && TASKS.every(t => spans(contrast(D, `${CROP_HANN}/${t}`)))
  && (dz.contrast_limitations[`${CROP_HANN}/u8`] ?? []).includes('crop_vs_hann_unresolved'), 'the cropped match minus Hann-tapered CCA: both intervals span zero');
need(dz.design.scorers.find((s: { code: string }) => s.code === 'SUBSPACE-CROP')?.training === 'no training'
  && dz.display_names['SUBSPACE-CROP'] === 'cropped-spectrum match (no training)', 'the cropped-spectrum match has no training');
need(dz.limitations_keys.includes('coordinates_before_scaler') && dz.limitations_keys.includes('crop_changes_metric')
  && dz.checks.cropped_coordinates_match_earlier_cache?.passed === true, 'the match reads the earlier heads’ coordinates before their fitted scaling');
const EARLIER = { fs: 'L0c-FS-REFc-0/u8', match: 'L0c-MATCH-REFc-0/u8' };
need(study('ref2').display_names.L0c === 'complex spectrum' && study('ref2').display_names.FS === 'FiLM head'
  && study('ref2').display_names.MATCH === 'matching head' && study('ref2').display_names['REFc-0'] === 'reference with stimulus phase'
  && level('ref2', EARLIER.fs).seeds === cohort.training_seeds && level('ref2', EARLIER.match).seeds === cohort.training_seeds,
  'the earlier complex-spectrum heads: the FiLM and matching heads asked with the reference with stimulus phase (card 2)');
need(dz.limitations_keys.includes('earlier_heads_descriptive')
  && dz.not_run.some((x: { item: string }) => x.item === 'paired contrast with the earlier complex-spectrum heads'), 'the earlier heads are quoted with no paired contrast');
need(level(D, 'CHANNEL-JOINT/u8').estimate === level(D, 'CHANNEL-HARMONIC/u8').estimate
  && level(D, 'CCA-HANN-C/u8').estimate === level(D, 'CCA-HANN-U/u8').estimate, 'the two energy variants and the two Hann variants score alike');
for (const s of [HANN_UC, ENERGY_HJ]) for (const t of TASKS) {
  const c = contrast(D, `${s}/${t}`);
  need(c.estimate === 0 && c.flags?.identical_results === true && (dz.contrast_limitations[`${s}/${t}`] ?? []).includes('identical_results_different_definitions'),
    `${s} on ${t}: identical results from different definitions`);
}
const ridge = dz.design.scorers.find((s: { code: string }) => s.code === 'SHARED-RIDGE');
need(ridge?.training === 'ridge fitted on source people' && ridge?.fits === cohort.card5.ridge_fits && dz.design.ridge_fits === cohort.card5.ridge_fits
  && dz.design.harmonics === 3, 'one ridge scorer fitted on the source people, 35 fits, over three harmonics');
need(above(contrast(D, `${RIDGE_AVG}/u8`)) && below(contrast(D, `${RIDGE_CCA}/u8`)) && spans(contrast(D, `${RIDGE_AVG}/seen_ba`))
  && (dz.contrast_limitations[`${RIDGE_AVG}/u8`] ?? []).includes('ridge_no_seen_gain'),
  'the ridge scorer: above the energy average on held-out frequencies, below CCA, its seen interval spanning zero');
const bundled5 = contrast(D, `${CROP_ENERGY}/u8`).flags?.bundles as string[];
need(Array.isArray(bundled5) && bundled5.join('|') === 'cross-channel mixing|fitting the reference coefficients|aggregation'
  && JSON.stringify(contrast(D, `${CROP_ENERGY}/seen_ba`).flags?.bundles) === JSON.stringify(bundled5)
  && (dz.contrast_limitations[`${CROP_ENERGY}/u8`] ?? []).includes('bundled_contrast'), 'the +17.98 contrast bundles three changes');
need(dz.design.training_free_scorers === cohort.card5.training_free_scorers
  && dz.design.scorers.filter((s: { training: string }) => s.training === 'no training').length === cohort.card5.training_free_scorers,
  'six training-free scorers');
need(dz.design.dataset.targets === cohort.targets && dz.checks.reference_subspace_preflight?.candidates === cohort.targets
  && dz.limitations_keys.includes('candidates_known'), 'every method is given all 40 candidate frequencies');
const ck = dz.checks;
need(ck.raw_cca_reconstruction?.passed && ck.raw_cca_reconstruction.windows === cohort.windows && ck.independent_analytic_spot_check?.passed
  && ck.independent_analytic_spot_check.scorers_checked === cohort.card5.training_free_scorers
  && ck.independent_ridge_refits?.passed && ck.independent_ridge_refits.refits === ck.independent_ridge_refits.of
  && ck.independent_ridge_refits.of === cohort.card5.ridge_fits && dz.limitations_keys.includes('six_row_spot_check'), 'how card 5 was checked');
// Same scores in cards 5 and 6 (the adapter review: bit-identical), each read from its own study.
for (const [a, d] of [['CCA-RAW', 'CCA-RAW'], ['CCA-CROP', 'SUBSPACE-CROP']]) for (const t of TASKS)
  need(JSON.stringify([level(A, `${a}/${t}`).estimate, level(A, `${a}/${t}`).interval]) === JSON.stringify([level(D, `${d}/${t}`).estimate, level(D, `${d}/${t}`).interval]),
    `${a} in card 6 is ${d} in card 5 (${t})`);

/** A scorer's or arm's name; where two codes share a site name, the export's variant tells them apart. */
function armName(id: StudyId, code: string): string {
  const s = study(id), n = nm(id, code);
  const shared = Object.values(s.display_names).filter(v => v === s.display_names[code]).length > 1;
  if (!shared) return n;
  const v = s.design?.scorers?.find((x: { code: string }) => x.code === code)?.variant;
  return `${n}${zh ? '（' : ' ('}${words(VARIANT, v, 'a variant')}${zh ? '）' : ')'}`;
}
function contrastName(id: StudyId, key: string): string {
  const [l, r] = sidesOf(id, key), s = study(id);
  if (s.display_names[l] === s.display_names[r]) {
    const v = (c: string) => words(VARIANT, s.design?.scorers?.find((x: { code: string }) => x.code === c)?.variant, 'a variant');
    return `${cap(nm(id, l))}${zh ? '：' : ': '}${v(l)} − ${v(r)}`;
  }
  return `${cap(armName(id, l))} − ${armName(id, r)}`;
}
const LIMIT: Record<string, Record<Locale, string>> = {
  identical_results_different_definitions: { en: 'Identical results from different definitions.', zh: '定义不同，结果相同。' },
  crop_vs_hann_unresolved: { en: 'Unresolved: the interval spans zero on both tasks.', zh: '尚无定论：两项任务上的区间都跨过零。' },
  bundled_contrast: { en: `This lead bundles three changes: ${bundleList(bundled5, 'en')}.`, zh: `这一领先捆绑了三项改变：${bundleList(bundled5, 'zh')}。` },
  ridge_no_seen_gain: { en: 'Above the average on held-out frequencies; on seen frequencies the interval spans zero.', zh: '在留出频率上高于平均；在见过的频率上，区间跨过零。' },
  // Card 6's lead says it, beside the same figure: the table row adds nothing (a caveat once).
  bundled_matching_operations: { en: '', zh: '' },
  residual_not_uniformly_better: { en: 'On held-out frequencies the correction on the cropped match is below the adapted head.', zh: '在留出频率上，加在裁剪谱匹配上的修正低于适配分类头。' },
  raw_vs_crop_baseline_access: { en: 'The two corrections start from different baselines: CCA on the raw window, and the cropped match.', zh: '两种修正的起点不同：一个是原始时间窗上的 CCA，一个是裁剪谱匹配。' },
};
need(bundled5.length === 3, 'three bundled changes, as the note says');
need(contrast(A, 'CROP-RESIDUAL minus ADAPT-FS/u8').interval[1] < 0, 'the correction on the cropped match is below the adapted head on held-out frequencies');
const notesOf = (id: StudyId, stem: string): string[] => {
  const lim = study(id).contrast_limitations ?? {};
  const u = lim[`${stem}/u8`] ?? [], s = lim[`${stem}/seen_ba`] ?? [];
  need(JSON.stringify(u) === JSON.stringify(s), `${stem}: one note for both tasks`);
  return u.map((k: string) => words(LIMIT, k, 'a contrast note')).filter(Boolean);
};
const contrastRows = (id: StudyId, stems: string[]) => stems.map(s => ({
  stem: s, name: contrastName(id, `${s}/u8`), notes: notesOf(id, s),
  cells: TASKS.map(t => ({ est: contrastFig(id, `${s}/${t}`), iv: civ(id, `${s}/${t}`) })),
}));
const c5Rows = contrastRows(D, STEMS5);
const c5Levels = dz.design.scorers.map((s: { code: string; training: string }) => ({
  code: s.code, name: cap(armName(D, s.code)), training: /no training/.test(dz.display_names[s.code]) ? null : words(TRAINING, s.training, 'a training'),
  cells: TASKS.map(t => ({ est: levelFig(D, `${s.code}/${t}`), iv: liv(D, `${s.code}/${t}`) })),
}));

// --- Card 6: the CCA adapter ---------------------------------------------------------------------------------------
const GAIN = 'RAW-RESIDUAL minus CCA-RAW', ADAPT = 'ADAPT-FS minus ENERGY-FS';
const STEMS6 = ['ADAPT-FS minus ENERGY-FS', 'ADAPT-FS minus CCA-CROP', 'CROP-RESIDUAL minus ADAPT-FS', 'CROP-RESIDUAL minus CCA-CROP', GAIN,
  'RAW-RESIDUAL minus CROP-RESIDUAL'];
need(Object.keys(az.contrasts).join('|') === STEMS6.flatMap(s => TASKS.map(t => `${s}/${t}`)).join('|')
  && Object.values(az.contrasts).every(c => c.role === 'prespecified' && c.people === cohort.people && c.seeds === cohort.training_seeds),
  'six prespecified contrasts on each task, 70 people, three seeds');
need(az.interval_method.method === 'paired person bootstrap, percentile interval' && az.interval_method.conditional_on === 'the fitted models and the three fixed training seeds',
  'card 6: a person bootstrap, conditional on the fitted models and the three seeds');
need(sidesOf(A, `${GAIN}/u8`).join() === 'RAW-RESIDUAL,CCA-RAW' && TASKS.every(t => above(contrast(A, `${GAIN}/${t}`))),
  'CCA with learned correction above CCA alone on both tasks, the intervals above zero');
const arms6 = az.design.arms as { code: string; training: string; fits?: number }[];
need(arms6.map(a => a.code).join() === 'ENERGY-FS,ADAPT-FS,CROP-RESIDUAL,RAW-RESIDUAL,CCA-CROP,CCA-RAW'
  && arms6.filter(a => a.training !== 'no training').every(a => a.fits === wearable.source_models)
  && az.design.dataset.training_seeds === cohort.training_seeds && az.limitations_keys.includes('seeds_averaged'),
  'four trained arms of 105 fits each, three seeds averaged, beside CCA and the cropped match');
const prot = az.protection;
need(prot.scale === 'CCA correlation' && prot.protected_margin >= 0.2 && show(num1(prot.protected_margin)) === '0.2' && prot.protected_flips === 0
  && az.limitations_keys.includes('protection_structural') && az.limitations_keys.includes('protection_bound'),
  'the correction reorders only candidates whose CCA correlations lie within 0.2; no protected decision changed');
need(prot.instances_unit === `prediction instances across ${cohort.training_seeds} seeds and ${cohort.frequency_rotations} rotations`,
  'protected prediction instances are counted over the three seeds and five rotations');
const tr = az.transitions;
const OUTCOMES = ['wrong_to_right', 'right_to_wrong', 'wrong_to_different_wrong', 'unchanged_right', 'unchanged_wrong', 'changed'] as const;
need(tr.arm === 'RAW-RESIDUAL' && tr.against === 'CCA-RAW' && tr.unit === 'share of all decisions on the task' && tr.u8.denominator === 'all held-out decisions'
  && tr.seen_ba.denominator === 'all seen decisions' && az.limitations_keys.includes('transitions_share_of_all_decisions'),
  'transitions of CCA with learned correction against CCA alone, as shares of all decisions on the task');
for (const t of TASKS) {
  const x = tr[t];
  need(Math.abs(x.wrong_to_right + x.right_to_wrong + x.wrong_to_different_wrong + x.unchanged_right + x.unchanged_wrong - 1) < 1e-9
    && Math.abs(x.changed - x.wrong_to_right - x.right_to_wrong - x.wrong_to_different_wrong) < 1e-9
    && Math.abs(x.wrong_to_right - x.right_to_wrong - contrast(A, `${GAIN}/${t}`).estimate) < 1e-9,
    `${t}: the five outcomes sum to all decisions, "changed" is the first three, and the transitions match the gain`);
}
need(tr.averaged_over === `three seeds, then five rotations, then ${cohort.people} people`, 'transitions averaged over seeds, rotations, then people');
const added = contrast(A, `${ADAPT}/u8`).flags as { bundles?: string[]; added_input?: { canonical_correlations: number; computed_on: string } };
need(sidesOf(A, `${ADAPT}/u8`).join() === 'ADAPT-FS,ENERGY-FS' && added?.added_input?.canonical_correlations === 6
  && added.added_input.computed_on === 'cropped-spectrum match (no training)' && added.bundles?.join() === 'several matching operations'
  && above(contrast(A, `${ADAPT}/u8`)) && az.limitations_keys.includes('canonical_correlations_from_cropped_match'),
  'the adapted head is the energy head given six canonical correlations from the cropped-spectrum match; the gain bundles several matching operations');
need(undefinedReason(A, 'ADAPT-FS minus CCA-RAW') === 'not_a_planned_contrast' && !Object.keys(az.contrasts).some(k => k.startsWith('ADAPT-FS minus CCA-RAW')),
  'the adapted head against CCA alone was not a planned contrast and has no interval');
need(az.limitations_keys.includes('candidates_supplied') && az.limitations_keys.includes('frequency_code_supplied')
  && ['filter-bank CCA', 'supervised spatial templates'].every(i => az.not_run.some((x: { item: string }) => x.item === i)),
  'the candidates supply CCA’s references and the numeric code; filter-bank CCA and supervised spatial templates were not compared');
need(az.limitations_keys.includes('separate_tasks') && az.limitations_keys.includes('unadjusted_intervals'), 'separate tasks, unadjusted intervals');
const c6Rows = contrastRows(A, STEMS6);
const c6Arms = arms6.map(a => ({
  code: a.code, name: cap(nm(A, a.code)), training: /no training/.test(az.display_names[a.code]) ? null : words(TRAINING, a.training, 'a training'),
  cells: TASKS.map(t => ({ est: levelFig(A, `${a.code}/${t}`), iv: liv(A, `${a.code}/${t}`) })),
}));

// --- Card 7: Wearable-102 ------------------------------------------------------------------------------------------
const WK = ['dry', 'wet', 'all'] as const;
const wd = wz.design, wsm = wd.source_models, wcd = wz.cca_definition;
need(wd.dataset.name === wearable.dataset && wd.dataset.people === wearable.people && wd.dataset.targets === wearable.targets
  && wd.dataset.windows_per_sensor === wearable.windows_per_sensor && wd.dataset.sensors.join() === wearable.sensors.join()
  && JSON.stringify(wd.dataset.frequency_range_hz) === JSON.stringify(wearable.frequency_range_hz) && wearable.window_seconds === 2
  && wd.dataset.amplitude === 'as stored' && wearable.recordings === 'as stored', 'card 7’s scope strip: the Wearable-102 block');
need(wearable.participant_overlap_with_beta === 'possible: the documentation cannot rule it out' && wz.limitations_keys.includes(wearable.overlap_limitation_key),
  'the documentation cannot rule out that some people also appear in BETA');
need(wsm.dataset === 'BETA' && wsm.arm === 'RAW-RESIDUAL' && wsm.models === wearable.source_models && wsm.retraining === false && wsm.ensemble === false
  && wsm.models === wsm.person_folds * wsm.frequency_rotations * wsm.training_seeds && wsm.person_folds === cohort.person_folds
  && wsm.frequency_rotations === cohort.frequency_rotations && wsm.training_seeds === cohort.training_seeds
  && arms6.find(a => a.code === 'RAW-RESIDUAL')?.fits === wsm.models && wz.source_models_sha256 === az.source_sha256,
  'the 105 card 6 models (7 folds × 5 rotations × 3 seeds), trained on BETA, run unchanged');
need(WK.every(k => wd.endpoints[k].candidate_count === wearable.targets) && wd.endpoints.dry.role === 'primary' && wd.endpoints.wet.role === 'primary'
  && wd.endpoints.all.role === 'secondary' && wd.endpoints.all.label === 'both sensors'
  && wd.endpoints.dry.windows === wearable.windows_per_sensor && wd.endpoints.wet.windows === wearable.windows_per_sensor && wd.endpoints.all.windows === wearable.windows,
  'dry and wet primary, both sensors secondary');
const wc = (k: string) => contrast(W, `RAW-RESIDUAL_minus_CCA-RAW/${k}`);
need(WK.every(k => wc(k).role === wd.endpoints[k].role && sidesOf(W, `RAW-RESIDUAL_minus_CCA-RAW/${k}`).join() === 'RAW-RESIDUAL,CCA-RAW' && spans(wc(k))
  && wc(k).people === wearable.people) && Object.keys(wz.contrasts).length === 3, 'the models minus matched CCA, by sensor: every interval includes zero');
need(wz.not_run.some((x: { item: string }) => x.item === 'equivalence margin') && wz.limitations_keys.includes('no_equivalence_no_single_cause'),
  'no equivalence margin was set, and no single factor is isolated');
