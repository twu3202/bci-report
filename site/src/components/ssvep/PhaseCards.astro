// --- Rows -------------------------------------------------------------------------------------------------------
type Seg = { t: string; a?: string };
const seg = (p: Part[]): Seg[] => p.map(x => typeof x === 'string' ? { t: x } : { t: formatSsvep(x), a: figAttr(x) });
interface Cellv { lead?: Seg; iv?: Seg[] }
/**
 * A level cell: its estimate, and its interval unless the interval is a point (CCA's cost). A cost is a signed
 * difference, so its bounds are joined by "to" rather than a dash.
 */
function cellOf(id: StudyId, key: string): Cellv {
  if (undefinedReason(id, key)) return {};
  const x = level(id, key);
  const iv = levelIv(id, key, x.unit === 'difference of proportions' ? COPY.to : '–');
  return { lead: seg([levelFig(id, key)])[0], iv: x.interval[0] === x.interval[1] ? undefined : seg(iv) };
}
/** "a minus b": in Chinese, a space where 减去 meets a Latin letter or a digit. */
const minus = (a: string, b: string) => zh ? `${a}${/[A-Za-z0-9)]$/.test(a) ? ' ' : ''}减去${/^[A-Za-z0-9+−]/.test(b) ? ' ' : ''}${b}` : `${a} minus ${b}`;
const sep = ' · ';
const recipe = (a: JArm) => [nameOf(J, a.head, locale), nameOf(J, a.features, locale), nameOf(J, a.query, locale)].join(sep);
const jRows = jArms.map(a => ({ a, name: COPY.jArmName[a.arm], recipe: recipe(a), held: cellOf(J, `${a.cell}/u8`), seen: cellOf(J, `${a.cell}/seen_ba`) }));
const sideOfJ = (key: string) => {
  const cell = key.split('/')[0], a = jArms.find(x => x.cell === cell);
  need(a, `card 3: a contrast side ${key}`);
  return COPY.jSide[a!.arm];
};
const taskOf = (c: Contrast) => {
  const [lt, rt] = [c.left, c.right].map(s => s.split('/')[1]);
  need(lt === rt && (lt === 'u8' || lt === 'seen_ba'), `a contrast within one task: ${c.left} minus ${c.right}`);
  return COPY.task[lt];
};
const jContrasts = jKeys.map(k => {
  const c = contrast(J, k);
  return { k, task: taskOf(c), comparison: minus(sideOfJ(c.left), sideOfJ(c.right)),
    role: COPY.role[c.role === 'primary' ? 'primary' : 'descriptive'], est: seg([contrastFig(J, k)])[0], iv: seg(contrastIv(J, k, COPY.to)) };
});

const ccaName = nameOf(R, 'CCA', locale);
const headQuery = (a: Arm) => a.kind === 'cca' ? ccaName : `${nameOf(R, a.head!, locale)}${sep}${nameOf(R, a.query!, locale)}`;
const groups = (['ramp', 'control', 'plain', 'cca'] as Kind[]).map(kind => ({
  kind, label: COPY.group[kind],
  rows: rampArms.filter(a => a.kind === kind).map(a => ({
    a, name: headQuery(a), held: cellOf(R, `${a.code}/u8`), m8: cellOf(R, `${a.code}/m8`), seen: cellOf(R, `${a.code}/seen_ba`),
    cost: cellOf(R, `${a.code}/cost`), nn8: cellOf(R, `${a.code}/nn8`), u3: cellOf(R, `${a.code}/u3`),
  })),
}));
need(groups.map(g => g.rows.length).join() === '6,6,2,1', 'card 4: six cells, six controls, two plain-spectrum heads and CCA');
const rContrasts = rKeys.map(k => {
  const c = contrast(R, k), l = armOf(c.left.split('/')[0]), r = armOf(c.right.split('/')[0]);
  need(l.kind === 'ramp' && r.kind !== 'ramp' && (r.kind !== 'control' || (r.head === l.head && r.query === l.query)),
    `card 4: ${k} is a cell trained with the ramp minus its own control, a plain-spectrum head or CCA`);
  // The right side shares the cell's head and query unless the comparison names them.
  const right = r.kind === 'cca' ? ccaName : r.head === l.head && r.query === l.query ? COPY.rSide[r.kind] : COPY.named(COPY.rSide[r.kind], headQuery(r));
  return { k, arm: headQuery(l), task: taskOf(c), comparison: minus(COPY.rSide.ramp, right),
    role: COPY.role[c.role], est: seg([contrastFig(R, k)])[0], iv: seg(contrastIv(R, k, COPY.to)) };
});

const c3 = cardChrome(3, locale), c4 = cardChrome(4, locale);
need(c3.anchor === 'phase-jitter' && c3.studies.join() === J && c4.anchor === 'phase-ramp' && c4.studies.join() === R, 'cards 3 and 4 at their anchors');
const lead3 = seg(COPY.lead3()), caption3 = seg(COPY.caption3()), lead4 = seg(COPY.lead4()), bet4 = seg(COPY.bet()), caption4 = seg(COPY.caption4());
const jSummary = seg(COPY.contrastsSummary(jit.checks.audit.numerical_summary.contrasts));
const rSummary = seg(COPY.contrastsSummary(ramp.checks.audit.numerical_summary.contrasts));
// The bet sits on card 4 alone; card 3's words carry no threshold at whole percent.
need(![...lead3, ...caption3].some(s => s.a?.includes('|pct0|')) && bet4.filter(s => s.a?.includes('|pct0|')).length === 1, 'the bet once, on card 4');
need(siteName('FiLM head', locale) === nameOf(R, 'FS', locale), 'one name for the FiLM head');
