    group: { ramp: '复数频谱，训练时加相位斜坡', control: '复数频谱，不加斜坡（匹配对照）', plain: '普通频谱，不加斜坡', cca: '无需训练' } as Record<Kind, string>,
    readoffsSummary: '描述性读出：泛化代价、nn8 与 u3',
    readoffsRegion: '卡片 4 的描述性读出，可横向滚动',
