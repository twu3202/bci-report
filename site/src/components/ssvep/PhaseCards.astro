        </tr>)}</tbody>
      </table>
    </div>
  </details>
</section>

<section class="topic-section ssvep-card" id={c4.anchor} aria-labelledby={c4.headingId} data-ssvep-card={c4.card}>
  <div class="topic-heading"><div><p class="eyebrow">{c4.eyebrow}</p><h2 id={c4.headingId}>{c4.title}</h2></div></div>
