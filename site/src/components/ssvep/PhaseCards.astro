    jArmName: { A: '0–125 ms 延迟', B: '一个周期的延迟', C: '不加延迟（匹配对照）', M: '普通频谱上的幅度参考谱分类头' } as Record<string, string>,
    jSide: { A: '0–125 ms 延迟', B: '一个周期的延迟', C: '不加延迟', M: '普通频谱上的幅度参考谱分类头' } as Record<string, string>,
    contrastsSummary: (n: number): Part[] => ['全部 ', count(n), ' 项配对对比'],
    contrastsRegion: (card: number) => `卡片 ${card} 的配对对比，可横向滚动`,
