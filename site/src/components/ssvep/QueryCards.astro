/** Card 1's reading of a contrast, from the export's flags. */
function refReading(key: string): string {
  const c = contrast(R, key), f = c.flags ?? {};
  const rule = f.margin_rule as string | null, pass = f.margin_pass as boolean | null;
  let r: string;
  if (rule === null) { need(pass === null, `${key}: no margin, no verdict`); r = txt('read for a difference only'); }
  else if (rule === RULE_EQ && key.endsWith('/R4')) r = txt(pass ? 'cost within ±{m} pp of zero' : 'cost not within ±{m} pp of zero', { m });
  else if (rule === RULE_EQ) r = txt(pass ? 'equivalent within ±{m} pp' : 'not equivalent within ±{m} pp', { m });
  else if (rule === RULE_NI) r = txt(pass ? 'non-inferior to CCA within −{m} pp' : 'non-inferiority to CCA (−{m} pp) not met', { m });
  else { need(false, `${key}: a known margin rule`); r = ''; }
  return dirWord(c) + sep + r;
}
