const slotsOf = (s: string) => (s.match(/\{\w+\}/g) ?? []).sort().join();
// "route 3" is 第三条路线 in Chinese, a numeral the digit check cannot see: both are taken out before it counts.
const digitsOf = (s: string) => (s.replace(/\{\w+\}/g, '').replace(/\broute 3\b|第三条路线/g, '').match(/\d+/g) ?? []).join(',');
for (const [en, z] of Object.entries(ZH)) {
  need(slotsOf(en) === slotsOf(z), `the Chinese of “${en.slice(0, 60)}…” carries the same slots`);
  need(digitsOf(en) === digitsOf(z), `the Chinese of “${en.slice(0, 60)}…” carries the same digits`);
  need(!/[.!?]$/.test(z) && !/\p{Script=Han}[.,;:]/u.test(z), `the Chinese of “${en.slice(0, 60)}…” uses Chinese punctuation`);
}
const used = new Set<string>();
/** A sentence in the page's language: English with {slots}, the Chinese looked up by that exact English. */
function say(en: string, slots: Record<string, Slot> = {}): Seg[] {
  need(en in ZH, `Chinese for “${en.slice(0, 70)}…”`);
  used.add(en);
  const t = zh ? ZH[en] : en, out: Seg[] = [], printed = new Set<string>();
  for (const piece of t.split(/(\{\w+\})/)) {
    const m = piece.match(/^\{(\w+)\}$/);
    if (!m) { if (piece) out.push(piece); continue; }
    need(m[1] in slots, `the slot {${m[1]}} of “${en.slice(0, 50)}…”`);
    printed.add(m[1]);
    const v = slots[m[1]];
    out.push(...(Array.isArray(v) ? v : [v]));
  }
  need(Object.keys(slots).every(k => printed.has(k)), `every slot of “${en.slice(0, 50)}…” is printed`);
  return out;
}
/** Words only (headers, labels, aria-labels): no figure, no link. */
function txt(en: string, slots: Record<string, string> = {}): string {
  const s = say(en, slots);
  need(s.every(x => typeof x === 'string'), `“${en}” is words only`);
  return (s as string[]).join('');
}

// --- The margin, from the export. ---------------------------------------------------------------------------------
const softPrimary = contrast('softmax', 'BSH-CE minus BSH-BCE'), softSecondary = contrast('softmax', 'BSH-CE minus LINEAR-CE');
const M = softPrimary.flags!.equivalence_margin as number;
need(M === 0.02 && softSecondary.flags!.equivalence_margin === M, 'the ±2-point margin of the softmax run');
const RULE_EQ = 'Both interval bounds strictly inside [-0.02,+0.02]', RULE_NI = 'Lower interval bound strictly greater than -0.02';
const m = String(Math.round(M * 100));
need(m === '2', 'the margin prints as 2 points');

// --- Shared pieces --------------------------------------------------------------------------------------------------
const ivAt = (x: { interval: [number, number] }) => x.interval;
/** The direction of a paired difference: from its flag where the export gives one, and always from its interval. */
function dirWord(c: { interval: [number, number]; flags?: Record<string, unknown> }): string {
  const [lo, hi] = ivAt(c);
  const d = lo > 0 ? 'positive' : hi < 0 ? 'negative' : 'not_resolved';
  if (c.flags && 'difference' in c.flags) need(c.flags.difference === d, `a difference flag (${String(c.flags.difference)}) its interval supports`);
  return txt(d === 'negative' ? 'Below zero' : d === 'positive' ? 'Above zero' : 'Direction unresolved');
}
const taskOf = (key: string) => key.endsWith('/u8') ? txt('Held-out') : key.endsWith('/seen_ba') ? txt('Seen, balanced') : (need(false, `a task for ${key}`), '');
const roleWord = (r: string) => (need(r === 'primary' || r === 'secondary', `a role (${r})`), txt(r === 'primary' ? 'Primary' : 'Secondary'));
const armOf = (key: string) => key.split('/')[0];
/** An arm code split into features, head and question ("L0c-MATCH-REFc-0" → L0c, MATCH, REFc-0). */
function armParts(arm: string): { feat?: string; head?: string; q: string } {
  const a = arm.match(/^(L0c|L0|L1)-(FS|MATCH)-(.+)$/);
  if (a) return { feat: a[1], head: a[2], q: a[3] };
  const s = arm.match(/^(L0)-(.+)$/);
  if (s) return { feat: s[1], q: s[2] };
  return { q: arm };
}

// Levels tables: one row per arm, seven columns.
const METRICS = ['u8', 'm8', 'cost', 'seen_ba', 'nn8', 'u3'] as const;
interface FigCell { t: 'fig'; main: SsvepFig; iv: Part[] | null }
type Cell = FigCell | { t: 'undef' } | { t: 'none' };
interface LevelRow { arm: string; name: string; origin: string | null; cells: Cell[] }
interface LevelGroup { heading: string; rows: LevelRow[] }
function cellOf(id: StudyId, key: string): Cell {
  const x = study(id).levels[key];
  if (!x) return undefinedReason(id, key) ? { t: 'undef' } : { t: 'none' };
  need(!undefinedReason(id, key), `${id} ${key} is either defined or not`);
  const diff = x.unit === 'difference of proportions';
  const zero = diff && x.estimate === 0 && x.interval[0] === 0 && x.interval[1] === 0;
  if (zero) need(x.seeds === 'no training' || (id === 'ref' && key === 'TEMPLATE/cost'), `${key}: a zero cost only for a scorer with no training`);
  return { t: 'fig', main: levelFig(id, key), iv: zero ? null : levelIv(id, key, diff ? to : '–') };
}
function levelRow(id: StudyId, arm: string, nameFrom: StudyId = id): LevelRow {
  const keys = METRICS.map(k => `${arm}/${k}`);
  const origins = new Set(keys.map(k => study(id).levels[k]?.origin).filter(Boolean));
  need(origins.size === 1, `${id} ${arm}: one origin for the whole row`);
  const origin = [...origins][0] as string;
  need(['new', 'reused_parent', 'reused_ref'].includes(origin) && (origin !== 'reused_ref' || id === 'ref2'), `${id} ${arm}: a known origin`);
  return {
    arm, name: cap(nameOf(nameFrom, armParts(arm).q, locale)),
    origin: origin === 'reused_parent' ? txt('from route 3') : origin === 'reused_ref' ? txt('from card 1') : null,
    cells: keys.map(k => cellOf(id, k)),
  };
}
/** Every level of a study appears in exactly one row of its card's table. */
function covers(id: StudyId, groups: LevelGroup[], arms: string[]) {
  const inTable = groups.flatMap(g => g.rows.map(r => r.arm)).filter(a => arms.includes(a));
  const inExport = [...new Set([...Object.keys(study(id).levels), ...study(id).undefined.map(u => u.level!)].map(armOf))];
  need(inTable.length === new Set(inTable).size && inExport.every(a => inTable.includes(a)) && inTable.every(a => inExport.includes(a)),
    `${id}: every arm of the export in the card's levels table, once`);
}
const levelHeads = [txt('Arm'), txt('Held-out'), 'm8', txt('Cost, held-out − m8'), txt('Seen, balanced'), 'nn8', 'u3'];
need(levelHeads.length === 7, 'seven columns in each levels table');

