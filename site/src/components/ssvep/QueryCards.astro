---
/**
 * Cards 1 and 2 of /topics/new-ssvep-frequencies/ (package P-SS2, plan §2.1 cards 1 and 2):
 *   #reference-spectrum — the REF study: the head asked with the spectrum of CCA's own reference signals;
 *   #head-and-features  — REF2 and the softmax run: the head, the spectrum it reads, or the way a frequency is asked.
 *
 * Each card runs question → what changed → matched control → result → limit. The result is the plan's lead, with
 * every figure a leaf of new-ssvep-frequencies-update.json; below it the card's planned contrasts (always visible)
 * and every level behind the card (a <details> table of seven columns); the caption names the interval method, the
 * number of contrasts and that no multiplicity correction was applied. Seen and held-out results sit in separate
 * columns. Card 1 states both readings of R2 on the plain spectrum (equivalent within the margin, and a small
 * difference below zero) and the L1 sentence; card 2 sets the reference with stimulus phase beside card 1's
 * reference spectrum, the numeric code and CCA, gives the corrigendum sentence and the harmonics effects with their
 * intervals, and frames the complex spectrum through its own feature contrasts, never through a head comparison.
 *
 * Props
 *   locale: Locale — 'en' or 'zh', the page's language. Nothing else is passed: every figure and every word the card
 *     needs comes from src/data/new-ssvep-frequencies.ts and the Chinese map below.
 *
 * Contract with the page (P-SS1)
 *   - Renders exactly the <section>s for cards 1 and 2, in that order, each
 *       <section class="topic-section ssvep-card" id={c.anchor} aria-labelledby={c.headingId} data-ssvep-card={c.card}>
 *     with the eyebrow and the <h2 id={c.headingId}> from cardChrome(n, locale).
 *   - Every figure is an SsvepFig printed as <span data-fig={figAttr(f)}>{formatSsvep(f)}</span> (class="metric" for
 *     the figure that leads a table cell). Both languages print the same multiset of data-fig values: the Chinese
 *     page runs the same code and only swaps words.
 *   - The scope of cards 1–6 is stated once on the page and is not restated here; the thread is linked once, on the
 *     page, and never from these cards. No figure of the commenter's own confidence, and no bet: the bet is card 4's.
 *   - Every table has a <thead>; the tables inside <details> have seven columns (stack-tables.ts stacks them below
 *     640px). No inline style, script or event handler. Styles: <style is:global> with selectors that start from
 *     this file's own card attributes, so no data-astro-cid attribute lands on the figures.
 *
 * Words. Every sentence is English with {slots} for figures and links; the Chinese is looked up by that exact
 * English (ZH below), on both pages, so English with no Chinese fails the build in either language. A Chinese entry
 * must carry the same slots and the same literal digits as its English, end in Chinese punctuation, and be used.
 * Every sentence that summarises the export is guarded by need(), so the build fails if the numbers stop supporting
 * it.
 */
import type { Locale } from '../../data/i18n';
import { hrefFor, topicChrome } from '../../data/i18n';
import {
  cardChrome, study, level, contrast, levelFig, levelIv, contrastFig, contrastIv, undefinedReason, nameOf, siteName,
  intervalText, notRunOf, cohort, rights, needFor, count, figAttr, formatSsvep,
  type Part, type SsvepFig, type StudyId,
} from '../../data/new-ssvep-frequencies';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const need = needFor('new-ssvep-frequencies cards 1–2');
const tc = topicChrome[locale];
const to = zh ? ' 至 ' : ' to ';
const sep = zh ? '；' : '; ';
const F = (f: SsvepFig) => formatSsvep(f);
const cap = (s: string) => (zh ? s : s.charAt(0).toUpperCase() + s.slice(1));

// --- Words: English with {slots}, and the Chinese keyed by that exact English. ------------------------------------
type Link = { href: string; text: string };
type Seg = Part | Link;
type Slot = Seg | Seg[];
const isLink = (x: Seg): x is Link => typeof x === 'object' && 'href' in x;

