      tc: contrastFig(R2, 'transfer_CCA'), tcIv: contrastIv(R2, 'transfer_CCA', to),
    }),
    say('The stimulus phases come from the BETA authors’ corrigendum, converted to the cosine convention with zero latency; equal amplitudes across harmonics, with harmonic h at h times the stimulus phase, are modelling assumptions. They are the phases of the stimulus as displayed, and the question carries no phase measured on the scalp.'),
    say('Dropping the second and third harmonics from the reference spectrum changed the plain-spectrum FiLM head’s held-out accuracy by {hu} ({huIv}), to {r1u}, and its seen balanced accuracy by {hs} ({hsIv}).', {
      hu: contrastFig(R2, 'harmonics_u8'), huIv: contrastIv(R2, 'harmonics_u8', to), r1u: levelFig(R2, 'L0-FS-REF1/u8'),
      hs: contrastFig(R2, 'harmonics_seen'), hsIv: contrastIv(R2, 'harmonics_seen', to),
    }),
  ],
  caption: say('{iv}. Twelve planned contrasts in the main run, all primary, and one primary and one secondary in the softmax run, with no multiplicity correction.', {
    iv: intervalText(R2, locale),
  }),
  limit: say('Each arm is one fixed recipe: the matching head is one bilinear design, and the softmax run changes the whole training objective or several parts of the architecture at once. These contrasts compare the recipes; how much frequency information the plain spectrum holds stays open. Both runs were designed with route 3’s results known.'),
  contrastCaption: txt('Each contrast changes one named part; differences in percentage points.'),
  contrastRegion: txt('Card 2’s contrasts, scrolls horizontally'),
  levelsSummary: txt('Every level behind card 2: held-out, m8, cost, seen, and the two read-offs'),
  levelsRegion: txt('Card 2’s levels, scrolls horizontally'),
  levelsCaption: txt('Levels with their 95% intervals. Rows marked card 1 or route 3 are those runs, reused unchanged. A question number or a softmax exists only for seen frequencies, so their held-out cells are not defined. On the complex spectrum u3 also involves stimulus phase, because neighbouring targets differ in phase.'),
};
need(ref2.limitations_keys.includes('u3_phase_and_id'), 'u3 involves stimulus phase where phase is kept');

/** Card 2's reading of a contrast: its direction, and the one rule the protocol applies to it, if any. */
function ref2Reading(id: StudyId, key: string, rule?: 'head' | 'cca' | 'equiv'): string {
  const c = contrast(id, key), f = c.flags ?? {};
  const parts = [dirWord(c)];
  if (rule === 'head') { need(f.meaningful_head_gain === false, `${key}: the head-gain verdict`); parts.push(txt('meaningful head gain (lower bound above +{m} pp) not met', { m })); }
  if (rule === 'cca') { need(f.noninferiority_to_CCA === false, `${key}: the non-inferiority verdict`); parts.push(txt('non-inferiority to CCA (−{m} pp) not met', { m })); }
  if (rule === 'equiv') parts.push(txt(f.equivalent_strict_2pp ? 'equivalent within ±{m} pp' : 'not equivalent within ±{m} pp', { m }));
  if (id === R2) need(f.equivalent_within_2pp === false && (rule === 'head' || f.meaningful_head_gain === null) && (rule === 'cca' || f.noninferiority_to_CCA === null),
    `${key}: no other verdict in the export`);
  return parts.join(sep);
}
const C2_ROWS: { heading: string; rows: { id: StudyId; key: string; label: string; rule?: 'head' | 'cca' | 'equiv' }[] }[] = [
  { heading: 'The head · plain spectrum', rows: [
    { id: R2, key: 'head_REF', label: 'Matching head − FiLM head, asked with the reference spectrum', rule: 'head' },
    { id: R2, key: 'head_ID', label: 'Matching head − FiLM head, asked with question numbers', rule: 'head' },
  ] },
  { heading: 'The features · complex spectrum − plain spectrum', rows: [
    { id: R2, key: 'features_FS_REF', label: 'FiLM head, asked with the reference spectrum' },
    { id: R2, key: 'features_FS_ID', label: 'FiLM head, asked with question numbers' },
    { id: R2, key: 'features_MATCH_REF', label: 'Matching head, asked with the reference spectrum' },
    { id: R2, key: 'features_MATCH_ID', label: 'Matching head, asked with question numbers' },
  ] },
  { heading: 'The question · complex spectrum', rows: [
    { id: R2, key: 'phase_FS', label: 'FiLM head: reference with stimulus phase − reference spectrum' },
    { id: R2, key: 'phase_MATCH', label: 'Matching head: reference with stimulus phase − reference spectrum' },
    { id: R2, key: 'transfer_NUM', label: 'Matching head: reference with stimulus phase − numeric code' },
    { id: R2, key: 'transfer_CCA', label: 'Matching head asked with the reference with stimulus phase − CCA (no training)', rule: 'cca' },
  ] },
  { heading: 'The question · plain spectrum', rows: [
    { id: R2, key: 'harmonics_u8', label: 'FiLM head: fundamental-only reference − reference spectrum' },
    { id: R2, key: 'harmonics_seen', label: 'FiLM head: fundamental-only reference − reference spectrum' },
  ] },
  { heading: 'The output · softmax run, plain spectrum', rows: [
    { id: S, key: 'BSH-CE minus BSH-BCE', label: 'One output per question: softmax training − one-vs-rest training', rule: 'equiv' },
    { id: S, key: 'BSH-CE minus LINEAR-CE', label: 'One output per question, softmax training − plain 32-way softmax', rule: 'equiv' },
  ] },
];
const c2Listed = C2_ROWS.flatMap(g => g.rows);
need(c2Listed.filter(r => r.id === R2).map(r => r.key).sort().join() === [...c2Keys].sort().join()
  && c2Listed.filter(r => r.id === S).map(r => r.key).join() === Object.keys(soft.contrasts).join(), 'every contrast of card 2, once');
// The groups say what each contrast holds fixed: features and head from the arm codes.
for (const g of C2_ROWS) for (const r of g.rows) {
  const c = contrast(r.id, r.key), L = armParts(armOf(c.left)), Rt = armOf(c.right) === 'CCA' ? null : armParts(armOf(c.right));
  const ok = g.heading.startsWith('The head') ? L.feat === 'L0' && Rt?.feat === 'L0' && L.head === 'MATCH' && Rt?.head === 'FS' && L.q === Rt?.q
    : g.heading.startsWith('The features') ? L.feat === 'L0c' && Rt?.feat === 'L0' && L.head === Rt?.head && L.q === Rt?.q
    : g.heading === 'The question · complex spectrum' ? L.feat === 'L0c' && L.q === 'REFc-0' && (Rt === null || (Rt.feat === 'L0c' && Rt.head === L.head))
    : g.heading === 'The question · plain spectrum' ? L.feat === 'L0' && L.q === 'REF1' && Rt?.feat === 'L0' && Rt?.q === 'REF' && L.head === 'FS' && Rt?.head === 'FS'
    : L.feat === 'L0' && r.id === S;
  need(ok, `card 2’s ${r.key} sits in “${g.heading}”`);
}
const c2Contrasts: ContrastGroup[] = C2_ROWS.map(g => ({
  heading: txt(g.heading),
  rows: g.rows.map(r => {
    const c = contrast(r.id, r.key);
    return { id: r.id, key: r.key, label: txt(r.label), task: taskOf(c.left), role: roleWord(c.role),
             est: contrastFig(r.id, r.key), iv: contrastIv(r.id, r.key, to), reading: ref2Reading(r.id, r.key, r.rule) };
  }),
}));
const fsHead = nameOf(R2, 'FS', locale), mHead = nameOf(R2, 'MATCH', locale), plain = cap(nameOf(R2, 'L0', locale)), cplx = cap(nameOf(R2, 'L0c', locale));
const c2Levels: LevelGroup[] = [
  { heading: txt('{feat} · {head}', { feat: plain, head: fsHead }), rows: ['REF', 'REF1', 'ID', 'NUM', 'TPL'].map(q => levelRow(R2, `L0-FS-${q}`)) },
  { heading: txt('{feat} · {head}', { feat: plain, head: mHead }), rows: ['REF', 'ID', 'NUM'].map(q => levelRow(R2, `L0-MATCH-${q}`)) },
  { heading: txt('{feat} · {head}', { feat: cplx, head: fsHead }), rows: ['REF', 'REFc-0', 'ID', 'NUM'].map(q => levelRow(R2, `L0c-FS-${q}`)) },
  { heading: txt('{feat} · {head}', { feat: cplx, head: mHead }), rows: ['REF', 'REFc-0', 'ID', 'NUM'].map(q => levelRow(R2, `L0c-MATCH-${q}`)) },
  { heading: txt('{feat} · no question, softmax run', { feat: plain }), rows: ['LINEAR-CE', 'BSH-CE', 'BSH-BCE'].map(a => levelRow(S, `L0-${a}`)) },
  { heading: txt('No training'), rows: [levelRow(R2, 'CCA')] },
];
covers(R2, c2Levels, ['L0-FS-REF', 'L0-FS-REF1', 'L0-FS-ID', 'L0-FS-NUM', 'L0-FS-TPL', 'L0-MATCH-REF', 'L0-MATCH-ID', 'L0-MATCH-NUM',
  'L0c-FS-REF', 'L0c-FS-REFc-0', 'L0c-FS-ID', 'L0c-FS-NUM', 'L0c-MATCH-REF', 'L0c-MATCH-REFc-0', 'L0c-MATCH-ID', 'L0c-MATCH-NUM', 'CCA']);
covers(S, c2Levels, ['L0-LINEAR-CE', 'L0-BSH-CE', 'L0-BSH-BCE']);

const cards = [
  { ...c1, contrasts: c1Contrasts, levels: c1Levels },
  { ...c2, contrasts: c2Contrasts, levels: c2Levels },
];
const stepTerms = [txt('Question'), txt('What changed'), txt('Matched control')];
const steps = (c: typeof cards[number]) => [c.question, c.changed, c.control].map((body, i) => ({ term: stepTerms[i], body }));
const resultH = txt('Result'), limitH = txt('Limit');
const notDefined = txt('not defined'), byConstruction = txt('by construction');
// Unknown English fails the build above; a Chinese entry nothing prints fails it here.
const unused = Object.keys(ZH).filter(k => !used.has(k));
need(unused.length === 0, `every Chinese entry is printed (unused: ${unused.map(k => `“${k.slice(0, 40)}”`).join(', ')})`);
need(siteName('reference spectrum', locale) === nameOf(R, 'REF', locale), 'one name for the reference spectrum');
---
{cards.map(c => <section class="topic-section ssvep-card" id={c.chrome.anchor} aria-labelledby={c.chrome.headingId} data-ssvep-card={c.chrome.card}>
  <div class="topic-heading"><div><p class="eyebrow">{c.chrome.eyebrow}</p><h2 id={c.chrome.headingId}>{c.chrome.title}</h2></div></div>
  <dl class="ssvep-steps" data-ssvep-steps="">
    {steps(c).map(s => <div><dt>{s.term}</dt><dd>{s.body.map(p => typeof p === 'string' ? p : isLink(p) ? <a href={p.href}>{p.text}</a> : <span data-fig={figAttr(p)}>{F(p)}</span>)}</dd></div>)}
  </dl>
  <h3 class="roadmap-h3">{resultH}</h3>
  {c.lead.map((par, i) => <p class="roadmap-p" data-ssvep-lead={i + 1}>{par.map(p => typeof p === 'string' ? p : isLink(p) ? <a href={p.href}>{p.text}</a> : <span data-fig={figAttr(p)}>{F(p)}</span>)}</p>)}
  <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={c.contrastRegion}>
    <table data-ssvep-table={`card-${c.chrome.card}-contrasts`}>
      <caption>{c.contrastCaption}</caption>
      <thead><tr>{contrastHeads.map(h => <th scope="col">{h}</th>)}</tr></thead>
      <tbody>{c.contrasts.map(g => <>
        <tr class="subhead"><th scope="colgroup" colspan={contrastHeads.length}>{g.heading}</th></tr>
        {g.rows.map(r => <tr data-contrast={`${r.id}|${r.key}`}>
          <th scope="row">{r.label}</th>
          <td>{r.task}</td>
          <td>{r.role}</td>
          <td><span data-fig={figAttr(r.est)} class="metric">{F(r.est)}</span><span class="interval">{r.iv.map(p => typeof p === 'string' ? p : <span data-fig={figAttr(p)}>{F(p)}</span>)}</span></td>
          <td>{r.reading}</td>
        </tr>)}
      </>)}</tbody>
    </table>
  </div>
  <p class="protocol-note" data-ssvep-caption="">{c.caption.map(p => typeof p === 'string' ? p : isLink(p) ? <a href={p.href}>{p.text}</a> : <span data-fig={figAttr(p)}>{F(p)}</span>)}</p>
  <details class="rd-panel" data-ssvep-levels={c.chrome.card}>
    <summary>{c.levelsSummary}</summary>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={c.levelsRegion}>
      <table data-ssvep-table={`card-${c.chrome.card}-levels`}>
        <caption>{c.levelsCaption}</caption>
        <thead><tr>{levelHeads.map(h => <th scope="col">{h}</th>)}</tr></thead>
        <tbody>{c.levels.map(g => <>
          <tr class="subhead"><th scope="colgroup" colspan={levelHeads.length}>{g.heading}</th></tr>
          {g.rows.map(r => <tr data-level-row={r.arm}>
            <th scope="row">{r.name}{r.origin && <small>{r.origin}</small>}</th>
            {r.cells.map(x => x.t === 'fig'
              ? <td><span data-fig={figAttr(x.main)} class="metric">{F(x.main)}</span><span class="interval">{x.iv ? x.iv.map(p => typeof p === 'string' ? p : <span data-fig={figAttr(p)}>{F(p)}</span>) : byConstruction}</span></td>
              : <td data-null={x.t}>{x.t === 'undef' ? notDefined : '—'}</td>)}
          </tr>)}
        </>)}</tbody>
      </table>
    </div>
  </details>
  <p class="roadmap-p ssvep-limit" data-ssvep-limit=""><strong>{limitH}</strong>{zh ? '：' : '. '}{c.limit.map(p => typeof p === 'string' ? p : isLink(p) ? <a href={p.href}>{p.text}</a> : <span data-fig={figAttr(p)}>{F(p)}</span>)}</p>
</section>)}

<style is:global>
  /* Global, not scoped: a scoped style would add a data-astro-cid attribute to every element of this component, and
     check-workbench.mjs reads figures by their exact markup. Every selector starts from this file's two cards. */
  :is([data-ssvep-card="1"],[data-ssvep-card="2"]) .ssvep-steps{display:grid;gap:9px;max-width:900px;margin:0 0 4px}
  :is([data-ssvep-card="1"],[data-ssvep-card="2"]) .ssvep-steps>div{display:grid;grid-template-columns:minmax(120px,160px) minmax(0,1fr);gap:16px;align-items:baseline}
  :is([data-ssvep-card="1"],[data-ssvep-card="2"]) .ssvep-steps dt{font-size:.68rem;letter-spacing:.08em;text-transform:uppercase;font-weight:650;color:var(--muted)}
  :is([data-ssvep-card="1"],[data-ssvep-card="2"]) .ssvep-steps dd{margin:0;font-size:.875rem}
  :is([data-ssvep-card="1"],[data-ssvep-card="2"]) .topic-table th[scope=row] small{display:block;margin-top:3px;font-size:.7rem;font-weight:400;color:var(--muted)}
  :is([data-ssvep-card="1"],[data-ssvep-card="2"]) .ssvep-limit a,:is([data-ssvep-card="1"],[data-ssvep-card="2"]) .protocol-note a{color:var(--accent)}
  :is([data-ssvep-card="1"],[data-ssvep-card="2"]) .rd-panel .topic-table{margin-top:4px}
  :is([data-ssvep-card="1"],[data-ssvep-card="2"]) .topic-table td[data-null]{color:var(--muted)}
  @media(max-width:560px){
    :is([data-ssvep-card="1"],[data-ssvep-card="2"]) .ssvep-steps>div{grid-template-columns:minmax(0,1fr);gap:2px}
  }
</style>
