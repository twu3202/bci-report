}
const c1Contrasts: ContrastGroup[] = (['L0', 'L1'] as const).map(feat => ({
  heading: txt('{feat} · {role}', { feat: cap(nameOf(R, feat, locale)), role: txt(feat === 'L0' ? 'primary' : 'secondary') }),
  rows: c1Keys.filter(k => k.startsWith(feat + '/')).map(k => {
