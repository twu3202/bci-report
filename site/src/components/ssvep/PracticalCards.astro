---
/**
 * Cards 10, 11, 13 and 14 of /topics/new-ssvep-frequencies/ (plan §2.1, package P-SS): #harmonic-pooling (pooling
 * CCA's per-harmonic statistics, on BETA and on Wearable-102), #practical-settings (filter-bank CCA, shorter windows and
 * fewer electrodes, with the CPU component timings of owner decision D25 in its details), #fixed-decay (one decay rule
 * on harmonics and on filter-bank bands) and #rising-weights (a rising weight on the harmonics).
 *
 * Every figure is a field of ssvep-followups-update.json, made by src/data/ssvep-followups.ts from its path and
 * printed with data-at and data-fig; scripts/checks/ssvep-followups.mjs holds each to its field and format. A shared
 * level prints its interval on its home card only and links that card elsewhere; every contrast prints its own
 * interval. Wearable-102 sits in its own block and table, never ranked against BETA. The CPU timings are component
 * medians labelled as the export labels them, never summed, with no host label.
 *
 * Props
 *   locale: Locale — 'en' or 'zh'.
 *   cards: number[] — which of its cards (10, 11, 13, 14) to render here; the page interleaves the two components so
 *     the cards run in number order.
 */
import type { Locale } from '../../data/i18n';
import { hrefFor } from '../../data/i18n';
import {
  need, figAt, countAt, st, scChrome, level, contrast, spansZero, lvBits, ctBits, levelCell, contrastCell, rangeCell, toHtml, figHtml,
  nameOf, trainingWords, roleWords, taskWords, contrastName, intervalText, cardLink, keyed, codeOf, said, cardOfStudy,
  type Bit, type AnyBit, type ScStudy, type ScFig,
} from '../../data/ssvep-followups';

interface Props { locale: Locale; cards?: number[] }
const { locale, cards = [10, 11, 13, 14] } = Astro.props;
const show = (n: number) => cards.includes(n);
const zh = locale === 'zh';
const H = (bits: AnyBit[]) => toHtml(bits);
const to = zh ? ' 至 ' : ' to ';
const [c10, c11, c13, c14] = ([10, 11, 13, 14] as const).map(n => scChrome(n, locale));
const A: ScStudy = 'harmonic_pooling', C: ScStudy = 'harmonic_pooling_wearable', P: ScStudy = 'practical_settings', D: ScStudy = 'fixed_decay', W: ScStudy = 'rising_weights';
const nm = (id: ScStudy, code: string) => nameOf(id, code, locale);
const ln = (n: number) => cardLink(n, locale);
const lnC = (n: number) => cardLink(n, locale, false, true);
const contrastRows = (id: ScStudy, keys = Object.keys(st(id).contrasts)) => keys.map(k => {
  const c = contrast(id, k);
  return { k, name: contrastName(id, c, locale), task: taskWords(k, locale), role: roleWords(c.role, locale), cell: contrastCell(c, locale) };
});

// --- Card 10: pooling the per-harmonic statistics -------------------------------------------------------------------
const a = st(A), cw = st(C);
const aP = ['RAW-LEAD3-RIDGE minus RAW-HARM-SUM/u8', 'EIG-RAW minus RAW-LEAD3-RIDGE/u8', 'RAW-HARM-ALLSUM minus RAW-HARM-SUM/u8'].map(k => contrast(A, k));
const aS = ['RAW-HARM-MAX minus RAW-HARM-SUM/u8', 'JOINT-ALLSUM minus CCA-RAW/u8', 'EIG-JOINT minus JOINT-ALLSUM/u8'].map(k => contrast(A, k));
need(a.design.contrast_family.primary === 3 && a.design.contrast_family.secondary === 3 && a.design.contrast_family.multiplicity_adjusted === false
  && a.design.contrast_family.equivalence_margin === null && aP.every(c => c.role === 'primary') && aS.every(c => c.role === 'secondary')
  && Object.keys(a.contrasts).length === 6, 'card 10, BETA: three primary and three secondary contrasts, no margin');
need(spansZero(aP[0]) && spansZero(aP[1]) && aP[2].hi.raw < 0 && aS[0].hi.raw < 0 && aS[1].lo.raw > 0 && spansZero(aS[2]),
  'card 10, BETA: the top-three ridge and the eigenvalue head unresolved, the all-component sum below the harmonic sum');
need(a.design.arms.find((x: any) => x.code === 'RAW-HARM-ALLSUM').components === 'all six components'
  && a.design.arms.find((x: any) => x.code === 'RAW-HARM-SUM').components === 'leading component of each harmonic'
  && a.design.arms.find((x: any) => x.code === 'RAW-LEAD3-RIDGE').components === 'leading component of each harmonic', 'card 10: what each rule pools');
keyed(A, 'eigenfeatures_carry_cca_statistics', 'pooling_rules_only', 'no_learned_lead3_advantage', 'no_equivalence_margin', 'seen_descriptive');
const cP = ['EIG-RAW minus RAW-HARM-SUM/dry', 'EIG-RAW minus RAW-HARM-SUM/wet'].map(k => contrast(C, k));
need(cw.design.contrast_family.primary === 1 && cw.design.contrast_family.per_sensor === true && cP.every(c => c.role === 'primary' && spansZero(c))
  && Object.values(cw.contrasts).filter((c: any) => c.role === 'primary').length === 2, 'card 10, Wearable-102: one primary contrast per sensor, both unresolved');
const sh = cw.design.source_heads;
need(sh.dataset === 'BETA' && sh.heads_per_learned_arm === 35 && sh.collapsed_to_one_affine_function === true && sh.target_fits === 0 && sh.target_selection === false
  && sh.retraining === false && cw.design.dataset.same_windows_as === 'wearable_transfer' && cw.design.dataset.candidate_order === 'native order, unsorted'
  && cw.design.dataset.tie_rule === 'first native candidate index' && cw.checks.matched_cca_equals_card7.dry && cw.checks.matched_cca_equals_card7.wet,
  'card 10, Wearable-102: card 7’s windows, 35 BETA heads collapsed to one function, nothing fitted on the target');
keyed(C, 'intervals_conditional_on_heads', 'average_not_compact_model', 'not_comparable_with_beta_tasks', 'not_unknown_frequency_discovery',
  'stored_amplitude_units', 'window_onset_and_filter', 'candidates_supplied_off_grid', 'prior_use_overlap', 'no_single_factor', 'no_equivalence_margin');
const c10Beta = a.design.arms.map((x: any) => ({ code: x.code, name: nm(A, x.code), training: trainingWords(x.training, locale),
  cells: ['u8', 'seen_ba'].map(t => levelCell(level(A, `${x.code}/${t}`), locale)) }));
const c10Wear = cw.design.methods.map((x: any) => ({ code: x.code, name: nm(C, x.code), training: trainingWords(x.training, locale),
  cells: ['dry', 'wet'].map(t => levelCell(level(C, `${x.code}/${t}`), locale)) }));
need(cw.design.methods.find((x: any) => x.code === 'CCA-RAW').level_only === true && level(C, 'CCA-RAW/dry').iv === null && level(C, 'CCA-RAW/dry').home === 7,
  'card 10: matched CCA is card 7’s level only');
const c10Rows = [...contrastRows(A), ...contrastRows(C)];

// --- Card 11: filter-bank CCA, shorter windows, fewer electrodes -----------------------------------------------------
const p = st(P), dz = p.design;
const cellIdx = (id: string) => dz.cells.findIndex((c: any) => c.id === id);
need(p.grid.order === 'prospective' && p.checks.grid_order_is_prospective === true && p.grid.cells.join() === dz.cells.map((c: any) => c.id).join()
  && p.grid.methods.join() === dz.methods.map((m: any) => m.code).join(), 'card 11: the grid in prospective order');
const cellLabel = (id: string, sep = ' · '): Bit[] => { const i = cellIdx(id);
  return [figAt(['studies', P, 'design', 'cells', i, 'window_s'], 's1'), sep, countAt('studies', P, 'design', 'cells', i, 'electrodes'), zh ? ' 个电极' : ' electrodes']; };
// In a sentence the electrode count is a word ("2.0 s with four electrodes"), as the card's other sentences say it.
const inCell = (id: string): Bit[] => { const i = cellIdx(id);
  return [figAt(['studies', P, 'design', 'cells', i, 'window_s'], 's1'), zh ? '、' : ' with ', said(dz.cells[i].electrodes, locale), zh ? '个电极' : ' electrodes']; };
const anchor = 'w500-c8', anchorCell = dz.cells[cellIdx(anchor)];
need(anchorCell.window_s === 2 && anchorCell.electrodes === 8 && [...dz.cells].sort((x: any, y: any) => y.samples - x.samples || y.electrodes - x.electrodes)[0].id === anchor,
  'card 11: the 2-s, eight-electrode cell is the longest window with the most electrodes');
const FB = dz.fbcca.code, SUM = 'RAW-HARM-SUM-H3', CCA = 'CCA-RAW-H3', EIG = 'EIG-RAW6-RIDGE';
const pk = (cell: string, code: string, t = 'u8') => `${cell}/${code}/${t}`;
const pc = (l: string, r: string) => contrast(P, `${l} minus ${r}/u8`);
const fbL = level(P, pk(anchor, FB)), fbSum = level(P, pk(anchor, SUM)), fbCca = level(P, pk(anchor, CCA));
const fbVsSum = pc(`${anchor}/${FB}`, `${anchor}/${SUM}`), fbVsCca = pc(`${anchor}/${FB}`, `${anchor}/${CCA}`);
need(dz.primary.B.join() === fbVsSum.key && fbVsSum.role === 'primary' && fbVsSum.lo.raw > 0 && fbVsCca.role === 'secondary' && fbVsCca.lo.raw > 0
  && fbL.home === 11 && fbSum.home === 9 && fbCca.home === 5, 'card 11: filter-bank CCA above the harmonic sum (primary) and CCA (secondary), at its home card');
const dPrim = dz.primary.D.map((k: string) => contrast(P, k));
const dPos = dPrim.filter((c: any) => c.lo.raw > 0);
need(dPrim.length === 6 && dPrim.every((c: any) => c.role === 'primary') && dPos.length === 1 && dPos[0].key === `w500-c4/${EIG} minus w500-c4/${SUM}/u8`
  && dPrim.filter((c: any) => c !== dPos[0]).every((c: any) => spansZero(c)) && dPrim.length === dz.cells.length, 'card 11: one of six eigenvalue-head primaries above zero, at 2 s and four electrodes');
keyed(P, 'one_learning_contrast_positive', 'complete_pipelines', 'observation_window_not_latency', 'author_preprocessing_inherited', 'recorded_subset_not_headset',
  'eight_not_always_better', 'candidates_supplied', 'no_forty_way_claim', 'not_foundation_model_evidence', 'not_bitwise_matlab', 'other_recipe_on_site', 'seen_descriptive');
const win4 = pc(pk('w125-c4', FB).replace('/u8', ''), pk('w500-c4', FB).replace('/u8', '')), win8 = pc(pk('w125-c8', FB).replace('/u8', ''), pk('w500-c8', FB).replace('/u8', ''));
need(win4.hi.raw < 0 && win8.hi.raw < 0, 'card 11: shorter windows cut filter-bank CCA');
const elec = p.contrast_groups.electrodes.map((k: string) => contrast(P, k));
need(elec.length === 5 && elec.every((c: any) => c.hi.raw < 0 && c.key.startsWith('w250-c4/') && c.key.includes(' minus w250-c8/')), 'card 11: four against eight electrodes at 1 s, every interval below zero');
const elecFb = elec.find((c: any) => c.key.startsWith(`w250-c4/${FB} `))!, elecRaw = elec.filter((c: any) => c !== elecFb);
need(elecRaw.length === 4 && elecRaw.every((c: any) => dz.raw_family.codes.includes(codeOf(c.left))), 'card 11: the four raw-family methods');
const elecLo = [...elecRaw].sort((x: any, y: any) => x.est.raw - y.est.raw)[0], elecHi = [...elecRaw].sort((x: any, y: any) => y.est.raw - x.est.raw)[0];
const q = p.qualifiers.eight_electrodes_not_always_better;
need(q.cells.join() === 'w125-c4,w125-c8' && q.paired_interval === null && q.limitation_key === 'eight_not_always_better' && q.methods_four_above_eight.length === 3
  && q.methods_four_above_eight.every((m: string) => p.levels[pk('w125-c4', m)].estimate > p.levels[pk('w125-c8', m)].estimate), 'card 11: at 0.5 s three methods score higher with four electrodes');
const fbd = dz.fbcca, other = fbd.other_recipe_on_site;
need(fbd.sub_bands === 7 && fbd.harmonics === 5 && fbd.trained_head === false && fbd.bitwise_replication_of_the_matlab_code === false
  && other.code === 'S11' && other.page === '/topics/questions-in-language/' && other.filter === 'Butterworth' && other.release_id === 'questions-in-language-update-20261008'
  && fbd.input === 'the authors’ preprocessed window, cropped before its own filtering' && dz.preprocessing.crop_before_new_filtering === true
  && dz.preprocessing.new_filtering_borrows_later_samples === false,
  'card 11: its filter-bank recipe, and route 3’s other recipe on its page');
const ans11 = p.answers_not_run[0];
need(p.answers_not_run.length === 1 && ans11.card === 6 && ans11.item === 'filter-bank CCA', 'card 11 runs filter-bank CCA, which card 6 did not run');
need(p.reproduces.filter((r: any) => r.role_here !== undefined && r.role_there !== undefined && r.role_here !== r.role_there).length === 2
  && p.reproduces.every((r: any) => { const here = r.here.includes(' minus ') ? p.contrasts[r.here] : p.levels[r.here];
    const src = r.card === 5 ? undefined : st(r.study as ScStudy)[r.here.includes(' minus ') ? 'contrasts' : 'levels'][r.there];
    return here && (r.card === 5 || Math.abs(here.estimate - src.estimate) < 1e-12); }), 'card 11: the 2-s, eight-electrode cell reproduces cards 9 and 10');
const METHODS = p.grid.methods as string[];
const gridRows = (t: 'u8' | 'seen_ba') => (p.grid.cells as string[]).map(cell => ({ cell, label: cellLabel(cell), cells: METHODS.map(m => levelCell(level(P, pk(cell, m, t)), locale)) }));
const GROUP: Record<string, Record<'en' | 'zh', string>> = { method: { en: 'method', zh: '方法' }, window: { en: 'window', zh: '时间窗' }, electrodes: { en: 'electrodes', zh: '电极' } };
need(Object.keys(p.contrast_groups).join() === 'method,window,electrodes'
  && Object.values(p.contrast_groups).flat().length === Object.keys(p.contrasts).length, 'card 11: three groups cover the contrasts');
const pName = (key: string): Bit[] => {
  const c = contrast(P, key), [lc, lm] = c.left.split('/'), [rc, rm] = c.right.split('/');
  if (lc === rc) return [`${nm(P, lm)} − ${nm(P, rm)}, `, ...cellLabel(lc)];
  need(lm === rm, `${key}: one method or one cell`);
  return [`${nm(P, lm)}: `, ...cellLabel(lc), ' − ', ...cellLabel(rc)];
};
const c11Rows = Object.entries(p.contrast_groups as Record<string, string[]>).flatMap(([gid, keys]) => keys.map(k => {
  const c = contrast(P, k);
  return { k, group: GROUP[gid][locale], name: H(pName(k)), role: roleWords(c.role, locale), cell: contrastCell(c, locale) };
}));
// CPU component timings (D25): warm, single-thread wall-clock medians [min, max], components only, never summed, no host label.
const cpu = p.cpu_components, m = cpu.measurement;
need(m.clock === 'wall' && m.unit === 'ms' && m.statistic === 'median [min, max]' && m.measured_calls === 3 && m.warmup_calls_excluded === 1 && m.threads === 1
  && m.gpu === false && m.buffers === 'warm' && m.candidates === 40 && m.batch_sizes.join() === '1,8' && m.summed === false
  && cpu.anchor_cell === anchor && cpu.checks.whole_method_measurements === 0 && cpu.label.en === 'components; not sensor-to-decision or online latency',
  'card 11: warm single-thread component medians of three calls, never summed, at the anchor cell');
need(!/\b(?:A[M]D|Intel|Ry[z]en|Thread[r]ipper|Xeon|EPYC|Apple|M\d|GHz|Linux|Ubuntu|macOS|Windows|Python|NumPy|SciPy \d)\b/i.test(JSON.stringify(cpu)), 'card 11: no host, processor, system or runtime label in the timings');
for (const k of ['components_never_summed', 'not_sensor_to_decision', 'shared_geometry_counted_once', 'readouts_exclude_extraction', 'forty_candidates',
  'three_warm_repetitions', 'wall_times_used', 'one_head_not_average', 'unmeasured_stages', 'batch_amortised_not_lone_trial', 'anchor_not_chosen_by_speed',
  'no_hardware_recommendation']) need(cpu.limitations_keys.includes(k), `card 11 timings carry ${k}`);
const COMPONENT: Record<string, Record<'en' | 'zh', string>> = {
  crop: { en: 'crop, validation and copy', zh: '裁剪、校验与复制' },
  raw_filter: { en: 'raw 6–80 Hz filter', zh: '原始信号 6–80 Hz 滤波' },
  raw_geometry: { en: 'shared raw CCA geometry', zh: '共享的原始 CCA 几何计算' },
  fbcca: { en: 'filter-bank CCA: filter, geometry and scores', zh: '滤波器组 CCA：滤波、几何计算与打分' },
  top3_readout: { en: 'top-three ridge readout on cached statistics', zh: '基于缓存统计量的三项主分量岭回归读出' },
  eigenvalue_readout: { en: 'eigenvalue head readout on cached statistics', zh: '基于缓存统计量的特征值分类头读出' },
};
need(cpu.components.every((c: any) => COMPONENT[c.code]?.en === c.name) && dz.raw_family.band_hz.join() === '6,80', 'card 11: words for each timed component');
const cpuRows = cpu.components.map((c: any) => ({ code: c.code, name: COMPONENT[c.code][locale], cells: [1, 8].map(b => {
  const k = `${anchor}/${b}/${c.code}`, base = ['studies', P, 'cpu_components', 'groups', k, b === 1 ? 'wall_ms_per_call' : 'wall_ms_amortised'];
  need(cpu.groups[k]?.cell === anchor && cpu.groups[k].batch === b && cpu.groups[k].component === c.code, `the timing group ${k}`);
  return rangeCell(figAt([...base, 'median'], 'sig3'), figAt([...base, 'min'], 'sig3'), figAt([...base, 'max'], 'sig3'), locale);
}) }));
const fbMs = (b: 1 | 8) => figAt(['studies', P, 'cpu_components', 'groups', `${anchor}/${b}/fbcca`, b === 1 ? 'wall_ms_per_call' : 'wall_ms_amortised', 'median'], 'sig3');
const batch8 = countAt('studies', P, 'cpu_components', 'measurement', 'batch_sizes', 1);

// --- Card 13: one decay rule ------------------------------------------------------------------------------------------
const d = st(D), rule = d.design.rule;
need(rule.weight === 'n^-1.25 + 0.25' && rule.exponent === 1.25 && rule.offset === 0.25 && rule.origin === 'the sub-band weights of the published filter-bank CCA recipe'
  && fbd.sub_band_weights === 'n^-1.25 + 0.25 for sub-band n = 1 to 7' && d.design.harmonic_and_sub_band_weights_are_different_operations === true
  && d.design.each_contrast_changes_weights_within_one_construction === true && d.design.constructions.H3.terms === 3 && d.design.constructions.FBCCA.terms === 7
  && d.design.training_fits === 0, 'card 13: the filter-bank recipe’s weight rule on three harmonics and on seven sub-bands, nothing trained');
const ruleBits = (): AnyBit[] => ['n', '^', '−', figAt(['studies', D, 'design', 'rule', 'exponent'], 'auc2'), ' + ', figAt(['studies', D, 'design', 'rule', 'offset'], 'auc2')];
const dP = contrast(D, 'H3-DECAY minus H3-FLAT/u8'), dFb = contrast(D, 'FBCCA-DECAY minus FBCCA-FLAT/u8');
const dSeen = contrast(D, 'H3-DECAY minus H3-FLAT/seen_ba'), dFbSeen = contrast(D, 'FBCCA-DECAY minus FBCCA-FLAT/seen_ba');
const dDry = contrast(D, 'H3-DECAY minus H3-FLAT/dry'), dWet = contrast(D, 'H3-DECAY minus H3-FLAT/wet');
const eq = d.equivalence;
need(dP.role === 'primary' && Object.values(d.contrasts).filter((c: any) => c.role === 'primary').length === 1 && eq.contrast === dP.key && eq.met === false
  && eq.interval_beyond_margin === true && eq.interval[1] < -eq.margin && dP.flags.equivalence_met === false && dP.hi.raw < 0 && dFb.lo.raw > 0,
  'card 13: the single primary contrast, its 90% interval wholly outside the margin; the sub-band rule raises filter-bank CCA');
need(Math.abs(d.levels['FBCCA-DECAY/u8'].estimate - p.levels[pk(anchor, FB)].estimate) < 1e-12 && level(D, 'FBCCA-DECAY/u8').home === 11
  && level(D, 'H3-FLAT/u8').home === 9, 'card 13: the decayed filter-bank arm is card 11’s filter-bank CCA; the flat harmonic sum card 9’s');
keyed(D, 'equivalence_not_met', 'equivalence_approximate', 'within_construction_only', 'secondary_descriptive', 'harmonic_weighting_is_adaptation', 'no_optimality_claim', 'wearable_units_and_windows');
const eqLo = figAt(['studies', D, 'equivalence', 'interval', 0], 'sgn2'), eqHi = figAt(['studies', D, 'equivalence', 'interval', 1], 'sgn2');
const eqLevel = figAt(['studies', D, 'equivalence', 'interval_level'], 'pct0'), eqMargin = figAt(['studies', D, 'equivalence', 'margin'], 'pm1');
const D_ARMS = ['H3-FLAT', 'H3-DECAY', 'FBCCA-FLAT', 'FBCCA-DECAY'], T4 = ['u8', 'seen_ba', 'dry', 'wet'];
const c13Levels = D_ARMS.map(code => ({ code, name: nm(D, code), cells: T4.map(t => d.levels[`${code}/${t}`] ? levelCell(level(D, `${code}/${t}`), locale) : '—') }));
need(Object.values(d.levels).every((l: any) => l.interval === null) && D_ARMS.every(c => T4.some(t => d.levels[`${c}/${t}`])), 'card 13: levels without intervals');

// --- Card 14: rising weights ------------------------------------------------------------------------------------------
const w = st(W);
need(w.design.weights.literal_rise.join() === '1,1.5,1.9' && w.display_names.literal_rise === 'rising weights 1, 1.5, 1.9 (no training)'
  && w.design.weights.flat.join() === '1,1,1' && w.design.same_vector_for_every_candidate === true && w.design.training_fits === 0
  && w.design.pooled === 'the three harmonic-local leading squared canonical correlations', 'card 14: the rising weights its name states, on the three harmonics, nothing trained');
const crit = w.criterion, wP = contrast(W, 'literal_rise minus flat/u8');
need(crit.contrast === wP.key && crit.met === true && crit.prespecified === true && crit.rule === 'the paired 95% interval lies wholly above zero' && wP.lo.raw > 0
  && wP.role === 'primary' && Object.values(w.contrasts).filter((c: any) => c.role === 'primary').length === 1, 'card 14: the single prespecified criterion, met');
const wSeen = contrast(W, 'literal_rise minus flat/seen_ba'), wDry = contrast(W, 'literal_rise minus flat/dry'), wWet = contrast(W, 'literal_rise minus flat/wet');
need(spansZero(wSeen) && wDry.hi.raw < 0 && spansZero(wWet) && wSeen.role === 'secondary' && wDry.role === 'secondary' && wWet.role === 'secondary',
  'card 14: seen unresolved, dry below zero, wet unresolved');
keyed(W, 'single_primary', 'secondary_descriptive', 'exact_profile_rounding_check', 'dry_decrement_wet_unresolved', 'coverage_heuristic', 'passbands_wider_than_nominal',
  'no_alpha_test', 'no_learned_weights');
need(Object.entries(w.contrasts).filter(([k]) => k.startsWith('exact_rise')).every(([, c]: [string, any]) => c.role === 'rounding_check')
  && /^cumulative sum of n\^-1\.25 \+ 0\.25 over n = 1 to 3, divided by its first term$/.test(w.design.exact_profile), 'card 14: the exact profile is a rounding check of card 13’s rule');
// The coverage heuristic in one clause: the recipe's sub-bands rise in their lower edges and share one upper edge (nested).
need(typeof fbd.pass_band_high_edge_hz === 'number' && fbd.pass_band_low_edges_hz.length === fbd.sub_bands
  && fbd.pass_band_low_edges_hz.every((x: number, i: number, a: number[]) => i === 0 || x > a[i - 1]) && fbd.pass_band_low_edges_hz.at(-1) < fbd.pass_band_high_edge_hz,
  'card 14: filter-bank CCA’s sub-bands are nested, one upper edge and rising lower edges');
const W_ARMS = ['flat', 'literal_rise', 'exact_rise'];
const c14Levels = W_ARMS.map(code => ({ code, name: nm(W, code), cells: T4.map(t => levelCell(level(W, `${code}/${t}`), locale)) }));

const copy = {
  en: {
    q10: 'CCA gives one squared correlation per harmonic. Does the rule that pools them matter, and does a learned rule do better than a sum?',
    betaH3: 'BETA, held-out frequencies',
    lead10a: (): Bit[] => ['All three primary contrasts: the top-three ridge, learned on each harmonic’s leading correlation, minus the harmonic sum ', ...ctBits(aP[0], locale),
      ', unresolved; the eigenvalue head minus the top-three ridge ', ...ctBits(aP[1], locale), ', unresolved; the all-component sum, which sums all six components rather than each harmonic’s leading one, minus the harmonic sum ',
      ...ctBits(aP[2], locale), '.'],
    lead10b: (): Bit[] => ['Secondary: the harmonic max minus the harmonic sum ', ...ctBits(aS[0], locale), '; the joint all-component sum minus CCA ', ...ctBits(aS[1], locale),
