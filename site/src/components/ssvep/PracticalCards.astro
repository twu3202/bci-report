<style is:global>
  /* Global, not scoped (the page's contract: a scoped style would add data-astro-cid-* to every element, and
     check-workbench.mjs reads figures by their exact markup). Every selector starts from one of these cards. */
  :is([data-ssvep-card="10"],[data-ssvep-card="11"],[data-ssvep-card="13"],[data-ssvep-card="14"]) .topic-table th[scope=row] small{display:block;margin-top:3px;font-size:.7rem;font-weight:400;color:var(--muted);line-height:1.4}
  :is([data-ssvep-card="10"],[data-ssvep-card="11"],[data-ssvep-card="13"],[data-ssvep-card="14"]) .topic-table code{font-family:var(--mono);font-size:.72rem}
  :is([data-ssvep-card="10"],[data-ssvep-card="11"],[data-ssvep-card="13"],[data-ssvep-card="14"]) :is(p.roadmap-p,p.protocol-note) a{color:var(--accent)}
  :is([data-ssvep-card="10"],[data-ssvep-card="11"],[data-ssvep-card="13"],[data-ssvep-card="14"]) .topic-table .interval a{color:inherit;text-decoration:underline}
  [data-ssvep-card="11"] details + details{margin-top:12px}
</style>
