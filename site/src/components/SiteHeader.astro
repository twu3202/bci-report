---
/**
 * The one header. Three pages used to carry their own copy of this markup, and
 * they had already drifted — index.astro listed an "Updates" link the shared
 * component did not have. A language switcher would have made that four copies
 * to keep in step, so the copies went first.
 *
 * Since 2026-10-02 every hub has its own link and its own `active` key:
 * Questions (/topics/), Results (the home matrix), Protocols, Methods, Datasets,
 * Releases, API and Data use. "Updates" went: it opened external field notes,
 * which now sit at the foot of /methods/, while the site's own updates are the
 * release log. /api/ used to light up "Datasets".
 */
import { site } from '../data/site';
import { chrome, hrefFor, isTranslated, localeNames, locales, localizePath, type Locale, type NavKey } from '../data/i18n';

interface Props {
  locale: Locale;
  /** Current path without a locale prefix, e.g. `/` or `/topics/on-the-move/`. */
  path: string;
  active?: NavKey;
  /** The homepage anchors work in place; other pages have to travel home first. */
  anchorsAreLocal?: boolean;
}
const { locale, path, active, anchorsAreLocal = false } = Astro.props;
const t = chrome[locale];
const anchor = (id: string) => (anchorsAreLocal ? `#${id}` : hrefFor(`/#${id}`, locale));
const current = (key: NavKey) => (active === key ? 'page' : undefined);
// On a page with no translation the switcher still works, but it cannot offer
// "this page in Chinese". It goes to that locale's home and says why.
const translated = isTranslated(path);
const switchTo = (code: Locale) => localizePath(translated ? path : '/', code);
---
<header class="site-header">
  <a class="brand" href={hrefFor('/', locale)}><img class="mark" src="/logo.svg" width="30" height="30" alt="" />{site.name}</a>
  <nav aria-label={t.mainNav}>
    <a href={hrefFor('/topics/', locale)} aria-current={current('topics')}>{t.nav.questions}</a>
    <a href={anchor('overview')} aria-current={current('home')}>{t.nav.results}</a>
    <a href={hrefFor('/protocols/', locale)} aria-current={current('protocols')}>{t.nav.protocols}</a>
    <a href={hrefFor('/methods/', locale)} aria-current={current('methods')}>{t.nav.methods}</a>
    <a href={hrefFor('/datasets/', locale)} aria-current={current('datasets')}>{t.nav.datasets}</a>
    <a href={hrefFor('/releases/', locale)} aria-current={current('releases')}>{t.nav.releases}</a>
    <a href={hrefFor('/api/', locale)} aria-current={current('api')}>{t.nav.api}</a>
    <a href="/data-use/" aria-current={current('data-use')}>{t.nav.dataUse}{t.englishMark}</a>
  </nav>
  <div class="lang" role="group" aria-label={t.languageLabel}>
    {locales.map((code) => (
      code === locale
        ? <span class="lang-on" aria-current="true">{localeNames[code]}</span>
        : <a href={switchTo(code)} hreflang={code === 'zh' ? 'zh-Hans' : code} lang={code === 'zh' ? 'zh-Hans' : code}
             title={translated ? undefined : chrome[code].onlyInEnglish}>{localeNames[code]}</a>
    ))}
  </div>
</header>
