---
/**
 * The published figures for one entity, one table per group. Every value is a
 * `Fig` from src/data/entities.ts and carries `data-fig="<file>|<format>|<raw>"`
 * so check-workbench.mjs can re-read the leaf from the served file and re-format
 * it. A plot is added above a group when it has two or more balanced-accuracy
 * rows with intervals, on one scale.
 */
import IntervalPlot from './IntervalPlot.astro';
import { formatFig, isEnglishOnly, methodLabel, methodLabelIsEnglish, tr, type Fig, type ResultGroup, type DatasetEntity } from '../data/entities';
import { entityCopy } from '../data/entity-copy';
import { hrefFor, topicCards, type Locale } from '../data/i18n';
import { protocolLinkLabel } from '../data/protocols';
import { fmText } from '../data/foundation-models-zh';
import { fmModels, fmTermsSentence } from '../data/foundation-models';
import { rdLimits } from '../data/reliable-decisions-limits';
import BoasGaps from './BoasGaps.astro';
import { groupLimits, groupRule } from '../data/shared-encoder';
import { qlGroupLimits } from '../data/questions-in-language';

// fmEndorsement: whether each v9 group's weights terms end with "No model's authors endorse these results". A method
// page passes false: it states that once, in its checkpoints-and-terms section (2026-10-08).
interface Props { locale: Locale; groups: (ResultGroup & { dataset?: DatasetEntity })[]; showMethod?: boolean; fmEndorsement?: boolean }
const { locale, groups, showMethod = true, fmEndorsement = true } = Astro.props;
const c = entityCopy[locale];
const attr = (f: Fig) => `${f.src}|${f.fmt}|${f.raw}`;
const pageLabel = (path: string) => {
  const slug = path.match(/^\/topics\/([^/#]+)\//)?.[1];
  return slug ? topicCards[locale][slug].title : (protocolLinkLabel(path, locale) ?? (locale === 'zh' ? '核心矩阵（首页）' : 'Core matrix (home page)'));
};
const plottable = (g: ResultGroup) => {
  const rows = g.rows.filter(r => r.metric.en === 'Balanced accuracy' && r.interval && (r.value.fmt === 'pct1' || r.value.fmt === 'pct1raw'));
  return rows.length >= 2 && rows.length <= 16 && new Set(rows.map(r => r.value.fmt)).size === 1 ? rows : [];
};
const heading = (g: ResultGroup & { dataset?: DatasetEntity }) => g.dataset ? `${g.dataset.name} · ${tr(g.title, locale)}` : tr(g.title, locale);
// A URL the export's text carries in parentheses is printed as itself, linked: printable ASCII without brackets, ending in
// a letter, digit or slash, so neither a closing bracket and full stop nor the Chinese that follows it joins the link.
const urlParts = (s: string) => s.split(/(https:\/\/[!-'*-~]*[A-Za-z0-9\/])/);
// Route 2 (2026-10-07): a BOAS group carries the three stated gaps, the participants' wording and the credit beside
// its rows (BoasGaps.astro), on the dataset page and on every method page that shows them. Its note prints the
// stage-only read-out's two figures (shared-encoder.ts groupLimits), inside the same data-boas section. Route 3
// (2026-10-08) does the same for its BOAS group (qlNotes), and every route-3 group prints the limitations that bear on
// its figures (questions-in-language.ts qlGroupLimits).
---
{groups.map(g => {
  const plot = plottable(g);
  // When every row shares one condition, the plot labels need only the method.
  const oneCondition = new Set(plot.map(r => r.condition.en)).size === 1;
  const scale = plot[0]?.value.fmt === 'pct1raw' ? 100 : 1;
  const files = [...new Set(g.rows.flatMap(r => [r.value.src]))];
  return (
    <section class="entity-group" id={`g-${g.dataset ? g.dataset.slug + '-' : ''}${g.id}`} data-boas={g.srNotes === 'boas' || g.qlNotes === 'boas' ? 'true' : undefined}>
      <h3>{g.dataset ? <><a href={hrefFor(`/datasets/${g.dataset.slug}/`, locale)} lang="en">{g.dataset.name}</a> · {tr(g.title, locale)}</> : tr(g.title, locale)}</h3>
      <p class="entity-group-meta">{c.readOn} <a href={hrefFor(g.path, locale)}>{pageLabel(g.path)}</a>{g.chance && <> · {c.chance} <span data-fig={attr(g.chance)}>{formatFig(g.chance)}</span></>} · {files.map((f, i) => <>{i > 0 && ', '}<a href={`/data/${f}`} download>{f}</a></>)}</p>
      {plot.length > 0 && <IntervalPlot
        caption={c.plotCaption(plot.length)}
        legend={g.plotLegend ? tr(g.plotLegend, locale) : c.plotLegend}
        domain={[0, scale]}
        ticks={['0%', '25%', '50%', '75%', '100%']}
        reference={g.chance ? g.chance.raw : undefined}
        rows={plot.map(r => ({ label: oneCondition ? methodLabel(r, locale) : `${methodLabel(r, locale)} · ${tr(r.condition, locale)}`,
                               labelLang: methodLabelIsEnglish(r, locale) && (oneCondition || isEnglishOnly(r.condition, locale)) ? 'en' : undefined,
                               value: r.value.raw, interval: [r.interval![0].raw, r.interval![1].raw] as [number, number],
                               text: `${formatFig(r.value)} (${formatFig(r.interval![0])}–${formatFig(r.interval![1])})`, tone: r.comparator ? 'muted' as const : 'rust' as const }))}
      />}
      {g.rows.length > 0 && <div class="topic-table scroll" tabindex="0" role="region" aria-label={c.resultsRegion(heading(g))}>
        <table>
          <thead><tr>{showMethod && <th scope="col">{c.colMethod}</th>}<th scope="col">{c.colCondition}</th><th scope="col">{c.colMetric}</th><th scope="col">{c.colValue}</th><th scope="col">{c.colPeople}</th></tr></thead>
          <tbody>{g.rows.map(r => (
            <tr>
              {showMethod && <th scope="row" lang={methodLabelIsEnglish(r, locale) ? 'en' : undefined}>{r.methodSlug ? <a href={hrefFor(`/methods/${r.methodSlug}/`, locale)}>{methodLabel(r, locale)}</a> : methodLabel(r, locale)}{r.comparator && <small lang={locale === 'zh' ? 'zh-Hans' : 'en'}>{c.comparator}</small>}</th>}
              <td lang={isEnglishOnly(r.condition, locale) ? 'en' : undefined}>{tr(r.condition, locale)}</td>
              <td lang={isEnglishOnly(r.metric, locale) ? 'en' : undefined}>{tr(r.metric, locale)}</td>
              <td>{r.of
                ? <span class="metric"><span data-fig={attr(r.value)}>{formatFig(r.value)}</span> / <span data-fig={attr(r.of)}>{formatFig(r.of)}</span></span>
                : <span data-fig={attr(r.value)} class="metric">{formatFig(r.value)}</span>}
                {r.interval && <span class="interval"><span data-fig={attr(r.interval[0])}>{formatFig(r.interval[0])}</span>–<span data-fig={attr(r.interval[1])}>{formatFig(r.interval[1])}</span></span>}
                {r.note && <small class="row-note">{r.note[locale].map(p => typeof p === 'string' ? p : <span data-fig={attr(p)} class="fig">{formatFig(p)}</span>)}</small>}</td>
              <td>{r.records ? <><span data-fig={attr(r.records)}>{formatFig(r.records)}</span>{c.records}</> : r.people ? r.people : c.noPeople}</td>
            </tr>
          ))}</tbody>
        </table>
      </div>}
      {g.fmTerms && g.rows.length > 0 && <p class="protocol-note fm-terms-note" data-fm-terms={g.fmTerms}>{fmTermsSentence(fmModels.filter(m => g.rows.some(r => r.method === m.name)), locale, fmEndorsement)} <a href={`${hrefFor(`/protocols/${g.fmTerms}/`, locale)}#v9-licences`}>{locale === 'zh' ? '全部权重许可与条款 →' : 'Every weights licence and its terms →'}</a></p>}
      {g.rdLimits && <p class="protocol-note rd-limits-note" data-rd-limits={g.rdLimits}><strong>{locale === 'zh' ? '这些数字说明不了什么：' : 'What these figures cannot say:'}</strong>{locale === 'en' && ' '}{rdLimits(g.rdLimits, locale).map((x, i) => <>{i > 0 && locale === 'en' && ' '}{urlParts(x).map((part, j) => j % 2 ? <a href={part} target="_blank" rel="noreferrer">{part}</a> : part)}</>)}{locale === 'en' && ' '}<a href={`${hrefFor('/topics/when-not-to-act/', locale)}#rd-limits`}>{locale === 'zh' ? '第一条路线的全部局限 →' : 'Every limitation of route 1 →'}</a></p>}
      {g.srNotes === 'boas' && g.rows.length > 0 && <BoasGaps locale={locale}/>}
      {g.srNotes && g.rows.length > 0 && <p class="protocol-note sr-limits-note" data-sr-limits={g.srNotes}><strong>{locale === 'zh' ? '这些数字说明不了什么：' : 'What these figures cannot say:'}</strong>{locale === 'en' && ' '}{groupLimits(g.srNotes, locale).map((parts, i) => <>{i > 0 && locale === 'en' && ' '}{parts.map(p => typeof p === 'string' ? p : <span data-fig={attr(p)} class="fig">{formatFig(p)}</span>)}</>)}{locale === 'en' && ' '}{groupRule[locale]}{locale === 'en' && ' '}<a href={`${hrefFor('/topics/shared-encoder/', locale)}#methods-and-limits`}>{locale === 'zh' ? '第二条路线的全部局限 →' : 'Every limitation of route 2 →'}</a></p>}
      {g.qlNotes === 'boas' && g.rows.length > 0 && <BoasGaps locale={locale}/>}
      {g.qlNotes && g.rows.length > 0 && <p class="protocol-note ql-limits-note" data-ql-limits={g.qlNotes}><strong>{locale === 'zh' ? '这些数字说明不了什么：' : 'What these figures cannot say:'}</strong>{locale === 'en' && ' '}{qlGroupLimits(g.qlNotes, locale).map((x, i) => <>{i > 0 && locale === 'en' && ' '}{x.text}</>)}{locale === 'en' && ' '}<a href={`${hrefFor('/topics/questions-in-language/', locale)}#methods-and-limits`}>{locale === 'zh' ? '第三条路线的全部局限 →' : 'Every limitation of route 3 →'}</a></p>}
      {g.notRun && g.notRun.length > 0 && <p class="protocol-note fm-not-run-note">{g.notRun.map((x, i) => {
        const why = fmText(x.reason, locale);
        return <>{i > 0 && ' '}<strong><span lang="en">{x.method}</span>{locale === 'zh' ? '：未运行，不是零。' : ': not run, never a zero.'}</strong> {why.text}{why.original && <span class="note-original" lang="en">{why.original}</span>}</>;
      })}</p>}
    </section>
  );
})}
