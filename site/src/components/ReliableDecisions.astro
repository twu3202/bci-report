---
/**
 * Route 1 of the decision-research roadmap, reliable decisions (2026-10-04,
 * owner approved): when a decoder should decline to decide, and what its
 * confidence is worth. The #reliable-decisions section of /topics/when-not-to-act/,
 * placed before #decision-research, whose slice check-workbench.mjs keeps
 * figure-free.
 *
 * Every figure is a leaf of reliable-decisions-update.json, printed with data-fig
 * (Fig.astro) and re-read from the served file. The rules this section lives under
 * (handoff of 2026-10-04 and the review manifest): balanced or uniform protocols,
 * so method comparisons and never deployment error rates; nothing accepted has
 * no error rate (a dash and its reason, never 0%); fewer than ten accepted is
 * flagged unstable and printed as a count, not a rate; a contrast is a difference
 * only when its interval excludes zero, and every contrast prints its verdict;
 * methods keep the matrix's order and are never ranked; people with nothing
 * accepted sit beside every coverage; secondary arms live in a collapsed panel,
 * ds003810 labelled crude; the idle protocol and BNCI2015-001 carry no figure.
 * The sentences that summarise a table are checked against the export below, and
 * the page refuses to build if the numbers stop supporting them.
 */
import reliable from '../data/reliable-decisions-update.json';
import Fig from './Fig.astro';
import ScoreBar from './ScoreBar.astro';
import { reliableMethod, tr, isEnglishOnly, formatFig, ppFmt, sgnFmt, covFmt, type Fig as FigValue, type Fmt } from '../data/entities';
import { hrefFor, topicCards, topicChrome, type Locale } from '../data/i18n';
import { elsewhere } from '../data/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === 'zh';
const tc = topicChrome[locale];
const SRC = 'reliable-decisions-update.json';
const f = (raw: number, fmt: Fmt = 'pct1'): FigValue => ({ raw, fmt, src: SRC });
// A difference in pp, an interval's lower bound and a coverage, each with a second decimal where one would read as zero.
const pp = (raw: number) => f(raw, ppFmt(raw)), sg = (raw: number) => f(raw, sgnFmt(raw)), cov = (raw: number) => f(raw, covFmt(raw));
type Part = string | FigValue;
type Diff = { mean: number; interval_95: number[]; excludes_zero: boolean };
type Level = { mean: number; interval_95: number[] };
type Op = { n: number; accepted: number; coverage: number; coverage_interval_95?: number[]; selective_error: number | null;
            selective_error_interval_95?: number[]; accepted_wrong?: number; unstable: boolean; people_with_nothing_accepted: number };
type Risk = Op & { outer_folds: number; certified_folds: number; folds_over_target: number; target_weighted: number | null;
                   error_minus_target: Diff | null };
type Recal = { prefix: string; labelled_prefix: string; labels_per_new_person: number; people_with_degenerate_personal_temperature: number;
               nll_change: Diff; ece_change: Diff; aurc_change: Diff; unlabelled_cutoff_gap_change: Diff };
type Method = { id: string; balanced_accuracy: number; error_accepting_everything: number; fixed_cutoff: Op & { cutoff: number };
                coverage_target: Op; risk_certification: Risk;
                ranking_S: { aurc: Level; error_at_80: Level; error_at_test_coverage: { coverage: number; selective_error: number }[] };
                ranking_L: { aurc: Level; error_at_80: Level };
                learned_minus_confidence: { aurc: Diff; error_at_80: Diff };
                probability_quality: { calibrated: { nll: Level; ece: Level; brier: Level }; raw: { nll: Level; ece: Level } | null;
                                       degenerate_population_temperature_folds: number };
                recalibration: Recal[] };
type Protocol = { protocol: string; dataset: string; people: number; outer_folds: number; classes: number; test_items: number; unit: string;
                  methods: Method[]; fixed_cutoff_coverage_differences: (Diff & { a: string; b: string })[];
                  common_coverage: { coverage: number; accepted: number; unstable: boolean; errors?: (Level & { id: string })[];
                                     differences?: (Diff & { a: string; b: string })[] };
                  rights: { name: string; attribution: string; source: string; license: string; licenseUrl: string; reviewBasis: string[] } };
const r = reliable.results['reliable-decisions'] as unknown as {
  design: { unstable_below_accepted: number }; protocols: Record<'arithmetic-rest' | 'beta-8ch', Protocol>;
  robustness: { mi_rest: Protocol & { methods: (Method & { risk_certification: Risk })[] };
                seeds: { rows: { protocol: string; method: string; seed: number; learned_minus_confidence: { aurc: Diff; error_at_80: Diff } }[] };
                matched_model_holdout: { rows: SensRow[] }; map_sensitivity: { rows: SensRow[] };
                l_joint: { rows: { protocol: string; learned_minus_confidence: { aurc: Diff; error_at_80: Diff } }[] } };
  audits: { independent_primary: { checks: number; passed: number }; independent_secondary: { checks: number; passed: number } };
  literature: { id: string; cite: string; url: string }[];
};
type SensRow = { protocol: string; method: string; variant: string; outer_folds: number; certified_folds: number; folds_over_target: number };
const EEGMAT = r.protocols['arithmetic-rest'], BETA = r.protocols['beta-8ch'], MIREST = r.robustness.mi_rest;
const panels = [BETA, EEGMAT];                     // the handoff's order: BETA, then EEGMAT
const tenth = r.design.unstable_below_accepted;
const name = (id: string) => tr(reliableMethod[id].label, locale);
// In prose and in "a − b" rows the LaBraM arms take a shorter name; tables keep the full label.
const short: Record<string, string> = zh
  ? { 'labram-frozen-ce': 'LaBraM（只训分类头）', 'labram-lora-r4': 'LaBraM（LoRA）' }
  : { 'labram-frozen-ce': 'LaBraM (head only)', 'labram-lora-r4': 'LaBraM (LoRA)' };
const shortName = (id: string) => short[id] ?? name(id);
const nameLang = (id: string) => isEnglishOnly(reliableMethod[id].label, locale) ? 'en' : undefined;
const byId = (p: Protocol, id: string) => p.methods.find(m => m.id === id)!;
const words = zh ? ['零', '一', '两', '三', '四'] : ['no', 'one', 'two', 'three', 'four'];
// A space between Latin text and Chinese, none after a full-width bracket.
const gap = (t: string) => /[）]$/.test(t) ? '' : ' ';
const listJoin = (xs: string[]) => zh ? xs.join('、') : xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs.at(-1)}`;

// --- The sentences below summarise the tables; each rests on these facts of the export. ----------
const primary = [EEGMAT, BETA];
const c2 = primary.flatMap(p => p.methods.map(m => ({ p, m, d: m.learned_minus_confidence.error_at_80 })));
if (c2.some(x => x.d.mean < 0 && x.d.excludes_zero)) throw new Error('reliable decisions: the copy says L had a lower error than S for no method');
if (!c2.some(x => x.d.excludes_zero)) throw new Error('reliable decisions: the copy says some C2 differences were resolved, all with L worse');
const c1 = primary.flatMap(p => p.methods.map(m => ({ p, m, d: m.learned_minus_confidence.aurc })));
const where = (x: { p: Protocol; m: Method }) => zh ? `${x.p.dataset} 的 ${shortName(x.m.id)}` : `${shortName(x.m.id)} on ${x.p.dataset}`;
const c1Better = c1.filter(x => x.d.excludes_zero && x.d.mean < 0).map(where), c1Worse = c1.filter(x => x.d.excludes_zero && x.d.mean > 0).map(where);
if (!c1Better.length || !c1Worse.length) throw new Error('reliable decisions: the AURC sentence names a better and a worse case');
if (EEGMAT.methods.some(m => m.risk_certification.certified_folds !== 0 || m.risk_certification.accepted !== 0))
  throw new Error('reliable decisions: the copy says S-risk certified nothing on EEGMAT');
if (BETA.methods.some(m => m.risk_certification.certified_folds === 0 || m.risk_certification.folds_over_target === 0))
  throw new Error('reliable decisions: the copy says S-risk certified folds for every BETA method and some went over target');
if (BETA.methods.some(m => m.risk_certification.error_minus_target!.excludes_zero))
  throw new Error('reliable decisions: the copy says no pooled error-minus-target was resolved');
const betaRecal = BETA.methods.map(m => m.recalibration[0]);
if (!betaRecal.every(x => x.labels_per_new_person === 40 && x.nll_change.excludes_zero && x.nll_change.mean < 0 && x.aurc_change.excludes_zero && x.aurc_change.mean < 0))
  throw new Error('reliable decisions: the copy says 40 labels lowered NLL and AURC for every BETA method');
const k5 = EEGMAT.methods.map(m => m.recalibration.find(x => x.prefix === 'k5')!);
const k5Up = k5.filter(x => x.nll_change.excludes_zero && x.nll_change.mean > 0).length;
const k5Gap = k5.filter(x => x.unlabelled_cutoff_gap_change.excludes_zero && x.unlabelled_cutoff_gap_change.mean > 0).length;
if (k5.some(x => x.labels_per_new_person !== 10) || k5Up < 2 || k5.some(x => x.nll_change.excludes_zero && x.nll_change.mean < 0) || k5Gap < 1
    || k5.some(x => x.unlabelled_cutoff_gap_change.excludes_zero && x.unlabelled_cutoff_gap_change.mean < 0))
  throw new Error('reliable decisions: the EEGMAT recalibration sentence no longer follows from the export');
const c4 = (EEGMAT as unknown as { lora_minus_head_only: { nll_calibrated: Diff; ece_calibrated: Diff; head_only_degenerate_population_temperature_folds: number } }).lora_minus_head_only;
if (!(c4.nll_calibrated.excludes_zero && c4.nll_calibrated.mean < 0) || c4.ece_calibrated.excludes_zero)
  throw new Error('reliable decisions: the LoRA sentence says lower NLL and no ECE difference resolved');
const lora = byId(EEGMAT, 'labram-lora-r4'), head = byId(EEGMAT, 'labram-frozen-ce');
if (!(lora.balanced_accuracy > head.balanced_accuracy)) throw new Error('reliable decisions: the LoRA sentence says LoRA is also more accurate');
if (c4.head_only_degenerate_population_temperature_folds !== 1) throw new Error('reliable decisions: the copy names one flagged fold');
if (!BETA.common_coverage.errors || !EEGMAT.common_coverage.unstable || EEGMAT.common_coverage.errors)
  throw new Error('reliable decisions: the matched-coverage copy expects BETA stable and EEGMAT unstable');
if (MIREST.methods.some(m => m.risk_certification.certified_folds !== 0)) throw new Error('reliable decisions: the crude panel says S-risk accepted nothing on ds003810');
const cstarOwner = BETA.methods.find(m => m.fixed_cutoff.coverage === BETA.common_coverage.coverage)!;
const cca = byId(BETA, 'cca'), eegmatNet = byId(EEGMAT, 'eegnet');
const half = (m: Method) => m.ranking_S.error_at_test_coverage.find(x => x.coverage === 0.5)!.selective_error;
if (!(half(cca) < cca.error_accepting_everything && half(eegmatNet) < eegmatNet.error_accepting_everything))
  throw new Error('reliable decisions: the rejection sentence says the error falls');

const verdict = (d: Diff) => d.excludes_zero ? (zh ? '可以认定有差异' : 'difference resolved') : (zh ? '不能认定有差异' : 'no difference resolved');
const prefixText: Record<string, string> = zh
  ? { k5: '每段记录的前 5 个窗口，之后空出 1 个窗口', k10: '每段记录的前 10 个窗口，之后空出 1 个窗口', prefix: '第 1 组块（每个目标一个试次）' }
  : { k5: 'first 5 windows of each recording, then a one-window gap', k10: 'first 10 windows of each recording, then a one-window gap', prefix: 'block 1, one trial per target' };
const unitWord = (p: Protocol) => p.unit === 'windows' ? (zh ? '窗口' : 'windows') : (zh ? '试次' : 'trials');
const variantName: Record<string, string> = zh
  ? { matched: '匹配模型留出', platt: 'Platt 缩放', 'vector-scaling': '向量缩放' }
  : { matched: 'matched-model holdout', platt: 'Platt scaling', 'vector-scaling': 'vector scaling' };
const datasetOf = (protocol: string) => protocol === 'beta-8ch' ? BETA.dataset : protocol === 'arithmetic-rest' ? EEGMAT.dataset : MIREST.dataset;

const copy = {
  en: {
    eyebrow: 'Reliable decisions · route 1 of the plan below · EEGMAT and BETA',
    h2: 'When should a decoder decline to decide?',
    lede: (): Part[] => ['The first route of the research plan below. It retrained nothing. It took the saved test scores of models this site already publishes — on EEGMAT, ', f(EEGMAT.people, 'count'), ' people, mental arithmetic against rest, and on BETA, ', f(BETA.people, 'count'), ' people, a ', f(BETA.classes, 'count'), '-target SSVEP speller — and asked which trials each decoder should have declined, under four rules fixed in advance. Every full-coverage accuracy below is the published one: for the two LaBraM arms, the adaptation release’s seed-20260922 mean, which the model-adaptation page lists beside the three-seed mean. Both protocols are balanced or uniform by design, so every figure compares methods; none is a deployment error rate.'],
    rulesH3: 'Four rules, fixed before scoring',
    rules: [
      ['Fixed threshold (F)', 'accept a trial when its calibrated top-class probability is at least 0.8. Temperature scaling, fitted on calibration scores, keeps every predicted label.'],
      ['Coverage target (S-cov)', 'accept the most confident trials, with the cut-off set from calibration quantiles so that 80% should be accepted.'],
      ['Certified risk (S-risk)', 'selection with guaranteed risk (SGR, δ = 0.05) certifies a cut-off whose error should stay at or below a target r*, here half the calibration error. A fold where nothing can be certified accepts nothing.'],
      ['Learned reject option (L)', 'a logistic selector on the classifier’s top two scores and their margin, plus a spectral description of the signal that does not depend on the model, trained to predict which trials the classifier gets wrong.'],
    ],
    rulesNote: () => ['Calibration scores never include a test person: in each outer fold the training people form four groups, and each group is scored by a model trained on the other three. Intervals are paired person-bootstrap 95% intervals over 2,000 resamples, with no multiplicity correction. A contrast is called a difference only when its interval excludes zero; differences of rates are in percentage points (pp).'],
    q1H3: 'A fixed threshold is a different policy for each method',
    q1P: 'The same cut-off — accept when the calibrated top-class probability is at least 0.8 — accepts very different shares of trials from different decoders, and from different people.',
    q1Caption: (p: Protocol): Part[] => [`${p.dataset} · `, f(p.people, 'count'), ' people · ', f(p.test_items, 'count'), ` ${unitWord(p)}, ${p.protocol === 'beta-8ch' ? 'uniform over ' : 'half rest and half arithmetic'}`, ...(p.protocol === 'beta-8ch' ? [f(p.classes, 'count'), ' targets'] : []), '. Methods in the core matrix’s order, not ranked.'],
    q1Region: (p: Protocol) => `${p.dataset}, fixed threshold by method, scrolls horizontally`,
    colMethod: 'Method', colBa: 'Balanced accuracy, everything accepted', colFixed: 'Accepted at confidence ≥ 0.8', colFixedError: 'Error among accepted',
    colNothing: 'People with nothing accepted', colTarget: 'Coverage when the cut-off targets 80%',
    published: 'the published value', publishedSeed: 'the published seed-20260922 mean, adaptation release', coverageOf: 'coverage', ofPeople: (n: FigValue): Part[] => ['of ', n, ' people'],
    wrongOfAccepted: 'wrong, of those accepted', unstable: (k: FigValue): Part[] => ['Unstable: fewer than ', k, ' accepted, so no rate is read from it'],
    notDefined: 'not defined: nothing accepted',
    coverageBar: (v: string) => `${v} of trials accepted`,
    pairsCaption: (p: Protocol) => `${p.dataset}: paired differences in coverage under the fixed threshold, first method minus second`,
    pairsRegion: (p: Protocol) => `${p.dataset}, paired coverage differences, scrolls horizontally`,
    colPair: 'Pair', colDiff: 'Difference', colReading: 'Reading',
    matchedH4: 'Error at matched coverage',
    matchedP: (): Part[] => ['On BETA the smallest coverage the fixed threshold reached was ', f(BETA.common_coverage.accepted, 'count'), ' of ', f(BETA.test_items, 'count'), ' trials (', f(BETA.common_coverage.coverage), `, ${shortName(cstarOwner.id)}’s). Each method then accepts its own `, f(BETA.common_coverage.accepted, 'count'), ' most confident trials, so the threshold drops out of the comparison:'],
    matchedRegion: 'BETA, error at a matched coverage, scrolls horizontally',
    matchedCaption: (): Part[] => ['BETA: error among each method’s ', f(BETA.common_coverage.accepted, 'count'), ' most confident trials, with paired differences.'],
    colMatched: 'Error among its most confident', descriptive: 'a descriptive level, no verdict',
    matchedEegmat: (): Part[] => ['On EEGMAT that common coverage is ', f(EEGMAT.common_coverage.accepted, 'count'), ' window of ', f(EEGMAT.test_items, 'count'), ': fewer than ', f(tenth, 'count'), ' accepted, so no verdict.'],
    q2H3: 'A learned reject option did not beat the model’s own calibrated confidence',
    q2P: () => `Holding the classifier fixed, the learned reject option L — which also sees a spectral description of the signal — was set against the calibrated confidence S of the same classifier, on the same test trials. Two measures: the area under the risk–coverage curve (AURC; lower means the errors sit among the trials ranked least certain), and the error among the 80% of trials each ranks as most certain. L had a lower error than S at 80% for no method; where a difference was resolved, L erred more. By AURC, L ranked better only for ${listJoin(c1Better)} and worse for ${listJoin(c1Worse)}; every other contrast: no difference resolved.`,
    q2Region: (p: Protocol) => `${p.dataset}, learned reject option against calibrated confidence, scrolls horizontally`,
    q2Caption: (p: Protocol): Part[] => [`${p.dataset} · `, f(p.people, 'count'), ' people.'],
    colAurcS: 'AURC · confidence S', colAurcL: 'AURC · learned L', colAurcD: 'L − S, AURC', colErrS: 'Error at 80% · S', colErrL: 'Error at 80% · L', colErrD: 'L − S, error at 80%',
    buysH4: 'What declining buys, under the calibrated confidence',
    buysP: (): Part[] => ['How much declining buys is read per protocol; the two are not compared: forty targets against two classes. On BETA, standard CCA’s error falls from ', f(cca.error_accepting_everything), ' with everything accepted to ', f(half(cca)), ' among its most certain half; on EEGMAT, EEGNet’s falls from ', f(eegmatNet.error_accepting_everything), ' to ', f(half(eegmatNet)), '.'],
    buysRegion: 'Error as more trials are declined, by method, scrolls horizontally',
    buysCaption: 'Error among the trials accepted, by the share of test trials the calibrated confidence accepts. Point estimates.',
    colAll: 'Everything accepted', colAt80: 'Most certain 80%', colAt50: 'Most certain 50%',
    q3H3: 'A certified error level did not reliably hold on new people',
    q3P: 'Selection with guaranteed risk certifies, from calibration data, a cut-off whose error should stay at or below a target r* — here half the calibration error, with δ = 0.05. The guarantee assumes calibration and test trials are exchangeable; across people they are not. On EEGMAT it certified no outer fold for any method, so nothing was accepted: there is no error rate, not a zero one. On BETA it certified folds for every method, and in some certified folds the error on the new people exceeded that fold’s own target. The pooled error minus the target was not resolved from zero for any method.',
    q3Region: 'Certified selective risk by method, scrolls horizontally',
    q3Caption: 'S-risk at the relative target. Folds over their own target count certified outer folds whose realised error exceeded that fold’s r*.',
    q3Sub: (p: Protocol): Part[] => [`${p.dataset} · `, f(p.outer_folds, 'count'), ' outer folds · ', f(p.people, 'count'), ' people'],
    colCertified: 'Folds certified', colAccepted: 'Accepted', colRiskError: 'Error among accepted', colRstar: 'Target r*, weighted over folds',
    colOver: 'Certified folds over their own target', colC6: 'Error minus target',
    noneCertified: 'no fold certified', nothingAccepted: 'nothing accepted',
    q3Note: 'Each fold holds about ten people, so a fold’s error also carries sampling noise. Read the folds over target as the measured failure frequency of a nominal guarantee, not as a significance test.',
    q5H3: 'A personal recalibration costs each new person labels',
    q5P: () => `R0 uses the population temperature and no label from the new person; R1 fits a personal temperature on a labelled prefix of that person’s own trials. Both are scored on the same remaining trials, and a negative change is an improvement. With 40 labels per new person on BETA, NLL and AURC fell for every method. With 10 per person on EEGMAT, NLL rose, with the interval excluding zero, for ${words[k5Up]} of the four methods: many personal temperatures were degenerate, and they were kept, as the protocol requires. Re-setting only the coverage cut-off from that prefix, without its labels, moved EEGMAT coverage further from the 80% target with the 10-label prefix, resolved for ${words[k5Gap]} of the four methods.`,
    q5Region: 'Recalibration by method and labelled prefix, scrolls horizontally',
    q5Caption: 'R1 minus R0 on the same remaining trials; negative is better.',
    colPrefix: 'Labelled prefix', colLabels: 'Labels per new person', colNll: 'Change in NLL, R1 − R0', colEce: 'Change in ECE', colAurc: 'Change in AURC',
    colDegenerate: 'People with a degenerate personal temperature', colGap: 'Label-free cut-off: change in distance from the 80% target',
    q4H3: 'LoRA and probability quality, on EEGMAT',
    q4P: (): Part[] => ['On EEGMAT, LaBraM adapted with rank-4 LoRA had a lower NLL than the head-only arm of the same recipe: calibrated ', f(c4.nll_calibrated.mean, 'sgn3'), ' (95% interval ', f(c4.nll_calibrated.interval_95[0], 'sgn3'), ' to ', f(c4.nll_calibrated.interval_95[1], 'sgn3'), '). For ECE, no difference resolved (', f(c4.ece_calibrated.mean, 'sgn3'), '; ', f(c4.ece_calibrated.interval_95[0], 'sgn3'), ' to ', f(c4.ece_calibrated.interval_95[1], 'sgn3'), '). The LoRA arm is also more accurate, ', f(lora.balanced_accuracy), ' against ', f(head.balanced_accuracy), ' balanced accuracy (seed 20260922, as the adaptation release publishes it; the three-seed means are on the model-adaptation page), so the NLL gap alone is not evidence of more honest probabilities. The adaptation itself is on '],
    q4Link: 'the model-adaptation page',
    qualityH3: 'Probability quality, with everything accepted',
    qualityP: (): Part[] => ['Negative log-likelihood (NLL), expected calibration error (ECE, 15 equal-mass bins) and the Brier score after temperature scaling, and NLL and ECE before it where the model outputs a probability. A spectral ridge’s decision value and a CCA correlation have none: “not applicable”, not zero. Lower is better throughout. NLL and the Brier score depend on the number of classes, so EEGMAT (', f(EEGMAT.classes, 'count'), ') and BETA (', f(BETA.classes, 'count'), ') are not compared. Binned ECE is biased upward under person resampling, so a small ECE can sit at the lower end of its interval. In one outer fold of the LaBraM head-only arm the population temperature reached its search bound; it was flagged and kept.'],
    qualityRegion: 'Probability quality by method, scrolls horizontally',
    qualityCaption: 'Full coverage, 95% person-bootstrap intervals.',
    colNllCal: 'NLL, calibrated', colEceCal: 'ECE, calibrated', colBrier: 'Brier score, calibrated', colNllRaw: 'NLL, raw', colEceRaw: 'ECE, raw',
    notApplicable: 'not applicable', notApplicableWhy: 'no raw probability, not zero',
    robustSummary: 'Robustness and exploratory arms: descriptive, never compared between arms',
    miH4: 'ds003810, motor imagery and rest: crude',
    miP: (): Part[] => [f(MIREST.people, 'count'), ' people, two per test fold: crude intervals and no person-level spread. Its contrasts below are secondary. Balanced, so no deployment rate. The certified risk accepted nothing here for any method.'],
    miRegion: 'ds003810, crude, scrolls horizontally',
    colCertifiedOf: 'Folds certified (S-risk)',
    seedsH4: 'Secondary seeds',
    seedsP: 'Every other saved seed of the trained methods, each with its own calibration, cut-offs and selector, scored on that seed’s saved test predictions. Seeds are never treated as people, and no contrast is drawn between seeds.',
    seedsRegion: 'Secondary seeds, learned reject option against calibrated confidence, scrolls horizontally',
    colProtocol: 'Dataset', colSeed: 'Seed',
    sensH4: 'Two sensitivity arms: certified folds only',
    sensP: 'The matched-model holdout trains the model on three quarters of the training people and calibrates it on the remaining quarter, so calibration and test scores come from one model. Platt scaling on two classes and vector scaling on BETA replace temperature scaling and can change predicted labels.',
    sensRegion: 'Sensitivity arms, certified-risk fold counts, scrolls horizontally',
    colArm: 'Arm',
    ljH4: 'A reject head trained with its classifier (exploratory)',
    ljP: 'A SelectiveNet-style EEGNet, trained with its own selection head g (alpha 0.5, lambda 32, target coverage 0.8). Within the same model, g is set against the calibrated confidence of its own classifier head; a positive difference means g is worse.',
    ljRegion: 'Jointly trained reject head against calibrated confidence, scrolls horizontally',
    colGAurc: 'g − confidence, AURC', colGErr: 'g − confidence, error at 80%',
    leftOut: ['Left out on purpose: a cross-day label-budget arm on BNCI2015-001, a source that is held, so none of its figures is published (see ', 'the holds register', ').'],
    limitsH3: 'What these results cannot say',
    limits: [
      ['Method comparisons, not deployment rates', 'Every protocol here is balanced or uniform by design: EEGMAT is half rest and half arithmetic, BETA uniform over its 40 targets, ds003810 balanced. The figures compare methods; none is a deployment error rate. On EEGMAT each class is its own recording, so recording-level differences are part of what any model or selector can use. BETA is cue-paced spelling with no idle state, so it gives no false-activation figure of any kind.'],
      ['Nothing accepted, no error rate', 'A risk–coverage curve exists only where something is accepted. At zero coverage there is no error rate, not a zero one, and fewer than 10 accepted trials are flagged unstable.'],
      ['A nominal guarantee', 'A certified selective risk assumes that calibration and test data are exchangeable. Across people they are not, so the guarantee is nominal: how often it fails is measured here, not assumed.'],
      ['Not out-of-distribution detection', 'Rejecting likely errors on known classes is not detecting unfamiliar input: an uncertainty threshold may not flag an unseen class. Route 1 makes no out-of-distribution claim.'],
      ['Calibration on fewer people', 'Calibration scores come from inner models that see about three quarters of the training people, so they may be less confident than the full model whose scores are tested. This approximation is part of every calibrated figure.'],
      ['The published accuracies, and only those', 'Temperature scaling keeps each predicted label, so every full-coverage accuracy equals the site’s published value. The matched-model, map-sensitivity and jointly trained arms use other models or maps; their accuracies are not published and are never mixed with the site’s.'],
