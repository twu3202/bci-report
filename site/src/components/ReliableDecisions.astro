    audit: (): Part[] => ['这些数字背后的检查：两项第 0 阶段审计都已通过。独立的主审计在 ', f(r.audits.independent_primary.checks, 'count'), ' 项检查中通过了 ', f(r.audits.independent_primary.passed, 'count'), ' 项；没有通过的那一项发现的是文档错误，不是计算错误——运行日志说退化的个人温度参数会退回到总体温度参数，而代码按协议的要求保留了它，每个数字都是这样计算和复现的。独立的次级审计 ', f(r.audits.independent_secondary.checks, 'count'), ' 项全部通过。两项审计都不调用研究代码、重新实现了各项定义；它们留在私有的运行目录中，以哈希固定。'],
  },
}[locale];

const pctIv = (iv?: number[]) => iv ? [f(iv[0]), f(iv[1])] as const : null;
---
<section class="topic-section" id="reliable-decisions" aria-labelledby="rd-heading">
  <div class="topic-heading"><div><p class="eyebrow">{copy.eyebrow}</p><h2 id="rd-heading">{copy.h2}</h2></div><p>{copy.lede().map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</p></div>
  <h3 class="roadmap-h3">{copy.rulesH3}</h3>
  <ul class="rd-rules">{copy.rules.map(([h, p]) => <li><strong>{h}</strong>{zh ? '：' : ': '}{p}</li>)}</ul>
  <p class="protocol-note">{copy.rulesNote().map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</p>

  <h3 class="roadmap-h3" id="rd-fixed">{copy.q1H3}</h3>
  <p class="roadmap-p">{copy.q1P}</p>
  {panels.map(p => <>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.q1Region(p)} data-rd-panel={p.protocol}>
      <table>
        <caption>{copy.q1Caption(p).map(x => typeof x === 'string' ? x : <Fig f={x}/>)}</caption>
        <thead><tr><th scope="col">{copy.colMethod}</th><th scope="col">{copy.colBa}</th><th scope="col">{copy.colFixed}</th><th scope="col">{copy.colFixedError}</th><th scope="col">{copy.colNothing}</th><th scope="col">{copy.colTarget}</th></tr></thead>
        <tbody>{p.methods.map(m => { const F = m.fixed_cutoff, T = m.coverage_target, ci = pctIv(F.coverage_interval_95), ti = pctIv(T.coverage_interval_95), ei = pctIv(F.selective_error_interval_95); return (
          <tr data-rd-row={`${p.protocol}|${m.id}`}>
            <th scope="row" lang={nameLang(m.id)}>{name(m.id)}</th>
            <td data-cell="ba"><Fig f={f(m.balanced_accuracy)} cls="metric"/><span class="interval">{m.id.startsWith('labram-') ? copy.publishedSeed : copy.published}</span></td>
            <td data-cell="fixed"><span class="metric"><Fig f={f(F.accepted, 'count')}/> / <Fig f={f(F.n, 'count')}/></span><span class="interval">{copy.coverageOf} <Fig f={cov(F.coverage)}/>{ci && <> · {tc.interval95} <Fig f={ci[0]}/>–<Fig f={ci[1]}/></>}</span><ScoreBar value={F.coverage} label={copy.coverageBar(formatFig(cov(F.coverage)))}/></td>
            {F.selective_error === null
              ? <td data-cell="fixed-error" data-null="true"><span class="metric">—</span><span class="interval">{copy.notDefined}</span></td>
              : F.unstable
                ? <td data-cell="fixed-error" data-unstable="true"><span class="metric"><Fig f={f(F.accepted_wrong!, 'count')}/> / <Fig f={f(F.accepted, 'count')}/></span><span class="interval">{copy.wrongOfAccepted}</span><span class="flag">{copy.unstable(f(tenth, 'count')).map(x => typeof x === 'string' ? x : <Fig f={x}/>)}</span></td>
                : <td data-cell="fixed-error"><Fig f={f(F.selective_error)} cls="metric"/>{ei && <span class="interval">{tc.interval95} <Fig f={ei[0]}/>–<Fig f={ei[1]}/></span>}</td>}
            <td data-cell="nothing-accepted"><Fig f={f(F.people_with_nothing_accepted, 'count')} cls="metric"/><span class="interval">{copy.ofPeople(f(p.people, 'count')).map(x => typeof x === 'string' ? x : <Fig f={x}/>)}</span></td>
            <td data-cell="target"><Fig f={f(T.coverage)} cls="metric"/>{ti && <span class="interval">{tc.interval95} <Fig f={ti[0]}/>–<Fig f={ti[1]}/></span>}</td>
          </tr>); })}</tbody>
      </table>
    </div>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.pairsRegion(p)}>
      <table>
        <caption>{copy.pairsCaption(p)}</caption>
        <thead><tr><th scope="col">{copy.colPair}</th><th scope="col">{copy.colDiff}</th><th scope="col">{copy.colReading}</th></tr></thead>
        <tbody>{p.fixed_cutoff_coverage_differences.map(d => (
          <tr data-rd-pair={`${p.protocol}|${d.a}|${d.b}`}>
            <th scope="row" lang={nameLang(d.a) && nameLang(d.b)}>{shortName(d.a)} − {shortName(d.b)}</th>
            <td data-diff="coverage" data-resolved={String(d.excludes_zero)}><Fig f={pp(d.mean)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={sg(d.interval_95[0])}/> {tc.to} <Fig f={pp(d.interval_95[1])}/></span></td>
            <td><span class="verdict" data-resolved={String(d.excludes_zero)}>{verdict(d)}</span></td>
          </tr>))}</tbody>
      </table>
    </div>
  </>)}
  <h4 class="rd-h4" id="rd-matched">{copy.matchedH4}</h4>
  <p class="roadmap-p">{copy.matchedP().map(x => typeof x === 'string' ? x : <Fig f={x}/>)}</p>
  <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.matchedRegion}>
    <table>
      <caption>{copy.matchedCaption().map(x => typeof x === 'string' ? x : <Fig f={x}/>)}</caption>
      <thead><tr><th scope="col">{copy.colMethod}</th><th scope="col">{copy.colMatched}</th><th scope="col">{copy.colReading}</th></tr></thead>
      <tbody>
        {BETA.common_coverage.errors!.map(e => (
          <tr data-rd-matched={e.id}><th scope="row" lang={nameLang(e.id)}>{name(e.id)}</th><td><Fig f={f(e.mean)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={f(e.interval_95[0])}/>–<Fig f={f(e.interval_95[1])}/></span></td><td><span class="verdict">{copy.descriptive}</span></td></tr>))}
        {BETA.common_coverage.differences!.map((d, i) => (
          <tr class={i === 0 ? 'pooled-row' : undefined} data-rd-pair={`matched|${d.a}|${d.b}`}><th scope="row" lang={nameLang(d.a) && nameLang(d.b)}>{shortName(d.a)} − {shortName(d.b)}</th><td data-diff="matched" data-resolved={String(d.excludes_zero)}><Fig f={pp(d.mean)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={sg(d.interval_95[0])}/> {tc.to} <Fig f={pp(d.interval_95[1])}/></span></td><td><span class="verdict" data-resolved={String(d.excludes_zero)}>{verdict(d)}</span></td></tr>))}
      </tbody>
    </table>
  </div>
  <p class="roadmap-p" data-rd-unstable="arithmetic-rest">{copy.matchedEegmat().map(x => typeof x === 'string' ? x : <Fig f={x}/>)}</p>

  <h3 class="roadmap-h3" id="rd-learned">{copy.q2H3}</h3>
  <p class="roadmap-p">{copy.q2P()}</p>
  {[EEGMAT, BETA].map(p => (
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.q2Region(p)}>
      <table>
        <caption>{copy.q2Caption(p).map(x => typeof x === 'string' ? x : <Fig f={x}/>)}</caption>
        <thead><tr><th scope="col">{copy.colMethod}</th><th scope="col">{copy.colAurcS}</th><th scope="col">{copy.colAurcL}</th><th scope="col">{copy.colAurcD}</th><th scope="col">{copy.colErrS}</th><th scope="col">{copy.colErrL}</th><th scope="col">{copy.colErrD}</th></tr></thead>
        <tbody>{p.methods.map(m => { const S = m.ranking_S, L = m.ranking_L, d1 = m.learned_minus_confidence.aurc, d2 = m.learned_minus_confidence.error_at_80; return (
          <tr data-rd-learned={`${p.protocol}|${m.id}`}>
            <th scope="row" lang={nameLang(m.id)}>{name(m.id)}</th>
            <td><Fig f={f(S.aurc.mean, 'num3')} cls="metric"/><span class="interval">{tc.interval95} <Fig f={f(S.aurc.interval_95[0], 'num3')}/>–<Fig f={f(S.aurc.interval_95[1], 'num3')}/></span></td>
            <td><Fig f={f(L.aurc.mean, 'num3')} cls="metric"/><span class="interval">{tc.interval95} <Fig f={f(L.aurc.interval_95[0], 'num3')}/>–<Fig f={f(L.aurc.interval_95[1], 'num3')}/></span></td>
            <td data-diff="c1" data-resolved={String(d1.excludes_zero)}><Fig f={f(d1.mean, 'sgn3')} cls="metric"/><span class="interval">{tc.interval95} <Fig f={f(d1.interval_95[0], 'sgn3')}/> {tc.to} <Fig f={f(d1.interval_95[1], 'sgn3')}/></span><span class="verdict" data-resolved={String(d1.excludes_zero)}>{verdict(d1)}</span></td>
            <td><Fig f={f(S.error_at_80.mean)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={f(S.error_at_80.interval_95[0])}/>–<Fig f={f(S.error_at_80.interval_95[1])}/></span></td>
            <td><Fig f={f(L.error_at_80.mean)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={f(L.error_at_80.interval_95[0])}/>–<Fig f={f(L.error_at_80.interval_95[1])}/></span></td>
            <td data-diff="c2" data-resolved={String(d2.excludes_zero)}><Fig f={pp(d2.mean)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={sg(d2.interval_95[0])}/> {tc.to} <Fig f={pp(d2.interval_95[1])}/></span><span class="verdict" data-resolved={String(d2.excludes_zero)}>{verdict(d2)}</span></td>
          </tr>); })}</tbody>
      </table>
    </div>))}
  <h4 class="rd-h4">{copy.buysH4}</h4>
  <p class="roadmap-p">{copy.buysP().map(x => typeof x === 'string' ? x : <Fig f={x}/>)}</p>
  <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.buysRegion}>
    <table>
      <caption>{copy.buysCaption}</caption>
      <thead><tr><th scope="col">{copy.colMethod}</th><th scope="col">{copy.colAll}</th><th scope="col">{copy.colAt80}</th><th scope="col">{copy.colAt50}</th></tr></thead>
      <tbody>{[EEGMAT, BETA].map(p => <>
        <tr class="subhead"><th colspan="4" scope="colgroup">{p.dataset}</th></tr>
        {p.methods.map(m => { const at = (c: number) => m.ranking_S.error_at_test_coverage.find(x => x.coverage === c)!.selective_error; return (
          <tr><th scope="row" lang={nameLang(m.id)}>{name(m.id)}</th><td><Fig f={f(m.error_accepting_everything)} cls="metric"/></td><td><Fig f={f(at(0.8))} cls="metric"/></td><td><Fig f={f(at(0.5))} cls="metric"/></td></tr>); })}
      </>)}</tbody>
    </table>
  </div>

  <h3 class="roadmap-h3" id="rd-certified">{copy.q3H3}</h3>
  <p class="roadmap-p">{copy.q3P}</p>
  <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.q3Region}>
    <table>
      <caption>{copy.q3Caption}</caption>
      <thead><tr><th scope="col">{copy.colMethod}</th><th scope="col">{copy.colCertified}</th><th scope="col">{copy.colAccepted}</th><th scope="col">{copy.colRiskError}</th><th scope="col">{copy.colRstar}</th><th scope="col">{copy.colOver}</th><th scope="col">{copy.colC6}</th></tr></thead>
      <tbody>{[BETA, EEGMAT].map(p => <>
        <tr class="subhead"><th colspan="7" scope="colgroup">{copy.q3Sub(p).map(x => typeof x === 'string' ? x : <Fig f={x}/>)}</th></tr>
        {p.methods.map(m => { const R = m.risk_certification, ri = pctIv(R.selective_error_interval_95), d = R.error_minus_target; return (
          <tr data-rd-risk={`${p.protocol}|${m.id}`}>
            <th scope="row" lang={nameLang(m.id)}>{name(m.id)}</th>
            <td><span class="metric"><Fig f={f(R.certified_folds, 'count')}/> / <Fig f={f(R.outer_folds, 'count')}/></span></td>
            <td><span class="metric"><Fig f={f(R.accepted, 'count')}/> / <Fig f={f(R.n, 'count')}/></span>{R.accepted > 0 ? <span class="interval">{copy.coverageOf} <Fig f={f(R.coverage)}/></span> : <span class="interval">{copy.nothingAccepted}</span>}</td>
            {R.selective_error === null
              ? <td data-cell="risk-error" data-null="true"><span class="metric">—</span><span class="interval">{copy.notDefined}</span></td>
              : <td data-cell="risk-error"><Fig f={f(R.selective_error)} cls="metric"/>{ri && <span class="interval">{tc.interval95} <Fig f={ri[0]}/>–<Fig f={ri[1]}/></span>}</td>}
            {R.target_weighted === null
              ? <td data-null="true"><span class="metric">—</span><span class="interval">{copy.noneCertified}</span></td>
              : <td><Fig f={f(R.target_weighted)} cls="metric"/></td>}
            {R.certified_folds === 0
              ? <td data-null="true"><span class="metric">—</span><span class="interval">{copy.noneCertified}</span></td>
              : <td data-cell="over"><span class="metric"><Fig f={f(R.folds_over_target, 'count')}/> / <Fig f={f(R.certified_folds, 'count')}/></span></td>}
            {d === null
              ? <td data-cell="c6" data-null="true"><span class="metric">—</span><span class="interval">{copy.notDefined}</span></td>
              : <td data-cell="c6" data-diff="c6" data-resolved={String(d.excludes_zero)}><Fig f={pp(d.mean)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={sg(d.interval_95[0])}/> {tc.to} <Fig f={pp(d.interval_95[1])}/></span><span class="verdict" data-resolved={String(d.excludes_zero)}>{verdict(d)}</span></td>}
          </tr>); })}
      </>)}</tbody>
    </table>
  </div>
  <p class="protocol-note">{copy.q3Note}</p>

  <h3 class="roadmap-h3" id="rd-recalibration">{copy.q5H3}</h3>
  <p class="roadmap-p">{copy.q5P()}</p>
  <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.q5Region}>
    <table>
      <caption>{copy.q5Caption}</caption>
      <thead><tr><th scope="col">{copy.colMethod}</th><th scope="col">{copy.colPrefix}</th><th scope="col">{copy.colLabels}</th><th scope="col">{copy.colNll}</th><th scope="col">{copy.colEce}</th><th scope="col">{copy.colAurc}</th><th scope="col">{copy.colDegenerate}</th><th scope="col">{copy.colGap}</th></tr></thead>
      <tbody>{[BETA, EEGMAT].map(p => <>
        <tr class="subhead"><th colspan="8" scope="colgroup">{p.dataset}</th></tr>
        {p.methods.flatMap(m => m.recalibration.map(x => (
          <tr data-rd-recal={`${p.protocol}|${m.id}|${x.prefix}`}>
            <th scope="row" lang={nameLang(m.id)}>{name(m.id)}</th>
            <td>{prefixText[x.prefix]}</td>
            <td data-cell="labels"><Fig f={f(x.labels_per_new_person, 'count')} cls="metric"/></td>
            {[x.nll_change, x.ece_change, x.aurc_change].map((d, i) => (
              <td data-diff={['nll', 'ece', 'aurc'][i]} data-resolved={String(d.excludes_zero)}><Fig f={f(d.mean, 'sgn3')} cls="metric"/><span class="interval">{tc.interval95} <Fig f={f(d.interval_95[0], 'sgn3')}/> {tc.to} <Fig f={f(d.interval_95[1], 'sgn3')}/></span><span class="verdict" data-resolved={String(d.excludes_zero)}>{verdict(d)}</span></td>))}
            <td><span class="metric"><Fig f={f(x.people_with_degenerate_personal_temperature, 'count')}/> / <Fig f={f(p.people, 'count')}/></span></td>
            <td data-diff="gap" data-resolved={String(x.unlabelled_cutoff_gap_change.excludes_zero)}><Fig f={pp(x.unlabelled_cutoff_gap_change.mean)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={sg(x.unlabelled_cutoff_gap_change.interval_95[0])}/> {tc.to} <Fig f={pp(x.unlabelled_cutoff_gap_change.interval_95[1])}/></span><span class="verdict" data-resolved={String(x.unlabelled_cutoff_gap_change.excludes_zero)}>{verdict(x.unlabelled_cutoff_gap_change)}</span></td>
          </tr>)))}
      </>)}</tbody>
    </table>
  </div>

  <h3 class="roadmap-h3" id="rd-lora">{copy.q4H3}</h3>
  <p class="roadmap-p">{copy.q4P().map(x => typeof x === 'string' ? x : <Fig f={x}/>)}<a href={hrefFor('/topics/model-adaptation/', locale)}>{zh ? `「${copy.q4Link}」` : copy.q4Link}</a>{zh ? '。' : '.'}</p>

  <h3 class="roadmap-h3" id="rd-quality">{copy.qualityH3}</h3>
  <p class="roadmap-p">{copy.qualityP().map(x => typeof x === 'string' ? x : <Fig f={x}/>)}</p>
  <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.qualityRegion}>
    <table>
      <caption>{copy.qualityCaption}</caption>
      <thead><tr><th scope="col">{copy.colMethod}</th><th scope="col">{copy.colNllCal}</th><th scope="col">{copy.colEceCal}</th><th scope="col">{copy.colBrier}</th><th scope="col">{copy.colNllRaw}</th><th scope="col">{copy.colEceRaw}</th></tr></thead>
      <tbody>{[EEGMAT, BETA].map(p => <>
        <tr class="subhead"><th colspan="6" scope="colgroup">{p.dataset}</th></tr>
        {p.methods.map(m => { const q = m.probability_quality; const lv = (x: Level) => <><Fig f={f(x.mean, 'num3')} cls="metric"/><span class="interval">{tc.interval95} <Fig f={f(x.interval_95[0], 'num3')}/>–<Fig f={f(x.interval_95[1], 'num3')}/></span></>; return (
          <tr data-rd-quality={`${p.protocol}|${m.id}`}>
            <th scope="row" lang={nameLang(m.id)}>{name(m.id)}</th>
            <td>{lv(q.calibrated.nll)}</td><td>{lv(q.calibrated.ece)}</td><td>{lv(q.calibrated.brier)}</td>
            {q.raw ? <><td>{lv(q.raw.nll)}</td><td>{lv(q.raw.ece)}</td></>
                   : <><td data-null="true" data-na="true"><span class="metric">—</span><span class="interval">{copy.notApplicable}{zh ? '：' : ': '}{copy.notApplicableWhy}</span></td><td data-null="true" data-na="true"><span class="metric">—</span><span class="interval">{copy.notApplicable}{zh ? '：' : ': '}{copy.notApplicableWhy}</span></td></>}
          </tr>); })}
      </>)}</tbody>
    </table>
  </div>

  <details class="rd-panel" id="rd-robustness">
    <summary>{copy.robustSummary}</summary>
    <h4 class="rd-h4" id="rd-crude">{copy.miH4}</h4>
    <p class="roadmap-p">{copy.miP().map(x => typeof x === 'string' ? x : <Fig f={x}/>)}</p>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.miRegion}>
      <table>
        <thead><tr><th scope="col">{copy.colMethod}</th><th scope="col">{copy.colBa}</th><th scope="col">{copy.colFixed}</th><th scope="col">{copy.colNothing}</th><th scope="col">{copy.colAurcD}</th><th scope="col">{copy.colErrD}</th><th scope="col">{copy.colCertifiedOf}</th></tr></thead>
        <tbody>{MIREST.methods.map(m => { const F = m.fixed_cutoff, d1 = m.learned_minus_confidence.aurc, d2 = m.learned_minus_confidence.error_at_80; return (
          <tr data-rd-crude={m.id}>
            <th scope="row" lang={nameLang(m.id)}>{name(m.id)}</th>
            <td><Fig f={f(m.balanced_accuracy)} cls="metric"/><span class="interval">{copy.published}</span></td>
            <td><span class="metric"><Fig f={f(F.accepted, 'count')}/> / <Fig f={f(F.n, 'count')}/></span><span class="interval">{copy.coverageOf} <Fig f={cov(F.coverage)}/></span></td>
            <td><Fig f={f(F.people_with_nothing_accepted, 'count')} cls="metric"/><span class="interval">{copy.ofPeople(f(MIREST.people, 'count')).map(x => typeof x === 'string' ? x : <Fig f={x}/>)}</span></td>
            <td data-diff="c1" data-resolved={String(d1.excludes_zero)}><Fig f={f(d1.mean, 'sgn3')} cls="metric"/><span class="interval">{tc.interval95} <Fig f={f(d1.interval_95[0], 'sgn3')}/> {tc.to} <Fig f={f(d1.interval_95[1], 'sgn3')}/></span><span class="verdict" data-resolved={String(d1.excludes_zero)}>{verdict(d1)}</span></td>
            <td data-diff="c2" data-resolved={String(d2.excludes_zero)}><Fig f={pp(d2.mean)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={sg(d2.interval_95[0])}/> {tc.to} <Fig f={pp(d2.interval_95[1])}/></span><span class="verdict" data-resolved={String(d2.excludes_zero)}>{verdict(d2)}</span></td>
            <td><span class="metric"><Fig f={f(m.risk_certification.certified_folds, 'count')}/> / <Fig f={f(m.risk_certification.outer_folds, 'count')}/></span><span class="interval">{copy.nothingAccepted}</span></td>
          </tr>); })}</tbody>
      </table>
    </div>
    <h4 class="rd-h4">{copy.seedsH4}</h4>
    <p class="roadmap-p">{copy.seedsP}</p>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.seedsRegion}>
      <table>
        <thead><tr><th scope="col">{copy.colMethod}</th><th scope="col">{copy.colProtocol}</th><th scope="col">{copy.colSeed}</th><th scope="col">{copy.colAurcD}</th><th scope="col">{copy.colErrD}</th></tr></thead>
        <tbody>{r.robustness.seeds.rows.map(s => { const d1 = s.learned_minus_confidence.aurc, d2 = s.learned_minus_confidence.error_at_80; return (
          <tr data-rd-seed={`${s.protocol}|${s.method}|${s.seed}`}>
            <th scope="row" lang={nameLang(s.method)}>{name(s.method)}</th><td lang="en">{datasetOf(s.protocol)}</td><td>{s.seed}</td>
            <td data-diff="c1" data-resolved={String(d1.excludes_zero)}><Fig f={f(d1.mean, 'sgn3')} cls="metric"/><span class="interval">{tc.interval95} <Fig f={f(d1.interval_95[0], 'sgn3')}/> {tc.to} <Fig f={f(d1.interval_95[1], 'sgn3')}/></span><span class="verdict" data-resolved={String(d1.excludes_zero)}>{verdict(d1)}</span></td>
            <td data-diff="c2" data-resolved={String(d2.excludes_zero)}><Fig f={pp(d2.mean)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={sg(d2.interval_95[0])}/> {tc.to} <Fig f={pp(d2.interval_95[1])}/></span><span class="verdict" data-resolved={String(d2.excludes_zero)}>{verdict(d2)}</span></td>
          </tr>); })}</tbody>
      </table>
    </div>
    <h4 class="rd-h4">{copy.sensH4}</h4>
    <p class="roadmap-p">{copy.sensP}</p>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.sensRegion} data-rd-sensitivity="true">
      <table>
        <thead><tr><th scope="col">{copy.colMethod}</th><th scope="col">{copy.colProtocol}</th><th scope="col">{copy.colArm}</th><th scope="col">{copy.colCertified}</th><th scope="col">{copy.colOver}</th></tr></thead>
        <tbody>{[...r.robustness.matched_model_holdout.rows, ...r.robustness.map_sensitivity.rows].map(s => (
          <tr>
            <th scope="row" lang={nameLang(s.method)}>{name(s.method)}</th><td lang="en">{datasetOf(s.protocol)}</td><td>{variantName[s.variant]}</td>
            <td><span class="metric"><Fig f={f(s.certified_folds, 'count')}/> / <Fig f={f(s.outer_folds, 'count')}/></span></td>
            {s.certified_folds === 0 ? <td><span class="metric">—</span><span class="interval">{copy.noneCertified}</span></td>
                                     : <td><span class="metric"><Fig f={f(s.folds_over_target, 'count')}/> / <Fig f={f(s.certified_folds, 'count')}/></span></td>}
          </tr>))}</tbody>
      </table>
    </div>
    <h4 class="rd-h4">{copy.ljH4}</h4>
    <p class="roadmap-p">{copy.ljP}</p>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.ljRegion}>
      <table>
        <thead><tr><th scope="col">{copy.colProtocol}</th><th scope="col">{copy.colGAurc}</th><th scope="col">{copy.colGErr}</th></tr></thead>
        <tbody>{r.robustness.l_joint.rows.map(s => { const d1 = s.learned_minus_confidence.aurc, d2 = s.learned_minus_confidence.error_at_80; return (
          <tr data-rd-ljoint={s.protocol}>
            <th scope="row" lang="en">{datasetOf(s.protocol)}</th>
            <td data-diff="c1" data-resolved={String(d1.excludes_zero)}><Fig f={f(d1.mean, 'sgn3')} cls="metric"/><span class="interval">{tc.interval95} <Fig f={f(d1.interval_95[0], 'sgn3')}/> {tc.to} <Fig f={f(d1.interval_95[1], 'sgn3')}/></span><span class="verdict" data-resolved={String(d1.excludes_zero)}>{verdict(d1)}</span></td>
            <td data-diff="c2" data-resolved={String(d2.excludes_zero)}><Fig f={pp(d2.mean)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={sg(d2.interval_95[0])}/> {tc.to} <Fig f={pp(d2.interval_95[1])}/></span><span class="verdict" data-resolved={String(d2.excludes_zero)}>{verdict(d2)}</span></td>
          </tr>); })}</tbody>
      </table>
    </div>
    <p class="roadmap-p" id="rd-left-out">{copy.leftOut[0]}<a href={hrefFor('/releases/#hold-bnci2015-001-crossday', locale)}>{copy.leftOut[1]}</a>{copy.leftOut[2]}</p>
  </details>

  <h3 class="roadmap-h3" id="rd-limits">{copy.limitsH3}</h3>
  <div class="method-grid-wide">{copy.limits.map(([h, p], i) => <article><h3>{h}</h3><p>{p}</p>{i === 3 && <p><a href={r.literature.find(x => x.id === 'ood-mi')!.url} target="_blank" rel="noreferrer">{copy.oodLink}</a></p>}</article>)}</div>
  <h3 class="roadmap-h3">{copy.creditsH3}</h3>
  <div class="citation-list">{[EEGMAT, BETA, MIREST].map(p => (
    <article><h3 lang="en">{p.rights.name}</h3><p lang="en">{p.rights.attribution}</p><p><a href={p.rights.source} target="_blank" rel="noreferrer">{copy.datasetLink}</a> · <a href={p.rights.licenseUrl} target="_blank" rel="noreferrer">{p.rights.license}</a></p></article>))}
  </div>
  <h4 class="rd-h4">{copy.litH4}</h4>
  <ul class="rd-literature">{r.literature.map(x => <li lang="en"><a href={x.url} target="_blank" rel="noreferrer">{x.cite} ↗</a></li>)}</ul>
  <p class="citation-note" id="rd-audits">{copy.audit().map(x => typeof x === 'string' ? x : <Fig f={x}/>)}</p>
  <p class="citation-note">{tc.dataSource} <a href="/data/reliable-decisions-update.json" download>reliable-decisions-update.json</a> · {tc.schema} {reliable.schema_version}{tc.period}</p>
  {elsewhere.articles.filter(a => a.page === '/topics/when-not-to-act/').map(a => <p class="citation-note" id="rd-article">{copy.article[0]}<a href={a.url} target="_blank" rel="noreferrer" hreflang="en">{copy.article[1]}</a></p>)}
</section>
