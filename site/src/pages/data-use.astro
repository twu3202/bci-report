---
import data from '../data/mvp.json';
import evidence from '../data/evidence-update.json';
import clinical from '../data/clinical-update.json';
import context from '../data/context-update.json';
import adaptation from '../data/adaptation-update.json';
import extension from '../data/extension-update.json';
import large from '../data/large-source-update.json';
import reliable from '../data/reliable-decisions-update.json';
import foundation from '../data/foundation-models-update.json';
import shared from '../data/shared-representation-update.json';
import later from '../data/later-sessions-update.json';
import language from '../data/questions-in-language-update.json';
import languageWordings from '../data/questions-in-language-wordings.json';
import deployment from '../data/deployment-topics.json';
import { site, contact, contactReady, correctionSubject } from '../data/site';
import { defaultLocale } from '../data/i18n';
import { fmModelById, fmModels, fmRelease } from '../data/foundation-models';
import SiteHeader from '../components/SiteHeader.astro';
import AgentLinks from '../components/AgentLinks.astro';
import ShareImage from '../components/ShareImage.astro';
import FooterElsewhere from '../components/FooterElsewhere.astro';
import '../styles/global.css';
const description=`How ${site.name} selects sources, credits datasets and shares aggregate EEG benchmark results.`;
const locale=defaultLocale;
const canonical=new URL('/data-use/',Astro.site ?? site.origin).href;
const title=`Data use & privacy · ${site.name}`;
// The Dreem paper's statements, cohort by cohort, as the 2026-10-03 export records them.
// Route 1 (2026-10-04): no new dataset; the three recordings' 2026-09-20 rights records, reused unchanged.
const route1=reliable.results['reliable-decisions'];
const route1Rights=[route1.protocols['arithmetic-rest'].rights,route1.protocols['beta-8ch'].rights,route1.robustness.mi_rest.rights];
// The v9 foundation-model review of the same date (owner approved): no new dataset, so each core protocol's
// 2026-09-20 rights record, reused unchanged with its v9 "Published here" scope; and the new models' weights terms,
// one entry per family with every checkpoint and its revision, the licence note and the owner's decision.
const v9=(foundation as any).results['foundation-models-v9'];
const v9Rights=v9.protocols.map((p:any)=>({protocol:p.id,title:p.title,...p.rights}));
const v9Families=[...new Map(fmModels.map(m=>[m.slug,fmModels.filter(x=>x.slug===m.slug)])).values()];
// Route 2 (2026-10-07): BOAS is new, published under the owner's approval of its rights review with three stated
// gaps and an attribution; OpenBMI's 2026-10-03 record and EESM19's 2026-09-20 record are reused, each ending with
// what route 2 publishes. All read from the export, which holds them to the review manifest.
const route2=(shared as any).results['one-representation'];
const route2Rights=['openbmi','boas','eesm19'].map((id:string)=>({id,...route2.datasets[id].rights}));
const boasTerms=route2.boas_conditions;
// The later-sessions question (owner decision): three new sources, each published as aggregate scores, each with
// the licence read from its repository record and the ethics and consent statements read from its paper's full text.
const laterSources=Object.entries((later as any).datasets).map(([id,d]:[string,any])=>({id,...d.rights,ce:d.consent_and_ethics}));
// Route 3, questions in language (owner approval of the results, 2026-10-08): no new dataset, five released rights
// records reused unchanged, each with what route 3 publishes on it; new are three frozen text encoders (pinned, never
// redistributed) and the wordings, the site's own text; REVE Large's terms travel with its secondary rows; BOAS is
// published under the owner's D11, which extends its approval of 7 October to route 3. All read from the export.
const route3=(language as any).results['questions-in-language'];
const route3Sources=Object.entries((language as any).datasets).map(([id,d]:[string,any])=>({id,...d}));
const route3Encoders=Object.values(route3.design.text_encoders) as {repo:string;commit:string;licence:string}[];
const licenceName=(l:string)=>l==='mit'?'MIT':l==='apache-2.0'?'Apache-2.0':l;
const reveL=fmModelById['reve-large'];
const route3Boas=(language as any).boas_conditions;
const dreemStatements=Object.entries(large.results['dreem-sleep-baselines'].cohorts).map(([id,c])=>{const e=c.consent_and_ethics;
  return {id,ethics:e.ethics_approval.stated?e.ethics_approval.statement:`not stated. ${e.ethics_approval.note}`,consent:e.informed_consent.stated?e.informed_consent.statement:`not stated. ${e.informed_consent.note}`,readFrom:e.read_from};});
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#b3450e"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="icon" href="/favicon.ico" sizes="32x32"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="canonical" href={canonical}/><AgentLinks href="/data-use/"/><title>Data use &amp; privacy · {site.name}</title>
<meta property="og:type" content="article"/><meta property="og:site_name" content={site.name}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><ShareImage locale={locale}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/></head>
<body>
<SiteHeader locale={locale} path="/data-use/" active="data-use"/>
<main class="policy-page">
<p class="eyebrow">SOURCES &amp; RESPONSIBLE USE</p><h1>Evidence you can inspect.<br/>Recordings we do not redistribute.</h1>
<p>{site.name} is a personal, noncommercial research project. This release has no advertising, paid access, EEG upload form or diagnostic service.</p>
<div class="policy-summary"><strong>Downloads contain aggregate benchmark results and methods.</strong><p>They do not contain raw EEG, individual scores, participant identifiers, recordings, embeddings or model weights. Access original data through the credited source and follow that source’s terms.</p></div>
<section><h2>What a source review means</h2><p>We check the original release, its stated license, attribution requirements and available consent or ethics documentation. A Hugging Face mirror is a distribution source; its metadata alone does not establish the uploader’s rights or participants’ consent. Numerical audits and permission to publish are separate checks.</p><p>“Aggregate results” means this project has selected cohort-level outputs for the stated research scope. It is not legal certification, permission to reuse raw data, a claim of verified anonymity for the source files, or endorsement by the original researchers.</p></section>
<section id="sources"><h2>Sources in this release</h2><p>The deployment extension carries nine reviewed citation records. Six refer to datasets already represented in the matrix or research register; three add the wearable and mobile sources. These are citation records, not nine independent cohorts.</p><div class="scroll" tabindex="0" role="region" aria-label="Source terms table, scrolls horizontally"><table><thead><tr><th>Dataset</th><th>Source terms</th><th>Scope</th></tr></thead><tbody><tr><th colspan="3">Stable 39-comparison matrix and research register</th></tr>{data.datasets.map(d=><tr><td><a href={d.source} target="_blank" rel="noreferrer">{d.name} ↗</a><small>{d.attribution}</small></td><td>{d.licenseUrl?<a href={d.licenseUrl} target="_blank" rel="noreferrer">{d.license} ↗</a>:d.license}</td><td><strong>{d.status}</strong><small>{d.detail}</small></td></tr>)}<tr><th colspan="3">Deployment-topic extension</th></tr>{deployment.dataset_citations.map(d=><tr><td><a href={d.primary_sources[0]} target="_blank" rel="noreferrer">{d.identity.title} ↗</a><small>{d.identity.local_representation || d.identity.representation}</small></td><td>{d.identity.license}</td><td><strong>Aggregate topic results</strong><small>Participant-level scores, demographics and recordings stay outside the site.</small></td></tr>)}</tbody></table></div></section>
<section id="sources-2026-09-22"><h2>Sources added 22 September 2026</h2><p>Reviewed separately from the release above, each with its own recorded editorial decision and its own aggregate export. None of them extends the eight-protocol matrix.</p><div class="scroll" tabindex="0" role="region" aria-label="Sources added 22 September 2026, scrolls horizontally"><table><thead><tr><th>Dataset</th><th>Source terms</th><th>Consent and privacy</th></tr></thead><tbody>{Object.values(evidence.results).map(r=><tr><td><a href={r.rights.source} target="_blank" rel="noreferrer">{r.rights.name} ↗</a><small>{r.rights.attribution}</small></td><td><a href={r.rights.licenseUrl} target="_blank" rel="noreferrer">{r.rights.license} ↗</a></td><td><small>{r.rights.privacyReview}</small></td></tr>)}</tbody></table></div><p id="amendment-eesm19"><strong>Amended 22 September 2026 — EESM19.</strong> Its 2025 data descriptor, which covers EESM23 as well, states that publication was not mentioned in the informed consent form. The public release rests on the GDPR office of Region Midt judging the data fully anonymized. The entry above now says so. No score, cohort or decision changed.</p></section>
<section id="sources-2026-09-23"><h2>Sources added 23 September 2026</h2><p>Reviewed under their own manifest again. One is published as aggregate scores; two are published as status only, with no numbers of any kind. None of them extends the eight-protocol matrix.</p><div class="scroll" tabindex="0" role="region" aria-label="Sources added 23 September 2026, scrolls horizontally"><table><thead><tr><th>Dataset</th><th>Source terms</th><th>What is published</th></tr></thead><tbody>{Object.values(clinical.results).map(r=><tr><td><a href={r.rights.source} target="_blank" rel="noreferrer">{r.rights.name} ↗</a><small>{r.rights.attribution}</small></td><td><a href={r.rights.licenseUrl} target="_blank" rel="noreferrer">{r.rights.license} ↗</a></td><td><strong>Aggregate scores</strong><small>{r.rights.privacyReview}</small></td></tr>)}{clinical.status_only.map(e=><tr><td><a href={e.rights.source} target="_blank" rel="noreferrer">{e.name} ↗</a><small>{e.rights.attribution}</small></td><td><a href={e.rights.licenseUrl} target="_blank" rel="noreferrer">{e.rights.license} ↗</a></td><td><strong>Status only — no scores</strong><small>{e.reason}</small></td></tr>)}</tbody></table></div>
<p id="clinical-scope"><strong>A clinical cohort raises the bar, it does not lower it.</strong> {clinical.medical_disclaimer} The published rows are two model-level scores with descriptive intervals. Deliberately not published, although both are aggregates and both sit in the reviewed inputs: the per-group age means and sex counts of a diagnosis-specific cohort, which is the demographic profile this policy excludes just above, and the per-condition band descriptors of the six-person L-FAME expansion, where a range bound is one person's recording. The export code refuses all of them by field name, and the tests fail if any reappears.</p>
<p>What each batch could not publish is in the <a href="/releases/#holds">holds register</a>, with the date each hold was opened and, where it was, resolved.</p></section>

<section id="sources-2026-09-27"><h2>Sources added 27 September 2026</h2><p>Reviewed under their own manifest. Three are published as aggregate scores and one as status only. The asynchronous SSVEP pilot was held until its data paper's consent and ethics statement had been read, and released the same day. All four are fixed CPU baselines: this batch has no foundation-model or fine-tuning result.</p><div class="scroll" tabindex="0" role="region" aria-label="Sources added 27 September 2026, scrolls horizontally"><table><thead><tr><th>Dataset</th><th>Source terms</th><th>What is published</th></tr></thead><tbody>{Object.values(context.results).map(r=><tr><td><a href={r.rights.source} target="_blank" rel="noreferrer">{r.rights.name} ↗</a><small>{r.rights.attribution}</small></td><td><a href={r.rights.licenseUrl} target="_blank" rel="noreferrer">{r.rights.license} ↗</a></td><td><strong>Aggregate scores</strong><small>{r.rights.privacyReview}</small></td></tr>)}{context.status_only.map(e=><tr><td><a href={e.rights.source} target="_blank" rel="noreferrer">{e.name} ↗</a><small>{e.rights.attribution}</small></td><td><a href={e.rights.licenseUrl} target="_blank" rel="noreferrer">{e.rights.license} ↗</a></td><td><strong>Status only — no scores</strong><small>{e.reason}</small></td></tr>)}</tbody></table></div></section>

<section id="sources-2026-10-01"><h2>Reviewed 1 October 2026</h2><p>Under their own manifest. No new dataset: the LaBraM adaptation results reuse the 2026-09-20 review of the EEGMAT recordings unchanged, and the LaBraM Base checkpoint's MIT-licensed repository was reviewed for aggregate evaluation on the same date. The checkpoint, adapters and trained heads are not redistributed. The second experiment ran on a source whose editorial hold stands, so it is listed as status only.</p><div class="scroll" tabindex="0" role="region" aria-label="Reviewed 1 October 2026, scrolls horizontally"><table><thead><tr><th>Dataset</th><th>Source terms</th><th>What is published</th></tr></thead><tbody>{Object.values(adaptation.results).map(r=><tr><td><a href={r.rights.source} target="_blank" rel="noreferrer">{r.rights.name} ↗</a><small>{r.rights.attribution}</small></td><td><a href={r.rights.licenseUrl} target="_blank" rel="noreferrer">{r.rights.license} ↗</a></td><td><strong>Aggregate scores</strong><small>{r.rights.privacyReview}</small></td></tr>)}{adaptation.status_only.map(e=><tr><td><a href={e.rights.source} target="_blank" rel="noreferrer">{e.name} ↗</a><small>{e.rights.attribution}</small></td><td><a href={e.rights.licenseUrl} target="_blank" rel="noreferrer">{e.rights.license} ↗</a></td><td><strong>Status only — no scores</strong><small>{e.reason}</small></td></tr>)}</tbody></table></div><p>Two pieces of released wording were also corrected on this date, a method description and a dataset credit, without changing any released file; both are listed on the <a href="/releases/#corrections">releases page</a>.</p></section>

<section id="sources-2026-10-02"><h2>Reviewed 2 October 2026</h2><p>Under their own manifest; both published as aggregate scores. The asynchronous SSVEP extension scores the remaining twenty people of the same figshare release whose data paper's consent and ethics statement was read for the 27 September pilot; that record is reused by reference, not re-read. LTRSVP is a new source: the PhysioNet record carries no consent statement, so it was read from the original publication, which reports approval by the Ethics Committee of the University of Essex and written consent from every participant. The independent audits behind both are pinned by hash in the review manifest and not published, because they carry private storage paths. Both are fixed classical baselines: no foundation-model or fine-tuning result.</p><div class="scroll" tabindex="0" role="region" aria-label="Reviewed 2 October 2026, scrolls horizontally"><table><thead><tr><th>Dataset</th><th>Source terms</th><th>What is published</th></tr></thead><tbody>{Object.values(extension.results).map(r=><tr><td><a href={r.rights.source} target="_blank" rel="noreferrer">{r.rights.name} ↗</a><small>{r.rights.attribution}</small></td><td><a href={r.rights.licenseUrl} target="_blank" rel="noreferrer">{r.rights.license} ↗</a></td><td><strong>Aggregate scores</strong><small>{r.rights.privacyReview}</small></td></tr>)}</tbody></table></div></section>

<section id="sources-2026-10-03"><h2>Reviewed 3 October 2026</h2><p>Under their own manifest; both published as aggregate scores, each with two fixed classical baselines and no foundation-model or fine-tuning result. The Dreem Open Datasets are a new source. The licence recorded is MIT, as the Zenodo deposit declares it in its archived publisher metadata: the deposit’s declaration, not a statement about every future use. The upstream code licence could not be fetched, and nothing upstream is redistributed. The dataset paper gives its two cohorts different statements, and each is published as it stands (owner decision, 3 October 2026): for DOD-H the paper names an ethics approval and has no informed-consent sentence; for DOD-O it states written informed consent and names no ethics committee — as the Alpha Waves release was published on 22 September with a consent statement and no named committee. The physical units of the Dreem recordings are unresolved (the stored metadata says millivolts, the publisher’s converter microvolts), so models that need absolute amplitude are held. OpenBMI is new to this site: CC0 1.0 per the DataCite record GigaDB registered and GigaDB’s repository policy (the GPL-3.0 seen in third-party catalogues is the licence of the OpenBMI code, not of the data), and the paper states approval by the Korea University Institutional Review Board and written informed consent. The independent audits behind both are pinned by hash in the review manifest and not published, because they carry private storage paths.</p><div class="scroll" tabindex="0" role="region" aria-label="Reviewed 3 October 2026, scrolls horizontally"><table><thead><tr><th>Dataset</th><th>Source terms</th><th>What is published</th></tr></thead><tbody>{Object.values(large.results).map(r=><tr><td><a href={r.rights.source} target="_blank" rel="noreferrer">{r.rights.name} ↗</a><small>{r.rights.attribution}</small></td><td><a href={r.rights.licenseUrl} target="_blank" rel="noreferrer">{r.rights.license} ↗</a></td><td><strong>Aggregate scores</strong><small>{r.rights.privacyReview}</small></td></tr>)}</tbody></table></div><p id="dreem-consent"><strong>Dreem, cohort by cohort, as the paper states it.</strong> {dreemStatements.map(d=><>{d.id} — ethics approval: {d.ethics} Informed consent: {d.consent} </>)}Read from {dreemStatements[0].readFrom}.</p></section>

<section id="sources-2026-10-04"><h2>Reviewed 4 October 2026</h2><p>Two reviews on this date, each under its own manifest: route 1 of the decision-research roadmap, and the foundation-model evaluation.</p><h3 id="sources-2026-10-04-route-1">Route 1, reliable decisions</h3><p>Route 1 adds no new dataset and no new model: it rescored the saved test scores of models this site already publishes on EEGMAT, BETA and ds003810, whose rights records from the 2026-09-20 review are reused unchanged, and every full-coverage accuracy equals the published one. Published: pooled coverage and selective error, probability quality and paired contrasts with whole-person bootstrap intervals, and counts of people and of outer folds. Not published: per-trial, per-person and per-fold values, including the person-level percentiles and the median temperature over folds the release candidate carries; the route's idle-protocol figures, which are in another unit; and every figure of its BNCI2015-001 arm, whose editorial hold stands. ds003810 is shown as crude. The audits behind the release are pinned by hash in the review manifest and not published, because they carry private storage paths.</p><div class="scroll" tabindex="0" role="region" aria-label="Reviewed 4 October 2026, scrolls horizontally"><table><thead><tr><th>Dataset</th><th>Source terms</th><th>What is published</th></tr></thead><tbody>{route1Rights.map(r=><tr><td><a href={r.source} target="_blank" rel="noreferrer">{r.name} ↗</a><small>{r.attribution}</small></td><td><a href={r.licenseUrl} target="_blank" rel="noreferrer">{r.license} ↗</a></td><td><strong>Aggregate scores</strong><small>{r.privacyReview}</small></td></tr>)}</tbody></table></div>
<h3 id="sources-2026-10-04-v9">Foundation models</h3><p>No new dataset, but new models. Eleven further EEG foundation models — sixteen encoder checkpoints — were run as frozen probes on the eight core protocols with the published recipe and only the encoder swapped, and nine of them were adapted on EEGMAT. The seven datasets behind those protocols keep their rights records from the 2026-09-20 review, reused unchanged; each record below ends with what this release publishes on it. The new models’ weights carry their own terms, reviewed on the same date and listed below with the owner’s decision for each: the REVE Responsible Use License, accepted by the owner; LUNA’s CC BY-ND 4.0, approved for internal probing and adaptation with aggregate scores only and no endorsement implied; ERP-FM’s CC BY-NC-SA 4.0, non-commercial; and ZUNA 1.1’s model card, research use only, not for diagnosis or clinical use. No weights, adapted weights or LoRA deltas were kept or shared, and no model’s authors endorse these results. Pretraining exposure is what each model’s authors publish as their pretraining list, checked on 4 October 2026 and linked on the protocol and method pages: not proof that a recording was never seen. Not published: per-trial, per-person and per-fold values, features, and timings and memory, which were measured on a shared GPU. The aggregate, the group summaries and the six independent audits are pinned by hash in the review manifest and not published, because they carry private storage paths. Release <a href={`/releases/#${fmRelease.id}`}><code>{fmRelease.id}</code></a>.</p><div class="scroll" tabindex="0" role="region" aria-label="Reviewed 4 October 2026, foundation models, source terms, scrolls horizontally"><table data-v9-sources="true"><thead><tr><th>Dataset · protocol</th><th>Source terms</th><th>What is published</th></tr></thead><tbody>{v9Rights.map((r:any)=><tr data-v9-source={r.protocol}><td><a href={r.source} target="_blank" rel="noreferrer">{r.name} ↗</a><small>{r.title} · <a href={`/protocols/${r.protocol}/#foundation-v9`}>{r.protocol}</a></small><small>{r.attribution}</small></td><td><a href={r.licenseUrl} target="_blank" rel="noreferrer">{r.license} ↗</a></td><td><strong>Aggregate scores</strong><small>{r.privacyReview}</small></td></tr>)}</tbody></table></div><p>The new models’ weights, one entry per model family, with every checkpoint and its revision:</p><div class="scroll" tabindex="0" role="region" aria-label="Reviewed 4 October 2026, foundation models, weights terms, scrolls horizontally"><table data-v9-licences="true"><thead><tr><th>Model and checkpoints</th><th>Weights licence and terms</th><th>Owner’s review, 4 October 2026</th></tr></thead><tbody>{v9Families.map(ms=><tr data-v9-licence={ms[0].slug}><td><a href={`/methods/${ms[0].slug}/`}>{ms.map(m=>m.name).join(' · ')}</a>{ms.map(m=><small><span>{m.name}</span>: {m.revision ? <code>{m.revision}</code> : 'revision not in the release'}{m.revision && /sha256 is the identity/.test(m.revision) && m.checkpointSha && <> · SHA-256 <code>{m.checkpointSha}</code></>}</small>)}</td><td>{ms[0].licenceNote}<small><a href={ms[0].paper} target="_blank" rel="noreferrer">Paper ↗</a></small></td><td><small>{ms[0].rightsReview}</small></td></tr>)}</tbody></table></div></section>

<section id="sources-2026-10-07"><h2>Reviewed 7 October 2026</h2><p>Under its own manifest: route 2 of the decision-research roadmap, one representation and several questions. One new source, BOAS, and two records reused. OpenBMI keeps its rights record from the 3 October review, and EESM19 its record from the 20 September review with the 22 September amendment; route 2 uses every stored epoch of the full EESM19 release that passes the published quality rules, with the first scorer’s stages at their natural mix: a different protocol from the balanced scalp subset in the core matrix. Each record below ends with what this release publishes on it. Not published: per-window, per-person, per-night and per-fold values, including the per-person percentiles the release candidate carries for OpenBMI; measured compute totals (GPU-hours, wall time per fit and per block, training steps per outer fold), while the cost ledger publishes, labelled indicative, the two times measured interleaved on a shared GPU; and the aggregates and the three independent audits, which are pinned by hash in the review manifest and not published, because they carry private storage paths. Release <a href={`/releases/#${shared.release_id}`}><code>{shared.release_id}</code></a>.</p><div class="scroll" tabindex="0" role="region" aria-label="Reviewed 7 October 2026, scrolls horizontally"><table data-route2-sources="true"><thead><tr><th>Dataset</th><th>Source terms</th><th>What is published</th></tr></thead><tbody>{route2Rights.map((r:any)=><tr data-route2-source={r.id}><td><a href={r.source} target="_blank" rel="noreferrer">{r.name} ↗</a><small>{r.attribution}</small></td><td><a href={r.licenseUrl} target="_blank" rel="noreferrer">{r.license} ↗</a></td><td><strong>Aggregate scores</strong><small>{r.privacyReview}</small></td></tr>)}</tbody></table></div>
<p id="boas-gaps"><strong>BOAS, published with three stated gaps (owner decision, 7 October 2026).</strong> Its authors released it on OpenNeuro under CC0, name an ethics committee with a reference number and state written informed consent. Three gaps remain, and they are stated wherever a BOAS figure appears: {boasTerms.gaps.join(' ')} The owner approved publishing cohort aggregates only, with every cell pooling at least {boasTerms.minimum_cell_people} people, no demographics and no per-person distributions. Participants are {boasTerms.participants}. {boasTerms.not_an_evaluation_of} Credit: {boasTerms.attribution}</p></section>

<section id="sources-later-sessions"><h2>Later sessions: three new sources</h2><p>Under their own manifest: four results on one question — does a decoder trained on an earlier session still work later? — each from its own approved release, and each the same person in a later session with no labels from it. All three sources are new to this site and published as aggregate scores: WBCIC-SHU motor imagery, the longitudinal RSVP dataset (its Group A only) and Forenzo and He’s continuous-tracking dataset. Each licence was read from the repository’s public API record and each ethics and consent statement from the paper’s full text, on 8 October 2026; the statements are quoted below. The continuous-tracking results count cohort records, not proven unique people, and never pool the two cohorts. Each record below ends with what this release publishes on it. Not published: per-person and per-record values, including every minimum and percentile and every median other than the four cursor-tracking ridge medians printed beside their means; WBCIC-SHU confusion matrices; the cursor-tracking results split by recorded decoder; measured compute; and the handoffs, release decisions and independent audits, which are pinned by hash in the review manifest and not published, because they carry private storage paths. Release <a href={`/releases/#${later.release_id}`}><code>{later.release_id}</code></a>.</p><div class="scroll" tabindex="0" role="region" aria-label="Later sessions, three new sources, scrolls horizontally"><table data-later-sources="true"><thead><tr><th>Dataset</th><th>Source terms</th><th>What is published</th></tr></thead><tbody>{laterSources.map((r:any)=><tr data-later-source={r.id}><td><a href={r.source} target="_blank" rel="noreferrer">{r.name} ↗</a><small>{r.attribution}</small></td><td><a href={r.licenseUrl} target="_blank" rel="noreferrer">{r.license} ↗</a></td><td><strong>Aggregate scores</strong><small>{r.privacyReview}</small></td></tr>)}</tbody></table></div><p id="later-sessions-consent"><strong>Ethics and consent, as each paper states them.</strong> {laterSources.map((r:any)=><>{r.name} — ethics approval: {r.ce.ethics_approval.statement} Informed consent: {r.ce.informed_consent.statement} Read from <a href={r.ce.read_from.split(' ')[0]} target="_blank" rel="noreferrer">its paper’s full text ↗</a>. </>)}</p></section>

<section id="sources-questions-in-language"><h2>Questions in language: sources, text encoders and wordings</h2><p>Under its own manifest: route 3 of the decision-research roadmap, where one small head over frozen EEG features is asked each question by a question number, a label template or a description. No new dataset: BETA, BOAS, EESM19, OpenBMI motor imagery and the wearable SSVEP dataset keep their rights records, reused unchanged, and each record below ends with what this release publishes on it. New here are three frozen text encoders, which turn the wordings into vectors, and the wordings themselves. Not published: per-person, per-night, per-recording and per-fold values, per-window scores, features, head weights, text-encoder files and fold assignments; the per-frequency and interior-only SSVEP breakdowns, which no independent audit covers; any value of a pre-run check, which is published as pass or fail and counts only; demographics, recording dates and clock times; measured compute; and the handoff, the aggregates, the protocol and the four independent audits, which are pinned by hash in the review manifest and not published, because they carry private storage paths. Release <a href={`/releases/#${language.release_id}`}><code>{language.release_id}</code></a>.</p><div class="scroll" tabindex="0" role="region" aria-label="Questions in language, sources, scrolls horizontally"><table data-ql-sources="true"><thead><tr><th>Dataset</th><th>Source terms</th><th>What is published</th></tr></thead><tbody>{route3Sources.map((r:any)=><tr data-ql-source={r.id}><td><a href={r.source} target="_blank" rel="noreferrer">{r.name} ↗</a><small>{r.attribution}</small>{r.paper && <small>{r.paper}</small>}</td><td><a href={r.licenseUrl} target="_blank" rel="noreferrer">{r.license} ↗</a></td><td><strong>Aggregate scores</strong><small>{r.published_here}</small></td></tr>)}</tbody></table></div>
<p id="ql-text-encoders"><strong>Three text encoders, frozen at pinned commits and never redistributed.</strong> {route3Encoders.map((x,i)=><>{i>0&&'; '}<a href={`https://huggingface.co/${x.repo}`} target="_blank" rel="noreferrer">{x.repo} ↗</a> ({licenceName(x.licence)}, commit <code>{x.commit}</code>)</>)}. Each is used as released, only to turn the wordings into vectors; no encoder file is served.</p>
<p id="ql-reve"><strong>REVE Large, for secondary results.</strong> Frozen REVE Large features (<code>{reveL.revision}</code>) feed secondary results on BETA and BOAS, under the REVE Responsible Use License v1.0, accepted by the owner with the other foundation models above: aggregate results only, the <a href={reveL.paper} target="_blank" rel="noreferrer">REVE paper ↗</a> cited and the model version named. No model’s authors endorse these results.</p>
<p id="ql-wordings"><strong>The wordings are this site’s own text.</strong> <a href="/data/questions-in-language-wordings.json" download>questions-in-language-wordings.json</a> holds every text the questions were asked with, in English and Chinese, written by two agents from a fixed brief before any score, with the held-out frequencies and the derangements of the shuffled control. It is published under <a href={languageWordings.licenseUrl} target="_blank" rel="noreferrer">{languageWordings.license} ↗</a>.</p>
<p id="ql-boas"><strong>BOAS, extended to route 3 (owner decision D11).</strong> The owner extended BOAS’s approval of 7 October 2026 to route 3’s aggregate BOAS results, under the same conditions: <a href="#boas-gaps">the three stated gaps and the credit above</a>, stated wherever a BOAS figure appears; participants {route3Boas.participants}; cohort aggregates only, every cell pooling at least {route3Boas.minimum_cell_people} people; no demographics and no per-person distributions; every pre-run check on BOAS published as pass or fail and counts only. {route3Boas.not_an_evaluation_of}</p></section>

<section><h2>What stays local</h2><ul><li>Recordings, timestamps, subject mappings, labels and individual predictions remain outside the website.</li><li>We do not publish diagnosis-specific small groups, identifiable example traces, or demographic profiles. Aggregate scores describe decoder performance, not a person’s health or ability.</li><li>Source files with unclear provenance, incompatible terms or unresolved physical calibration do not enter published comparisons.</li></ul><p>Removing a name or replacing it with a code does not by itself anonymize EEG. Open licenses address specified intellectual-property rights; they do not generally clear privacy and personality rights.</p>
<p id="small-cohorts"><strong>An average over four people is close to its parts.</strong> The idle protocol has a cohort of four, and at that size a published mean can be turned back into a count: 1.7&#37; of 60 command trials is one detection, and since two of the four participants selected an always-abstain threshold, that detection belongs to one of the remaining two. We publish the abstention counts anyway, because a false-activation rate of zero produced by people who never activate is the more misleading number. What a reader cannot recover is which person is which — participants are unidentified here and in the public source recordings, and no demographic, session or ordering information is published that would let anyone line them up. Treat &quot;aggregate&quot; as a description of what is published, not as a claim that it cannot be inverted.</p>
<p id="odd-medians"><strong>A median over an odd number of records is one record&#39;s value.</strong> The later-sessions page prints the cursor-tracking ridge&#39;s median error beside its mean for each Forenzo cohort and response arm, and the Main cohort has an odd number of admitted records, so each of its printed medians is the error of one record. We publish those medians anyway, because a mean pulled far upwards by a few very large errors is the more misleading number without them. It does not identify anyone: the records are not proven to be distinct people, the page does not say which record the median is, and no participant, record or file identifier is published.</p></section>
<section><h2>How to interpret the comparisons</h2><p>Each protocol states the cohort, selected electrodes, preprocessing, split and training budget. Frozen foundation encoders, scratch-trained networks and classical references are labeled separately. The stable matrix keeps its fixed published seeds; the deployment extension separately reports five three-seed EEGNet sensitivity groups. These comparisons and descriptive intervals do not establish optimal performance or clinical validation.</p><p>Pretraining exposure is stated as what each model’s authors publish as their pretraining list, checked on 4 October 2026 and linked to the source on the protocol and method pages: a dataset absent from the list is “not in the authors’ published pretraining list”, which is not proof that its recordings were never seen, and where the authors publish no list (ZUNA 1.1) it is unknown. Four- and eight-electrode subsets of laboratory recordings do not validate a physical four- or eight-channel headset.</p></section>
<section id="corrections"><h2>Corrections and changes of use</h2>
<p>Scientific corrections, benchmark-method questions, and rights, privacy or attribution concerns are all welcome, including ones that would withdraw a published result. Affected results can be withheld while an issue is reviewed.</p>
{contactReady ? (
<div class="policy-summary"><strong>Report an issue</strong><p>Write to <a href={`mailto:${contact.corrections}?subject=${encodeURIComponent(correctionSubject+' ')}`}>{contact.corrections}</a> for scientific corrections and benchmark questions, or <a href={`mailto:${contact.privacy}`}>{contact.privacy}</a> for privacy, licensing and withdrawal requests. Both addresses are selectable text as well as links.</p><p>This domain receives mail but does not send it, so a reply will come from the maintainer's own mailbox rather than from {site.origin.replace('https://','@')}. Replying to the address above still reaches the same place.</p></div>
) : (
<div class="policy-summary"><strong>A public contact address is not published yet.</strong><p>Until a monitored address is published here, please reply through the channel where you received the link. A permanent address for corrections and for privacy requests will appear in this section, and this note will be removed.</p></div>
)}
<p>When reporting, please include the page URL, the dataset and model, the release or protocol ID, a short description, and a public evidence link. <strong>Do not send raw EEG, participant names, health records, passwords or identity documents</strong> — an email address cannot technically refuse attachments, so please do not send them. Identity proof is not requested. Published corrections are redacted scientific notes; the original message and sender details are not published.</p>
<p>Advertising, sponsorship, paid access, new hosting jurisdictions, data uploads or clinical applications require a new scope review. A noncommercial source label is not a blanket authorization for those uses.</p></section>
<section><h2>Website privacy</h2><p>The application does not run analytics, advertising trackers or EEG processing. Hosting and access-control providers may process connection and sign-in information independently. External source links lead to sites with their own privacy practices.</p><p>This site is not a medical service and provides no diagnosis, treatment advice or participant-level assessment.</p></section>
