---
import data from '../data/mvp.json';
import { site } from '../data/site';
import '../styles/global.css';
import '../styles/matrix.css';
import '../styles/directory.css';
const tracks=data.tracks;
const track=tracks[0];
const canonical=new URL('/',Astro.site ?? site.origin).href;
const ogImage=new URL('/og.png',Astro.site ?? site.origin).href;
const title=`${site.name} · Public EEG Model Evaluation`;
const chanceOf=(t:typeof tracks[number])=>(t as {chanceLevel?:number|null}).chanceLevel ?? null;

// The same caveats workbench.ts attaches on re-render, applied to the first
// paint so the static HTML — what a crawler and a no-JS reader get — carries
// them too. Kept in step with seedFlag()/chanceFlag() in the script.
const chance=chanceOf(track);
const seed=(track as {seedSensitivity?:{model:string;balancedAccuracyPercent:number[];meanPercent:number}}).seedSensitivity;
const chanceNote=(r:{y:number;interval?:number[]|null})=>{
  if(chance===null) return null;
  if(r.y<=chance) return `At or below the ${chance}% chance level`;
  if(r.interval&&r.interval[0]<=chance) return `Interval reaches the ${chance}% chance level`;
  return null;
};
const seedNote=(name:string)=>{
  if(!seed||seed.model!==name) return null;
  const v=seed.balancedAccuracyPercent,hi=Math.max(...v),lo=Math.min(...v);
  const word=v[0]>=hi?'highest':v[0]<=lo?'lowest':'middle';
  return `Single seed — the ${word} of ${v.length} run (${lo.toFixed(2)}–${hi.toFixed(2)}%, mean ${seed.meanPercent.toFixed(2)}%)`;
};

// --- Coverage matrix -------------------------------------------------------
// Built here rather than in the client script: it is the page's opening screen,
// so it must exist in the served HTML with no JavaScript, and it never changes
// in response to a control.
const familyLabel=(f:string)=>f==='foundation'?'Foundation model':f==='small'?'Compact model':'Classical method';
const methods=new Map<string,{family:string;scores:Map<string,number>}>();
for(const t of tracks) for(const r of t.rows){
  const entry=methods.get(r.name) ?? {family:r.family,scores:new Map<string,number>()};
  entry.scores.set(t.id,r.y);
  methods.set(r.name,entry);
}
// Highest score within a column, marked per protocol only. The idle track is
// excluded on purpose: its headline number is command detection, and detection
// without its false-activation rate is exactly the reading this site argues
// against — always abstaining scores zero false activations.
const leader=new Map<string,string>();
for(const t of tracks){
  if(t.type==='tradeoff') continue;
  const best=t.rows.reduce((a,b)=>b.y>a.y?b:a);
  leader.set(t.id,best.name);
}
const matrixRows=[...methods.entries()]
  .map(([name,m])=>({name,family:m.family,scores:m.scores,covered:m.scores.size}))
  .sort((a,b)=>b.covered-a.covered || a.name.localeCompare(b.name));
// Where the score sits between this task's own chance level and 100%. Scaling
// each column by its own chance is what makes a 33.7% on a 40-class task and a
// 62.9% on a 2-class task legible at all; it is also why the bars carry no
// meaning sideways, which the caption states.
const fill=(t:typeof tracks[number],y:number)=>{
  const c=chanceOf(t) ?? 0;
  return Math.max(0,Math.min(100,(y-c)/(100-c)*100));
};
const datasetCount=new Set(tracks.map(t=>t.dataset)).size;
const stats=[
  ['Protocols',data.coverage.displayedProtocols],
  ['Datasets',datasetCount],
  ['Comparisons',data.coverage.displayedComparisons],
  ['Methods',matrixRows.length],
] as const;
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={site.description}/><meta name="theme-color" content="#b3450e"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="icon" href="/favicon.ico" sizes="32x32"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="canonical" href={canonical}/><title>{title}</title>
<meta property="og:type" content="website"/><meta property="og:site_name" content={site.name}/><meta property="og:title" content={title}/><meta property="og:description" content={site.description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={ogImage}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content={`${site.name} — every EEG score with the protocol that produced it. ${data.coverage.displayedProtocols} protocols, ${datasetCount} datasets, ${data.coverage.displayedComparisons} comparisons, ${matrixRows.length} methods.`}/>
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={site.description}/><meta name="twitter:image" content={ogImage}/></head>
<body><a class="skip" href="#overview">Skip to results</a>
<header><a class="brand" href="/"><span class="mark">{site.name.charAt(0)}</span>{site.name} <small>{site.stage}</small></a><nav aria-label="Main navigation"><a href="#overview">Results</a><a href="#benchmarks">Protocols</a><a href="#models">Models</a><a href="#datasets">Datasets</a><a href="#news">Updates</a><a href="/data-use/">Data use</a></nav><a class="download" href="/data/experiments.json" download>Aggregate results ↗</a></header>
<main><section class="masthead"><div><p class="eyebrow">Open EEG evaluation · Snapshot {data.generatedAt.slice(0,10)}</p><h1>Every EEG score, with the protocol that produced it.</h1><p class="lede">{matrixRows.length} decoding methods run under {data.coverage.displayedProtocols} fixed protocols on {datasetCount} public datasets. Cohort, electrode count, training budget and chance level travel with every number.</p></div><dl class="stat-rail">{stats.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}<span class="live"><i></i>{site.stage}</span></dl></section>

<section id="overview" class="overview"><div class="section-heading"><div><p class="eyebrow">All measured results</p><h2>{matrixRows.length} methods × {data.coverage.displayedProtocols} protocols</h2></div><p>Every comparison in this release on one screen. Blank cells are protocols a method has not been run on — not failures.</p></div>
<div class="matrix-frame"><div class="scroll" tabindex="0" role="region" aria-label="Coverage matrix of methods against protocols, scrolls horizontally"><table class="matrix"><caption class="visually-hidden">Balanced accuracy of each method on each protocol. Chance level differs by protocol and is given in each column heading.</caption><thead><tr><th class="corner" scope="col">Method</th>{tracks.map(t=><th class="colhead" scope="col"><a href="#benchmarks" data-jump={t.id}>{t.title}</a><small>n={t.subjects} · {chanceOf(t)===null?'detection':'chance '+chanceOf(t)+'%'}</small></th>)}</tr></thead>
<tbody>{matrixRows.map(m=><tr data-family={m.family}><th class="rowhead" scope="row"><span class="mname">{m.name}</span><small>{familyLabel(m.family)} · {m.covered} of {tracks.length}</small></th>{tracks.map(t=>{
  const y=m.scores.get(t.id);
  if(y===undefined) return <td class="cell none"><span class="num" title={`${m.name} has not been evaluated on ${t.title}`}>·</span></td>;
  const c=chanceOf(t);
  const below=c!==null&&y<=c;
  return <td class="cell" data-rank={leader.get(t.id)===m.name?'lead':below?'sub':null} title={`${m.name} · ${t.title}: ${y.toFixed(1)}% ${t.yLabel.toLowerCase()}`}><span class="track"><span class="bar" style={`--w:${fill(t,y).toFixed(1)}%`}></span></span><span class="num">{y.toFixed(1)}</span>{below&&<span class="cmark">≤ chance</span>}</td>;
})}</tr>)}</tbody></table></div>
<p class="matrix-note"><span class="key"><i class="lead"></i>Best on that protocol</span><span class="key"><i class="plain"></i>Bar = position between that protocol's chance level and 100%</span><span class="key"><i class="gap"></i>Not evaluated</span></p></div>
<p class="matrix-caveat">Bars are comparable <strong>down</strong> a column and not <strong>across</strong> one: chance level is 50% for the two-class tasks, 20% for sleep staging and 2.5% for 40-class SSVEP, and every protocol uses a different cohort and electrode layout. There is no overall score. The idle column reports command detection only — read it with the false-activation rate in its protocol.</p></section>

<section id="benchmarks" class="section"><div class="section-heading"><div><p class="eyebrow">One protocol at a time</p><h2>The evidence behind each score</h2></div><p>Cohort, electrode layout, training budget, source terms and known limitations, alongside the numbers they belong to.</p></div>
<div class="track-tabs" id="track-tabs" role="tablist" aria-label="Evaluation protocol" data-active={track.id}>{tracks.map(t=><button class="track-tab" type="button" role="tab" id={'tab-'+t.id} aria-controls="track-panel" data-track={t.id} aria-selected={t.id===track.id?'true':'false'} tabindex={t.id===track.id?0:-1}><strong>{t.title}</strong><small>{t.dataset} · {t.subjects} participants</small></button>)}</div>
<div id="track-panel" role="tabpanel" aria-labelledby={'tab-'+track.id} aria-label={track.title+" results"}><div class="context"><div><h2 id="track-title">{track.subtitle}</h2><p id="track-meta">{track.dataset} · {track.subjects} subjects · {track.observations}</p></div><button class="button" id="open-protocol">View protocol ↗</button></div>
<div class="results-panel"><div class="table-panel"><div class="toolbar"><div><p class="eyebrow">Measured here</p><h3>Results at a glance</h3></div><div class="controls"><label>Model family<select id="family-filter"><option value="all">All families</option><option value="foundation">Foundation model</option><option value="small">Compact model</option><option value="classical">Classical method</option></select></label><label>Sort<select id="sort-results"><option value="name">Model name</option><option value="y-desc">Primary metric ↓</option><option id="secondary-sort" value="x-asc">Secondary metric ↓</option></select></label><a id="download-results" class="button" href={'/data/'+track.id+'-results.csv'} download>CSV ↓</a></div></div>
<div class="scroll" tabindex="0" role="region" aria-label="Results table, scrolls horizontally"><table><thead><tr><th>Model / configuration</th><th id="metric-y-heading">{track.yLabel}</th><th id="metric-x-heading">{track.xLabel}</th><th>Compute time</th></tr></thead><tbody id="result-rows">{track.rows.map(r=><tr><td><button class="model-name" data-model={r.id}>{r.name} ↗</button><small>{r.mode} · {r.channels} ch</small></td><td><strong>{r.y.toFixed(1)}%</strong><small>{r.yDetail}</small>{chanceNote(r)&&<span class="flag">{chanceNote(r)}</span>}{seedNote(r.name)&&<span class="flag seed">{seedNote(r.name)}</span>}</td><td><strong>{track.type==='tradeoff'?r.x.toFixed(1)+'%':r.x.toFixed(3)}</strong><small>{r.xDetail}</small></td><td>{r.seconds.toFixed(1)}s</td></tr>)}</tbody></table></div><p class="scroll-hint" id="scroll-hint">Scroll the table sideways for the remaining columns.</p><p class="caption">Fixed budgets and adapters; no universal ranking. Scoring time includes fitting and prediction, and may include accelerator waiting. It excludes data preparation.</p></div>
<aside><p class="eyebrow">Visual comparison</p><h3 id="chart-title">Accuracy by configuration</h3><div id="result-chart" class="chart"></div><div id="chart-legend" class="legend"></div><p id="chart-note">Read each comparison with its protocol and limitations.</p></aside></div>
<div class="source-strip"><span id="track-rights">{track.license} · Aggregate research results</span><a id="track-source" href={track.source} target="_blank" rel="noreferrer">Original dataset ↗</a><a href="/data-use/">Use &amp; privacy →</a><a href="/data-use/#corrections">Report an issue with this result →</a></div><div class="evidence"><strong>Read with care</strong><p id="track-limitation">{track.limitation}</p><a href="#methods">Methods →</a></div></div></section>
<section id="models" class="section"><div class="section-heading"><div><p class="eyebrow">Model directory</p><h2>From compact baselines to foundation models</h2></div><p>Availability and measured performance are separate. Parameter counts depend on the backbone and task configuration.</p></div><div class="model-grid">{data.models.map(m=><article class="model-card"><div class="card-top"><span class="family">{familyLabel(m.family)}</span><span class:list={['status',{'ready':m.status==='Evaluated'}]}>{m.status}</span></div><h3>{m.name}</h3><p class="parameter">{m.parameters ? (m.parameters/1e6>=1?(m.parameters/1e6).toFixed(2)+'M':(m.parameters/1e3).toFixed(1)+'K'):'—'} <span>parameters</span></p><p>{m.note}</p><div class="card-footer"><span>{m.license}</span><a href={m.url || 'https://braindecode.org/'} target="_blank" rel="noreferrer">Official source ↗</a></div></article>)}</div></section>
<section id="datasets" class="section"><div class="section-heading"><div><p class="eyebrow">Public data</p><h2>Public data, documented experiments</h2></div><p>Source terms are checked separately from numerical results. Unresolved data remain outside this release.</p></div><div class="dataset-list">{data.datasets.map(d=><article class="dataset-row"><div><span class="family">{d.task}</span><h3><a href={d.source} target="_blank" rel="noreferrer">{d.name} ↗</a></h3><p>{d.detail}</p></div><dl><div><dt>Subjects</dt><dd>{d.subjects}</dd></div><div><dt>Channels</dt><dd>{d.channels}</dd></div></dl><div class="dataset-status"><span class="status">{d.status}</span><small>{d.licenseUrl?<a href={d.licenseUrl} target="_blank" rel="noreferrer">{d.license} ↗</a>:d.license}</small><small>{d.attribution}</small></div></article>)}</div></section>
<section id="news" class="section"><div class="section-heading"><div><p class="eyebrow">Field notes</p><h2>Notes from the field</h2></div><p>Curated research updates, linked to original sources.</p></div><div class="news-grid">{data.news.map(n=><article class="news-card"><div class="card-top"><span class="family">{n.tag}</span><time datetime={n.date}>{n.date}</time></div><h3><a href={n.sourceUrl} target="_blank" rel="noreferrer">{n.title} ↗</a></h3><p>{n.summary}</p><span class="source">{n.source}</span></article>)}</div></section>
<section id="methods" class="section methods"><div><p class="eyebrow">Evidence before ranking</p><h2>A score is only useful with its conditions.</h2><p>{data.evidencePolicy}</p><a class="button" href="/data/experiments.json" download>Download all results · JSON ↓</a></div><div class="method-grid"><article><span>01</span><h3>A successful forward pass is not a benchmark</h3><p>Downloads, loading checks and scored evaluations have distinct status labels. Models awaiting an adapter have no result.</p></article><article><span>02</span><h3>Show the failure modes</h3><p>Report missed commands, false activations and abstention. Zero errors in a short session do not establish all-day reliability.</p></article><article><span>03</span><h3>Compare the same task</h3><p>Splits, channels, preprocessing and training modes travel with each protocol. Frozen encoders and scratch baselines are labeled separately.</p></article><article><span>04</span><h3>Start with fixed, audited local runs</h3><p>Experiments run offline on a Mac or local GPU workstation. Timings are configuration-specific. This website performs no EEG inference or diagnosis.</p></article></div></section>
</main><footer><a class="brand" href="/">{site.name}</a><p>Aggregate results. Credited sources. Research use.</p><a href="/data-use/#corrections">Report an issue</a><a href="/data-use/">Data use &amp; privacy</a><a href="#overview">Back to results ↑</a></footer>
<dialog id="detail-dialog" aria-labelledby="dialog-title"><div class="dialog-top"><p class="eyebrow">Experiment details</p><button id="close-dialog" aria-label="Close details">×</button></div><h2 id="dialog-title"></h2><div id="dialog-body"></div></dialog>
<script>import '../scripts/workbench';</script>
</body></html>
