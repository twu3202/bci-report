---
import rawData from '../../data/deployment-topics.json';
import TopicLayout from '../../components/TopicLayout.astro';
import ScoreBar from '../../components/ScoreBar.astro';
import { type DeploymentData, type DeploymentRow, intervalPct, modelLabel, pct, pp, intervalPp } from '../../data/topics';

const data = rawData as unknown as DeploymentData;
const ridgeRows = data.rows.filter(row => row.track === 'wearable-calibration');
const trcaRows = data.rows.filter(row => row.track === 'wearable-etrca-calibration');
const trcaContrasts = data.paired_contrasts.filter(row => row.track === 'wearable-etrca-calibration');
const citation = data.dataset_citations.find(item => item.id === 'zhu2021-wearable102-author-snapshot-20260920');
const targetRidge = (sensor: string, budget: number) => ridgeRows.find(row => row.training_regime === 'target-only' && row.target_sensor === sensor && row.labeled_target_trials === budget)!;
const sourceRidge = (source: string, target: string) => ridgeRows.find(row => row.training_regime === 'source-only' && row.source_sensor === source && row.target_sensor === target)!;
const methodRow = (model: string, sensor: string, budget: number) => trcaRows.find(row => row.model === model && row.target_sensor === sensor && row.labeled_target_trials === budget)!;
const budgets = [12,24,48];
const sensors = ['wet','dry'];
const wetImprovement = trcaContrasts.find(row => row.comparison === 'etrca48-minus-etrca24-wet')!;
const dryImprovement = trcaContrasts.find(row => row.comparison === 'etrca48-minus-etrca24-dry')!;
---
<TopicLayout
  title="How much calibration?"
  description="Target-only wearable SSVEP calibration at 12, 24 and 48 labeled trials, with source-only spectral ridge and analytic CCA kept as separate reference arms."
  path="/topics/calibration-budget/"
  eyebrow="Adaptation budget · common future test blocks"
  dek="More labeled trials do not have one universal value. On this 12-target wearable protocol, target-only spectral ridge improves gradually but remains low; single-band ensemble TRCA benefits sharply on wet recordings from 24 to 48 labels and only modestly on dry recordings."
  activeSlug="calibration-budget"
>
  <section class="topic-section" aria-labelledby="ridge-heading">
    <div class="topic-heading"><div><p class="eyebrow">Target-only spectral ridge</p><h2 id="ridge-heading">Twelve, 24 and 48 labeled trials</h2></div><p>Each target-person model uses only that person's labeled calibration recordings. All conditions are evaluated on the same future blocks 5–10, across 102 people and 7,344 test trials.</p></div>
    <div class="evidence-grid">{sensors.flatMap(sensor => budgets.map(budget => {
      const row = targetRidge(sensor,budget);
      return <article class="evidence-card"><p class="eyebrow">{sensor} · {budget} labels</p><div class="reading">{pct(row.value)}</div><ScoreBar value={row.value} max={0.85} label={`${pct(row.value)} balanced accuracy`} tone={sensor === 'wet' ? 'rust' : 'ink'} /><p>Participant-mean balanced accuracy</p><small>95% interval {intervalPct(row.confidence_interval_95)}</small></article>;
    }))}</div>
    <p class="protocol-note"><strong>Trial counts are not minutes.</strong> The export records 12, 24 or 48 labeled trials per person. It does not convert those trials into a setup-time claim.</p>
  </section>

  <section class="topic-section" aria-labelledby="zero-heading">
    <div class="topic-heading"><div><p class="eyebrow">A separate arm</p><h2 id="zero-heading">Zero target labels is source-only transfer</h2></div><p>The zero-budget spectral-ridge rows use a model trained on other participants from one source sensor. They are not the starting point of an incremental target-person update curve.</p></div>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label="Source-only spectral ridge transfer results, scrolls horizontally">
      <table><caption>Participant-mean balanced accuracy on common future test blocks 5–10 · 0 labeled target trials.</caption><thead><tr><th scope="col">Training source</th><th scope="col">Test on wet</th><th scope="col">Test on dry</th></tr></thead><tbody>{sensors.map(source => <tr><th scope="row">{source} source<small>other participants only</small></th>{sensors.map(target => {
        const row = sourceRidge(source,target);
        return <td><span class="metric">{pct(row.value)}</span><span class="interval">{intervalPct(row.confidence_interval_95)}</span></td>;
      })}</tr>)}</tbody></table>
    </div>
  </section>

  <section class="topic-section" aria-labelledby="trca-heading">
    <div class="topic-heading"><div><p class="eyebrow">Method matters</p><h2 id="trca-heading">Single-band eTRCA responds differently</h2></div><p>The target-only eTRCA arm uses 24 or 48 calibration trials and the same future test blocks. CCA at zero labels is an analytic reference, not an unfitted eTRCA point.</p></div>
    <div class="finding">
      <div class="finding-number"><strong>{pp(wetImprovement.difference, 1)}</strong><span>Wet eTRCA: 48 labels minus 24 labels</span></div>
      <div class="finding-copy"><h3>A larger budget helped wet recordings much more</h3><p>The paired participant interval is {intervalPp(wetImprovement.paired_participant_bootstrap_95, 1)}. Dry eTRCA improved by {pp(dryImprovement.difference, 1)}, interval {intervalPp(dryImprovement.paired_participant_bootstrap_95, 1)}. Neither calibrated point exceeds the analytic CCA reference on the same test blocks.</p></div>
    </div>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label="CCA and ensemble TRCA calibration results, scrolls horizontally">
      <table><caption>Participant-mean balanced accuracy · native 8 channels · 2 s · 12 targets.</caption><thead><tr><th scope="col">Method and labeled target trials</th><th scope="col">Wet</th><th scope="col">Dry</th></tr></thead><tbody>
        <tr><th scope="row">CCA · 0 labels<small>analytic target-recording reference</small></th>{sensors.map(sensor => { const row=methodRow('cca',sensor,0); return <td><span class="metric">{pct(row.value)}</span><span class="interval">{intervalPct(row.confidence_interval_95)}</span></td>; })}</tr>
        {[24,48].map(budget => <tr><th scope="row">{modelLabel('ensemble-trca')} · {budget} labels<small>target-only adaptation</small></th>{sensors.map(sensor => { const row=methodRow('ensemble-trca',sensor,budget); return <td><span class="metric">{pct(row.value)}</span><span class="interval">{intervalPct(row.confidence_interval_95)}</span></td>; })}</tr>)}
      </tbody></table>
    </div>
  </section>

  <section class="topic-section" id="methods-and-limits" aria-labelledby="limits-heading">
    <div class="topic-heading"><div><p class="eyebrow">Methods &amp; limits</p><h2 id="limits-heading">What the budget curves do and do not mean</h2></div><p>All results are tied to a frozen protocol. They describe labeled-trial budgets for these methods, sensors and fixed test blocks.</p></div>
    <div class="method-grid-wide">
      <article><h3>Different zero-label mechanisms</h3><p>Spectral ridge at budget zero is source-only supervised transfer. CCA at budget zero is an analytic target-recording reference. Neither should be connected to target-only points as one model's learning curve.</p></article>
      <article><h3>Target-only means target-only</h3><p>The 12/24/48 ridge and 24/48 eTRCA conditions fit only the target person's calibration recordings, then test on blocks 5–10.</p></article>
      <article><h3>Prespecified single band</h3><p>eTRCA uses the fixed 6–80 Hz prepared band. It is not the reference repository's three-filter-bank experiment, so low scores do not establish an optimized TRCA ceiling.</p></article>
      <article><h3>Descriptive intervals</h3><p>Bootstrap intervals summarize participants under this protocol. They do not add retraining uncertainty or establish general calibration requirements for another headset.</p></article>
    </div>
    {citation && <div class="citation-list"><article><h3>{citation.identity.title}</h3><p>{citation.identity.canonical_dataset_citation}</p><p>{citation.identity.paper_citation}</p><p>Official Tsinghua author mirror snapshot acquired 2026-09-20 · {citation.identity.license}. Aggregate results only.</p><p><a href={citation.primary_sources[0]} target="_blank" rel="noreferrer">Dataset record ↗</a> · <a href={citation.primary_sources[1]} target="_blank" rel="noreferrer">Sensors paper ↗</a></p></article></div>}
    <p class="citation-note">Data source: <a href="/data/deployment-topics.json" download>reviewed aggregate JSON</a> · schema {data.schema_version} · generated {data.generated_at.slice(0,10)}.</p>
  </section>
</TopicLayout>
