---
/**
 * The home page, in reading order since 2026-10-02 (owner-approved restructure):
 * masthead → Questions (the topics in three groups, and a compact map of which
 * kinds of transfer have been measured) → holds → the core matrix → the
 * per-protocol panel → a directory band (methods, datasets, releases, data and
 * API) → principles. The model directory, the public-data register and the
 * external field notes moved to /methods/ and /datasets/, where the rest of
 * their content already was: they were more than half the page's words, and
 * their membership had drifted from the directories they duplicated.
 */
import data from '../../data/mvp.json';
import { corrections, holds, latestRelease, releases } from '../../data/releases';
import { site } from '../../data/site';
import { topicPages } from '../../data/topics';
import { servedFiles } from '../../data/files';
import { homeDataset, websiteEntity } from '../../data/structured';
import { alternates, chrome, familyLabel, home, hrefFor, htmlLang, localeOf, localeParams, localizePath, metricLabel, ogLocale,
         topicsHubCopy, trackTitle, transferMapCopy } from '../../data/i18n';
import SiteHeader from '../../components/SiteHeader.astro';
import AgentLinks from '../../components/AgentLinks.astro';
import ShareImage from '../../components/ShareImage.astro';
import FooterElsewhere from '../../components/FooterElsewhere.astro';
import TopicGroups from '../../components/TopicGroups.astro';
import TransferMap from '../../components/TransferMap.astro';
import FmHomeRow from '../../components/FmHomeRow.astro';
import { datasets as datasetEntities, methods as methodEntities } from '../../data/entities';
import { coreExposure, fmMatrixModels, fmModels, fmTermsSentence, fmProtocols, fmRelease, fmVersionsOf, fmResearchUse, fmRowsByProtocol, fmFileOf, FM_ANCHOR, type FmRow } from '../../data/foundation-models';
import { fmText, fmZh } from '../../data/foundation-models-zh';
import '../../styles/global.css';
import '../../styles/matrix.css';
import '../../styles/generated.css';
import '../../styles/directory.css';

export const getStaticPaths = localeParams;
const locale=localeOf(Astro.params.lang);
const t=chrome[locale];
const h=home[locale];
// Release prose (protocol steps, limitations, notes, attributions) stays in
// English on every locale; on the Chinese page those elements say so in `lang`,
// which is what switches a screen reader's voice and a browser's hyphenation.
const payloadLang=locale==='en'?undefined:'en';
const tt=(title:string)=>trackTitle(title,locale);
const ml=(label:string)=>metricLabel(label,locale);

const tracks=data.tracks;
const track=tracks[0];
const origin=Astro.site ?? site.origin;
const canonical=new URL(localizePath('/',locale),origin).href;
// A matrix row head links to its method's page where one exists.
const methodPage=(name:string)=>{const m=methodEntities.find(x=>x.name===name||(x.slug==='cca'&&name==='Standard CCA'));return m?hrefFor(`/methods/${m.slug}/`,locale):null;};
const title=`${site.name} · ${h.title}`;
const description=locale==='en'?site.description:h.description;
const chanceOf=(t:typeof tracks[number])=>(t as {chanceLevel?:number|null}).chanceLevel ?? null;

// The same caveats workbench.ts attaches on re-render, applied to the first
// paint so the static HTML — what a crawler and a no-JS reader get — carries
// them too. Kept in step with seedFlag()/chanceFlag() in the script.
const chance=chanceOf(track);
const seed=(track as {seedSensitivity?:{model:string;balancedAccuracyPercent:number[];meanPercent:number}}).seedSensitivity;
const chanceNote=(r:{y:number;interval?:number[]|null})=>{
  if(chance===null) return null;
  if(r.y<=chance) return h.atOrBelow(chance);
  if(r.interval&&r.interval[0]<=chance) return h.intervalReaches(chance);
  return null;
};
const seedNote=(name:string)=>{
  if(!seed||seed.model!==name) return null;
  const v=seed.balancedAccuracyPercent,hi=Math.max(...v),lo=Math.min(...v);
  const word=v[0]>=hi?'highest':v[0]<=lo?'lowest':'middle';
  return h.singleSeed(h.seedWord[word],v.length,lo.toFixed(2),hi.toFixed(2),seed.meanPercent.toFixed(2));
};

// Open holds, from the same register the releases page prints in full. The
// cards used to be written out here by hand; a second copy is a copy to drift.
// Each card is a link: to the page that explains the hold where there is one,
// otherwise to its row in the register.
const openHolds = holds.filter(x => !x.closed);
const holdHref = (x: typeof holds[number]) => hrefFor(x.href ?? `/releases/#hold-${x.id}`, locale);
const holdDate = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  return locale === 'zh' ? `${y} 年 ${m} 月 ${d} 日`
    : `${d} ${['January','February','March','April','May','June','July','August','September','October','November','December'][m - 1]} ${y}`;
};

// --- Coverage matrix -------------------------------------------------------
// Built here rather than in the client script: it must exist in the served HTML
// with no JavaScript, and it never changes in response to a control.
const methods=new Map<string,{family:string;scores:Map<string,number>}>();
for(const t of tracks) for(const r of t.rows){
  const entry=methods.get(r.name) ?? {family:r.family,scores:new Map<string,number>()};
  entry.scores.set(t.id,r.y);
  methods.set(r.name,entry);
}
// Highest score within a column, marked per protocol only. The idle track is
// excluded on purpose: its headline number is command detection, and detection
// without its false-activation rate is exactly the reading this site argues
// against — always abstaining scores zero false activations.
const leader=new Map<string,string>();
for(const t of tracks){
  if(t.type==='tradeoff') continue;
  const best=t.rows.reduce((a,b)=>b.y>a.y?b:a);
  leader.set(t.id,best.name);
}
const matrixRows=[...methods.entries()]
  .map(([name,m])=>({name,family:m.family,scores:m.scores,covered:m.scores.size}))
  .sort((a,b)=>b.covered-a.covered || a.name.localeCompare(b.name));
// Where the score sits between this task's own chance level and 100%. Scaling
// each column by its own chance is what makes a 33.7% on a 40-class task and a
// 62.9% on a 2-class task legible at all; it is also why the bars carry no
// meaning sideways, which the caption states.
const fill=(t:typeof tracks[number],y:number)=>{
  const c=chanceOf(t) ?? 0;
  return Math.max(0,Math.min(100,(y-c)/(100-c)*100));
};
const datasetCount=new Set(tracks.map(t=>t.dataset)).size;
const counts={methods:matrixRows.length,protocols:data.coverage.displayedProtocols,datasets:datasetCount,
              comparisons:data.coverage.displayedComparisons,added:fmMatrixModels.length,
              // The date the v9 encoders were added, from their release, as the page writes dates.
              addedOn:holdDate(fmRelease.date),
              // The models the matrix checkpoints belong to (REVE Base and Large count apart, as the release does), and the masking ablation's siblings.
              addedModels:new Set(fmMatrixModels.map(m=>m.exposureKey)).size,addedAblation:fmModels.length-fmMatrixModels.length};
// A matrix encoder not run on every protocol is named with how many it ran on (BrainOmni Base: six of eight).
const fmPartly=fmMatrixModels.map(m=>({m,ran:fmProtocols.filter(p=>fmRowsByProtocol[p.id].find(r=>r.model.id===m.id)!.status==='complete').length}))
  .filter(x=>x.ran<fmProtocols.length)
  .map(x=>locale==='zh'?`${x.m.name} 只在其中 ${x.ran} 个上运行`:`${x.m.name} on ${['zero','one','two','three','four','five','six','seven'][x.ran]} of them`).join(locale==='zh'?'；':'; ');

// --- The v9 rows (2026-10-04) ------------------------------------------------
// Embedded for workbench.ts as JSON (#fm-rows), read from the served per-protocol
// CSVs (foundation-models.ts) with the prose in this page's language. The first
// protocol's rows are also printed here, so the static HTML carries them as the
// script renders them (kept in step with fmRowHtml() in workbench.ts).
const say=(en:string)=>fmText(en,locale);
// Values at the precision the table prints them (the CSV's percent to one decimal, macro
// F1 to three), so the page carries no digits it does not show; the chance flag is the
// protocol page's, computed from the full values (foundation-models.ts).
const at=(v:number|undefined,d:number)=>v===undefined?null:Number(v.toFixed(d));
const fmJsonRow=(r:FmRow)=>({id:r.model.id,name:r.model.name,panel:r.model.panel,href:hrefFor(`/methods/${r.model.slug}/`,locale),mode:r.mode,
  channels:r.channels.raw,subjects:r.people?.raw??null,y:at(r.primary?.raw,1),interval:r.interval?[at(r.interval[0].raw,1)!,at(r.interval[1].raw,1)!]:null,
  x:at(r.secondary?.raw,r.protocol==='idle'?1:3),chanceFlag:r.chanceFlag,status:r.status,reason:r.reason?say(r.reason).text:null,reasonOriginal:r.reason?say(r.reason).original??null:null,
  exposure:r.exposure.status,exposureText:locale==='en'?r.exposure.statement:fmZh[r.exposure.statement],exposureSource:r.exposure.urls[0]??null,
  footnote:say(r.model.footnote).text,footnoteOriginal:say(r.model.footnote).original??null,
  // The notes in the page's language, the English beside them on the Chinese page; REVE's licence asks for its version (review of 2026-10-05).
  notes:locale==='en'?r.notes:r.noteParts.map(n=>say(n).text).join(''),notesOriginal:locale==='en'||!r.notes?null:r.notes,version:fmVersionsOf([r.model])??null,
  licence:say(r.model.licenceNote).text,licenceOriginal:say(r.model.licenceNote).original??null,researchUse:fmResearchUse(r.model),
  idle:r.idle?{detected:r.idle.detected.raw,commandTrials:r.idle.commandTrials.raw,falseActivations:r.idle.falseActivations.raw,idleTrials:r.idle.idleTrials.raw,
               abstain:r.idle.abstain.raw}:null});
const core=coreExposure('labram');
const fmPayload={release:fmRelease.id,date:fmRelease.date,tracks:Object.fromEntries(tracks.map(t=>[t.id,{
  file:fmFileOf(t.id),protocolHref:hrefFor(`/protocols/${t.id}/`,locale),rows:fmRowsByProtocol[t.id].map(fmJsonRow),
  coreExposure:{text:locale==='en'?core.statement:fmZh[core.statement],urls:[...new Set([...coreExposure('labram').urls,...coreExposure('cbramod').urls])]}}]))};
// "</" cannot close the data block: every "<" is escaped.
const fmJson=JSON.stringify(fmPayload).replace(/</g,'\\u003c');
const fm0=fmPayload.tracks[track.id];
const fmMatrix0=fm0.rows.filter(r=>r.panel==='matrix').sort((a,b)=>a.name.localeCompare(b.name));
const fmAblation0=[...fm0.rows.filter(r=>r.panel==='matrix'&&r.id.startsWith('eeg-fm-masking/')).sort((a,b)=>a.name.localeCompare(b.name)),
                   ...fm0.rows.filter(r=>r.panel!=='matrix').sort((a,b)=>a.name.localeCompare(b.name))];
const fmChance=(r:{chanceFlag:string|null})=>chance===null||!r.chanceFlag?null:r.chanceFlag==='at-or-below'?h.atOrBelow(chance):h.intervalReaches(chance);
const stats=[
  [h.stats.protocols,counts.protocols],
  [h.stats.datasets,counts.datasets],
  [h.stats.comparisons,counts.comparisons],
  [h.stats.methods,counts.methods],
] as const;
// The core matrix is one snapshot; its date moved from the eyebrow to its own heading.
const snapshot=data.generatedAt.slice(0,10);

// Whole-site counts, each from the module that builds those pages, never summed:
// check-workbench.mjs counts the built pages and files and compares.
const siteCounts={questions:topicPages.length,datasets:datasetEntities.length,methods:methodEntities.length,
                  releases:releases.length,files:new Set(servedFiles.map(f=>f.file)).size};
const directory=[
  {key:'methods',href:hrefFor('/methods/',locale),n:siteCounts.methods,...h.directory.methods},
  {key:'datasets',href:hrefFor('/datasets/',locale),n:siteCounts.datasets,...h.directory.datasets},
  {key:'releases',href:hrefFor('/releases/',locale),n:siteCounts.releases,...h.directory.releases},
  {key:'files',href:hrefFor('/api/',locale),n:siteCounts.files,...h.directory.api},
];
const links=alternates('/',String(origin));
const oldAnchor:Record<string,string|undefined>={methods:'models',datasets:'datasets'};
---
<!doctype html>
<html lang={htmlLang[locale]}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#b3450e"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="icon" href="/favicon.ico" sizes="32x32"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="canonical" href={canonical}/><AgentLinks href={localizePath('/', locale)}/>{links.map(l=><link rel="alternate" hreflang={l.hreflang} href={l.href}/>)}<title>{title}</title>
<meta property="og:type" content="website"/><meta property="og:site_name" content={site.name}/><meta property="og:locale" content={ogLocale[locale]}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><ShareImage locale={locale}/>
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/>
{locale==='en'&&<script type="application/ld+json" set:html={JSON.stringify(homeDataset())}/>}
{locale==='en'&&<script type="application/ld+json" set:html={JSON.stringify(websiteEntity())}/>}</head>
<body><a class="skip" href="#overview">{t.skipToResults}</a>
<SiteHeader locale={locale} path="/" active="home" anchorsAreLocal={true}/>
<main><section class="masthead"><div><p class="eyebrow">{h.eyebrow} <time datetime={latestRelease.date}>{latestRelease.date}</time></p><h1>{h.h1}</h1><p class="lede">{h.lede(counts)}</p></div>
<div class="stat-block"><p class="stat-caption" id="stat-caption">{h.statsCaption}</p><dl class="stat-rail" aria-labelledby="stat-caption">{stats.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
<p class="stat-added"><a href={hrefFor('/protocols/',locale)}>{h.statsAdded[0]}<span data-count="encoders">{counts.added}</span>{h.statsAdded[1]}</a></p>
<p class="site-counts">{h.siteCountsLead} <a href={hrefFor('/topics/',locale)}><span data-count="questions">{siteCounts.questions}</span> {h.siteCounts.questions}</a> · <a href={hrefFor('/datasets/',locale)}><span data-count="datasets">{siteCounts.datasets}</span> {h.siteCounts.datasets}</a> · <a href={hrefFor('/methods/',locale)}><span data-count="methods">{siteCounts.methods}</span> {h.siteCounts.methods}</a></p></div></section>

<section id="topics" class="topic-entry"><div class="section-heading"><div><p class="eyebrow">{h.topicsEyebrow}</p><h2>{h.topicsH2}</h2></div><p>{h.topicsLede}</p></div>
<TopicGroups locale={locale} level={3} readLabel={h.readEvidence}/>
<div class="topic-map" id="transfer-map"><div class="topic-group-head"><h3>{topicsHubCopy[locale].mapH2}</h3></div>
<TransferMap locale={locale}/>
<p class="topic-map-more"><a href={hrefFor('/topics/#transfer',locale)}>{transferMapCopy[locale].fullMap}</a></p></div></section>

<section id="holds" class="holds"><div class="section-heading"><div><p class="eyebrow">{h.holdsEyebrow}</p><h2>{h.holdsH2}</h2></div><p>{h.holdsLede}</p></div>
<div class="hold-grid">{openHolds.map(x=><a class="hold-card" href={holdHref(x)}><p class="state">{x.state[locale]}</p><h3>{x.item[locale]}</h3><p>{x.outcome[locale]}</p><small><time datetime={x.opened}>{h.holdsSince(holdDate(x.opened))}</time></small></a>)}</div>
<p class="holds-more"><a href={hrefFor('/releases/#holds',locale)}>{h.holdsRegister}</a><a href={hrefFor('/releases/#corrections',locale)}>{h.correctionsLink(corrections.length)}</a></p></section>

<section id="overview" class="overview"><div class="section-heading"><div><p class="eyebrow">{h.matrixEyebrow}</p><h2>{h.matrixH2(counts)}<span class="snapshot"> · {h.snapshot} <time datetime={snapshot}>{snapshot}</time></span></h2></div><p>{h.matrixLede}</p></div>
<div class="matrix-frame"><div class="scroll" tabindex="0" role="region" aria-label={h.matrixRegion}><table class="matrix"><caption class="visually-hidden">{h.matrixCaption}</caption><thead><tr><th class="corner" scope="col">{h.corner}</th>{tracks.map(t=><th class="colhead" scope="col"><a href={hrefFor(`/protocols/${t.id}/`,locale)} data-jump={t.id}>{tt(t.title)}</a><small>n={t.subjects} · {chanceOf(t)===null?h.colDetection:h.colChance(chanceOf(t)!)}</small></th>)}</tr></thead>
<tbody>{matrixRows.map(m=><tr data-family={m.family}><th class="rowhead" scope="row">{methodPage(m.name)?<a class="mname" href={methodPage(m.name)!}>{m.name}</a>:<span class="mname">{m.name}</span>}<small>{familyLabel(m.family,locale)} · {h.covered(m.covered,tracks.length)}</small></th>{tracks.map(t=>{
  const y=m.scores.get(t.id);
  if(y===undefined) return <td class="cell none"><span class="num" title={h.notEvaluated(m.name,tt(t.title))}>·</span><span class="visually-hidden">{h.keyGap}</span></td>;
  const c=chanceOf(t);
  const below=c!==null&&y<=c;
  return <td class="cell" data-rank={leader.get(t.id)===m.name?'lead':below?'sub':null} title={`${m.name} · ${tt(t.title)}${h.colon}${y.toFixed(1)}% ${ml(t.yLabel).toLowerCase()}`}><span class="track"><span class={`bar w${Math.round(fill(t,y))}`}></span></span><span class="num">{y.toFixed(1)}</span>{below&&<span class="cmark">{h.atChance}</span>}</td>;
})}</tr>)}</tbody></table></div>
<p class="matrix-note"><span class="key"><i class="lead"></i>{h.keyLead}</span><span class="key"><i class="plain"></i>{h.keyBar}</span><span class="key"><i class="gap"></i>{h.keyGap}</span><a href="/data/experiments.json" download>{h.matrixDownload}</a></p></div>
<p class="matrix-caveat" set:html={h.matrixCaveat}></p>
<p class="matrix-added" data-release={fmRelease.id}>{h.matrixAdded(counts.added,fmRelease.date,fmPartly,counts.addedModels,counts.addedAblation)} <a href={`${fm0.protocolHref}#${FM_ANCHOR}`}>{h.matrixAddedLink}</a></p></section>

<section id="benchmarks" class="section"><div class="section-heading"><div><p class="eyebrow">{h.protocolsEyebrow}</p><h2>{h.protocolsH2}</h2></div></div>
{h.payloadNote&&<p class="payload-note">{h.payloadNote}</p>}
<div class="track-tabs" id="track-tabs" role="tablist" aria-label={h.tabsLabel} data-active={track.id}>{tracks.map(t=><button class="track-tab" type="button" role="tab" id={'tab-'+t.id} aria-controls="track-panel" data-track={t.id} aria-selected={t.id===track.id?'true':'false'} tabindex={t.id===track.id?0:-1}><strong>{tt(t.title)}</strong><small>{t.dataset} · {h.tabParticipants(t.subjects)}</small></button>)}</div>
<div id="track-panel" role="tabpanel" aria-labelledby={'tab-'+track.id}><div class="context"><div><h2 id="track-title" lang={payloadLang}>{track.subtitle}</h2><p id="track-meta">{track.dataset} · {track.subjects} {h.subjects} · <span lang={payloadLang}>{track.observations} · {track.exposure}</span></p></div><button class="button" id="open-protocol">{h.viewProtocol}</button></div>
<div class="results-panel"><div class="table-panel"><div class="toolbar"><div><p class="eyebrow">{h.measuredHere}</p><h3>{h.atAGlance}</h3></div><div class="controls"><label>{h.familyControl}<select id="family-filter"><option value="all">{h.allFamilies}</option><option value="foundation">{familyLabel('foundation',locale)}</option><option value="small">{familyLabel('small',locale)}</option><option value="classical">{familyLabel('classical',locale)}</option></select></label><label>{h.sortControl}<select id="sort-results"><option value="name">{h.sortName}</option><option value="y-desc">{h.sortPrimary}</option><option id="secondary-sort" value="x-asc">{h.sortSecondary}</option></select></label><a id="download-results" class="button" href={'/data/'+track.id+'-results.csv'} download>{h.csv}</a></div></div>
<div class="scroll" tabindex="0" role="region" aria-label={h.tableRegion}><table><thead><tr><th>{h.colModel}</th><th id="metric-y-heading">{ml(track.yLabel)}</th><th id="metric-x-heading">{ml(track.xLabel)}</th><th>{h.colCompute}</th></tr></thead><tbody id="result-rows">{track.rows.map(r=><tr><td><button class="model-name" data-model={r.id}>{r.name} ↗</button><small lang={payloadLang}>{r.mode} · {r.channels} ch</small></td><td><strong>{r.y.toFixed(1)}%</strong><small lang={payloadLang}>{r.yDetail}</small>{chanceNote(r)&&<span class="flag">{chanceNote(r)}</span>}{seedNote(r.name)&&<span class="flag seed">{seedNote(r.name)}</span>}</td><td><strong>{track.type==='tradeoff'?r.x.toFixed(1)+'%':r.x.toFixed(3)}</strong><small lang={payloadLang}>{r.xDetail}</small></td><td>{r.seconds.toFixed(1)}s</td></tr>)}{fmMatrix0.length>0&&<tr class="fm-group"><th colspan="4" scope="colgroup"><span class="fm-group-label">{h.fmGroup(fmMatrix0.length,fmPayload.date,fmMatrix0.filter(r=>r.status!=='complete').length)} <a href={`${fm0.protocolHref}#${FM_ANCHOR}`}>{h.fmGroupLink}</a></span></th></tr>}{fmMatrix0.map(r=><FmHomeRow r={r} h={h} payloadLang={payloadLang} chance={fmChance(r)} tradeoff={track.type==='tradeoff'}/>)}</tbody></table></div><p class="scroll-hint" id="scroll-hint">{h.scrollHint}</p>
<p class="fm-download"><a id="download-fm" href={'/data/'+fm0.file} download>{h.fmCsv}</a></p>
<p class="fm-terms-home" id="fm-terms">{fmTermsSentence(fmModels,locale)} <a id="fm-terms-link" href={`${fm0.protocolHref}#v9-licences`}>{h.fmTermsLink}</a></p>
<details class="fm-ablation-home" id="ablation-panel"><summary>{h.fmAblation}</summary><p>{h.fmAblationLede}</p><div class="scroll" tabindex="0" role="region" aria-label={h.fmAblation}><table><tbody id="ablation-rows">{fmAblation0.map(r=><FmHomeRow r={r} h={h} payloadLang={payloadLang} chance={fmChance(r)} tradeoff={track.type==='tradeoff'} reference={r.panel==='matrix'}/>)}</tbody></table></div></details>
<p class="caption">{h.tableCaption}</p></div>
<aside><p class="eyebrow">{h.visualEyebrow}</p><h3 id="chart-title">{h.chartTitle}</h3><div id="result-chart" class="chart"></div><ol id="chart-legend" class="legend"></ol><p id="chart-note"></p></aside></div>
<div class="source-strip"><span id="track-rights"><span lang={payloadLang}>{track.license}</span> · {h.rights}</span><a id="track-source" href={track.source} target="_blank" rel="noreferrer">{h.originalDataset}</a><a href="/data-use/">{h.usePrivacy}</a><a href="/data-use/#corrections">{h.reportResult}</a></div><div class="evidence"><strong>{h.readWithCare}</strong><p id="track-limitation" lang={payloadLang}>{track.limitation}</p><a href="#methods">{h.methodsLink}</a></div></div></section>

<section id="directory" class="section directory-band"><div class="section-heading"><div><p class="eyebrow">{h.directoryEyebrow}</p><h2>{h.directoryH2}</h2></div></div>
{/* The old home anchors (#models, #datasets, #news) land on the card that now leads to that content. */}
<div class="directory-grid">{directory.map(d=><a class="directory-card" id={oldAnchor[d.key]} href={d.href}>{d.key==='methods'&&<span id="news"></span>}<span class="family">{d.title}</span><strong class="directory-count"><span data-count={d.key}>{d.n}</span> {d.count}</strong><p>{d.body}</p></a>)}</div></section>

<section id="methods" class="section methods"><div><p class="eyebrow">{h.methodsEyebrow}</p><h2>{h.methodsH2}</h2>{h.evidencePolicyLocal?<><p>{h.evidencePolicyLocal}</p><p class="note-original" lang="en">{data.evidencePolicy}</p></>:<p lang={payloadLang}>{data.evidencePolicy}</p>}<a class="button" href="/data/experiments.json" download>{h.downloadAll}</a></div><div class="method-grid">{h.principles.map(([title,body],i)=><article><span>0{i+1}</span><h3>{title}</h3><p>{body}</p></article>)}</div></section>
</main><footer><a class="brand" href={hrefFor('/',locale)}>{site.name}</a><p>{t.footerTagline}</p><a href="/data-use/#corrections">{t.footerReport}{t.englishMark}</a><a href={hrefFor('/releases/',locale)}>{t.footerReleases}</a><a href="/data-use/">{t.footerDataUse}{t.englishMark}</a><a href="#overview">{t.footerBack}</a><FooterElsewhere locale={locale}/></footer>
<dialog id="detail-dialog" aria-labelledby="dialog-title"><div class="dialog-top"><p class="eyebrow">{h.dialogEyebrow}</p><button id="close-dialog" aria-label={h.closeDialog}>×</button></div><h2 id="dialog-title"></h2><div id="dialog-body"></div></dialog>
<script type="application/json" id="fm-rows" is:inline set:html={fmJson}></script>
<script>import '../../scripts/workbench';</script>
</body></html>
