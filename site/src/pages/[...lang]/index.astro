---
import data from '../../data/mvp.json';
import deployment from '../../data/deployment-topics.json';
import { site } from '../../data/site';
import { topicPages } from '../../data/topics';
import { homeDataset, websiteEntity } from '../../data/structured';
import { alternates, chrome, datasetStatus, datasetTask, familyLabel, home, hrefFor, htmlLang, localeOf,
         localeParams, localizePath, metricLabel, modelStatus, ogLocale, topicCards, trackTitle } from '../../data/i18n';
import SiteHeader from '../../components/SiteHeader.astro';
import '../../styles/global.css';
import '../../styles/matrix.css';
import '../../styles/generated.css';
import '../../styles/directory.css';

export const getStaticPaths = localeParams;
const locale=localeOf(Astro.params.lang);
const t=chrome[locale];
const h=home[locale];
// Release prose (protocol steps, limitations, notes, attributions) stays in
// English on every locale; on the Chinese page those elements say so in `lang`,
// which is what switches a screen reader's voice and a browser's hyphenation.
const payloadLang=locale==='en'?undefined:'en';
const tt=(title:string)=>trackTitle(title,locale);
const ml=(label:string)=>metricLabel(label,locale);

const tracks=data.tracks;
const track=tracks[0];
const origin=Astro.site ?? site.origin;
const canonical=new URL(localizePath('/',locale),origin).href;
const ogImage=new URL('/og.png',origin).href;
const title=`${site.name} · ${h.title}`;
const description=locale==='en'?site.description:h.description;
const chanceOf=(t:typeof tracks[number])=>(t as {chanceLevel?:number|null}).chanceLevel ?? null;

// The same caveats workbench.ts attaches on re-render, applied to the first
// paint so the static HTML — what a crawler and a no-JS reader get — carries
// them too. Kept in step with seedFlag()/chanceFlag() in the script.
const chance=chanceOf(track);
const seed=(track as {seedSensitivity?:{model:string;balancedAccuracyPercent:number[];meanPercent:number}}).seedSensitivity;
const chanceNote=(r:{y:number;interval?:number[]|null})=>{
  if(chance===null) return null;
  if(r.y<=chance) return h.atOrBelow(chance);
  if(r.interval&&r.interval[0]<=chance) return h.intervalReaches(chance);
  return null;
};
const seedNote=(name:string)=>{
  if(!seed||seed.model!==name) return null;
  const v=seed.balancedAccuracyPercent,hi=Math.max(...v),lo=Math.min(...v);
  const word=v[0]>=hi?'highest':v[0]<=lo?'lowest':'middle';
  return h.singleSeed(h.seedWord[word],v.length,lo.toFixed(2),hi.toFixed(2),seed.meanPercent.toFixed(2));
};

// --- Coverage matrix -------------------------------------------------------
// Built here rather than in the client script: it is the page's opening screen,
// so it must exist in the served HTML with no JavaScript, and it never changes
// in response to a control.
const methods=new Map<string,{family:string;scores:Map<string,number>}>();
for(const t of tracks) for(const r of t.rows){
  const entry=methods.get(r.name) ?? {family:r.family,scores:new Map<string,number>()};
  entry.scores.set(t.id,r.y);
  methods.set(r.name,entry);
}
// Highest score within a column, marked per protocol only. The idle track is
// excluded on purpose: its headline number is command detection, and detection
// without its false-activation rate is exactly the reading this site argues
// against — always abstaining scores zero false activations.
const leader=new Map<string,string>();
for(const t of tracks){
  if(t.type==='tradeoff') continue;
  const best=t.rows.reduce((a,b)=>b.y>a.y?b:a);
  leader.set(t.id,best.name);
}
const matrixRows=[...methods.entries()]
  .map(([name,m])=>({name,family:m.family,scores:m.scores,covered:m.scores.size}))
  .sort((a,b)=>b.covered-a.covered || a.name.localeCompare(b.name));
// Where the score sits between this task's own chance level and 100%. Scaling
// each column by its own chance is what makes a 33.7% on a 40-class task and a
// 62.9% on a 2-class task legible at all; it is also why the bars carry no
// meaning sideways, which the caption states.
const fill=(t:typeof tracks[number],y:number)=>{
  const c=chanceOf(t) ?? 0;
  return Math.max(0,Math.min(100,(y-c)/(100-c)*100));
};
const datasetCount=new Set(tracks.map(t=>t.dataset)).size;
const counts={methods:matrixRows.length,protocols:data.coverage.displayedProtocols,datasets:datasetCount,
              comparisons:data.coverage.displayedComparisons,topicRows:deployment.rows.length};
const stats=[
  [h.stats.protocols,counts.protocols],
  [h.stats.datasets,counts.datasets],
  [h.stats.comparisons,counts.comparisons],
  [h.stats.methods,counts.methods],
] as const;
const links=alternates('/',String(origin));
---
<!doctype html>
<html lang={htmlLang[locale]}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#b3450e"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="icon" href="/favicon.ico" sizes="32x32"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="canonical" href={canonical}/>{links.map(l=><link rel="alternate" hreflang={l.hreflang} href={l.href}/>)}<title>{title}</title>
<meta property="og:type" content="website"/><meta property="og:site_name" content={site.name}/><meta property="og:locale" content={ogLocale[locale]}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={ogImage}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content={`${site.name} — ${h.ogAlt(counts)}`}/>
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogImage}/>
{locale==='en'&&<script type="application/ld+json" set:html={JSON.stringify(homeDataset())}/>}
{locale==='en'&&<script type="application/ld+json" set:html={JSON.stringify(websiteEntity())}/>}</head>
<body><a class="skip" href="#overview">{t.skipToResults}</a>
<SiteHeader locale={locale} path="/" active="home" anchorsAreLocal={true}/>
<main><section class="masthead"><div><p class="eyebrow">{h.eyebrow(data.generatedAt.slice(0,10))}</p><h1>{h.h1}</h1><p class="lede">{h.lede(counts)}</p></div><dl class="stat-rail" aria-label={h.statsLabel}>{stats.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}<span class="live"><i></i>{t.stage}</span></dl></section>

<section id="topics" class="topic-entry"><div class="section-heading"><div><p class="eyebrow">{h.topicsEyebrow}</p><h2>{h.topicsH2}</h2></div><p>{h.topicsLede(deployment.rows.length)}</p></div>
<div class="topic-entry-grid">{topicPages.map((topic,index)=>{const card=topicCards[locale][topic.slug];return <a class="topic-entry-card" href={hrefFor(`/topics/${topic.slug}/`,locale)}><span class="topic-number">0{index+1}</span><span class="family">{card.kicker}</span><h3>{card.title}</h3><p>{card.summary}</p><small>{card.detail}</small><strong>{h.readEvidence}</strong></a>;})}</div>
<div class="topic-entry-download"><p>{h.topicsDownloadNote}</p><a class="button" href="/data/deployment-topics.json" download>{h.topicsDownload}</a><a class="button" href="/data/evidence-update.json" download>{h.evidenceDownload}</a></div></section>

<section id="overview" class="overview"><div class="section-heading"><div><p class="eyebrow">{h.matrixEyebrow}</p><h2>{h.matrixH2(counts)}</h2></div><p>{h.matrixLede}</p></div>
<div class="matrix-frame"><div class="scroll" tabindex="0" role="region" aria-label={h.matrixRegion}><table class="matrix"><caption class="visually-hidden">{h.matrixCaption}</caption><thead><tr><th class="corner" scope="col">{h.corner}</th>{tracks.map(t=><th class="colhead" scope="col"><a href="#benchmarks" data-jump={t.id}>{tt(t.title)}</a><small>n={t.subjects} · {chanceOf(t)===null?h.colDetection:h.colChance(chanceOf(t)!)}</small></th>)}</tr></thead>
<tbody>{matrixRows.map(m=><tr data-family={m.family}><th class="rowhead" scope="row"><span class="mname">{m.name}</span><small>{familyLabel(m.family,locale)} · {h.covered(m.covered,tracks.length)}</small></th>{tracks.map(t=>{
  const y=m.scores.get(t.id);
  if(y===undefined) return <td class="cell none"><span class="num" title={h.notEvaluated(m.name,tt(t.title))}>·</span></td>;
  const c=chanceOf(t);
  const below=c!==null&&y<=c;
  return <td class="cell" data-rank={leader.get(t.id)===m.name?'lead':below?'sub':null} title={`${m.name} · ${tt(t.title)}${h.colon}${y.toFixed(1)}% ${ml(t.yLabel).toLowerCase()}`}><span class="track"><span class={`bar w${Math.round(fill(t,y))}`}></span></span><span class="num">{y.toFixed(1)}</span>{below&&<span class="cmark">{h.atChance}</span>}</td>;
})}</tr>)}</tbody></table></div>
<p class="matrix-note"><span class="key"><i class="lead"></i>{h.keyLead}</span><span class="key"><i class="plain"></i>{h.keyBar}</span><span class="key"><i class="gap"></i>{h.keyGap}</span><a href="/data/experiments.json" download>{h.matrixDownload}</a></p></div>
<p class="matrix-caveat" set:html={h.matrixCaveat}></p></section>

<section id="benchmarks" class="section"><div class="section-heading"><div><p class="eyebrow">{h.protocolsEyebrow}</p><h2>{h.protocolsH2}</h2></div><p>{h.protocolsLede}</p></div>
{h.payloadNote&&<p class="payload-note">{h.payloadNote}</p>}
<div class="track-tabs" id="track-tabs" role="tablist" aria-label={h.tabsLabel} data-active={track.id}>{tracks.map(t=><button class="track-tab" type="button" role="tab" id={'tab-'+t.id} aria-controls="track-panel" data-track={t.id} aria-selected={t.id===track.id?'true':'false'} tabindex={t.id===track.id?0:-1}><strong>{tt(t.title)}</strong><small>{t.dataset} · {h.tabParticipants(t.subjects)}</small></button>)}</div>
<div id="track-panel" role="tabpanel" aria-labelledby={'tab-'+track.id} aria-label={h.panelResults(tt(track.title))}><div class="context"><div><h2 id="track-title" lang={payloadLang}>{track.subtitle}</h2><p id="track-meta">{track.dataset} · {track.subjects} {h.subjects} · <span lang={payloadLang}>{track.observations}</span></p></div><button class="button" id="open-protocol">{h.viewProtocol}</button></div>
<div class="results-panel"><div class="table-panel"><div class="toolbar"><div><p class="eyebrow">{h.measuredHere}</p><h3>{h.atAGlance}</h3></div><div class="controls"><label>{h.familyControl}<select id="family-filter"><option value="all">{h.allFamilies}</option><option value="foundation">{familyLabel('foundation',locale)}</option><option value="small">{familyLabel('small',locale)}</option><option value="classical">{familyLabel('classical',locale)}</option></select></label><label>{h.sortControl}<select id="sort-results"><option value="name">{h.sortName}</option><option value="y-desc">{h.sortPrimary}</option><option id="secondary-sort" value="x-asc">{h.sortSecondary}</option></select></label><a id="download-results" class="button" href={'/data/'+track.id+'-results.csv'} download>{h.csv}</a></div></div>
<div class="scroll" tabindex="0" role="region" aria-label={h.tableRegion}><table><thead><tr><th>{h.colModel}</th><th id="metric-y-heading">{ml(track.yLabel)}</th><th id="metric-x-heading">{ml(track.xLabel)}</th><th>{h.colCompute}</th></tr></thead><tbody id="result-rows">{track.rows.map(r=><tr><td><button class="model-name" data-model={r.id}>{r.name} ↗</button><small lang={payloadLang}>{r.mode} · {r.channels} ch</small></td><td><strong>{r.y.toFixed(1)}%</strong><small lang={payloadLang}>{r.yDetail}</small>{chanceNote(r)&&<span class="flag">{chanceNote(r)}</span>}{seedNote(r.name)&&<span class="flag seed">{seedNote(r.name)}</span>}</td><td><strong>{track.type==='tradeoff'?r.x.toFixed(1)+'%':r.x.toFixed(3)}</strong><small lang={payloadLang}>{r.xDetail}</small></td><td>{r.seconds.toFixed(1)}s</td></tr>)}</tbody></table></div><p class="scroll-hint" id="scroll-hint">{h.scrollHint}</p><p class="caption">{h.tableCaption}</p></div>
<aside><p class="eyebrow">{h.visualEyebrow}</p><h3 id="chart-title">{h.chartTitle}</h3><div id="result-chart" class="chart"></div><div id="chart-legend" class="legend"></div><p id="chart-note">{h.chartNote}</p></aside></div>
<div class="source-strip"><span id="track-rights">{track.license} · {h.rights}</span><a id="track-source" href={track.source} target="_blank" rel="noreferrer">{h.originalDataset}</a><a href="/data-use/">{h.usePrivacy}</a><a href="/data-use/#corrections">{h.reportResult}</a></div><div class="evidence"><strong>{h.readWithCare}</strong><p id="track-limitation" lang={payloadLang}>{track.limitation}</p><a href="#methods">{h.methodsLink}</a></div></div></section>
<section id="models" class="section"><div class="section-heading"><div><p class="eyebrow">{h.modelsEyebrow}</p><h2>{h.modelsH2}</h2></div><p>{h.modelsLede}</p></div><div class="model-grid">{data.models.map(m=><article class="model-card"><div class="card-top"><span class="family">{familyLabel(m.family,locale)}</span><span class:list={['status',{'ready':m.status==='Evaluated'}]}>{modelStatus(m.status,locale)}</span></div><h3>{m.name}</h3><p class="parameter">{m.parameters ? (m.parameters/1e6>=1?(m.parameters/1e6).toFixed(2)+'M':(m.parameters/1e3).toFixed(1)+'K'):'—'} <span>{h.parameters}</span></p><p lang={payloadLang}>{m.note}</p><div class="card-footer"><span>{m.license}</span><a href={m.url || 'https://braindecode.org/'} target="_blank" rel="noreferrer">{h.officialSource}</a></div></article>)}</div></section>
<section id="datasets" class="section"><div class="section-heading"><div><p class="eyebrow">{h.datasetsEyebrow}</p><h2>{h.datasetsH2}</h2></div><p>{h.datasetsLede}</p></div><div class="dataset-list">{data.datasets.map(d=><article class="dataset-row"><div><span class="family">{datasetTask(d.task,locale)}</span><h3><a href={d.source} target="_blank" rel="noreferrer">{d.name} ↗</a></h3><p lang={payloadLang}>{d.detail}</p></div><dl><div><dt>{h.dtSubjects}</dt><dd>{d.subjects}</dd></div><div><dt>{h.dtChannels}</dt><dd>{d.channels}</dd></div></dl><div class="dataset-status"><span class="status">{datasetStatus(d.status,locale)}</span><small>{d.licenseUrl?<a href={d.licenseUrl} target="_blank" rel="noreferrer">{d.license} ↗</a>:d.license}</small><small lang={payloadLang}>{d.attribution}</small></div></article>)}</div></section>
<section id="news" class="section"><div class="section-heading"><div><p class="eyebrow">{h.newsEyebrow}</p><h2>{h.newsH2}</h2></div><p>{h.newsLede}</p></div><div class="news-grid">{data.news.map(n=><article class="news-card" lang={payloadLang}><div class="card-top"><span class="family">{n.tag}</span><time datetime={n.date}>{n.date}</time></div><h3><a href={n.sourceUrl} target="_blank" rel="noreferrer">{n.title} ↗</a></h3><p>{n.summary}</p><span class="source">{n.source}</span></article>)}</div></section>
<section id="methods" class="section methods"><div><p class="eyebrow">{h.methodsEyebrow}</p><h2>{h.methodsH2}</h2><p lang={payloadLang}>{data.evidencePolicy}</p><a class="button" href="/data/experiments.json" download>{h.downloadAll}</a></div><div class="method-grid">{h.principles.map(([title,body],i)=><article><span>0{i+1}</span><h3>{title}</h3><p>{body}</p></article>)}</div></section>
</main><footer><a class="brand" href={hrefFor('/',locale)}>{site.name}</a><p>{t.footerTagline}</p><a href="/data-use/#corrections">{t.footerReport}{t.englishMark}</a><a href="/data-use/">{t.footerDataUse}{t.englishMark}</a><a href="#overview">{t.footerBack}</a></footer>
<dialog id="detail-dialog" aria-labelledby="dialog-title"><div class="dialog-top"><p class="eyebrow">{h.dialogEyebrow}</p><button id="close-dialog" aria-label={h.closeDialog}>×</button></div><h2 id="dialog-title"></h2><div id="dialog-body"></div></dialog>
<script>import '../../scripts/workbench';</script>
</body></html>
