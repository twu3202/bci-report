---
import context from '../../../data/context-update.json';
import extension from '../../../data/extension-update.json';
import TopicLayout from '../../../components/TopicLayout.astro';
import ScoreBar from '../../../components/ScoreBar.astro';
import IntervalPlot from '../../../components/IntervalPlot.astro';
import { intervalPct, intervalPp, pct, pp } from '../../../data/topics';
import { localeOf, localeParams, topicCards, topicChrome } from '../../../data/i18n';

export const getStaticPaths = localeParams;
const locale = localeOf(Astro.params.lang);
const tc = topicChrome[locale];

// Within-person display-context transfer (2026-09-27 export). Every mean and
// interval here was recomputed by an independent audit before export; the
// per-person distribution and the direction-specific means were left out.
const r = context.results['vr-pc-p300'];
const primary = r.timings.onset_corrected, tag = r.timings.recorded_tag;
const lead = primary[0];                  // mean-window logistic regression
const iv = (b: { bootstrap_95: number[] }) => intervalPct(b.bootstrap_95 as [number, number]);
const auc = (b: { mean: number; bootstrap_95: number[] }) => `${b.mean.toFixed(3)}`;
const aucIv = (b: { bootstrap_95: number[] }) => `${b.bootstrap_95[0].toFixed(3)}–${b.bootstrap_95[1].toFixed(3)}`;
const n = (v: number) => v.toLocaleString('en-US');
const c = r.cohort;
const ratio = c.non_target_events / c.target_events;
// The baseline whose score moves most without the onset correction.
const timingDrop = primary.map((m, i) => ({ m, tagged: tag[i], drop: m.balanced_accuracy.mean - tag[i].balanced_accuracy.mean }))
  .sort((a, b) => b.drop - a.drop)[0];
const basis = r.rights.reviewBasis;
// Figures the short answer and the key figure name. All from the audited export.
const leadBa = pct(lead.balanced_accuracy.mean), leadIv = iv(lead.balanced_accuracy);
const chance = pct(r.chance_level, 0);

// A second presentation change (2026-10-02 export): LTRSVP image rate. Its own
// data set, cohort and decoder, so nothing here is compared with the VR scores
// above. Both primary arms are tested on the identical 10-Hz run-b images; the
// export checks that, and that the paired mean equals the two cell means. The
// interval crosses zero and rate is confounded with recording, so the page
// claims no rate effect — the export refuses to build if the first stops being
// true.
const lt = extension.results['ltrsvp-rate-transfer'];
const ltPeople = lt.cohort.people;
const [ltCross, ltSame] = lt.primary.arms;
const ltDiff = lt.paired_difference, ltAuc = lt.secondary_auroc_difference;
const ltRates = [5, 6, 10];
const ltCell = (train: number, test: number) => lt.matrix.find(m => m.train_rate_hz === train && m.test_rate_hz === test)!;
const ipp = (i: number[]) => intervalPp(i as [number, number], 1, locale);
const signed3 = (v: number) => `${v >= 0 ? '+' : '−'}${Math.abs(v).toFixed(3)}`;
const ltIv = (b: { bootstrap_95: number[] }) => intervalPct(b.bootstrap_95 as [number, number]);

const copy = {
  en: {
    description: `Above chance after the switch, but its cost is not measured: across ${c.people} people calibrated on a PC screen and tested in VR, and the reverse, a logistic regression reached ${leadBa} balanced accuracy (${leadIv}; chance ${chance}). Nobody was tested on the display they were calibrated on.`,
    answer: `It scores above chance after the switch, but this dataset cannot say how much the switch costs. Across [[${c.people}]] people, each calibrated on a PC screen and tested in a VR headset and also the other way round, a simple logistic regression averaged [[${leadBa}]] balanced accuracy over the two directions (95% interval [[${leadIv}]]; chance is [[${chance}]]), with stimulus-onset timing corrected. Nobody was also tested on the display they were calibrated on, so this is the level reached after the display change, not its cost.`,
    plotCaption: `The level after a display change, ${c.people} people.`,
    plotLegend: `Each person was calibrated on one display and tested on the other, in both directions, averaged within the person. Balanced accuracy, onset-corrected timing. Dot: mean over people; line: participant-bootstrap 95% interval; dashed line: chance, ${chance}. Rust: the logistic regression the short answer quotes; dark: the second fixed baseline.`,
    eyebrow: 'Context transfer · P300 on a screen and in VR',
    dek: `${c.people} people used the same P300 interface on a PC screen and in a virtual-reality headset. Calibrated on one display and tested on the other, a simple logistic regression reached ${pct(lead.balanced_accuracy.mean)} balanced accuracy, where chance is ${pct(r.chance_level, 0)}. That is the level reached after the change, not its cost: this protocol did not also test each person on the display they were calibrated on.`,
    findingLabel: `Balanced accuracy after the display change, ${c.people} people`,
    findingH3: 'Above chance after the change — with no same-display score to compare',
    findingP: `Interval ${iv(lead.balanced_accuracy)}; AUROC ${auc(lead.auroc)}.`,
    tableEyebrow: 'Two fixed baselines',
    tableH2: 'Calibrated on one display, tested on the other',
    tableLede: `Target against non-target epochs, ${Math.round(ratio)} non-targets to every target, so accuracy would reward always answering “non-target”; balanced accuracy and AUROC do not. Primary timing.`,
    tableRegion: 'Display-transfer results by baseline, scrolls horizontally',
    caption: 'Mean over 21 people of each person’s average of the two transfer directions, with participant-bootstrap 95% intervals.',
    colModel: 'Baseline', colBa: 'Balanced accuracy', colAuroc: 'AUROC',
    modelLabel: { mean_window_logreg: 'Mean-window logistic regression', spatiotemporal_shrinkage_lda: 'Spatiotemporal shrinkage LDA' } as Record<string, string>,
    baLabel: (v: string) => `${v} balanced accuracy`,
    timingEyebrow: 'Prespecified sensitivity',
    timingH2: 'With and without the onset correction',
    timingLede: 'The headset and the screen report stimulus onset with different delays. The primary analysis shifts each epoch by the source-reported offset — 19 samples on the PC and 60 in VR, at 512 Hz. The sensitivity analysis leaves epochs at the recorded tag. Neither scheme was chosen from test scores.',
    timingRegion: 'Balanced accuracy with and without the onset correction, scrolls horizontally',
    timingCaption: 'Balanced accuracy under each timing scheme, with participant-bootstrap 95% intervals.',
    colCorrected: 'Onset corrected (primary)', colTag: 'At the recorded tag',
    timingNote: `${timingDrop.m.label} depends on timing most: ${pct(timingDrop.m.balanced_accuracy.mean)} with the correction, ${pct(timingDrop.tagged.balanced_accuracy.mean)} without.`,
    covEyebrow: 'What the scores are computed on',
    covH2: 'Twenty-one people, one recording on each display',
    covLede: `Every label comes from the source; none was interpolated. One malformed row at the very end of one recording was discarded; it followed every possible epoch.`,
    covPeople: 'People', covPeopleOf: 'each recorded once on each display',
    covEvents: 'Labelled events', covEventsOf: `1 target to ${Math.round(ratio)} non-targets`,
    covKept: 'Epochs kept, primary timing', covKeptOf: `${n(c.rejected_epochs.onset_corrected)} rejected at 500 µV peak to peak`,
    limitsH2: 'What this comparison can and cannot support',
    limits: [
      ['No same-display reference', 'Nobody was tested on the display they were calibrated on in this protocol, so the cost of changing display is not measured here — only the level reached after the change.'],
      ['Within one person, not across people or days', 'Each person supplies both their calibration and their test data, on the same day. Nothing here speaks to a model that works for a new person or a later session.'],
      ['Two fixed baselines, not a ceiling', 'Two simple CPU classifiers with no tuning. No foundation model and no fine-tuned model was run in this batch.'],
      ['A mean offset, not per-event timing', 'Correcting the average onset delay does not remove event-to-event jitter, which a headset can add.'],
    ],
    consent: 'All participants gave written informed consent covering the experimental process, the data management procedures and the right to withdraw at any moment; the study was approved by the ethics committee of the University of Grenoble Alpes (CERNI). Only cohort aggregates appear here.',
    datasetLink: 'Zenodo record ↗', docLink: 'Dataset documentation ↗',
    rateEyebrow: 'Another presentation change · image rate · reviewed 2 October 2026',
    rateH2: 'Trained at 5 images a second, tested at 10: does a P300 decoder carry over?',
    rateLede: `A different data set and a different decoder, so nothing here compares with the VR scores above. In LTRSVP, ${ltPeople} people watched aerial images flash past at 5, 6 and 10 a second and looked for the ones with an airplane, recording twice at each rate. A fixed logistic regression is trained on one recording at one rate (run a) and tested on a different recording of the same person (run b), at the same rate or another; within a rate, run b followed run a after a long break. Both arms below are tested on the same 10-Hz images: ${n(lt.primary.target_events)} targets and ${n(lt.primary.non_target_events)} non-targets across the ${ltPeople} people.`,
    ltArm: (train: number, test: number) => `Trained at ${train} Hz, run a → tested at ${test} Hz, run b`,
    ltAuroc: (v: string) => `AUROC ${v}`,
    ltFindingLabel: `Trained at 5 Hz minus trained at 10 Hz, same 10-Hz test images, ${ltPeople} people`,
    ltFindingH3: 'Slightly lower on average — and the interval crosses zero',
    ltFindingP: `Paired interval ${ipp(ltDiff.bootstrap_95)}: it crosses zero, so no change is established. ${ltDiff.people_lower} of ${ltPeople} people had a lower point estimate and ${ltDiff.people_higher} a higher one. AUROC moved by ${signed3(ltAuc.mean)} (interval ${signed3(ltAuc.bootstrap_95[0])} to ${signed3(ltAuc.bootstrap_95[1])}), which also crosses zero.`,
    ltMatrixCaption: `Participant-mean balanced accuracy for each training rate (rows, run a) and test rate (columns, run b), ${ltPeople} people, with participant-bootstrap 95% intervals. Chance is ${pct(lt.chance_level, 0)}.`,
    ltMatrixRegion: 'Balanced accuracy by training and test image rate, scrolls horizontally',
    ltCorner: 'Training recording', ltTrain: (hz: number) => `Trained at ${hz} Hz`, ltTest: (hz: number) => `Tested at ${hz} Hz`,
    ltEvents: (t: string, nt: string) => `${t} targets / ${nt} non-targets`,
    ltMatrixNote: 'Every cell in a column is tested on the same images, whatever the training rate. On the diagonal the test recording is the same-rate run b, after a long break; off it, the rate also changes, and so does how far apart in the session the two recordings were. The nine cells reuse the same people and the same three training recordings of each, so they are not nine independent results.',
    ltLimitsH3: 'What the image-rate comparison cannot say',
    ltLimits: [
      ['Rate and recording are confounded', 'Training at another rate also means training on another recording, with another number of images and another target balance. A difference here is not a causal effect of image rate.'],
      ['Ascending order, not randomised', 'The original publication reports that the rates were presented from the lowest to the highest, in an order not randomised across participants. Within a rate, run b is the later recording, after a long break; how the two files of each rate map onto the ascending sequence is not documented on PhysioNet. So a cross-rate cell also differs in elapsed time, fatigue and practice, not only in rate and recording.'],
      [`${ltPeople} people`, `The ${n(lt.cohort.unique_test_events)} test images and ${lt.cohort.evaluation_cells} person-by-cell evaluations add no people; intervals summarise those ${ltPeople} people. ${lt.cohort.people_excluded} of the release's ${lt.cohort.people_in_release} people lack both recordings at one rate and were excluded from file metadata before scoring.`],
      ['Overlapping responses, offline', 'At these rates one image’s baseline and response windows contain its neighbours, so nothing here isolates a target response. Offline and fixed: no online latency, information transfer rate, new-person transfer, foundation-model or fine-tuning result.'],
    ],
    ltConsent: 'The original publication states that the study was approved by the Ethics Committee of the University of Essex and that every participant gave written consent before the experiment. Only cohort aggregates appear here, not the ages, sexes or handedness the paper reports.',
    ltRecord: 'PhysioNet record ↗', ltPaper: 'Original publication ↗',
  },
  zh: {
    description: `换设备后高于随机水平，但测不出换设备的代价：${c.people} 名被试在电脑屏幕上校准、在 VR 里测试，也反过来做一遍，逻辑回归的平衡准确率为 ${leadBa}（${leadIv}；随机水平 ${chance}）。没有被试在校准所用的设备上接受测试。`,
    answer: `换设备后的表现高于随机水平，但这个数据集测不出换设备的代价。[[${c.people}]] 名被试各自在电脑屏幕上校准、在 VR 头显里测试，也反过来做一遍；校正刺激出现时刻后，一个简单的逻辑回归在两个方向上平均达到 [[${leadBa}]] 的平衡准确率（95% 区间 [[${leadIv}]]；随机水平为 [[${chance}]]）。没有任何被试在校准所用的设备上接受测试，所以这是换设备之后达到的水平，而不是换设备的代价。`,
    plotCaption: `${c.people} 名被试更换显示设备后达到的水平。`,
    plotLegend: `每名被试在一种设备上校准、在另一种上测试，两个方向都做，再在被试内取平均。平衡准确率，主分析时间校正。点为被试平均值，横线为被试 bootstrap 95% 区间，虚线为随机水平（${chance}）。锈色为简答引用的逻辑回归，深色为另一个固定基线。`,
    eyebrow: '场景迁移 · 屏幕与 VR 中的 P300',
    dek: `${c.people} 名被试分别在电脑屏幕和虚拟现实头显里使用同一套 P300 界面。在一种显示设备上校准、在另一种上测试，一个简单的逻辑回归达到 ${pct(lead.balanced_accuracy.mean)} 的平衡准确率，随机水平为 ${pct(r.chance_level, 0)}。这是换设备之后达到的水平，不是换设备的代价：这个协议没有在被试校准时所用的那种设备上再测一次。`,
    findingLabel: `更换显示设备后的平衡准确率，${c.people} 名被试`,
    findingH3: '换设备后仍高于随机水平——但没有同设备的分数可比',
    findingP: `区间 ${iv(lead.balanced_accuracy)}；AUROC ${auc(lead.auroc)}。`,
    tableEyebrow: '两个固定基线',
    tableH2: '在一种设备上校准，在另一种上测试',
    tableLede: `区分目标与非目标分段，每 1 个目标对应 ${Math.round(ratio)} 个非目标，所以准确率会奖励一律回答“非目标”的模型；平衡准确率和 AUROC 不会。主分析时间校正。`,
    tableRegion: '按基线的跨设备迁移结果，可横向滚动',
    caption: '先对每名被试的两个迁移方向取平均，再对 21 名被试取平均；附被试 bootstrap 95% 区间。',
    colModel: '基线', colBa: '平衡准确率', colAuroc: 'AUROC',
    modelLabel: { mean_window_logreg: '窗口均值逻辑回归', spatiotemporal_shrinkage_lda: '时空收缩 LDA' } as Record<string, string>,
    baLabel: (v: string) => `平衡准确率 ${v}`,
    timingEyebrow: '预先设定的敏感性分析',
    timingH2: '校正与不校正刺激出现时刻',
    timingLede: '头显和屏幕报告刺激出现时刻的延迟不同。主分析按数据源报告的偏移量平移每个分段——在 512 Hz 下，电脑为 19 个采样点，VR 为 60 个。敏感性分析则把分段留在记录的标记处。两种方案都不是根据测试分数挑选的。',
    timingRegion: '有无出现时刻校正时的平衡准确率，可横向滚动',
    timingCaption: '两种时间方案下的平衡准确率，附被试 bootstrap 95% 区间。',
    colCorrected: '校正出现时刻（主分析）', colTag: '记录标记处',
    timingNote: `${timingDrop.m.id === 'spatiotemporal_shrinkage_lda' ? '时空收缩 LDA' : '窗口均值逻辑回归'} 对时间最敏感：校正后 ${pct(timingDrop.m.balanced_accuracy.mean)}，不校正 ${pct(timingDrop.tagged.balanced_accuracy.mean)}。`,
    covEyebrow: '这些分数算在什么之上',
    covH2: '21 名被试，每种设备各一段记录',
    covLede: '所有标签都来自数据源，没有插补任何一个。一段记录末尾有一行格式错误的数据被丢弃，它位于所有可用分段之后。',
    covPeople: '被试', covPeopleOf: '每种显示设备各记录一次',
    covEvents: '有标签的事件', covEventsOf: `1 个目标对 ${Math.round(ratio)} 个非目标`,
    covKept: '保留的分段（主分析时间）', covKeptOf: `${n(c.rejected_epochs.onset_corrected)} 个因峰峰值超过 500 µV 被剔除`,
    limitsH2: '这项比较能支持什么、不能支持什么',
    limits: [
      ['没有同设备的参照', '这个协议没有让被试在校准所用的设备上接受测试，所以这里测不出更换设备的代价，只测出了换设备之后达到的水平。'],
      ['被试内迁移，不是跨被试或跨天', '每名被试既提供自己的校准数据，也提供自己的测试数据，而且在同一天。这里的结果说明不了模型对新被试或之后的会话是否有效。'],
      ['两个固定基线，不是上限', '两个未调参的简单 CPU 分类器。这一批没有运行任何基础模型或微调模型。'],
      ['平均偏移，不是逐事件对齐', '校正平均出现延迟，并不能消除事件与事件之间的时间抖动，而头显可能会引入这种抖动。'],
    ],
    consent: '所有被试都签署了书面知情同意，内容涵盖实验流程、数据管理方式以及随时退出实验的权利；研究经格勒诺布尔-阿尔卑斯大学伦理委员会（CERNI）批准。这里只发布队列级聚合结果。',
    datasetLink: 'Zenodo 记录 ↗', docLink: '数据集说明文档 ↗',
    rateEyebrow: '另一种呈现变化 · 图像速率 · 2026 年 10 月 2 日审核',
    rateH2: '在每秒 5 张图像上训练、在每秒 10 张上测试：P300 解码器还管用吗？',
    rateLede: `另一个数据集、另一个解码器，所以这里的结果不能和上面的 VR 分数比较。在 LTRSVP 中，${ltPeople} 名被试观看以每秒 5、6、10 张的速度快速闪过的航拍图像，找出其中有飞机的那些；每种速率各记录两次。一个固定的逻辑回归在某一速率的一段记录（a 段）上训练，在同一被试的另一段记录（b 段）上测试，测试速率可以相同，也可以不同；在同一速率内，b 段是在 a 段之后、隔了较长的休息才记录的。下面两组都在同样的 10 Hz 图像上测试：${ltPeople} 名被试合计 ${n(lt.primary.target_events)} 个目标、${n(lt.primary.non_target_events)} 个非目标。`,
    ltArm: (train: number, test: number) => `${train} Hz a 段训练 → ${test} Hz b 段测试`,
    ltAuroc: (v: string) => `AUROC ${v}`,
    ltFindingLabel: `5 Hz 训练减 10 Hz 训练，相同的 10 Hz 测试图像，${ltPeople} 名被试`,
    ltFindingH3: '平均略低——但区间跨过零',
    ltFindingP: `配对区间 ${ipp(ltDiff.bootstrap_95)}：跨过零，所以不能认定有变化。${ltPeople} 名被试中 ${ltDiff.people_lower} 人的点估计更低、${ltDiff.people_higher} 人更高。AUROC 变化 ${signed3(ltAuc.mean)}（区间 ${signed3(ltAuc.bootstrap_95[0])} 至 ${signed3(ltAuc.bootstrap_95[1])}），同样跨过零。`,
    ltMatrixCaption: `每种训练速率（行，a 段）与测试速率（列，b 段）下的被试平均平衡准确率，${ltPeople} 名被试，附被试 bootstrap 95% 区间。随机水平为 ${pct(lt.chance_level, 0)}。`,
    ltMatrixRegion: '按训练与测试图像速率的平衡准确率，可横向滚动',
    ltCorner: '训练记录', ltTrain: (hz: number) => `${hz} Hz 训练`, ltTest: (hz: number) => `${hz} Hz 测试`,
    ltEvents: (t: string, nt: string) => `${t} 个目标 / ${nt} 个非目标`,
    ltMatrixNote: '同一列中，无论训练速率如何，测试的都是同样的图像。对角线上，测试记录是同一速率的 b 段，隔了较长的休息才记录；对角线以外，速率也变了，两段记录在实验中相隔多远也随之不同。这九个格子复用同一批被试、每人同样的三段训练记录，所以不是九个独立的结果。',
    ltLimitsH3: '图像速率比较说明不了什么',
    ltLimits: [
      ['速率与记录相互混杂', '换一种速率训练，也就换了一段训练记录，图像数量和目标比例也随之不同。这里的差异不是图像速率的因果效应。'],
      ['从低到高、没有随机化的顺序', '原始论文写明，各速率按从低到高的顺序呈现，而且这一顺序没有在被试之间随机化。在同一速率内，b 段是之后的记录，隔了较长的休息；每种速率的两个文件在这个升序序列中处于什么位置，PhysioNet 没有说明。所以跨速率的格子除了速率和记录不同，经过的时间、疲劳和练习程度也不同。'],
      [`${ltPeople} 名被试`, `${n(lt.cohort.unique_test_events)} 张测试图像和 ${lt.cohort.evaluation_cells} 次“被试 × 格子”评估并不增加被试人数；区间概括的是这 ${ltPeople} 人。该数据集 ${lt.cohort.people_in_release} 名被试中有 ${lt.cohort.people_excluded} 人缺少某一速率下的两段记录，在评分前已按文件元数据排除。`],
      ['反应相互重叠、离线', '在这些速率下，一张图像的基线窗口和反应窗口里都含有相邻图像，所以这里没有分离出单独的目标反应。离线、固定：没有在线延迟、信息传输率、新被试迁移、基础模型或微调结果。'],
    ],
    ltConsent: '原始论文写明，研究经埃塞克斯大学（University of Essex）伦理委员会批准，每名被试在实验开始前都签署了书面同意。这里只发布队列级聚合结果，不发布论文中的年龄、性别与利手信息。',
    ltRecord: 'PhysioNet 记录 ↗', ltPaper: '原始论文 ↗',
  },
}[locale];
const card = topicCards[locale]['screen-to-vr'];
---
<TopicLayout
  locale={locale}
  title={card.title}
  description={copy.description}
  path="/topics/screen-to-vr/"
  eyebrow={copy.eyebrow}
  dek={copy.dek}
  activeSlug="screen-to-vr"
  dataFiles={['/data/context-update.json']}
  answer={copy.answer}
>
  <IntervalPlot
    caption={copy.plotCaption}
    legend={copy.plotLegend}
    domain={[0, 1]}
    ticks={['0%', '25%', '50%', '75%', '100%']}
    reference={r.chance_level}
    rows={primary.map((m, i) => ({ label: copy.modelLabel[m.id], tone: i === 0 ? 'rust' as const : 'ink' as const, value: m.balanced_accuracy.mean, interval: m.balanced_accuracy.bootstrap_95 as [number, number], text: `${pct(m.balanced_accuracy.mean)} (${iv(m.balanced_accuracy)})` }))}
  />
  <section class="topic-section" aria-labelledby="vr-finding">
    <div class="finding">
      <div class="finding-number"><strong>{pct(lead.balanced_accuracy.mean)}</strong><span>{copy.findingLabel}</span></div>
      <div class="finding-copy"><h3 id="vr-finding">{copy.findingH3}</h3><p>{copy.findingP}</p></div>
    </div>
    <div class="topic-heading"><div><p class="eyebrow">{copy.tableEyebrow}</p><h2>{copy.tableH2}</h2></div><p>{copy.tableLede}</p></div>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.tableRegion}>
      <table>
        <caption>{copy.caption}</caption>
        <thead><tr><th scope="col">{copy.colModel}</th><th scope="col">{copy.colBa}</th><th scope="col">{copy.colAuroc}</th></tr></thead>
        <tbody>{primary.map((m, i) => <tr><th scope="row">{copy.modelLabel[m.id]}</th><td><span class="metric">{pct(m.balanced_accuracy.mean)}</span><span class="interval">{iv(m.balanced_accuracy)}</span><ScoreBar value={m.balanced_accuracy.mean} label={copy.baLabel(pct(m.balanced_accuracy.mean))} tone={i === 0 ? 'rust' : 'ink'} /></td><td><span class="metric">{auc(m.auroc)}</span><span class="interval">{aucIv(m.auroc)}</span></td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="topic-section" aria-labelledby="timing-heading">
    <div class="topic-heading"><div><p class="eyebrow">{copy.timingEyebrow}</p><h2 id="timing-heading">{copy.timingH2}</h2></div><p>{copy.timingLede}</p></div>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.timingRegion}>
      <table>
        <caption>{copy.timingCaption}</caption>
        <thead><tr><th scope="col">{copy.colModel}</th><th scope="col">{copy.colCorrected}</th><th scope="col">{copy.colTag}</th></tr></thead>
        <tbody>{primary.map((m, i) => <tr><th scope="row">{copy.modelLabel[m.id]}</th><td><span class="metric">{pct(m.balanced_accuracy.mean)}</span><span class="interval">{iv(m.balanced_accuracy)}</span></td><td><span class="metric">{pct(tag[i].balanced_accuracy.mean)}</span><span class="interval">{iv(tag[i].balanced_accuracy)}</span></td></tr>)}</tbody>
      </table>
    </div>
    <p class="protocol-note">{copy.timingNote}</p>
  </section>

  <section class="topic-section" aria-labelledby="vr-coverage">
    <div class="topic-heading"><div><p class="eyebrow">{copy.covEyebrow}</p><h2 id="vr-coverage">{copy.covH2}</h2></div><p>{copy.covLede}</p></div>
    <div class="evidence-grid">
      <article class="evidence-card"><p class="eyebrow">{copy.covPeople}</p><div class="reading">{c.people}</div><p>{copy.covPeopleOf}</p></article>
      <article class="evidence-card"><p class="eyebrow">{copy.covEvents}</p><div class="reading">{n(c.labeled_events)}</div><p>{copy.covEventsOf}</p></article>
      <article class="evidence-card"><p class="eyebrow">{copy.covKept}</p><div class="reading">{n(c.retained_epochs.onset_corrected)}</div><p>{copy.covKeptOf}</p></article>
    </div>
  </section>

  <section class="topic-section" id="image-rate" aria-labelledby="rate-heading">
    <div class="topic-heading"><div><p class="eyebrow">{copy.rateEyebrow}</p><h2 id="rate-heading">{copy.rateH2}</h2></div><p>{copy.rateLede}</p></div>
    <div class="evidence-grid">{[ltCross, ltSame].map((a, i) => <article class="evidence-card"><p class="eyebrow">{copy.ltArm(a.train_rate_hz, a.test_rate_hz)}</p><div class="reading">{pct(a.balanced_accuracy.mean)}</div><ScoreBar value={a.balanced_accuracy.mean} max={1} label={copy.baLabel(pct(a.balanced_accuracy.mean))} tone={i === 0 ? 'rust' : 'ink'} /><p>{copy.ltAuroc(`${auc(a.auroc)} (${aucIv(a.auroc)})`)}</p><small>{tc.interval95} {ltIv(a.balanced_accuracy)}</small></article>)}</div>
    <div class="finding">
      <div class="finding-number"><strong>{pp(ltDiff.mean, 1)}</strong><span>{copy.ltFindingLabel}</span></div>
      <div class="finding-copy"><h3>{copy.ltFindingH3}</h3><p>{copy.ltFindingP}</p></div>
    </div>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.ltMatrixRegion}>
      <table>
        <caption>{copy.ltMatrixCaption}</caption>
        <thead><tr><th scope="col">{copy.ltCorner}</th>{ltRates.map(t => <th scope="col">{copy.ltTest(t)}<small>{copy.ltEvents(n(ltCell(5, t).target_events), n(ltCell(5, t).non_target_events))}</small></th>)}</tr></thead>
        <tbody>{ltRates.map(s => <tr><th scope="row">{copy.ltTrain(s)}</th>{ltRates.map(t => { const m = ltCell(s, t); return <td><span class="metric">{pct(m.balanced_accuracy.mean)}</span><span class="interval">{ltIv(m.balanced_accuracy)}</span></td>; })}</tr>)}</tbody>
      </table>
    </div>
    <p class="protocol-note">{copy.ltMatrixNote}</p>
    <h3 class="roadmap-h3">{copy.ltLimitsH3}</h3>
    <div class="method-grid-wide" id="image-rate-limits">{copy.ltLimits.map(([h, p]) => <article><h3>{h}</h3><p>{p}</p></article>)}</div>
    <div class="citation-list"><article><h3 lang="en">{lt.rights.name}</h3><p lang="en">{lt.rights.attribution}</p><p>{copy.ltConsent}</p><p><a href={lt.rights.reviewBasis[0]} target="_blank" rel="noreferrer">{copy.ltRecord}</a> · <a href={lt.rights.reviewBasis[1]} target="_blank" rel="noreferrer">{copy.ltPaper}</a> · <a href={lt.rights.licenseUrl} target="_blank" rel="noreferrer">{lt.rights.license}</a></p></article></div>
    <p class="citation-note">{tc.dataSource} <a href="/data/extension-update.json" download>extension-update.json</a> · {tc.schema} {extension.schema_version} · {tc.generated} {extension.generated_at}{tc.period}</p>
  </section>

  <section class="topic-section" id="methods-and-limits" aria-labelledby="vr-limits">
    <div class="topic-heading"><div><p class="eyebrow">{tc.methodsEyebrow}</p><h2 id="vr-limits">{copy.limitsH2}</h2></div></div>
    <div class="method-grid-wide">{copy.limits.map(([h, p]) => <article><h3>{h}</h3><p>{p}</p></article>)}</div>
    <div class="citation-list"><article><h3 lang="en">{r.rights.name}</h3><p lang="en">{r.rights.attribution}</p><p>{copy.consent}</p><p><a href={basis[0]} target="_blank" rel="noreferrer">{copy.datasetLink}</a> · <a href={basis[1]} target="_blank" rel="noreferrer">{copy.docLink}</a> · <a href={r.rights.licenseUrl} target="_blank" rel="noreferrer">{r.rights.license}</a></p></article></div>
    <p class="citation-note">{tc.dataSource} <a href="/data/context-update.json" download>{tc.reviewedAggregate}</a> · {tc.schema} {context.schema_version} · {tc.generated} {context.generated_at.slice(0,10)}{tc.period}</p>
  </section>
</TopicLayout>
