    optGates: (): Part[] => ['分类器处于暂缓状态，所以没有任何分数。数字任务编码没有经过核实的、与左右手或动作对应的对照表，事件时长也互相矛盾：事件表中为 ', n(G.event_duration_s.events_table), ' 秒，光学数据文件中为 ', n(G.event_duration_s.optical_files), ' 秒，所引论文中为 ', n(G.event_duration_s.cited_paper), ' 秒。因辅助运动传感器时钟未经核实而暂缓的 ', n(G.auxiliary_clock_hold_recordings), ' 段记录仍然暂缓：光学数值覆盖不能弥补它们。'],
    optSource: '数据：',
    optAudit: '经过独立审计：每个通道计数都与记录总数和合计值对上，代码及其合成数据测试也经过审查。没有重做对原始信号的那一遍计算。',
    soEyebrow: '只发状态 · 没有分数',
    soH2: '尚未评测',
    soLede: '从公开文件中准备好的内容，以计数列出。',
    falconMeta: '人类，一名被试 · 皮层内神经元放电 · 跨记录日按提示尝试书写句子',
    falconState: '已完成准备，尚未评分。',
    falconPrep: (): Part[] => ['还没有拟合任何模型。公开发布的数据共 ', n(P2.files), ' 个文件、', n(P2.recording_dates), ' 个记录日，', n(P2.channels), ' 个通道；其中 held-in 校准部分有 ', n(P2.held_in_calibration_trials), ' 个试次。公开的 ', n(P2.minival_trials), ' 个 minival 试次全部出现在这些校准试次之中，所以一个不泄漏的诊断必须先把它们从训练数据中去掉。剩下 ', n(P2.training_candidate_trials), ' 个训练试次，涵盖 ', n(P2.symbols), ' 个符号（CTC 解码器加上空白符共 ', n(P2.ctc_classes_with_blank), ' 类）。另外 ', n(P2.held_out_calibration_trials), ' 个留出的校准试次是少样本重新校准的输入，不是独立的评估数据。'],
    falconFacts: '为了找出重叠，已经查看过这些 minival 试次，所以之后在它们上面做的诊断不是盲测，也不会是 FALCON 官方的跨天分数。',
    fusMeta: '人类，一名被试 · 透过声学透明颅骨植入窗的功能超声 · 画画、弹吉他、说话或阅读，与静息对比',
    fusState: '已完成准备，尚未分析。',
    fusPrep: (): Part[] => ['帧标签、时间戳与图像坐标轴都已核实；还没有读取任何多普勒数值，也没有拟合任何解码器。已准备：同一个人的 ', n(P3.runs), ' 个 run，不是九名被试——其中画画 ', n(P3.drawing_runs), ' 个、弹吉他 ', n(P3.guitar_runs), ' 个、说话与阅读混合 ', n(P3.mixed_speech_reading_runs), ' 个——共 ', n(P3.frames), ' 帧，静息 ', n(P3.rest_frames), ' 帧，活动 ', n(P3.activity_frames), ' 帧。'],
    fusFacts: '只核实了静息与活动的区分；混合 run 中说话与阅读的编码各自是什么意思，还没有核实。使用实测的时间戳，因为 run 标签中的标称组块时长与实测的帧时间不一致。画画、弹吉他与说话或阅读是不同的范式，不合并成一个任务。这些数据只许可非商业使用。',
    holdLink: '它在暂缓登记表中的条目 →',
    limitsH2: '局限',
    methodsH3: '每项结果是怎样得到的',
    methods: (): [string, Part[]][] => [
      ['人类 fNIRS，Bak 等人', ['数据集提供的 ', n(BS.channels), ' 条血流动力学序列。每个试次从任务开始到 ', n(BS.observation_window_s), ' 秒，取三个连续的 ', n(5), ' 秒时间窗内的通道均值，各减去任务开始前一秒的均值：共 ', n(BS.features), ' 个特征，在数据集提供的序列之外不做任何滤波。标准化与收缩 LDA（lsqr 求解器、自动收缩、训练集经验先验）只在训练被试上拟合，不搜索通道、特征或超参数；共 ', n(BD.folds), ' 折，每折留出一名完整的被试。']],
      ['猕猴神经元放电，MC_RTT', ['held-in 神经元在 ', n(NS.bin_ms), ' ms 时间窗内的放电计数，在包括当前在内的此前 ', n(NS.smoothing_bins), ' 个时间窗上平滑（只用过去的数据），取 ', n(NS.history_lags), ' 个历史滞后：共 ', n(NS.features), ' 个特征，在每个试次与每段观测间隙处重置。目标是 ', n(NS.target_lag_ms), ' ms 之后那个时间窗内存储的手指 x/y 速度均值，每个 ', n(N.trial_ms), ' ms 的试次保留 ', n(NS.retained_bins_each_trial), ' 个时间窗。标准化只在训练数据行上拟合，之后是岭回归（alpha 为 10，Cholesky 求解器，带截距），去掉在训练数据中恒定的特征，不做超参搜索。只使用训练文件及其存储的训练与验证试次；没有打开测试文件。']],
      ['人类 fNIRS 数值覆盖，ds007420', ['在不使用标签或事件的情况下，把 ', n(O.recordings), ' 段记录的每个光学数值读一遍。占比的分母是全部光学数值；恒定通道指采样全部有限且完全相等的通道，不设容差。']],
    ],
    intervalsH3: '区间覆盖了什么',
    intervals: (): Part[] => ['只有 fNIRS 的结果有区间：对 ', n(B.people), ' 个固定的逐人分数有放回地重抽样 ', n(BU.draws), ' 次得到的描述性 95% 百分位区间。MC_RTT 的数字没有区间，ds007420 的数字是计数。'],
    limitsH3: '三项结果共同的局限',
    limits: [
      '这些是本站在本地运行的实验，不是论文或基准排行榜上报告的分数。',
      '物种、信号、任务与指标各不相同，三项结果没有共同的尺度，各自单独报告；都不与头皮 EEG 的结果比较，也都不进入八个协议的核心矩阵。',
      '只有离线结果：不涉及在线或闭环控制、设备、临床或部署方面的结论。',
      '在评分之前固定：不搜索通道、特征或超参数，这里的任何分数都没有用来选择设置。',
    ],
    notPubH3: '这里不发布的内容',
    notPub: '任何逐人、逐段记录、逐通道、逐试次、逐折与逐行的数值；混淆矩阵；被试、记录、文件与会话的标识以及记录日期；信号、特征、预测、模型系数、归一化统计量、提示文本、标签、时间戳与图像；实测的计算量；人口学信息。为什么一只动物和小样本只能发布这么少：',
    smallCohorts: '见数据使用页面上的小样本说明（英文）→',
    creditsH3: '署名、许可，以及知情同意或动物护理',
    consentH: '数据源陈述的伦理与知情同意：',
    animalH: 'Neural Latents Benchmark 论文陈述的动物护理：',
    consentNA: '知情同意：不适用，动物数据。',
    archiveNote: '读自出版方文章页面在互联网档案馆的存档，因为出版方拒绝了自动化请求。',
    recordLink: '数据集记录 ↗', paperLink: '论文 ↗', readFrom: '声明读自 ↗', readFromPaper: '声明读自该论文', datasetPage: '数据集页面 →', creditsLink: '署名、许可与知情同意 ↓',
    derived: '以上均为 BCI Report 的衍生分析，只发布聚合结果；不代表数据作者的认可，也不再分发任何原始数据。',
    relatedH2: '相关问题',
    related: [
      { text: '小规模的 EEG 试点研究，其中一些数据集同时记录了 fNIRS 或肌电：', href: '/topics/pilot-studies/', link: topicCards.zh['pilot-studies'].question },
      { text: '耳道内而不是头皮上的电极，与完整的头皮电极对比：', href: '/topics/fewer-electrodes/', link: topicCards.zh['fewer-electrodes'].question },
      { text: '从头皮 EEG 解码同一个人跨会话的连续光标追踪，信号、任务与指标都不同：', href: '/topics/later-sessions/#forenzo', link: '连续光标追踪，一个阴性结果' },
    ],
  },
}[locale];

// The consent, ethics and animal-care sentences: the export's English, and its Chinese here, held to the export's wording.
const consentZh: Record<string, [string, string, string, string]> = {
  'bak-fnirs': ['Approved by the Korea University Institutional Review Board (KUIRB-2019-0254-01); the experiments followed the criteria of the Declaration of Helsinki.',
    'The participants\' written consent, approved by that board, was submitted before data recording.',
    '经高丽大学机构审查委员会批准（KUIRB-2019-0254-01）；实验遵循《赫尔辛基宣言》的准则。',
    '被试在数据记录之前提交了经该委员会批准的书面知情同意。'],
  'nlb-mc-rtt': ['Collected under procedures and experiments approved by the Institutional Animal Care and Use Committees at the respective institutions; MC_RTT was collected in the Sabes Lab at UCSF.',
    'Not applicable: animal data, no human participant.',
    '在各相关机构的动物护理与使用委员会批准的程序与实验下采集；MC_RTT 采集于 UCSF 的 Sabes 实验室。',
    '不适用：动物数据，没有人类被试。'],
  ds007420: ['Approved by the Institutional Review Board of Boston University (Protocol #4502, as the dataset description records it).',
    'All participants provided written informed consent to take part in the study.',
    '经波士顿大学机构审查委员会批准（数据集描述记录的方案编号为 #4502）。',
    '所有被试都签署了参加本研究的书面知情同意。'],
  'falcon-h2': ['Permission from the Institutional Review Boards of Stanford University (protocol #20804); the BrainGate2 pilot trial ran under FDA Investigational Device Exemption #G090003 (ClinicalTrials.gov NCT00912041).',
    'The participant gave informed consent and was enrolled in the BrainGate2 trial.',
    '获得斯坦福大学机构审查委员会的许可（方案编号 #20804）；BrainGate2 先导试验在美国 FDA 研究用器械豁免 #G090003 下开展（ClinicalTrials.gov NCT00912041）。',
    '该被试给予了知情同意，并入组 BrainGate2 试验。'],
  'rabut-fus': ['Approved by the Institutional Review Boards of the University of Southern California, Caltech (IR19-0902) and Rancho Los Amigos National Rehabilitation Hospital.',
    'The participant\'s consent was obtained.',
    '经南加州大学、加州理工学院（IR19-0902）与 Rancho Los Amigos 国家康复医院的机构审查委员会批准。',
    '已获得该被试的同意。'],
};
const credits = (['bak-fnirs', 'nlb-mc-rtt', 'ds007420', 'falcon-h2', 'rabut-fus'] as const).map(id => {
  const d = D[id], e = d.consent_and_ethics, r = d.rights, z = consentZh[id];
  need(e.ethics_approval.stated && e.ethics_approval.statement === z[0] && e.informed_consent.statement === z[1], `the ${id} consent and ethics sentences`);
  need(id === 'nlb-mc-rtt' ? e.subjects === 'animal' && e.informed_consent.stated === false : e.subjects === 'human' && e.informed_consent.stated === true, `${id}: who the subjects are`);
  const readFrom = (e.read_from as string).split(' ')[0];
  need(/^https:\/\//.test(readFrom), `${id}: the statement's source is a link`);
  // Bak: the publisher refused automated requests, so the statement was read from the archived page its rights record names.
  const archive = id === 'bak-fnirs' ? r.reviewBasis.find((u: string) => u.startsWith('https://web.archive.org/')) : null;
  if (id === 'bak-fnirs') need(!!archive && /Internet Archive capture/.test(e.read_from) && /HTTP 403/.test(e.read_from), 'Bak\'s statement came from the archived article page');
  const from = archive ?? readFrom;
  return { id, r, e, paper: PAPER[id], readFrom: from === PAPER[id] ? null : from, archive: !!archive, animal: e.subjects === 'animal',
    ethics: zh ? z[2] : e.ethics_approval.statement, consent: zh ? z[3] : e.informed_consent.statement };
});
const card = topicCards[locale]['beyond-scalp-eeg'];
const dataset = (slug: string) => hrefFor(`/datasets/${slug}/`, locale);
// The page's own credits, as a full path: the Markdown copy drops in-page jump links.
const creditsHref = `${hrefFor(BEYOND_PATH, locale)}#credits`;
const sourceLine = (text: string, names: string | null, version: string, licence: string, licenceUrl: string, slug: string | null) => ({ text, names, version, licence, licenceUrl, slug });
const sources = {
  bak: sourceLine(copy.bakSource, zh ? 'Sujin Bak, Jinwoo Park, Jaeyoung Shin and Jichai Jeong' : null, VERSION.bak, D['bak-fnirs'].rights.license, D['bak-fnirs'].rights.licenseUrl, 'bak-fnirs'),
  nlb: sourceLine(copy.nlbSource, zh ? 'Joseph E. O’Doherty, Mariana M. B. Cardoso, Joseph G. Makin and Philip N. Sabes (Sabes Lab, UCSF), prepared for the Neural Latents Benchmark' : null, VERSION.nlb, D['nlb-mc-rtt'].rights.license, D['nlb-mc-rtt'].rights.licenseUrl, 'nlb-mc-rtt'),
  opt: sourceLine(copy.optSource, zh ? 'Shibo Zhou, De’Ja Rogers, David A. Boas, Meryem A. Yücel and Yuanyuan Gao' : null, VERSION.ds007420, 'CC0', D.ds007420.rights.licenseUrl, 'ds007420'),
};
for (const [k, who] of [['bak', 'Sujin Bak, Jinwoo Park, Jaeyoung Shin and Jichai Jeong'], ['nlb', 'Joseph E. O\'Doherty, Mariana M. B. Cardoso, Joseph G. Makin and Philip N. Sabes'], ['opt', 'Shibo Zhou, De’Ja Rogers, David A. Boas, Meryem A. Yücel and Yuanyuan Gao']] as const)
  need(D[{ bak: 'bak-fnirs', nlb: 'nlb-mc-rtt', opt: 'ds007420' }[k]].rights.attribution.includes(who), `the ${k} source line names the dataset's authors`);
---
<TopicLayout
  locale={locale}
  title={card.title}
  description={copy.description}
  path="/topics/beyond-scalp-eeg/"
  eyebrow={copy.eyebrow}
  dek={copy.dek}
  activeSlug="beyond-scalp-eeg"
  answer={copy.answer}
  dataFiles={['/data/beyond-scalp-update.json']}
>
  <section class="topic-section" id="bak-fnirs" aria-labelledby="bak-heading" data-beyond="bak">
    <div class="topic-heading"><div><p class="eyebrow">{copy.bakEyebrow}</p><h2 id="bak-heading">{copy.bakH2}</h2><p class="topic-subtitle" data-subtitle="bak">{copy.bakLabel}{zh && <span class="note-original" lang="en">{bak.label}</span>}</p></div><p><Parts p={copy.bakLede()}/></p></div>
    <IntervalPlot
      id="bak-balanced-accuracy"
      caption={copy.bakPlotCaption}
      legend={copy.bakPlotLegend}
      domain={[0, 1]}
      ticks={['0%', '25%', '50%', '75%', '100%']}
      reference={chance}
      rows={[
        { label: armName.lda, value: lda.mean, interval: lda.interval_95 as [number, number], fig: f(lda.mean),
          noteParts: [`${tc.interval95} `, f(lda.interval_95[0]), '–', f(lda.interval_95[1])], tone: 'rust' },
        { label: armName.prior, value: prior.mean, fig: f(prior.mean), note: copy.noInterval, tone: 'ink' },
      ]}
    />
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.bakRegion}>
      <table data-beyond-table="bak">
        <caption><Parts p={copy.bakCaption()}/></caption>
        <thead><tr><th scope="col">{copy.colDecoder}</th><th scope="col">{copy.colBa}</th>{(['right_hand', 'left_hand', 'foot'] as const).map(c => <th scope="col">{copy.colRecall[c]}</th>)}</tr></thead>
        <tbody>
          <tr data-beyond-row="shrinkage_lda"><th scope="row">{armName.lda}<small>{copy.ldaNote}</small></th>
            <td data-cell="ba"><Fig f={f(lda.mean)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={f(lda.interval_95[0])}/>–<Fig f={f(lda.interval_95[1])}/></span></td>
            {(['right_hand', 'left_hand', 'foot'] as const).map(c => <td data-cell={`recall-${c}`}><Fig f={f(BA.shrinkage_lda.class_recall[c])} cls="metric"/></td>)}</tr>
          <tr data-beyond-row="source_prior"><th scope="row">{armName.prior}<small>{copy.priorNote}</small></th>
            <td data-cell="ba"><Fig f={f(prior.mean)} cls="metric"/><span class="interval">{copy.noInterval}</span></td>
            {(['right_hand', 'left_hand', 'foot'] as const).map(c => <td data-cell={`recall-${c}`}><Fig f={f(BA.source_prior.class_recall[c])} cls="metric"/></td>)}</tr>
        </tbody>
      </table>
    </div>
    <div class="finding" data-finding="bak">
      <div class="finding-number"><strong><Fig f={f(lda.mean)}/></strong><span><Parts p={copy.bakFindLabel()}/></span></div>
      <div class="finding-copy"><h3>{copy.bakFindH3}</h3><p><Parts p={copy.bakFindP()}/></p></div>
    </div>
    <p class="protocol-note" data-beyond-note="bak-limits">{copy.bakLimits}</p>
    <p class="citation-note" data-beyond-note="bak-source">{sources.bak.text}{sources.bak.names ? <><span lang="en">{sources.bak.names}</span>，</> : ' '}<code>{sources.bak.version}</code>{zh ? '，' : ', '}<a href={sources.bak.licenceUrl} target="_blank" rel="noreferrer">{sources.bak.licence}</a>{tc.period}{sp}<a href={dataset('bak-fnirs')}>{copy.datasetPage}</a> · <a href={creditsHref}>{copy.creditsLink}</a></p>
    <p class="citation-note" data-beyond-note="bak-audit">{copy.bakAudit}</p>
  </section>

  <section class="topic-section" id="mc-rtt" aria-labelledby="nlb-heading" data-beyond="nlb">
    <div class="topic-heading"><div><p class="eyebrow">{copy.nlbEyebrow}</p><h2 id="nlb-heading">{copy.nlbH2}</h2><p class="topic-subtitle" data-subtitle="nlb">{copy.nlbLabel}{zh && <span class="note-original" lang="en">{nlb.label}</span>}</p></div><p><Parts p={copy.nlbLede()}/></p></div>
    <IntervalPlot
      id="mc-rtt-r2"
      caption={copy.r2Caption}
      legend={copy.r2Legend}
      domain={r2Domain}
      ticks={['−0.1', '0', '0.1', '0.2', '0.3']}
      reference={0}
      rows={[
        ...r2Keys.map(k => ({ label: copy.rowR2(armName.ridge, k), value: NA.ridge[k], fig: w(NA.ridge[k]), tone: 'rust' as const })),
        ...r2Keys.map(k => ({ label: copy.rowR2(armName.mean, k), value: NA.training_mean[k], fig: w(NA.training_mean[k]), tone: 'ink' as const })),
      ]}
    />
    {(['rmse_m_per_s', 'mae_m_per_s'] as const).map(k => <IntervalPlot
      id={k === 'rmse_m_per_s' ? 'mc-rtt-rmse' : 'mc-rtt-mae'}
      caption={k === 'rmse_m_per_s' ? copy.rmseCaption : copy.maeCaption}
      legend={k === 'rmse_m_per_s' ? copy.rmseLegend : copy.maeLegend}
      domain={errDomain}
      ticks={['0', '0.02', '0.04', '0.06', '0.08']}
      reference={NA.training_mean[k]}
      rows={[
        { label: armName.ridge, value: NA.ridge[k], fig: w(NA.ridge[k]), tone: 'rust' },
        { label: armName.mean, value: NA.training_mean[k], fig: w(NA.training_mean[k]), tone: 'ink' },
      ]}
    />)}
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.nlbRegion}>
      <table data-beyond-table="nlb">
        <caption><Parts p={copy.nlbCaption()}/></caption>
        <thead><tr><th scope="col">{copy.colMetric}</th><th scope="col">{copy.colRidge}</th><th scope="col">{copy.colMean}</th><th scope="col">{copy.colBetter}</th></tr></thead>
        <tbody>{nlbMetrics.map(k => <tr data-beyond-row={k}>
          <th scope="row">{metricName[k]}<small>{metricNote[k]}</small></th>
          <td data-cell="ridge"><Fig f={w(NA.ridge[k])} cls="metric"/></td>
          <td data-cell="training_mean"><Fig f={w(NA.training_mean[k])} cls="metric"/></td>
          <td data-cell="better" data-ridge-better={String(NC[k])}>{NC[k] ? copy.betterRidge : copy.betterMean}</td>
        </tr>)}</tbody>
      </table>
    </div>
    <div class="finding" data-finding="nlb">
      <div class="finding-number"><strong><Fig f={w(NA.ridge.r2_uniform_average)}/></strong><span><Parts p={copy.nlbFindLabel()}/></span></div>
      <div class="finding-copy"><h3>{copy.nlbFindH3}</h3><p><Parts p={copy.nlbFindP()}/></p></div>
    </div>
    <p class="protocol-note" data-beyond-note="nlb-limits">{copy.nlbLimits}</p>
    <p class="citation-note" data-beyond-note="nlb-source">{sources.nlb.text}{sources.nlb.names ? <><span lang="en">{sources.nlb.names}</span>，</> : ' '}<code>{sources.nlb.version}</code>{zh ? '，' : ', '}<a href={sources.nlb.licenceUrl} target="_blank" rel="noreferrer">{sources.nlb.licence}</a>{tc.period}{sp}{copy.nlbAnimal}{sp}<a href={dataset('nlb-mc-rtt')}>{copy.datasetPage}</a> · <a href={creditsHref}>{copy.creditsLink}</a></p>
    <p class="citation-note" data-beyond-note="nlb-audit">{copy.nlbAudit}</p>
  </section>

  <section class="topic-section" id="ds007420" aria-labelledby="opt-heading" data-beyond="ds007420">
    <div class="topic-heading"><div><p class="eyebrow">{copy.optEyebrow}</p><h2 id="opt-heading">{copy.optH2}</h2><p class="topic-subtitle" data-subtitle="ds007420">{copy.optLabel}{zh && <span class="note-original" lang="en">{opt.label}</span>}</p></div><p><Parts p={copy.optLede()}/></p></div>
    <div class="evidence-grid" data-beyond-cards="ds007420">{copy.optCards.map(x => <article class="evidence-card"><p class="eyebrow">{x.h}</p><div class="reading"><Parts p={x.v()}/></div><p><Parts p={x.p()}/></p></article>)}</div>
    <p class="protocol-note" data-beyond-note="ds007420-limits">{copy.optLimits}</p>
    <p class="roadmap-p" data-beyond-note="ds007420-gates"><Parts p={copy.optGates()}/></p>
    <p class="citation-note" data-beyond-note="ds007420-source">{sources.opt.text}{sources.opt.names ? <><span lang="en">{sources.opt.names}</span>，</> : ' '}<code>{sources.opt.version}</code>{zh ? '，' : ', '}<a href={sources.opt.licenceUrl} target="_blank" rel="noreferrer">{sources.opt.licence}</a>{tc.period}{sp}<a href={dataset('ds007420')}>{copy.datasetPage}</a> · <a href={creditsHref}>{copy.creditsLink}</a></p>
    <p class="citation-note" data-beyond-note="ds007420-audit">{copy.optAudit}</p>
  </section>

  <section class="topic-section" id="status-only" aria-labelledby="status-heading" data-beyond="status-only">
    <div class="topic-heading"><div><p class="eyebrow">{copy.soEyebrow}</p><h2 id="status-heading">{copy.soH2}</h2></div><p>{copy.soLede}</p></div>
    <div class="method-grid-wide">
      <article class="status-entry" id="falcon-h2" data-beyond-status="falcon-h2">
        <h3 lang="en">{falcon.name}</h3>
        <p><strong>{copy.falconState}</strong>{sp}{copy.falconMeta}{tc.period}{sp}<code>{VERSION.falcon}</code>{zh ? '，' : ', '}<a href={D['falcon-h2'].rights.licenseUrl} target="_blank" rel="noreferrer">{D['falcon-h2'].rights.license}</a>{tc.period}</p>
        <p><Parts p={copy.falconPrep()}/></p>
        <p>{copy.falconFacts}</p>
      </article>
      <article class="status-entry" id="rabut-fus" data-beyond-status="rabut-fus">
        <h3 lang="en">{fus.name}</h3>
        <p><strong>{copy.fusState}</strong>{sp}{copy.fusMeta}{tc.period}{sp}<code>{VERSION.fus}</code>{zh ? '，' : ', '}<a href={D['rabut-fus'].rights.licenseUrl} target="_blank" rel="noreferrer">{D['rabut-fus'].rights.license}</a>{tc.period}</p>
        <p><Parts p={copy.fusPrep()}/></p>
        <p>{copy.fusFacts}</p>
      </article>
    </div>
    <p class="protocol-note" id="ds007420-classifier" data-beyond-hold="ds007420-classifier"><strong>{hold!.item[locale]} · {hold!.state[locale]}{tc.period}</strong>{sp}{hold!.outcome[locale]}{sp}<a href={hrefFor(`/releases/#hold-${hold!.id}`, locale)}>{copy.holdLink}</a></p>
  </section>

  <section class="topic-section" id="methods-and-limits" aria-labelledby="limits-heading">
    <div class="topic-heading"><div><p class="eyebrow">{tc.methodsEyebrow}</p><h2 id="limits-heading">{copy.limitsH2}</h2></div></div>
    <h3 class="roadmap-h3">{copy.methodsH3}</h3>
    <div class="method-grid-wide" data-beyond-note="methods">{copy.methods().map(([h, p]) => <article><h3>{h}</h3><p><Parts p={p}/></p></article>)}</div>
    <h3 class="roadmap-h3">{copy.intervalsH3}</h3>
    <p class="roadmap-p" data-beyond-note="intervals"><Parts p={copy.intervals()}/></p>
    <h3 class="roadmap-h3">{copy.limitsH3}</h3>
    <ul class="rd-rules" data-beyond-note="limits">{copy.limits.map(x => <li>{x}</li>)}</ul>
    <h3 class="roadmap-h3">{copy.notPubH3}</h3>
    <p class="roadmap-p" data-beyond-note="not-published">{copy.notPub}{sp}<a href="/data-use/#small-cohorts-pilots">{copy.smallCohorts}</a></p>
    <h3 class="roadmap-h3">{copy.creditsH3}</h3>
    <div class="citation-list" id="credits">{credits.map(x => <article data-credit={x.id}>
      <h3 lang="en">{x.r.name}</h3>
      <p lang="en">{x.r.attribution}</p>
      <p data-consent={x.id}><strong>{x.animal ? copy.animalH : copy.consentH}</strong>{zh ? '' : ' '}{x.ethics}{zh ? '' : ' '}{x.animal ? copy.consentNA : x.consent}{x.archive && <>{zh ? '' : ' '}{copy.archiveNote}</>}{zh && <span class="note-original" lang="en">{x.e.ethics_approval.statement} {x.e.informed_consent.statement}</span>}</p>
      <p><a href={x.r.source} target="_blank" rel="noreferrer">{copy.recordLink}</a>{x.paper && <> · <a href={x.paper} target="_blank" rel="noreferrer">{copy.paperLink}</a></>} · <a href={x.r.licenseUrl} target="_blank" rel="noreferrer">{x.r.license}</a>{x.readFrom ? <> · <a href={x.readFrom} target="_blank" rel="noreferrer">{copy.readFrom}</a></> : <> · {copy.readFromPaper}</>}</p>
    </article>)}</div>
    <p class="citation-note">{copy.derived}</p>
    <p class="citation-note">{tc.dataSource} <a href="/data/beyond-scalp-update.json" download>beyond-scalp-update.json</a> · {tc.schema} {beyond.schema_version}{tc.period}</p>
  </section>

  <section class="topic-section" id="related" aria-labelledby="related-heading">
    <div class="topic-heading"><div><h2 id="related-heading">{copy.relatedH2}</h2></div></div>
    <ul class="rd-rules" data-beyond-note="related">{copy.related.map(x => <li>{x.text}<a href={hrefFor(x.href, locale)}>{x.link}</a>{/[?？]$/.test(x.link) ? '' : zh ? '。' : '.'}</li>)}</ul>
  </section>
</TopicLayout>
