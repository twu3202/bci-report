---
/**
 * Do simple baselines work on signals other than scalp EEG? (owner decision 1, 2026-10-12): the non-scalp batch, each
 * result its own species, signal and metric — human fNIRS on Bak et al.'s executed finger and foot tapping, a person
 * left out at a time; one macaque's motor-cortex spiking on MC_RTT, finger velocity within one session; and a numerical
 * coverage check of the ds007420 fNIRS recordings. FALCON H2 and Rabut et al.'s functional ultrasound are prepared and
 * not scored, and the ds007420 classifier is held. In "Other signals & pilots", with the pilot studies.
 *
 * Every figure is a leaf of beyond-scalp-update.json, printed with data-fig (Fig.astro) and re-read by
 * check-workbench.mjs. Rules, from the handoff, its review and the manifest: aggregates only; each section names its
 * species, signal, cohort, split, observation window, comparator and metric; nothing pooled, nothing ranked, nothing
 * compared with scalp EEG; locally executed experiments, never paper-reported scores; MC_RTT's worse MAE beside its
 * better RMSE, and never an official Neural Latents Benchmark score; coverage counts never read as quality; the
 * prepared sources print counts of what was prepared and no score; the hold prints nothing. The sentences that
 * summarise the export are checked against it below, and the page refuses to build if the numbers stop supporting them.
 */
import beyond from '../../../data/beyond-scalp-update.json';
import TopicLayout from '../../../components/TopicLayout.astro';
import Fig from '../../../components/Fig.astro';
import Parts from '../../../components/Parts.astro';
import IntervalPlot from '../../../components/IntervalPlot.astro';
import { hrefFor, localeOf, localeParams, topicCards, topicChrome } from '../../../data/i18n';
import { BEYOND_ANCHOR, BEYOND_PATH, formatFig, wideFmt, type Fig as FigValue, type Fmt } from '../../../data/entities';
import { holds } from '../../../data/releases';

export const getStaticPaths = localeParams;
const locale = localeOf(Astro.params.lang);
const zh = locale === 'zh';
const tc = topicChrome[locale];
// The space between two sentences or a sentence and its link: none in Chinese, after a full-width mark.
const sp = zh ? '' : ' ';
type Part = string | FigValue;
const BSF = 'beyond-scalp-update.json';
const f = (raw: number, fmt: Fmt = 'pct1'): FigValue => ({ raw, fmt, src: BSF });
const n = (raw: number) => f(raw, 'count');
const w = (raw: number) => f(raw, wideFmt(raw));
const F = (x: FigValue) => formatFig(x);
const ans = (x: FigValue) => `[[${F(x)}]]`;
const R = beyond.results;
const bak = R['bak-fnirs-loso'], nlb = R['nlb-mc-rtt-velocity'], opt = R['ds007420-optical-coverage'];
const D = beyond.datasets as Record<string, any>;
const statusOf = (id: string) => {
  const x = beyond.status_only.find(s => s.id === id);
  if (!x) throw new Error(`beyond-scalp-eeg: no status-only entry ${id}`);
  return x as any;
};
const falcon = statusOf('falcon-h2-preparation'), fus = statusOf('rabut-fus-preparation');
const hold = holds.find(h => h.id === 'ds007420-classifier');
const exportHold = beyond.holds.find(h => h.id === 'ds007420-classifier');

// --- The facts every sentence below rests on; the page refuses to build without them. -----------------------
const need = (ok: boolean, what: string) => { if (!ok) throw new Error(`beyond-scalp-eeg: the copy says ${what}`); };
const says = (text: string, ...xs: string[]) => xs.forEach(x => need(text.includes(x), `"${x}" (the export says otherwise)`));
need(BEYOND_PATH === '/topics/beyond-scalp-eeg/' && BEYOND_ANCHOR.bak === 'bak-fnirs' && BEYOND_ANCHOR.nlb === 'mc-rtt' && BEYOND_ANCHOR.ds007420 === 'ds007420'
  && BEYOND_ANCHOR.falcon === 'falcon-h2' && BEYOND_ANCHOR.fus === 'rabut-fus' && BEYOND_ANCHOR.statusOnly === 'status-only', 'the anchors the dataset pages link to');
need(beyond.release_id === 'beyond-scalp-update-20261012' && beyond.schema_version === 'bci-report-beyond-scalp-update-v1', 'this release and schema');
need(Object.keys(R).join() === 'bak-fnirs-loso,nlb-mc-rtt-velocity,ds007420-optical-coverage', 'three results');
need(beyond.status_only.map(s => s.id).join() === 'falcon-h2-preparation,rabut-fus-preparation' && beyond.status_only.every(s => s.scores_published === false), 'two prepared sources, no score');
need(!!hold && !hold.closed && !!exportHold && hold.href === `${BEYOND_PATH}#${BEYOND_ANCHOR.ds007420}`, 'the ds007420 classifier is an open hold, linked to its section');
// Bak et al.: human fNIRS, three executed movements, every person held out once against the training prior.
const B = bak.cohort, BD = bak.design, BS = bak.signal, BA = bak.arms, BU = bak.uncertainty;
need(bak.species === 'human' && bak.modality === 'fNIRS' && bak.task.classes.length === 3 && bak.task.kind.includes('executed movement') && bak.task.kind.includes('not motor imagery'), 'human fNIRS, three executed movements, not motor imagery');
need(B.trials === B.people * B.trials_each_person && B.trials_each_person === 3 * B.trials_each_class_each_person, 'the trial counts add up');
need(BD.folds === B.people && BD.training_people === B.people - 1 && BD.training_trials === B.trials - B.trials_each_person && BD.test_trials === B.trials_each_person, 'every person held out once, trained on everyone else');
need(BS.channels === 40 && BS.observation_window_s === 15 && BS.feature_windows_s.every(([a, b]) => b - a === 5) && BS.feature_windows_s.at(-1)![1] === BS.observation_window_s
  && BS.features === BS.channels * BS.feature_windows_s.length && BS.baseline_window_s[0] === -1 && BS.baseline_window_s[1] === 0, 'three 5 s windows over the first 15 s, against the second before onset');
says(BS.channel_note, 'twenty oxy- and twenty deoxyhemoglobin');
says(bak.measured_quantity, 'mM·cm as delivered, not absolute concentrations');
says(bak.models.shrinkage_lda, 'training people only', 'no channel, feature or hyperparameter search', 'lsqr solver, automatic shrinkage, empirical training priors');
says(bak.models.source_prior, 'predicts right-hand tapping every time');
need(bak.primary_metric.chance_level === 1 / 3 && BA.source_prior.balanced_accuracy.mean === bak.primary_metric.chance_level, 'the training prior sits on chance, one in three');
need(BA.source_prior.class_recall.right_hand === 1 && BA.source_prior.class_recall.left_hand === 0 && BA.source_prior.class_recall.foot === 0, 'the prior predicts right-hand tapping every time');
need(BA.shrinkage_lda.balanced_accuracy.interval_excludes_chance && BA.shrinkage_lda.balanced_accuracy.interval_95[0] > bak.primary_metric.chance_level, 'the interval lies wholly above chance');
need(BU.draws === 2000 && BU.seed === 20261011, 'two thousand draws, one seed');
says(BU.scope, 'not a refit bootstrap', 'not an independent clinical confidence interval');
says(BU.comparator, 'every person gets the same score');
says(bak.limitations.join(' '), 'upstream preprocessing may use future samples', 'Task-correlated systemic or motion effects are not excluded', 'neither a brain-only signal nor cortical localization', 'the supplied files carry no probe coordinates', "does not reproduce the authors' within-person scores");
says(bak.independent_audit.checked, 'every input file hash', 'whole-person folds', 'recomputed without the frozen scoring code');
says(bak.independent_audit.not_checked, 'features were not regenerated', 'classifier was not refit');
need(bak.independent_audit.status === 'pass' && bak.label === 'Locally executed experiment · offline · leave one whole person out', 'the Bak label as the export words it');
// MC_RTT: one macaque, one session, interleaved stored trials; the ridge against the training mean, worse on MAE.
const N = nlb.cohort, NS = nlb.signal, NA = nlb.arms, NC = nlb.comparison.ridge_better;
need(N.animals === 1 && N.sessions === 1 && nlb.species.startsWith('macaque') && nlb.modality === 'intracortical spiking', 'one macaque, one session, intracortical spiking');
need(NC.r2_uniform_average && NC.r2_x && NC.r2_y && NC.rmse_m_per_s && NC.mae_m_per_s === false, 'the ridge is better on R² and RMSE and worse on MAE');
need(NA.ridge.r2_uniform_average > NA.training_mean.r2_uniform_average && NA.ridge.rmse_m_per_s < NA.training_mean.rmse_m_per_s && NA.ridge.mae_m_per_s > NA.training_mean.mae_m_per_s, 'the directions the flags state');
need(NS.rows_excluded === 0 && nlb.coverage.scored_share === 1 && nlb.coverage.validation_rows_scored === NS.validation_rows, 'no row excluded, every validation row scored');
need(NS.training_rows === N.training_trials * NS.retained_bins_each_trial && NS.validation_rows === N.validation_trials * NS.retained_bins_each_trial, 'the rows are the retained bins of each stored trial');
need(NS.neural_support_ms === NS.bin_ms * (NS.smoothing_bins + NS.history_lags - 1) && NS.features === N.input_neurons * NS.history_lags, 'the history support and the feature count');
need(nlb.uncertainty.kind === 'none reported', 'no interval is reported');
says(nlb.uncertainty.reason, 'temporally correlated samples from one animal in one session, not independent subjects');
says(nlb.label, 'not an official Neural Latents Benchmark score');
says(nlb.design.split, 'interleaved within the one session', 'the test file was not opened');
says(nlb.design.neurons, 'held-in neurons only', 'held-out neurons are not inputs');
says(nlb.signal.context, 'trailing spike-count history only, reset at every trial and observation gap');
says(nlb.models.ridge, 'alpha 10, Cholesky solver, with intercept', 'training-constant features dropped', 'no hyperparameter search');
says(nlb.models.training_mean, 'predicts the training rows\' mean velocity for every validation row');
says(nlb.limitations.join(' '), 'no cross-day, cross-animal or human evidence', "every figure is that animal's", 'not co-smoothing and not a latent-model comparison', 'derived offline from finger position', 'not a real-time or closed-loop controller');
says(nlb.independent_audit.checked, 'reconstructed independently of the code that produced it', 'normal equations');
says(nlb.independent_audit.not_checked, 'the stored velocity itself');
says(D['nlb-mc-rtt'].rights.task, 'targets on an 8 x 8 grid', 'primary motor cortex');
need(D['nlb-mc-rtt'].consent_and_ethics.subjects === 'animal' && D['nlb-mc-rtt'].consent_and_ethics.informed_consent.applicable === false, 'animal data: informed consent does not apply');
// ds007420: every optical value finite and positive, no constant channel; counts only, the classifier held.
const O = opt.cohort, K = opt.counts, G = opt.gates;
need(opt.species === 'human' && opt.modality === 'fNIRS' && O.recordings_excluded === 0 && O.recording_channels === O.recordings * O.channels_each_recording
  && K.optical_values === O.channels_each_recording * O.optical_time_points, 'every channel at every time point of every recording, none excluded');
need(K.finite === K.optical_values && K.positive === K.optical_values && K.zero === 0 && K.negative === 0 && K.nonfinite === 0 && K.constant_channels === 0
  && opt.shares.finite === 1 && opt.shares.positive === 1, 'every value finite and positive, no constant channel');
need(G.classifier === 'held' && G.task_code_lookup_verified === false && G.event_duration_s.events_table !== G.event_duration_s.optical_files && G.event_duration_s.optical_files !== G.event_duration_s.cited_paper, 'the classifier is held: no verified task-code lookup, durations that disagree');
says(opt.limitations.join(' '), 'not signal-to-noise, scalp coupling, saturation, motion', 'cannot establish signal quality', 'optical coverage does not repair them');
says(opt.definitions, 'with no tolerance');
says(D.ds007420.rights.task, 'Resting state, left- and right-hand ball squeezing and instructed head and face movements');
says(opt.independent_audit.not_checked, 'raw-signal pass was not repeated');
need(opt.label === 'Locally executed check · label-independent · counts only', 'the ds007420 label as the export words it');
// The prepared sources: counts of what was prepared, and the facts that bound them.
const P2 = falcon.preparation, P3 = fus.preparation;
need(P2.participants === 1 && P2.minival_trials_also_in_calibration === P2.minival_trials && P2.training_candidate_trials === P2.held_in_calibration_trials - P2.minival_trials
  && P2.ctc_classes_with_blank === P2.symbols + 1, 'one participant; every minival trial inside the calibration data; the cleaned set; the blank');
says(falcon.reason, 'no model has been fitted');
says(falcon.facts.join(' '), 'exposed, not blinded', 'not be the official FALCON cross-day score', 'not independent evaluation data');
need(P3.participants === 1 && P3.runs === P3.drawing_runs + P3.guitar_runs + P3.mixed_speech_reading_runs && P3.frames === P3.rest_frames + P3.activity_frames
  && P3.guitar_runs === 1 && P3.mixed_speech_reading_runs === 1, 'one person, nine runs, the frames split into rest and activity');
says(fus.reason, 'no Doppler value has been read and no decoder has been fitted');
says(fus.facts.join(' '), 'One person, not nine participants', 'no verified individual meaning', 'nominal block durations', 'not pooled into one task');
need(D['rabut-fus'].rights.license === 'CC BY-NC 4.0' && D['falcon-h2'].rights.license === 'CC BY 4.0', 'the prepared sources\' licences');
// The version identifiers the sections print, each the export's own.
const VERSION = { bak: 'doi:10.6084/m9.figshare.9783755.v2', nlb: 'DANDI 000129 · 0.241017.1444', ds007420: 'OpenNeuro ds007420 · 1.0.5', falcon: 'DANDI 000950 · 0.241029.1403', fus: 'doi:10.22002/f3y3k-em558' };
need(D['bak-fnirs'].rights.source.endsWith('10.6084/m9.figshare.9783755.v2') && D['nlb-mc-rtt'].rights.source.endsWith('dandi.000129/0.241017.1444')
  && D.ds007420.rights.source.endsWith('openneuro.ds007420.v1.0.5') && D['falcon-h2'].rights.source.endsWith('dandi.000950/0.241029.1403')
  && D['rabut-fus'].rights.source.endsWith('10.22002/f3y3k-em558'), 'the dataset versions');
need(D['bak-fnirs'].rights.license === 'CC BY 4.0' && D['nlb-mc-rtt'].rights.license === 'CC BY 4.0' && D.ds007420.rights.license === 'CC0-1.0', 'the licences');
// Each source's paper, as its rights record names it.
const PAPER: Record<string, string | null> = {
  'bak-fnirs': 'https://doi.org/10.3390/electronics8121486', 'nlb-mc-rtt': 'https://arxiv.org/abs/2109.04463',
  ds007420: 'https://doi.org/10.1117/1.NPh.10.2.025007', 'falcon-h2': null, 'rabut-fus': 'https://doi.org/10.1126/scitranslmed.adj3143',
};
for (const [id, url] of Object.entries(PAPER)) if (url) need(D[id].rights.reviewBasis.includes(url) || D[id].rights.attribution.includes(url.replace('https://doi.org/', '')), `${id}'s paper`);

// --- What the charts draw. ---------------------------------------------------------------------------------------
const lda = BA.shrinkage_lda.balanced_accuracy, prior = BA.source_prior.balanced_accuracy;
const chance = bak.primary_metric.chance_level;
const r2Keys = ['r2_uniform_average', 'r2_x', 'r2_y'] as const;
const r2Domain: [number, number] = [-0.1, 0.3], errDomain: [number, number] = [0, 0.08];
for (const arm of [NA.ridge, NA.training_mean]) {
  for (const k of r2Keys) need(arm[k] > r2Domain[0] && arm[k] < r2Domain[1], 'every R² fits its axis, −0.1 to 0.3');
  for (const k of ['rmse_m_per_s', 'mae_m_per_s'] as const) need(arm[k] > errDomain[0] && arm[k] < errDomain[1], 'every error fits its axis, 0 to 0.08 m/s');
}

// --- Names, in both languages. ------------------------------------------------------------------------------------
const armName = {
  lda: zh ? '收缩 LDA' : 'Shrinkage LDA',
  prior: zh ? '训练集先验（对照）' : 'Training prior (comparator)',
  ridge: zh ? '基于放电计数历史的岭回归' : 'Ridge on spike-count history',
  mean: zh ? '训练集均值（对照）' : 'Training mean (comparator)',
};
const r2Name = { r2_uniform_average: zh ? 'x 与 y 的均值' : 'mean of x and y', r2_x: 'x', r2_y: 'y' };
const metricName = {
  r2_uniform_average: zh ? 'R²，x 与 y 的均值' : 'R², mean of x and y', r2_x: zh ? 'R²，x' : 'R², x', r2_y: zh ? 'R²，y' : 'R², y',
  rmse_m_per_s: zh ? 'RMSE（m/s）' : 'RMSE (m/s)', mae_m_per_s: zh ? 'MAE（m/s）' : 'MAE (m/s)',
};
const metricNote = {
  r2_uniform_average: zh ? '无单位；越高越好' : 'unitless; higher is better', r2_x: zh ? '无单位；越高越好' : 'unitless; higher is better', r2_y: zh ? '无单位；越高越好' : 'unitless; higher is better',
  rmse_m_per_s: zh ? '均方根误差；越低越好' : 'root-mean-square error; lower is better', mae_m_per_s: zh ? '平均绝对误差；越低越好' : 'mean absolute error; lower is better',
};
const nlbMetrics = ['r2_uniform_average', 'r2_x', 'r2_y', 'rmse_m_per_s', 'mae_m_per_s'] as const;

const copy = {
  en: {
    description: `Partly. Human fNIRS: ${F(f(lda.mean))} participant-macro balanced accuracy for executed tapping in people left out of training, against ${F(f(prior.mean))} for the training prior. One macaque’s spiking, one session: R² ${F(w(NA.ridge.r2_uniform_average))}, a lower RMSE but a higher MAE than the training mean. A second fNIRS dataset: every optical value finite and positive.`,
    answer: `Partly. On human fNIRS, a fixed shrinkage LDA told right-hand, left-hand and foot tapping apart in people it never saw: with each of ${ans(n(B.people))} people left out in turn, its participant-macro balanced accuracy was ${ans(f(lda.mean))} (95% interval ${ans(f(lda.interval_95[0]))} to ${ans(f(lda.interval_95[1]))}), well above the training prior’s ${ans(f(prior.mean))}. These were executed movements, not motor imagery, and systemic or motion effects are not excluded. On one macaque’s motor-cortex spiking, a ridge decoder recovered part of the finger velocity on held-out trials of the same session: R² ${ans(w(NA.ridge.r2_uniform_average))} against ${ans(w(NA.training_mean.r2_uniform_average))} for the training mean, and a lower root-mean-square error, but a higher mean absolute error (${ans(w(NA.ridge.mae_m_per_s))} against ${ans(w(NA.training_mean.mae_m_per_s))} m/s). On a second fNIRS dataset, a numerical coverage check finds all ${ans(n(K.optical_values))} optical values finite and positive.`,
    eyebrow: 'Other signals · human fNIRS and macaque intracortical spiking',
    dek: 'Three analyses: executed finger and foot tapping, classified from human fNIRS in people left out of training; finger velocity, decoded from one macaque’s motor-cortex spiking within one session; and a numerical check of every optical value in a second human fNIRS dataset. Two more sources are prepared, not yet scored.',
    // Bak
    bakEyebrow: 'Human · fNIRS · executed movement · Bak et al.',
    bakH2: 'fNIRS: which movement did a person the classifier never saw make?',
    bakLabel: bak.label,
    bakLede: (): Part[] => [n(B.people), ' people each tapped the fingers of the right hand, the fingers of the left hand or a foot when cued: executed movement, not motor imagery. That is ', n(B.trials), ' trials, ', n(B.trials_each_person), ' per person and ', n(B.trials_each_class_each_person), ' of each class. The signals are the supplied oxy- and deoxyhemoglobin series, ', n(BS.channels), ' channels in mM·cm as delivered, not absolute concentrations. Each person is held out once: a fixed classifier is fitted on the other ', n(BD.training_people), ' people’s ', n(BD.training_trials), ' trials and predicts all ', n(BD.test_trials), ' of the held-out person’s, from the first ', n(BS.observation_window_s), ' s after each task onset. The comparator is the training prior, which predicts the most frequent training class every time.'],
    bakPlotCaption: 'Participant-macro balanced accuracy for a person left out of training.',
    bakPlotLegend: 'Dot: the mean over people, each weighted equally; line: the classifier’s descriptive 95% interval; dashed line: chance, one in three.',
    bakRegion: 'Bak et al. fNIRS, balanced accuracy and class recall, scrolls horizontally',
    bakCaption: (): Part[] => ['Participant-macro balanced accuracy: each held-out person’s mean of the three class recalls, averaged over the ', n(B.people), ' people with equal weight; chance is ', f(chance), '. Class recall is computed over all held-out trials of every person together, the same number in each class: a secondary point estimate, without an interval.'],
    colDecoder: 'Decoder',
    colBa: 'Balanced accuracy',
    colRecall: { right_hand: 'Recall · right hand', left_hand: 'Recall · left hand', foot: 'Recall · foot' },
    ldaNote: 'standardization and shrinkage LDA, fitted on the training people only',
    priorNote: 'predicts right-hand tapping every time: the classes are balanced, and ties go to the fixed class order',
    noInterval: 'no interval: every person gets the same score',
    bakFindLabel: (): Part[] => ['Shrinkage LDA, participant-macro balanced accuracy, ', n(B.people), ' people each held out once; the training prior scores ', f(prior.mean)],
    bakFindH3: 'Well above the training prior, in people the classifier never saw',
    bakFindP: (): Part[] => ['Its descriptive interval, ', f(lda.interval_95[0]), ' to ', f(lda.interval_95[1]), ', lies wholly above chance. The interval resamples the fixed participant scores, ', n(BU.draws), ' draws: it describes variation between people given the fitted folds, and because the folds share training people it is not a refit bootstrap and not an independent clinical confidence interval.'],
    bakLimits: 'The supplied series’ upstream preprocessing may use future samples, so the result does not apply to online control or a device’s response time. It does not establish a brain-only signal or cortical localization: task-correlated systemic or motion effects are not excluded, and the supplied files carry no probe coordinates. The protocol is this site’s own and does not reproduce the authors’ within-person scores.',
    bakSource: 'Data: Sujin Bak, Jinwoo Park, Jaeyoung Shin and Jichai Jeong,',
    bakAudit: 'Independently audited: every input file hash, the marker-to-label order, whole-person folds, training-only scaling, the comparator’s tie rule and prediction alignment checked, and the class recalls, the mean and the interval recomputed without the frozen scoring code. The features were not regenerated from the raw channels, and the classifier was not refit.',
    // MC_RTT
    nlbEyebrow: 'Macaque · intracortical spiking · MC_RTT (Neural Latents Benchmark)',
    nlbH2: 'Spikes: how much finger velocity does a linear decoder recover within one session?',
    nlbLabel: nlb.label,
    nlbLede: (): Part[] => ['One rhesus macaque made self-paced reaches to targets on a grid while an electrode array in primary motor cortex recorded sorted units, in one session. A fixed ridge decoder reads the spike counts of the ', n(N.input_neurons), ' held-in neurons (the benchmark’s ', n(N.unused_neurons), ' held-out neurons are not inputs) in ', n(NS.bin_ms), ' ms bins, with ', n(NS.neural_support_ms), ' ms of trailing history, and predicts the x/y finger velocity ', n(NS.target_lag_ms), ' ms later. It is fitted on the session’s stored ', n(N.training_trials), ' training trials and scored on its ', n(N.validation_trials), ' validation trials, interleaved with them in time: ', n(NS.training_rows), ' and ', n(NS.validation_rows), ' rows, none excluded. The comparator is the training mean: the training rows’ mean velocity, predicted for every row.'],
    r2Caption: 'R² on the validation trials, for x, y and their mean: the ridge against the training mean.',
    r2Legend: 'Dot: the value; dashed line: an R² of zero. Higher is better.',
    rmseCaption: 'RMSE on the validation trials, in m/s: lower is better.',
    rmseLegend: 'Dot: the value; dashed line: the training mean’s RMSE.',
    maeCaption: 'MAE on the validation trials, in m/s: lower is better.',
    maeLegend: 'Dot: the value; dashed line: the training mean’s MAE.',
    rowR2: (arm: string, k: typeof r2Keys[number]) => `${arm} · ${r2Name[k]}`,
    nlbRegion: 'MC_RTT, every published metric for the ridge and the training mean, scrolls horizontally',
    nlbCaption: (): Part[] => ['Every published metric on the ', n(NS.validation_rows), ' validation rows, with the arm that is better on it. R² is unitless; RMSE and MAE are in m/s.'],
    colMetric: 'Metric',
    colRidge: 'Ridge on spike-count history',
    colMean: 'Training mean (comparator)',
    colBetter: 'Better on this metric',
    betterRidge: 'The ridge',
    betterMean: 'The training mean: the ridge’s error is larger',
    nlbFindLabel: (): Part[] => ['R², mean of x and y, ridge on spike-count history; the training mean scores ', w(NA.training_mean.r2_uniform_average)],
    nlbFindH3: 'A lower squared error, but a higher absolute error',
    nlbFindP: (): Part[] => ['The ridge lowers the root-mean-square error from ', w(NA.training_mean.rmse_m_per_s), ' to ', w(NA.ridge.rmse_m_per_s), ' m/s, but its mean absolute error is higher, ', w(NA.ridge.mae_m_per_s), ' against ', w(NA.training_mean.mae_m_per_s), ' m/s: it is not better on every metric. No interval is reported: the validation rows are temporally correlated samples from one animal in one session, not independent subjects.'],
