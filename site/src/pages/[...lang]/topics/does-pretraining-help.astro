---
import rawData from '../../../data/deployment-topics.json';
import TopicLayout from '../../../components/TopicLayout.astro';
import ScoreBar from '../../../components/ScoreBar.astro';
import IntervalPlot from '../../../components/IntervalPlot.astro';
import { type DeploymentData, type DeploymentRow, datasetLabel, intervalPct, intervalPp, modelLabel, pct, pp, seedProtocolLabel } from '../../../data/topics';
import { chrome, localeOf, localeParams, topicCards, topicChrome } from '../../../data/i18n';
import { coreExposure } from '../../../data/foundation-models';
import { formatFig } from '../../../data/entities';
import { betaBest, sleepAboveAll, sleepBest, SLEEP } from '../../../data/foundation-topics';
import PretrainingV9 from '../../../components/PretrainingV9.astro';
import mvp from '../../../data/mvp.json';

export const getStaticPaths = localeParams;
const locale = localeOf(Astro.params.lang);
const tc = topicChrome[locale];

const data = rawData as unknown as DeploymentData;
const fixed = data.rows.filter(row => row.track === 'pretraining-attribution-fixed');
const selected = data.rows.filter(row => row.track === 'pretraining-attribution-selected');
const contrasts = data.paired_contrasts.filter(row => row.track.startsWith('pretraining-attribution-'));
const controls = data.rows.filter(row => row.track === 'fixed-classical-control');
const models = ['labram','cbramod'];
const datasets = ['ds003810','physionet-eegmat-1.0.0'];
const score = (rows: DeploymentRow[], model: string, dataset: string, initialization: string) => rows.find(row => row.model === model && row.dataset_id === dataset && row.initialization === initialization)!;
const contrast = (track: string, model: string, dataset: string) => contrasts.find(row => row.track === track && row.model === model && row.dataset_id === dataset)!;
const control = (dataset: string) => controls.find(row => row.dataset_id === dataset)!;
const ipp = (i: [number, number], d = 2) => intervalPp(i, d, locale);
// Figures the short answer and the key figure name. All from the reviewed export.
const fixedTrack = 'pretraining-attribution-fixed', selectedTrack = 'pretraining-attribution-selected';
const cbMi = contrast(fixedTrack, 'cbramod', 'ds003810');
const cbWl = contrast(fixedTrack, 'cbramod', 'physionet-eegmat-1.0.0');
const lbWl = contrast(fixedTrack, 'labram', 'physionet-eegmat-1.0.0');
const lbMi = contrast(fixedTrack, 'labram', 'ds003810');
const lbMiSel = contrast(selectedTrack, 'labram', 'ds003810');
const nMi = lbMi.participants, nWl = lbWl.participants;
const d2 = (row: { difference: number }) => pp(row.difference, 2);
// The answer describes these intervals in words; fail the build if the export stops saying so.
const [lbMiLo, lbMiHi] = lbMi.paired_participant_bootstrap_95;
if (!(lbMiLo < 0 && lbMiHi > 0) || !(lbMiSel.paired_participant_bootstrap_95[1] < 0)
    || ![cbMi, cbWl, lbWl].every(row => row.paired_participant_bootstrap_95[0] > 0))
  throw new Error('does-pretraining-help: the short answer no longer matches the paired intervals in the export');
// The v9 frozen encoders (2026-10-04), as the short answer summarises them: the new rows above every
// released sleep row, in the export's order, and the two released rows they are read against.
const v9Above = sleepAboveAll.map(r => r.cell);
const v9Names = (zh: boolean) => v9Above.map(r => r.model.name).reduce((s, n, i, xs) => i === 0 ? n : `${s}${zh ? '、' : i === xs.length - 1 ? ' and ' : ', '}${n}`, '');
const v9Figs = v9Above.map(r => `[[${formatFig(r.primary!)}]]`).join(locale === 'zh' ? '、' : ', ');
const v9Sleep = mvp.tracks.find(t => t.id === SLEEP)!.subjects;
const v9Best = formatFig(sleepBest.ba), v9Cca = formatFig(betaBest.ba);
const span = 0.12;
// Axis in percentage points; the unit is in the legend, so the ticks fit a phone-width strip.
const ticks = [-span, -span / 2, 0, span / 2, span].map(v => v === 0 ? '0' : pp(v, 0).replace(' pp', '')) as [string, string, string, string, string];

const copy = {
  en: {
    description: `Sometimes. Frozen pretrained CBraMod beat random initialization on MI/rest (${d2(cbMi)}) and mental workload (${d2(cbWl)}); LaBraM on workload only. Of sixteen further encoder checkpoints, ${v9Above.length === 3 ? 'three' : v9Above.length} lie above every published sleep-staging row; none lies above training-free CCA on BETA.`,
    answer: `Sometimes, depending on the encoder and the task: with frozen encoders and the fixed readout, pretrained CBraMod beat the mean of its three random initializations by [[${d2(cbMi)}]] of balanced accuracy on MI/rest ([[${nMi}]] people) and by [[${d2(cbWl)}]] on mental workload ([[${nWl}]] people), and pretrained LaBraM beat its own by [[${d2(lbWl)}]] on mental workload, each with a paired 95% interval above zero. On MI/rest, LaBraM's difference was [[${d2(lbMi)}]] (interval crosses zero), and [[${d2(lbMiSel)}]] under the train-selected readout (interval wholly below zero). Neither benchmark is in LaBraM's or CBraMod's published pretraining list (checked 2026-10-04) — what the authors' lists show, not proof that the recordings were never seen — and the comparison does not establish a benefit on other tasks or adaptation budgets. Eleven further foundation models swapped into the same frozen recipe on 4 October 2026 answer a narrower question, with no random-initialization control: on sleep staging ([[${v9Sleep}]] people) ${v9Names(false)} (${v9Figs}) lie above every published row, spectral ridge at [[${v9Best}]] included; on BETA none lies above training-free CCA ([[${v9Cca}]]); and on EEGMAT the frozen readouts and LoRA put the encoders in different orders, so none is ranked.`,
    plotCaption: `Pretrained minus random: MI/rest, ${nMi} people; mental workload, ${nWl} people.`,
    plotLegend: 'Difference in participant-mean balanced accuracy, in percentage points (pp): pretrained encoder minus the mean of three random initializations, same frozen architecture and splits. Dot: the difference; line: paired participant bootstrap 95% interval, printed under each label; dashed line: zero, no difference. Dark rows use the fixed readout, rust rows the train-selected readout.',
    readout: { fixed: 'Fixed readout', selected: 'Train-selected readout' },
    eyebrow: 'Representation controls · matched frozen encoders',
    dek: 'Sometimes. CBraMod gains under both readout settings on both tasks; LaBraM gains on mental workload and does not on MI/rest. These are matched frozen-encoder results, conditional on the tasks, splits and three constructor-random initializations—not a universal model ranking. Since 4 October 2026 the page also carries eleven further foundation models in the same frozen recipe: a narrower question, with no random-initialization control.',
    settings: { fixed: 'Fixed head · alpha 100', selected: 'Train-selected head · alpha 100 / 10,000 / 1' },
    contrastEyebrow: 'Paired attribution contrasts',
    contrastH2: 'Pretrained minus random, with the head held honest',
    contrastLede: 'Each constructor-random architecture is averaged over three initialization seeds. Pretrained and random encoders share the same splits, pooling and ridge readout protocol.',
    contrastRegion: 'Pretraining attribution contrasts, scrolls horizontally',
    contrastCaption: 'Difference in participant-mean balanced accuracy. Intervals are paired participant bootstraps, conditional on three random initializations.',
    colTaskModel: 'Task / model', colFixed: 'Fixed alpha 100', colSelected: 'Train-selected alpha',
    contrastLabel: (v: string) => `${v} pretraining contrast`,
    scoresEyebrow: 'Measured scores',
    scoresH2: 'Both readout settings stay visible',
    scoresLede: 'Head selection uses only inner training participants. Showing both settings prevents a test score from choosing the adaptation budget after the fact.',
    scoresRegion: (label: string) => `${label} pretrained and random encoder scores, scrolls horizontally`,
    scoresCaption: (label: string) => `${label} · participant-mean balanced accuracy.`,
    colPretrained: 'Pretrained encoder', colRandom: 'Random encoder mean', colDelta: 'Paired difference',
    threeInits: '3 initializations',
    controlEyebrow: 'Fixed classical control',
    baLabel: (v: string) => `${v} balanced accuracy`,
    seedEyebrow: 'Training-seed sensitivity',
    seedH2: 'A spread is not a confidence interval',
    seedLede: 'Five existing EEGNet protocols were rerun with three fixed MPS seeds. The range is a small-sample training sensitivity check; it does not replace the published point estimate or describe population uncertainty.',
    seedRegion: 'EEGNet three-seed sensitivity results, scrolls horizontally',
    seedCaption: 'Balanced accuracy across three training seeds. Sample SD and full range are percentage points.',
    colProtocol: 'Protocol', colRuns: 'Three runs', colMean: 'Mean', colSd: 'Sample SD', colRange: 'Full range',
    trials: 'trials',
    seedSources: 'Dataset authors, versions, licenses and source records for all four seed-sensitivity datasets are listed under ',
    seedSourcesLink: 'Data use & privacy → Sources in this release',
    limitsH2: 'What a positive contrast establishes',
    limitsLede: 'These controls narrow one question: whether the pretrained initialization helps this frozen architecture, split and readout relative to constructor-random encoders.',
    limits: [
      ['Fixed versus selected heads', 'The primary head fixes ridge alpha at 100. The sensitivity setting selects among 100, 10,000 and 1 using inner training participants only. Both are reported.'],
      ['Three seeds, one cohort', 'The random baseline averages three encoder initializations. Those are not three independent datasets, and the participant bootstrap does not include unrestricted retraining uncertainty.'],
      ['Task-specific evidence', 'MI/rest contains 10 participants and 1,200 trials; mental workload contains 36 participants and 2,160 trials. A method can rank only within a compatible protocol.'],
      ['Exposure: the authors’ lists, not a proof', 'Neither ds003810 nor EEGMAT is in LaBraM’s or CBraMod’s published pretraining list, checked on 4 October 2026 (sources below). That is what the authors’ lists show, not proof that these recordings were never seen. The comparison also does not certify a universal benefit across tasks or adaptation budgets.'],
    ],
    exposureSources: (date: string) => `Pretraining lists, checked ${date}:`,
    miTitle: 'MI / rest · OpenNeuro ds003810 v2.0.2',
    wlTitle: 'Mental workload · EEGMAT 1.0.0',
    physionetRecord: 'PhysioNet record ↗',
  },
  zh: {
    description: `有时有用。冻结编码器下，预训练 CBraMod 在运动想象/静息（${d2(cbMi)}）和脑力负荷（${d2(cbWl)}）上都优于随机初始化；LaBraM 只在脑力负荷上如此。另外 16 个编码器检查点中，有 ${v9Above.length} 个高于睡眠分期上所有已发布的行；在 BETA 上没有一个高于免训练的 CCA。`,
    answer: `有时有用，取决于编码器和任务：在编码器冻结、固定分类头的设置下，预训练 CBraMod 的平衡准确率比三次随机初始化的均值高 [[${d2(cbMi)}]]（百分点；运动想象/静息，[[${nMi}]] 名被试）和 [[${d2(cbWl)}]]（脑力负荷，[[${nWl}]] 名被试），预训练 LaBraM 在脑力负荷上高 [[${d2(lbWl)}]]，这三项的配对 95% 区间都在零以上。在运动想象/静息上，LaBraM 的差值为 [[${d2(lbMi)}]]，区间跨过零；换成训练集内选定分类头时为 [[${d2(lbMiSel)}]]，区间整体低于零。这两个基准数据集都不在 LaBraM 或 CBraMod 作者公开的预训练数据清单中（2026-10-04 核查）——这是作者清单所显示的情况，并不证明这些记录从未被模型见过；这项比较也不能证明预训练在其他任务或其他适配预算下同样有益。另外 11 个基础模型于 2026 年 10 月 4 日换进同样的冻结方案，回答的是一个更窄的问题，也没有随机初始化对照：在睡眠分期上（[[${v9Sleep}]] 名被试），${v9Names(true)}（${v9Figs}）高于所有已发布的行，包括 spectral ridge 的 [[${v9Best}]]；在 BETA 上，没有一个高于免训练的 CCA（[[${v9Cca}]]）；在 EEGMAT 上，冻结读出与 LoRA 给出的编码器顺序不一致，所以不排名。`,
    plotCaption: `预训练减随机初始化：运动想象/静息 ${nMi} 名被试，脑力负荷 ${nWl} 名被试。`,
    plotLegend: '被试平均平衡准确率之差，单位为百分点（pp）：预训练编码器减三次随机初始化的均值，架构冻结、数据划分相同。点为差值，横线为被试配对 bootstrap 95% 区间（数值见各行标签下方），虚线为零（没有差别）。深色行为固定分类头，锈色行为训练集内选定分类头。',
    readout: { fixed: '固定分类头', selected: '训练集内选定分类头' },
    eyebrow: '表征对照 · 匹配的冻结编码器',
    dek: '有时有用。CBraMod 在两个任务、两种分类头设置下都有提升；LaBraM 在脑力负荷上有提升，在运动想象/静息上没有。这些是匹配的冻结编码器结果，以任务、数据划分和三次随机初始化为条件——不是通用的模型排名。自 2026 年 10 月 4 日起，本页还列出另外 11 个按同样冻结方案评测的基础模型：这是一个更窄的问题，没有随机初始化对照。',
    settings: { fixed: '固定分类头 · alpha 100', selected: '训练集内选定分类头 · alpha 100 / 10,000 / 1' },
    contrastEyebrow: '预训练贡献的配对对比',
    contrastH2: '预训练减随机初始化，分类头条件保持一致',
    contrastLede: '每个随机初始化的架构都对三个初始化种子取平均。预训练与随机初始化编码器使用相同的数据划分、池化方式和岭回归分类头。',
    contrastRegion: '预训练贡献的配对对比，可横向滚动',
    contrastCaption: '被试平均平衡准确率之差。区间为被试配对 bootstrap 区间，以三次随机初始化为条件。',
    colTaskModel: '任务 / 模型', colFixed: '固定 alpha 100', colSelected: '训练集内选定 alpha',
    contrastLabel: (v: string) => `预训练带来的差值 ${v}`,
    scoresEyebrow: '实测分数',
    scoresH2: '两种分类头设置都完整列出',
    scoresLede: '分类头的超参数只在嵌套交叉验证的内层训练被试上选择。两种设置都列出，避免事后用测试分数来挑选设置。',
    scoresRegion: (label: string) => `${label}：预训练与随机初始化编码器分数，可横向滚动`,
    scoresCaption: (label: string) => `${label} · 被试平均平衡准确率。`,
    colPretrained: '预训练编码器', colRandom: '随机初始化编码器均值', colDelta: '配对差值',
    threeInits: '3 次初始化',
    controlEyebrow: '固定的经典方法对照',
    baLabel: (v: string) => `平衡准确率 ${v}`,
    seedEyebrow: '训练随机种子敏感性',
    seedH2: '波动范围不是置信区间',
    seedLede: '五个已有的 EEGNet 协议在 MPS 后端上用三个固定随机种子重新运行。这个范围只是小样本的训练敏感性检查，不取代已发布的点估计，也不描述总体层面的不确定性。',
    seedRegion: 'EEGNet 三个随机种子的敏感性结果，可横向滚动',
    seedCaption: '三个训练随机种子下的平衡准确率。样本标准差与极差的单位为百分点。',
    colProtocol: '协议', colRuns: '三次运行', colMean: '均值', colSd: '样本标准差', colRange: '极差',
    trials: '个试次',
    seedSources: '四个种子敏感性数据集的作者、版本、许可与来源记录，见',
    seedSourcesLink: `数据使用与隐私 → 本次发布的来源${chrome.zh.englishMark}`,
    limitsH2: '对比值为正能说明什么',
    limitsLede: '这些对照只回答一个更窄的问题：与随机初始化编码器相比，预训练初始化是否对这个冻结架构、这种数据划分和这个分类头有帮助。',
    limits: [
      ['固定分类头与选定分类头', '主分析把岭回归 alpha 固定为 100。敏感性分析只用内层训练被试，在 100、10,000 和 1 之间选择。两者都报告。'],
      ['三个种子，一个队列', '随机基线是三次编码器随机初始化的平均。这不是三个独立数据集，被试 bootstrap 也不包含完全重新训练带来的不确定性。'],
      ['证据只对具体任务成立', '运动想象/静息有 10 名被试、1,200 个试次；脑力负荷有 36 名被试、2,160 个试次。方法只能在相容的协议内比较排名。'],
      ['是否出现在预训练数据中：看作者的清单，不是证明', 'ds003810 与 EEGMAT 都不在 LaBraM 或 CBraMod 作者公开的预训练数据清单中，于 2026 年 10 月 4 日核查（来源见下）。这是作者清单所显示的情况，并不证明这些记录从未被模型见过。这项比较也不能证明预训练在各任务或各适配预算下普遍有益。'],
    ],
    exposureSources: (date: string) => `预训练数据清单（${date} 核查）：`,
    miTitle: '运动想象 / 静息 · OpenNeuro ds003810 v2.0.2',
    wlTitle: '脑力负荷 · EEGMAT 1.0.0',
    physionetRecord: 'PhysioNet 记录 ↗',
  },
}[locale];
const settings = [
  { key: 'fixed', label: copy.settings.fixed, rows: fixed, track: 'pretraining-attribution-fixed' },
  { key: 'selected', label: copy.settings.selected, rows: selected, track: 'pretraining-attribution-selected' },
] as const;
const card = topicCards[locale]['does-pretraining-help'];
// LaBraM's and CBraMod's published pretraining lists, as the v9 exposure table links them (owner decision 2026-10-04).
const lb = coreExposure('labram'), cb = coreExposure('cbramod');
const checked = lb.checkedOn;
const exposure = [...lb.urls.map(url => ({ label: 'LaBraM', url })), ...cb.urls.map(url => ({ label: 'CBraMod', url }))];
---
<TopicLayout
  locale={locale}
  title={card.title}
  description={copy.description}
  path="/topics/does-pretraining-help/"
  eyebrow={copy.eyebrow}
  dek={copy.dek}
  activeSlug="does-pretraining-help"
  answer={copy.answer}
>
  <IntervalPlot
    caption={copy.plotCaption}
    legend={copy.plotLegend}
    domain={[-span, span]}
    ticks={ticks}
    reference={0}
    rows={datasets.flatMap(dataset => models.flatMap(model => settings.map(setting => {
      const row = contrast(setting.track, model, dataset);
      return { label: `${modelLabel(model, locale)} · ${datasetLabel(dataset, locale)}`, note: `${copy.readout[setting.key]} · ${ipp(row.paired_participant_bootstrap_95)}`,
        tone: setting.key === 'fixed' ? 'ink' as const : 'rust' as const, value: row.difference, interval: row.paired_participant_bootstrap_95, text: d2(row) };
    })))}
  />
  <section class="topic-section" aria-labelledby="contrast-heading">
    <div class="topic-heading"><div><p class="eyebrow">{copy.contrastEyebrow}</p><h2 id="contrast-heading">{copy.contrastH2}</h2></div><p>{copy.contrastLede}</p></div>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.contrastRegion}>
      <table><caption>{copy.contrastCaption}</caption><thead><tr><th scope="col">{copy.colTaskModel}</th><th scope="col">{copy.colFixed}</th><th scope="col">{copy.colSelected}</th></tr></thead><tbody>{datasets.flatMap(dataset => models.map(model => {
        const fixedContrast = contrast('pretraining-attribution-fixed',model,dataset);
        const selectedContrast = contrast('pretraining-attribution-selected',model,dataset);
        return <tr><th scope="row">{modelLabel(model, locale)}<small>{datasetLabel(dataset, locale)} · n={fixedContrast.participants}</small></th><td><span class="metric">{pp(fixedContrast.difference, 2)}</span><span class="interval">{ipp(fixedContrast.paired_participant_bootstrap_95)}</span><ScoreBar value={Math.abs(fixedContrast.difference)} max={0.12} label={copy.contrastLabel(pp(fixedContrast.difference,2))} tone={fixedContrast.difference >= 0 ? 'olive' : 'ink'} /></td><td><span class="metric">{pp(selectedContrast.difference, 2)}</span><span class="interval">{ipp(selectedContrast.paired_participant_bootstrap_95)}</span><ScoreBar value={Math.abs(selectedContrast.difference)} max={0.12} label={copy.contrastLabel(pp(selectedContrast.difference,2))} tone={selectedContrast.difference >= 0 ? 'olive' : 'ink'} /></td></tr>;
      }))}</tbody></table>
    </div>
  </section>

  <section class="topic-section" aria-labelledby="scores-heading">
    <div class="topic-heading"><div><p class="eyebrow">{copy.scoresEyebrow}</p><h2 id="scores-heading">{copy.scoresH2}</h2></div><p>{copy.scoresLede}</p></div>
    {settings.map(setting => <div class="topic-table topic-table-spaced scroll" tabindex="0" role="region" aria-label={copy.scoresRegion(setting.label)}>
      <table><caption>{copy.scoresCaption(setting.label)}</caption><thead><tr><th scope="col">{copy.colTaskModel}</th><th scope="col">{copy.colPretrained}</th><th scope="col">{copy.colRandom}</th><th scope="col">{copy.colDelta}</th></tr></thead><tbody>{datasets.flatMap(dataset => models.map(model => {
        const pretrained = score(setting.rows,model,dataset,'pretrained');
        const random = score(setting.rows,model,dataset,'constructor-random-mean');
        const delta = contrast(setting.track,model,dataset);
        return <tr><th scope="row">{modelLabel(model, locale)}<small>{datasetLabel(dataset, locale)}</small></th><td><span class="metric">{pct(pretrained.value)}</span></td><td><span class="metric">{pct(random.value)}</span><small>{copy.threeInits}</small></td><td><span class="metric">{pp(delta.difference,2)}</span><span class="interval">{ipp(delta.paired_participant_bootstrap_95)}</span></td></tr>;
      }))}</tbody></table>
    </div>)}
    <div class="evidence-grid">{datasets.map(dataset => {
      const row = control(dataset);
      return <article class="evidence-card"><p class="eyebrow">{copy.controlEyebrow}</p><div class="reading">{pct(row.value)}</div><ScoreBar value={row.value} label={copy.baLabel(pct(row.value))} tone="ink"/><p>{modelLabel(row.model, locale)} · {datasetLabel(dataset, locale)}</p><small>{tc.interval95} {intervalPct(row.confidence_interval_95)}</small></article>;
    })}</div>
  </section>

  <section class="topic-section" aria-labelledby="seed-heading">
    <div class="topic-heading"><div><p class="eyebrow">{copy.seedEyebrow}</p><h2 id="seed-heading">{copy.seedH2}</h2></div><p>{copy.seedLede}</p></div>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.seedRegion}>
      <table><caption>{copy.seedCaption}</caption><thead><tr><th scope="col">{copy.colProtocol}</th><th scope="col">{copy.colRuns}</th><th scope="col">{copy.colMean}</th><th scope="col">{copy.colSd}</th><th scope="col">{copy.colRange}</th></tr></thead><tbody>{data.seed_sensitivity.map(group => <tr><th scope="row">{seedProtocolLabel(group.protocol, locale)}<small>n={group.participants} · {group.trials.toLocaleString('en-US')} {copy.trials}</small></th><td>{group.runs.map(run => pct(run.balanced_accuracy,2)).join(' / ')}</td><td><span class="metric">{pct(group.mean_balanced_accuracy,2)}</span></td><td>{(group.sample_standard_deviation*100).toFixed(2)} pp</td><td>{(group.full_range*100).toFixed(2)} pp<small>{pct(group.minimum,2)}–{pct(group.maximum,2)}</small></td></tr>)}</tbody></table>
    </div>
    <p class="citation-note">{copy.seedSources}<a href="/data-use/#sources">{copy.seedSourcesLink}</a>{locale === 'en' ? '.' : '。'}</p>
  </section>

  <PretrainingV9 locale={locale}/>

  <section class="topic-section" id="methods-and-limits" aria-labelledby="limits-heading">
    <div class="topic-heading"><div><p class="eyebrow">{tc.methodsEyebrow}</p><h2 id="limits-heading">{copy.limitsH2}</h2></div><p>{copy.limitsLede}</p></div>
    <div class="method-grid-wide">{copy.limits.map(([h, p]) => <article><h3>{h}</h3><p>{p}</p></article>)}</div>
    {/* The owner's sourced exposure statement (2026-10-04): the authors' lists, linked. */}
    <p class="citation-note fm-core-exposure">{copy.exposureSources(checked)} {exposure.map((x, i) => <>{i > 0 && ' · '}<a href={x.url} target="_blank" rel="noreferrer" lang="en">{x.label} ↗</a></>)}</p>
    <div class="citation-list">
      <article><h3>{copy.miTitle}</h3><p lang="en">Peterson et al. · CC0-1.0.</p><p><a href="https://doi.org/10.18112/openneuro.ds003810.v2.0.2" target="_blank" rel="noreferrer">{tc.datasetRecord}</a></p></article>
      <article><h3>{copy.wlTitle}</h3><p lang="en">Zyma et al. · Open Data Commons Attribution License 1.0.</p><p><a href="https://physionet.org/content/eegmat/1.0.0/" target="_blank" rel="noreferrer">{copy.physionetRecord}</a></p></article>
    </div>
    <p class="citation-note">{tc.dataSource} <a href="/data/deployment-topics.json" download>{tc.reviewedAggregate}</a> · {tc.schema} {data.schema_version} · {tc.generated} {data.generated_at.slice(0,10)}{tc.period}</p>
  </section>
</TopicLayout>
