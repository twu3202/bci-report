---
import TopicLayout from '../../../components/TopicLayout.astro';
import ScoreBar from '../../../components/ScoreBar.astro';
import Fig from '../../../components/Fig.astro';
import { intervalPct, pct, pp, intervalPp } from '../../../data/topics';
import { hrefFor, localeOf, localeParams, topicCards, topicChrome } from '../../../data/i18n';
import { formatFig, type Fig as FigValue } from '../../../data/entities';
import evidence from '../../../data/evidence-update.json';
import adaptation from '../../../data/adaptation-update.json';
import context from '../../../data/context-update.json';
import mvp from '../../../data/mvp.json';

export const getStaticPaths = localeParams;
const locale = localeOf(Astro.params.lang);
const tc = topicChrome[locale];
const ipp = (i: [number, number]) => intervalPp(i, 1, locale);

// New people, same task, zero labels from the test person: LaBraM adapted three
// ways, reviewed 2026-10-01. Until 2026-10-02 this sat on calibration-budget,
// under an SSVEP calibration question it does not answer — the model adapts on
// other people and never sees a label from the person it is tested on. The
// next-day question is the second half of this page's title; both of its
// sources are status only, so that half carries no figure.
//
// The 2026-09-22 export (evidence-update.json) still records the adaptation
// roadmap as 'planned', which was true when it was released, so only its
// engineering check is read from it.
const eng = evidence.roadmap.peft.engineering_check;
const ad = adaptation.results['eegmat-labram-adaptation'];
const adPeople = ad.cohort.people;
type Metric = 'balanced_accuracy' | 'macro_f1';
const contrast = (metric: Metric, id: string) => ad.paired_contrasts[metric].find(c => c.id === id)!;
const loraHead = contrast('balanced_accuracy', 'lora-r4_minus_frozen');
const blockHead = contrast('balanced_accuracy', 'last-block_minus_frozen');
const loraBlock = contrast('balanced_accuracy', 'lora-r4_minus_last-block');
const arm = (id: string) => ad.arms.find(a => a.id === id)!;
const headArm = arm('frozen'), blockArm = arm('last-block'), loraArm = arm('lora-r4');
const headBa = pct(headArm.balanced_accuracy.mean), blockBa = pct(blockArm.balanced_accuracy.mean), loraBa = pct(loraArm.balanced_accuracy.mean);
// Printed for scale beside the head-only arm: the matrix's frozen LaBraM readout
// on the same people and folds. A different head, so not a paired comparison;
// the export proves the shared folds and carries no number, so the figure is
// read from the core release that published it, marked with its file so the
// cite block names that release (check-workbench.mjs).
const matrixTrack = mvp.tracks.find(t => t.id === ad.matrix_reference.track_id)!;
const matrixRow = matrixTrack.rows.find(r => r.name === ad.matrix_reference.model && r.mode === ad.matrix_reference.training_mode)!;
const matrixFig: FigValue = { raw: matrixRow.y, fmt: 'pct1raw', src: ad.matrix_reference.file };
const matrixBa = formatFig(matrixFig);
// The adapter's size, from the engineering check that shipped in evidence-update.json.
const engFig = (raw: number): FigValue => ({ raw, fmt: 'count', src: 'evidence-update.json' });
const loraParams: FigValue = { raw: loraArm.trainable_parameters, fmt: 'count', src: 'adaptation-update.json' };
// The two next-day statuses. Neither carries a score: BNCI2015-001 is held,
// and the Stieger pilot is one person, whose every score would be theirs.
const nextDay = adaptation.status_only[0];
const nextDaySource = nextDay.name.split(' · ')[0];
// Its calibration budgets, as the export states them: day-B labels from the test person.
const budgets = nextDay.design.calibration_labels;
const series = (xs: number[], sep: string, last: string) => `${xs.slice(0, -1).join(sep)}${last}${xs[xs.length - 1]}`;
const stieger = context.status_only.find(e => e.id === 'stieger-longitudinal')!;
const stiegerSessions = stieger.feasibility.sessions;
const secs = (v: number) => `${v.toFixed(1)} s`;
const seedMeans = (a: typeof loraArm) => a.balanced_accuracy.per_seed_means.map(x => pct(x.mean)).join(' · ');
const kib = Math.round(eng.adapter_float32_bytes / 1024);
const n = (v: number) => v.toLocaleString('en-US');
const share = `${(eng.adapter_fraction * 100).toFixed(2)}%`;
type Part = string | FigValue;

const copy = {
  en: {
    description: `New people, same task, zero labels from the test person: updating LaBraM's last block reached ${blockBa} balanced accuracy and LoRA ${loraBa}, against ${headBa} for a short head-only fit, with no demonstrated difference between the two; the core matrix's frozen readout scored ${matrixBa}. The next-day experiment is held.`,
    answer: `On new people, same task, zero labels from the test person — LaBraM Base on mental arithmetic versus rest, [[${adPeople}]] people in five participant-disjoint folds — updating the last block with the head reached [[${blockBa}]] balanced accuracy and rank-4 LoRA [[${loraBa}]], against [[${headBa}]] for a short head-only fit; LoRA minus last block crosses zero, so neither is shown to be better. That head-only fit is not the best a frozen encoder can do: the core matrix's frozen LaBraM with a ridge head scored [[${matrixBa}]] on the same people and folds, a different head and not a paired comparison. The next day is not answered here: that experiment ran, but its source is held, so no figure from it is published.`,
    // The page covers both halves of its title. Only the adaptation result uses zero labels from
    // the test person — the next-day design calibrates on the person's own day-B labels — so the
    // label stays on #adaptation, the cards and the snippets, and the hero says what is on the page.
    eyebrow: 'Model adaptation · new people; next day held',
    dek: 'Which part of a pretrained encoder to update when it meets people it has not seen, on a task it is adapted to: the head only, the last block, or a low-rank adapter — with the same checkpoint, folds, starting heads, batches and five-epoch recipe for all three. The next-day version of the question has run too; its source is held, so it is listed without a figure.',
    baLabel: (v: string) => `${v} balanced accuracy`,
    rmEyebrow: 'New people, same task, zero labels from the test person · reviewed 1 October 2026',
    rmH2: 'Adapting a foundation model: head only, last block or LoRA?',
    rmLede: `LaBraM Base on EEGMAT, mental arithmetic versus rest: ${adPeople} people in five participant-disjoint folds, so every score is on people the model was not adapted on, and no label from a test person is used. The three update rules start from the same head, see the same batches in the same order and train for the same five epochs. Three seeds are averaged within each person before the cohort mean.`,
    armLabel: { frozen: 'Head only · encoder frozen', 'last-block': 'Last block + head', 'lora-r4': 'LoRA rank 4 + head' } as Record<string, string>,
    armNote: (f1: string, params: string) => `Macro F1 ${f1} · ${params} trainable parameters`,
    rmScale: ["For scale: the core matrix's frozen LaBraM, on the same people and folds but read out by a closed-form ridge head on standardized features, scored ", ' (core matrix release, ', '). The head-only arm here is a short five-epoch head on unscaled features — not the best a frozen encoder can do — and the two are not a paired comparison.'],
    findingLabel: 'LoRA minus head only, same people',
    findingH3: 'LoRA beat the short head-only fit; it did not beat the last block',
    findingP: `${loraHead.helped} of ${adPeople} people improved and ${loraHead.harmed} got worse; paired interval ${ipp(loraHead.bootstrap_95)}. Updating the last block instead gained ${pp(blockHead.mean_change, 1)} (${ipp(blockHead.bootstrap_95)}). LoRA minus last block was ${pp(loraBlock.mean_change, 1)}, interval ${ipp(loraBlock.bootstrap_95)}: it crosses zero, so neither is shown to be better. ${loraBlock.helped} people did better with LoRA, ${loraBlock.harmed} with the last block.`,
    contrastRegion: 'Paired changes between update rules, scrolls horizontally',
    contrastCaption: `Change in participant-mean score for the same ${adPeople} people under both rules · descriptive person-bootstrap 95% interval · people helped, harmed and unchanged.`,
    colContrast: 'Comparison', colBa: 'Balanced accuracy', colF1: 'Macro F1',
    contrastRow: { 'lora-r4_minus_frozen': 'LoRA − head only', 'last-block_minus_frozen': 'Last block − head only', 'lora-r4_minus_last-block': 'LoRA − last block' } as Record<string, string>,
    counts: (h: number, hm: number, t: number) => `${h} helped · ${hm} harmed · ${t} unchanged`,
    f1Note: 'On macro F1 the gains are smaller, and LoRA helps fewer people over head only than it does on balanced accuracy: the metric matters.',
    costH3: 'What each rule costs',
    costRegion: 'Trainable parameters and training time by update rule, scrolls horizontally',
    costCaption: 'Training time is the sum over 15 fits (5 folds × 3 seeds) on one Apple-silicon Mac, PyTorch MPS backend, excluding loading and evaluation.',
    colRule: 'Update rule', colParams: 'Trainable parameters', colTime: 'Training time, 15 fits', colSeeds: 'Balanced accuracy, seed by seed',
    costNote: 'LoRA trains far fewer weights than the last block but took longer here: its adapters sit in all twelve blocks, so gradients flow back through most of the encoder, and this implementation is an effective-weight parametrization, not an optimized low-rank kernel. Fewer trainable weights do not by themselves mean less time or memory.',
    notDelivered: 'Promised on the roadmap and not delivered by this batch: peak memory (only lower-bound samples were recorded, so none is published) and a comparison at a fixed computation budget (every rule trained for the same five epochs, not the same compute).',
    nextEyebrow: 'Next day · status only',
    nextH2: 'Same person, the next day: run, not published',
    nextLede: 'Whether a model fitted on one day still works on a later one, and which part to update when it does not, has no published figure here. Two sources were prepared for it; for different reasons, neither can be scored in public.',
    nextH3: 'Two recording days: run and replayed, held',
    nextP: `${nextDaySource}: ${nextDay.design.people} people recorded on two days. Each person's model is trained on day A, calibrated with the first ${series(budgets, ', ', ' or ')} labeled trials of day B under the same three update rules, and tested on the same later day-B trials. Unlike the result above, this design uses the test person's own labels: their day-B calibration trials. It ran on 22 September and passed an independent replay. The source's editorial hold stands — its catalogue licence is CC BY-NC-ND and its description names no ethics approval — so no figure from it is published.`,
    crossH3: 'Same person, later sessions: status only',
    crossP: [`${stieger.name.split(' · ')[0]}: one person's ${stiegerSessions} sessions were acquired, not the full release. What is published is that the loader and a chronological split work on it — earlier sessions train, later sessions test. With one person, every score would be that person's, so none is published; the source is listed as status only in the `, 'release of 27 September', '.'],
    rmApartH3: 'Four questions kept apart',
    rmApart: 'A new person, a new day, a new dataset and a new device are different questions, answered on different data. A task adapter trained on several people is not evidence that it transfers across devices.',
    adLimitsH2: 'What this result is not',
    adLimitsLede: 'One fixed recipe, three update rules and three seeds, on new people for a task the model is adapted to. It describes that recipe on these people; it is not a ranking of update rules.',
    adLimits: [
      ['One recipe, not a tuned ranking', 'Five epochs, AdamW at learning rate 1e-4, batch 32, with no search, validation split, early stopping or checkpoint selection. Another learning rate or training budget could reorder the rules.'],
      ['New people, not a new day or device', 'The folds hold out people on a task the model is adapted to. Nothing here measures a new recording day, a new headset or a new dataset.'],
      ['A known dataset', "EEGMAT is public, and whether it was in LaBraM's pretraining data is not certified."],
      ['Descriptive intervals', 'Person bootstrap after averaging the three seeds within each person. It ignores the dependence that shared cross-validation models create.'],
    ],
    rmEngH3: 'Adapter size',
    rmEng: (rank: number): Part[] => ['The LaBraM base encoder has ', engFig(eng.base_encoder_parameters), ` parameters. Rank-${rank} updates to its twelve fused QKV weights add `, engFig(eng.adapter_parameters), ` trainable parameters (${share}); with the `, engFig(eng.binary_head_parameters_if_added), '-parameter head that is the ', loraParams, ` above. The adapter tensors take ${kib} KiB in float32 before metadata.`],
    rmEngNote: 'These are parameter counts — not accuracy, speed, memory-saving or privacy claims.',
    rmChecksH: 'Engineering checks passed before any real-EEG run:',
    rmCheck: {} as Record<string, string>,
    engSource: 'the adapter counts and checks, from the engineering check released on 22 September',
    rmPriorH3: 'Not the first to ask',
    rmPrior: ['Other groups already benchmark EEG adapters: ', 'OpenEEGBench', ' covers parameter-efficient fine-tuning of EEG foundation models; a ', 'systematic study of test-time adaptation', ' reports inconsistent gains under distribution shift; a recent ', 'preprint', ' compares self-supervised adaptation under fixed computation budgets. Our emphasis is the calibration cost, the cases that get worse, and whether recordings are compatible at all.'],
    creditNote: (license: string) => `${license} · aggregate results only; the adaptation reuses the 2026-09-20 review of these recordings.`,
    stiegerNote: (license: string) => `${license} · status only: no figure from this source is published.`,
  },
  zh: {
    description: `新被试、同一任务、不使用测试被试的任何标签：更新 LaBraM 最后一个 Transformer 块达到 ${blockBa} 的平衡准确率，LoRA 为 ${loraBa}，只做短训练的分类头为 ${headBa}，前两者之间没有可证实的差别；核心矩阵中冻结编码器的结果为 ${matrixBa}。次日实验暂缓发布。`,
    answer: `新被试、同一任务、不使用测试被试的任何标签：LaBraM Base 区分心算与静息，[[${adPeople}]] 名被试按被试不重叠分成 5 折；连同分类头更新最后一个 Transformer 块，平衡准确率达到 [[${blockBa}]]，秩为 4 的 LoRA 为 [[${loraBa}]]，只做短训练的分类头为 [[${headBa}]]；LoRA 减最后一个 Transformer 块的区间跨过零，所以无法说明哪一个更好。只训分类头的结果并不是冻结编码器能达到的最好结果：核心矩阵中同一批被试、同一数据划分上的冻结 LaBraM 配岭回归分类头，得分 [[${matrixBa}]]，但分类头不同，也不是配对比较。第二天的问题这里没有回答：该实验已运行，但数据源处于暂缓状态，所以不发布它的任何数字。`,
    eyebrow: '模型适配 · 新被试；次日实验暂缓发布',
    dek: '预训练编码器遇到没见过的被试、而任务是它已适配过的任务时，该更新哪一部分：只训分类头、最后一个 Transformer 块，还是低秩适配器（LoRA）——三种方式的检查点、数据划分、初始分类头、批次和训练 5 轮的配方都相同。同一问题的次日版本也已运行；它的数据源处于暂缓状态，所以只列出、不给数字。',
    baLabel: (v: string) => `平衡准确率 ${v}`,
    rmEyebrow: '新被试、同一任务、不使用测试被试的任何标签 · 2026 年 10 月 1 日审核',
    rmH2: '基础模型怎么适配：只训分类头、最后一个 Transformer 块（block）还是 LoRA？',
    rmLede: `LaBraM Base 在 EEGMAT 上区分心算与静息：${adPeople} 名被试，按被试不重叠分成 5 折，所以每个分数都来自模型适配时没见过的人，也不使用测试被试的任何标签。三种更新方式从同一个分类头出发，以相同顺序看到相同的批次，都训练 5 轮（epoch）。3 个随机种子先在每名被试内平均，再求队列均值。`,
    armLabel: { frozen: '只训分类头 · 编码器冻结', 'last-block': '最后一个 Transformer 块 + 分类头', 'lora-r4': '秩为 4 的 LoRA + 分类头' } as Record<string, string>,
    armNote: (f1: string, params: string) => `宏平均 F1 ${f1} · 可训练参数 ${params} 个`,
    rmScale: ['作为参照：核心矩阵中同一批被试、同一数据划分上的冻结 LaBraM，配上在标准化特征上闭式求解的岭回归分类头，平衡准确率为 ', '（核心矩阵发布，', '）。这里「只训分类头」那一组是在未缩放特征上只训 5 轮的短训练分类头——并不是冻结编码器能达到的最好结果——两者也不是配对比较。'],
    findingLabel: 'LoRA 减只训分类头，同一批被试（pp 为百分点）',
    findingH3: 'LoRA 胜过短训练的分类头，但没有胜过最后一个 Transformer 块',
    findingP: `${adPeople} 名被试中 ${loraHead.helped} 人提升、${loraHead.harmed} 人变差；配对区间 ${ipp(loraHead.bootstrap_95)}。改为更新最后一个 Transformer 块，提升 ${pp(blockHead.mean_change, 1)}（${ipp(blockHead.bootstrap_95)}）。LoRA 减最后一个 Transformer 块为 ${pp(loraBlock.mean_change, 1)}，区间 ${ipp(loraBlock.bootstrap_95)}：跨过零，所以无法说明哪一个更好。${loraBlock.helped} 人用 LoRA 更好，${loraBlock.harmed} 人用最后一个 Transformer 块更好。`,
    contrastRegion: '各更新方式之间的配对变化，可横向滚动',
    contrastCaption: `同样 ${adPeople} 名被试在两种方式下的被试平均分数之差 · 描述性被试 bootstrap 95% 区间 · 提升、变差与不变的人数。`,
    colContrast: '比较', colBa: '平衡准确率', colF1: '宏平均 F1',
    contrastRow: { 'lora-r4_minus_frozen': 'LoRA − 只训分类头', 'last-block_minus_frozen': '最后一个 Transformer 块 − 只训分类头', 'lora-r4_minus_last-block': 'LoRA − 最后一个 Transformer 块' } as Record<string, string>,
    counts: (h: number, hm: number, t: number) => `${h} 人提升 · ${hm} 人变差 · ${t} 人不变`,
    f1Note: '在宏平均 F1 上提升更小，LoRA 相对只训分类头帮到的人也比平衡准确率上少：指标的选择会影响结论。',
    costH3: '每种方式的代价',
    costRegion: '各更新方式的可训练参数与训练时间，可横向滚动',
    costCaption: '训练时间为 15 次拟合（5 折 × 3 个随机种子）之和，在一台 Apple 芯片 Mac 上用 PyTorch MPS 后端测得，不含加载与评测。',
    colRule: '更新方式', colParams: '可训练参数', colTime: '训练时间，15 次拟合', colSeeds: '平衡准确率，逐个随机种子',
    costNote: 'LoRA 可训练的权重比最后一个 Transformer 块少得多，但这里训练反而更久：它的适配器分布在全部 12 个 Transformer 块中，梯度要反传经过编码器的大部分；而且这里的实现是等效权重参数化，不是优化过的低秩算子。可训练权重少，本身并不意味着更省时间或内存。',
    notDelivered: '路线图上承诺、但这一批没有给出的：峰值内存（只记录了下界采样，因此不发布）；以及固定计算预算下的比较（各方式训练的是相同的 5 轮，而不是相同的计算量）。',
    nextEyebrow: '次日 · 只发状态',
    nextH2: '同一个人，第二天：已运行，不发布',
    nextLede: '在某一天拟合的模型，换一天还管不管用、不管用时该更新哪一部分——这里还没有公开的数字。为它准备了两个数据源；出于不同的原因，两者都不能公开评分。',
    nextH3: '两个记录日：已运行并通过复核，暂缓发布',
    nextP: `${nextDaySource}：${nextDay.design.people} 名被试，每人记录两天。每名被试的模型用第一天训练，用第二天最前面的 ${series(budgets, '、', ' 或 ')} 个校准试次、以同样三种更新方式校准，再在第二天同一批后续试次上测试。与上面的结果不同，这个设计要用到测试被试本人的标签：其第二天的校准试次。它已于 9 月 22 日运行，并通过了独立复核。该数据源的编辑暂缓仍然有效——目录标注的许可是 CC BY-NC-ND，数据说明也没有写伦理批准——所以不发布它的任何数字。`,
    crossH3: '同一个人，之后的会话：只发状态',
    crossP: [`Stieger 纵向 BCI：获取的是一名被试的 ${stiegerSessions} 次会话，而不是完整的数据集。公开的只有一点：加载程序和按时间顺序的划分（较早的会话训练、较晚的会话测试）在它上面可以运行。只有一个人时，任何分数都是这个人的分数，所以不发布；该数据源在`, '9 月 27 日的发布', '中只列状态。'],
    rmApartH3: '刻意分开的四个问题',
    rmApart: '新被试、新的一天、新数据集、新设备是四个不同的问题，要用不同的数据回答。在多名被试上训练出的任务适配器，并不能证明它能跨设备迁移。',
    adLimitsH2: '这个结果不是什么',
    adLimitsLede: '一个固定的配方、三种更新方式、3 个随机种子，用在模型已适配过的任务的新被试上。它描述的是这个配方在这些被试上的表现，不是各更新方式的排名。',
    adLimits: [
      ['一个配方，不是调参后的排名', '5 轮，AdamW，学习率 1e-4，批大小 32；没有超参搜索、验证集、早停或检查点挑选。换一个学习率或训练预算，各方式的先后可能改变。'],
      ['新被试，不是新的一天或新设备', '数据划分留出的是被试，任务是模型已经适配过的任务。这里没有测量新的记录日、新的头戴设备或新的数据集。'],
      ['已公开的数据集', 'EEGMAT 是公开数据，它是否在 LaBraM 的预训练数据中，无法证实。'],
      ['描述性区间', '先在每名被试内平均 3 个随机种子，再做被试 bootstrap。它没有计入共享交叉验证模型带来的相关性。'],
    ],
    rmEngH3: '适配器的大小',
    rmEng: (rank: number): Part[] => ['LaBraM 基础编码器有 ', engFig(eng.base_encoder_parameters), ` 个参数。对它的 12 个融合 QKV 权重做秩为 ${rank} 的更新，增加 `, engFig(eng.adapter_parameters), ` 个可训练参数（${share}）；加上 `, engFig(eng.binary_head_parameters_if_added), ' 个参数的分类头，就是上面的 ', loraParams, ` 个。适配器张量以 float32 存储约 ${kib} KiB（不含元数据）。`],
    rmEngNote: '这些是参数计数，不代表准确率、速度、内存节省或隐私方面的任何结论。',
    rmChecksH: '在任何真实 EEG 运行之前通过的工程检查：',
    rmCheck: {
      'exact adapter save and reload': '适配器保存与重载后完全一致',
      'exact merged-weight equivalence': '合并权重后输出完全等价',
      'finite, nonzero adapter gradients in every block': '每个 Transformer 块的适配器梯度有限且非零',
      'frozen encoder weights unchanged after updates': '更新后冻结编码器的权重保持不变',
      'identical output at zero adapter initialization': '适配器零初始化时输出完全不变',
    } as Record<string, string>,
    engSource: '适配器的参数计数与检查，来自 9 月 22 日发布的工程检查',
    rmPriorH3: '这个问题已有前人研究',
    rmPrior: ['已有其他工作在评测 EEG 适配器：', 'OpenEEGBench', ' 覆盖 EEG 基础模型的参数高效微调；一项', '关于测试时适配的系统研究', '报告了分布偏移下时好时坏的收益；一篇近期', '预印本', '比较了固定计算预算下的自监督适配。我们的侧重点是校准成本、变差的情况，以及记录条件本身是否兼容。'],
    creditNote: (license: string) => `${license} · 仅发布聚合结果；本次适配沿用 2026-09-20 对这些记录的审查。`,
    stiegerNote: (license: string) => `${license} · 只发状态：不发布这个数据源的任何数字。`,
  },
}[locale];
const card = topicCards[locale]['model-adaptation'];
---
<TopicLayout
  locale={locale}
  title={card.title}
  description={copy.description}
  path="/topics/model-adaptation/"
  eyebrow={copy.eyebrow}
  dek={copy.dek}
  activeSlug="model-adaptation"
  dataFiles={['/data/adaptation-update.json']}
  answer={copy.answer}
>
  <section class="topic-section" id="adaptation" aria-labelledby="adaptation-heading">
    <div class="topic-heading"><div><p class="eyebrow">{copy.rmEyebrow}</p><h2 id="adaptation-heading">{copy.rmH2}</h2></div><p>{copy.rmLede}</p></div>
    <div class="evidence-grid">{ad.arms.map(a => <article class="evidence-card"><p class="eyebrow">{copy.armLabel[a.id]}</p><div class="reading">{pct(a.balanced_accuracy.mean)}</div><ScoreBar value={a.balanced_accuracy.mean} max={1} label={copy.baLabel(pct(a.balanced_accuracy.mean))} tone={a.id === 'frozen' ? 'ink' : 'rust'} /><p>{copy.armNote(pct(a.macro_f1.mean), n(a.trainable_parameters))}</p><small>{tc.interval95} {intervalPct(a.balanced_accuracy.bootstrap_95)}</small></article>)}</div>
    <p class="protocol-note">{copy.rmScale[0]}<Fig f={matrixFig}/>{copy.rmScale[1]}<a href={`/data/${ad.matrix_reference.file}`} download>{ad.matrix_reference.file}</a>{copy.rmScale[2]}</p>
    <div class="finding">
      <div class="finding-number"><strong>{pp(loraHead.mean_change, 1)}</strong><span>{copy.findingLabel}</span></div>
      <div class="finding-copy"><h3>{copy.findingH3}</h3><p>{copy.findingP}</p></div>
    </div>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.contrastRegion}>
      <table><caption>{copy.contrastCaption}</caption><thead><tr><th scope="col">{copy.colContrast}</th><th scope="col">{copy.colBa}</th><th scope="col">{copy.colF1}</th></tr></thead><tbody>{ad.paired_contrasts.balanced_accuracy.map(c => { const f = contrast('macro_f1', c.id); return <tr><th scope="row">{copy.contrastRow[c.id]}</th>{[c, f].map(x => <td><span class="metric">{pp(x.mean_change, 1)}</span><span class="interval">{ipp(x.bootstrap_95)}</span><span class="interval">{copy.counts(x.helped, x.harmed, x.tied)}</span></td>)}</tr>; })}</tbody></table>
    </div>
    <p class="protocol-note">{copy.f1Note}</p>
    <h3 class="roadmap-h3">{copy.costH3}</h3>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.costRegion}>
      <table><caption>{copy.costCaption}</caption><thead><tr><th scope="col">{copy.colRule}</th><th scope="col">{copy.colParams}</th><th scope="col">{copy.colTime}</th><th scope="col">{copy.colSeeds}</th></tr></thead><tbody>{ad.arms.map(a => <tr><th scope="row">{copy.armLabel[a.id]}</th><td><span class="metric">{n(a.trainable_parameters)}</span></td><td><span class="metric">{secs(a.training_seconds_15_fits)}</span></td><td><span class="interval">{seedMeans(a)}</span></td></tr>)}</tbody></table>
    </div>
    <p class="roadmap-p">{copy.costNote}</p>
    <p class="protocol-note">{copy.notDelivered}</p>
  </section>

  <section class="topic-section" id="next-day" aria-labelledby="next-day-heading">
    <div class="topic-heading"><div><p class="eyebrow">{copy.nextEyebrow}</p><h2 id="next-day-heading">{copy.nextH2}</h2></div><p>{copy.nextLede}</p></div>
    <h3 class="roadmap-h3" id="two-days">{copy.nextH3}</h3>
    <p class="roadmap-p">{copy.nextP}</p>
    <h3 class="roadmap-h3" id="cross-session">{copy.crossH3}</h3>
    <p class="roadmap-p">{copy.crossP[0]}<a href={hrefFor(`/releases/#${context.release_id}`, locale)}>{copy.crossP[1]}</a>{copy.crossP[2]}</p>
    <h3 class="roadmap-h3">{copy.rmApartH3}</h3>
    <p class="roadmap-p">{copy.rmApart}</p>
  </section>

  <section class="topic-section" id="methods-and-limits" aria-labelledby="limits-heading">
    <div class="topic-heading"><div><p class="eyebrow">{tc.methodsEyebrow}</p><h2 id="limits-heading">{copy.adLimitsH2}</h2></div><p>{copy.adLimitsLede}</p></div>
    <div class="method-grid-wide">{copy.adLimits.map(([h, p]) => <article><h3>{h}</h3><p>{p}</p></article>)}</div>
    <h3 class="roadmap-h3">{copy.rmEngH3}</h3>
    <p class="roadmap-p">{copy.rmEng(eng.rank).map(x => typeof x === 'string' ? x : <Fig f={x}/>)}</p>
    <p class="roadmap-p"><strong>{copy.rmChecksH}</strong> {eng.checks_passed.map(c => copy.rmCheck[c] ?? c).join(locale === 'zh' ? '；' : '; ')}{tc.period}</p>
    <p class="protocol-note">{copy.rmEngNote}</p>
    <h3 class="roadmap-h3">{copy.rmPriorH3}</h3>
    <p class="roadmap-p">{copy.rmPrior[0]}<a href="https://github.com/braindecode/OpenEEGBench" target="_blank" rel="noreferrer">{copy.rmPrior[1]}</a>{copy.rmPrior[2]}<a href="https://proceedings.mlr.press/v340/lee26a.html" target="_blank" rel="noreferrer">{copy.rmPrior[3]}</a>{copy.rmPrior[4]}<a href="https://arxiv.org/abs/2608.24727v1" target="_blank" rel="noreferrer">{copy.rmPrior[5]}</a>{copy.rmPrior[6]}</p>
    <div class="citation-list">
      <article><h3 lang="en">{ad.rights.name}</h3><p lang="en">{ad.rights.attribution}</p><p>{copy.creditNote(ad.rights.license)}</p><p><a href={ad.rights.source} target="_blank" rel="noreferrer">{tc.datasetRecord}</a></p></article>
      <article><h3 lang="en">{stieger.name}</h3><p lang="en">{stieger.rights.attribution}</p><p>{copy.stiegerNote(stieger.rights.license)}</p><p><a href={stieger.rights.source} target="_blank" rel="noreferrer">{tc.datasetRecord}</a></p></article>
    </div>
    <p class="citation-note">{tc.dataSource} <a href="/data/adaptation-update.json" download>adaptation-update.json</a> · {tc.schema} {adaptation.schema_version} · {tc.generated} {adaptation.generated_at}{tc.period}</p>
    <p class="citation-note">{tc.dataSource} <a href="/data/evidence-update.json" download>evidence-update.json</a> · {copy.engSource}{tc.period}</p>
  </section>
</TopicLayout>
