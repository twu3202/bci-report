---
/**
 * Route 2 of the decision-research plan, one representation and several questions (2026-10-07, owner approved):
 * can one EEG model answer several questions about the same data as well as separate models, and at what cost?
 * Its own question in "Adapting models"; when-not-to-act's roadmap marks the route run and links here.
 *
 * Every figure is a leaf of shared-representation-update.json, printed with data-fig (Fig.astro) and re-read by
 * check-workbench.mjs. Rules (handoff and review manifest of 2026-10-07): every contrast prints both flags, the
 * margin with them; a floor-gated entry is labelled, never counted, and its margin flag not read; no ranking where
 * intervals overlap; every BOAS figure sits in an element marked data-boas that holds the three gaps, the credit and
 * "pseudonymised in the public release" (BoasGaps.astro), so the short answer and the card print none; E2 sleep
 * travels with its disclosure; EESM19 is crude, one seed, with the stage sentence; secondary results sit in a
 * collapsed panel with each gate and who attached it. The sentences that summarise a table are checked against the
 * export below, and the page refuses to build if the numbers stop supporting them.
 */
import TopicLayout from '../../../components/TopicLayout.astro';
import Fig from '../../../components/Fig.astro';
import BoasGaps from '../../../components/BoasGaps.astro';
import { hrefFor, localeOf, localeParams, topicCards, topicChrome } from '../../../data/i18n';
import { formatFig, type Fig as FigValue, type Fmt } from '../../../data/entities';
import { R2, D, DELTA, P3_CUT, srFig, srPp, srLo, srRelease, qName, setupName, code, differenceText, marginText, gateText,
         attachedText, floorMarginText, inconclusiveText, srText, isLogR, isPp, ppEntry, entry, arm, gate,
         type SrEntry, type SrLogR, type SrOracle } from '../../../data/shared-encoder';

export const getStaticPaths = localeParams;
const locale = localeOf(Astro.params.lang);
const zh = locale === 'zh';
const tc = topicChrome[locale];
type Part = string | FigValue;
const f = (raw: number, fmt: Fmt = 'pct1') => srFig(raw, fmt);
const n = (raw: number) => srFig(raw, 'count');
const F = (x: FigValue) => formatFig(x);
const O = D.openbmi, B = D.boas, E = D.eesm19, E2 = B.e2_sleep;
const P = (d: typeof O | typeof B, id: string, q: string, level = 'E1') => ppEntry(d.entries, id, q, level);
const iv = (e: SrEntry): Part[] => [srLo(e.interval_95_pp[0]), ` ${tc.to} `, srPp(e.interval_95_pp[1])];
const pctIv = (x: { interval_95: [number, number] }): Part[] => [f(x.interval_95[0]), '–', f(x.interval_95[1])];

// --- The facts every sentence below rests on; the page refuses to build without them. -----------------------
const need = (ok: boolean, what: string) => { if (!ok) throw new Error(`shared-encoder: the copy says ${what}`); };
const eq = (e: SrEntry) => e.margin === 'equivalent within delta';
const near = (e: SrEntry) => e.margin === 'equivalent within delta' || e.margin === 'non-inferior';
const OR = O.route_sentence, BR = B.route_sentence;
need(!OR.supported && !BR.supported, 'the fixed-heads sentence is supported on neither domain');
need(OR.counted.join() === 'MI-A,MI-B' && !Object.keys(OR.excluded).length, 'both motor-imagery questions count');
need(BR.counted.join() === 'SL-A' && Object.entries(BR.excluded).map(([q, w]) => `${q}:${w}`).join() === 'SL-E:floor,SL-F:floor', 'only SL-A counts on BOAS, SL-E and SL-F at floor');
need(OR.fixed_heads_for_less && BR.fixed_heads_for_less && !OR.fixed_heads_higher_on.length && !BR.fixed_heads_higher_on.length
  && OR.fixed_heads_lower_on.join() === 'parameters,head_macs' && BR.fixed_heads_lower_on.join() === 'parameters,head_macs,step_time',
  'fixed heads cost less: parameters and head MACs, and on sleep the step time too');
const p1a = P(O, 'P1', 'MI-A'), p1b = P(O, 'P1', 'MI-B'), p1s = P(B, 'P1', 'SL-A');
need(p1a.difference === 'difference: C1 higher' && p1a.margin === 'margin not met' && p1a.interval_95_pp[0] < DELTA && p1a.interval_95_pp[1] > DELTA,
  'C1 is higher on MI-A and a gap of 2 pp or more cannot be ruled out');
need(eq(p1b), 'MI-B is equivalent within the margin');
need(p1s.difference === 'difference: C1 higher' && p1s.interval_95_pp[0] > DELTA, 'the whole SL-A interval lies above the margin');
const p5 = [P(O, 'P5', 'MI-A'), P(O, 'P5', 'MI-B'), P(B, 'P5', 'SL-A')];
need(p5.every(e => e.gate === 'pass' && near(e)) && eq(p5[0]) && eq(p5[1]) && p5[2].margin === 'non-inferior' && p5[2].interval_95_pp[1] < DELTA,
  'the layer not told the question is equivalent on both motor-imagery questions and, on the sleep stage, B-sh is the non-inferior arm');
// Where the conditioned head's lift comes from (S2, B-sh − B-lin, secondary): shown on the sleep stage, not on imagery or rest.
const s2a = ppEntry(O.secondary, 'S2', 'MI-A', 'E1'), s2s = ppEntry(B.secondary, 'S2', 'SL-A', 'E1');
need(s2a.x === 'B-sh' && s2a.y === 'B-lin' && s2a.wording === 'inconclusive at this sample size' && s2a.gate === 'pass', 'the hidden layer\'s own contrast is inconclusive on imagery or rest');
need(s2s.x === 'B-sh' && s2s.y === 'B-lin' && s2s.difference === 'difference: B-sh higher' && s2s.interval_95_pp[0] > 0 && s2s.gate === 'pass', 'the hidden layer is higher than the fixed heads on the sleep stage');
const s1 = [entry(O.entries, 'S1', 'MI-A', 'L1'), ...['SL-A', 'SL-E', 'SL-F'].map(q => entry(B.entries, 'S1', q, 'L1'))] as SrEntry[];
need(s1.every(e => e.gate === 'pass' && eq(e)), 'C1 − B-sh on frozen features is equivalent wherever it is counted');
need((entry(O.entries, 'S1', 'MI-B', 'L1') as SrEntry).gate === 'floor', 'which hand is at floor on frozen features');
const p2a = P(O, 'P2', 'MI-A'), p2b = P(O, 'P2', 'MI-B'), p2s = P(B, 'P2', 'SL-A');
need(p2b.difference === 'difference: A higher' && p2b.margin === 'margin not met', 'sharing the trunk cost accuracy on which hand');
need(p2a.wording === 'inconclusive at this sample size' && p2s.wording === 'inconclusive at this sample size', 'sharing is inconclusive on MI-A and SL-A');
need(OR.counted.concat(BR.counted).join() === 'MI-A,MI-B,SL-A', 'the counted P2 contrasts are MI-A, MI-B and SL-A');
const p4a = P(O, 'P4', 'MI-A', 'L1'), p4b = P(O, 'P4', 'MI-B', 'L1');
need(p4a.difference === 'difference: C1-fz higher' && p4a.margin === 'margin not met' && p4b.gate === 'floor', 'P4 repeats P1 on MI-A and MI-B is at floor');
const p4s = ['SL-A', 'SL-E', 'SL-F'].map(q => P(B, 'P4', q, 'L1'));
need(eq(p4s[0]) && eq(p4s[2]) && p4s[1].margin === 'margin not met' && p4s[1].difference === 'difference: C1-fz higher' && p4s.every(e => e.gate === 'pass'),
  'on frozen features fixed heads are equivalent on SL-A and SL-F, not on SL-E');
const p3 = entry(B.entries, 'P3', 'SL-B') as SrLogR;
need(p3.difference === 'difference: dedicated model leaves less error' && p3.margin === 'margin not met' && p3.gate === 'pass', 'the dedicated wake model leaves less error, margin not met');
const e2 = (id: string, q: string) => ppEntry(E2.entries, id, q, 'E2');
need(eq(e2('S3-P1', 'SL-A')) && eq(e2('S3-P1', 'SL-F')) && e2('S3-P1', 'SL-E').difference === 'difference: C1 higher' && e2('S3-P1', 'SL-E').margin === 'margin not met'
  && ['SL-A', 'SL-E', 'SL-F'].every(q => eq(e2('S3-P2', q))) && E2.gates.every(g => g.gate === 'pass'), 'the E2 sleep readings');
need(E2.run_after_other_results && E2.seeds === 1 && E2.resume_checkpoints.left_after_the_run === 0, 'E2 sleep ran last, one seed, no checkpoint left');
const s13 = ppEntry(E.secondary, 'S13-P1', 'SL-A');
need(s13.difference === 'difference: C1 higher' && s13.margin === 'margin not met' && s13.single_seed, 'EESM19 matches BOAS on SL-A, one seed');
for (const d of [O, B, E]) need(d.canary.questions.every(q => q.balanced_accuracy < d.canary.demotes_at && q.label === 'passes canary'), 'the canary demoted nothing');
const floorMi = gate(O, 'L1', 'MI-B'), floorE = gate(B, 'E1', 'SL-E'), floorF = gate(B, 'E1', 'SL-F');
need(floorMi.interval_95[0] <= floorMi.floor, 'the L1 MI-B interval does not lie wholly above its floor');
need(floorMi.gate === 'floor' && floorE.gate === 'floor' && floorF.gate === 'floor'
  && [O, B].every(d => d.gates.filter(g => g.gate !== 'pass').length === (d === O ? 1 : 2)), 'the gate set aside L1 MI-B and E1 SL-E, SL-F only');
const primaryN = [...O.entries, ...B.entries].filter(e => e.role === 'primary').length;
need(primaryN === 21 && /21 pre-declared primary entries/.test(R2.design.multiplicity), '21 primary entries');
const oracle = (q: string) => B.secondary.find(e => e.id === 'S11-oracle' && e.question === q) as SrOracle;
const L = O.ledger, LB = B.ledger;
const canaryTop = (d: { canary: { questions: { id: string; balanced_accuracy: number }[] } }) => [...d.canary.questions].sort((a, b) => b.balanced_accuracy - a.balanced_accuracy)[0];
need(canaryTop(O).id === 'MI-A', 'the highest motor-imagery canary is MI-A');
need([L, LB].every(l => (['B-sh', 'C1', 'A'] as const).every(k => l['B-lin'].parameters < l[k].parameters)), 'the fixed heads have the fewest parameters of the four set-ups');

// --- What the tables print. ---------------------------------------------------------------------------------
const contrastName = (id: string): string => {
  const base = id === 'S3-P2' ? id : id.replace(/^S3-|^S13-/, '');
  const names: Record<string, [string, string]> = {
    P1: ['Conditioned head − fixed heads', '条件化分类头 − 固定分类头'],
    P4: ['Conditioned head − fixed heads', '条件化分类头 − 固定分类头'],
    P5: ['Conditioned head − the same layer, not told the question', '条件化分类头 − 不告知问题的同一隐藏层'],
    S1: ['Conditioned head − the same layer, not told the question', '条件化分类头 − 不告知问题的同一隐藏层'],
    P2: ['Fixed heads on one small-CNN trunk − separate models', '一个小 CNN 主干上的固定分类头 − 分开的模型'],
    'S3-P2': ['Fixed heads on one adapted CBraMod − separate models', '一个适配后的 CBraMod 上的固定分类头 − 分开的模型'],
  };
  const x = names[base];
  if (!x) throw new Error(`shared-encoder: no name for ${id}`);
  return x[zh ? 1 : 0];
};
const order = (d: typeof O | typeof B | typeof E2, level: string, ids: string[], qs: string[]) =>
  ids.flatMap(id => qs.map(q => ppEntry(d.entries, id, q, level)));
const miE1 = order(O, 'E1', ['P1', 'P5', 'P2'], ['MI-A', 'MI-B']), miL1 = order(O, 'L1', ['P4', 'S1'], ['MI-A', 'MI-B']);
const slQs = ['SL-A', 'SL-E', 'SL-F'];
const slE1 = order(B, 'E1', ['P1', 'P5', 'P2'], slQs), slL1 = order(B, 'L1', ['P4', 'S1'], slQs), slE2 = order(E2, 'E2', ['S3-P1', 'S3-P5', 'S3-P2'], slQs);
const e19 = ['S13-P1', 'S13-P2'].flatMap(id => slQs.map(q => ppEntry(E.secondary, id, q)));
const armRows = (d: typeof O | typeof B, qs: string[]) => [
  { sub: zh ? 'EEGNet，从头训练（E1）' : 'EEGNet trained from scratch (E1)', level: 'E1', arms: ['B-lin', 'B-sh', 'C1', 'A'] },
  { sub: zh ? '冻结的 CBraMod 特征（L1）' : 'Frozen CBraMod features (L1)', level: 'L1', arms: ['B-lin-fz-sgd', 'B-sh-fz', 'C1-fz'] },
].map(g => ({ ...g, rows: g.arms.map(a => ({ id: a, cells: qs.map(q => arm(d, g.level, a === 'A' ? `A_${q}` : a, q)) })) }));
const setupOf = (a: string) => setupName[a.replace(/-fz(?:-sgd)?$/, '') as 'A' | 'B-lin' | 'B-sh' | 'C1'][locale];
const ledgerRows = (l: typeof L) => (['B-lin', 'B-sh', 'C1', 'A'] as const).map(id => ({ id, x: l[id] }));
const qHead = (q: string) => `${q} · ${qName(q, locale)}`;
const secondaryTables = [
  { id: 'openbmi', rows: O.secondary.filter(isPp) as SrEntry[] },
  { id: 'boas', rows: B.secondary.filter(isPp) as SrEntry[] },
];
const s4 = B.secondary.filter(isLogR) as SrLogR[];
const coh = B.coherence.shares;
const levelOf = (e: SrEntry) => e.representation ? `${e.level} · ${e.representation}` : e.level;
const auditN = R2.audits;
const credits = [O.rights, B.rights, E.rights];
const literature: { cite: string; url: string }[] = [
  { cite: 'Yu & Yao, 2026 · Visual Jev: Accurate and Efficient Decisions from Shared Visual Context', url: 'https://arxiv.org/abs/2609.25845' },
  { cite: 'Dai et al., 2026 · Towards Unified Multi-task EEG Analysis with Low-Rank Adaptation', url: 'https://arxiv.org/abs/2604.25131' },
  { cite: 'Xiong et al., 2025 · EEG-FM-Bench: A Comprehensive Benchmark for the Systematic Evaluation and Diagnostic Analyses of EEG Foundation Models', url: 'https://arxiv.org/abs/2508.17742' },
  { cite: 'Perez et al., 2017 · FiLM: Visual Reasoning with a General Conditioning Layer', url: 'https://arxiv.org/abs/1709.07871' },
  { cite: 'Ha, Dai & Le, 2016 · HyperNetworks', url: 'https://arxiv.org/abs/1609.09106' },
];
need(literature.map(x => x.url).join() === R2.literature.map(x => x.url).join(), 'the five literature anchors of the export, in its order');

// --- The short answer and the description: no BOAS figure (BOAS travels with its gaps, which sit below). ------
const ans = (x: FigValue) => `[[${F(x)}]]`;
const ivAns = (e: SrEntry) => `${ans(srLo(e.interval_95_pp[0]))} ${tc.to} ${ans(srPp(e.interval_95_pp[1]))}`;
const copy = {
  en: {
    description: `A shared EEGNet with a fixed output per question cost less than a head told the question, but was not shown to come within ${DELTA} pp of it: ${F(srPp(p1a.estimate_pp))} (${F(srLo(p1a.interval_95_pp[0]))} to ${F(srPp(p1a.interval_95_pp[1]))}) on imagery against rest, ${O.people} people. Naming the question added nothing measurable.`,
    answer: `The cheaper set-up was not shown to do as well, on these data. A shared EEGNet with a fixed linear output per question cost less than a head told which question it was answering (${ans(n(L['B-lin'].parameters))} against ${ans(n(L.C1.parameters))} trainable parameters on motor imagery), but it was not shown to come within ${DELTA} pp of that head, the margin fixed before the run. On imagery against rest, in ${ans(n(O.people))} people (OpenBMI), that head scored ${ans(srPp(p1a.estimate_pp))} higher (${ivAns(p1a)}); on five-stage sleep scoring (BOAS) its whole interval lay above ${DELTA} pp. Naming the question added nothing measurable: the same hidden layer, not told the question, was equivalent to that head within ±${DELTA} pp on both motor-imagery questions and non-inferior at ${DELTA} pp on sleep. Against a separate EEGNet per question, the small shared EEGNet trunk scored ${ans(srPp(p2b.estimate_pp))} on which hand (${ivAns(p2b)}): a difference, and a loss of ${DELTA} pp or more cannot be ruled out; on imagery or rest and on the sleep stage the comparison was inconclusive.`,
    eyebrow: 'Shared encoders · route 2 of the decision-research plan',
    dek: 'One encoder answering several questions about the same windows, against a separate model per question and against a head told which question it is answering, at matched data and compute. Motor imagery on OpenBMI and sleep on BOAS, with EESM19 as a crude replication.',
    designEyebrow: 'How the comparison works',
    designH2: 'Four set-ups, the same questions',
    designLede: 'Every question is a label the dataset already has, asked by its identifier: the model is told which question it is answering, never given it in words. The four set-ups answer the same questions from the same windows.',
    setups: {
      A: 'one model per question.',
      'B-lin': 'one shared encoder and one linear output per question; the fewest parameters.',
      'B-sh': 'the shared encoder, then one hidden layer used by every question, then one output per question.',
      C1: 'B-sh, with the hidden layer adjusted for each question by a learned code (FiLM).',
    } as Record<string, string>,
    matching: 'B-lin, B-sh and C1 start from the same weights, see the same batches in the same order and train for the same number of steps. Two primary levels, three seeds each: EEGNet trained from scratch (E1), and heads trained on frozen CBraMod features (L1; the same set-ups, marked -fz). CBraMod adapted by LoRA (E2) ran with one seed, as a secondary level.',
    comparisons: 'Three comparisons answer the question. P1, C1 − B-lin: do fixed heads do as well? P5, C1 − B-sh: does telling the head the question add anything? P2, B-lin − A: does sharing one encoder cost accuracy? P4 is P1 on frozen CBraMod features.',
    reading: `Each comparison is a paired difference in balanced accuracy, in percentage points (pp), with a 95% interval from resampling people (and, with three seeds, training runs). It gets two readings. A difference is shown when the interval excludes zero. And against a margin of ±${DELTA} pp, fixed by the owner before any result, it is equivalent when the whole interval lies inside the margin, non-inferior when the bound that matters does, and otherwise the margin is not met. “Fixed heads do as well for less” is said of a domain only if every counted question meets the margin on P1 and the fixed heads cost less. A question whose fixed-head accuracy is not clearly above chance + 5 pp is at floor: reported, never counted.`,
    multiplicity: `There are ${primaryN} primary comparisons and no multiplicity correction, so about one in 20 comparisons with no true difference may show one by chance. Balanced accuracy is averaged per person, then over people: it compares set-ups and is not a deployment error rate.`,
    routeOf: ['This is route 2 of the research plan on ', 'When not to act', '.'],
    verdict: 'Fixed heads did as well for less: not supported',
    colComparison: 'Comparison', colQuestion: 'Question', colDiff: 'Difference, pp', colShown: 'Difference shown?', colMargin: `Margin, ±${DELTA} pp`, colGate: 'Gate',
    colSetup: 'Set-up', colEntry: 'Entry', colLevel: 'Level', colContrast: 'Contrast', colMeans: 'The two arms’ means',
    secondaryMark: 'secondary',
    miEyebrow: (): Part[] => ['Primary · OpenBMI · EEGNet and CBraMod'],
    miH2: 'Motor imagery: imagery or rest, and which hand',
    miLede: (): Part[] => ['Two questions about each 2-second window of OpenBMI’s motor-imagery runs and rest recordings: is the person imagining a hand movement or resting (MI-A), and which hand (MI-B, offline trials only)? ', n(O.windows.qc_passing), ' windows from ', n(O.people), ' people; each person’s two sessions sit in one fold, so every test is on new people. Both questions passed the canary and the gate, so both count.'],
    miFindingLabel: 'C1 − B-lin on MI-A, EEGNet from scratch, three seeds',
    miFinding: (): Part[] => ['On imagery or rest the conditioned head scored ', srPp(p1a.estimate_pp), ' above the fixed heads (', ...iv(p1a), `): a gap of ${DELTA} pp or more cannot be ruled out. On which hand the two were equivalent within ±${DELTA} pp (`, srPp(p1b.estimate_pp), ', ', ...iv(p1b), '). The fixed heads were the cheaper set-up: ', n(L['B-lin'].parameters), ' against ', n(L.C1.parameters), ' trainable parameters, and ', n(L['B-lin'].head_macs_per_window), ' against ', n(L.C1.head_macs_per_window), ' head multiply-accumulates per window.'],
    miTableRegion: 'Motor imagery, paired comparisons, scrolls horizontally',
    miTableCaption: (): Part[] => ['Paired differences in balanced accuracy, in pp, with 95% intervals; ', n(O.people), ' people, three seeds.'],
    e1Sub: 'EEGNet trained from scratch (E1)', l1Sub: 'Heads on frozen CBraMod features (L1)', e2Sub: 'CBraMod adapted by LoRA (E2), one seed',
    miReading: (): Part[] => [`Telling the head the question added nothing measurable: C1 − B-sh was equivalent within ±${DELTA} pp on both questions from scratch, and on imagery or rest on frozen features. That does not show where the conditioned head’s lift over the fixed heads comes from: the same layer not told the question, against the fixed heads (B-sh − B-lin, secondary S2), was `, srPp(s2a.estimate_pp), ' on imagery or rest (', ...iv(s2a), `), inconclusive at this sample size. Against a separate EEGNet per question, sharing one small trunk (`, n(L['B-lin'].parameters_by_part!.encoder), ' parameters) scored ', srPp(p2b.estimate_pp), ' on which hand (', ...iv(p2b), `): a difference, and a cost of ${DELTA} pp or more cannot be ruled out; on imagery or rest it was inconclusive. On frozen CBraMod features the conditioned head was again higher on imagery or rest (`, srPp(p4a.estimate_pp), ', ', ...iv(p4a), '); which hand is at floor there.'],
    armsRegion: (d: string) => `${d}, balanced accuracy of each set-up, scrolls horizontally`,
    miArmsCaption: (): Part[] => ['Balanced accuracy of each set-up: the mean over ', n(O.people), ' people with its 95% interval. Chance is ', f(arm(O, 'E1', 'B-lin', 'MI-A').chance), '; the gate’s floor is ', f(gate(O, 'E1', 'MI-A').floor), '. Overlapping intervals are not ranked: the paired differences above are the comparison.'],
    ledgerRegion: (d: string) => `${d}, what each set-up costs, scrolls horizontally`,
    ledgerCaption: (domain: string, unit: string, timing: string): Part[] => [`What each set-up costs on ${domain} (EEGNet, E1). Parameters, encoder passes, multiply-accumulates and steps are exact. The time per step was measured once, interleaved across set-ups on a shared GPU, and is indicative: in the cost rule a time counts only beyond ${timing.match(/beyond (\d+\.\d+)x/)![1]}×.`],
    colParams: 'Trainable parameters', colPasses: (u: string) => `Encoder passes per ${u}`, colMacs: (u: string) => `Head multiply-accumulates per ${u}`, colSteps: 'Training steps per fit', colStep: 'Time per step',
    parts: (l: { encoder: number; heads: number; conditioning: number }): Part[] => ['encoder ', n(l.encoder), ' · heads ', n(l.heads), ' · conditioning ', n(l.conditioning)],
    oneEach: 'one EEGNet per question',
    gatesH3: 'What the canary and the gate set aside',
    miGates: (): Part[] => ['Before any fit, a ridge classifier on each window’s per-channel mean and log-variance, trained and tested within the first fold’s ', n(O.canary.training_people), ' training people, checked whether a question could be answered from those statistics alone; it demotes a question at ', f(O.canary.demotes_at), ' or more. It gave ', ...O.canary.questions.flatMap((q, i): Part[] => [i ? ', ' : '', `${q.id} `, f(q.balanced_accuracy)]), ', so none was demoted. The gate set one entry aside: on frozen CBraMod features the fixed heads scored ', f(floorMi.mean), ' (', ...pctIv(floorMi), ') on which hand; its interval does not lie wholly above the ', f(floorMi.floor), ' floor, so that question is at floor there.'],
    slEyebrow: (): Part[] => ['Primary · BOAS · EEGNet and CBraMod'],
    slH2: 'Sleep: the stage, the next change and the half of the night',
    slLede: (): Part[] => { const s = B.questions.find(q => q.id === 'SL-A')!.shares, e = B.questions.find(q => q.id === 'SL-E')!.shares;
      return ['Three questions about each 30-second epoch of the six polysomnography EEG channels, scored against the human consensus: the sleep stage (SL-A), whether the next epoch’s stage differs (SL-E), and the first or second half of the night (SL-F). ', n(B.windows.qc_passing), ' epochs from ', n(B.people), ' people; all nights of a person sit in one fold. Stages at their natural mix: W ', f(s.W), ', N1 ', f(s.N1), ', N2 ', f(s.N2), ', N3 ', f(s.N3), ', REM ', f(s.REM), '; the stage changes at the next epoch in ', f(e.change), ' of epochs. SL-E and SL-F are largely predictable from the current stage: read off the true current stage alone, they reach ', f(oracle('SL-E').mean), ' and ', f(oracle('SL-F').mean), '.']; },
    slFindingLabel: 'C1 − B-lin on SL-A, EEGNet from scratch, three seeds',
