    fzH2: '一个简单基线揭示了跨会话解码器的失败',
    fzLabel: '离线、同一被试、不对目标会话做任何适配。',
    fzLede: '被试用运动想象控制光标，追踪一个在屏幕上连续移动的目标；发布者把数据分为 Main 与 Transfer Learning 两个队列。对每条纳入记录，固定的 spectral ridge 用最早一次完整记录会话中所有符合条件、非 chance 的 run 训练，在最晚一次会话上测试，不使用该会话的任何标签，并与源会话均值对照比较：即最早会话的平均响应，对每一行都重复使用。解码器在较晚的会话上能胜过这个常数吗？这里没有。',
    fzCards: [
      { h: '纳入的队列记录', v: (): Part[] => [n(fz.coverage.admitted_records)], p: (): Part[] => ['Main ', n(main.admitted_records), ' 条（共 ', n(main.candidate_records), ' 条），Transfer Learning ', n(tl.admitted_records), ' 条（共 ', n(tl.candidate_records), ' 条）。这是记录数，不能证明是不同的人。'] },
      { h: '每种响应变量的目标行数', v: (): Part[] => [n(fz.coverage.target_rows_per_arm)], p: (): Part[] => ['两种响应变量用的是同一批行：两个结果变量并不使独立样本加倍。没有删除任何响应行。'] },
      { h: '响应拟合', v: (): Part[] => [n(fz.coverage.response_fits)], p: (): Part[] => ['每条纳入记录、每种响应变量各一次，全部成功。'] },
    ],
