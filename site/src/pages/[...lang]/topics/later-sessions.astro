---
/**
 * Does a decoder trained on an earlier session still work later? (owner decision): four results from the
 * large-source batch, each the same person in a later session with no labels from it — WBCIC-SHU motor imagery (two
 * fixed CPU baselines, and frozen CBraMod with a session-1 readout; two cohorts kept apart), the longitudinal RSVP
 * source (one first-visit ERP decoder at the publisher's nominal later visits) and Forenzo's continuous cursor
 * tracking (a negative result). Its own question, in "Transfer".
 *
 * Every figure is a leaf of later-sessions-update.json, printed with data-fig (Fig.astro) and re-read by
 * check-workbench.mjs. Rules, from the four handoffs and the review manifest: aggregates only; datasets, cohorts and
 * response arms never pooled and never ranked; the RSVP section under the subtitle its handoff words, its chart three
 * points with participant-bootstrap intervals and no fitted curve, AP beside AUROC; Forenzo's mean, median, comparator
 * and paired interval together, its upper tail visible, its two response arms never compared with each other, its
 * coverage beside the result, no online-control or intended-motion claim. The sentences that summarise the export
 * are checked against it below, and the page refuses to build if the numbers stop supporting them.
 */
import later from '../../../data/later-sessions-update.json';
import TopicLayout from '../../../components/TopicLayout.astro';
import Fig from '../../../components/Fig.astro';
import IntervalPlot from '../../../components/IntervalPlot.astro';
import { hrefFor, localeOf, localeParams, topicCards, topicChrome } from '../../../data/i18n';
import { formatFig, wideFmt, type Fig as FigValue, type Fmt } from '../../../data/entities';

export const getStaticPaths = localeParams;
const locale = localeOf(Astro.params.lang);
const zh = locale === 'zh';
const tc = topicChrome[locale];
type Part = string | FigValue;
const LTS = 'later-sessions-update.json';
const f = (raw: number, fmt: Fmt = 'pct1'): FigValue => ({ raw, fmt, src: LTS });
const n = (raw: number) => f(raw, 'count');
const w = (raw: number) => f(raw, wideFmt(raw));
const F = (x: FigValue) => formatFig(x);
const ans = (x: FigValue) => `[[${F(x)}]]`;
const R = later.results;
const cpu = R['wbcic-cross-session-cpu'], fm = R['wbcic-frozen-cbramod'], rs = R['rsvp-later-visits'], fz = R['forenzo-continuous-control'];

// --- The facts every sentence below rests on; the page refuses to build without them. -----------------------
const need = (ok: boolean, what: string) => { if (!ok) throw new Error(`later-sessions: the copy says ${what}`); };
const same = (a: number, b: number) => Math.abs(a - b) < 1e-12;
const cohorts = ['2C', '3C'] as const;
need(cpu.sessions.train === 1 && cpu.sessions.test === 3 && cpu.sessions.unused === 2 && cpu.sessions.target_session_labels === 0
  && fm.sessions.train === 1 && fm.sessions.test === 3 && fm.sessions.target_session_labels === 0, 'session 1 trains, session 3 tests, session 2 is unused and no session-3 label is used');
for (const c of cohorts) {
  const a = cpu.cohorts[c], b = fm.cohorts[c];
  need(a.people === b.people && a.target_trials === b.target_trials && a.source_trials === b.source_trials, `both WBCIC-SHU results read the same ${c} cohort and trials`);
  need(b.relative_spectral_ridge.balanced_accuracy.mean === a.arms.relative_spectral_ridge.balanced_accuracy.mean, 'the CBraMod release reads against the CPU release\'s spectral ridge figure');
  need(same(a.arms.source_prior.balanced_accuracy.mean, a.chance_level), `the source prior sits on chance in ${c}`);
  need(a.paired.interval_excludes_zero && a.paired.balanced_accuracy_difference.interval_95[0] > 0, `the spectral ridge is above the source prior in ${c}, its paired interval above zero`);
  need(b.paired.interval_excludes_zero && b.paired.balanced_accuracy_difference.interval_95[0] > 0, `frozen CBraMod is above the spectral ridge in ${c}, its paired interval above zero`);
}
need(cpu.cohorts['2C'].people > cpu.cohorts['3C'].people, 'the three-class cohort is the small one');
need(fm.encoder === 'frozen' && !fm.fine_tuning && !fm.lora && fm.pretraining_exposure.status === 'not established', 'the encoder is frozen, with no fine-tuning or LoRA, and its pretraining exposure is not established');
need(cpu.trials.excluded === 0 && cpu.session_quality.holds_in_selected_sessions + cpu.session_quality.holds_in_unused_session_2 === cpu.session_quality.fixed_count_holds
  && cpu.session_quality.missing_trial_cause === 'unknown', 'no trial excluded; six short sessions, three of them used; the cause unknown');
const visits = rs.visits;
need(visits.map(v => v.nominal_day).join() === '7,80,200' && visits.every(v => v.people === rs.cohort.people), 'the nominal visits are Day 7, 80 and 200, the same people at each');
need(visits.every(v => v.delivered_events === null && v.signal_invalid_events === 0), 'the delivered-event count is null at every visit, and no event was invalid');
need(visits.every(v => v.target_share > 0.02 && v.target_share < 0.03), 'targets are about 2.5% of events at every visit');
need(rs.contrast.interval_excludes_zero && rs.contrast.auroc_difference.interval_95[1] < 0 && rs.contrast.people === rs.cohort.people, 'the Day 200 minus Day 7 AUROC interval lies below zero, the same people');
need(visits[2].auroc.mean < visits[0].auroc.mean && visits[2].average_precision.mean < visits[0].average_precision.mean, 'AUROC and average precision are lower at Day 200 than at Day 7');
need(visits.every(v => v.auroc.interval_95[0] > 0.8), 'AUROC stays well above chance at every later visit');
need(rs.subtitle === 'Same-person, offline RSVP classification; publisher nominal visit labels; no target-session adaptation.', 'the RSVP subtitle as its handoff words it');
need(rs.model.label === 'Normalized ERP features + logistic/Platt (CPU baseline)', 'the RSVP model label as its handoff words it');
const fzCohorts = ['Main', 'Transfer Learning'] as const;
const fzArms = ['historical_decoder_velocity_imitation', 'constructed_raw_target_displacement_proxy'] as const;
type FzArm = typeof fzArms[number];
const fzc = fz.cohorts as Record<string, any>;
const cell = (c: string, a: FzArm) => fzc[c].arms[a];
for (const c of fzCohorts) for (const a of fzArms) {
  const x = cell(c, a);
  need(x.records === fzc[c].admitted_records && x.paired.records === x.records && x.paired.records_with_higher_ridge_error === x.records,
    `the ridge has the larger error on every admitted ${c} record (${a})`);
  need(x.paired.interval_excludes_zero && x.paired.primary_difference.interval_95[0] > 0 && x.ridge.primary.mean > x.source_mean.primary.mean, `the paired ${c} ${a} interval lies above zero`);
  need(x.ridge.primary.mean > 10 * x.ridge.primary.median && x.upper_tail.ridge_mean_over_median > 10, `the ${c} ${a} ridge mean lies far above its median`);
  need(x.source_mean.secondary.pearson_x.mean === null && x.source_mean.secondary.pearson_y.mean === null, 'the comparator\'s correlations are null');
}
const main = fzc.Main, tl = fzc['Transfer Learning'];
need(main.admitted_records + main.held_before_scoring === main.candidate_records && main.hold_reasons.reduce((s: number, h: { records: number }) => s + h.records, 0) === main.held_before_scoring,
  'Main\'s holds add up to its candidates');
need(tl.admitted_records === tl.candidate_records && tl.held_before_scoring === 0 && main.conditional_on_admitted_records && !tl.conditional_on_admitted_records, 'Transfer Learning admits every record; Main is conditional on its admitted subset');
need(fz.coverage.admitted_records === main.admitted_records + tl.admitted_records && fz.coverage.counting_unit === 'cohort records, not proven unique people', 'records, not people');
need(fz.coverage.response_rows_removed === 0 && fz.coverage.response_fits === 2 * fz.coverage.admitted_records, 'no response row removed, one fit per record and arm');
need(fz.primary_metric.lower_is_better && fz.kind === 'negative result', 'the primary metric is an error, lower is better, and the result is negative');
need(fz.label === 'Offline, same-person, no target-session adaptation', 'the Forenzo label as its handoff words it');
// The method facts the page types (channels, rates, bands, sizes) are the export's own words.
const says = (text: string, ...xs: string[]) => xs.forEach(x => need(text.includes(x), `the method says "${x}"`));
says(cpu.method.data, '58 anonymous channel indices at 250 Hz in four-second epochs');
says(cpu.method.spectra, '4–8, 8–13, 13–30 and 30–40 Hz', '232 values per trial');
says(cpu.method.ridge, 'session 1 only', 'alpha 1', 'no class weights');
says(cpu.method.selection, 'no hyperparameter search, target normalization, calibration or abstention');
says(fm.method.adapter, '200 Hz', '800 samples', 'its own standard deviation');
says(fm.method.encoder, 'every weight frozen', 'four temporal patch embeddings averaged', '11,600 values per trial');
says(fm.method.not_done, 'no backbone training, LoRA, target-session calibration');
says(rs.method.events, '57 EEG channels', '−200 to +700 ms', 'six 100 ms averages from +100 to +700 ms', '342 values per event');
says(rs.method.split, 'blocks 1–3 fit the classifier', 'block 4 fits Platt calibration', 'blocks 2–4');
says(rs.method.classifier, 'L2 logistic regression');
says(fz.method.signal, '62 channels at 1,000 Hz', '4–8, 8–12, 12–16, 16–24 and 24–30 Hz', 'preceding 1,000 filtered power samples', '310 values per row');
says(fz.method.split, 'every eligible non-chance run');
says(fz.method.timing, '2-second past window', 'every 40 ms');
says(fz.method.models, 'source session only', 'Ridge (alpha 1', 'no tuning, LoRA, target-session calibration or foundation-model inference');
for (const u of [cpu.uncertainty.kind, fm.uncertainty.kind, rs.uncertainty.kind, fz.uncertainty.kind]) says(u, 'pointwise 95% percentile interval from 10,000');
says(rs.label_coding, 'Trigger.txt reverses');
const tails = fzCohorts.flatMap(c => fzArms.map(a => cell(c, a).upper_tail.ridge_mean_over_median as number));
const tailLo = Math.min(...tails), tailHi = Math.max(...tails);
// Typed English the Chinese page translates, kept equal to the export so a changed export fails the build.
const holdReasonZh: Record<string, string> = {
  'a session lacks its required Chance R01 record': '某次会话缺少必需的 Chance R01 记录',
  'the decoder-local run allocation differs from the documented contract': '按解码器划分的 run 分配与文档约定不符',
  'the sample-boundary geometry differs; its exact numeric cause was not independently reconstructed': '样本边界的几何结构不一致，其确切的数值原因没有得到独立重建',
};
for (const h of main.hold_reasons) need(h.reason in holdReasonZh, `a Chinese hold reason for "${h.reason}"`);

// --- Names. ------------------------------------------------------------------------------------------------------
const cohortName = (c: '2C' | '3C') => c === '2C' ? (zh ? '二分类运动想象' : 'Two-class motor imagery') : (zh ? '三分类运动想象' : 'Three-class motor imagery');
const cohortClasses = (c: '2C' | '3C') => c === '2C' ? (zh ? '左手或右手' : 'left or right hand') : (zh ? '左手、右手或脚' : 'left hand, right hand or foot');
const armName = {
  source_prior: zh ? '源会话多数类先验' : 'Source-majority prior',
  relative_spectral_ridge: zh ? '相对频谱功率 + 岭回归' : 'Relative spectral power + ridge',
  frozen_cbramod: zh ? 'CBraMod · 冻结编码器，分类头用第 1 次会话拟合' : 'CBraMod · frozen encoder, session-1 ridge readout',
};
const armNote = {
  source_prior: zh ? '预测第 1 次会话中最常见的类别：一个下限，不是模型' : 'predicts session 1’s most frequent class: a floor, not a model',
  relative_spectral_ridge: zh ? '固定的 CPU 基线' : 'a fixed CPU baseline',
  frozen_cbramod: zh ? '只拟合分类头，不训练编码器' : 'only the readout is fitted; the encoder is not trained',
};
const fzCohortName = (c: string) => zh ? `${c === 'Main' ? 'Main' : 'Transfer Learning'} 队列` : `${c} cohort`;
const fzArmName: Record<FzArm, { name: string; tag: string; what: string }> = zh ? {
  historical_decoder_velocity_imitation: { name: '历史解码器速度', tag: '模仿历史解码器（historical decoder imitation）',
    what: '模仿的是记录时所用解码器的输出（由发布者保存），不是意图中的手部运动，也不是意图控制。' },
  constructed_raw_target_displacement_proxy: { name: '构造的位移代理变量', tag: '构造的代理变量（constructed proxy）',
    what: '在发布者的屏幕坐标中，目标位置减光标位置，单独拟合的代理变量。' },
} : {
  historical_decoder_velocity_imitation: { name: 'Historical decoder velocity', tag: 'historical decoder imitation',
    what: 'The output of the decoder in use at recording time, as the publisher stored it, imitated: not intended hand motion or intended control.' },
  constructed_raw_target_displacement_proxy: { name: 'Constructed displacement proxy', tag: 'constructed proxy',
    what: 'Target position minus cursor position in the publisher’s screen coordinates, a separately fitted proxy.' },
};
const secondaryKeys = ['raw_rmse_x', 'raw_rmse_y', 'r2_x', 'r2_y', 'pearson_x', 'pearson_y'] as const;
const secondaryHead: Record<string, string> = zh
  ? { raw_rmse_x: '原始 RMSE，水平', raw_rmse_y: '原始 RMSE，垂直', r2_x: 'R²，水平', r2_y: 'R²，垂直', pearson_x: 'Pearson，水平', pearson_y: 'Pearson，垂直' }
  : { raw_rmse_x: 'Raw RMSE, x', raw_rmse_y: 'Raw RMSE, y', r2_x: 'R², x', r2_y: 'R², y', pearson_x: 'Pearson, x', pearson_y: 'Pearson, y' };

// --- What the RSVP chart and the Forenzo tail plots draw. -----------------------------------------------------
const visitName = (v: typeof visits[number]) => zh ? `标称第 ${v.nominal_day} 天` : `Nominal ${v.visit}`;
const rsvpRows = visits.map(v => ({
  label: visitName(v), value: v.auroc.mean, interval: v.auroc.interval_95 as [number, number], fig: f(v.auroc.mean, 'auc3'),
  noteParts: [`${tc.interval95} `, f(v.auroc.interval_95[0], 'auc3'), '–', f(v.auroc.interval_95[1], 'auc3')] as Part[], tone: 'rust' as const,
}));
const lg = (x: number) => Math.log10(x);
const lgIv = (iv: number[]) => [lg(iv[0]), lg(iv[1])] as [number, number];
const tailRows = (a: FzArm) => fzCohorts.flatMap(c => {
  const x = cell(c, a), cn = c;
  return [
    { label: zh ? `${cn} · spectral ridge · 均值` : `${cn} · spectral ridge · mean`, value: lg(x.ridge.primary.mean), interval: lgIv(x.ridge.primary.interval_95),
      fig: w(x.ridge.primary.mean), noteParts: [`${tc.interval95} `, w(x.ridge.primary.interval_95[0]), '–', w(x.ridge.primary.interval_95[1])] as Part[], tone: 'rust' as const },
    { label: zh ? `${cn} · spectral ridge · 中位数` : `${cn} · spectral ridge · median`, value: lg(x.ridge.primary.median), fig: w(x.ridge.primary.median), tone: 'olive' as const },
    { label: zh ? `${cn} · 源会话均值对照 · 均值` : `${cn} · source-mean comparator · mean`, value: lg(x.source_mean.primary.mean), interval: lgIv(x.source_mean.primary.interval_95),
      fig: w(x.source_mean.primary.mean), noteParts: [`${tc.interval95} `, w(x.source_mean.primary.interval_95[0]), '–', w(x.source_mean.primary.interval_95[1])] as Part[], tone: 'ink' as const },
  ];
});
const allTail = fzCohorts.flatMap(c => fzArms.flatMap(a => { const x = cell(c, a); return [x.ridge.primary.interval_95[1], x.source_mean.primary.interval_95[0], x.ridge.primary.median]; }));
need(Math.min(...allTail) > 0.01 && Math.max(...allTail) < 1e6, 'every Forenzo value fits the log axis, 0.01 to 1,000,000');

// --- Figures the short answer and the description name. ------------------------------------------------------
const c2 = cpu.cohorts['2C'], c3 = cpu.cohorts['3C'], m2 = fm.cohorts['2C'], m3 = fm.cohorts['3C'];
const d7 = visits[0], d200 = visits[2], dd = rs.contrast;
const fmBa2 = f(m2.frozen_cbramod.balanced_accuracy.mean), fmBa3 = f(m3.frozen_cbramod.balanced_accuracy.mean);
const gain2 = f(m2.paired.balanced_accuracy_difference.mean, 'pp1'), gain3 = f(m3.paired.balanced_accuracy_difference.mean, 'pp1');
const au7 = f(d7.auroc.mean, 'auc3'), au200 = f(d200.auroc.mean, 'auc3');
const dAu = f(dd.auroc_difference.mean, 'sgn3'), dLo = f(dd.auroc_difference.interval_95[0], 'sgn3'), dHi = f(dd.auroc_difference.interval_95[1], 'sgn3');
const ap7 = f(d7.average_precision.mean, 'auc3'), ap200 = f(d200.average_precision.mean, 'auc3'), share = f(d7.target_share);
const lede = (c: '2C' | '3C') => cpu.cohorts[c].people;

const copy = {
  en: {
    description: `Partly. Same person, no later-session labels. WBCIC-SHU: frozen CBraMod beat a spectral ridge by ${F(gain2)} and ${F(gain3)}. RSVP, nominal Day 7 to 200: AUROC ${F(au7)} → ${F(au200)}, average precision ${F(ap7)} → ${F(ap200)}. Cursor tracking: a fixed decoder had a higher overall error than a constant baseline on every admitted record.`,
    answer: `Partly, and each result stands on its own. On WBCIC-SHU motor imagery — trained on each person’s recording session 1 and tested on session 3 with no labels from it, ${ans(n(lede('2C')))} people in a two-class and ${ans(n(lede('3C')))} in a three-class cohort, kept apart — frozen CBraMod with a ridge readout fitted on session 1 reached ${ans(fmBa2)} and ${ans(fmBa3)} balanced accuracy, ${ans(gain2)} and ${ans(gain3)} above a relative spectral ridge, each paired interval above zero. It needs that person’s labelled earlier session, so it is same-person transfer, not decoding for someone new, and it does not show that pretraining caused the gain. On a longitudinal RSVP task, a decoder trained at each of ${ans(n(rs.cohort.people))} people’s first visit ranked targets with an AUROC of ${ans(au7)} at the publisher’s nominal Day 7 visit and ${ans(au200)} at nominal Day 200, a paired change of ${ans(dAu)} (${ans(dLo)} to ${ans(dHi)}). With targets only about ${ans(share)} of events, average precision fell from ${ans(ap7)} to ${ans(ap200)}. The nominal visit labels do not tie either decline to elapsed time. In continuous cursor tracking, a fixed spectral ridge trained on each record’s earliest session had a higher overall error in its latest session than a constant source-mean comparator, for every admitted record in both cohorts and both response arms: a negative result, with a severe upper tail.`,
    eyebrow: 'Session transfer · the same person, no labels from the later session',
    dek: 'Three datasets, four results, each read on its own. Motor imagery across recording sessions: frozen CBraMod with a readout fitted on the earlier session scores above a spectral baseline in both cohorts. Target detection at later visits: a first-visit decoder ranks targets less well at the last nominal visit, and its average precision is lower. Continuous cursor tracking: a fixed decoder does worse than a constant baseline for every admitted record.',
    // WBCIC-SHU
    wbEyebrow: 'WBCIC-SHU · motor imagery · session 1 to session 3',
    wbH2: 'Motor imagery two sessions later: two baselines and a frozen encoder',
    wbLede: (): Part[] => ['People imagined moving the left or the right hand (a two-class cohort, ', n(c2.people), ' people) or, in a separate three-class cohort (', n(c3.people), ' people), a foot movement as well, in three recording sessions. Each person’s complete session 1 trains the decoder and session 3 is the test; session 2 is unused, and no label from session 3 is used. Session numbers are recording-session ordinals, not a guaranteed time gap or distinct calendar days. The cohorts are kept apart and never averaged.'],
    baRegion: 'WBCIC-SHU, balanced accuracy on session 3 by cohort, scrolls horizontally',
    baCaption: (): Part[] => ['Participant-equal mean balanced accuracy on session 3, with a paired whole-participant bootstrap 95% interval. Chance is ', f(c2.chance_level), ' for two classes and ', f(c3.chance_level), ' for three, where the source-majority prior sits by construction. Accuracy and macro F1 are the secondary means.'],
    colArm: 'Decoder',
    colCohort: (c: '2C' | '3C', people: FigValue): Part[] => [cohortName(c), ' · ', people, ' people'],
    secondary: (acc: FigValue, f1: FigValue): Part[] => ['Accuracy ', acc, ' · macro F1 ', f1],
    diffRegion: 'WBCIC-SHU, paired differences in balanced accuracy by cohort, scrolls horizontally',
    diffCaption: 'Paired differences in balanced accuracy, in percentage points (pp), the same people and test trials. Each interval resamples matched per-person differences within its cohort, conditional on the fixed trained models and predictions.',
    diffRow: { ridge: 'Spectral ridge minus the source prior', cbramod: 'Frozen CBraMod minus the spectral ridge' },
    aboveZero: 'Interval above zero.',
    findLabel: (people: FigValue): Part[] => ['Frozen CBraMod minus the spectral ridge, two-class cohort, ', people, ' people'],
    findH3: 'Above the spectral baseline in both cohorts — as a comparison of two pipelines',
    findP: (): Part[] => ['Paired interval ', f(m2.paired.balanced_accuracy_difference.interval_95[0], 'sgn1'), ' to ', f(m2.paired.balanced_accuracy_difference.interval_95[1], 'pp1'), '. In the small three-class cohort the gap was ', gain3, ' (', f(m3.paired.balanced_accuracy_difference.interval_95[0], 'sgn1'), ' to ', f(m3.paired.balanced_accuracy_difference.interval_95[1], 'pp1'), '). The CBraMod arm was frozen after the spectral results existed and reuses their test trials: a comparative follow-up, not a fresh test set. There is no matched random-weight control, the two feature spaces differ in size and preprocessing (the same ridge alpha does not equalize regularization across them), and whether this checkpoint saw WBCIC-SHU in pretraining is not established, so the gap compares the two pipelines; it does not show that pretraining caused it. Each person’s session-1 labels train the readout: zero labels from session 3 is not a decoder for someone new.'],
    trials: (): Part[] => ['Trials: ', n(c2.source_trials), ' training and ', n(c2.target_trials), ' test trials in the two-class cohort, ', n(c3.source_trials), ' and ', n(c3.target_trials), ' in the three-class cohort; no person or trial was excluded. ', n(cpu.session_quality.fixed_count_holds), ' of the ', n(cpu.session_quality.sessions), ' session records hold fewer trials than the publisher’s nominal count (', n(cpu.session_quality.delivered_trials), ' delivered against ', n(cpu.session_quality.nominal_trials), '); ', n(cpu.session_quality.holds_in_selected_sessions), ' of them are in the sessions used and are admitted under a reviewed variable-N rule, with no filling, truncation or performance-based exclusion; the original strict-count holds stay recorded. Why the trials are missing is unknown.'],
    // RSVP
    rsEyebrow: 'Longitudinal RSVP · target detection · a first-visit decoder',
    rsH2: 'Does your decoder still work at later visits?',
    rsSubtitle: rs.subtitle,
    rsModel: (): Part[] => ['Decoder: ', rs.model.label, '.'],
    rsLede: (): Part[] => ['In rapid serial visual presentation (RSVP), a stream of face images is shown and the decoder has to pick out the rare target. ', n(rs.cohort.people), ' people, the source’s Group A, were recorded at visits the publisher labels Day 1, 7, 80 and 200. Each person’s decoder is trained and calibrated on their first visit only, then scored unchanged at each later visit: ', n(visits[0].events), ' events per visit across the ', n(rs.cohort.people), ' people.'],
    plotCaption: 'AUROC at each nominal later visit: the same people, one first-visit decoder each.',
    plotLegend: 'Participant-equal mean AUROC. Dot: the mean; line: its participant-bootstrap 95% interval, printed under each label; dashed line: chance, a decoder that orders events at random. The visits are labels, evenly spaced, not a time axis, and no curve is fitted between them. AUROC ranks targets above non-targets; it is not accuracy.',
    caveatsH: 'Read the chart with these',
    caveats: (): Part[][] => [
      ['Same person: each person’s first-visit labels train and calibrate their own decoder. Not a decoder for someone new.'],
      ['Nominal visits: Day 7, Day 80 and Day 200 are the publisher’s labels, not verified participant-specific calendar intervals.'],
      ['Rare targets: about ', f(visits[0].target_share), ' of events at every visit (the table gives each). AUROC ranks; average precision is not precision at a chosen threshold; neither is an online selection success rate. The target share describes the data; it is not a comparator.'],
      [n(rs.cohort.people), ' people and one fixed offline baseline: no clinical, real-time or causal claim, and no foundation model.'],
    ],
    rsRegion: 'Longitudinal RSVP, every published measure at each nominal visit, scrolls horizontally',
    rsCaption: (): Part[] => ['Participant-equal means at each nominal visit, ', n(rs.cohort.people), ' people; counts are event totals.'],
    colMeasure: 'Measure',
    measures: { auroc: 'AUROC', ap: 'Average precision', logloss: 'Log loss', brier: 'Brier score', ece: 'ECE, 10 bins', targets: 'Target events', delivered: 'Delivered events' },
    measureNote: { auroc: 'ranks targets, 0 to 1; not accuracy', ap: '0 to 1; not precision at a threshold', logloss: 'per event, natural log; lower is better', brier: 'lower is better', ece: 'expected calibration error; lower is better', targets: 'of all events at the visit', delivered: 'not available from the protected scoring interface' },
    ofEvents: (k: FigValue, all: FigValue): Part[] => [k, ' of ', all],
    nullCell: 'not available (null, not zero)',
