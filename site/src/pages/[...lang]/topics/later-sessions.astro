    admitted: (k: FigValue, of: FigValue): Part[] => ['纳入 ', k, ' 条记录（共 ', of, ' 条）'],
    timesMedian: (r: FigValue): Part[] => ['均值是中位数的 ', r, ' 倍'],
    worseOn: (k: FigValue, of: FigValue): Part[] => ['ridge 误差更高的记录：', k, ' 条（共 ', of, ' 条）'],
