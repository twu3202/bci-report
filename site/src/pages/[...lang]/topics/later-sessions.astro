    methodsH3: '每项结果是怎样得到的',
    methods: (): [string, Part[]][] => [
      ['WBCIC-SHU 基线', ['使用发布者预处理后的衍生数据：58 个匿名通道编号，250 Hz，4 秒分段。每个通道在 4–8、8–13、13–30 与 30–40 Hz 频带上的 Welch 相对频带功率，取对数比：每个试次 232 个值。StandardScaler 只在第 1 次会话上拟合，之后是 RidgeClassifier（alpha 为 1，不加类别权重）。没有超参搜索、目标会话归一化、校准或拒识。']],
      ['WBCIC-SHU，冻结 CBraMod', ['同样的试次，重采样到 200 Hz 并补零到 800 个采样点；每个试次、每个通道除以其自身的标准差，这是无量纲的输入，不是该检查点原生的幅值，所以这里也不复现上游基准中的数字。CBraMod 处于评估模式，所有权重冻结；四个时间片嵌入取平均，每个试次 11,600 个值；为每名被试单独在其第 1 次会话上拟合 StandardScaler 与 RidgeClassifier。没有训练主干网络，没有 LoRA，也没有目标会话校准。']],
      ['纵向 RSVP', ['57 个 EEG 通道，每个事件前 200 ms 到后 700 ms，做基线归一化；从 +100 到 +700 ms 取 6 个 100 ms 平均，每个事件 342 个值。每名被试第一次访次的第 1–3 组块拟合固定的 L2 逻辑回归，第 4 组块拟合 Platt 校准；后续访次在第 2–4 组块上评分。不使用 B 组。没有超参搜索、目标标签校准、微调或 LoRA。']],
      ['连续光标追踪', ['62 个通道，1,000 Hz，发布者已做带通与陷波滤波。4 到 30 Hz 之间的 5 个频带，经逐试次的 FIR 滤波，取前 1 秒的频带功率，表示为相对通道的对数功率：每行 310 个值，来自试次内过去 2 秒的窗口，每 40 ms 一行。每种响应变量分别只在最早会话上拟合 StandardScaler 与响应缩放，之后是 Ridge（alpha 为 1）。没有调参、LoRA、目标会话校准或基础模型推理。']],
    ],
    intervalsH3: '区间覆盖了什么',
    limitsH3: '四项结果共同的局限',
    intervals: '每个区间都是逐点的 95% 百分位区间，来自在各自队列内对被试（光标追踪中为记录）做的 10,000 次 bootstrap 重抽样，每个差值都用配对抽样。区间都以训练好的固定模型及其预测为条件：不包含重新拟合、预处理、模型与协议选择带来的不确定性——对 CBraMod 也不包含预训练数据重叠带来的不确定性——也没有做多重比较校正。',
    limits: [
      '每项结果都是同一被试。每个解码器都用这个人自己较早的有标签数据训练；这里没有任何结果衡量解码器在从未见过的人身上、或在另一个数据集上的表现。',
      '只有离线结果。不涉及实时、闭环、临床或部署方面的结论；在光标追踪中，也不涉及在线控制质量或意图运动解码。',
      '不合并，不排名。三个数据集、WBCIC-SHU 的两个队列、光标追踪的两个队列及其两种响应变量，都分开报告；没有一个分数能概括它们，也都不进入八个协议的核心矩阵。',
      '协议固定，在评分之前冻结；这里的分数没有用来调整协议。已说明的例外是 CBraMod 这一组：它在 spectral ridge 的结果出来之后才冻结，并复用了同样的测试试次。',
      '目标数据的标签与元信息曾被查看过。WBCIC-SHU 较早的结构检查查看过标签的取值范围与计数，RSVP 的事件角色与目标标签在质量检查中查看过。所有预测都在评分之前封存，没有任何目标标签进入归一化、拟合、校准、预测，或超参数、阈值、拒识与重试方面的决定。',
      '沿用发布者的预处理。WBCIC-SHU 的通道顺序依据的是发布者的处理流程与原始文件头，而不是从原始数据到处理后数据的直接证明，它的物理幅值也尚未确定。其参考、滤波、分段与基线处理的选择过程及时间支撑也没有完全确定。',
      '没有校准组。WBCIC-SHU 的两项结果都不能说明加入少量第 3 次会话的有标签试次是否有帮助：这需要单独匹配的一组，而这里没有运行（也没有 LoRA 或校准预算方面的比较）。',
      '光标追踪：会话、练习、速度与当时所用的历史解码器相互混杂，记录中的解码器标签是观察性的情境，不是随机分配的比较；会话内解码器的先后顺序未知，所以不能作按时间顺序的前缀划分或在线适配方面的结论。只用源会话数据的稳定性诊断将是一项新的、单独冻结的分析，而不是对这些分数的修改。',
      '审计范围。每项结果都通过了针对其已保存预测、指标与区间的独立数值审计；都没有从原始 EEG 独立重做完整的特征提取，CBraMod 的编码器也没有在全部 EEG 上重新运行。',
    ],
    notPubH3: '这里不发布的内容',
    notPub: '任何逐人或逐条记录的数值——所有最小值与百分位数，以及除光标追踪中与均值并列的四个 spectral ridge 中位数之外的所有中位数；哪些人下降了、哪些记录更差；WBCIC-SHU 的混淆矩阵；按记录时所用解码器划分的光标追踪结果；实测的计算量；以及任何被试、记录或文件标识。',
    creditsH3: '署名、许可与知情同意',
    consentH: '论文陈述的伦理与知情同意：',
    readFrom: '读自论文全文 ↗',
    recordLink: '数据集记录 ↗', paperLink: '论文 ↗',
    cbramodCredit: (): Part[] => ['CBraMod，即这里的冻结编码器：其论文，以及固定检查点的 SHA-256 ', fm.model.checkpoint_sha256.slice(0, 12), '…（版本 ', fm.model.source_revision.slice(0, 12), '…）。WBCIC-SHU 是否出现在它的预训练数据中没有确定：模型论文说明预训练使用 TUH EEG 语料，固定版本的代码仓库把 SHU 列为下游任务，两者都没有给出针对该检查点的文件清单。'],
    cbramodPaper: 'CBraMod 论文 ↗', cbramodPage: 'CBraMod 的页面',
    derived: '以上均为 BCI Report 的衍生分析，只发布聚合结果；不代表数据作者的认可，也不再分发任何原始数据。',
    relatedH2: '相关问题',
    related: [
      { text: '同一个人的下一次会话，加入或不加入少量该会话的校准试次——OpenBMI 运动想象，两个经典基线：', href: '/topics/calibration-budget/#next-session', link: topicCards.zh['calibration-budget'].question },
      { text: '第二天，以及更新预训练模型的三种方式——已运行并通过独立复核，处于暂缓状态，所以不发布任何数字：', href: '/topics/model-adaptation/#next-day', link: topicCards.zh['model-adaptation'].question },
      { text: '同一个人之后的会话，一项只发状态的纵向试点，在同一页面：', href: '/topics/model-adaptation/#cross-session', link: '同一个人，之后的会话' },
      { text: 'CBraMod 与其他冻结编码器在核心协议上的结果，以及预训练与随机初始化的对比：', href: '/topics/does-pretraining-help/', link: topicCards.zh['does-pretraining-help'].question },
    ],
  },
}[locale];

// The consent and ethics sentences: the export's English, and its Chinese here, held to the export's wording.
const consentZh: Record<string, [string, string, string, string]> = {
  'wbcic-shu': ['Approved by the Tsinghua University Medical Ethics Committee (approval number 20190002); carried out in line with the Declaration of Helsinki.',
    'Written informed consent was obtained from the participants after they were informed about the procedure, purpose, requirements and motor-imagery techniques.',
    '经清华大学医学伦理委员会批准（批准号 20190002），按《赫尔辛基宣言》开展。',
    '被试在了解实验流程、目的、要求与运动想象技巧之后，签署了书面知情同意。'],
  'longitudinal-rsvp': ['Approved by the Tsinghua Institutional Review Board (No. 20230058).',
    'Each participant read and signed an informed consent form before the experiment.',
    '经清华大学机构审查委员会批准（编号 20230058）。',
    '每名被试在实验前阅读并签署了知情同意书。'],
  'forenzo-continuous-tracking': ['Approved by the Institutional Review Board at Carnegie Mellon University; no approval number is given.',
    'Each subject provided written consent to the protocol before participating.',
    '经 Carnegie Mellon University 机构审查委员会批准；论文没有给出批准编号。',
    '每名被试在参加之前对实验方案给予了书面同意。'],
};
const credits = (['wbcic-shu', 'longitudinal-rsvp', 'forenzo-continuous-tracking'] as const).map(id => {
  const d = (later.datasets as Record<string, any>)[id], e = d.consent_and_ethics, r = d.rights, z = consentZh[id];
  need(e.ethics_approval.stated && e.informed_consent.stated && e.ethics_approval.statement === z[0] && e.informed_consent.statement === z[1], `the ${id} consent and ethics sentences`);
  const paper = r.reviewBasis.find((u: string) => u.startsWith('https://doi.org/') && u !== r.source);
  const pmc = r.reviewBasis.find((u: string) => u.includes('europepmc.org'));
  need(Boolean(paper && pmc), `the ${id} rights record names its paper and the full text the statements were read from`);
  return { id, r, e, paper, pmc, ethics: zh ? z[2] : e.ethics_approval.statement, consent: zh ? z[3] : e.informed_consent.statement };
});
const card = topicCards[locale]['later-sessions'];
---
<TopicLayout
  locale={locale}
  title={card.title}
  description={copy.description}
  path="/topics/later-sessions/"
  eyebrow={copy.eyebrow}
  dek={copy.dek}
  activeSlug="later-sessions"
  answer={copy.answer}
  dataFiles={['/data/later-sessions-update.json']}
>
  <section class="topic-section" id="wbcic-shu" aria-labelledby="wbcic-heading" data-later="wbcic">
    <div class="topic-heading"><div><p class="eyebrow">{copy.wbEyebrow}</p><h2 id="wbcic-heading">{copy.wbH2}</h2></div><p>{(copy.wbLede()).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</p></div>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.baRegion}>
      <table data-later-table="wbcic-ba">
        <caption>{(copy.baCaption()).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</caption>
        <thead><tr><th scope="col">{copy.colArm}</th>{cohorts.map(c => <th scope="col">{(copy.colCohort(c, n(cpu.cohorts[c].people))).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}<small>{cohortClasses(c)}</small></th>)}</tr></thead>
        <tbody>
          <tr data-later-row="source_prior"><th scope="row">{armName.source_prior}<small>{armNote.source_prior}</small></th>{cohorts.map(c => { const x = cpu.cohorts[c].arms.source_prior; return <td data-cell={`${c}|source_prior`}><Fig f={f(x.balanced_accuracy.mean)} cls="metric"/><span class="interval">{(copy.secondary(f(x.accuracy.mean), f(x.macro_f1.mean))).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</span></td>; })}</tr>
          <tr data-later-row="relative_spectral_ridge"><th scope="row">{armName.relative_spectral_ridge}<small>{armNote.relative_spectral_ridge}</small></th>{cohorts.map(c => { const x = cpu.cohorts[c].arms.relative_spectral_ridge; return <td data-cell={`${c}|relative_spectral_ridge`}><Fig f={f(x.balanced_accuracy.mean)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={f(x.balanced_accuracy.interval_95[0])}/>–<Fig f={f(x.balanced_accuracy.interval_95[1])}/></span><span class="interval">{(copy.secondary(f(x.accuracy.mean), f(x.macro_f1.mean))).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</span></td>; })}</tr>
          <tr data-later-row="frozen_cbramod"><th scope="row">{armName.frozen_cbramod}<small>{armNote.frozen_cbramod}</small></th>{cohorts.map(c => { const x = fm.cohorts[c].frozen_cbramod; return <td data-cell={`${c}|frozen_cbramod`}><Fig f={f(x.balanced_accuracy.mean)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={f(x.balanced_accuracy.interval_95[0])}/>–<Fig f={f(x.balanced_accuracy.interval_95[1])}/></span><span class="interval">{(copy.secondary(f(x.accuracy.mean), f(x.macro_f1.mean))).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</span></td>; })}</tr>
        </tbody>
      </table>
    </div>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.diffRegion}>
      <table data-later-table="wbcic-diff">
        <caption>{copy.diffCaption}</caption>
        <thead><tr><th scope="col">{copy.colArm}</th>{cohorts.map(c => <th scope="col">{(copy.colCohort(c, n(cpu.cohorts[c].people))).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</th>)}</tr></thead>
        <tbody>
          {([['ridge', (c: '2C' | '3C') => cpu.cohorts[c].paired], ['cbramod', (c: '2C' | '3C') => fm.cohorts[c].paired]] as const).map(([k, get]) => <tr data-later-row={`diff-${k}`}><th scope="row">{copy.diffRow[k]}</th>{cohorts.map(c => { const d = get(c), x = d.balanced_accuracy_difference; return <td data-cell={`${c}|diff-${k}`}><Fig f={f(x.mean, 'pp1')} cls="metric"/><span class="interval">{tc.interval95} <Fig f={f(x.interval_95[0], 'sgn1')}/> {tc.to} <Fig f={f(x.interval_95[1], 'pp1')}/></span>{d.interval_excludes_zero && <span class="interval">{copy.aboveZero}</span>}</td>; })}</tr>)}
        </tbody>
      </table>
    </div>
    <div class="finding" data-finding="wbcic|2C|frozen_cbramod">
      <div class="finding-number"><strong><Fig f={gain2}/></strong><span>{(copy.findLabel(n(m2.people))).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</span></div>
      <div class="finding-copy"><h3>{copy.findH3}</h3><p>{(copy.findP()).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</p></div>
    </div>
    <p class="protocol-note" data-later-note="wbcic-trials">{(copy.trials()).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</p>
  </section>

  <section class="topic-section" id="longitudinal-rsvp" aria-labelledby="rsvp-heading" data-later="rsvp">
    <div class="topic-heading"><div><p class="eyebrow">{copy.rsEyebrow}</p><h2 id="rsvp-heading">{copy.rsH2}</h2><p class="topic-subtitle" data-subtitle="rsvp">{copy.rsSubtitle}{zh && <span class="note-original" lang="en">{rs.subtitle}</span>}</p></div><p>{(copy.rsLede()).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</p></div>
    <p class="protocol-note" data-later-note="rsvp-model">{copy.rsModel().map(p => typeof p === 'string' ? (p === rs.model.label ? <span lang="en">{p}</span> : p) : <Fig f={p}/>)}</p>
    <IntervalPlot
      id="rsvp-auroc"
      caption={copy.plotCaption}
      legend={copy.plotLegend}
      domain={[0.5, 1]}
      ticks={['0.50', '0.625', '0.75', '0.875', '1.00']}
      reference={0.5}
      rows={rsvpRows}
    />
    <div class="rsvp-caveats" data-later-note="rsvp-caveats"><h3 class="roadmap-h3">{copy.caveatsH}</h3><ul class="rd-rules">{copy.caveats().map(c => <li>{(c).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</li>)}</ul></div>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.rsRegion}>
      <table data-later-table="rsvp">
        <caption>{(copy.rsCaption()).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</caption>
        <thead><tr><th scope="col">{copy.colMeasure}</th>{visits.map(v => <th scope="col">{visitName(v)}</th>)}</tr></thead>
        <tbody>
          <tr data-later-row="auroc"><th scope="row">{copy.measures.auroc}<small>{copy.measureNote.auroc}</small></th>{visits.map(v => <td data-cell={`${v.nominal_day}|auroc`}><Fig f={f(v.auroc.mean, 'auc3')} cls="metric"/><span class="interval">{tc.interval95} <Fig f={f(v.auroc.interval_95[0], 'auc3')}/>–<Fig f={f(v.auroc.interval_95[1], 'auc3')}/></span></td>)}</tr>
          <tr data-later-row="average_precision"><th scope="row">{copy.measures.ap}<small>{copy.measureNote.ap}</small></th>{visits.map(v => <td data-cell={`${v.nominal_day}|average_precision`}><Fig f={f(v.average_precision.mean, 'auc3')} cls="metric"/></td>)}</tr>
          <tr data-later-row="log_loss"><th scope="row">{copy.measures.logloss}<small>{copy.measureNote.logloss}</small></th>{visits.map(v => <td data-cell={`${v.nominal_day}|log_loss`}><Fig f={f(v.log_loss.mean, 'num3')} cls="metric"/></td>)}</tr>
          <tr data-later-row="brier_score"><th scope="row">{copy.measures.brier}<small>{copy.measureNote.brier}</small></th>{visits.map(v => <td data-cell={`${v.nominal_day}|brier_score`}><Fig f={f(v.brier_score.mean, 'num3')} cls="metric"/></td>)}</tr>
          <tr data-later-row="ece_10_bins"><th scope="row">{copy.measures.ece}<small>{copy.measureNote.ece}</small></th>{visits.map(v => <td data-cell={`${v.nominal_day}|ece_10_bins`}><Fig f={f(v.ece_10_bins.mean, 'num3')} cls="metric"/></td>)}</tr>
          <tr data-later-row="target_events"><th scope="row">{copy.measures.targets}<small>{copy.measureNote.targets}</small></th>{visits.map(v => <td data-cell={`${v.nominal_day}|target_events`}><span class="metric">{(copy.ofEvents(n(v.target_events), n(v.events))).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</span><span class="interval"><Fig f={f(v.target_share)}/></span></td>)}</tr>
          <tr data-later-row="delivered_events"><th scope="row">{copy.measures.delivered}<small>{copy.measureNote.delivered}</small></th>{visits.map(v => <td data-cell={`${v.nominal_day}|delivered_events`} data-null="true">{copy.nullCell}</td>)}</tr>
        </tbody>
      </table>
    </div>
    <div class="finding" data-finding="rsvp|contrast">
      <div class="finding-number"><strong><Fig f={dAu}/></strong><span>{(copy.rsFindLabel(n(dd.people))).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</span></div>
      <div class="finding-copy"><h3>{copy.rsFindH3}</h3><p>{(copy.rsFindP()).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</p></div>
    </div>
    <p class="protocol-note" data-later-note="rsvp-coding">{copy.rsCoding}</p>
  </section>

  <section class="topic-section" id="forenzo" aria-labelledby="forenzo-heading" data-later="forenzo">
    <div class="topic-heading"><div><p class="eyebrow">{copy.fzEyebrow}</p><h2 id="forenzo-heading">{copy.fzH2}</h2><p class="topic-subtitle" data-subtitle="forenzo">{copy.fzLabel}{zh && <span class="note-original" lang="en">{fz.label}</span>}</p></div><p>{copy.fzLede}</p></div>
    <div class="evidence-grid">{copy.fzCards.map(x => <article class="evidence-card"><p class="eyebrow">{x.h}</p><div class="reading">{(x.v()).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</div><p>{(x.p()).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</p></article>)}</div>
    <p class="roadmap-p" data-later-note="forenzo-metric">{copy.metric}</p>
    <p class="protocol-note" data-later-note="forenzo-arms">{copy.armsNote}</p>
    {fzArms.map(a => <div class="forenzo-arm" data-forenzo-arm={a}>
      <h3 class="roadmap-h3">{fzArmName[a].name} <span class="arm-tag">{zh ? `· ${fzArmName[a].tag}` : `(${fzArmName[a].tag})`}</span></h3>
      <p class="roadmap-p">{fzArmName[a].what}</p>
      <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.fzRegion(fzArmName[a].name)}>
        <table data-later-table={`forenzo|${a}`}>
          <caption>{copy.fzCaption(fzArmName[a].name, fzArmName[a].tag)}</caption>
          <thead><tr><th scope="col">{copy.colCohort2}</th><th scope="col">{copy.colRidgeMean}</th><th scope="col">{copy.colRidgeMedian}</th><th scope="col">{copy.colComparator}</th><th scope="col">{copy.colPaired}</th></tr></thead>
          <tbody>{fzCohorts.map(c => { const x = cell(c, a); return <tr data-forenzo-cell={`${c}|${a}`}>
            <th scope="row">{fzCohortName(c)}<small>{(copy.admitted(n(fzc[c].admitted_records), n(fzc[c].candidate_records))).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</small></th>
            <td data-cell="ridge-mean"><Fig f={w(x.ridge.primary.mean)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={w(x.ridge.primary.interval_95[0])}/> {tc.to} <Fig f={w(x.ridge.primary.interval_95[1])}/></span></td>
            <td data-cell="ridge-median"><Fig f={w(x.ridge.primary.median)} cls="metric"/><span class="interval">{(copy.timesMedian(f(x.upper_tail.ridge_mean_over_median, 'int0'))).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</span></td>
            <td data-cell="comparator"><Fig f={w(x.source_mean.primary.mean)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={w(x.source_mean.primary.interval_95[0])}/> {tc.to} <Fig f={w(x.source_mean.primary.interval_95[1])}/></span></td>
            <td data-cell="paired"><Fig f={w(x.paired.primary_difference.mean)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={w(x.paired.primary_difference.interval_95[0])}/> {tc.to} <Fig f={w(x.paired.primary_difference.interval_95[1])}/></span><span class="interval">{(copy.worseOn(n(x.paired.records_with_higher_ridge_error), n(x.paired.records))).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</span></td>
          </tr>; })}</tbody>
        </table>
      </div>
      <IntervalPlot
        id={`forenzo-tail-${a === 'historical_decoder_velocity_imitation' ? 'velocity' : 'displacement'}`}
        caption={copy.tailCaption(fzArmName[a].name)}
        legend={copy.tailLegend}
        domain={[-2, 6]}
        ticks={['10⁻²', '1', '10²', '10⁴', '10⁶']}
        rows={tailRows(a)}
      />
    </div>)}
    <p class="roadmap-p" data-later-note="forenzo-tail">{(copy.tail()).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</p>
    <p class="protocol-note" data-later-note="forenzo-coverage">{(copy.coverage()).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</p>
    <p class="protocol-note" data-later-note="forenzo-cohort-name">{copy.cohortNameNote}</p>
    <details class="rd-panel" data-later-note="forenzo-secondary">
      <summary>{copy.secSummary}</summary>
      <p class="roadmap-p">{copy.secKey}</p>
      {fzArms.map(a => <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.secRegion(fzArmName[a].name)}>
        <table data-later-table={`forenzo-secondary|${a}`}>
          <caption>{copy.secCaption(fzArmName[a].name)}</caption>
          <thead><tr><th scope="col">{copy.colModel}</th>{secondaryKeys.map(k => <th scope="col">{secondaryHead[k]}</th>)}</tr></thead>
          <tbody>{fzCohorts.flatMap(c => (['ridge', 'source_mean'] as const).map(m => { const s = cell(c, a)[m].secondary; return <tr data-forenzo-secondary={`${c}|${a}|${m}`}>
            <th scope="row">{fzCohortName(c)}<small>{m === 'ridge' ? copy.ridgeName : copy.comparatorName}</small></th>
            {secondaryKeys.map(k => { const v = s[k]; return v.mean === null
              ? <td data-cell={k} data-null="true">{copy.undefinedCell}</td>
              : <td data-cell={k}><Fig f={w(v.mean)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={w(v.interval_95[0])}/> {tc.to} <Fig f={w(v.interval_95[1])}/></span></td>; })}
          </tr>; }))}</tbody>
        </table>
      </div>)}
    </details>
  </section>

  <section class="topic-section" id="methods-and-limits" aria-labelledby="limits-heading">
    <div class="topic-heading"><div><p class="eyebrow">{tc.methodsEyebrow}</p><h2 id="limits-heading">{copy.limitsH2}</h2></div></div>
    <h3 class="roadmap-h3">{copy.methodsH3}</h3>
    <div class="method-grid-wide" data-later-note="methods">{copy.methods().map(([h, p]) => <article><h3>{h}</h3><p>{(p).map(p => typeof p === 'string' ? p : <Fig f={p}/>)}</p></article>)}</div>
    <h3 class="roadmap-h3">{copy.intervalsH3}</h3>
    <p class="roadmap-p" data-later-note="intervals">{copy.intervals}</p>
    <h3 class="roadmap-h3">{copy.limitsH3}</h3>
    <ul class="rd-rules" data-later-note="limits">{copy.limits.map(x => <li>{x}</li>)}</ul>
    <h3 class="roadmap-h3">{copy.notPubH3}</h3>
    <p class="roadmap-p" data-later-note="not-published">{copy.notPub}</p>
    <h3 class="roadmap-h3">{copy.creditsH3}</h3>
    <div class="citation-list" id="credits">{credits.map(x => <article data-credit={x.id}>
      <h3 lang="en">{x.r.name}</h3>
      <p lang="en">{x.r.attribution}</p>
      <p data-consent={x.id}><strong>{copy.consentH}</strong>{zh ? '' : ' '}{x.ethics}{zh ? '' : ' '}{x.consent}{zh && <span class="note-original" lang="en">{x.e.ethics_approval.statement} {x.e.informed_consent.statement}</span>}</p>
      <p><a href={x.r.source} target="_blank" rel="noreferrer">{copy.recordLink}</a> · <a href={x.paper} target="_blank" rel="noreferrer">{copy.paperLink}</a> · <a href={x.r.licenseUrl} target="_blank" rel="noreferrer">{x.r.license}</a> · <a href={x.pmc} target="_blank" rel="noreferrer">{copy.readFrom}</a></p>
    </article>)}
      <article data-credit="cbramod">
        <h3 lang="en">CBraMod</h3>
        <p>{copy.cbramodCredit().map(p => typeof p === 'string' && /^[0-9a-f]{12}$/.test(p) ? <code>{p}</code> : typeof p === 'string' ? p : <Fig f={p}/>)}</p>
        <p><a href={fm.model.paper} target="_blank" rel="noreferrer">{copy.cbramodPaper}</a> · <a href={hrefFor('/methods/cbramod/', locale)}>{copy.cbramodPage}</a></p>
      </article>
    </div>
    <p class="citation-note">{copy.derived}</p>
    <p class="citation-note">{tc.dataSource} <a href="/data/later-sessions-update.json" download>later-sessions-update.json</a> · {tc.schema} {later.schema_version}{tc.period}</p>
  </section>

  <section class="topic-section" id="related" aria-labelledby="related-heading">
    <div class="topic-heading"><div><h2 id="related-heading">{copy.relatedH2}</h2></div></div>
    <ul class="rd-rules" data-later-note="related">{copy.related.map(x => <li>{x.text}<a href={hrefFor(x.href, locale)}>{x.link}</a>{/[?？]$/.test(x.link) ? '' : zh ? '。' : '.'}</li>)}</ul>
  </section>
</TopicLayout>
