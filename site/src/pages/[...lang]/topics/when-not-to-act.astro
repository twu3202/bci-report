---
import data from '../../../data/mvp.json';
import context from '../../../data/context-update.json';
import TopicLayout from '../../../components/TopicLayout.astro';
import ScoreBar from '../../../components/ScoreBar.astro';
import { pct } from '../../../data/topics';
import { decisionCopy, decisionRoadmap, decisionSources } from '../../../data/decision-research';
import { hrefFor, localeOf, localeParams, topicCards, topicChrome } from '../../../data/i18n';

export const getStaticPaths = localeParams;
const locale = localeOf(Astro.params.lang);
const tc = topicChrome[locale];
const plan = decisionCopy[locale];

// Every figure on this page comes from the reviewed idle protocol in the core
// snapshot. No new measurement enters here; the section below the table is a
// plan, and renders no number.
const idle = data.tracks.find(t => t.id === 'idle')!;
const [, idleN, cmdN] = idle.observations.match(/(\d+) idle \/ (\d+) command/)!.map(Number);
const people = idle.subjects;
const count = (percent: number, of: number) => Math.round(percent / 100 * of);
const rows = [...idle.rows].sort((a, b) => b.y - a.y).map(r => ({
  ...r, commands: count(r.y, cmdN), falseActs: count(r.x, idleN),
}));
// The quietest decoder: no false activation, fewest commands detected.
const quiet = rows.filter(r => r.falseActs === 0).sort((a, b) => a.commands - b.commands)[0];
const noun = (n: number, one: string, many: string) => (n === 1 ? one : many);

// Explicit non-control conditions (2026-09-27 export). It was held for its
// consent statement; the export carries a key for it only because the manifest
// now records a complete approval, and without one this section cannot render.
const nc = (context.results as Record<string, any>)['ysu-async-ssvep'] as undefined | {
  people: number; control_windows: { tested: number; frequency_recognised: number; accepted: number; accepted_and_correct: number };
  control_vs_non_control_balanced_accuracy: number;
  false_acceptance: { condition: string; accepted: number; tested: number }[];
  rights: { name: string; attribution: string; license: string; licenseUrl: string; reviewBasis: string[] };
};
const frac = (a: number, b: number) => `${a} / ${b}`;

// Figures the short answer names: counts already printed in the two tables
// below, stated as "k / n" the way the page states them. The conditional
// accuracy among accepted windows is left out — it may not travel without
// coverage and the end-to-end rate. The non-control clause exists only when its
// section renders.
const ncAccepted = nc ? frac(nc.control_windows.accepted, nc.control_windows.tested) : '';
const ncFalse = nc ? nc.false_acceptance.map(f => `[[${frac(f.accepted, f.tested)}]]`) : [];
const series = (items: string[], sep: string, last: string) =>
  items.length < 2 ? items.join('') : `${items.slice(0, -1).join(sep)}${last}${items[items.length - 1]}`;

const modeLabel: Record<string, string> = locale === 'zh'
  ? { 'Supervised fit': '监督拟合', 'Frozen encoder + linear head': '冻结编码器 + 线性分类头', 'Scratch · 20 epochs': '从头训练 · 20 轮' }
  : {};

const copy = {
  en: {
    documentTitle: `${topicCards.en['when-not-to-act'].question} · Jev-style decision models for EEG`,
    description: `It depends on how often the decoder acts at all. In a cue-gated idle test with ${people} people, ${quiet.name} made ${quiet.falseActs} / ${idleN} false activations but detected ${quiet.commands} / ${cmdN} commands: a decoder that never acts never fires by mistake, so both numbers are read together.`,
    answer: `It depends on how often the decoder acts at all: one that never acts never fires by mistake, so its false activations mean something only beside the commands it caught. In a cue-gated idle test with [[${people}]] people, the quietest decoder, ${quiet.name}, made [[${quiet.falseActs} / ${idleN}]] false activations in idle trials but detected [[${quiet.commands} / ${cmdN}]] commands, and for [[${quiet.abstain}]] of those people its threshold rejected every command${nc ? `; in a separate pilot with [[${nc.people}]] other people, a CCA decoder accepted [[${ncAccepted}]] windows when a command was intended, and ${series(ncFalse, ', ', ' and ')} in the states where none was` : ''}. ${nc ? 'Both are small pilots, counted per trial or per window rather than per hour' : 'It is a small pilot, counted per trial rather than per hour'}: neither can say how often a decoder would fire by mistake over an hour of real rest.`,
    eyebrow: 'Abstention · Jev-style research plan',
    dek: `On this site's idle protocol, ${quiet.name} made no false activation in ${idleN} idle trials — and detected ${quiet.commands} of ${cmdN} commands. ${quiet.abstain} of its ${people} people ended up with a threshold that rejects every command. A false-activation rate read on its own rewards a decoder for doing nothing. This page keeps the two numbers together, then sets out a Jev-style research plan: what would have to be measured to say when a decoder should act at all.`,
    findingLabel: `${quiet.name}: idle false activations, ${people} people`,
    findingH3: `No false activation, and ${quiet.commands} ${noun(quiet.commands, 'command', 'commands')} in ${cmdN}`,
    findingP: `Thresholds are chosen on calibration data only, and a threshold may reject every command. For ${quiet.abstain} of ${people} people it did. Someone who never triggers a command never triggers one by mistake either, so the number of people who always abstained is printed beside every method.`,
    tableEyebrow: 'Both numbers, every method',
    tableH2: 'Command detection against idle false activation',
    tableLede: `${people} people; ${idleN} idle and ${cmdN} command test trials in total; a command counts if it is detected within 3 seconds of its cue. Sorted by command detection.`,
    tableRegion: 'Idle and command results, scrolls horizontally',
    caption: 'Counts over the whole test set, with the percentage beneath. “Always abstained” counts people whose calibrated threshold rejected every command.',
    colMethod: 'Method', colMode: 'Training', colCmd: 'Commands detected ≤3 s', colFalse: 'Idle false activations', colAbstain: 'Always abstained',
    ofPeople: `of ${people} people`,
    cmdLabel: (v: string) => `${v} of commands detected`,
    limitsH2: 'What these numbers cannot say',
    limitsLede: 'A small, cue-gated protocol. It shows why both numbers are needed; it cannot say how a decoder would behave in continuous use.',
    limits: [
      [`${people} people`, `At this size an average stays close to its parts: a published rate can be turned back into a count, and a count narrowed to one of two people. The arithmetic is written out on the data-use page.`],
      ['Three minutes of idle', `The test holds ${idle.exposure.replace('of test idle', '').trim()} of idle. That cannot estimate how often a decoder would fire by mistake over an hour of real, unprompted rest.`],
      ['Cue-gated, not always-on', 'Detection restarts at every cue, so the decoder always knows a decision window has opened. A system that must notice intent on its own faces a harder problem than this protocol measures.'],
      ['No probability quality yet', 'These are thresholded decisions. How well each method’s probabilities are calibrated — the basis for deciding when to defer — has not been measured on this protocol.'],
    ],
    smallCohorts: 'The four-person arithmetic, in full (English)',
    consent: 'The source README reports voluntary signed consent and approval by the ethics committee of Universidad Antonio Nariño. Only cohort aggregates appear here.',
    datasetLink: 'OpenNeuro dataset ↗', studyLink: 'Associated study ↗',
    csv: 'this protocol as CSV',
    ncEyebrow: 'Explicit non-control · four-person pilot',
    ncH2: 'Does it accept a window when nobody intends a command?',
    ncLede: 'A second protocol records the states between commands on purpose: looking at a central image with the flicker off, resting on a white wall, and looking at the centre while the targets around it flicker. A fixed CCA decoder with per-person thresholds, fitted on calibration trials only, decides whether to accept each 1.5-second window.',
    ncControlH3: 'When a command was intended',
    ncControlNote: 'Accuracy among accepted windows is never shown alone: rejecting hard windows raises it while refusing commands the person meant.',
    ncRows: ['Frequency recognised, before rejection', 'Accepted (coverage)', 'Accepted and correct (end to end)', 'Correct among accepted'],
    ncNonH3: 'When no command was intended',
    ncCondition: { 'central image, flicker off': 'Central image, flicker off', 'looking at a white wall, resting': 'Looking at a white wall, resting', 'central image while the surrounding stimuli flicker': 'Central image while the surrounding targets flicker' } as Record<string, string>,
    colWindows: 'Windows', colState: 'State', colAccepted: 'Accepted by mistake',
    ncRegion: 'Control and non-control windows, scrolls horizontally',
    ncLimits: 'Four people, offline, window by window. These are rates per tested window, not false activations per hour, and the source states no physical amplitude unit.',
    ncConsent: 'Before the experiment, every participant signed written informed consent; the study was reviewed and approved by the ethics committee of Qinhuangdao First Hospital. This site uses four of the release’s twenty-four people and publishes pooled counts only.',
    ncPaper: 'Data paper ↗', ncData: 'figshare release ↗', ncSmall: 'Why four people limit what can be published (English)',
  },
  zh: {
    documentTitle: `${topicCards.zh['when-not-to-act'].question} · Jev-style 的 EEG 决策模型`,
    description: `取决于解码器有多愿意执行。在 ${people} 名被试的提示同步空闲测试中，${quiet.name} 的空闲误触发为 ${quiet.falseActs} / ${idleN}，但指令只检出 ${quiet.commands} / ${cmdN}：从不执行的解码器也就从不误触发，所以两个数字要放在一起读。`,
    answer: `取决于解码器有多愿意执行：从不执行的解码器，也就从不误触发，所以误触发只有和它检出的指令放在一起读才有意义。在 [[${people}]] 名被试的提示同步空闲测试中，最安静的解码器 ${quiet.name} 在空闲试次里的误触发为 [[${quiet.falseActs} / ${idleN}]]，但指令只检出 [[${quiet.commands} / ${cmdN}]]，并且有 [[${quiet.abstain}]] 名被试的阈值拒绝了全部指令${nc ? `；在另一组 [[${nc.people}]] 名被试的试点中，CCA 解码器在有意发出指令时接受了 [[${ncAccepted}]] 个窗口，在无意发出指令的各状态下分别误接受了 ${series(ncFalse, '、', ' 和 ')}` : ''}。${nc ? '两者都是小规模试点，按试次或窗口计数，而不是按小时' : '这是一个小规模试点，按试次计数，而不是按小时'}，所以说明不了在一个小时真实的休息中，解码器会误触发多少次。`,
    eyebrow: '拒识 · Jev-style 研究计划',
    dek: `在本站的空闲协议上，${quiet.name} 在 ${idleN} 个空闲试次里没有一次误触发——同时在 ${cmdN} 条指令中只检出 ${quiet.commands} 条。它的 ${people} 名被试中有 ${quiet.abstain} 名最终用上了拒绝一切指令的阈值。单看误触发率，等于奖励一个什么都不做的解码器。本页把两个数字放在一起，再给出一个 Jev-style 研究计划：要测什么，才能回答解码器究竟该不该执行。`,
    findingLabel: `${quiet.name}：空闲误触发，${people} 名被试`,
    findingH3: `没有误触发，${cmdN} 条指令只检出 ${quiet.commands} 条`,
    findingP: `阈值只用校准数据来选，而选出的阈值可能拒绝所有指令。${people} 名被试中有 ${quiet.abstain} 名正是如此。从不触发指令的人，自然也从不误触发，所以每种方法旁边都列出了始终拒识的人数。`,
    tableEyebrow: '两个数字，每种方法',
    tableH2: '指令检出与空闲误触发',
    tableLede: `${people} 名被试；测试集共 ${idleN} 个空闲试次和 ${cmdN} 个指令试次；指令在提示后 3 秒内被检出才算。按指令检出率排序。`,
    tableRegion: '空闲与指令结果，可横向滚动',
    caption: '整个测试集上的计数，下方为百分比。“始终拒识”指校准得到的阈值拒绝了全部指令的被试人数。',
    colMethod: '方法', colMode: '训练方式', colCmd: '3 秒内检出的指令', colFalse: '空闲误触发', colAbstain: '始终拒识',
    ofPeople: `共 ${people} 名被试`,
    cmdLabel: (v: string) => `指令检出率 ${v}`,
    limitsH2: '这些数字说明不了什么',
    limitsLede: '一个规模小、提示同步的协议。它说明了为什么两个数字缺一不可，却说明不了解码器在连续使用中的表现。',
    limits: [
      [`${people} 名被试`, '在这个规模下，平均值离每个人都很近：公开的比率可以还原成计数，计数又能缩小到两个人中的一个。具体算法写在数据使用页上。'],
      ['三分钟的空闲', '测试中只有 180 秒的空闲。它估计不了在一个小时真实、无提示的休息中，解码器会误触发多少次。'],
      ['提示同步，不是全天候', '每次提示都会重新开始检测，所以解码器总是知道决策窗口已经打开。一个必须自己察觉意图的系统，面对的问题比这个协议测的更难。'],
      ['还没有测概率质量', '这些都是经过阈值的决策。每种方法的概率校准得好不好——这正是判断何时该推迟决策的依据——还没有在这个协议上测过。'],
    ],
    smallCohorts: '四人队列的完整算法（英文）',
    consent: '数据源 README 写明被试自愿签署了同意书，并经 Universidad Antonio Nariño 伦理委员会批准。这里只发布队列级聚合结果。',
    datasetLink: 'OpenNeuro 数据集 ↗', studyLink: '相关研究论文 ↗',
    csv: '本协议的 CSV',
    ncEyebrow: '明确的非控制状态 · 四人试点',
    ncH2: '没人想发指令时，它会不会接受这个窗口？',
    ncLede: '另一个协议专门记录了指令之间的状态：注视中央图像但闪烁关闭、看着白墙休息、注视中央而周围目标在闪烁。一个固定的 CCA 解码器配合只用校准试次拟合的逐人阈值，决定是否接受每个 1.5 秒窗口。',
    ncControlH3: '有意发出指令时',
    ncControlNote: '被接受窗口中的准确率从不单独呈现：拒绝困难窗口会抬高这个数字，但代价是拒绝了被试本想发出的指令。',
    ncRows: ['拒识前识别出正确频率', '被接受（覆盖率）', '被接受且正确（端到端）', '被接受窗口中的正确率'],
    ncNonH3: '无意发出指令时',
    ncCondition: { 'central image, flicker off': '注视中央图像，闪烁关闭', 'looking at a white wall, resting': '看着白墙休息', 'central image while the surrounding stimuli flicker': '注视中央，周围目标在闪烁' } as Record<string, string>,
    colWindows: '窗口', colState: '状态', colAccepted: '被误接受',
    ncRegion: '控制与非控制窗口，可横向滚动',
    ncLimits: '四名被试、离线、逐窗口统计。这些是每个测试窗口上的比率，不是每小时的误触发次数；数据源也没有说明物理幅值单位。',
    ncConsent: '实验前，每名被试都签署了书面知情同意；研究经秦皇岛市第一医院伦理委员会审查批准。本站只用了该数据集 24 名被试中的 4 名，并且只发布合并后的计数。',
    ncPaper: '数据论文 ↗', ncData: 'figshare 数据 ↗', ncSmall: '为什么四名被试会限制可发布的内容（英文）',
  },
}[locale];
const card = topicCards[locale]['when-not-to-act'];
const basis = idle.reviewBasis;
---
<TopicLayout
  locale={locale}
  title={card.title}
  description={copy.description}
  path="/topics/when-not-to-act/"
  eyebrow={copy.eyebrow}
  dek={copy.dek}
  activeSlug="when-not-to-act"
  dataFiles={['/data/experiments.json']}
  documentTitle={copy.documentTitle}
  answer={copy.answer}
>
  <section class="topic-section" aria-labelledby="abstain-finding">
    <div class="finding">
      <div class="finding-number"><strong>{quiet.falseActs} / {idleN}</strong><span>{copy.findingLabel}</span></div>
      <div class="finding-copy"><h3 id="abstain-finding">{copy.findingH3}</h3><p>{copy.findingP}</p></div>
    </div>
    <div class="topic-heading"><div><p class="eyebrow">{copy.tableEyebrow}</p><h2>{copy.tableH2}</h2></div><p>{copy.tableLede}</p></div>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.tableRegion}>
      <table>
        <caption>{copy.caption}</caption>
        <thead><tr><th scope="col">{copy.colMethod}</th><th scope="col">{copy.colMode}</th><th scope="col">{copy.colCmd}</th><th scope="col">{copy.colFalse}</th><th scope="col">{copy.colAbstain}</th></tr></thead>
        <tbody>{rows.map(r => <tr><th scope="row">{r.name}</th><td>{modeLabel[r.mode] ?? r.mode}</td><td><span class="metric">{r.commands} / {cmdN}</span><span class="interval">{pct(r.y / 100)}</span><ScoreBar value={r.y / 100} label={copy.cmdLabel(pct(r.y / 100))} tone="rust" /></td><td><span class="metric">{r.falseActs} / {idleN}</span><span class="interval">{pct(r.x / 100)}</span></td><td><span class="metric">{r.abstain}</span><span class="interval">{copy.ofPeople}</span></td></tr>)}</tbody>
      </table>
    </div>
  </section>

  {nc && (
  <section class="topic-section" id="non-control" aria-labelledby="nc-heading">
    <div class="topic-heading"><div><p class="eyebrow">{copy.ncEyebrow}</p><h2 id="nc-heading">{copy.ncH2}</h2></div><p>{copy.ncLede}</p></div>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.ncRegion}>
      <table>
        <caption>{copy.ncControlH3} · {copy.ncControlNote}</caption>
        <thead><tr><th scope="col">{copy.colState}</th><th scope="col">{copy.colWindows}</th></tr></thead>
        <tbody>
          <tr><th scope="row">{copy.ncRows[0]}</th><td><span class="metric">{frac(nc.control_windows.frequency_recognised, nc.control_windows.tested)}</span><span class="interval">{pct(nc.control_windows.frequency_recognised / nc.control_windows.tested)}</span></td></tr>
          <tr><th scope="row">{copy.ncRows[1]}</th><td><span class="metric">{frac(nc.control_windows.accepted, nc.control_windows.tested)}</span><span class="interval">{pct(nc.control_windows.accepted / nc.control_windows.tested)}</span></td></tr>
          <tr><th scope="row">{copy.ncRows[2]}</th><td><span class="metric">{frac(nc.control_windows.accepted_and_correct, nc.control_windows.tested)}</span><span class="interval">{pct(nc.control_windows.accepted_and_correct / nc.control_windows.tested)}</span></td></tr>
          <tr><th scope="row">{copy.ncRows[3]}</th><td><span class="metric">{frac(nc.control_windows.accepted_and_correct, nc.control_windows.accepted)}</span><span class="interval">{pct(nc.control_windows.accepted_and_correct / nc.control_windows.accepted)}</span></td></tr>
        </tbody>
      </table>
    </div>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.ncRegion}>
      <table>
        <caption>{copy.ncNonH3}</caption>
        <thead><tr><th scope="col">{copy.colState}</th><th scope="col">{copy.colAccepted}</th></tr></thead>
        <tbody>{nc.false_acceptance.map(f => <tr><th scope="row">{copy.ncCondition[f.condition] ?? f.condition}</th><td><span class="metric">{frac(f.accepted, f.tested)}</span><span class="interval">{pct(f.accepted / f.tested)}</span></td></tr>)}</tbody>
      </table>
    </div>
    <p class="protocol-note">{copy.ncLimits}</p>
    <p class="citation-note"><a href="/data-use/#small-cohorts">{copy.ncSmall}</a></p>
    <div class="citation-list"><article><h3 lang="en">{nc.rights.name}</h3><p lang="en">{nc.rights.attribution}</p><p>{copy.ncConsent}</p><p><a href={nc.rights.reviewBasis[0]} target="_blank" rel="noreferrer">{copy.ncPaper}</a> · <a href={nc.rights.reviewBasis[1]} target="_blank" rel="noreferrer">{copy.ncData}</a> · <a href={nc.rights.licenseUrl} target="_blank" rel="noreferrer">{nc.rights.license}</a></p></article></div>
    <p class="citation-note">{tc.dataSource} <a href="/data/context-update.json" download>{tc.reviewedAggregate}</a> · {tc.schema} {context.schema_version} · {tc.generated} {context.generated_at.slice(0,10)}{tc.period}</p>
  </section>
  )}

  <section class="topic-section" id="methods-and-limits" aria-labelledby="abstain-limits">
    <div class="topic-heading"><div><p class="eyebrow">{tc.methodsEyebrow}</p><h2 id="abstain-limits">{copy.limitsH2}</h2></div><p>{copy.limitsLede}</p></div>
    <div class="method-grid-wide">{copy.limits.map(([h, p]) => <article><h3>{h}</h3><p>{p}</p></article>)}</div>
    <p class="citation-note"><a href="/data-use/#small-cohorts">{copy.smallCohorts}</a></p>
    <div class="citation-list"><article><h3 lang="en">{idle.dataset} · {idle.subtitle}</h3><p lang="en">{idle.attribution}</p><p>{copy.consent}</p><p><a href={basis[0]} target="_blank" rel="noreferrer">{copy.datasetLink}</a> · <a href={basis[2]} target="_blank" rel="noreferrer">{copy.studyLink}</a> · <a href={idle.licenseUrl} target="_blank" rel="noreferrer">{idle.license}</a></p></article></div>
    <p class="citation-note">{tc.dataSource} <a href="/data/experiments.json" download>{tc.reviewedAggregate}</a> · <a href="/data/idle-results.csv" download>{copy.csv}</a> · {data.releaseId}{tc.period}</p>
  </section>

  <section class="topic-section roadmap" id="decision-research" aria-labelledby="decision-heading" data-status={decisionRoadmap.status} data-run-status={decisionRoadmap.runStatus}>
    <div class="topic-heading"><div><p class="eyebrow">{plan.eyebrow}</p><h2 id="decision-heading">{plan.h2}</h2></div><p>{plan.lede}</p></div>
    <p class="protocol-note research-status">{plan.statusLine}</p>
    <p class="roadmap-p research-scope">{plan.scope}</p>
    <ol class="route-list">{plan.routes.map(r => <li><p class="eyebrow">{r.tag} · {plan.routeStatus}</p><h3>{r.title}</h3><p>{r.body}</p><p class="route-boundary">{r.boundary}</p></li>)}</ol>
    <h3 class="roadmap-sub">{plan.boundaryH3}</h3>
    <p class="roadmap-p">{plan.boundary}</p>
    <p class="roadmap-p">{plan.inputsNote}</p>
    <h3 class="roadmap-sub">{plan.litH3}</h3>
    <p class="roadmap-p">{plan.litLede}</p>
    <div class="literature-grid">{plan.literature.map(([id, shows, limit]) => <article><h4 lang="en"><a href={decisionSources[id].url} target="_blank" rel="noreferrer">{decisionSources[id].cite} ↗</a></h4><p><strong>{plan.shows}</strong> {shows}</p><p><strong>{plan.limit}</strong> {limit}</p></article>)}</div>
    <h3 class="roadmap-sub">{plan.relatedH3}</h3>
    <p class="roadmap-p">{plan.related.map(([href, label], i) => <>{i > 0 && ' · '}<a href={hrefFor(href, locale)}>{label}</a></>)}</p>
  </section>
</TopicLayout>
