---
import rawData from '../../../data/deployment-topics.json';
import TopicLayout from '../../../components/TopicLayout.astro';
import ScoreBar from '../../../components/ScoreBar.astro';
import IntervalPlot from '../../../components/IntervalPlot.astro';
import { type DeploymentData, intervalPct, modelLabel, pct, pp, intervalPp } from '../../../data/topics';
import { hrefFor, localeOf, localeParams, topicCards, topicChrome } from '../../../data/i18n';

export const getStaticPaths = localeParams;
const locale = localeOf(Astro.params.lang);
const tc = topicChrome[locale];

const data = rawData as unknown as DeploymentData;
const ridgeRows = data.rows.filter(row => row.track === 'wearable-calibration');
const trcaRows = data.rows.filter(row => row.track === 'wearable-etrca-calibration');
const trcaContrasts = data.paired_contrasts.filter(row => row.track === 'wearable-etrca-calibration');
const citation = data.dataset_citations.find(item => item.id === 'zhu2021-wearable102-author-snapshot-20260920');
const targetRidge = (sensor: string, budget: number) => ridgeRows.find(row => row.training_regime === 'target-only' && row.target_sensor === sensor && row.labeled_target_trials === budget)!;
const sourceRidge = (source: string, target: string) => ridgeRows.find(row => row.training_regime === 'source-only' && row.source_sensor === source && row.target_sensor === target)!;
const methodRow = (model: string, sensor: string, budget: number) => trcaRows.find(row => row.model === model && row.target_sensor === sensor && row.labeled_target_trials === budget)!;
const budgets = [12,24,48];
const sensors = ['wet','dry'];
const wetImprovement = trcaContrasts.find(row => row.comparison === 'etrca48-minus-etrca24-wet')!;
const dryImprovement = trcaContrasts.find(row => row.comparison === 'etrca48-minus-etrca24-dry')!;
const ipp = (i: [number, number]) => intervalPp(i, 1, locale);
// Figures the short answer and the key figure name. All from the reviewed export.
const people = wetImprovement.participants;
const etrcaWet24 = pct(methodRow('ensemble-trca','wet',24).value), etrcaWet48 = pct(methodRow('ensemble-trca','wet',48).value);
const etrcaDry24 = pct(methodRow('ensemble-trca','dry',24).value), etrcaDry48 = pct(methodRow('ensemble-trca','dry',48).value);
const ridgeWet48 = pct(targetRidge('wet',48).value), ridgeDry48 = pct(targetRidge('dry',48).value);
const ccaWet = pct(methodRow('cca','wet',0).value), ccaDry = pct(methodRow('cca','dry',0).value);
const chance = 1 / 12;
// The LaBraM adaptation results (reviewed 2026-10-01) and the next-day status
// sat here until 2026-10-02. They are not calibration — the model adapts on
// other people and uses no label from the test person — so they have their own
// topic now, model-adaptation. The two anchors stay, as short notes pointing
// there, so links to #adaptation and #next-day keep working.
const moved = topicCards[locale]['model-adaptation'].question;

const copy = {
  en: {
    description: `It depends on the method. For ${people} people on a 12-target wearable SSVEP task, going from 24 to 48 labeled trials lifted single-band eTRCA from ${etrcaWet24} to ${etrcaWet48} on wet recordings but only from ${etrcaDry24} to ${etrcaDry48} on dry; training-free CCA scored higher. Trial counts are not minutes.`,
    answer: `It depends on the method: on a 12-target wearable SSVEP task, with the same [[${people}]] people and the same future test blocks, going from 24 to 48 labeled target trials lifted single-band eTRCA from [[${etrcaWet24}]] to [[${etrcaWet48}]] balanced accuracy on wet recordings, but only from [[${etrcaDry24}]] to [[${etrcaDry48}]] on dry ones. Target-only spectral ridge reached just [[${ridgeWet48}]] (wet) and [[${ridgeDry48}]] (dry) at 48 trials, and no calibrated eTRCA point beat the training-free CCA reference, which uses no labels ([[${ccaWet}]] wet, [[${ccaDry}]] dry); that eTRCA uses one fixed band, not the original method's filter bank, so it is not TRCA at its best. Trial counts are not minutes: the export records labeled trials per person and does not convert them into a setup-time claim.`,
    plotCaption: `Labeled-trial budgets for the same ${people} people, tested on the same future blocks.`,
    plotLegend: 'Participant-mean balanced accuracy on 12-target, two-second SSVEP. Dot: the estimate; line: participant bootstrap 95% interval; dashed line: chance, 1 in 12. Rust rows are wet recordings, dark rows dry. CCA uses no labels; the source-only arm is a different mechanism and is not plotted.',
    plotNote: (s: string, reference: boolean) => `${s} recording · ${reference ? 'training-free reference' : 'target-only'}`,
    eyebrow: 'Calibration budget · common future test blocks',
    dek: 'More labeled trials do not have one universal value. On this 12-target wearable protocol, target-only spectral ridge improves gradually but remains low; single-band ensemble TRCA benefits sharply on wet recordings from 24 to 48 labels and only modestly on dry recordings.',
    sensor: { wet: 'wet', dry: 'dry' } as Record<string, string>,
    ridgeEyebrow: 'Target-only spectral ridge',
    ridgeH2: 'Twelve, 24 and 48 labeled trials',
    ridgeLede: "Each target-person model uses only that person's labeled calibration recordings. All conditions are evaluated on the same future blocks 5–10, across 102 people and 7,344 test trials.",
    labels: (n: number) => `${n} labels`,
    baLabel: (v: string) => `${v} balanced accuracy`,
    participantMean: 'Participant-mean balanced accuracy',
    trialsStrong: 'Trial counts are not minutes.',
    trialsRest: ' The export records 12, 24 or 48 labeled trials per person. It does not convert those trials into a setup-time claim.',
    zeroEyebrow: 'A separate arm',
    zeroH2: 'Zero target labels is source-only transfer',
    zeroLede: 'The zero-budget spectral-ridge rows use a model trained on other participants from one source sensor. They are not the starting point of an incremental target-person update curve.',
    zeroRegion: 'Source-only spectral ridge transfer results, scrolls horizontally',
    zeroCaption: 'Participant-mean balanced accuracy on common future test blocks 5–10 · 0 labeled target trials.',
    colSource: 'Training source', testWet: 'Test on wet', testDry: 'Test on dry',
    sourceRow: (s: string) => `${s} source`,
    otherOnly: 'other participants only',
    trcaEyebrow: 'Method matters',
    trcaH2: 'Single-band eTRCA responds differently',
    trcaLede: 'The target-only eTRCA arm uses 24 or 48 calibration trials and the same future test blocks. CCA at zero labels is an analytic reference, not an unfitted eTRCA point.',
    trcaFindingLabel: 'Wet eTRCA: 48 labels minus 24 labels',
    trcaFindingH3: 'A larger budget helped wet recordings much more',
    trcaFindingP: `The paired participant interval is ${ipp(wetImprovement.paired_participant_bootstrap_95)}. Dry eTRCA improved by ${pp(dryImprovement.difference, 1)}, interval ${ipp(dryImprovement.paired_participant_bootstrap_95)}. Neither calibrated point exceeds the analytic CCA reference on the same test blocks.`,
    trcaRegion: 'CCA and ensemble TRCA calibration results, scrolls horizontally',
    trcaCaption: 'Participant-mean balanced accuracy · native 8 channels · 2 s · 12 targets.',
    colMethodBudget: 'Method and labeled target trials', colWet: 'Wet', colDry: 'Dry',
    ccaRow: 'CCA · 0 labels', ccaNote: 'analytic target-recording reference',
    targetOnly: 'target-only adaptation',
    limitsH2: 'What the budget curves do and do not mean',
    limitsLede: 'All results are tied to a frozen protocol. They describe labeled-trial budgets for these methods, sensors and fixed test blocks.',
    limits: [
      ['Different zero-label mechanisms', "Spectral ridge at budget zero is source-only supervised transfer. CCA at budget zero is an analytic target-recording reference. Neither should be connected to target-only points as one model's learning curve."],
      ['Target-only means target-only', "The 12/24/48 ridge and 24/48 eTRCA conditions fit only the target person's calibration recordings, then test on blocks 5–10."],
      ['Prespecified single band', 'eTRCA uses the fixed 6–80 Hz prepared band, not the filter bank of the original method (five sub-bands in the paper and in the reference code’s tutorials), so low scores do not establish an optimized TRCA ceiling.'],
      ['Descriptive intervals', 'Bootstrap intervals summarize participants under this protocol. They do not add retraining uncertainty or establish general calibration requirements for another headset.'],
    ],
    citationNote: (license: string) => `Official Tsinghua author mirror snapshot acquired 2026-09-20 · ${license}. Aggregate results only.`,
    movedAdH2: 'LaBraM adaptation has its own page',
    movedAd: ['The LaBraM results on new people, same task, zero labels from the test person — head only, last block or LoRA — moved to their own page: ', ' They are not calibration: the model adapts on other people and uses no label from the person it is tested on.'],
    // Self-contained: a link to #next-day lands on this heading, not on the one above it.
    movedNextH2: 'The next-day experiment has moved to the model-adaptation page',
    movedNext: ['The next-day status — run, independently replayed and held, with no figure published — is on the same page: ', ''],
  },
  zh: {
    description: `取决于方法。同样 ${people} 名被试的 12 目标可穿戴 SSVEP 任务上，校准试次从 24 增加到 48，单频带 eTRCA 在湿电极上从 ${etrcaWet24} 升到 ${etrcaWet48}，在干电极上只从 ${etrcaDry24} 升到 ${etrcaDry48}；免训练的 CCA 参考更高。试次数不等于分钟数。`,
    answer: `取决于方法：在 12 目标的可穿戴 SSVEP 任务上，同样 [[${people}]] 名被试、相同的后续测试组块，目标被试校准试次从 24 增加到 48 时，单频带 eTRCA 在湿电极记录上的平衡准确率从 [[${etrcaWet24}]] 升到 [[${etrcaWet48}]]，在干电极记录上只从 [[${etrcaDry24}]] 升到 [[${etrcaDry48}]]。仅用目标被试数据的 spectral ridge 在 48 个校准试次时也只有 [[${ridgeWet48}]]（湿电极）和 [[${ridgeDry48}]]（干电极）；校准后的 eTRCA 没有一个超过不使用校准试次的免训练 CCA 参考（湿电极 [[${ccaWet}]]，干电极 [[${ccaDry}]]）；这里的 eTRCA 只用一个固定频带，而不是原方法的滤波器组，所以并不代表 TRCA 的最好水平。试次数不等于分钟数：导出数据记录的是每名被试的校准试次数，并不据此推算校准需要多长时间。`,
    plotCaption: `同样 ${people} 名被试的各档校准试次，均在相同的后续组块上测试。`,
    plotLegend: '12 目标、两秒 SSVEP 上的被试平均平衡准确率。点为估计值，横线为被试 bootstrap 95% 区间，虚线为随机水平（12 选 1）。锈色行为湿电极记录，深色行为干电极记录。CCA 不使用校准试次；仅源域迁移是另一种机制，不在图中。',
    plotNote: (s: string, reference: boolean) => `${s}记录 · ${reference ? '免训练参考' : '仅用目标被试数据'}`,
    eyebrow: '校准预算 · 共同的后续测试组块',
    dek: '增加校准试次的价值并不是一个固定值。在这个 12 目标可穿戴协议上，仅用目标被试数据的 spectral ridge（频谱特征岭回归）逐步提升，但始终偏低；单频带集成 TRCA 在湿电极上从 24 增加到 48 个校准试次时提升明显，在干电极上只有小幅提升。',
    sensor: { wet: '湿电极', dry: '干电极' } as Record<string, string>,
    ridgeEyebrow: '仅用目标被试数据的 spectral ridge',
    ridgeH2: '12、24 与 48 个校准试次',
    ridgeLede: '每名目标被试的模型只用该被试自己的有标签校准记录训练。所有条件都在相同的后续组块（第 5–10 组块）上评测，共 102 名被试、7,344 个测试试次。',
    labels: (n: number) => `${n} 个校准试次`,
    baLabel: (v: string) => `平衡准确率 ${v}`,
    participantMean: '被试平均平衡准确率',
    trialsStrong: '试次数不等于分钟数。',
    trialsRest: '导出数据记录的是每名被试 12、24 或 48 个校准试次，并不据此推算校准需要多长时间。',
    zeroEyebrow: '单独的对照组',
    zeroH2: '零个校准试次，即仅源域迁移',
    zeroLede: '校准预算为零的 spectral ridge 各行，使用的是在其他被试、单一源传感器上训练好的模型。它们不是目标被试逐步增加校准数据的学习曲线起点。',
    zeroRegion: '仅源域 spectral ridge 迁移结果，可横向滚动',
    zeroCaption: '共同的后续测试组块（第 5–10 组块）上的被试平均平衡准确率 · 0 个目标被试校准试次。',
    colSource: '训练来源', testWet: '在湿电极上测试', testDry: '在干电极上测试',
    sourceRow: (s: string) => `以${s}为源域`,
    otherOnly: '仅使用其他被试',
    trcaEyebrow: '方法很关键',
    trcaH2: '单频带 eTRCA 的反应不同',
    trcaLede: '仅用目标被试数据的 eTRCA 组使用 24 或 48 个校准试次，并在相同的后续测试组块上评测。零校准试次的 CCA 是免训练参考方法，不是未经拟合的 eTRCA。',
    trcaFindingLabel: '湿电极 eTRCA：48 减 24 个校准试次（pp 为百分点）',
    trcaFindingH3: '增加校准预算对湿电极帮助大得多',
    trcaFindingP: `被试配对区间为 ${ipp(wetImprovement.paired_participant_bootstrap_95)}。干电极 eTRCA 提升了 ${pp(dryImprovement.difference, 1)}，区间 ${ipp(dryImprovement.paired_participant_bootstrap_95)}。两个校准后的结果都没有超过同一测试组块上的免训练 CCA 参考。`,
    trcaRegion: 'CCA 与集成 TRCA 校准结果，可横向滚动',
    trcaCaption: '被试平均平衡准确率 · 原生 8 通道 · 2 秒 · 12 个目标。',
    colMethodBudget: '方法与目标被试校准试次', colWet: '湿电极', colDry: '干电极',
    ccaRow: 'CCA · 0 个校准试次', ccaNote: '直接作用于目标记录的免训练参考',
    targetOnly: '仅用目标被试数据适配',
    limitsH2: '校准预算曲线说明什么，不说明什么',
    limitsLede: '所有结果都绑定在一个预先冻结的协议上，描述的是这些方法、传感器和固定测试组块下的校准试次预算。',
    limits: [
      ['零校准试次背后的机制不同', '预算为零的 spectral ridge 是仅源域的监督迁移；预算为零的 CCA 是直接作用于目标记录的免训练参考。两者都不应与仅用目标被试数据的结果连成同一个模型的学习曲线。'],
      ['「仅目标被试」名副其实', '12/24/48 的 spectral ridge 与 24/48 的 eTRCA 只拟合目标被试自己的校准记录，然后在第 5–10 组块上测试。'],
      ['预先指定的单一频带', 'eTRCA 使用固定的 6–80 Hz 预处理频带，而不是原方法的滤波器组（原论文与参考代码的教程都用 5 个子带），所以较低的分数并不代表 TRCA 经过优化后的上限。'],
      ['描述性区间', 'bootstrap 区间概括的是本协议下的被试间分布，不包含重新训练带来的不确定性，也不能推出其他头戴设备的通用校准需求。'],
    ],
    citationNote: (license: string) => `2026-09-20 获取的清华作者官方镜像快照 · ${license}。仅发布聚合结果。`,
    movedAdH2: 'LaBraM 适配已有单独的页面',
    movedAd: ['LaBraM 的适配结果（新被试、同一任务、不使用测试被试的任何标签）——只训分类头、最后一个 Transformer 块还是 LoRA——已移到单独的页面「', '」。它们不是校准：模型在其他被试上适配，不使用被测试者本人的任何标签。'],
    movedNextH2: '次日实验已移到模型适配页面',
    movedNext: ['次日实验的状态——已运行、通过独立复核、暂缓发布、不公布任何数字——也在同一页面「', '」。'],
  },
}[locale];
const card = topicCards[locale]['calibration-budget'];
---
<TopicLayout
  locale={locale}
  title={card.title}
  description={copy.description}
  path="/topics/calibration-budget/"
  eyebrow={copy.eyebrow}
  dek={copy.dek}
  activeSlug="calibration-budget"
  answer={copy.answer}
>
  <IntervalPlot
    caption={copy.plotCaption}
    legend={copy.plotLegend}
    domain={[0, 1]}
    ticks={['0%', '25%', '50%', '75%', '100%']}
    reference={chance}
    rows={sensors.flatMap(sensor => [
      { row: methodRow('cca', sensor, 0), label: copy.ccaRow, reference: true },
      ...budgets.map(budget => ({ row: targetRidge(sensor, budget), label: `${modelLabel('spectral-ridge', locale)} · ${copy.labels(budget)}`, reference: false })),
      ...[24, 48].map(budget => ({ row: methodRow('ensemble-trca', sensor, budget), label: `${modelLabel('ensemble-trca', locale)} · ${copy.labels(budget)}`, reference: false })),
    ].map(({ row, label, reference }) => ({ label, note: copy.plotNote(copy.sensor[sensor], reference), tone: sensor === 'wet' ? 'rust' as const : 'ink' as const, value: row.value, interval: row.confidence_interval_95, text: `${pct(row.value)} (${intervalPct(row.confidence_interval_95)})` })))}
  />
  <section class="topic-section" aria-labelledby="ridge-heading">
    <div class="topic-heading"><div><p class="eyebrow">{copy.ridgeEyebrow}</p><h2 id="ridge-heading">{copy.ridgeH2}</h2></div><p>{copy.ridgeLede}</p></div>
    <div class="evidence-grid">{sensors.flatMap(sensor => budgets.map(budget => {
      const row = targetRidge(sensor,budget);
      return <article class="evidence-card"><p class="eyebrow">{copy.sensor[sensor]} · {copy.labels(budget)}</p><div class="reading">{pct(row.value)}</div><ScoreBar value={row.value} max={0.85} label={copy.baLabel(pct(row.value))} tone={sensor === 'wet' ? 'rust' : 'ink'} /><p>{copy.participantMean}</p><small>{tc.interval95} {intervalPct(row.confidence_interval_95)}</small></article>;
    }))}</div>
    <p class="protocol-note"><strong>{copy.trialsStrong}</strong>{copy.trialsRest}</p>
  </section>

  <section class="topic-section" aria-labelledby="zero-heading">
    <div class="topic-heading"><div><p class="eyebrow">{copy.zeroEyebrow}</p><h2 id="zero-heading">{copy.zeroH2}</h2></div><p>{copy.zeroLede}</p></div>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.zeroRegion}>
      <table><caption>{copy.zeroCaption}</caption><thead><tr><th scope="col">{copy.colSource}</th><th scope="col">{copy.testWet}</th><th scope="col">{copy.testDry}</th></tr></thead><tbody>{sensors.map(source => <tr><th scope="row">{copy.sourceRow(copy.sensor[source])}<small>{copy.otherOnly}</small></th>{sensors.map(target => {
        const row = sourceRidge(source,target);
        return <td><span class="metric">{pct(row.value)}</span><span class="interval">{intervalPct(row.confidence_interval_95)}</span></td>;
      })}</tr>)}</tbody></table>
    </div>
  </section>

  <section class="topic-section" aria-labelledby="trca-heading">
    <div class="topic-heading"><div><p class="eyebrow">{copy.trcaEyebrow}</p><h2 id="trca-heading">{copy.trcaH2}</h2></div><p>{copy.trcaLede}</p></div>
    <div class="finding">
      <div class="finding-number"><strong>{pp(wetImprovement.difference, 1)}</strong><span>{copy.trcaFindingLabel}</span></div>
      <div class="finding-copy"><h3>{copy.trcaFindingH3}</h3><p>{copy.trcaFindingP}</p></div>
    </div>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.trcaRegion}>
      <table><caption>{copy.trcaCaption}</caption><thead><tr><th scope="col">{copy.colMethodBudget}</th><th scope="col">{copy.colWet}</th><th scope="col">{copy.colDry}</th></tr></thead><tbody>
        <tr><th scope="row">{copy.ccaRow}<small>{copy.ccaNote}</small></th>{sensors.map(sensor => { const row=methodRow('cca',sensor,0); return <td><span class="metric">{pct(row.value)}</span><span class="interval">{intervalPct(row.confidence_interval_95)}</span></td>; })}</tr>
        {[24,48].map(budget => <tr><th scope="row">{modelLabel('ensemble-trca', locale)} · {copy.labels(budget)}<small>{copy.targetOnly}</small></th>{sensors.map(sensor => { const row=methodRow('ensemble-trca',sensor,budget); return <td><span class="metric">{pct(row.value)}</span><span class="interval">{intervalPct(row.confidence_interval_95)}</span></td>; })}</tr>)}
      </tbody></table>
    </div>
  </section>

  <section class="topic-section topic-moved" id="adaptation" aria-labelledby="adaptation-heading">
    <h2 id="adaptation-heading">{copy.movedAdH2}</h2>
    <p class="roadmap-p">{copy.movedAd[0]}<a href={hrefFor('/topics/model-adaptation/#adaptation', locale)}>{moved}</a>{locale === 'zh' ? '' : ' '}{copy.movedAd[1]}</p>
  </section>

  <section class="topic-section topic-moved" id="next-day" aria-labelledby="next-day-heading">
    <h2 id="next-day-heading">{copy.movedNextH2}</h2>
    <p class="roadmap-p">{copy.movedNext[0]}<a href={hrefFor('/topics/model-adaptation/#next-day', locale)}>{moved}</a>{copy.movedNext[1]}</p>
  </section>

  <section class="topic-section" id="methods-and-limits" aria-labelledby="limits-heading">
    <div class="topic-heading"><div><p class="eyebrow">{tc.methodsEyebrow}</p><h2 id="limits-heading">{copy.limitsH2}</h2></div><p>{copy.limitsLede}</p></div>
    <div class="method-grid-wide">{copy.limits.map(([h, p]) => <article><h3>{h}</h3><p>{p}</p></article>)}</div>
    {citation && <div class="citation-list"><article><h3 lang="en">{citation.identity.title}</h3><p lang="en">{citation.identity.canonical_dataset_citation}</p><p lang="en">{citation.identity.paper_citation}</p><p>{copy.citationNote(citation.identity.license ?? '')}</p><p><a href={citation.primary_sources[0]} target="_blank" rel="noreferrer">{tc.datasetRecord}</a> · <a href={citation.primary_sources[1]} target="_blank" rel="noreferrer">{tc.sensorsPaper}</a></p></article></div>}
    <p class="citation-note">{tc.dataSource} <a href="/data/deployment-topics.json" download>{tc.reviewedAggregate}</a> · {tc.schema} {data.schema_version} · {tc.generated} {data.generated_at.slice(0,10)}{tc.period}</p>
  </section>
</TopicLayout>
