---
import rawData from '../../../data/deployment-topics.json';
import TopicLayout from '../../../components/TopicLayout.astro';
import ScoreBar from '../../../components/ScoreBar.astro';
import IntervalPlot from '../../../components/IntervalPlot.astro';
import { type DeploymentData, intervalPct, modelLabel, pct, pp, intervalPp } from '../../../data/topics';
import { localeOf, localeParams, topicCards, topicChrome } from '../../../data/i18n';
import evidence from '../../../data/evidence-update.json';
import adaptation from '../../../data/adaptation-update.json';
import mvp from '../../../data/mvp.json';

export const getStaticPaths = localeParams;
const locale = localeOf(Astro.params.lang);
const tc = topicChrome[locale];

const data = rawData as unknown as DeploymentData;
const ridgeRows = data.rows.filter(row => row.track === 'wearable-calibration');
const trcaRows = data.rows.filter(row => row.track === 'wearable-etrca-calibration');
const trcaContrasts = data.paired_contrasts.filter(row => row.track === 'wearable-etrca-calibration');
const citation = data.dataset_citations.find(item => item.id === 'zhu2021-wearable102-author-snapshot-20260920');
const targetRidge = (sensor: string, budget: number) => ridgeRows.find(row => row.training_regime === 'target-only' && row.target_sensor === sensor && row.labeled_target_trials === budget)!;
const sourceRidge = (source: string, target: string) => ridgeRows.find(row => row.training_regime === 'source-only' && row.source_sensor === source && row.target_sensor === target)!;
const methodRow = (model: string, sensor: string, budget: number) => trcaRows.find(row => row.model === model && row.target_sensor === sensor && row.labeled_target_trials === budget)!;
const budgets = [12,24,48];
const sensors = ['wet','dry'];
const wetImprovement = trcaContrasts.find(row => row.comparison === 'etrca48-minus-etrca24-wet')!;
const dryImprovement = trcaContrasts.find(row => row.comparison === 'etrca48-minus-etrca24-dry')!;
const ipp = (i: [number, number]) => intervalPp(i, 1, locale);
// Figures the short answer and the key figure name. All from the reviewed export.
const people = wetImprovement.participants;
const etrcaWet24 = pct(methodRow('ensemble-trca','wet',24).value), etrcaWet48 = pct(methodRow('ensemble-trca','wet',48).value);
const etrcaDry24 = pct(methodRow('ensemble-trca','dry',24).value), etrcaDry48 = pct(methodRow('ensemble-trca','dry',48).value);
const ridgeWet48 = pct(targetRidge('wet',48).value), ridgeDry48 = pct(targetRidge('dry',48).value);
const ccaWet = pct(methodRow('cca','wet',0).value), ccaDry = pct(methodRow('cca','dry',0).value);
const chance = 1 / 12;
// Adaptation results, reviewed 2026-10-01. They replace the roadmap that stood
// here from 2026-09-22; evidence-update.json still records that roadmap as
// 'planned', which was true when it was released, so only its engineering
// check is read from it now.
const eng = evidence.roadmap.peft.engineering_check;
const ad = adaptation.results['eegmat-labram-adaptation'];
const adPeople = ad.cohort.people;
type Metric = 'balanced_accuracy' | 'macro_f1';
const contrast = (metric: Metric, id: string) => ad.paired_contrasts[metric].find(c => c.id === id)!;
const loraHead = contrast('balanced_accuracy', 'lora-r4_minus_frozen');
const blockHead = contrast('balanced_accuracy', 'last-block_minus_frozen');
const loraBlock = contrast('balanced_accuracy', 'lora-r4_minus_last-block');
const loraArm = ad.arms.find(a => a.id === 'lora-r4')!;
// Printed for scale beside the head-only arm: the matrix's frozen LaBraM readout
// on the same people and folds. A different head, so not a paired comparison;
// the export proves the shared folds and carries no number, so the figure is
// read from the snapshot that published it.
const matrixTrack = mvp.tracks.find(t => t.id === ad.matrix_reference.track_id)!;
const matrixRow = matrixTrack.rows.find(r => r.name === ad.matrix_reference.model && r.mode === ad.matrix_reference.training_mode)!;
const matrixBa = `${matrixRow.y.toFixed(1)}%`;
const nextDay = adaptation.status_only[0];
const nextDaySource = nextDay.name.split(' · ')[0];
const secs = (v: number) => `${v.toFixed(1)} s`;
const seedMeans = (a: typeof loraArm) => a.balanced_accuracy.per_seed_means.map(x => pct(x.mean)).join(' · ');
const kib = Math.round(eng.adapter_float32_bytes / 1024);
const n = (v: number) => v.toLocaleString('en-US');
const share = `${(eng.adapter_fraction * 100).toFixed(2)}%`;

const copy = {
  en: {
    description: `It depends on the method. For ${people} people on a 12-target wearable SSVEP task, going from 24 to 48 labeled trials lifted single-band eTRCA from ${etrcaWet24} to ${etrcaWet48} on wet recordings but only from ${etrcaDry24} to ${etrcaDry48} on dry; training-free CCA scored higher. Trial counts are not minutes.`,
    answer: `It depends on the method: on a 12-target wearable SSVEP task, with the same [[${people}]] people and the same future test blocks, going from 24 to 48 labeled target trials lifted single-band eTRCA from [[${etrcaWet24}]] to [[${etrcaWet48}]] balanced accuracy on wet recordings, but only from [[${etrcaDry24}]] to [[${etrcaDry48}]] on dry ones. Target-only spectral ridge reached just [[${ridgeWet48}]] (wet) and [[${ridgeDry48}]] (dry) at 48 trials, and no calibrated eTRCA point beat the training-free CCA reference, which uses no labels ([[${ccaWet}]] wet, [[${ccaDry}]] dry). Trial counts are not minutes: the export records labeled trials per person and does not convert them into a setup-time claim.`,
    plotCaption: `Labeled-trial budgets for the same ${people} people, tested on the same future blocks.`,
    plotLegend: 'Participant-mean balanced accuracy on 12-target, two-second SSVEP. Dot: the estimate; line: participant bootstrap 95% interval; dashed line: chance, 1 in 12. Rust rows are wet recordings, dark rows dry. CCA uses no labels; the source-only arm is a different mechanism and is not plotted.',
    plotNote: (s: string, reference: boolean) => `${s} recording · ${reference ? 'training-free reference' : 'target-only'}`,
    eyebrow: 'Adaptation budget · common future test blocks',
    dek: 'More labeled trials do not have one universal value. On this 12-target wearable protocol, target-only spectral ridge improves gradually but remains low; single-band ensemble TRCA benefits sharply on wet recordings from 24 to 48 labels and only modestly on dry recordings.',
    sensor: { wet: 'wet', dry: 'dry' } as Record<string, string>,
    ridgeEyebrow: 'Target-only spectral ridge',
    ridgeH2: 'Twelve, 24 and 48 labeled trials',
    ridgeLede: "Each target-person model uses only that person's labeled calibration recordings. All conditions are evaluated on the same future blocks 5–10, across 102 people and 7,344 test trials.",
    labels: (n: number) => `${n} labels`,
    baLabel: (v: string) => `${v} balanced accuracy`,
    participantMean: 'Participant-mean balanced accuracy',
    trialsStrong: 'Trial counts are not minutes.',
    trialsRest: ' The export records 12, 24 or 48 labeled trials per person. It does not convert those trials into a setup-time claim.',
    zeroEyebrow: 'A separate arm',
    zeroH2: 'Zero target labels is source-only transfer',
    zeroLede: 'The zero-budget spectral-ridge rows use a model trained on other participants from one source sensor. They are not the starting point of an incremental target-person update curve.',
    zeroRegion: 'Source-only spectral ridge transfer results, scrolls horizontally',
    zeroCaption: 'Participant-mean balanced accuracy on common future test blocks 5–10 · 0 labeled target trials.',
    colSource: 'Training source', testWet: 'Test on wet', testDry: 'Test on dry',
    sourceRow: (s: string) => `${s} source`,
    otherOnly: 'other participants only',
    trcaEyebrow: 'Method matters',
    trcaH2: 'Single-band eTRCA responds differently',
    trcaLede: 'The target-only eTRCA arm uses 24 or 48 calibration trials and the same future test blocks. CCA at zero labels is an analytic reference, not an unfitted eTRCA point.',
    trcaFindingLabel: 'Wet eTRCA: 48 labels minus 24 labels',
    trcaFindingH3: 'A larger budget helped wet recordings much more',
    trcaFindingP: `The paired participant interval is ${ipp(wetImprovement.paired_participant_bootstrap_95)}. Dry eTRCA improved by ${pp(dryImprovement.difference, 1)}, interval ${ipp(dryImprovement.paired_participant_bootstrap_95)}. Neither calibrated point exceeds the analytic CCA reference on the same test blocks.`,
    trcaRegion: 'CCA and ensemble TRCA calibration results, scrolls horizontally',
    trcaCaption: 'Participant-mean balanced accuracy · native 8 channels · 2 s · 12 targets.',
    colMethodBudget: 'Method and labeled target trials', colWet: 'Wet', colDry: 'Dry',
    ccaRow: 'CCA · 0 labels', ccaNote: 'analytic target-recording reference',
    targetOnly: 'target-only adaptation',
    limitsH2: 'What the budget curves do and do not mean',
    limitsLede: 'All results are tied to a frozen protocol. They describe labeled-trial budgets for these methods, sensors and fixed test blocks.',
    limits: [
      ['Different zero-label mechanisms', "Spectral ridge at budget zero is source-only supervised transfer. CCA at budget zero is an analytic target-recording reference. Neither should be connected to target-only points as one model's learning curve."],
      ['Target-only means target-only', "The 12/24/48 ridge and 24/48 eTRCA conditions fit only the target person's calibration recordings, then test on blocks 5–10."],
      ['Prespecified single band', 'eTRCA uses the fixed 6–80 Hz prepared band, not the filter bank of the original method (five sub-bands in the paper and in the reference code’s tutorials), so low scores do not establish an optimized TRCA ceiling.'],
      ['Descriptive intervals', 'Bootstrap intervals summarize participants under this protocol. They do not add retraining uncertainty or establish general calibration requirements for another headset.'],
    ],
    citationNote: (license: string) => `Official Tsinghua author mirror snapshot acquired 2026-09-20 · ${license}. Aggregate results only.`,
    rmEyebrow: 'New people, same task · reviewed 1 October 2026',
    rmH2: 'Adapting a foundation model: head only, last block or LoRA?',
    rmLede: `LaBraM Base on EEGMAT, mental arithmetic versus rest: ${adPeople} people in five participant-disjoint folds, so every score is on people the model was not adapted on. The three update rules start from the same head, see the same batches in the same order and train for the same five epochs. Three seeds are averaged within each person before the cohort mean.`,
    armLabel: { frozen: 'Head only · encoder frozen', 'last-block': 'Last block + head', 'lora-r4': 'LoRA rank 4 + head' } as Record<string, string>,
    armNote: (f1: string, params: string) => `Macro F1 ${f1} · ${params} trainable parameters`,
    rmScale: (m: string) => `For scale: the core matrix's frozen LaBraM, on the same people and folds but read out by a closed-form ridge head on standardized features, scored ${m}. The head-only arm here is a short five-epoch head on unscaled features — not the best a frozen encoder can do — and the two are not a paired comparison.`,
    findingLabel: 'LoRA minus head only, same people',
    findingH3: 'LoRA beat the short head-only fit; it did not beat the last block',
    findingP: `${loraHead.helped} of ${adPeople} people improved and ${loraHead.harmed} got worse; paired interval ${ipp(loraHead.bootstrap_95)}. Updating the last block instead gained ${pp(blockHead.mean_change, 1)} (${ipp(blockHead.bootstrap_95)}). LoRA minus last block was ${pp(loraBlock.mean_change, 1)}, interval ${ipp(loraBlock.bootstrap_95)}: it crosses zero, so neither is shown to be better. ${loraBlock.helped} people did better with LoRA, ${loraBlock.harmed} with the last block.`,
    contrastRegion: 'Paired changes between update rules, scrolls horizontally',
    contrastCaption: `Change in participant-mean score for the same ${adPeople} people under both rules · descriptive person-bootstrap 95% interval · people helped, harmed and unchanged.`,
    colContrast: 'Comparison', colBa: 'Balanced accuracy', colF1: 'Macro F1',
    contrastRow: { 'lora-r4_minus_frozen': 'LoRA − head only', 'last-block_minus_frozen': 'Last block − head only', 'lora-r4_minus_last-block': 'LoRA − last block' } as Record<string, string>,
    counts: (h: number, hm: number, t: number) => `${h} helped · ${hm} harmed · ${t} unchanged`,
    f1Note: 'On macro F1 the gains are smaller, and LoRA helps fewer people over head only than it does on balanced accuracy: the metric matters.',
    costH3: 'What each rule costs',
    costRegion: 'Trainable parameters and training time by update rule, scrolls horizontally',
    costCaption: 'Training time is the sum over 15 fits (5 folds × 3 seeds) on one Apple-silicon Mac, PyTorch MPS backend, excluding loading and evaluation.',
    colRule: 'Update rule', colParams: 'Trainable parameters', colTime: 'Training time, 15 fits', colSeeds: 'Balanced accuracy, seed by seed',
    costNote: 'LoRA trains far fewer weights than the last block but took longer here: its adapters sit in all twelve blocks, so gradients flow back through most of the encoder, and this implementation is an effective-weight parametrization, not an optimized low-rank kernel. Fewer trainable weights do not by themselves mean less time or memory.',
    notDelivered: 'Promised on the roadmap and not delivered by this batch: peak memory (only lower-bound samples were recorded, so none is published) and a comparison at a fixed computation budget (every rule trained for the same five epochs, not the same compute).',
    adLimitsH3: 'What this result is not',
    adLimits: [
      ['One recipe, not a tuned ranking', 'Five epochs, AdamW at learning rate 1e-4, batch 32, with no search, validation split, early stopping or checkpoint selection. Another learning rate or training budget could reorder the rules.'],
      ['New people, not a new day or device', 'The folds hold out people on a task the model is adapted to. Nothing here measures a new recording day, a new headset or a new dataset.'],
      ['A known dataset', "EEGMAT is public, and whether it was in LaBraM's pretraining data is not certified."],
      ['Descriptive intervals', 'Person bootstrap after averaging the three seeds within each person. It ignores the dependence that shared cross-validation models create.'],
    ],
    nextH3: 'Same person, the next day: run, not published',
    nextP: `${nextDaySource}: ${nextDay.design.people} people recorded on two days. Each person's model is trained on day A, calibrated with the first 0, 10, 20 or 40 labeled trials of day B under the same three update rules, and tested on the same later day-B trials. It ran on 22 September and passed an independent replay. The source's editorial hold stands — its catalogue licence is CC BY-NC-ND and its description names no ethics approval — so no figure from it is published.`,
    rmApartH3: 'Four questions kept apart',
    rmApart: 'A new person, a new day, a new dataset and a new device are different questions, answered on different data. A task adapter trained on several people is not evidence that it transfers across devices.',
    rmEngH3: 'Adapter size',
    rmEng: `The LaBraM base encoder has ${n(eng.base_encoder_parameters)} parameters. Rank-${eng.rank} updates to its twelve fused QKV weights add ${n(eng.adapter_parameters)} trainable parameters (${share}); with the ${n(eng.binary_head_parameters_if_added)}-parameter head that is the ${n(loraArm.trainable_parameters)} above. The adapter tensors take ${kib} KiB in float32 before metadata.`,
    rmEngNote: 'These are parameter counts — not accuracy, speed, memory-saving or privacy claims.',
    rmChecksH: 'Engineering checks passed before any real-EEG run:',
    rmCheck: {} as Record<string, string>,
    rmPriorH3: 'Not the first to ask',
    rmPrior: ['Other groups already benchmark EEG adapters: ', 'OpenEEGBench', ' covers parameter-efficient fine-tuning of EEG foundation models; a ', 'systematic study of test-time adaptation', ' reports inconsistent gains under distribution shift; a recent ', 'preprint', ' compares self-supervised adaptation under fixed computation budgets. Our emphasis is the calibration cost, the cases that get worse, and whether recordings are compatible at all.'],
    creditNote: (license: string) => `${license} · aggregate results only; the adaptation reuses the 2026-09-20 review of these recordings.`,
  },
  zh: {
    description: `取决于方法。同样 ${people} 名被试的 12 目标可穿戴 SSVEP 任务上，校准试次从 24 增加到 48，单频带 eTRCA 在湿电极上从 ${etrcaWet24} 升到 ${etrcaWet48}，在干电极上只从 ${etrcaDry24} 升到 ${etrcaDry48}；免训练的 CCA 参考更高。试次数不等于分钟数。`,
    answer: `取决于方法：在 12 目标的可穿戴 SSVEP 任务上，同样 [[${people}]] 名被试、相同的后续测试组块，目标被试校准试次从 24 增加到 48 时，单频带 eTRCA 在湿电极记录上的平衡准确率从 [[${etrcaWet24}]] 升到 [[${etrcaWet48}]]，在干电极记录上只从 [[${etrcaDry24}]] 升到 [[${etrcaDry48}]]。仅用目标被试数据的 spectral ridge 在 48 个校准试次时也只有 [[${ridgeWet48}]]（湿电极）和 [[${ridgeDry48}]]（干电极）；校准后的 eTRCA 没有一个超过不使用校准试次的免训练 CCA 参考（湿电极 [[${ccaWet}]]，干电极 [[${ccaDry}]]）。试次数不等于分钟数：导出数据记录的是每名被试的校准试次数，并不据此推算校准需要多长时间。`,
    plotCaption: `同样 ${people} 名被试的各档校准试次，均在相同的后续组块上测试。`,
    plotLegend: '12 目标、两秒 SSVEP 上的被试平均平衡准确率。点为估计值，横线为被试 bootstrap 95% 区间，虚线为随机水平（12 选 1）。锈色行为湿电极记录，深色行为干电极记录。CCA 不使用校准试次；仅源域迁移是另一种机制，不在图中。',
    plotNote: (s: string, reference: boolean) => `${s}记录 · ${reference ? '免训练参考' : '仅用目标被试数据'}`,
    eyebrow: '适配预算 · 共同的后续测试组块',
    dek: '增加校准试次的价值并不是一个固定值。在这个 12 目标可穿戴协议上，仅用目标被试数据的 spectral ridge（频谱特征岭回归）逐步提升，但始终偏低；单频带集成 TRCA 在湿电极上从 24 增加到 48 个校准试次时提升明显，在干电极上只有小幅提升。',
    sensor: { wet: '湿电极', dry: '干电极' } as Record<string, string>,
    ridgeEyebrow: '仅用目标被试数据的 spectral ridge',
    ridgeH2: '12、24 与 48 个校准试次',
    ridgeLede: '每名目标被试的模型只用该被试自己的有标签校准记录训练。所有条件都在相同的后续组块（第 5–10 组块）上评测，共 102 名被试、7,344 个测试试次。',
    labels: (n: number) => `${n} 个校准试次`,
    baLabel: (v: string) => `平衡准确率 ${v}`,
    participantMean: '被试平均平衡准确率',
    trialsStrong: '试次数不等于分钟数。',
    trialsRest: '导出数据记录的是每名被试 12、24 或 48 个校准试次，并不据此推算校准需要多长时间。',
    zeroEyebrow: '单独的对照组',
    zeroH2: '零个校准试次，即仅源域迁移',
    zeroLede: '校准预算为零的 spectral ridge 各行，使用的是在其他被试、单一源传感器上训练好的模型。它们不是目标被试逐步增加校准数据的学习曲线起点。',
    zeroRegion: '仅源域 spectral ridge 迁移结果，可横向滚动',
    zeroCaption: '共同的后续测试组块（第 5–10 组块）上的被试平均平衡准确率 · 0 个目标被试校准试次。',
    colSource: '训练来源', testWet: '在湿电极上测试', testDry: '在干电极上测试',
    sourceRow: (s: string) => `以${s}为源域`,
    otherOnly: '仅使用其他被试',
    trcaEyebrow: '方法很关键',
    trcaH2: '单频带 eTRCA 的反应不同',
    trcaLede: '仅用目标被试数据的 eTRCA 组使用 24 或 48 个校准试次，并在相同的后续测试组块上评测。零校准试次的 CCA 是免训练参考方法，不是未经拟合的 eTRCA。',
    trcaFindingLabel: '湿电极 eTRCA：48 减 24 个校准试次（pp 为百分点）',
    trcaFindingH3: '增加校准预算对湿电极帮助大得多',
    trcaFindingP: `被试配对区间为 ${ipp(wetImprovement.paired_participant_bootstrap_95)}。干电极 eTRCA 提升了 ${pp(dryImprovement.difference, 1)}，区间 ${ipp(dryImprovement.paired_participant_bootstrap_95)}。两个校准后的结果都没有超过同一测试组块上的免训练 CCA 参考。`,
    trcaRegion: 'CCA 与集成 TRCA 校准结果，可横向滚动',
    trcaCaption: '被试平均平衡准确率 · 原生 8 通道 · 2 秒 · 12 个目标。',
    colMethodBudget: '方法与目标被试校准试次', colWet: '湿电极', colDry: '干电极',
    ccaRow: 'CCA · 0 个校准试次', ccaNote: '直接作用于目标记录的免训练参考',
    targetOnly: '仅用目标被试数据适配',
    limitsH2: '校准预算曲线说明什么，不说明什么',
    limitsLede: '所有结果都绑定在一个预先冻结的协议上，描述的是这些方法、传感器和固定测试组块下的校准试次预算。',
    limits: [
      ['零校准试次背后的机制不同', '预算为零的 spectral ridge 是仅源域的监督迁移；预算为零的 CCA 是直接作用于目标记录的免训练参考。两者都不应与仅用目标被试数据的结果连成同一个模型的学习曲线。'],
      ['「仅目标被试」名副其实', '12/24/48 的 spectral ridge 与 24/48 的 eTRCA 只拟合目标被试自己的校准记录，然后在第 5–10 组块上测试。'],
      ['预先指定的单一频带', 'eTRCA 使用固定的 6–80 Hz 预处理频带，而不是原方法的滤波器组（原论文与参考代码的教程都用 5 个子带），所以较低的分数并不代表 TRCA 经过优化后的上限。'],
      ['描述性区间', 'bootstrap 区间概括的是本协议下的被试间分布，不包含重新训练带来的不确定性，也不能推出其他头戴设备的通用校准需求。'],
    ],
    citationNote: (license: string) => `2026-09-20 获取的清华作者官方镜像快照 · ${license}。仅发布聚合结果。`,
    rmEyebrow: '新被试，同一任务 · 2026 年 10 月 1 日审核',
    rmH2: '基础模型怎么适配：只训分类头、最后一个 Transformer 块（block）还是 LoRA？',
    rmLede: `LaBraM Base 在 EEGMAT 上区分心算与静息：${adPeople} 名被试，按被试不重叠分成 5 折，所以每个分数都来自模型适配时没见过的人。三种更新方式从同一个分类头出发，以相同顺序看到相同的批次，都训练 5 轮（epoch）。3 个随机种子先在每名被试内平均，再求队列均值。`,
    armLabel: { frozen: '只训分类头 · 编码器冻结', 'last-block': '最后一个 Transformer 块 + 分类头', 'lora-r4': '秩为 4 的 LoRA + 分类头' } as Record<string, string>,
    armNote: (f1: string, params: string) => `宏平均 F1 ${f1} · 可训练参数 ${params} 个`,
    rmScale: (m: string) => `作为参照：核心矩阵中同一批被试、同一数据划分上的冻结 LaBraM，配上在标准化特征上闭式求解的岭回归分类头，平衡准确率为 ${m}。这里「只训分类头」那一组是在未缩放特征上只训 5 轮的短训练分类头——并不是冻结编码器能达到的最好结果——两者也不是配对比较。`,
    findingLabel: 'LoRA 减只训分类头，同一批被试',
    findingH3: 'LoRA 胜过短训练的分类头，但没有胜过最后一个 Transformer 块',
    findingP: `${adPeople} 名被试中 ${loraHead.helped} 人提升、${loraHead.harmed} 人变差；配对区间 ${ipp(loraHead.bootstrap_95)}。改为更新最后一个 Transformer 块，提升 ${pp(blockHead.mean_change, 1)}（${ipp(blockHead.bootstrap_95)}）。LoRA 减最后一个 Transformer 块为 ${pp(loraBlock.mean_change, 1)}，区间 ${ipp(loraBlock.bootstrap_95)}：跨过零，所以无法说明哪一个更好。${loraBlock.helped} 人用 LoRA 更好，${loraBlock.harmed} 人用最后一个 Transformer 块更好。`,
    contrastRegion: '各更新方式之间的配对变化，可横向滚动',
    contrastCaption: `同样 ${adPeople} 名被试在两种方式下的被试平均分数之差 · 描述性被试 bootstrap 95% 区间 · 提升、变差与不变的人数。`,
    colContrast: '比较', colBa: '平衡准确率', colF1: '宏平均 F1',
    contrastRow: { 'lora-r4_minus_frozen': 'LoRA − 只训分类头', 'last-block_minus_frozen': '最后一个 Transformer 块 − 只训分类头', 'lora-r4_minus_last-block': 'LoRA − 最后一个 Transformer 块' } as Record<string, string>,
    counts: (h: number, hm: number, t: number) => `${h} 人提升 · ${hm} 人变差 · ${t} 人不变`,
    f1Note: '在宏平均 F1 上提升更小，LoRA 相对只训分类头帮到的人也比平衡准确率上少：指标的选择会影响结论。',
    costH3: '每种方式的代价',
    costRegion: '各更新方式的可训练参数与训练时间，可横向滚动',
    costCaption: '训练时间为 15 次拟合（5 折 × 3 个随机种子）之和，在一台 Apple 芯片 Mac 上用 PyTorch MPS 后端测得，不含加载与评测。',
    colRule: '更新方式', colParams: '可训练参数', colTime: '训练时间，15 次拟合', colSeeds: '平衡准确率，逐个随机种子',
    costNote: 'LoRA 可训练的权重比最后一个 Transformer 块少得多，但这里训练反而更久：它的适配器分布在全部 12 个 Transformer 块中，梯度要反传经过编码器的大部分；而且这里的实现是等效权重参数化，不是优化过的低秩算子。可训练权重少，本身并不意味着更省时间或内存。',
    notDelivered: '路线图上承诺、但这一批没有给出的：峰值内存（只记录了下界采样，因此不发布）；以及固定计算预算下的比较（各方式训练的是相同的 5 轮，而不是相同的计算量）。',
    adLimitsH3: '这个结果不是什么',
    adLimits: [
      ['一个配方，不是调参后的排名', '5 轮，AdamW，学习率 1e-4，批大小 32；没有超参搜索、验证集、早停或检查点挑选。换一个学习率或训练预算，各方式的先后可能改变。'],
      ['新被试，不是新的一天或新设备', '数据划分留出的是被试，任务是模型已经适配过的任务。这里没有测量新的记录日、新的头戴设备或新的数据集。'],
      ['已公开的数据集', 'EEGMAT 是公开数据，它是否在 LaBraM 的预训练数据中，无法证实。'],
      ['描述性区间', '先在每名被试内平均 3 个随机种子，再做被试 bootstrap。它没有计入共享交叉验证模型带来的相关性。'],
    ],
    nextH3: '同一个人，第二天：已运行，不发布',
    nextP: `${nextDaySource}：${nextDay.design.people} 名被试，每人记录两天。每名被试的模型用第一天训练，用第二天最前面的 0、10、20 或 40 个有标签试次、以同样三种更新方式校准，再在第二天同一批后续试次上测试。它已于 9 月 22 日运行，并通过了独立复核。该数据源的编辑暂缓仍然有效——目录标注的许可是 CC BY-NC-ND，数据说明也没有写伦理批准——所以不发布它的任何数字。`,
    rmApartH3: '刻意分开的四个问题',
    rmApart: '新被试、新的一天、新数据集、新设备是四个不同的问题，要用不同的数据回答。在多名被试上训练出的任务适配器，并不能证明它能跨设备迁移。',
    rmEngH3: '适配器的大小',
    rmEng: `LaBraM 基础编码器有 ${n(eng.base_encoder_parameters)} 个参数。对它的 12 个融合 QKV 权重做秩为 ${eng.rank} 的更新，增加 ${n(eng.adapter_parameters)} 个可训练参数（${share}）；加上 ${n(eng.binary_head_parameters_if_added)} 个参数的分类头，就是上面的 ${n(loraArm.trainable_parameters)} 个。适配器张量以 float32 存储约 ${kib} KiB（不含元数据）。`,
    rmEngNote: '这些是参数计数，不代表准确率、速度、内存节省或隐私方面的任何结论。',
    rmChecksH: '在任何真实 EEG 运行之前通过的工程检查：',
    rmCheck: {
      'exact adapter save and reload': '适配器保存与重载后完全一致',
      'exact merged-weight equivalence': '合并权重后输出完全等价',
      'finite, nonzero adapter gradients in every block': '每个 Transformer 块的适配器梯度有限且非零',
      'frozen encoder weights unchanged after updates': '更新后冻结编码器的权重保持不变',
      'identical output at zero adapter initialization': '适配器零初始化时输出完全不变',
    } as Record<string, string>,
    rmPriorH3: '这个问题已有前人研究',
    rmPrior: ['已有其他工作在评测 EEG 适配器：', 'OpenEEGBench', ' 覆盖 EEG 基础模型的参数高效微调；一项', '关于测试时适配的系统研究', '报告了分布偏移下时好时坏的收益；一篇近期', '预印本', '比较了固定计算预算下的自监督适配。我们的侧重点是校准成本、变差的情况，以及记录条件本身是否兼容。'],
    creditNote: (license: string) => `${license} · 仅发布聚合结果；本次适配沿用 2026-09-20 对这些记录的审查。`,
  },
}[locale];
const card = topicCards[locale]['calibration-budget'];
---
<TopicLayout
  locale={locale}
  title={card.title}
  description={copy.description}
  path="/topics/calibration-budget/"
  eyebrow={copy.eyebrow}
  dek={copy.dek}
  activeSlug="calibration-budget"
  answer={copy.answer}
>
  <IntervalPlot
    caption={copy.plotCaption}
    legend={copy.plotLegend}
    domain={[0, 1]}
    ticks={['0%', '25%', '50%', '75%', '100%']}
    reference={chance}
    rows={sensors.flatMap(sensor => [
      { row: methodRow('cca', sensor, 0), label: copy.ccaRow, reference: true },
      ...budgets.map(budget => ({ row: targetRidge(sensor, budget), label: `${modelLabel('spectral-ridge', locale)} · ${copy.labels(budget)}`, reference: false })),
      ...[24, 48].map(budget => ({ row: methodRow('ensemble-trca', sensor, budget), label: `${modelLabel('ensemble-trca', locale)} · ${copy.labels(budget)}`, reference: false })),
    ].map(({ row, label, reference }) => ({ label, note: copy.plotNote(copy.sensor[sensor], reference), tone: sensor === 'wet' ? 'rust' as const : 'ink' as const, value: row.value, interval: row.confidence_interval_95, text: `${pct(row.value)} (${intervalPct(row.confidence_interval_95)})` })))}
  />
  <section class="topic-section" aria-labelledby="ridge-heading">
    <div class="topic-heading"><div><p class="eyebrow">{copy.ridgeEyebrow}</p><h2 id="ridge-heading">{copy.ridgeH2}</h2></div><p>{copy.ridgeLede}</p></div>
    <div class="evidence-grid">{sensors.flatMap(sensor => budgets.map(budget => {
      const row = targetRidge(sensor,budget);
      return <article class="evidence-card"><p class="eyebrow">{copy.sensor[sensor]} · {copy.labels(budget)}</p><div class="reading">{pct(row.value)}</div><ScoreBar value={row.value} max={0.85} label={copy.baLabel(pct(row.value))} tone={sensor === 'wet' ? 'rust' : 'ink'} /><p>{copy.participantMean}</p><small>{tc.interval95} {intervalPct(row.confidence_interval_95)}</small></article>;
    }))}</div>
    <p class="protocol-note"><strong>{copy.trialsStrong}</strong>{copy.trialsRest}</p>
  </section>

  <section class="topic-section" aria-labelledby="zero-heading">
    <div class="topic-heading"><div><p class="eyebrow">{copy.zeroEyebrow}</p><h2 id="zero-heading">{copy.zeroH2}</h2></div><p>{copy.zeroLede}</p></div>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.zeroRegion}>
      <table><caption>{copy.zeroCaption}</caption><thead><tr><th scope="col">{copy.colSource}</th><th scope="col">{copy.testWet}</th><th scope="col">{copy.testDry}</th></tr></thead><tbody>{sensors.map(source => <tr><th scope="row">{copy.sourceRow(copy.sensor[source])}<small>{copy.otherOnly}</small></th>{sensors.map(target => {
        const row = sourceRidge(source,target);
        return <td><span class="metric">{pct(row.value)}</span><span class="interval">{intervalPct(row.confidence_interval_95)}</span></td>;
      })}</tr>)}</tbody></table>
    </div>
  </section>

  <section class="topic-section" aria-labelledby="trca-heading">
    <div class="topic-heading"><div><p class="eyebrow">{copy.trcaEyebrow}</p><h2 id="trca-heading">{copy.trcaH2}</h2></div><p>{copy.trcaLede}</p></div>
    <div class="finding">
      <div class="finding-number"><strong>{pp(wetImprovement.difference, 1)}</strong><span>{copy.trcaFindingLabel}</span></div>
      <div class="finding-copy"><h3>{copy.trcaFindingH3}</h3><p>{copy.trcaFindingP}</p></div>
    </div>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.trcaRegion}>
      <table><caption>{copy.trcaCaption}</caption><thead><tr><th scope="col">{copy.colMethodBudget}</th><th scope="col">{copy.colWet}</th><th scope="col">{copy.colDry}</th></tr></thead><tbody>
        <tr><th scope="row">{copy.ccaRow}<small>{copy.ccaNote}</small></th>{sensors.map(sensor => { const row=methodRow('cca',sensor,0); return <td><span class="metric">{pct(row.value)}</span><span class="interval">{intervalPct(row.confidence_interval_95)}</span></td>; })}</tr>
        {[24,48].map(budget => <tr><th scope="row">{modelLabel('ensemble-trca', locale)} · {copy.labels(budget)}<small>{copy.targetOnly}</small></th>{sensors.map(sensor => { const row=methodRow('ensemble-trca',sensor,budget); return <td><span class="metric">{pct(row.value)}</span><span class="interval">{intervalPct(row.confidence_interval_95)}</span></td>; })}</tr>)}
      </tbody></table>
    </div>
  </section>

  <section class="topic-section" id="adaptation" aria-labelledby="adaptation-heading">
    <div class="topic-heading"><div><p class="eyebrow">{copy.rmEyebrow}</p><h2 id="adaptation-heading">{copy.rmH2}</h2></div><p>{copy.rmLede}</p></div>
    <div class="evidence-grid">{ad.arms.map(a => <article class="evidence-card"><p class="eyebrow">{copy.armLabel[a.id]}</p><div class="reading">{pct(a.balanced_accuracy.mean)}</div><ScoreBar value={a.balanced_accuracy.mean} max={1} label={copy.baLabel(pct(a.balanced_accuracy.mean))} tone={a.id === 'frozen' ? 'ink' : 'rust'} /><p>{copy.armNote(pct(a.macro_f1.mean), n(a.trainable_parameters))}</p><small>{tc.interval95} {intervalPct(a.balanced_accuracy.bootstrap_95)}</small></article>)}</div>
    <p class="protocol-note">{copy.rmScale(matrixBa)}</p>
    <div class="finding">
      <div class="finding-number"><strong>{pp(loraHead.mean_change, 1)}</strong><span>{copy.findingLabel}</span></div>
      <div class="finding-copy"><h3>{copy.findingH3}</h3><p>{copy.findingP}</p></div>
    </div>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.contrastRegion}>
      <table><caption>{copy.contrastCaption}</caption><thead><tr><th scope="col">{copy.colContrast}</th><th scope="col">{copy.colBa}</th><th scope="col">{copy.colF1}</th></tr></thead><tbody>{ad.paired_contrasts.balanced_accuracy.map(c => { const f = contrast('macro_f1', c.id); return <tr><th scope="row">{copy.contrastRow[c.id]}</th>{[c, f].map(x => <td><span class="metric">{pp(x.mean_change, 1)}</span><span class="interval">{ipp(x.bootstrap_95)}</span><span class="interval">{copy.counts(x.helped, x.harmed, x.tied)}</span></td>)}</tr>; })}</tbody></table>
    </div>
    <p class="protocol-note">{copy.f1Note}</p>
    <h3 class="roadmap-h3">{copy.costH3}</h3>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.costRegion}>
      <table><caption>{copy.costCaption}</caption><thead><tr><th scope="col">{copy.colRule}</th><th scope="col">{copy.colParams}</th><th scope="col">{copy.colTime}</th><th scope="col">{copy.colSeeds}</th></tr></thead><tbody>{ad.arms.map(a => <tr><th scope="row">{copy.armLabel[a.id]}</th><td><span class="metric">{n(a.trainable_parameters)}</span></td><td><span class="metric">{secs(a.training_seconds_15_fits)}</span></td><td><span class="interval">{seedMeans(a)}</span></td></tr>)}</tbody></table>
    </div>
    <p class="roadmap-p">{copy.costNote}</p>
    <p class="protocol-note">{copy.notDelivered}</p>
    <h3 class="roadmap-h3">{copy.adLimitsH3}</h3>
    <div class="method-grid-wide">{copy.adLimits.map(([h, p]) => <article><h3>{h}</h3><p>{p}</p></article>)}</div>
    <h3 class="roadmap-h3" id="next-day">{copy.nextH3}</h3>
    <p class="roadmap-p">{copy.nextP}</p>
    <h3 class="roadmap-h3">{copy.rmApartH3}</h3>
    <p class="roadmap-p">{copy.rmApart}</p>
    <h3 class="roadmap-h3">{copy.rmEngH3}</h3>
    <p class="roadmap-p">{copy.rmEng}</p>
    <p class="roadmap-p"><strong>{copy.rmChecksH}</strong> {eng.checks_passed.map(c => copy.rmCheck[c] ?? c).join(locale === 'zh' ? '；' : '; ')}{tc.period}</p>
    <p class="protocol-note">{copy.rmEngNote}</p>
    <h3 class="roadmap-h3">{copy.rmPriorH3}</h3>
    <p class="roadmap-p">{copy.rmPrior[0]}<a href="https://github.com/braindecode/OpenEEGBench" target="_blank" rel="noreferrer">{copy.rmPrior[1]}</a>{copy.rmPrior[2]}<a href="https://proceedings.mlr.press/v340/lee26a.html" target="_blank" rel="noreferrer">{copy.rmPrior[3]}</a>{copy.rmPrior[4]}<a href="https://arxiv.org/abs/2608.24727v1" target="_blank" rel="noreferrer">{copy.rmPrior[5]}</a>{copy.rmPrior[6]}</p>
  </section>

  <section class="topic-section" id="methods-and-limits" aria-labelledby="limits-heading">
    <div class="topic-heading"><div><p class="eyebrow">{tc.methodsEyebrow}</p><h2 id="limits-heading">{copy.limitsH2}</h2></div><p>{copy.limitsLede}</p></div>
    <div class="method-grid-wide">{copy.limits.map(([h, p]) => <article><h3>{h}</h3><p>{p}</p></article>)}</div>
    {citation && <div class="citation-list"><article><h3 lang="en">{citation.identity.title}</h3><p lang="en">{citation.identity.canonical_dataset_citation}</p><p lang="en">{citation.identity.paper_citation}</p><p>{copy.citationNote(citation.identity.license ?? '')}</p><p><a href={citation.primary_sources[0]} target="_blank" rel="noreferrer">{tc.datasetRecord}</a> · <a href={citation.primary_sources[1]} target="_blank" rel="noreferrer">{tc.sensorsPaper}</a></p></article></div>}
    <div class="citation-list"><article><h3 lang="en">{ad.rights.name}</h3><p lang="en">{ad.rights.attribution}</p><p>{copy.creditNote(ad.rights.license)}</p><p><a href={ad.rights.source} target="_blank" rel="noreferrer">{tc.datasetRecord}</a></p></article></div>
    <p class="citation-note">{tc.dataSource} <a href="/data/deployment-topics.json" download>{tc.reviewedAggregate}</a> · {tc.schema} {data.schema_version} · {tc.generated} {data.generated_at.slice(0,10)}{tc.period}</p>
    <p class="citation-note">{tc.dataSource} <a href="/data/adaptation-update.json" download>adaptation-update.json</a> · {tc.schema} {adaptation.schema_version} · {tc.generated} {adaptation.generated_at}{tc.period}</p>
  </section>
</TopicLayout>
