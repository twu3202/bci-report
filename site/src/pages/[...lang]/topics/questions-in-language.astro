---
/**
 * Route 3 of the decision-research plan, questions in language (owner approval of the results, 2026-10-08): can an EEG
 * model answer questions asked in words? One small question-conditioned head over frozen features is asked each
 * question by a question number, a label template or a description. Its own question in "Adapting models";
 * when-not-to-act's roadmap marks the route run and links here, and /jev-style/ gathers the three routes.
 *
 * Every figure is a leaf of questions-in-language-update.json (the count of wordings, of questions-in-language-
 * wordings.json), printed with data-fig (Fig.astro) and re-read by check-workbench.mjs. Rules (handoff and review
 * manifest of 2026-10-08): seen questions in their training wording, rewordings and questions the EEG head was never
 * trained on are separate rows, never pooled into one zero-shot number; every entry prints both flags, the margin with
 * them; "unseen" travels with "unseen by the EEG head, not by the text encoder"; the pre-run checks are pass or fail
 * and counts, the two failed canary revisions and the owner's override disclosed; every BOAS figure sits in an element
 * marked data-boas that holds the three gaps, the credit and "pseudonymised in the public release" (BoasGaps.astro), so
 * the short answer, the description and the card print none; secondary results sit in a collapsed panel, labelled
 * single-seed and declared likely inconclusive where they were. The sentences that summarise a table are checked
 * against the export below, and the page refuses to build if the numbers stop supporting them.
 */
import TopicLayout from '../../../components/TopicLayout.astro';
import Fig from '../../../components/Fig.astro';
import Parts from '../../../components/Parts.astro';
import BoasGaps from '../../../components/BoasGaps.astro';
import QlRow from '../../../components/QlRow.astro';
import { hrefFor, localeOf, localeParams, topicCards, topicChrome } from '../../../data/i18n';
import { formatFig, type Fig as FigValue, type Fmt } from '../../../data/entities';
import { R3, QL, QLW, DELTA, RATIO, block, entry, level, part, qlFig, qlwFig, qlRelease, qlwRelease, QL_DATASETS, QL_BOAS, qlText,
         visualJev, differenceText, marginText, type QlEntry, type QlLevel, type QlRow as QlRowT } from '../../../data/questions-in-language';
import wordings from '../../../data/questions-in-language-wordings.json';
import { fmModelById, fmTermsSentence } from '../../../data/foundation-models';
import { jevStyle } from '../../../data/decision-research';

export const getStaticPaths = localeParams;
const locale = localeOf(Astro.params.lang);
const zh = locale === 'zh';
const tc = topicChrome[locale];
type Part = string | FigValue;
const f = (raw: number, fmt: Fmt = 'pct1') => qlFig(raw, fmt);
const n = (raw: number) => qlFig(raw, 'count');
const pp = (raw: number) => qlFig(raw, 'pp2');
const s3 = (raw: number) => qlFig(raw, 'sgn3');
const a3 = (raw: number) => qlFig(raw, 'auc3');
const a2 = (raw: number) => qlFig(raw, 'auc2');
const F = (x: FigValue) => formatFig(x);
const ans = (x: FigValue) => `[[${F(x)}]]`;
const to = ` ${tc.to} `;
/** An entry's 95% interval as the tables print it: pp with the unit once, or a signed three-decimal value. */
const iv = (e: { interval_95: [number, number]; unit: string }): Part[] => e.unit === 'difference of proportions'
  ? [qlFig(e.interval_95[0], 'sgn2'), to, pp(e.interval_95[1])] : [s3(e.interval_95[0]), to, s3(e.interval_95[1])];
const ivPct = (x: { interval_95: [number, number] }): Part[] => [f(x.interval_95[0]), '–', f(x.interval_95[1])];
const ivA3 = (x: { interval_95: [number, number] }): Part[] => [a3(x.interval_95[0]), '–', a3(x.interval_95[1])];
const ivR = (e: QlEntry): Part[] => [a2(e.r!.interval_95[0]), '–', a2(e.r!.interval_95[1])];

// --- The facts every sentence below rests on; the page refuses to build without them. -----------------------
const need = (ok: boolean, what: string) => { if (!ok) throw new Error(`questions-in-language: the copy says ${what}`); };
const B0 = block('P-ssvep-L0'), B1 = block('P-ssvep-L1'), BS = block('P-sleep-L1');
need(B0.dataset === 'BETA' && B1.dataset === 'BETA' && BS.dataset === 'BOAS' && B0.level === 'L0' && B1.level === 'L1' && BS.level === 'L1',
  'SSVEP on BETA at L0 and L1, sleep on BOAS at L1');
need(B0.people === B1.people && [B0, B1, BS].every(b => b.seeds === 3), 'three seeds, the same BETA cohort at both levels');
need(R3.primary.entries_count === 35 && blocks35(), '35 primary entries');
function blocks35() { return [B0, B1, BS].reduce((s, b) => s + b.entries.length, 0) === R3.primary.entries_count; }
const E = entry;
const keys = (b: string, ix: number[]) => ix.map(i => E(`${b}/${i}`));
const refNotMet = (e: QlEntry) => e.difference === 'difference: reference higher' && e.margin === 'margin not met';
const equiv = (e: QlEntry) => e.difference === 'no difference shown' && e.margin === 'equivalent within the margin';
// P1: on sleep equivalent; on SSVEP language cost accuracy at both levels.
const [t0, d0] = keys('P-ssvep-L0', [0, 1]), [t1, d1] = keys('P-ssvep-L1', [0, 1]), [ts, ds] = keys('P-sleep-L1', [0, 1]);
const p1 = [t0, d0, t1, d1, ts, ds];
need(p1.every(e => e.id === 'P1') && [t0, d0, t1, d1].every(refNotMet) && equiv(ts) && equiv(ds), 'P1: SSVEP cost accuracy, margin not met; sleep equivalent');
// P2: every BETA rewording cost accuracy, only the L1 synonyms within the margin; on sleep a new frame equivalent.
const p2b = [...keys('P-ssvep-L0', [2, 3, 4]), ...keys('P-ssvep-L1', [2, 3, 4])], p2s = keys('P-sleep-L1', [2, 3, 4]);
need([...p2b, ...p2s].every(e => e.id === 'P2' && e.kind === 'rewording'), 'P2 is rewording');
need(p2b.filter((_, i) => i !== 4).every(refNotMet) && p2b[4].difference === 'difference: reference higher' && p2b[4].margin === 'equivalent within the margin'
  && p2b[4].label.startsWith('TPL(a2)'), 'on BETA every rewording cost accuracy, only the L1 synonyms within the margin');
need(equiv(p2s[0]) && refNotMet(p2s[1]) && refNotMet(p2s[2]) && p2s[0].label.startsWith('TPL(a1)') && p2s[1].label.startsWith('TPL(a2)') && p2s[2].label.startsWith('DESC(a3)'),
  'sleep: a new frame equivalent, synonyms and descriptions a cost');
const p2Worst = p2b.reduce((a, b) => (b.estimate < a.estimate ? b : a)), p2Least = p2b.reduce((a, b) => (b.estimate > a.estimate ? b : a));
need(p2Least === p2b[4], 'the smallest BETA rewording cost is the L1 synonyms');
// P3: every unseen sleep question fell short of the read-off, margin not met; R from NREM explicit to asleep implicit.
const p3 = keys('P-sleep-L1', [5, 6, 7, 8, 9, 10, 11, 12]);
need(p3.every(e => e.id === 'P3' && e.kind === 'unseen' && e.difference === 'difference: the read-off leaves less error' && e.margin === 'margin not met' && e.rule === 1 && !!e.r && e.r.interval_95[0] > 1),
  'every unseen sleep question fell short of the read-off in all eight wordings');
const rMin = p3.reduce((a, b) => (b.r!.estimate < a.r!.estimate ? b : a)), rMax = p3.reduce((a, b) => (b.r!.estimate > a.r!.estimate ? b : a));
need(rMin.key === 'P-sleep-L1/7' && rMax.key === 'P-sleep-L1/5', 'R ran from N1, N2 or N3 sleep (explicit) to asleep (implicit)');
// P5: SHUF higher on the implicit names, TPL higher on the explicit names; difference only.
const [p5i, p5e] = keys('P-sleep-L1', [13, 14]);
need(p5i.id === 'P5' && p5e.id === 'P5' && p5i.label.endsWith('implicit cells') && p5e.label.endsWith('explicit cells')
  && p5i.difference === 'difference: reference higher' && p5e.difference === 'difference: language arm higher'
  && [p5i, p5e].every(e => e.margin === 'not applicable (difference only)'), 'P5: the explicit names use the link, the implicit names were not shown to');
// P4: far below CCA; worse than the neighbour average and the numeric code in the 8-way; neighbour 3-way against NUM: none at L0, higher at L1.
const p4a = keys('P-ssvep-L0', [5, 6, 7, 8, 9]), p4b = keys('P-ssvep-L1', [5, 6, 7, 8, 9]);
need([...p4a, ...p4b].every(e => e.id === 'P4' && e.kind === 'unseen'), 'P4 is unseen frequencies');
for (const g of [p4a, p4b]) need(refNotMet(g[0]) && refNotMet(g[3]) && g[1].difference === 'difference: reference higher' && g[2].difference === 'difference: reference higher',
  'at both levels: far below CCA, worse than the neighbour average and the numeric code in the 8-way');
need(p4a[4].difference === 'no difference shown' && p4b[4].difference === 'difference: language arm higher', 'neighbour 3-way against NUM: no difference at L0, TPL higher at L1');
// Levels the readings name.
const L0 = (k: string) => level('P-ssvep-L0', k), L1 = (k: string) => level('P-ssvep-L1', k), LS = (k: string) => level('P-sleep-L1', k);
need(L0('TPL u8').estimate < L0('CCA u8').estimate && L1('TPL u8').estimate < L0('CCA u8').estimate && L0('CCA u8').estimate === L1('CCA u8').estimate, 'CCA is the same at both levels and far above the head');
need(L0('TPL u3').estimate < L0('TPL u3').chance!, 'the template head fell below the mean chance of the neighbour 3-way on a plain spectrum');
const H = R3.pre_run_checks.gates.headroom;
need(Math.abs(H['P-ssvep-L0'].estimate - L0('ID seen_ba').estimate) < 1e-12 && Math.abs(H['P-sleep-L1'].estimate - LS('ID seen_ba').estimate) < 1e-12, 'the headroom gate reads the ID level');
const sleepSeen = ['ID', 'TPL', 'DESC', 'SHUF', 'B-sh'].map(a => LS(`${a} seen_ba`).estimate);
need(Math.max(...sleepSeen) - Math.min(...sleepSeen) < 0.005, 'every sleep arm reached about the same seen balanced accuracy');
const S15 = R3.descriptive['P-sleep-L1'].S15!;
const auroc = (k: string) => LS(`${k} AUROC`);
need(auroc('TPL unseen asleep implicit').estimate < 0.5 && auroc('TPL unseen light implicit').estimate < 0.5 && auroc('TPL unseen asleep implicit').interval_95[1] < 0.5
  && auroc('TPL unseen light implicit').interval_95[1] < 0.5, 'the implicit names ranked windows in reverse');
need(auroc('TPL unseen asleep explicit').estimate < S15['asleep prior-corrected read-off (TPL)'].estimate && auroc('TPL unseen light explicit').estimate < S15['light prior-corrected read-off (TPL)'].estimate,
  'the explicit names stayed short of the read-off');
// The pre-run checks.
const C = R3.pre_run_checks.canaries, r3c = C.revision_3, r4c = C.revision_4, r5c = C.revision_5;
need(!r3c.pass && !r4c.pass && r5c.pass && r5c.intervals_excluding_zero === 0 && r3c.intervals === r4c.intervals && r4c.intervals === r5c.intervals,
  'revision 3 failed, revision 4 failed, revision 5 passed, on the same intervals');
need(r4c.cells_excluding_chance.every(c => c.cell.startsWith('sleep/')) && r4c.cells_excluding_chance.some(c => c.side === 'below'), 'revision 4 failed on BOAS only, once below chance');
need(r3c.cells_excluding_chance.length === 1 && r3c.cells_excluding_chance[0].cell === 'sleep/L1/SHUF unseen light explicit', 'revision 3 failed on one sleep cell');
const dirs = r5c.single_head_intervals_excluding_exact_chance;
need(dirs.above + dirs.below === dirs.total, 'the direction counts add up');
need(/no further revision/.test(R3.pre_run_checks.owner_override) && /not run/.test(R3.pre_run_checks.centring_diagnostic), 'the owner override and the centring diagnostic not run');
const NP = R3.pre_run_checks.numeracy_probe;
const rho = ['bge/frame0', 'bge/frame1', 'bge/frame2'].map(k => NP.spearman_rho[k]);
need(!NP.activated && rho.every(r => r >= 0.3) && NP.flag_anyway.L0.difference === 'difference: reference higher' && NP.flag_anyway.L1.difference === 'difference: reference higher',
  'the numeracy prediction was not activated: every rho at or above 0.3, and NUM higher at both levels anyway');
const S06 = R3.pre_run_checks.decision_s0b6.token_rule;
need(S06.stops_the_run_for.join() === 'bge-small-en-v1.5,all-MiniLM-L6-v2' && S06.multilingual_e5_small.full_rule_passed === 0, 'S0b-6: the rule stops bge and MiniLM, and cannot hold for e5');
const G = R3.pre_run_checks.gates;
need(Object.values(G.headroom).every(h => h.pass) && G.readoff_floor.primary_cells === G.readoff_floor.primary_cells_passing && G.readoff_floor.secondary_cells === G.readoff_floor.secondary_cells_passing
  && G.shuffled_eeg_scorer_check.pass && G.shuffled_eeg_scorer_check.cells === G.shuffled_eeg_scorer_check.cells_within_3_se, 'every gate passed');
const fit = G.fit_check.by_domain_and_level;
need(['ssvep/L0', 'ssvep/L1', 'ssvep/REVE'].every(k => fit[k].fallback_to_60_epochs && fit[k].training_epochs === 60)
  && ['sleep/L1', 'sleep/REVE', 'eesm19/L1', 'mi/L1'].every(k => !fit[k].fallback_to_60_epochs && fit[k].training_epochs === 30)
  && Object.values(fit).every(x => x.failed_fits === 0), 'the 60-epoch fallback on every SSVEP arm, 30 epochs elsewhere, no failed fit');
const triv = G.triviality;
need(triv.BETA.pass && triv.BOAS.pass && triv.EESM19.pass && /no declared canary/.test(triv['OpenBMI MI'].label!), 'the triviality canary passed on BETA, BOAS and EESM19, none declared for motor imagery');
const A = R3.audits;
need([A.primary_conformance, A.secondary_conformance].every(a => a.verdict === 'pass' && a.failed === 0) && A.primary_numeric.verdict === 'pass' && A.primary_numeric.mismatches === 0
  && A.secondary_numeric.verdict === 'pass' && A.secondary_numeric.unexplained === 0, 'four independent audits passed');
need(R3.secondary.expected_inconclusive.join() === 'every EESM19 entry,every single-seed S entry' && /no secondary entry reached the "inconclusive" flag combination/.test(R3.secondary.none_inconclusive),
  'every EESM19 and single-seed entry declared likely inconclusive; none reached the flags');
need(/not corrected for multiplicity/.test(R3.design.multiplicity), 'no multiplicity correction');
need(R3.references[0].id === 'yu-yao-2026', 'the Visual Jev paper first');
// REVE-L (secondary) is the v9 REVE Large checkpoint (route 3's protocol: the v9 features on BETA, route 2's on BOAS, both
// from the v9 weights manifest). Its licence asks that the paper be cited and the model version named (the handoff).
const REVE_L = fmModelById['reve-large'];
need(!!REVE_L && !!REVE_L.revision && /name the model version|as REVE Base/.test(REVE_L.licenceNote + (fmModelById['reve-base']?.licenceNote ?? '')) && /arxiv\.org\/abs\//.test(REVE_L.paper),
  'REVE Large, with its revision, its licence and its paper');
const reveVersion = REVE_L.revision!.split(' @ ').at(-1)!;

// --- The secondary parts, as the panel prints them. ----------------------------------------------------------
const S = (id: string) => part(id);
const entryParts = ['S1', 'S2', 'S3-ssvep', 'S4-ssvep-L0', 'S4-ssvep-L1', 'S5-ssvep-L0'].map(S);
const boasEntryParts = ['S3-sleep', 'S4-sleep-L1', 'S5-sleep-L1'].map(S);
for (const p of [...entryParts, ...boasEntryParts]) {
  need(p.boas === (p.dataset === 'BOAS') && (p.entries ?? []).length > 0, `${p.part} carries its entries`);
  need(p.part === 'S1' || p.part === 'S2' ? !p.single_seed : !!p.single_seed && !!p.declared_likely_inconclusive, `${p.part}: single seed and declared likely inconclusive`);
}
need(S('S1').declared_likely_inconclusive === true && S('S2').declared_likely_inconclusive === false, 'EESM19 declared likely inconclusive, OpenBMI not');
const s2hand = E('secondary/S2/5');
need(s2hand.difference === 'difference: the read-off leaves less error' && s2hand.margin === 'equivalent within the margin', 'imagining a hand movement: a difference, within the 1.25 margin');
const S6 = S('S6'), S13 = S('S13-sleep'), S8 = [S('S8-L0'), S('S8-L1')], S12 = S('S12'), SX = [S('SSVEP-L0-secondary'), S('SSVEP-L1-secondary')];
need(S6.boas && S13.boas && !S12.boas && S8.every(p => !p.boas && p.single_seed), 'the BOAS probes are S6 and S13; S8 is BETA, one seed');
const negated = Object.entries(S6.cells!);
need(negated.every(([, c]) => (c.negated_wording_auroc ?? c.auroc).estimate < 0.5 && (c.negated_wording_auroc ?? c.auroc).interval_95[1] < 0.5), 'every negated wording was answered as if it asked for X');
need(Object.values(S13.rows!).every(r => 'difference' in r && r.difference === 'difference: the read-off leaves less error' && r.margin === 'margin not met'), 'held-out frames give the same P3 result');
/** A row of a rows-type part: its two arms read from the export's own key. */
const rowXY = (k: string, r: QlRowT) => {
  if (r.unit === 'log R') return { x: 'TPL', y: 'read-off' };
  if (/^rotation \d$/.test(k)) return { x: 'TPL', y: 'CCA' };
  const m = k.replace(/^S\d+ /, '').match(/^(.+?) - (\S+?)(?: \(|$)/);
  if (!m) throw new Error(`questions-in-language: no arms in "${k}"`);
  return { x: m[1], y: m[2] };
};
const rowEst = (r: QlRowT): Part[] => r.unit === 'difference of proportions' ? [pp(r.estimate)] : [s3(r.estimate)];
const flip = R3.secondary.flip_rates;
const sx = (L: 0 | 1) => SX[L];
const rot = (L: 0 | 1) => Object.entries(sx(L).per_rotation_tpl_minus_cca_8_way!);
need(rot(0).length === 5 && rot(1).length === 5 && [...rot(0), ...rot(1)].every(([, r]) => refNotMetRow(r)), 'every rotation: TPL below CCA, margin not met');
function refNotMetRow(r: QlRowT) { return r.difference === 'difference: reference higher' && r.margin === 'margin not met'; }
const synonymKeys = [1, 2, 3].map(i => `TPL(a2, synonym ${i}) - TPL(train)`);
const synonymOf = (b: string, k: string) => R3.descriptive[b].contrasts[k];
const costRows = Object.keys(R3.descriptive['P-ssvep-L0'].generalisation_costs!);
const costName = (k: string) => {
  const m = k.match(/^(ID|TPL|DESC|SHUF|NUM|B-sh|CCA) (8|3)-way \(unseen\s+(NN )?- matched seen\)$/);
  if (!m) throw new Error(`questions-in-language: a generalisation cost "${k}"`);
  return zh ? `${m[1]}，${m[2]} 选 1${m[3] ? '（相邻读出）' : ''}` : `${m[1]}, ${m[2]}-way${m[3] ? ' (neighbour read-off)' : ''}`;
};
const levelRows: [string, string][] = [['TPL', 'u8'], ['DESC', 'u8'], ['SHUF', 'u8'], ['NUM', 'u8'], ['CCA', 'u8'], ['TPL', 'nn8'], ['ID', 'nn8'], ['B-sh', 'nn8'], ['TPL', 'u3'], ['NUM', 'u3'], ['CCA', 'u3']];
const seenArms = ['ID', 'TPL', 'DESC', 'SHUF', 'NUM', 'B-sh', 'CCA'];
const sleepArms = ['ID', 'TPL', 'DESC', 'SHUF', 'B-sh'];
const LL = R3.descriptive['P-sleep-L1'].log_loss!;
const perStage = R3.descriptive['P-sleep-L1'].seen_auroc_per_predicate!;
const stages = ['W', 'N1', 'N2', 'N3', 'REM'];
need(stages.every(s => ['ID', 'TPL', 'DESC'].every(a => perStage[`${a} ${s}`].people === perStage[`ID ${s}`].people)) && perStage['ID N3'].people < BS.people
  && Math.min(...Object.values(perStage).map(x => x.people)) >= QL_BOAS.minimum_cell_people, 'per-stage AUROC: N3 pools fewer people, every cell at least 20');
const unseenNames = wordings.lists['en/sleep'].unseen_names as Record<string, { implicit: string | null; explicit: string }>;
const unions = ['asleep', 'NREM', 'light'] as const;
const sleepFrames = wordings.lists['en/sleep'].frames_train;
const sleepCanon = wordings.lists['en/sleep'].canonical as Record<string, string>;
const sleepSyn = wordings.lists['en/sleep'].synonyms as Record<string, string[]>;
const p3Rows: { q: string; w: 'implicit' | 'explicit' }[] = [{ q: 'asleep', w: 'implicit' }, { q: 'asleep', w: 'explicit' }, { q: 'NREM', w: 'explicit' }, { q: 'light', w: 'implicit' }, { q: 'light', w: 'explicit' }];
const literature = R3.references;
const encoders = Object.values(R3.design.text_encoders);
const roleOf = { bge: { en: 'primary', zh: '主分析' }, minilm: { en: 'secondary, S4', zh: '次要分析，S4' }, e5: { en: 'Chinese wordings, S5', zh: '中文问法，S5' } } as const;
const limits = R3.limitations.map(x => qlText(x, locale));
const notRun = [...R3.not_run.map(x => [x.item, x.status]), ...R3.not_reported.map(x => [x.item, x.status])].map(([a, b]) => [qlText(a, locale), qlText(b, locale)]);

// --- The copy. The short answer and the description print no BOAS figure (BOAS travels with its gaps, below). ---
const ivAns = (e: QlEntry) => `${ans(qlFig(e.interval_95[0], 'sgn2'))} ${tc.to} ${ans(pp(e.interval_95[1]))}`;
const u8 = L0('TPL u8'), cca8 = L0('CCA u8');
const copy = {
  en: {
    description: `In its training wording, a small head on frozen EEG features matched question numbers on seen sleep questions but not on SSVEP (${F(pp(t0.estimate))} with templates on a plain spectrum, ${B0.people} people); rewordings mostly cost accuracy, and it did not answer unseen questions: CCA, with no training, did far better on unseen frequencies.`,
    answer: `Only for questions it was trained on, and not on every dataset. A small head over frozen EEG features, asked a seen question with a label template or a description instead of a question number, was equivalent within the ${DELTA} pp margin on sleep (BOAS), but lost accuracy on SSVEP (BETA, ${ans(n(B0.people))} people): ${ans(pp(t0.estimate))} with templates on a plain spectrum (${ivAns(t0)}), the margin not met. Rewording a seen question cost accuracy too, except a new sentence frame on sleep. Questions the EEG head was never trained on were not answered usefully: every unseen sleep question did worse than adding up the head’s own stage answers, and on unseen flicker frequencies the head reached ${ans(f(u8.estimate))} on a plain spectrum where CCA, which needs no training, reached ${ans(f(cca8.estimate))} (chance ${ans(f(u8.chance!))}). Explicit wordings such as “N1 or N2 sleep” used the link between words and stages; the everyday names “asleep” and “light sleep” ranked windows backwards, and in a boundary probe negated questions were answered as if they asked for what they negate.`,
    eyebrow: 'Questions in language · route 3 of the decision-research plan',
    dek: 'One small head over frozen EEG features, asked each question by a question number, a label template or a natural-language description: SSVEP on BETA, sleep on BOAS. Seen questions, rewordings and questions the EEG head was never trained on are reported apart, never as one zero-shot number.',
    designEyebrow: 'How the comparison works',
    designH2: 'One head, three ways to ask',
    designLede: 'The same small head answers every question; only the vector that tells it which question changes. Every test is on people the head never trained on.',
    arms: [
      ['ID', 'question number', 'a one-hot code for each question the head was trained on. It cannot ask anything new.'],
      ['TPL', 'label template', 'a sentence frame filled with the label’s name, turned into a vector by a frozen text encoder.'],
      ['DESC', 'description', 'a sentence that describes the state without naming it, turned into a vector the same way.'],
      ['SHUF', 'shuffled templates', 'the template vectors attached to the wrong questions during training, by derangements declared in advance: a control for whether the head uses the link between a wording and its question.'],
      ['NUM', 'numeric code', 'for SSVEP, the frequency given as numbers, not words: a control without text.'],
      ['B-sh', 'one output per question', 'the same hidden layer with a fixed output per seen question, as in route 2; it cannot ask anything new either.'],
      ['CCA', 'no training', 'for SSVEP, canonical correlation analysis, which needs no training and can name any frequency: the reference an unseen frequency is held to.'],
    ] as [string, string, string][],
    exampleFrame: 'A training frame for sleep, filled with a stage’s name:',
    matching: 'SSVEP on BETA: a plain spectrum (L0) and frozen CBraMod features (L1). Sleep on BOAS: frozen CBraMod features (L1). Three training seeds each. The primary text encoder is bge-small-en-v1.5, frozen. The head is the same for every arm: standardised features, a small hidden layer adjusted by the question vector (FiLM), one output.',
    kinds: 'Three kinds of result, never pooled into one zero-shot number: a seen question in the wording the head trained with; the same question reworded; and a question the head never trained on. “Unseen” always means unseen by the EEG head, not by the text encoder: the frozen encoder has read the words, and for SSVEP every token of a held-out frequency also occurs in that rotation’s training texts. Unseen sleep questions are combinations of seen stages; unseen SSVEP questions are flicker frequencies held out in five rotations.',
    reading: `Each comparison is the language arm minus the reference, in percentage points (pp), with a 95% interval from resampling people, then training seeds, then held-out wordings. It gets two readings, both fixed before any fit. A difference is shown when the interval excludes zero. Against a margin of ±${DELTA} pp, it is equivalent when the whole interval lies inside, non-inferior when the bound against the language arm stays within the margin, and otherwise the margin is not met, which is not the same as a loss of ${DELTA} pp or more. For an unseen sleep question the comparison is R, the head’s remaining error (1 − AUROC) over that of the read-off from its own stage answers, with a margin of R < ${RATIO}. The check of whether the head uses the link between wording and stage, the template arm against the shuffled templates, is a difference of AUROC. Among the primary comparisons, those with the numeric code, the neighbour average and the shuffled templates are read for a difference only; the secondary tables print both readings as the run computed them.`,
    multiplicity: (): Part[] => ['There are ', n(R3.primary.entries_count), ' pre-declared primary comparisons and no multiplicity correction, so at 95% about one in twenty comparisons with no true difference may show one by chance. Accuracy is averaged per person, then over people: it compares set-ups and is not a deployment error rate.'],
