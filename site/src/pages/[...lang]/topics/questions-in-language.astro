    s6Caption: (): Part[] => ['每个否定问法对被否定问题真值的 AUROC，旁边是 1 − p(X) 的 AUROC，也就是把分类头对 X 的回答反过来；三个随机种子。“非 REM 睡眠”按“不是 REM”的真值评分。'],
    colNegated: '对被否定问题真值的 AUROC', colOneMinus: '1 − p(X) 的 AUROC', colPeople: '被试',
    s6Reading: '每一个否定问法，都被当成在问 X 本身：它对被否定问题真值的 AUROC 远低于 0.5，而把分类头对 X 的回答反过来，本可以答得很好。多写提示词并不能提供信号层面的真值。',
    woEyebrow: '随结果一并发布',
    woH2: '问法、留出频率与错位排列',
    wo: (): Part[] => ['提问所用的全部 ', qlwFig(qlwRelease.texts, 'count'), ' 条文本，英文与中文，涵盖睡眠、SSVEP 和运动想象：训练与留出的句式、标签名称与同义词、描述、未见问题的名称与描述，以及否定句式。两个代理在任何评分之前按固定说明写成，第二个代理在没有看到第一个代理文件的情况下写了全部留出描述；它们不是用户写的问法，也没有调优。文件中还有它们通过的防泄漏规则、每种轮换的留出频率与外推频段、错配对照预先声明的错位排列、频率的数值编码，以及固定版本的文本编码器。只有文本，'],
    woDownload: '问法文件（JSON）↓',
    synTable: '训练句式中各睡眠分期的名称，以及每个名称改写时所用的三个同义词（英文原文）：',
    colCanonical: '训练名称', colSynonyms: '同义词（a2）',
    limitsH2: '这些结果能说明什么、不能说明什么',
    notRunH3: '没有运行与没有报告的内容',
    notPubH3: '不发布的内容',
    notPub: ['逐人、逐夜、逐条记录与逐折的数值，逐窗口得分，特征，分类头权重，以及交叉验证折的分配。',
      'SSVEP 按频率与仅内部频率的细分：在审计之后计算，审计没有覆盖。',
      '运行前检查的数值：这些检查只以通过或失败及计数发布。',
      '实测的计算量：是在共享 GPU 上计时的。',
      '人口学信息、记录日期与钟点，以及任何真实记录的图像。'],
    encodersH3: '文本编码器',
    encodersNote: '固定在指定的提交版本，冻结使用，从不再分发。',
    creditsH3: '所用的记录',
    boasCreditNote: '在说明三处缺口后发布，缺口与结果一起列在上文。',
    mirrorNote: '基于 2026-09-20 获取的清华 BCI 实验室作者官方镜像快照计算；该镜像本身没有单独的 DOI 或版本号。',
    featuresNote: ['特征：冻结的 ', 'CBraMod', '（主分析），以及冻结的 ', 'REVE', ` Large @ ${reveVersion}，即 REVE-L（次要分析）。`],
    litH3: '这些结果所依据的方法与来源',
    sourceLink: '来源 ↗', paperLink: '论文 ↗',
    dataSource2: '问法：',
  },
}[locale];
const card = topicCards[locale]['questions-in-language'];
const sep = zh ? '：' : ': ';
const nameOf = (a: string) => copy.arms.find(x => x[0] === a)?.[1] ?? a;
const frameExample = sleepFrames[0].replace('{label}', sleepCanon.N2);
const credits = (['beta', 'boas', 'eesm19', 'openbmi', 'wearable-ssvep-102'] as const).map(id => ({ id, ...QL_DATASETS[id] }));
// The one record computed from an author mirror says so (the handoff: disclose the 2026-09-20 author mirror); the English is the export's.
need(credits.filter(c => c.computed_from).map(c => c.id).join() === 'wearable-ssvep-102' && QL_DATASETS['wearable-ssvep-102'].computed_from === `Official Tsinghua BCI Lab author mirror snapshot acquired 2026-09-20; the mirror itself has no separate DOI or version number.`
  && !!QL_DATASETS['wearable-ssvep-102'].paper?.includes('10.3390/s21041256'), 'Wearable-102: its Sensors paper and the author mirror it was computed from');
const entryKeyOrder = (p: string) => (S(p).entries ?? []);
---
<TopicLayout
  locale={locale}
  title={card.title}
  description={copy.description}
  path="/topics/questions-in-language/"
  eyebrow={copy.eyebrow}
  dek={copy.dek}
  activeSlug="questions-in-language"
  dataFiles={[`/data/${QL}`, `/data/${QLW}`]}
  answer={copy.answer}
>
  <section class="topic-section" id="design" aria-labelledby="design-heading">
    <div class="topic-heading"><div><p class="eyebrow">{copy.designEyebrow}</p><h2 id="design-heading">{copy.designH2}</h2></div><p>{copy.designLede}</p></div>
    <ul class="rd-rules sr-setups">{copy.arms.map(([id, name, what]) => <li data-arm={id}><strong><span lang="en">{id}</span> · {name}</strong>{sep}{what}</li>)}</ul>
    <p class="roadmap-p">{copy.exampleFrame} <q lang="en">{frameExample}</q></p>
    <p class="roadmap-p">{copy.matching}</p>
    <p class="roadmap-p" data-kinds="true">{copy.kinds}</p>
    <p class="roadmap-p">{copy.reading}</p>
    <p class="protocol-note" id="multiplicity"><Parts p={copy.multiplicity()}/></p>
    <p class="protocol-note" data-jev-style="true">{copy.routeOf[0]}<a href={`${hrefFor('/topics/when-not-to-act/', locale)}#decision-research`}>{copy.routeOf[1]}</a>{copy.routeOf[2]}{jevStyle[locale]}{copy.originOf[0]}<a href={visualJev.url} target="_blank" rel="noreferrer" lang="en">{visualJev.cite} ↗</a>{copy.originOf[1]}{zh ? '' : ' '}{copy.hubLead}<a href={hrefFor('/jev-style/', locale)}>{copy.hubLink}</a></p>
  </section>

  <section class="topic-section" id="seen" aria-labelledby="seen-heading" data-boas="true">
    <div class="topic-heading"><div><p class="eyebrow">{copy.seenEyebrow}</p><h2 id="seen-heading">{copy.seenH2}</h2></div><p><Parts p={copy.seenLede()}/></p></div>
    <BoasGaps locale={locale}/>
    <h3 class="roadmap-h3" id="p1">{copy.p1H3}</h3>
    <div class="finding" data-finding="p1">
      <div class="finding-number"><strong><Fig f={pp(t0.estimate)}/></strong><span>{copy.p1Label}</span></div>
      <div class="finding-copy"><h3>{copy.p1FindH3}</h3><p><Parts p={copy.p1Find()}/></p></div>
    </div>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.p1Region}>
      <table data-ql-table="p1">
        <caption><Parts p={copy.p1Caption()}/></caption>
        <thead><tr><th scope="col">{copy.colComparison}</th><th scope="col">{copy.colAsked}</th><th scope="col">{copy.colDiff}</th><th scope="col">{copy.colShown}</th><th scope="col">{copy.colMargin}</th><th scope="col">{copy.colGate}</th></tr></thead>
        <tbody>{[['P-ssvep-L0', [t0, d0]], ['P-ssvep-L1', [t1, d1]], ['P-sleep-L1', [ts, ds]]].map(([b, rows]) => <>
          <tr class="subhead"><th colspan="6" scope="colgroup">{copy.sub[b as string]}</th></tr>
          {(rows as QlEntry[]).map(e => <QlRow e={e} locale={locale}/>)}
        </>)}</tbody>
      </table>
    </div>
    <p class="roadmap-p" data-reading="p1"><Parts p={copy.p1Reading()}/></p>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.levelsRegion}>
      <table data-ql-table="levels-beta">
        <caption><Parts p={copy.betaLevelsCaption()}/></caption>
        <thead><tr><th scope="col">{copy.colArm}</th><th scope="col">{copy.colL0}</th><th scope="col">{copy.colCc}</th><th scope="col">{copy.colL1}</th><th scope="col">{copy.colCc}</th></tr></thead>
        <tbody>{seenArms.map(a => <tr data-ql-level={`beta|${a}|seen_ba`}><th scope="row"><span lang="en">{a}</span><small>{nameOf(a)}</small></th>
          {[L0, L1].map(L => { const x = L(`${a} seen_ba`); return <><td><Fig f={f(x.estimate)} cls="metric"/><span class="interval">{tc.interval95} <Parts p={ivPct(x)}/></span></td><td><Fig f={f(x.chance_corrected!.estimate)} cls="metric"/></td></>; })}</tr>)}</tbody>
      </table>
    </div>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.levelsRegion}>
      <table data-ql-table="levels-boas">
        <caption><Parts p={copy.sleepLevelsCaption()}/></caption>
        <thead><tr><th scope="col">{copy.colArm}</th><th scope="col">{copy.colLevel}</th><th scope="col">{copy.colCc}</th><th scope="col">{copy.colLogLoss}</th></tr></thead>
        <tbody>{sleepArms.map(a => { const x = LS(`${a} seen_ba`), ll = LL[a]; return <tr data-ql-level={`boas|${a}|seen_ba`}><th scope="row"><span lang="en">{a}</span><small>{nameOf(a)}</small></th>
          <td><Fig f={f(x.estimate)} cls="metric"/><span class="interval">{tc.interval95} <Parts p={ivPct(x)}/></span></td><td><Fig f={f(x.chance_corrected!.estimate)} cls="metric"/></td>
          <td>{ll ? <><Fig f={f(ll.estimate, 'num3')} cls="metric"/><span class="interval">{tc.interval95} <Fig f={f(ll.interval_95[0], 'num3')}/>–<Fig f={f(ll.interval_95[1], 'num3')}/></span></> : <span data-null="true">—</span>}</td></tr>; })}</tbody>
      </table>
    </div>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.levelsRegion}>
      <table data-ql-table="stages-boas">
        <caption><Parts p={copy.stageCaption()}/></caption>
        <thead><tr><th scope="col">{copy.colArm}</th>{stages.map(s => <th scope="col"><span lang="en">{s}</span><small><Fig f={n(perStage[`ID ${s}`].people)}/> {copy.people}</small></th>)}</tr></thead>
        <tbody>{['ID', 'TPL', 'DESC'].map(a => <tr data-ql-level={`boas|${a}|stage-auroc`}><th scope="row"><span lang="en">{a}</span><small>{nameOf(a)}</small></th>{stages.map(s => { const x = perStage[`${a} ${s}`]; return <td><Fig f={a3(x.estimate)} cls="metric"/><span class="interval"><Parts p={ivA3(x)}/></span></td>; })}</tr>)}</tbody>
      </table>
    </div>

    <h3 class="roadmap-h3" id="p2">{copy.p2H3}</h3>
    <p class="roadmap-p">{copy.p2Lede}</p>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.p2Region}>
      <table data-ql-table="p2">
        <caption><Parts p={copy.p2Caption()}/></caption>
        <thead><tr><th scope="col">{copy.colComparison}</th><th scope="col">{copy.colAsked}</th><th scope="col">{copy.colDiff}</th><th scope="col">{copy.colShown}</th><th scope="col">{copy.colMargin}</th><th scope="col">{copy.colGate}</th></tr></thead>
        <tbody>{[['P-ssvep-L0', p2b.slice(0, 3)], ['P-ssvep-L1', p2b.slice(3)], ['P-sleep-L1', p2s]].map(([b, rows]) => <>
          <tr class="subhead"><th colspan="6" scope="colgroup">{copy.sub[b as string]}</th></tr>
          {(rows as QlEntry[]).map(e => <QlRow e={e} locale={locale}/>)}
        </>)}</tbody>
      </table>
    </div>
    <p class="roadmap-p" data-reading="p2"><Parts p={copy.p2Reading()}/></p>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.synRegion}>
      <table data-ql-table="synonyms">
        <caption><Parts p={copy.synCaption()}/></caption>
        <thead><tr><th scope="col">{copy.colSynonym}</th>{['P-ssvep-L0', 'P-ssvep-L1', 'P-sleep-L1'].map(b => <th scope="col">{copy.sub[b]}</th>)}</tr></thead>
        <tbody>{synonymKeys.map((k, i) => <tr data-ql-synonym={i + 1}><th scope="row">{copy.synonymN(i + 1)}</th>{['P-ssvep-L0', 'P-ssvep-L1', 'P-sleep-L1'].map(b => { const x = synonymOf(b, k); return <td><Fig f={pp(x.estimate)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={qlFig(x.interval_95[0], 'sgn2')}/> {tc.to} <Fig f={pp(x.interval_95[1])}/></span></td>; })}</tr>)}</tbody>
      </table>
    </div>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.flipRegion}>
      <table data-ql-table="flips">
        <caption><Parts p={copy.flipCaption()}/></caption>
        <thead><tr><th scope="col"></th>{copy.flipCols.map(c => <th scope="col">{c}</th>)}</tr></thead>
        <tbody>{Object.entries(flip).map(([k, x]) => <tr data-ql-flip={k}><th scope="row">{copy.flipRows[k]}</th>{[x.TPL.a1, x.TPL.a2, x.TPL.ref_training, x.DESC.a3, x.DESC.ref_training, x.between_ID_seeds].map(r => <td><Fig f={f(r.rate)} cls="metric"/></td>)}</tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="topic-section" id="unseen-sleep" aria-labelledby="unseen-sleep-heading" data-boas="true">
    <div class="topic-heading"><div><p class="eyebrow">{copy.usEyebrow}</p><h2 id="unseen-sleep-heading">{copy.usH2}</h2></div><p><Parts p={copy.usLede()}/></p></div>
    <BoasGaps locale={locale}/>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.namesCaption}>
      <table data-ql-table="names">
        <caption>{copy.namesCaption}</caption>
        <thead><tr><th scope="col">{copy.colQuestion}</th><th scope="col">{copy.colImplicit}</th><th scope="col">{copy.colExplicit}</th></tr></thead>
        <tbody>{unions.map(u => <tr><th scope="row">{u === 'asleep' ? (zh ? '睡着' : 'Asleep') : u === 'NREM' ? (zh ? 'N1、N2 或 N3 期睡眠' : 'N1, N2 or N3 sleep') : (zh ? '浅睡' : 'Light sleep')}</th>
          <td>{unseenNames[u].implicit ? <q lang="en">{unseenNames[u].implicit}</q> : copy.none}</td><td><q lang="en">{unseenNames[u].explicit}</q></td></tr>)}</tbody>
      </table>
    </div>
    <h3 class="roadmap-h3" id="p3">{copy.p3H3}</h3>
    <div class="finding" data-finding="p3">
      <div class="finding-number"><strong><Fig f={a2(rMax.r!.estimate)}/></strong><span>{copy.p3Label}</span></div>
      <div class="finding-copy"><h3>{copy.p3FindH3}</h3><p><Parts p={copy.p3Find()}/></p></div>
    </div>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.p3Region}>
      <table data-ql-table="p3">
        <caption><Parts p={copy.p3Caption()}/></caption>
        <thead><tr><th scope="col">{copy.colComparison}</th><th scope="col">{copy.colAsked}</th><th scope="col">{copy.colLogR}</th><th scope="col">{copy.colShown}</th><th scope="col">{copy.colMarginR}</th><th scope="col">{copy.colGate}</th></tr></thead>
        <tbody>{p3.map(e => <QlRow e={e} locale={locale}/>)}</tbody>
      </table>
    </div>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.aurocRegion}>
      <table data-ql-table="p3-auroc">
        <caption><Parts p={copy.aurocCaption()}/></caption>
        <thead><tr><th scope="col">{copy.colQuestion}</th><th scope="col">{copy.colWording}</th><th scope="col">{copy.colHead}</th><th scope="col">{copy.colReadoff}</th></tr></thead>
        <tbody>{p3Rows.map(({ q, w }) => { const h = auroc(`TPL unseen ${q} ${w}`), ro = S15[`${q} prior-corrected read-off (TPL)`]; return <tr data-ql-auroc={`${q}|${w}`}>
          <th scope="row">{zh ? { asleep: '睡着', NREM: 'N1、N2 或 N3 期睡眠', light: '浅睡' }[q] : { asleep: 'Asleep', NREM: 'N1, N2 or N3 sleep', light: 'Light sleep' }[q]}</th><td>{w === 'implicit' ? (zh ? '隐式名称' : 'implicit name') : (zh ? '显式名称' : 'explicit name')}</td>
          <td><Fig f={a3(h.estimate)} cls="metric"/><span class="interval">{tc.interval95} <Parts p={ivA3(h)}/></span></td><td><Fig f={a3(ro.estimate)} cls="metric"/><span class="interval">{tc.interval95} <Parts p={ivA3(ro)}/></span></td></tr>; })}</tbody>
      </table>
    </div>
    <p class="roadmap-p" data-reading="p3"><Parts p={copy.p3Reading()}/></p>
    <h3 class="roadmap-h3" id="p5">{copy.p5H3}</h3>
    <p class="roadmap-p">{copy.p5Lede}</p>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.p5Region}>
      <table data-ql-table="p5">
        <caption><Parts p={copy.p5Caption()}/></caption>
        <thead><tr><th scope="col">{copy.colComparison}</th><th scope="col">{copy.colAsked}</th><th scope="col">{copy.colDiffA}</th><th scope="col">{copy.colShown}</th><th scope="col">{copy.colMarginNone}</th><th scope="col">{copy.colGate}</th></tr></thead>
        <tbody>{[p5i, p5e].map(e => <QlRow e={e} locale={locale}/>)}</tbody>
      </table>
    </div>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.shufRegion}>
      <table data-ql-table="p5-auroc">
        <caption><Parts p={copy.shufCaption()}/></caption>
        <thead><tr><th scope="col">{copy.colQuestion}</th><th scope="col">{copy.colWording}</th><th scope="col">{copy.colTpl}</th><th scope="col">{copy.colShuf}</th></tr></thead>
        <tbody>{p3Rows.map(({ q, w }) => { const t = auroc(`TPL unseen ${q} ${w}`), s = auroc(`SHUF unseen ${q} ${w}`); return <tr data-ql-shuf={`${q}|${w}`}>
          <th scope="row">{zh ? { asleep: '睡着', NREM: 'N1、N2 或 N3 期睡眠', light: '浅睡' }[q] : { asleep: 'Asleep', NREM: 'N1, N2 or N3 sleep', light: 'Light sleep' }[q]}</th><td>{w === 'implicit' ? (zh ? '隐式名称' : 'implicit name') : (zh ? '显式名称' : 'explicit name')}</td>
          <td><Fig f={a3(t.estimate)} cls="metric"/><span class="interval">{tc.interval95} <Parts p={ivA3(t)}/></span></td><td><Fig f={a3(s.estimate)} cls="metric"/><span class="interval">{tc.interval95} <Parts p={ivA3(s)}/></span></td></tr>; })}</tbody>
      </table>
    </div>
    <p class="roadmap-p" data-reading="p5"><Parts p={copy.p5Reading()}/></p>
  </section>

  <section class="topic-section" id="unseen-frequency" aria-labelledby="unseen-frequency-heading">
    <div class="topic-heading"><div><p class="eyebrow">{copy.ufEyebrow}</p><h2 id="unseen-frequency-heading">{copy.ufH2}</h2></div><p><Parts p={copy.ufLede()}/></p></div>
    <div class="finding" data-finding="p4">
      <div class="finding-number"><strong><Fig f={pp(p4a[0].estimate)}/></strong><span>{copy.p4Label}</span></div>
      <div class="finding-copy"><h3>{copy.p4FindH3}</h3><p><Parts p={copy.p4Find()}/></p></div>
    </div>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.p4Region}>
      <table data-ql-table="p4">
        <caption><Parts p={copy.p4Caption()}/></caption>
        <thead><tr><th scope="col">{copy.colComparison}</th><th scope="col">{copy.colAsked}</th><th scope="col">{copy.colDiff}</th><th scope="col">{copy.colShown}</th><th scope="col">{copy.colMargin}</th><th scope="col">{copy.colGate}</th></tr></thead>
        <tbody>{[['P-ssvep-L0', p4a], ['P-ssvep-L1', p4b]].map(([b, rows]) => <>
          <tr class="subhead"><th colspan="6" scope="colgroup">{copy.sub[b as string]}</th></tr>
          {(rows as QlEntry[]).map(e => <QlRow e={e} locale={locale}/>)}
        </>)}</tbody>
      </table>
    </div>
    <p class="roadmap-p" data-reading="p4"><Parts p={copy.p4Reading()}/></p>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.u8Region}>
      <table data-ql-table="levels-unseen">
        <caption><Parts p={copy.u8Caption()}/></caption>
        <thead><tr><th scope="col">{copy.colArm}</th><th scope="col">{copy.colMetric}</th><th scope="col">{copy.colL0}</th><th scope="col">{copy.colCc}</th><th scope="col">{copy.colL1}</th><th scope="col">{copy.colCc}</th></tr></thead>
        <tbody>{levelRows.map(([a, m]) => <tr data-ql-level={`beta|${a}|${m}`}><th scope="row"><span lang="en">{a}</span><small>{nameOf(a)}</small></th><td><span lang="en">{m}</span></td>
          {[L0, L1].map(L => { const x = L(`${a} ${m}`); return <><td><Fig f={f(x.estimate)} cls="metric"/><span class="interval">{tc.interval95} <Parts p={ivPct(x)}/></span></td><td><Fig f={f(x.chance_corrected!.estimate)} cls="metric"/></td></>; })}</tr>)}</tbody>
      </table>
    </div>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.costRegion}>
      <table data-ql-table="costs">
        <caption><Parts p={copy.costCaption()}/></caption>
        <thead><tr><th scope="col">{copy.colCost}</th><th scope="col">{copy.colL0}</th><th scope="col">{copy.colL1}</th></tr></thead>
        <tbody>{costRows.map(k => <tr data-ql-cost={k}><th scope="row">{costName(k)}</th>{['P-ssvep-L0', 'P-ssvep-L1'].map(b => { const x = R3.descriptive[b].generalisation_costs![k]; return <td><Fig f={pp(x.estimate)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={qlFig(x.interval_95[0], 'sgn2')}/> {tc.to} <Fig f={pp(x.interval_95[1])}/></span></td>; })}</tr>)}</tbody>
      </table>
    </div>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.rotRegion}>
      <table data-ql-table="rotations">
        <caption><Parts p={copy.rotCaption()}/></caption>
        <thead><tr><th scope="col">{copy.colRotation}</th><th scope="col">{copy.colL0}</th><th scope="col">{copy.colL1}</th></tr></thead>
        <tbody>{rot(0).map(([k], i) => <tr data-ql-rotation={k}><th scope="row">{copy.rotation(k)}</th>{[rot(0)[i][1], rot(1)[i][1]].map(x => <td><Fig f={pp(x.estimate)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={qlFig(x.interval_95[0], 'sgn2')}/> {tc.to} <Fig f={pp(x.interval_95[1])}/></span></td>)}</tr>)}</tbody>
      </table>
    </div>
    <p class="protocol-note" data-not-published="per-frequency">{copy.perFreq}</p>
  </section>

  <section class="topic-section" id="checks" aria-labelledby="checks-heading">
    <div class="topic-heading"><div><p class="eyebrow">{copy.ckEyebrow}</p><h2 id="checks-heading">{copy.ckH2}</h2></div><p>{copy.ckLede}</p></div>
    <div class="protocol-note" data-disclosure="canary">
      <p><Parts p={copy.canary()}/></p>
      <p data-disclosure="revision-3"><Parts p={copy.rev3()}/></p>
      <p data-disclosure="revision-4"><Parts p={copy.rev4()}/></p>
      <p data-disclosure="revision-5"><Parts p={copy.rev5()}/></p>
      <p data-disclosure="directions"><Parts p={copy.directions()}/></p>
    </div>
    <p class="roadmap-p" data-disclosure="why"><Parts p={copy.why()}/></p>
    <p class="roadmap-p" data-disclosure="s0b-6"><Parts p={copy.s0b6()}/></p>
    <p class="roadmap-p" data-disclosure="ea-1">{copy.ea1}</p>
    <p class="roadmap-p" data-disclosure="numeracy"><Parts p={copy.numeracy()}/></p>
    <h3 class="roadmap-h3">{copy.gatesH3}</h3>
    <ul class="rd-rules" data-gates="true">{copy.gates().map(g => <li><Parts p={g}/></li>)}</ul>
    <p class="roadmap-p" data-audits="true"><Parts p={copy.audits()}/></p>
  </section>

  <section class="topic-section" id="secondary" aria-labelledby="secondary-heading">
    <div class="topic-heading"><div><p class="eyebrow">{copy.secEyebrow}</p><h2 id="secondary-heading">{copy.secH2}</h2></div><p data-disclosure="secondary">{copy.secLede}</p></div>
    <details class="rd-panel sr-panel">
      <summary>{copy.secSummary}</summary>
      {entryParts.map(p => <div class="ql-part" data-ql-part={p.part}>
        <h3 class="roadmap-h3"><Parts p={copy.partTitle[p.part](p.entries![0].people)}/></h3>
        {copy.partNote[p.part] && <p class="protocol-note">{copy.partNote[p.part]}</p>}
        <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.secRegion(p.part)}>
          <table data-ql-table={p.part}>
            <thead><tr><th scope="col">{copy.colComparison}</th><th scope="col">{copy.colAsked}</th><th scope="col">{copy.colDiffMixed}</th><th scope="col">{copy.colShown}</th><th scope="col">{copy.colMarginNone}</th><th scope="col">{copy.colGate}</th></tr></thead>
            <tbody>{entryKeyOrder(p.part).map(e => <QlRow e={e} locale={locale}/>)}</tbody>
          </table>
        </div>
      </div>)}
      {S8.map((p, i) => <div class="ql-part" data-ql-part={p.part}>
        <h3 class="roadmap-h3"><Parts p={copy.s8Title(i ? 'L1' : 'L0', (Object.values(p.rows!).find(r => 'estimate' in r) as QlRowT).people)}/></h3>
        <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.secRegion(p.part)}>
          <table data-ql-table={p.part}>
            <thead><tr><th scope="col">{copy.colComparison}</th><th scope="col">{copy.colDiff}</th><th scope="col">{copy.colShown}</th><th scope="col">{copy.colMargin}</th></tr></thead>
            <tbody>{Object.entries(p.rows!).map(([k, r]) => 'estimate' in r ? (() => { const { x, y } = rowXY(k, r); return <tr data-ql-row={`${p.part}|${k}`}>
              <th scope="row"><span lang="en">{k}</span></th>
              <td data-cell="estimate"><Parts p={rowEst(r)}/><span class="interval">{tc.interval95} <Parts p={iv(r)}/></span></td>
              <td data-cell="difference" data-flag={r.difference}>{differenceText({ ...r, label: k }, x, y, locale)}</td>
              <td data-cell="margin" data-flag={r.margin}>{marginText(r, x, locale)}</td></tr>; })()
              : <tr data-ql-row={`${p.part}|${k}`}><th scope="row"><span lang="en">{k}</span></th><td colspan="3" data-null="true">{copy.notDefined}</td></tr>)}</tbody>
          </table>
        </div>
      </div>)}
      <p class="protocol-note">{copy.s8Note}</p>
      <div class="ql-part" data-ql-part="S12">
        <h3 class="roadmap-h3"><Parts p={copy.s12Title(S12.by_sensor!.dry['TPL - CCA (12-way)'].people)}/></h3>
        <p class="protocol-note">{copy.s12Note}</p>
        <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.secRegion('S12')}>
          <table data-ql-table="S12">
            <thead><tr><th scope="col">{copy.colComparison}</th><th scope="col">{copy.colDiff}</th><th scope="col">{copy.colShown}</th><th scope="col">{copy.colMargin}</th></tr></thead>
            <tbody>{Object.entries(S12.by_sensor!).map(([sensor, rows]) => <>
              <tr class="subhead"><th colspan="4" scope="colgroup">{copy.sensor[sensor]}</th></tr>
              {Object.entries(rows).map(([k, r]) => { const { x, y } = rowXY(k, r); return <tr data-ql-row={`S12|${sensor}|${k}`}>
                <th scope="row"><span lang="en">{k}</span></th>
                <td data-cell="estimate"><Parts p={rowEst(r)}/><span class="interval">{tc.interval95} <Parts p={iv(r)}/></span></td>
                <td data-cell="difference" data-flag={r.difference}>{differenceText({ ...r, label: k }, x, y, locale)}</td>
                <td data-cell="margin" data-flag={r.margin}>{marginText(r, x, locale)}</td></tr>; })}
            </>)}</tbody>
          </table>
        </div>
      </div>
      {SX.map((p, i) => { const L = i ? 'L1' : 'L0', lv = p.levels as Record<string, any>; return <div class="ql-part" data-ql-part={p.part}>
        <h3 class="roadmap-h3"><Parts p={copy.sxTitle(L, (Object.values(p.rows!)[0] as QlRowT).people)}/></h3>
        <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.secRegion(p.part)}>
          <table data-ql-table={p.part}>
            <thead><tr><th scope="col">{copy.colComparison}</th><th scope="col">{copy.colDiff}</th><th scope="col">{copy.colShown}</th><th scope="col">{copy.colMargin}</th></tr></thead>
            <tbody>{Object.entries(p.rows!).map(([k, r]) => { const rr = r as QlRowT, { x, y } = rowXY(k, rr); return <tr data-ql-row={`${p.part}|${k}`}>
              <th scope="row"><span lang="en">{k}</span></th>
              <td data-cell="estimate"><Parts p={rowEst(rr)}/><span class="interval">{tc.interval95} <Parts p={iv(rr)}/></span></td>
              <td data-cell="difference" data-flag={rr.difference}>{differenceText({ ...rr, label: k }, x, y, locale)}</td>
              <td data-cell="margin" data-flag={rr.margin}>{marginText(rr, x, locale)}</td></tr>; })}</tbody>
          </table>
        </div>
        <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.secRegion(`${p.part} levels`)}>
          <table data-ql-table={`${p.part}-levels`}>
            <caption>{copy.sxLevelsTitle(L)}</caption>
            <thead><tr><th scope="col">{copy.colArm}</th><th scope="col">{copy.colRowSeen}</th><th scope="col">{copy.colRowUnseen}</th></tr></thead>
            <tbody>{['S9 TPL', 'S9 DESC', 'S9 SHUF', 'S9 NUM'].map(k => <tr data-ql-row={`${p.part}|${k}`}><th scope="row"><span lang="en">{k}</span></th>
              {(['seen_truth', 'unseen_truth'] as const).map(t => <td><Fig f={f(lv[k][t].estimate)} cls="metric"/><span class="interval">{tc.interval95} <Parts p={ivPct(lv[k][t])}/></span></td>)}</tr>)}
              <tr data-ql-row={`${p.part}|S10 NN(B-sh) (8-way)`}><th scope="row">{copy.nnBsh}</th><td colspan="2"><Fig f={f(lv['S10 NN(B-sh) (8-way)'].estimate)} cls="metric"/><span class="interval">{tc.interval95} <Parts p={ivPct(lv['S10 NN(B-sh) (8-way)'])}/></span></td></tr>
              {(['seen_ba', 'u8', 'u3'] as const).map(t => <tr data-ql-row={`${p.part}|S11 FBCCA ${t}`}><th scope="row">{copy.fbcca[t]}</th><td colspan="2"><Fig f={f(lv['S11 FBCCA levels'][t].estimate)} cls="metric"/><span class="interval">{tc.interval95} <Parts p={ivPct(lv['S11 FBCCA levels'][t])}/></span></td></tr>)}</tbody>
          </table>
        </div>
      </div>; })}
      <p class="protocol-note">{copy.s9Note}</p>

      <div data-boas="true" data-domain="boas">
        <h3 class="roadmap-h3">{copy.boasSecH3}</h3>
        <BoasGaps locale={locale}/>
        {boasEntryParts.map(p => <div class="ql-part" data-ql-part={p.part}>
          <h3 class="roadmap-h3"><Parts p={copy.partTitle[p.part](p.entries![0].people)}/></h3>
          <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.secRegion(p.part)}>
            <table data-ql-table={p.part}>
              <thead><tr><th scope="col">{copy.colComparison}</th><th scope="col">{copy.colAsked}</th><th scope="col">{copy.colDiffMixed}</th><th scope="col">{copy.colShown}</th><th scope="col">{copy.colMarginNone}</th><th scope="col">{copy.colGate}</th></tr></thead>
              <tbody>{entryKeyOrder(p.part).map(e => <QlRow e={e} locale={locale}/>)}</tbody>
            </table>
          </div>
        </div>)}
        <div class="ql-part" data-ql-part="S13-sleep">
          <h3 class="roadmap-h3"><Parts p={copy.s13Title((Object.values(S13.rows!)[0] as QlRowT).people)}/></h3>
          <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.secRegion('S13')}>
            <table data-ql-table="S13-sleep">
              <thead><tr><th scope="col">{copy.colComparison}</th><th scope="col">{copy.colLogR}</th><th scope="col">{copy.colShown}</th><th scope="col">{copy.colMarginR}</th></tr></thead>
              <tbody>{Object.entries(S13.rows!).map(([k, r]) => { const rr = r as QlRowT; return <tr data-ql-row={`S13-sleep|${k}`}>
                <th scope="row"><span lang="en">{k}</span></th>
                <td data-cell="estimate"><Parts p={rowEst(rr)}/><span class="interval">{tc.interval95} <Parts p={iv(rr)}/></span></td>
                <td data-cell="difference" data-flag={rr.difference}>{differenceText({ ...rr, label: k }, 'TPL', 'read-off', locale)}</td>
                <td data-cell="margin" data-flag={rr.margin}>{marginText(rr, 'TPL', locale)}</td></tr>; })}</tbody>
            </table>
          </div>
        </div>
        <div class="ql-part" data-ql-part="S6">
          <h3 class="roadmap-h3">{copy.s6Title}</h3>
          <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.secRegion('S6')}>
            <table data-ql-table="S6">
              <caption><Parts p={copy.s6Caption()}/></caption>
              <thead><tr><th scope="col">{copy.colWording}</th><th scope="col">{copy.colNegated}</th><th scope="col">{copy.colOneMinus}</th><th scope="col">{copy.colPeople}</th></tr></thead>
              <tbody>{negated.map(([k, c]) => { const a = c.negated_wording_auroc ?? c.auroc, b = c.one_minus_p_auroc ?? c.one_minus_p_REM_auroc; return <tr data-ql-row={`S6|${k}`}>
                <th scope="row"><span lang="en">{k}</span></th>
                <td><Fig f={a3(a.estimate)} cls="metric"/><span class="interval">{tc.interval95} <Parts p={ivA3(a)}/></span></td>
                <td><Fig f={a3(b.estimate)} cls="metric"/><span class="interval">{tc.interval95} <Parts p={ivA3(b)}/></span></td>
                <td><Fig f={n(a.people)} cls="metric"/></td></tr>; })}</tbody>
            </table>
          </div>
          <p class="roadmap-p" data-reading="S6">{copy.s6Reading}</p>
        </div>
      </div>
    </details>
  </section>

  <section class="topic-section" id="wordings" aria-labelledby="wordings-heading">
    <div class="topic-heading"><div><p class="eyebrow">{copy.woEyebrow}</p><h2 id="wordings-heading">{copy.woH2}</h2></div></div>
    <p class="roadmap-p" data-wordings="true"><Parts p={copy.wo()}/><a href={qlwRelease.licenseUrl} target="_blank" rel="noreferrer">{qlwRelease.license}</a>{zh ? '。' : '.'}</p>
    <p class="roadmap-p"><a class="button" href={`/data/${QLW}`} download>{copy.woDownload}</a></p>
    <p class="roadmap-p">{copy.synTable}</p>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.synTable}>
      <table data-ql-table="sleep-names">
        <thead><tr><th scope="col">{copy.colStage}</th><th scope="col">{copy.colCanonical}</th><th scope="col">{copy.colSynonyms}</th></tr></thead>
        <tbody>{stages.map(s => <tr><th scope="row"><span lang="en">{s}</span></th><td><q lang="en">{sleepCanon[s]}</q></td><td>{sleepSyn[s].map((w, i) => <>{i > 0 && (zh ? '、' : ', ')}<q lang="en">{w}</q></>)}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="topic-section" id="methods-and-limits" aria-labelledby="limits-heading">
    <div class="topic-heading"><div><p class="eyebrow">{tc.methodsEyebrow}</p><h2 id="limits-heading">{copy.limitsH2}</h2></div></div>
    <ul class="rd-rules sr-limits" data-limits="true">{limits.map(x => <li>{x.text}{x.original && <span class="note-original" lang="en">{x.original}</span>}</li>)}<li data-site-limit="not-a-language-model">{copy.notLanguage}</li></ul>
    <h3 class="roadmap-h3">{copy.notRunH3}</h3>
    <ul class="rd-rules sr-not-run">{notRun.map(([a, b]) => <li><strong>{a.text}</strong>{sep}{b.text}</li>)}</ul>
    <h3 class="roadmap-h3">{copy.notPubH3}</h3>
    <ul class="rd-rules" data-not-published="true">{copy.notPub.map(x => <li>{x}</li>)}</ul>
    <h3 class="roadmap-h3">{copy.encodersH3}</h3>
    <ul class="rd-rules" data-encoders="true">{Object.entries(R3.design.text_encoders).map(([id, x]) => <li><a href={`https://huggingface.co/${x.repo}`} target="_blank" rel="noreferrer" lang="en">{x.repo} ↗</a>{sep}{roleOf[id as 'bge'][locale]} · <span lang="en">{x.licence === 'mit' ? 'MIT' : x.licence === 'apache-2.0' ? 'Apache-2.0' : x.licence}</span> · <code>{x.commit.slice(0, 7)}</code></li>)}</ul>
    <p class="citation-note">{copy.encodersNote}</p>
    <h3 class="roadmap-h3">{copy.creditsH3}</h3>
    <div class="citation-list" id="credits">{credits.map(c => <article data-credit={c.id}>
      <h3 lang="en">{c.name}</h3>
      <p lang="en">{c.attribution}</p>
      {c.paper && <p lang="en">{c.paper}</p>}
      {c.computed_from && <p>{copy.mirrorNote}</p>}
      {c.id === 'boas' && <p>{copy.boasCreditNote}</p>}
      <p><a href={c.source} target="_blank" rel="noreferrer">{copy.sourceLink}</a> · <a href={c.licenseUrl} target="_blank" rel="noreferrer">{c.license}</a></p>
    </article>)}</div>
    <p class="citation-note">{copy.featuresNote[0]}<a href={hrefFor('/methods/cbramod/', locale)} lang="en">{copy.featuresNote[1]}</a>{copy.featuresNote[2]}<a href={hrefFor('/methods/reve/', locale)} lang="en">{copy.featuresNote[3]}</a>{copy.featuresNote[4]}</p>
    <p class="citation-note" data-reve-terms="true">{fmTermsSentence([REVE_L], locale)} <a href={REVE_L.paper} target="_blank" rel="noreferrer" lang="en">REVE, {REVE_L.paper.replace(/^https:\/\/arxiv\.org\/abs\//, 'arXiv:')} ↗</a></p>
    <h3 class="roadmap-h3">{copy.litH3}</h3>
    <ul class="rd-literature">{literature.map(x => <li lang="en" data-ref={x.id}><a href={x.url} target="_blank" rel="noreferrer">{x.cite} ↗</a></li>)}</ul>
    <p class="citation-note">{tc.dataSource} <a href={`/data/${QL}`} download>{QL}</a> · {tc.schema} {qlRelease.schema}{tc.period}</p>
    <p class="citation-note">{copy.dataSource2} <a href={`/data/${QLW}`} download>{QLW}</a> · {tc.schema} {qlwRelease.schema}{tc.period}</p>
  </section>
</TopicLayout>
