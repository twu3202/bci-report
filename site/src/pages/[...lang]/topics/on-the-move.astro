    phRegion: '按伪迹条件的头模源信号恢复结果，可横向滚动',
    phCaption: '先在每折内对 10 个脑源取中位数，再对 5 折取中位数。每种条件留出相同的 60 秒时间段，训练段两侧各剔除 2 秒。只在仅含脑源的记录上训练。',
    colCondition: '条件', colR: '带符号相关系数 r', colR2: '预测 R²',
    foldRange: (a: string, b: string) => `各折范围 ${a} 至 ${b}`,
    phCond: { Brain: '仅脑源', Eyes: '眼动伪迹', Walking: '行走', Neck: '颈部肌电', Facial: '面部肌电', All: '全部伪迹同时出现' } as Record<string, string>,
    phCondNote: { Brain: '训练条件，留出时间段' } as Record<string, string>,
    phUnit: '一个导电的物理头模；不涉及任何真人被试。',
    phDataset: 'OpenNeuro 数据集 ↗', phMethod: '方法论文 ↗',
    gEyebrow: '跑步机速度 · 干电极',
    gH2: '步行速度分数可能在测什么',
    gLede: `${gc.people_scored} 名被试以三种速度在跑步机上行走，同时用干电极头戴设备记录 ${gc.scalp_channels} 个头皮通道。一个固定分类器根据每段完整的 ${gc.seconds_per_recording} 秒记录判断行走速度。另一个分类器完全看不到 EEG 的频谱模式，只拿到三个与运动相关的干扰特征：幅值、低频功率和工频功率。随机水平为 ${pct(gaitData.chance_level)}。`,
    gFindingLabel: `干扰特征减频谱频带，同一批 ${gc.people_scored} 名被试`,
    gFindingH3: gGap > 0 ? '干扰特征的分数更高' : '频谱频带的分数更高',
    gFindingP: `${pct(gNuis.balanced_accuracy)} 对 ${pct(gSpec.balanced_accuracy)}。${gOverlap ? `两者的区间有重叠（${gIv(gNuis)} 和 ${gIv(gSpec)}），所以谁更高并没有定论。` : ''}能确定的是：从行走时的 EEG 得到一个速度分数，并不需要神经解读所依赖的那种频谱模式。单凭这样一个分数，不能说明解码到了大脑活动。`,
    gRegion: '有无频谱 EEG 时的步行速度分类，可横向滚动',
