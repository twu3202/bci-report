---
import clinical from '../../../data/clinical-update.json';
import TopicLayout from '../../../components/TopicLayout.astro';
import ScoreBar from '../../../components/ScoreBar.astro';
import IntervalPlot from '../../../components/IntervalPlot.astro';
import { intervalPct, pct, pp } from '../../../data/topics';
import { localeOf, localeParams, topicCards, topicChrome } from '../../../data/i18n';

export const getStaticPaths = localeParams;
const locale = localeOf(Astro.params.lang);
const tc = topicChrome[locale];

// Only the source with a recorded `aggregate_preview` decision has a result
// here. The two status-only sources of this batch carry no numbers at all;
// they are listed on the home page instead, where holds belong.
const c = clinical.results.ds004584;
const byId = Object.fromEntries(c.models.map(m => [m.id, m]));
const eeg = byId.spectral_logistic, demo = byId.demographics_only;
const gap = eeg.mean_balanced_accuracy - demo.mean_balanced_accuracy;
// Descriptive intervals, and they very nearly touch. Say which it is.
const overlap = eeg.balanced_accuracy_bootstrap_95[0] <= demo.balanced_accuracy_bootstrap_95[1];
const n = (v: number) => v.toLocaleString('en-US');
const auroc = (v: number) => v.toFixed(2);
const basis = c.rights.reviewBasis;
// Figures the short answer and the key figure name. All from the reviewed export.
const people = c.cohort.people;
const eegCi = eeg.balanced_accuracy_bootstrap_95 as [number, number];
const demoCi = demo.balanced_accuracy_bootstrap_95 as [number, number];
const chance = pct(c.chance_level, 0);

const copy = {
  en: {
    description: `Above chance, at the group level, at one site: across ${people} people, a resting-state spectral model separated Parkinson's disease from controls at ${pct(eeg.mean_balanced_accuracy)} balanced accuracy; an age-and-sex comparator with no EEG reached ${pct(demo.mean_balanced_accuracy)}. It is not a diagnosis.`,
    answer: `Above chance, as a group-level research result from one site. Across [[${people}]] people with Parkinson's disease or in the control group, a relative-spectrum logistic regression on resting-state EEG separated the two groups at [[${pct(eeg.mean_balanced_accuracy)}]] balanced accuracy (95% interval [[${intervalPct(eegCi)}]], AUROC [[${auroc(eeg.auroc)}]], chance [[${chance}]]); a comparator given only age and sex reached [[${pct(demo.mean_balanced_accuracy)}]] ([[${intervalPct(demoCi)}]]) on the same folds.`,
    plotCaption: `The same ${people} people and the same ${c.cohort.folds} folds.`,
    plotLegend: `Person-level balanced accuracy, Parkinson's disease against controls. Dot: the estimate; line: descriptive bootstrap 95% interval; dashed line: chance, ${chance}.`,
    plotRows: { eeg: 'Relative-spectrum logistic regression', demo: 'Age-and-sex comparator' },
    plotNotes: { eeg: 'resting-state EEG', demo: 'no EEG input' },
    eyebrow: 'Clinical research · resting-state EEG',
    dek: `Parkinson's disease against controls, person by person: a spectral model on resting-state EEG, and a comparator given only age and sex.`,
    findingLabel: `EEG minus the age-and-sex comparator, same ${c.cohort.people} people`,
    findingH3: overlap ? 'A higher mean, with overlapping intervals' : 'The EEG model scores above a model with no EEG',
    findingP: `The EEG model's interval starts at ${pct(eegCi[0])}; the comparator's ends at ${pct(demoCi[1])}.`,
    tableEyebrow: 'EEG model and comparator',
    tableH2: 'EEG against age and sex',
    tableLede: `Two classes, chance ${pct(c.chance_level, 0)}; ${c.cohort.folds} stratified participant folds.`,
    tableRegion: 'Clinical case and control results, scrolls horizontally',
    caption: 'Person-level balanced accuracy with its 95% interval, macro F1 and AUROC.',
    colModel: 'Row', colInputs: 'Inputs', colBa: 'Balanced accuracy', colF1: 'Macro F1', colAuroc: 'AUROC',
    comparatorNote: 'not an EEG model',
    eegNote: 'log relative band power, 60 shared channels',
    modelLabel: { spectral_logistic: 'Relative-spectrum logistic regression', demographics_only: 'Age and sex only' } as Record<string, string>,
    inputLabel: { 'EEG only': 'EEG only', 'no EEG': 'no EEG' } as Record<string, string>,
    baLabel: (v: string) => `${v} balanced accuracy`,
    covEyebrow: 'Cohort and features',
    covH2: 'One site, 149 people, two minutes each',
    covLede: 'The 60 named channels shared by four source layouts; the first 120 seconds of each recording, cut into 30 disjoint four-second windows; log relative power in five bands spanning 1–45 Hz. Each person\'s 300 features are averaged within that person, so the classifier sees one vector per person rather than 4,470 independent examples. Scaling is fitted on training folds only, the classifier is a fixed balanced logistic regression (C=1), and there is one split seed with no held-out tuning.',
    covPeople: 'People', covPeopleOf: c.cohort.composition,
    covFolds: 'Participant folds', covFoldsOf: 'each person held out once',
    covWindows: 'Four-second windows', covWindowsOf: 'averaged within each person',
    limitsH2: 'Limits',
    limits: [
      ['Not a diagnosis', 'Group-level discrimination on a fixed research split, reported as balanced accuracy. Screening, clinical validation and interpretation for any individual person are outside its scope.'],
      ['Not replicated', 'One cohort, one split seed. The intervals are descriptive bootstrap ranges, because the cross-validation training folds overlap.'],
      ['Age and sex are not removed', 'The comparator shows that part of this separation is available with no brain signal at all. The EEG model is not adjusted for age or sex, so its score is not a measure of disease-specific brain activity.'],
      ['Group differences are not only in the brain', 'Anything that differs between patients and controls travels with the labels: medication, recording session, movement, alertness. A case/control score cannot separate those from the disease.'],
      ['Foundation models: held', 'The source states no physical amplitude unit. A relative spectrum needs none; models that need a calibrated scale are held.'],
      
    ],
    auditH3: 'Independently replayed',
    auditP: `${c.independent_audit.replayed}. Reconstructed features and metrics differed by ${c.independent_audit.maximum_metric_difference}; intervals differed at floating-point precision.`,
    consent: 'Every participant gave written informed consent, with decisional capacity established, in accordance with the Declaration of Helsinki; all research protocols were approved by the University of Iowa Human Subjects Review Board (IRB 201707828). Only cohort aggregates appear here: no participant rows, no clinical or cognitive scores, and no per-group age or sex composition.',
    datasetLink: 'OpenNeuro dataset ↗', paperLink: 'Cohort study ↗', manuscriptLink: 'Open manuscript ↗', mirrorLink: 'NEMAR mirror ↗',
    disclaimer: null as string | null, disclaimerOriginal: '',
  },
  zh: {
    description: `组层面、单中心的结果，高于随机水平：在 ${people} 名被试上，静息态频谱模型区分帕金森病与对照的平衡准确率为 ${pct(eeg.mean_balanced_accuracy)}；完全不用 EEG 的年龄性别对照基线为 ${pct(demo.mean_balanced_accuracy)}。这不是诊断。`,
    answer: `高于随机水平；这是单中心、组层面的研究结果。在 [[${people}]] 名被试（帕金森病患者与对照）的静息态 EEG 上，相对频谱逻辑回归区分两组的平衡准确率为 [[${pct(eeg.mean_balanced_accuracy)}]]（95% 区间 [[${intervalPct(eegCi)}]]，AUROC [[${auroc(eeg.auroc)}]]，随机水平 [[${chance}]]）；只用年龄和性别的对照基线在同样的折上为 [[${pct(demo.mean_balanced_accuracy)}]]（[[${intervalPct(demoCi)}]]）。`,
    plotCaption: `同一批 ${people} 名被试、同样的 ${c.cohort.folds} 折。`,
    plotLegend: `帕金森病对对照的被试级平衡准确率。点为估计值，横线为描述性 bootstrap 95% 区间，虚线为随机水平（${chance}）。`,
    plotRows: { eeg: '相对频谱逻辑回归', demo: '年龄性别对照基线' },
    plotNotes: { eeg: '静息态 EEG', demo: '不用 EEG' },
    eyebrow: '临床研究 · 静息态 EEG',
    dek: `逐名被试区分帕金森病与对照：一个基于静息态 EEG 的频谱模型，以及一个只用年龄和性别的对照基线。`,
    findingLabel: `EEG 减去年龄性别基线，同一批 ${c.cohort.people} 名被试（pp 为百分点）`,
    findingH3: overlap ? '均值更高，但区间有重叠' : 'EEG 模型高于完全不用 EEG 的模型',
    findingP: `EEG 模型的区间从 ${pct(eegCi[0])} 起，对照基线的区间到 ${pct(demoCi[1])} 止。`,
    tableEyebrow: 'EEG 模型与对照基线',
    tableH2: 'EEG 对年龄和性别',
    tableLede: `二分类，随机水平 ${pct(c.chance_level, 0)}；${c.cohort.folds} 折分层被试交叉验证。`,
    tableRegion: '临床病例与对照结果，可横向滚动',
    caption: '被试级平衡准确率及其 95% 区间、宏平均 F1 与 AUROC。',
    colModel: '行', colInputs: '输入', colBa: '平衡准确率', colF1: '宏平均 F1', colAuroc: 'AUROC',
    comparatorNote: '不是 EEG 模型',
    eegNote: '对数相对频带功率，60 个共有通道',
    modelLabel: { spectral_logistic: '相对频谱逻辑回归', demographics_only: '只用年龄和性别' } as Record<string, string>,
    inputLabel: { 'EEG only': '只用 EEG', 'no EEG': '不用 EEG' } as Record<string, string>,
    baLabel: (v: string) => `平衡准确率 ${v}`,
    covEyebrow: '队列与特征',
    covH2: '单中心，149 名被试，每人两分钟',
    covLede: '四种源通道布局共有的 60 个命名通道；取前 120 秒，切成 30 个互不重叠的 4 秒窗；在 1–45 Hz 的五个频带上取对数相对功率。每名被试的 300 个特征在被试内取平均，因此分类器看到的是每人一个向量，而不是 4,470 个独立样本。标准化只用训练折拟合，分类器是固定的平衡 L2 逻辑回归（C=1）；单一划分种子，没有留出调参。',
    covPeople: '被试', covPeopleOf: '100 名帕金森病被试与 49 名对照，单中心',
    covFolds: '分层被试折', covFoldsOf: '每名被试留出一次',
    covWindows: '4 秒窗', covWindowsOf: '在被试内取平均',
    limitsH2: '局限',
    limits: [
      ['不是诊断', '固定研究划分下的组层面区分，用平衡准确率报告。筛查、临床验证以及对任何具体个人的解读，都不在它的范围之内。'],
      ['没有被重复验证', '单队列、单一划分种子。区间是描述性的 bootstrap 范围，因为交叉验证的训练折彼此重叠。'],
      ['没有扣除年龄和性别', '对照基线说明，这种区分有一部分完全不需要脑信号就能做到。EEG 模型并没有对年龄、性别做校正，所以它的分数不能当作疾病特异的脑活动的度量。'],
      ['组间差异不只在大脑里', '凡是患者与对照之间不同的东西，都会跟着标签一起进入模型：用药、记录场次、身体活动、清醒程度。病例对照分数无法把这些与疾病本身分开。'],
      ['基础模型：暂缓', '数据源没有说明物理幅值单位。相对频谱不需要这个单位；需要标定幅值的模型暂缓。'],
      
    ],
    auditH3: '经过独立复算',
    auditP: `独立复算了全部 149 份原始记录与 4,470 个频谱窗，使用另一套 FFT 实现，并重新拟合了全部分类器。重建的特征与指标差异为 ${c.independent_audit.maximum_metric_difference}；区间的差异在浮点精度量级。`,
    consent: '每名被试都签署了书面知情同意，并确认具备决策能力，符合《赫尔辛基宣言》；全部研究方案经爱荷华大学机构审查委员会批准（IRB 201707828）。这里只发布队列级聚合结果：没有逐人记录，没有临床或认知量表分数，也不发布各组的年龄与性别构成。',
    datasetLink: 'OpenNeuro 数据集 ↗', paperLink: '队列研究论文 ↗', manuscriptLink: '公开手稿 ↗', mirrorLink: 'NEMAR 镜像 ↗',
    // The released file's medical_disclaimer, in Chinese. The most safety-relevant
    // sentence on the page was the one left in English; the original stays beside it.
    disclaimer: '公开数据集上的研究结果：不是诊断，不是诊断准确率，也不是医疗器械或医疗建议。' as string | null, disclaimerOriginal: '英文原文：',
  },
}[locale];
const card = topicCards[locale]['clinical-groups'];
const rows = [
  { m: eeg, note: copy.eegNote, tone: 'rust' as const },
  { m: demo, note: copy.comparatorNote, tone: 'ink' as const },
];
---
<TopicLayout
  locale={locale}
  title={card.title}
  description={copy.description}
  path="/topics/clinical-groups/"
  eyebrow={copy.eyebrow}
  dek={copy.dek}
  activeSlug="clinical-groups"
  dataFiles={['/data/clinical-update.json']}
  answer={copy.answer}
>
  <IntervalPlot
    caption={copy.plotCaption}
    legend={copy.plotLegend}
    domain={[0, 1]}
    ticks={['0%', '25%', '50%', '75%', '100%']}
    reference={c.chance_level}
    rows={[
      { m: eeg, ci: eegCi, label: copy.plotRows.eeg, note: copy.plotNotes.eeg, tone: 'rust' as const },
      { m: demo, ci: demoCi, label: copy.plotRows.demo, note: copy.plotNotes.demo, tone: 'ink' as const },
    ].map(({ m, ci, label, note, tone }) => ({ label, note, tone, value: m.mean_balanced_accuracy, interval: ci, text: `${pct(m.mean_balanced_accuracy)} (${intervalPct(ci)})` }))}
  />
  <section class="topic-section" aria-labelledby="clinical-finding">
    <div class="finding">
      <div class="finding-number"><strong>{pp(gap, 1)}</strong><span>{copy.findingLabel}</span></div>
      <div class="finding-copy"><h3 id="clinical-finding">{copy.findingH3}</h3><p>{copy.findingP}</p></div>
    </div>
    <p class="protocol-note">{copy.disclaimer ? <>{copy.disclaimer}<span class="protocol-note-original">{copy.disclaimerOriginal}<span lang="en">{clinical.medical_disclaimer}</span></span></> : clinical.medical_disclaimer}</p>
    <div class="topic-heading"><div><p class="eyebrow">{copy.tableEyebrow}</p><h2>{copy.tableH2}</h2></div><p>{copy.tableLede}</p></div>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.tableRegion}>
      <table>
        <caption>{copy.caption}</caption>
        <thead><tr><th scope="col">{copy.colModel}</th><th scope="col">{copy.colInputs}</th><th scope="col">{copy.colBa}</th><th scope="col">{copy.colF1}</th><th scope="col">{copy.colAuroc}</th></tr></thead>
        <tbody>{rows.map(r => <tr><th scope="row">{copy.modelLabel[r.m.id]}<small>{r.note}</small></th><td>{copy.inputLabel[r.m.inputs]}</td><td><span class="metric">{pct(r.m.mean_balanced_accuracy)}</span><span class="interval">{intervalPct(r.m.balanced_accuracy_bootstrap_95 as [number, number])}</span><ScoreBar value={r.m.mean_balanced_accuracy} label={copy.baLabel(pct(r.m.mean_balanced_accuracy))} tone={r.tone} /></td><td><span class="metric">{pct(r.m.macro_f1)}</span></td><td><span class="metric">{auroc(r.m.auroc)}</span></td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section class="topic-section" aria-labelledby="clinical-coverage">
    <div class="topic-heading"><div><p class="eyebrow">{copy.covEyebrow}</p><h2 id="clinical-coverage">{copy.covH2}</h2></div><p>{copy.covLede}</p></div>
    <div class="evidence-grid">
      <article class="evidence-card"><p class="eyebrow">{copy.covPeople}</p><div class="reading">{c.cohort.people}</div><p>{copy.covPeopleOf}</p></article>
      <article class="evidence-card"><p class="eyebrow">{copy.covFolds}</p><div class="reading">{c.cohort.folds}</div><p>{copy.covFoldsOf}</p></article>
      <article class="evidence-card"><p class="eyebrow">{copy.covWindows}</p><div class="reading">{n(c.cohort.windows)}</div><p>{copy.covWindowsOf}</p></article>
    </div>
  </section>

  <section class="topic-section" id="methods-and-limits" aria-labelledby="clinical-limits">
    <div class="topic-heading"><div><p class="eyebrow">{tc.methodsEyebrow}</p><h2 id="clinical-limits">{copy.limitsH2}</h2></div></div>
    <div class="method-grid-wide">{copy.limits.map(([h, p]) => <article><h3>{h}</h3><p>{p}</p></article>)}</div>
    <div class="citation-list">
      <article><h3>{copy.auditH3}</h3><p>{copy.auditP}</p></article>
      <article><h3 lang="en">{c.rights.name}</h3><p lang="en">{c.rights.attribution}</p><p>{copy.consent}</p><p><a href={basis[0]} target="_blank" rel="noreferrer">{copy.datasetLink}</a> · <a href={basis[1]} target="_blank" rel="noreferrer">{copy.paperLink}</a> · <a href={basis[2]} target="_blank" rel="noreferrer">{copy.manuscriptLink}</a> · <a href={basis[3]} target="_blank" rel="noreferrer">{copy.mirrorLink}</a> · <a href={c.rights.licenseUrl} target="_blank" rel="noreferrer">{c.rights.license}</a></p></article>
    </div>
    <p class="citation-note">{tc.dataSource} <a href="/data/clinical-update.json" download>{tc.reviewedAggregate}</a> · {tc.schema} {clinical.schema_version}{tc.period}</p>
  </section>
</TopicLayout>
