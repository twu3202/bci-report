    to: ' to ',
    secondaryH3: 'Secondary panel, apart',
    secondaryLede: (): Part[] => ['The ', cn(MS.record_ids), ' record IDs whose first run was excluded (', cn(MS.runs), ' runs, ', cn(MS.trials), ' trials): ', said(MS.design).text, '. ', said(MS.text).text],
    secondaryRegion: 'MIND, secondary panel, scrolls horizontally',
    coverageH3: 'From the runs in the release to the two panels',
    coverageRegion: 'MIND coverage, scrolls horizontally',
