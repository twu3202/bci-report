    armsRegion: 'Shin2022, three arms, scrolls horizontally',
    armsCaption: (): Part[] => ['Participant-mean balanced accuracy: the ', n(shin.scope.participants), ' held-out participants’ balanced accuracies averaged with equal weight, with its 95% participant-bootstrap interval. The pooled value counts every signal-valid window together: a secondary figure, without an interval.'],
    cols: ['Arm', 'Participant-mean balanced accuracy', 'Pooled (secondary)', 'What it reads'],
