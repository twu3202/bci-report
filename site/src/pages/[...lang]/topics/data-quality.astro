    licenceCols: ['Source', 'Licence as stated', 'How it was read'],
    gapsH: 'Gaps:',
    // The one-person cases
    onePersonEyebrow: 'Status cases · one participant each',
    onePersonH2: `${Word(onePerson.cases.length)} cases with one participant each`,
    // eldBETA
    eldEyebrow: 'Status case · eldBETA · SSVEP selection by older adults',
    eldH2: 'One participant’s raw recordings, end to end',
    eldLede: (): Part[] => ['The raw-recording route runs end to end on one participant’s ', n(C.blocks), ' blocks of ', n(C.targets), ' targets: all ', n(C.trials), ' trials pass the reader and the quality checks, none dropped. The continuous recordings hold ', n(C.non_finite_values_outside_analysed_windows), ' non-finite values outside the analysed windows, left as recorded, and none inside them.'],
    paperListLink: 'SingLEM paper, Table I ↗',
    factLink: 'SingLEM’s pretraining-exposure rows →',
    holdLink: 'Its entry in the holds register →',
    // Damm
    dammEyebrow: 'Status case · Damm finger motor imagery · random cue order',
    dammH2: `One participant’s ${word(D.runs_used, 'en')} random-order runs, end to end`,
    dammLede: (): Part[] => ['The runs hold ', cn(D.delivered_cues), ' delivered cues over ', word(D.classes, 'en'), ' fingers (', andList(fingers), '): ', cn(D.trials_per_held_out_run), ' balanced trials in each held-out run. A fixed pipeline (', said(D.pipeline).text, ') was trained on one run and tested on the other, in both directions; ', word(damm.variants.length, 'en'), ' variants and controls were fixed before scoring, and an independent audit rebuilt all ', cn(damm.variant_directions_audited), ' reports.'],
    filesH3: 'What the files show',
    variantsH3: 'Variants and controls, fixed before scoring',
    licenceStated: (lic: string): Part[] => ['Licence: ', lic, ', as dataset_description.json states it.'],
    // NeBULA
    nebulaEyebrow: 'Status case · NeBULA · reaching with exoskeleton assistance, EEG and EMG',
    nebulaH2: `One participant’s reaches under ${word(assistance.length, 'en')} levels of assistance`,
    nebulaLede: (): Part[] => ['One participant reaching to ', word(N.targets, 'en'), ' targets under ', andList(assistance), ' assistance: ', cn(N.trials), ' delivered trials (', ...assistance.flatMap((a, i) => [i === 0 ? '' : i === assistance.length - 1 ? ' and ' : ', ', cn(N.trials_by_condition[a])]), '), ', cn(nebula.eeg.channels), ' EEG channels at ', cn(nebula.eeg.sampling_hz), ' Hz. The EEG arms were trained on two assistance runs and tested on the third (', cn(nebula.arms.eeg_fits), ' fits), beside an order diagnostic with no signal input, a precue window and a label shuffle; EMG and EEG plus EMG arms (', cn(nebula.arms.emg_and_fusion_fits), ' fits, no pretrained model) ran on the same trials. An independent audit rebuilt every arm.'],
    armsRunH3: 'Arms run',
    eegArms: 'EEG pilot:',
    emgArms: 'EMG and EEG plus EMG:',
    paperLicence: ['The paper’s own licence, ', ', covers ', '.'],
    // ZuCo 2.0
    zucoEyebrow: 'Status case · ZuCo 2.0 on NEMAR · no score',
    zucoH2: 'A timing hold on one converted run',
    clearsH3: 'The hold clears with',
    zucoSourceLink: 'Source and stated terms ↓',
    // The register
    registerH2: 'Each case in the open register',
    registerLede: 'Each case has a row in the open register, with the furthest step checked and the gaps that remain.',
    caseNames: { shin2022: 'Shin2022', 'kim2025-beta-range': 'Kim beta-range SSVEP', mind2026: 'MIND', eldbeta: 'eldBETA', damm: 'Damm finger motor imagery',
                 nebula: 'NeBULA', zuco2: 'ZuCo 2.0' } as Record<DqSection, string>,
    // Methods and limits
    limitsH2: 'Methods and limits',
    methodH3: 'Shin2022: how the check was run',
    method: (): Part[] => ['Leave one participant out: ', n(shin.method.folds), ' folds, each fitted on ', n(shin.method.training_participants_each_fold), ' participants. The window is ', dqSay(shin.method.window, 'en'), ': ', n(shin.method.window_samples), ' samples at ', n(shin.scope.sampling_hz), ' Hz from a ', shin.scope.hardware, ' headset with dry electrodes (', dqSay(shin.method.channel_names, 'en'), '). The label is the instructed target as each run stores it (', shin.labels.state, '); the trial’s outcome is never read.'],
