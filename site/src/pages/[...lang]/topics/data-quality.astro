    relatedH2: '相关',
    related: [
      { text: '', href: '/data-use/#sources-data-quality', link: '每个数据源的许可、知情同意与伦理声明是怎样读取的 →', english: true },
      { text: '', href: '/data-use/#sources-dataset-checks', link: 'Kim beta 频段、MIND、Damm 与 NeBULA 的许可与声明是怎样读取的 →', english: true },
      { text: '小规模试点研究，各有各的局限：', href: '/topics/pilot-studies/', link: topicCards.zh['pilot-studies'].question, english: false },
