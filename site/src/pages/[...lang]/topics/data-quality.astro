}[locale];

// The coverage chain once: none of its counts may appear in the short answer or the description.
for (const c of shinChain) for (const s of [copy.answer, copy.description]) need(!s.includes(F(n(c.count))) || c.count < 20, `${c.id}: the chain only in its table`);
const card = topicCards[locale]['data-quality'];
const shinEthics = dqText(SC.ethics_approval.statement, locale), shinConsent = dqText(SC.informed_consent.statement, locale);
const eldEthics = dqText(EC.ethics_approval.statement, locale), eldConsent = dqText(EC.informed_consent.statement, locale);
const rows = dqRegisterRows;
// MOABB's counts are named as findings on Shin2022's register row only while that row carries them and its page is built.
const catalogOnRow = rows !== null && dqCatalogFinding;
---
<TopicLayout
  locale={locale}
  title={card.title}
  description={copy.description}
  path={DQ_PATH}
  eyebrow={copy.eyebrow}
  dek={copy.dek}
  activeSlug="data-quality"
  answer={copy.answer}
  dataFiles={[`/data/${DQ}`]}
>
  <section class="topic-section" id={DQ_ANCHOR.shin} aria-labelledby="shin-heading" data-dq="shin2022">
    <div class="topic-heading"><div><p class="eyebrow">{copy.shinEyebrow}</p><h2 id="shin-heading">{copy.shinH2}</h2></div><p><Parts p={copy.shinLede()}/></p></div>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.armsRegion}>
      <table data-dq-table="arms">
        <caption><Parts p={copy.armsCaption()}/></caption>
        <thead><tr>{copy.cols.map(h => <th scope="col">{h}</th>)}</tr></thead>
        <tbody>{armRows.map(r => r.kind === 'sub'
          ? <tr class="subhead" data-dq-group="retrospective"><th scope="colgroup" colspan="4">{copy.retroGroup}</th></tr>
          : <tr data-dq-arm={r.a.arm} data-role={r.a.role}>
            <th scope="row">{dqSay(r.a.name, locale)}{r.a.role !== 'retrospective_control' && <small>{copy.role[r.a.role]}</small>}</th>
            <td data-cell="mean"><Fig f={pct(r.a.mean)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={pct(r.a.interval[0])}/>–<Fig f={pct(r.a.interval[1])}/></span></td>
            <td data-cell="pooled"><Fig f={pct(r.a.pooled)} cls="metric"/></td>
            <td data-cell="input">{dqSay(r.a.input, locale)}</td>
          </tr>)}</tbody>
      </table>
    </div>
    <p class="protocol-note" data-dq-note="shin-caveat">{dqSay(shin.caveat, locale)}</p>

    <h3 class="roadmap-h3" id="shin2022-coverage">{copy.chainH3}</h3>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.chainRegion}>
      <table data-dq-table="chain">
        <caption>{copy.chainCaption}</caption>
        <thead><tr>{copy.chainCols.map(h => <th scope="col">{h}</th>)}</tr></thead>
        <tbody>{shinChain.map(c => <tr data-dq-step={c.id} data-role={c.role}>
          <th scope="row">{chainLabel[c.id][locale]}{c.role && <small>{copy.stepRole[c.role]}</small>}</th>
          <td data-cell="count"><Fig f={n(c.count)} cls="metric"/></td>
          <td data-cell="targets"><Parts p={targets(c)}/></td>
          <td data-cell="shows">{dqSay(c.text, locale)}{copy.chainExtra[c.id] && <Parts p={copy.chainExtra[c.id]}/>}</td>
        </tr>)}</tbody>
      </table>
    </div>
    <p class="roadmap-p" data-dq-note="catalog"><Parts p={copy.catalog()}/>{catalogOnRow && <span data-dq-part="catalog-register">{sp}{copy.catalogRegister[0]}<a href={registerRow(rows!.shin2022)}>{copy.catalogRegister[1]}</a>{copy.catalogRegister[2]}</span>}</p>

    <h3 class="roadmap-h3" id="shin2022-checks">{copy.checkedH3}</h3>
    <ol class="rd-rules" data-dq-list="how-checked">{shin.how_checked.map(h => <li data-state={h.state}><strong>{copy.state[h.state]}</strong>{zh ? '：' : ': '}{dqSay(h.text, locale)}</li>)}</ol>

    <h3 class="roadmap-h3" id="shin2022-holds">{copy.holdsH3}</h3>
    <ul class="rd-rules" data-dq-list="shin-holds">{shin.holds.map(h => <li>{dqSay(h, locale)}</li>)}</ul>

    <h3 class="roadmap-h3" id="shin2022-source">{copy.sourceH3}</h3>
    <div class="citation-list" data-dq-credit="shin2022">
      <article>
        <h3 lang="en">{shin.rights.name}</h3>
        <p>{dqSay(shin.rights.task, locale)}{sp}{dqSay(shin.rights.version, locale)}{tc.period}</p>
        <p lang="en" data-dq-attribution="shin2022">{shin.rights.attribution}</p>
        <p>{dqSay(shin.rights.terms.linked_code.note, locale)}{sp}<a href={shin.rights.terms.linked_code.url} target="_blank" rel="noreferrer">{copy.codeLink}</a></p>
        <p><a href={shin.rights.source} target="_blank" rel="noreferrer">{copy.recordLink}</a> · <a href={shin.rights.licenseUrl} target="_blank" rel="noreferrer">{shin.rights.license}</a>{shinPage && <> · <a href={shinPage}>{copy.datasetPage}</a></>}</p>
      </article>
      <article data-dq-consent="shin2022">
        <h3>{copy.consentArticleH}</h3>
        <p><strong>{copy.ethicsH}</strong>{sp}{shinEthics.text}{shinEthics.original && <span class="note-original" lang="en">{shinEthics.original}</span>}</p>
        <p><strong>{copy.consentH}</strong>{sp}{shinConsent.text}{shinConsent.original && <span class="note-original" lang="en">{shinConsent.original}</span>}</p>
        <p>{copy.alsoStates}{sp}{shin.rights.terms.other_terms_stated.map((x, i) => <>{i > 0 && ' '}“<span lang="en">{x.quote}</span>”</>)}</p>
        <p><a href={SC.read_from} target="_blank" rel="noreferrer">{copy.paperLink}</a></p>
      </article>
    </div>
  </section>

  <section class="topic-section" id={DQ_ANCHOR.eldbeta} aria-labelledby="eldbeta-heading" data-dq="eldbeta">
    <div class="topic-heading"><div><p class="eyebrow">{copy.eldEyebrow}</p><h2 id="eldbeta-heading">{copy.eldH2}</h2></div><p><Parts p={copy.eldLede()}/></p></div>
    <h3 class="roadmap-h3" id="eldbeta-holds">{copy.holdsH3}</h3>
    <ul class="rd-rules" data-dq-list="eldbeta-holds">{eldHolds(locale).map(h => <li><Parts p={h}/></li>)}</ul>
    <p class="roadmap-p" data-dq-note="singlem">{dqSay(eld.related.fact, locale)}{sp}<a href={singlemSource} target="_blank" rel="noreferrer">{copy.paperListLink}</a> · <a href={hrefFor('/methods/singlem/#pretraining-exposure', locale)}>{copy.factLink}</a></p>
    <p class="protocol-note" data-dq-hold={eldHold!.id}><strong>{eldHold!.item[locale]} · {eldHold!.state[locale]}{tc.period}</strong>{sp}<a href={hrefFor(`/releases/#hold-${eldHold!.id}`, locale)}>{copy.holdLink}</a></p>
    <h3 class="roadmap-h3" id="eldbeta-source">{copy.sourceH3}</h3>
    <div class="citation-list" data-dq-credit="eldbeta">
      <article>
        <h3 lang="en">{eld.rights.name}</h3>
        <p>{dqSay(eld.rights.task, locale)}{sp}{dqSay(eld.rights.version, locale)}{tc.period}</p>
        <p lang="en" data-dq-attribution="eldbeta">{eld.rights.attribution}</p>
        <p><a href={eld.rights.source} target="_blank" rel="noreferrer">{copy.recordLink}</a> · <a href={eld.rights.licenseUrl} target="_blank" rel="noreferrer">{eld.rights.license}</a></p>
      </article>
      <article data-dq-consent="eldbeta">
        <h3>{copy.consentArticleH}</h3>
        <p><strong>{copy.ethicsH}</strong>{sp}{eldEthics.text}{eldEthics.original && <span class="note-original" lang="en">{eldEthics.original}</span>}</p>
        <p><strong>{copy.consentH}</strong>{sp}{eldConsent.text}{eldConsent.original && <span class="note-original" lang="en">{eldConsent.original}</span>}</p>
        <p>{copy.descriptorStates}{sp}{eld.rights.terms.other_terms_stated.map(x => <>“<span lang="en">{x.quote}</span>”</>)}</p>
        <p><a href={EC.read_from} target="_blank" rel="noreferrer">{copy.descriptorLink}</a></p>
      </article>
    </div>
  </section>

  <section class="topic-section" id={DQ_ANCHOR.zuco} aria-labelledby="zuco-heading" data-dq="zuco2">
    <div class="topic-heading"><div><p class="eyebrow">{copy.zucoEyebrow}</p><h2 id="zuco-heading">{copy.zucoH2}</h2></div><p>{zucoCase[locale]}{sp}{dqSay(zuco.scope, locale)}</p></div>
    <h3 class="roadmap-h3" id="zuco2-clears">{copy.clearsH3}</h3>
    <ul class="rd-rules" data-dq-list="zuco2-clears">{zuco.clears_when.map(x => <li>{dqSay(x, locale)}</li>)}</ul>
    <p class="roadmap-p" data-dq-note="zuco2-consent">{dqSay(zuco.consent_and_ethics.gap, locale)}{sp}<a href={here(DQ_ANCHOR.zucoSource)}>{copy.zucoSourceLink}</a></p>
    <p class="protocol-note" data-dq-hold={zucoHold!.id}><strong>{zucoHold!.item[locale]} · {zucoHold!.state[locale]}{tc.period}</strong>{sp}<a href={hrefFor(`/releases/#hold-${zucoHold!.id}`, locale)}>{copy.holdLink}</a></p>
  </section>

  {rows && <section class="topic-section" id={DQ_ANCHOR.register} aria-labelledby="register-heading" data-dq="register">
    <div class="topic-heading"><div><h2 id="register-heading">{copy.registerH2}</h2></div><p>{copy.registerLede}</p></div>
    <ul class="rd-rules" data-dq-list="register">{(Object.keys(rows) as (keyof typeof rows)[]).map(k => <li data-dq-row={rows[k]}><span lang="en">{copy.caseNames[k]}</span>{zh ? '：' : ': '}<a href={registerRow(rows[k])}>{rc.rowLink}</a></li>)}</ul>
  </section>}

  <section class="topic-section" id={DQ_ANCHOR.methods} aria-labelledby="limits-heading">
    <div class="topic-heading"><div><p class="eyebrow">{tc.methodsEyebrow}</p><h2 id="limits-heading">{copy.limitsH2}</h2></div></div>
    <h3 class="roadmap-h3">{copy.methodH3}</h3>
    <p class="roadmap-p" data-dq-note="method"><Parts p={copy.method()}/></p>
    <h3 class="roadmap-h3">{copy.intervalH3}</h3>
    <p class="roadmap-p" data-dq-note="interval"><Parts p={copy.interval()}/></p>
    <h3 class="roadmap-h3">{copy.notPubH3}</h3>
    <ul class="rd-rules" data-dq-list="not-published">{dqNotPublishedShown(locale).map(x => <li>{x}</li>)}</ul>
    <h3 class="roadmap-h3" id={DQ_ANCHOR.zucoSource}>{copy.zucoSourceH3}</h3>
    <div data-dq-credit="zuco2">
      <p class="roadmap-p">{copy.zucoRecord}{sp}{copy.zucoLicence}{sp}{zuco.source.terms_unverified.map((x, i) => <>{i > 0 && (zh ? '；' : '; ')}{dqSay(x, locale)}</>)}{tc.period}{sp}<a href={zuco.source.url} target="_blank" rel="noreferrer">{copy.recordLink}</a></p>
      <p class="citation-note" lang="en">{zuco.source.citation}</p>
    </div>
    <p class="citation-note">{tc.dataSource} <a href={`/data/${DQ}`} download>{DQ}</a> · {tc.schema} {dqSchema}{tc.period}</p>
  </section>

  <section class="topic-section" id="related" aria-labelledby="related-heading">
    <div class="topic-heading"><div><h2 id="related-heading">{copy.relatedH2}</h2></div></div>
    <ul class="rd-rules" data-dq-list="related">
      {copy.related.map(x => <li>{x.text}<a href={hrefFor(x.href, locale)}>{x.link}</a>{x.english ? t.englishMark : ''}</li>)}
      {rows && <li><a href={hrefFor('/datasets/register/', locale)}>{rc.datasetsLink}</a></li>}
    </ul>
  </section>
</TopicLayout>
