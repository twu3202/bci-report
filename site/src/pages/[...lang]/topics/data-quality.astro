// The coverage chain once: none of its counts may appear in the short answer or the description.
for (const c of shinChain) for (const s of [copy.answer, copy.description]) need(!s.includes(F(n(c.count))) || c.count < 20, `${c.id}: the chain only in its table`);
const card = topicCards[locale]['data-quality'];
const shinEthics = dqText(SC.ethics_approval.statement, locale), shinConsent = dqText(SC.informed_consent.statement, locale);
const eldEthics = dqText(EC.ethics_approval.statement, locale), eldConsent = dqText(EC.informed_consent.statement, locale);
const rows = dqRegisterRows;
// MOABB's counts are named as findings on Shin2022's register row only while that row carries them and its page is built.
const catalogOnRow = rows !== null && dqCatalogFinding;
// A hold, named and linked: its item and state from the holds register, never its reason.
const holdOf = (h: typeof eldHold) => h!;
---
<TopicLayout
  locale={locale}
  title={card.title}
  description={copy.description}
  path={DQ_PATH}
  eyebrow={copy.eyebrow}
  dek={copy.dek}
  activeSlug="data-quality"
  answer={copy.answer}
  dataFiles={[`/data/${DQ}`, `/data/${DC}`]}
>
  <section class="topic-section" id={DQ_ANCHOR.shin} aria-labelledby="shin-heading" data-dq="shin2022">
    <div class="topic-heading"><div><p class="eyebrow">{copy.shinEyebrow}</p><h2 id="shin-heading">{copy.shinH2}</h2></div><p><Parts p={copy.shinLede()}/></p></div>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.armsRegion}>
      <table data-dq-table="arms">
        <caption><Parts p={copy.armsCaption()}/></caption>
        <thead><tr>{copy.cols.map(h => <th scope="col">{h}</th>)}</tr></thead>
        <tbody>{armRows.map(r => r.kind === 'sub'
          ? <tr class="subhead" data-dq-group="retrospective"><th scope="colgroup" colspan="4">{copy.retroGroup}</th></tr>
          : <tr data-dq-arm={r.a.arm} data-role={r.a.role}>
            <th scope="row">{dqSay(r.a.name, locale)}{r.a.role !== 'retrospective_control' && <small>{copy.role[r.a.role]}</small>}</th>
            <td data-cell="mean"><Fig f={pct(r.a.mean)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={pct(r.a.interval[0])}/>–<Fig f={pct(r.a.interval[1])}/></span></td>
            <td data-cell="pooled"><Fig f={pct(r.a.pooled)} cls="metric"/></td>
            <td data-cell="input">{dqSay(r.a.input, locale)}</td>
          </tr>)}</tbody>
      </table>
    </div>
    <p class="protocol-note" data-dq-note="shin-caveat">{dqSay(shin.caveat, locale)}</p>

    <h3 class="roadmap-h3" id="shin2022-coverage">{copy.chainH3}</h3>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.chainRegion}>
      <table data-dq-table="chain">
        <caption>{copy.chainCaption}</caption>
        <thead><tr>{copy.chainCols.map(h => <th scope="col">{h}</th>)}</tr></thead>
        <tbody>{shinChain.map(c => <tr data-dq-step={c.id} data-role={c.role}>
          <th scope="row">{chainLabel[c.id][locale]}{c.role && <small>{copy.stepRole[c.role]}</small>}</th>
          <td data-cell="count"><Fig f={n(c.count)} cls="metric"/></td>
          <td data-cell="targets"><Parts p={targets(c)}/></td>
          <td data-cell="shows">{dqSay(c.text, locale)}{copy.chainExtra[c.id] && <Parts p={copy.chainExtra[c.id]}/>}</td>
        </tr>)}</tbody>
      </table>
    </div>
    <p class="roadmap-p" data-dq-note="catalog"><Parts p={copy.catalog()}/>{catalogOnRow && <span data-dq-part="catalog-register">{sp}{copy.catalogRegister[0]}<a href={registerRow(rows!.shin2022)}>{copy.catalogRegister[1]}</a>{copy.catalogRegister[2]}</span>}</p>

    <h3 class="roadmap-h3" id="shin2022-checks">{copy.checkedH3}</h3>
    <ol class="rd-rules" data-dq-list="how-checked">{shin.how_checked.map(h => <li data-state={h.state}><strong>{copy.state[h.state]}</strong>{colon}{dqSay(h.text, locale)}</li>)}</ol>

