    intakeH3: 'Intake: what the files hold',
    caveatsH3: 'Caveats',
    // MIND
    mindEyebrow: 'Conditional case · MIND · stored codes on record IDs',
    mindLede: (): Part[] => [said(M.task).text, ' In the primary panel of ', cn(MP.record_ids), ' record IDs (', cn(MP.runs), ' runs, ', cn(MP.trials), ' trials), ', said(MP.design).text, '. CSP + LDA stands beside two controls that read no EEG: an ordinal lookup and the majority code.'],
    mindRegion: 'MIND, primary panel, scrolls horizontally',
    mindCols: ['Stored codes', 'CSP + LDA', 'Ordinal lookup (no EEG)', 'Majority (no EEG)'],
    contrastsH3: `${Word(M.contrasts.length)} contrasts, with record-ID resampling ranges`,
    contrastsRegion: 'MIND, contrasts, scrolls horizontally',
