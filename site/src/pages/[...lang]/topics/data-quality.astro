    notPubH3: '不发布的内容',
    notPubDq: 'Shin2022、eldBETA 与 ZuCo 2.0：',
    notPubDc: 'Kim beta 频段、MIND、Damm 与 NeBULA：',
    zucoSourceH3: 'ZuCo 2.0：来源与所述条款',
    zucoRecord: `${zuco.source.repository} 登录号 ${zuco.source.accession}，版本 ${zuco.source.version}，doi:${zuco.source.doi}。`,
