    holdsH3: 'Held or unestablished',
    sourceH3: 'Source, licence and consent',
    sourceH: 'Source and licence',
    consentArticleH: 'Ethics and consent, as the source states them',
    ethicsH: 'Ethics approval:',
    consentH: 'Informed consent:',
