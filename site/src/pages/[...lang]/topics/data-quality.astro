    stepRole: { excluded: 'excluded', held: 'held' } as Record<string, string>,
    chainExtra: {
      distinct_runs: [' They hold ', n(distinct.closed_windows!), ' closed feedback windows.'],
      complete_runs: [' They cover all ', n(complete.participants!), ' participants.'],
      signal_invalid: [' Flat on all channels: ', n(invalid.flat_on_all_channels!), '; on some: ', n(invalid.flat_on_some_channels!), '. Windows with non-finite input: ', n(invalid.non_finite_input_windows!), '.'],
      signal_valid: [' That is ', dqFig(valid.percent_of_closed_windows!, 'pct1raw'), ' of the closed windows and ', dqFig(valid.percent_of_duration_eligible!, 'pct2raw'), ' of those lasting at least one second; all ', n(valid.participants_with_both_targets!), ' participants keep windows of both targets.'],
    } as Record<string, Part[]>,
    catalog: (): Part[] => ['MOABB’s dataset summary gives a trial length of ', n(shin.catalog.catalog_trial_seconds), ' s: that is the feedback cap (MaxFeedbackDuration) set in the header of each of the ', n(shin.catalog.headers_read), ' runs read.'],
    catalogRegister: ['MOABB’s trial and run counts for Shin2022 are findings on ', 'its row in the open register', '.'],
    checkedH3: 'How it was checked',
