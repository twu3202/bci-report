---
/**
 * What do the files show once a public EEG dataset is checked end to end? (owner decisions D1, D2, D15, D16, D18, D21):
 * seven public datasets, in the order the dataset-checks file sets. Shin2022 is the first worked case, a participant-
 * held-out diagnostic with three arms beside the coverage chain that counts its runs and windows from the files; Kim
 * beta-range the second, training-free CCA on all its participants beside chance, with its intake, checks and caveats;
 * MIND a conditional case on record IDs, CSP + LDA beside two controls that read no EEG, with record-ID resampling ranges
 * and its secondary panel apart; then the one-person sentence, once, before eldBETA, Damm and NeBULA, status cases with
 * counts and file facts and no score; ZuCo 2.0 a status case with no figure. In "Reliability & clinical", last.
 *
 * Every figure is a leaf of data-quality-update.json or dataset-checks-update.json, printed with data-fig (Fig.astro);
 * the words for the exports' own English, and the facts each sentence rests on, are in src/data/data-quality.ts. Rules:
 * each coverage chain is printed once, in its table; the duration control is labelled retrospective and set apart; each
 * caveat sits once, beside its evidence; eldBETA, Damm and NeBULA print counts, file facts and their holds and no score;
 * the ZuCo 2.0 case prints no figure; hold reasons stay on /releases/#holds, and each section names its hold and links
 * it; each case links its row in the open register only while the register file is served and its page built, and the
 * catalog line says MOABB's counts are on Shin2022's row only while that row carries them. The sentences that summarise
 * the exports are checked against them here, and the page refuses to build without them.
 */
import TopicLayout from '../../../components/TopicLayout.astro';
import Fig from '../../../components/Fig.astro';
import Parts from '../../../components/Parts.astro';
import { chrome, hrefFor, localeOf, localeParams, registerCopy, topicCards, topicChrome } from '../../../data/i18n';
import { datasetBySlug, formatFig, type Fig as FigValue } from '../../../data/entities';
import {
  DC, DQ, DQ_ANCHOR, DQ_PATH, assistanceZh, chainLabel, damm, dammHold, dammHolds, dammRole, dcFig, dcNotPublishedShown, dcSchema, dqCatalogFinding,
  dqFig, dqNotPublishedShown, dqRegisterRows, dqSay, dqSchema, dqSections, dqText, duration, eld, eldHold, eldHolds, fingerZh, kim, kimHold, mind,
  mindSourceName, mindStepLabel, nebula, nebulaHold, onePerson, prior, shin, shinArms, shinChain, singlemSource, spectral, step, word, Word,
  zuco, zucoCase, zucoHold, type ChainStep, type DqSection, type Part, type ShinArm,
} from '../../../data/data-quality';

export const getStaticPaths = localeParams;
const locale = localeOf(Astro.params.lang);
const zh = locale === 'zh';
const tc = topicChrome[locale];
const t = chrome[locale];
// The space between two sentences, or a sentence and its link: none in Chinese, after a full-width mark.
const sp = zh ? '' : ' ';
const colon = zh ? '：' : ': ';
const pct = (raw: number): FigValue => dqFig(raw, 'pct2');
const n = (raw: number): FigValue => dqFig(raw, 'count');
const cp = (raw: number): FigValue => dcFig(raw, 'pct2');
const cn = (raw: number): FigValue => dcFig(raw, 'count');
const F = (x: FigValue) => formatFig(x);
const ans = (x: FigValue) => `[[${F(x)}]]`;
const cap = (s: string) => s.replace(/^./, c => c.toUpperCase());
// An English list: "a, b and c".
const andList = (xs: string[]) => xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs.at(-1)}`;

// --- The facts the page's own sentences state, beyond those data-quality.ts asserts. -----------------------------
const need = (ok: unknown, what: string) => { if (!ok) throw new Error(`topics/data-quality: the copy says ${what}`); };
const pairs = step('byte_identical_pairs'), distinct = step('distinct_runs'), complete = step('complete_runs');
const short = step('shorter_than_one_second'), invalid = step('signal_invalid'), valid = step('signal_valid');
const C = eld.counts, SC = shin.consent_and_ethics, EC = eld.consent_and_ethics;
// The short answer and the description: some runs repeat, some windows end early or carry a flat channel; the
// spectral arm beside the duration control and the prior; eldBETA passes every check with its score held; ZuCo's hold.
need(pairs.count > 0 && short.count > 0 && invalid.count > 0, 'some runs repeat byte for byte and some windows end early or carry a flat channel');
need(spectral.mean > prior.mean && duration.mean > prior.mean, 'both arms sit above the training prior');
need(C.trials_passing_checks === C.trials && C.trials_dropped === 0 && eld.flags.score_published === false, 'eldBETA passes every check, its score held');
need(zuco.flags.fixation_times_outside_recording && zuco.flags.score_computed === false, 'ZuCo 2.0: fixation times outside the recording, no score');
// The lede: every participant held out once, the others fitting the ridge.
need(shin.method.folds === shin.scope.participants && shin.method.training_participants_each_fold === shin.scope.participants - 1, 'each participant held out once');
need(shin.scope.hardware.startsWith('g.tec') && shin.scope.channels === 16 && shin.method.channel_names.startsWith('EEG1–EEG16'), 'the headset and its channels');
need(shin.interval.resamples === 10000 && shin.interval.percentile_method === 'linear interpolation', 'the bootstrap');
// The source blocks: the paper each statement was read from, and the code the data record links.
need(SC.read_from.includes('10.3389/fnhum.2022.951591') && shin.rights.attribution.includes('10.3389/fnhum.2022.951591'), 'Shin2022’s paper');
need(EC.read_from.includes('s41597-022-01372-9') && eld.rights.attribution.includes('10.1038/s41597-022-01372-9'), 'eldBETA’s data descriptor');
need(shin.rights.terms.linked_code.url === 'https://github.com/mcvain/bci-simulator', 'the simulator code the record links');
need(shin.rights.terms.other_terms_stated.map(x => x.item).join() === 'de-identification,citation request', 'the two terms Shin2022’s record states');
need(eld.rights.terms.other_terms_stated.length === 1 && eld.rights.terms.other_terms_stated[0].item === 'access', 'the access term eldBETA’s descriptor states');
need(zuco.source.licence_as_stated === 'CC-BY-4.0' && zuco.source.licence_stated_by === 'the dataset_description.json of that version'
  && zuco.source.terms_unverified.length === 2, 'ZuCo 2.0’s stated licence, and the two terms unverified');
need(eld.related.model === 'singlem' && eld.related.dataset === 'beta', 'the SingLEM exposure row on BETA');
// The dataset checks: the lede facts each section states in the page's own words.
const K = kim, KR = kim.result, KC = kim.consent_and_ethics, M = mind, MP = mind.primary, MS = mind.secondary, MC = mind.consent_and_ethics;
const D = damm.design, DCE = damm.consent_and_ethics, N = nebula.design, NCE = nebula.consent_and_ethics;
need(K.cohort.participants === K.intake.task_files && K.result.chance === 1 / K.cohort.targets, 'Kim beta-range: all its participants, chance one in its targets');
need(KR.metric.startsWith('mean participant accuracy;'), 'Kim beta-range: the figure is the mean participant accuracy');
need(MP.design.startsWith('two whole runs') && MS.design.startsWith('one run') && M.processing.controls.map((x: any) => x.id).join() === 'ordinal_lookup,majority',
  'MIND: the designs and the two controls the lede names');
need(D.directions === 2 && D.evaluation.endsWith('in both directions') && damm.variants.length === 8 && damm.files.excluded_channels.length === 3, 'Damm: both directions, eight variants');
need(N.targets === 3 && N.assistance_conditions.length === 3 && nebula.arms.eeg.some((a: any) => a.id === 'precue') && nebula.arms.eeg.some((a: any) => a.id === 'shuffle'),
  'NeBULA: three targets, three assistance runs, the precue window and the label shuffle');
const dsN = dqSections.length;

// The arms table: the reference and the EEG arm, then the retrospective control under its own heading.
type ArmRow = { kind: 'arm'; a: ShinArm } | { kind: 'sub' };
const armRows: ArmRow[] = [...shinArms.filter(a => a.role !== 'retrospective_control').map(a => ({ kind: 'arm' as const, a })),
  { kind: 'sub' }, { kind: 'arm', a: duration }];
need(shinArms.filter(a => a.role === 'retrospective_control').length === 1, 'one retrospective control');
// The chain's per-target column: instructed right, then left, with a no-break space each side of the dot so a stacked
// cell never strands it on a line of its own.
const dot = ' · ';
const targets = (c: ChainStep): Part[] => c.by_target ? [n(c.by_target['1']), dot, n(c.by_target['2'])]
  : c.windows_per_run_by_target ? [n(c.windows_per_run_by_target['1']), dot, n(c.windows_per_run_by_target['2']), zh ? '（每个 run）' : ' per run'] : ['—'];
const shinPage = datasetBySlug['shin2022'] ? hrefFor('/datasets/shin2022/', locale) : null;
const kimPage = datasetBySlug[K.id] ? hrefFor(K.dataset_page, locale) : null;
// In-page pointers as full paths: the Markdown copy drops in-page jump links.
const here = (anchor: string) => `${hrefFor(DQ_PATH, locale)}#${anchor}`;
const registerRow = (id: string) => hrefFor(`/datasets/register/#${id}`, locale);
const rc = registerCopy[locale];
// A source's sentence in the page's language, with its English beside it on a Chinese page.
const said = (en: string) => dqText(en, locale);
// MIND's caveats beside its evidence: the terms and ethics caveats print in its source block.
const mindCaveats = M.caveats.filter((x: any) => x.id !== 'terms' && x.id !== 'ethics');
const mindCaveat = (id: string) => M.caveats.find((x: any) => x.id === id).text as string;
const mindContrastName = (x: any) => `CSP + LDA − ${zh ? { ordinal_lookup: '按位置查表', majority: '多数类' }[x.control as string] : { ordinal_lookup: 'ordinal lookup', majority: 'majority' }[x.control as string]}`;
const assistance = N.assistance_conditions as string[];
const fingers = D.class_names as string[];

const copy = {
  en: {
    description: `${Word(dsN)} public EEG datasets, read from their files. Shin2022: for a held-out participant, alpha and beta band power reached ${F(pct(spectral.mean))} balanced accuracy, a trial-duration control ${F(pct(duration.mean))}, the training prior ${F(pct(prior.mean))}. Kim beta-range: training-free CCA ${F(cp(KR.mean_participant_accuracy))}, chance ${F(cp(KR.chance))}. eldBETA, Damm, NeBULA: one person each, scores held.`,
    answer: `Shin2022’s files repeat some runs byte for byte, and some feedback windows end early or carry a flat channel; on the windows that remain, a participant-held-out check put alpha and beta band power at ${ans(pct(spectral.mean))} balanced accuracy, beside ${ans(pct(duration.mean))} for a control that reads only how long each trial lasted and ${ans(pct(prior.mean))} for the training prior. eldBETA’s raw recordings for one participant pass every check, and with one person the score is held. In one converted ZuCo 2.0 run some fixation times fall outside the recording, so no EEG–text score is computed.`,
    eyebrow: `Data quality and reproducibility · ${word(dsN, 'en')} public EEG datasets, read from their files`,
    dek: 'Shin2022 and Kim beta-range are worked cases: their files counted and checked first, then a fixed baseline beside its reference. MIND is a conditional case on record IDs, with two controls that read no EEG. eldBETA, Damm and NeBULA have one participant each and publish counts and file facts; ZuCo 2.0 carries a timing hold.',
