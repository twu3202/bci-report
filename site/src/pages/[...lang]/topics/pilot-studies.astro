  need(D[id].rights.attribution.includes(who), `the ${id} source line names the dataset's authors`);
const names = { orthosis: 'Niklas Kueper, Kartik Chari, Judith Bütefür, Julia Habenicht, Tobias Rossol, Su Kyoung Kim, Marc Tabie, Frank Kirchner and Elsa Andrea Kirchner',
  refed: 'Xiaojun Ning, Jing Wang, Zhiyang Feng, Tianzuo Xin, Shuo Zhang, Shaoqi Zhang, Zheng Lian, Yi Ding, Youfang Lin and Ziyu Jia',
  bingo: 'BINGO (Brain Imagined-Speech Communication), CERTH', handwriting: 'lasfk on Hugging Face · EEG-fNIRS-based Handwriting Trajectory Dataset' };
need(D['eeg-fnirs-handwriting'].rights.attribution.startsWith(names.handwriting), 'the handwriting source line as its rights record words it');
const card = topicCards[locale]['pilot-studies'];
const dataset = (slug: string) => hrefFor(`/datasets/${slug}/`, locale);
// The page's own credits, as a full path: the Markdown copy drops in-page jump links.
const creditsHref = `${hrefFor(PILOT_PATH, locale)}#credits`;
const ivText = zh ? ' 至 ' : ' to ';
// One table cell: the figure, and its interval where it has one.
const cellParts = (x: { mean: number; interval_95: number[] }, fmt: Fmt) => ({ v: f(x.mean, fmt), iv: ivOf(x) ? [f(x.interval_95[0], fmt), f(x.interval_95[1], fmt)] : null });
const oRows = [
  { sub: copy.sub64 },
  { key: 'eeg64', label: arm.eeg64, a: o64.arms.eeg, perm: o64.permutation_control.balanced_accuracy },
  { key: 'confound64', label: arm.confound, a: o64.arms.confound },
  { key: 'majority64', label: arm.majority, a: o64.arms.majority },
  { key: 'prior64', label: arm.prior, a: o64.arms.prior },
  { sub: copy.sub58 },
  { key: 'classical58', label: arm.c58, a: o58.arms.classical58, perm: o58.permutation_control.balanced_accuracy },
  { key: 'eegpt58', label: arm.eegpt, a: oep.arms.eegpt2048, perm: oep.permutation_control.eegpt2048 },
  { key: 'confound58', label: arm.confound, a: oep.arms.confound },
  { key: 'majority58', label: arm.majority, a: oep.arms.majority },
  { key: 'prior58', label: arm.prior, a: oep.arms.prior },
] as const;
---
<TopicLayout
  locale={locale}
  title={card.title}
  description={copy.description}
  path="/topics/pilot-studies/"
  eyebrow={copy.eyebrow}
  dek={copy.dek}
  activeSlug="pilot-studies"
  answer={copy.answer}
  dataFiles={['/data/pilot-studies-update.json']}
>
  <section class="topic-section" id="orthosis" aria-labelledby="orthosis-heading" data-pilot="orthosis">
    <div class="topic-heading"><div><p class="eyebrow">{copy.oEyebrow}</p><h2 id="orthosis-heading">{copy.oH2}</h2><p class="topic-subtitle" data-subtitle="orthosis">{copy.oLabel}</p></div><p><Parts p={copy.oLede()}/></p></div>
    <h3 class="roadmap-h3" id="orthosis-64ch"><Parts p={copy.o64H3()}/></h3>
    <IntervalPlot
      id="orthosis-64ch-balanced-accuracy"
      caption={copy.o64Caption}
      legend={copy.o64Legend}
      domain={baDomain}
      ticks={['40%', '50%', '60%', '70%', '80%']}
      reference={o64.chance_level}
      rows={[
        { label: arm.eeg64, value: E64.mean, interval: E64.interval_95 as [number, number], fig: f(E64.mean), noteParts: [`${tc.interval95} `, f(E64.interval_95[0]), '–', f(E64.interval_95[1])], tone: 'rust' },
        { label: arm.confound, value: CF64.mean, interval: CF64.interval_95 as [number, number], fig: f(CF64.mean), noteParts: [`${tc.interval95} `, f(CF64.interval_95[0]), '–', f(CF64.interval_95[1])], tone: 'ink' },
        { label: arm.prior, value: PR64.mean, fig: f(PR64.mean), note: copy.priorNote, tone: 'ink' },
        { label: arm.perm, value: P64.balanced_accuracy_mean, fig: f(P64.balanced_accuracy_mean), noteParts: copy.permNote(P64), tone: 'muted' },
      ]}
    />
    <div class="finding" data-finding="orthosis-64ch">
      <div class="finding-number"><strong><Fig f={f(E64.mean)}/></strong><span><Parts p={copy.o64FindLabel()}/></span></div>
      <div class="finding-copy"><h3>{copy.o64FindH3}</h3><p><Parts p={copy.o64FindP()}/></p></div>
    </div>
    <p class="protocol-note" data-pilot-note="orthosis-64ch-limits">{copy.o64Limits}</p>
    <h3 class="roadmap-h3" id="orthosis-eegpt"><Parts p={copy.oepH3()}/></h3>
    <p class="roadmap-p" data-pilot-note="orthosis-58ch"><Parts p={copy.o58P()}/></p>
    <IntervalPlot
      id="orthosis-eegpt-balanced-accuracy"
      caption={copy.oepCaption}
      legend={copy.oepLegend}
      domain={baDomain}
      ticks={['40%', '50%', '60%', '70%', '80%']}
      reference={oep.chance_level}
      rows={[
        { label: arm.eegpt, value: EP.mean, interval: EP.interval_95 as [number, number], fig: f(EP.mean), noteParts: [`${tc.interval95} `, f(EP.interval_95[0]), '–', f(EP.interval_95[1])], tone: 'olive' },
        { label: arm.c58, value: oep.arms.classical58.balanced_accuracy.mean, interval: oep.arms.classical58.balanced_accuracy.interval_95 as [number, number], fig: f(oep.arms.classical58.balanced_accuracy.mean),
          noteParts: [`${tc.interval95} `, f(oep.arms.classical58.balanced_accuracy.interval_95[0]), '–', f(oep.arms.classical58.balanced_accuracy.interval_95[1])], tone: 'rust' },
        { label: arm.confound, value: oep.arms.confound.balanced_accuracy.mean, interval: oep.arms.confound.balanced_accuracy.interval_95 as [number, number], fig: f(oep.arms.confound.balanced_accuracy.mean),
          noteParts: [`${tc.interval95} `, f(oep.arms.confound.balanced_accuracy.interval_95[0]), '–', f(oep.arms.confound.balanced_accuracy.interval_95[1])], tone: 'ink' },
        { label: arm.prior, value: oep.arms.prior.balanced_accuracy.mean, fig: f(oep.arms.prior.balanced_accuracy.mean), note: copy.priorNote, tone: 'ink' },
      ]}
    />
    <IntervalPlot
      id="orthosis-eegpt-paired"
      caption={copy.pairCaption}
      legend={copy.pairLegend}
      domain={ppDomain}
      ticks={['−10', '−5', '0', '+5', '+10 pp']}
      reference={0}
      rows={[
        { label: copy.pairLabel, value: PD.mean, interval: PD.interval_95 as [number, number], fig: pp(PD.mean), noteParts: [`${tc.interval95} `, sg(PD.interval_95[0]), ivText, pp(PD.interval_95[1])], tone: 'olive' },
      ]}
    />
    <div class="finding" data-finding="orthosis-eegpt">
      <div class="finding-number"><strong><Fig f={pp(PD.mean)}/></strong><span><Parts p={copy.oepFindLabel()}/></span></div>
      <div class="finding-copy"><h3>{copy.oepFindH3}</h3><p><Parts p={copy.oepFindP()}/></p></div>
    </div>
    <p class="protocol-note" data-pilot-note="orthosis-eegpt-limits">{copy.oepLimits}</p>
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.oRegion}>
      <table data-pilot-table="orthosis">
        <caption><Parts p={copy.oCaption()}/></caption>
        <thead><tr><th scope="col">{copy.colArm}</th><th scope="col">{copy.colBa}</th><th scope="col">{copy.colAuroc}</th><th scope="col">{copy.colAp}</th><th scope="col">{copy.colPerm}</th></tr></thead>
        <tbody>{oRows.map(row => 'sub' in row
          ? <tr class="subhead"><th scope="colgroup" colspan="5">{row.sub}</th></tr>
          : <tr data-pilot-row={row.key}><th scope="row">{row.label}</th>
            {([['ba', 'balanced_accuracy', 'pct1'], ['auroc', 'auroc', 'auc3'], ['ap', 'average_precision', 'auc3']] as const).map(([cell, m, fmt]) => {
              const c = cellParts(row.a[m], fmt);
              return <td data-cell={cell}><Fig f={c.v} cls="metric"/>{c.iv ? <span class="interval">{tc.interval95} <Fig f={c.iv[0]}/>–<Fig f={c.iv[1]}/></span> : <span class="interval">{copy.constant}</span>}</td>;
            })}
            <td data-cell="perm">{'perm' in row && row.perm ? <><Fig f={f(row.perm.balanced_accuracy_mean)} cls="metric"/><span class="interval"><Parts p={copy.shuffleRange(row.perm.observed_range)}/></span></> : copy.noPerm}</td>
          </tr>)}</tbody>
      </table>
    </div>
    <p class="roadmap-p" data-pilot-note="orthosis-response-clean"><Parts p={copy.rcP()}/></p>
    <p class="citation-note" data-pilot-note="orthosis-source">{copy.oSource}{zh ? <><span lang="en">{names.orthosis}</span>，</> : ' '}<code>{VERSION.orthosis}</code>{zh ? '，' : ', '}<a href={D['orthosis-error-detection'].rights.licenseUrl} target="_blank" rel="noreferrer">{D['orthosis-error-detection'].rights.license}</a>{tc.period}{sp}<a href={dataset('orthosis-error-detection')}>{copy.datasetPage}</a> · <a href={creditsHref}>{copy.creditsLink}</a></p>
    <p class="citation-note" data-pilot-note="orthosis-audit">{copy.oAudit}</p>
  </section>

  {bingoReleased ? <>
    <section class="topic-section" id="bingo" aria-labelledby="bingo-heading" data-pilot="bingo">
      <div class="topic-heading"><div><p class="eyebrow">{copy.bEyebrow}</p><h2 id="bingo-heading">{copy.bH2}</h2><p class="topic-subtitle" data-subtitle="bingo">{copy.bLabel}</p></div><p><Parts p={copy.bLede()}/></p></div>
      <IntervalPlot
        id="bingo-balanced-accuracy"
        caption={copy.bCaption}
        legend={copy.bLegend}
        domain={bDomain}
        ticks={['3%', '5%', '7%', '9%', '11%']}
        reference={chance15}
        rows={dirs.map(d => ({ label: dirName[d.id][locale], value: d.balanced_accuracy.mean, interval: d.balanced_accuracy.interval_95 as [number, number], fig: f(d.balanced_accuracy.mean),
          noteParts: [`${d.kind === 'within-language' ? copy.within : copy.across} · ${tc.interval95} `, f(d.balanced_accuracy.interval_95[0]), '–', f(d.balanced_accuracy.interval_95[1])],
          tone: d.kind === 'within-language' ? 'rust' as const : 'olive' as const }))}
      />
      <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.bRegion}>
        <table data-pilot-table="bingo">
          <caption><Parts p={copy.bTabCaption()}/></caption>
          <thead><tr><th scope="col">{copy.colDir}</th><th scope="col">{copy.colBa}</th><th scope="col">{copy.colTop3}</th><th scope="col">{copy.colOrder}</th><th scope="col">{copy.colHf}</th><th scope="col">{copy.colShuffle}</th></tr></thead>
          <tbody>{dirs.map(d => <tr data-pilot-row={d.id}>
            <th scope="row">{dirName[d.id][locale]}<small>{d.kind === 'within-language' ? copy.within : copy.across}</small></th>
            {([['ba', d.balanced_accuracy], ['top3', d.top3_accuracy], ['order', d.controls.order_only.balanced_accuracy], ['hf', d.controls.high_frequency_ratio.balanced_accuracy]] as const).map(([cell, x]) =>
              <td data-cell={cell}><Fig f={f(x.mean)} cls="metric"/><span class="interval">{tc.interval95} <Fig f={f(x.interval_95[0])}/>–<Fig f={f(x.interval_95[1])}/></span></td>)}
            <td data-cell="shuffle"><Fig f={f(d.controls.label_shuffle.balanced_accuracy.balanced_accuracy_mean)} cls="metric"/><span class="interval"><Parts p={copy.shuffleRange(d.controls.label_shuffle.balanced_accuracy.observed_range)}/></span></td>
          </tr>)}</tbody>
        </table>
      </div>
      <IntervalPlot
        id="bingo-contrast"
        caption={copy.cCaption}
        legend={copy.cLegend}
        domain={cDomain}
        ticks={['−2', '−1', '0', '+1', '+2 pp']}
        reference={0}
        rows={[
          { label: copy.cRows.mean, value: C3.balanced_accuracy_difference.mean, interval: C3.balanced_accuracy_difference.interval_95 as [number, number], fig: pp(C3.balanced_accuracy_difference.mean),
            noteParts: [`${tc.interval95} `, sg(C3.balanced_accuracy_difference.interval_95[0]), ivText, pp(C3.balanced_accuracy_difference.interval_95[1])], tone: 'olive' },
          ...(['greek', 'english'] as const).map(k => {
            const x = C3.by_training_language[k].balanced_accuracy_difference;
            return { label: copy.cRows[k], value: x.mean, interval: x.interval_95 as [number, number], fig: pp(x.mean), noteParts: [`${tc.interval95} `, sg(x.interval_95[0]), ivText, pp(x.interval_95[1])], tone: 'muted' as const };
          }),
        ]}
      />
      <div class="finding" data-finding="bingo">
        <div class="finding-number"><strong><Fig f={pp(C3.balanced_accuracy_difference.mean)}/></strong><span><Parts p={copy.bFindLabel()}/></span></div>
        <div class="finding-copy"><h3>{copy.bFindH3}</h3><p><Parts p={copy.bFindP()}/></p></div>
      </div>
      <p class="protocol-note" data-pilot-note="bingo-delivered"><strong>{copy.bDelivered} <a href={doc[0].url} target="_blank" rel="noreferrer" lang="en">{doc[0].title} ↗</a>{zh ? '：' : ':'}</strong>{sp}{zh ? deliveredZh : DS.statement}{sp}{copy.bDeliveredEnd}{zh && <span class="note-original" lang="en">{DS.statement}</span>}</p>
      <p class="protocol-note" data-pilot-note="bingo-limits">{copy.bLimits}</p>
      <p class="roadmap-p" data-pilot-note="bingo-project-reported"><strong>{copy.bProjectH}</strong>{sp}<Parts p={copy.bProject()}/>{sp}<a href={doc[1].url} target="_blank" rel="noreferrer" lang="en">{doc[1].title} ↗</a></p>
      <p class="citation-note" data-pilot-note="bingo-source">{copy.bSource}{zh ? <><span lang="en">{names.bingo}</span>，</> : ' '}<a href={D['bingo-imagined-speech'].rights.source} target="_blank" rel="noreferrer">{copy.bDatasets}</a> · {copy.bDoc} <a href={doc[0].url} target="_blank" rel="noreferrer" lang="en">{doc[0].title} ↗</a>{tc.period}{sp}{copy.bNoLicence}{sp}<a href={dataset('bingo-imagined-speech')}>{copy.datasetPage}</a> · <a href={creditsHref}>{copy.creditsLink}</a></p>
      <p class="citation-note" data-pilot-note="bingo-audit">{copy.bAudit}</p>
    </section>
  </> : <>
    <section class="topic-section" id="bingo" aria-labelledby="bingo-heading" data-pilot="bingo" data-held="true">
      <div class="topic-heading"><div><p class="eyebrow">{copy.bHeldEyebrow}</p><h2 id="bingo-heading">{copy.bH2}</h2></div><p>{copy.bHeldLede}</p></div>
      <p class="protocol-note" id={BINGO_HOLD} data-pilot-hold={BINGO_HOLD}><strong>{bHold!.item[locale]} · {bHold!.state[locale]}{tc.period}</strong>{sp}{bHold!.outcome[locale]}{sp}<a href={hrefFor(`/releases/#hold-${bHold!.id}`, locale)}>{copy.holdLink}</a></p>
      <p class="citation-note" data-pilot-note="bingo-source">{copy.bSource}{zh ? <><span lang="en">{names.bingo}</span>，</> : ' '}<a href={D['bingo-imagined-speech'].rights.source} target="_blank" rel="noreferrer">{copy.bDatasets}</a> · {copy.bDoc} <a href={doc[0].url} target="_blank" rel="noreferrer" lang="en">{doc[0].title} ↗</a>{tc.period}{sp}{copy.bNoLicence}{sp}{copy.bHeldNoPage} <a href={creditsHref}>{copy.creditsLink}</a></p>
    </section>
  </>}

  {handwritingReleased ? <>
    <section class="topic-section" id="handwriting" aria-labelledby="handwriting-heading" data-pilot="handwriting">
      <div class="topic-heading"><div><p class="eyebrow">{copy.hEyebrow}</p><h2 id="handwriting-heading">{copy.hH2}</h2><p class="topic-subtitle" data-subtitle="handwriting">{copy.hLabel}</p></div><p><Parts p={copy.hLedeR()}/></p></div>
      <IntervalPlot
        id="handwriting-balanced-accuracy"
        caption={copy.hCaption}
        legend={copy.hLegend}
        domain={hDomain}
        ticks={['22%', '24%', '26%', '28%', '30%']}
        reference={hw.chance_level}
        axisLabel={copy.colBa}
        rows={HARMS.map(k => {
          const b = HA[k].balanced_accuracy, iv = b.interval_95 as [number, number] | null, live = !!iv && iv[0] !== iv[1];
          return { label: copy.hArm[k], value: b.mean, interval: live ? iv : null, fig: f2(b.mean),
            ...(live ? { noteParts: [`${k === 'relative_eeg' ? '' : `${copy.noEeg} · `}${tc.interval95} `, f2(iv![0]), '–', f2(iv![1])] } : { note: k === 'majority' ? copy.chanceAll : `${copy.noEeg} · ${copy.ivWithheld}` }),
            tone: k === 'relative_eeg' ? 'rust' as const : 'ink' as const };
        })}
      />
      <IntervalPlot
        id="handwriting-paired"
        caption={copy.hcCaption}
        legend={copy.hcLegend}
        domain={hcDomain}
        ticks={['−4', '−2', '0', '+2', '+4 pp']}
        reference={0}
        axisLabel={zh ? '配对差值' : 'Paired difference'}
        rows={HCONTRASTS.map(k => {
          const c = HK[k], d = c.balanced_accuracy_difference;
          return { label: copy.hcRow[k], value: d.mean, interval: d.interval_95 as [number, number], fig: p2(d.mean),
            noteParts: [`${tc.interval95} `, s2(d.interval_95[0]), ivText, p2(d.interval_95[1]), ...(c.interval_excludes_zero ? [] : [` · ${copy.crossesZero}`])],
            tone: c.interval_excludes_zero ? 'olive' as const : 'muted' as const };
        })}
      />
      <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.hRegion}>
        <table data-pilot-table="handwriting">
          <caption><Parts p={copy.hTabCaption()}/></caption>
          <thead><tr><th scope="col">{copy.colArm}</th><th scope="col">{copy.colBa}</th><th scope="col">{copy.colShuffleH}</th></tr></thead>
          <tbody>{HARMS.map(k => { const b = HA[k].balanced_accuracy, iv = b.interval_95 as number[] | null, sh = (HS as Record<string, any>)[k]; return <tr data-pilot-row={k}>
            <th scope="row">{copy.hArm[k]}{k !== 'relative_eeg' && <small>{copy.noEeg}</small>}</th>
            <td data-cell="ba"><Fig f={f2(b.mean)} cls="metric"/>{iv && iv[0] !== iv[1] ? <span class="interval">{tc.interval95} <Fig f={f2(iv[0])}/>–<Fig f={f2(iv[1])}/></span> : <span class="interval">{k === 'majority' ? copy.chanceAll : copy.ivWithheld}</span>}</td>
            <td data-cell="shuffle">{sh ? <><Fig f={f2(sh.balanced_accuracy_mean)} cls="metric"/><span class="interval"><Parts p={copy.shuffleRange2(sh.observed_range)}/></span></> : copy.noPerm}</td>
          </tr>; })}</tbody>
        </table>
      </div>
      <div class="finding" data-finding="handwriting">
        <div class="finding-number"><strong><Fig f={f2(HA.relative_eeg.balanced_accuracy.mean)}/></strong><span><Parts p={copy.hFindLabel()}/></span></div>
        <div class="finding-copy"><h3>{copy.hFindH3}</h3><p><Parts p={copy.hFindP()}/></p></div>
      </div>
      <h3 class="roadmap-h3" id="handwriting-availability">{copy.hAvailH3}</h3>
      <p class="roadmap-p" data-pilot-note="handwriting-availability"><Parts p={copy.hAvailP()}/></p>
      <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.hAvailRegion}>
        <table data-pilot-table="handwriting-availability">
          <caption><Parts p={copy.hAvailCaption()}/></caption>
          <thead><tr><th scope="col">{copy.colAvail}</th><th scope="col">{copy.colTrials}</th></tr></thead>
          <tbody>{(HV.trials_by_available_channels as { channels: number; trials: number }[]).map(x => <tr data-pilot-row={`channels-${x.channels}`}>
            <th scope="row"><Fig f={n(x.channels)}/></th><td data-cell="trials"><Fig f={n(x.trials)} cls="metric"/></td>
          </tr>)}</tbody>
        </table>
      </div>
      <p class="roadmap-p" data-pilot-note="handwriting-earlier"><Parts p={copy.hEarlier()}/></p>
      <p class="protocol-note" data-pilot-note="handwriting-limits">{copy.hLimits}</p>
      <p class="citation-note" data-pilot-note="handwriting-source">{copy.hSource}{sp}<a href={D['eeg-fnirs-handwriting'].rights.source} target="_blank" rel="noreferrer" lang="en">{names.handwriting} ↗</a>{zh ? '，' : ', '}<code>{VERSION.handwriting}</code>{zh ? '，' : ', '}<a href={D['eeg-fnirs-handwriting'].rights.licenseUrl} target="_blank" rel="noreferrer">{D['eeg-fnirs-handwriting'].rights.license}</a>{zh ? '，' : ' '}{copy.hDeclared}{sp}<span data-pilot-note="handwriting-rights-pointer">{copy.hRightsPointer}</span>{sp}<a href={dataset('eeg-fnirs-handwriting')}>{copy.datasetPage}</a> · <a href={creditsHref}>{copy.creditsLink}</a></p>
      <p class="citation-note" data-pilot-note="handwriting-audit"><Parts p={copy.hAudit()}/></p>
    </section>
  </> : <>
    <section class="topic-section" id="handwriting" aria-labelledby="handwriting-heading" data-pilot="handwriting" data-held="true">
      <div class="topic-heading"><div><p class="eyebrow">{copy.hHeldEyebrow}</p><h2 id="handwriting-heading">{copy.hH2}</h2></div><p>{copy.hHeldLede}</p></div>
      <p class="protocol-note" id={HANDWRITING_HOLD} data-pilot-hold={HANDWRITING_HOLD}><strong>{hold!.item[locale]} · {hold!.state[locale]}{tc.period}</strong>{sp}{hold!.outcome[locale]}{sp}<a href={hrefFor(`/releases/#hold-${hold!.id}`, locale)}>{copy.holdLink}</a></p>
      <p class="citation-note" data-pilot-note="handwriting-source">{copy.hSource}{sp}<a href={D['eeg-fnirs-handwriting'].rights.source} target="_blank" rel="noreferrer" lang="en">{names.handwriting} ↗</a>{zh ? '，' : ', '}<code>{VERSION.handwriting}</code>{zh ? '，' : ', '}<a href={D['eeg-fnirs-handwriting'].rights.licenseUrl} target="_blank" rel="noreferrer">{D['eeg-fnirs-handwriting'].rights.license}</a>{zh ? '，' : ' '}{copy.hDeclared}{sp}{copy.hHeldNoPage} <a href={creditsHref}>{copy.creditsLink}</a></p>
    </section>
  </>}

  <section class="topic-section" id="refed" aria-labelledby="refed-heading" data-pilot="refed">
    <div class="topic-heading"><div><p class="eyebrow">{copy.rEyebrow}</p><h2 id="refed-heading">{copy.rH2}</h2><p class="topic-subtitle" data-subtitle="refed">{copy.rLabel}</p></div><p><Parts p={copy.rLede()}/></p></div>
    {([['shared', shared], ['joint', joint]] as const).map(([k, c]) => <IntervalPlot
      id={`refed-${k}`}
      caption={copy.rCaption[k]}
      legend={copy.rLegend}
      domain={mDomain}
      ticks={['0', '30', '60', '90', '120']}
      reference={c.arms.source_global_mean.equal_axis_mae}
      rows={(['eeg_ridge', 'source_global_mean', 'source_video_lookup', 'duration_video_id_ridge'] as const).map(a => ({
        label: refedArm[a][locale], value: c.arms[a].equal_axis_mae, fig: m3(c.arms[a].equal_axis_mae), note: a === 'eeg_ridge' ? undefined : copy.control, tone: a === 'eeg_ridge' ? 'rust' as const : 'ink' as const }))}
    />)}
    <div class="topic-table scroll topic-table-spaced" tabindex="0" role="region" aria-label={copy.rRegion}>
      <table data-pilot-table="refed">
        <caption><Parts p={copy.rTabCaption()}/></caption>
        <thead><tr><th scope="col">{copy.colArm}</th><th scope="col">{copy.colShared}</th><th scope="col">{copy.colJoint}</th></tr></thead>
        <tbody>{(['eeg_ridge', 'source_global_mean', 'source_video_lookup', 'duration_video_id_ridge'] as const).map(a => <tr data-pilot-row={a}>
          <th scope="row">{refedArm[a][locale]}{a !== 'eeg_ridge' && <small>{copy.control}</small>}</th>
          <td data-cell="shared"><Fig f={m3(SA[a].equal_axis_mae)} cls="metric"/></td>
          <td data-cell="joint"><Fig f={m3(JA[a].equal_axis_mae)} cls="metric"/></td>
        </tr>)}</tbody>
      </table>
    </div>
    <div class="finding" data-finding="refed">
      <div class="finding-number"><strong><Fig f={m3(SA.eeg_ridge.equal_axis_mae)}/></strong><span><Parts p={copy.rFindLabel()}/></span></div>
      <div class="finding-copy"><h3>{copy.rFindH3}</h3><p><Parts p={copy.rFindP()}/></p></div>
    </div>
    <p class="protocol-note" data-pilot-note="refed-limits">{copy.rLimits}</p>
    <p class="citation-note" data-pilot-note="refed-source">{copy.rSource}{zh ? <><span lang="en">{names.refed}</span>，</> : ' '}<code>{VERSION.refed}</code>{zh ? '，' : ', '}<a href={D.refed.rights.licenseUrl} target="_blank" rel="noreferrer">{D.refed.rights.license}</a>{zh ? '，' : ', '}{copy.rGated}{sp}<a href={dataset('refed')}>{copy.datasetPage}</a> · <a href={creditsHref}>{copy.creditsLink}</a></p>
    <p class="citation-note" data-pilot-note="refed-audit">{copy.rAudit}</p>
  </section>

  <section class="topic-section" id="status-only" aria-labelledby="status-heading" data-pilot="status-only">
    <div class="topic-heading"><div><p class="eyebrow">{copy.soEyebrow}</p><h2 id="status-heading">{copy.soH2}</h2></div><p>{copy.soLede}</p></div>
    <div class="method-grid-wide">{statusEntries.map(s => <article class="status-entry" id={s.id} data-pilot-status={s.id}>
      <h3>{s.scope}</h3>
      <p><strong>{s.statement}</strong></p>
      <p>{s.reason}{zh && <span class="note-original" lang="en">{s.en}</span>}</p>
    </article>)}</div>
  </section>

  <section class="topic-section" id="methods-and-limits" aria-labelledby="limits-heading">
    <div class="topic-heading"><div><p class="eyebrow">{tc.methodsEyebrow}</p><h2 id="limits-heading">{copy.limitsH2}</h2></div></div>
    <h3 class="roadmap-h3">{copy.methodsH3}</h3>
    <div class="method-grid-wide" data-pilot-note="methods">{copy.methods().map(([h, p]) => <article><h3>{h}</h3><p><Parts p={p}/></p></article>)}</div>
    <h3 class="roadmap-h3">{copy.intervalsH3}</h3>
    <p class="roadmap-p" data-pilot-note="intervals">{copy.intervals}</p>
    <h3 class="roadmap-h3">{copy.limitsH3}</h3>
    <ul class="rd-rules" data-pilot-note="limits">{copy.limits.map(x => <li>{x}</li>)}</ul>
    <h3 class="roadmap-h3">{copy.notPubH3}</h3>
    <p class="roadmap-p" data-pilot-note="not-published">{copy.notPub}{sp}<a href="/data-use/#small-cohorts-pilots">{copy.smallCohorts}</a></p>
    <h3 class="roadmap-h3">{copy.creditsH3}</h3>
    <div class="citation-list" id="credits">
      {credits.map(x => <article data-credit={x.id}>
        <h3 lang="en">{x.r.name}</h3>
        <p lang="en">{x.r.attribution}</p>
        {x.gap
          ? <p data-consent={x.id} id="handwriting-rights"><strong>{copy.gapH}</strong>{sp}{x.gap}{zh && <span class="note-original" lang="en">{x.gapEn}</span>}</p>
          : <p data-consent={x.id}><strong>{copy.consentH}</strong>{sp}{copy.ethicsLabel}{zh ? '' : ' '}{x.ethics}{sp}{copy.consentLabel}{zh ? '' : ' '}{x.consent}{zh && <span class="note-original" lang="en">{x.en}</span>}</p>}
        <p><a href={x.r.source} target="_blank" rel="noreferrer">{copy.recordLink}</a>{x.paper && <> · <a href={x.paper} target="_blank" rel="noreferrer">{copy.paperLink}</a></>}{x.gap && <> · <a href={challengePaper.url} target="_blank" rel="noreferrer">{copy.challengePaperLink}</a></>}{x.id === 'bingo-imagined-speech' && doc.map(dd => <> · <a href={dd.url} target="_blank" rel="noreferrer" lang="en">{dd.title} ↗</a></>)} · {x.licenceLink ? <a href={x.r.licenseUrl} target="_blank" rel="noreferrer">{x.licence}</a> : x.licence}{x.readFrom !== x.paper && !doc.some(dd => dd.url === x.readFrom) && x.readFrom !== x.r.source ? <> · <a href={x.readFrom} target="_blank" rel="noreferrer">{copy.readFrom}</a></> : ''}</p>
      </article>)}
      <article data-credit="eegpt">
        <h3>{copy.eegptH}</h3>
        <p>{copy.eegptP}{sp}<a href={M.paper} target="_blank" rel="noreferrer" lang="en">{M.paper_title} ↗</a>{zh ? '；' : '; '}{copy.eegptCode}{sp}<a href={M.repository} target="_blank" rel="noreferrer">{M.repository.replace('https://github.com/', '')} ↗</a>{sp}{copy.eegptAt}{sp}<code>{M.source_revision}</code>{zh ? '；' : '; '}{copy.eegptCkpt}{sp}<code>{M.checkpoint.file}</code>{zh ? '，' : ', '}{copy.eegptSha}{sp}<code>{M.checkpoint.sha256}</code>{tc.period}</p>
        <p data-pilot-note="eegpt-licence">{copy.eegptLicence}</p>
      </article>
    </div>
    <p class="citation-note">{copy.derived}</p>
    <p class="citation-note">{tc.dataSource} <a href="/data/pilot-studies-update.json" download>pilot-studies-update.json</a> · {tc.schema} {pilot.schema_version}{tc.period}</p>
  </section>

  <section class="topic-section" id="related" aria-labelledby="related-heading">
    <div class="topic-heading"><div><h2 id="related-heading">{copy.relatedH2}</h2></div></div>
    <ul class="rd-rules" data-pilot-note="related">{copy.related.map(x => <li>{x.text}<a href={hrefFor(x.href, locale)}>{x.link}</a>{/[?？]$/.test(x.link) ? '' : zh ? '。' : '.'}</li>)}</ul>
  </section>
</TopicLayout>
