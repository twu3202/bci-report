---
/**
 * What can a small pilot show, and what can it not? (owner decisions 1 and 2, 2026-10-12): four small pilots, each
 * its own dataset, task and metric, none ranked — the Orthosis error events (one cohort of eight people in three
 * configurations, counted once: the 64-channel classical baseline, the same baseline on the 58 channels EEGPT
 * supports, and frozen EEGPT against those matched classical features); BINGO's inner speech in Greek and English
 * across people and across languages (a negative result near the prior); a mask-aware EEG analysis of a handwriting
 * competition dataset, five people, a data-quality and methods case study published by the owner's decision with its
 * rights gap stated (no ethics-approval or informed-consent statement was found); and a stored-clip computational
 * diagnostic on REFED. In "Other signals &
 * pilots", after the beyond-scalp page. EEGPT's directory card and method page link #orthosis (directory-status.ts).
 *
 * Every figure is a leaf of pilot-studies-update.json, printed with data-fig (Fig.astro) and re-read by
 * check-workbench.mjs. Rules, from the handoffs, their approval records and the manifest: aggregates only; the three
 * Orthosis results are one cohort, never counted twice and never new coverage, both configurations labelled and the
 * 64-channel result kept; the EEGPT comparison with its paired interval, which spans zero (neither arm shown better,
 * not equivalence, not a verdict on foundation models), beside its caveats (the same people, the 64-channel scores
 * seen first, pretraining overlap not excluded, a supervised probe, recorded device events); BINGO's near-prior result
 * as one baseline's negative result, its delivered preprocessing beside it as the project states it (not re-verified),
 * the project's own figure labelled as theirs; REFED's controls and the lookup lesson, two nominal folders, no
 * interval; the handwriting analysis with its controls, paired contrasts, availability counts and the earlier analysis
 * as context, its mask-only interval withheld (at five people its bounds would show individual scores), its rights gap
 * stated in full once, in the credits, and pointed to beside the result; a held pilot and the status-only arms print no
 * figure. Nothing pooled, nothing ranked, no per-person value. The sentences that summarise the export are checked against it below, and the page refuses to
 * build if the numbers stop supporting them.
 */
import pilot from '../../../data/pilot-studies-update.json';
import TopicLayout from '../../../components/TopicLayout.astro';
import Fig from '../../../components/Fig.astro';
import Parts from '../../../components/Parts.astro';
import IntervalPlot from '../../../components/IntervalPlot.astro';
import { hrefFor, localeOf, localeParams, topicCards, topicChrome } from '../../../data/i18n';
import { BINGO_RIGHTS_ZH, PILOT_ANCHOR, PILOT_PATH, formatFig, ppFmt, sgnFmt, type Fig as FigValue, type Fmt } from '../../../data/entities';
import { BINGO_HOLD, HANDWRITING_HOLD, bingoReleased, handwritingReleased } from '../../../data/pilot-switch';
import { EEGPT_PILOT_PATH } from '../../../data/directory-status';
import { holds } from '../../../data/releases';

export const getStaticPaths = localeParams;
const locale = localeOf(Astro.params.lang);
const zh = locale === 'zh';
const tc = topicChrome[locale];
// The space between two sentences or a sentence and its link: none in Chinese, after a full-width mark.
const sp = zh ? '' : ' ';
type Part = string | FigValue;
const PSF = 'pilot-studies-update.json';
const f = (raw: number, fmt: Fmt = 'pct1'): FigValue => ({ raw, fmt, src: PSF });
// The handwriting figures print two decimals, as the handoff states them: its arms differ by hundredths near 25%.
const f2 = (raw: number) => f(raw, 'pct2');
const p2 = (raw: number) => f(raw, 'pp2');
const s2 = (raw: number) => f(raw, 'sgn2');
const n = (raw: number) => f(raw, 'count');
const a3 = (raw: number) => f(raw, 'auc3');
const m3 = (raw: number) => f(raw, 'num3');
const sec = (raw: number) => f(raw, 's1');
const pp = (raw: number) => f(raw, ppFmt(raw));
const sg = (raw: number) => f(raw, sgnFmt(raw));
const F = (x: FigValue) => formatFig(x);
const ans = (x: FigValue) => `[[${F(x)}]]`;
const R = pilot.results;
const o64 = R['orthosis-64ch-classical'], o58 = R['orthosis-58ch-classical'], oep = R['orthosis-eegpt-vs-58ch'];
// BINGO and the handwriting analysis follow their publication switches (pilot-switch.ts): held, the export carries no
// result for one, and its section prints its hold.
const bingo = (R as Record<string, any>)['bingo-cross-language'], refed = R['refed-stored-clip'];
const hw = (R as Record<string, any>)['handwriting-mask-aware'];
const D = pilot.datasets as Record<string, any>;
const hold = holds.find(h => h.id === HANDWRITING_HOLD);
const exportHold = (pilot.holds as { id: string }[]).find(h => h.id === HANDWRITING_HOLD);

// --- The facts every sentence below rests on; the page refuses to build without them. -----------------------
const need = (ok: boolean, what: string) => { if (!ok) throw new Error(`pilot-studies: the copy says ${what}`); };
const says = (text: string, ...xs: string[]) => xs.forEach(x => need(text.includes(x), `"${x}" (the export says otherwise)`));
const same = (a: number, b: number) => Math.abs(a - b) < 1e-12;
const within = (x: number, iv: number[]) => iv[0] <= x && x <= iv[1];
need(PILOT_PATH === '/topics/pilot-studies/' && PILOT_ANCHOR.orthosis === 'orthosis' && PILOT_ANCHOR.bingo === 'bingo' && PILOT_ANCHOR.handwriting === 'handwriting'
  && PILOT_ANCHOR.refed === 'refed' && PILOT_ANCHOR.statusOnly === 'status-only' && EEGPT_PILOT_PATH === `${PILOT_PATH}#${PILOT_ANCHOR.orthosis}`, 'the anchors the dataset pages and EEGPT\'s directory card link to');
need(pilot.release_id === 'pilot-studies-update-20261012' && pilot.schema_version === 'bci-report-pilot-studies-update-v1', 'this release and schema');
need(Object.keys(R).join() === ['orthosis-64ch-classical', 'orthosis-58ch-classical', 'orthosis-eegpt-vs-58ch', ...(bingoReleased ? ['bingo-cross-language'] : []),
  ...(handwritingReleased ? ['handwriting-mask-aware'] : []), 'refed-stored-clip'].join(), 'the results the two switches release, in page order');
need(Object.values(R).every(r => r.leaderboard === false), 'no result joins a leaderboard');
// The handwriting analysis (owner decision, 2026-10-12): released with its rights gap stated; its switch holds it again.
need((D['eeg-fnirs-handwriting'].publication === 'released') === handwritingReleased && pilot.pilots.find(p => p.id === 'handwriting')?.publication === (handwritingReleased ? 'released' : 'status_only')
  && (handwritingReleased ? !hold && !exportHold : !!hold && !hold.closed && !!exportHold && hold.href === `${PILOT_PATH}#${PILOT_ANCHOR.handwriting}`),
  handwritingReleased ? 'the handwriting analysis is released, with no hold' : 'the handwriting analysis is held, its hold open and linked to its section');
need(['orthosis-error-detection', 'refed'].every(id => D[id].publication === 'released'), 'Orthosis and REFED are released');
// How many pilots and findings the page reports, and which pilots a switch holds.
const nPilots = 2 + Number(bingoReleased) + Number(handwritingReleased), nFindings = nPilots + 1;
const heldPilots = [...(bingoReleased ? [] : ['bingo']), ...(handwritingReleased ? [] : ['handwriting'])];
const bHold = holds.find(h => h.id === BINGO_HOLD), bExportHold = pilot.holds.find(h => h.id === BINGO_HOLD);
need((D['bingo-imagined-speech'].publication === 'released') === bingoReleased && pilot.pilots.find(p => p.id === 'bingo')?.publication === (bingoReleased ? 'released' : 'status_only')
  && (bingoReleased ? !bHold && !bExportHold : !!bHold && !bHold.closed && !!bExportHold && bHold.href === `${PILOT_PATH}#${PILOT_ANCHOR.bingo}`),
  bingoReleased ? 'BINGO is released, with no hold' : 'BINGO is held, its hold open and linked to its section');
need(pilot.status_only.map(s => s.id).join() === 'orthosis-emg-tinymyo-fusion,handwriting-fnirs-fusion,refed-physiological-fusion,meditation-eeg-phase', 'four status-only arms');

// Orthosis: one cohort, three configurations, counted once.
const C = o64.cohort;
for (const r of [o58, oep]) need(r.same_cohort_as === o64.id && (['people', 'runs', 'events', 'standard_events', 'error_events'] as const).every(k => r.cohort[k] === C[k]), 'the same cohort in all three configurations');
need(C.events === C.standard_events + C.error_events && C.people === 8 && o64.chance_level === 0.5, 'eight people, the events add up, chance is one half');
says(C.counted_once, 'one cohort, never counted twice');
need(o64.signal.eeg_channels === 64 && o58.signal.eeg_channels === 58 && oep.signal.eeg_channels === 58 && o64.configuration.label === '64-channel configuration' && o58.configuration.label === '58-channel configuration'
  && oep.configuration.label === '58-channel configuration', 'the two configurations, as the export names them');
need(o58.configuration.omitted_channels.length === o64.signal.eeg_channels - o58.signal.eeg_channels, 'six channels left out');
says(o58.configuration.rule, 'fixed before scoring', 'no substitution or score-based selection');
const E64 = o64.arms.eeg.balanced_accuracy, CF64 = o64.arms.confound.balanced_accuracy, PR64 = o64.arms.prior.balanced_accuracy, P64 = o64.permutation_control.balanced_accuracy;
need(E64.interval_95[0] > CF64.interval_95[1] && E64.interval_95[0] > PR64.mean && E64.interval_95[0] > P64.observed_range[1], 'the 64-channel interval lies above the confound probe, the prior and every permutation replicate');
need(PR64.mean === o64.chance_level && o64.arms.majority.balanced_accuracy.mean === o64.chance_level, 'the prior and the majority sit on chance');
const EMC = o64.eeg_minus_confound;
need(EMC.balanced_accuracy_difference.interval_95 === null && EMC.people_with_eeg_above_confound === EMC.people && EMC.people === C.people, 'no interval for EEG minus the confound; EEG above it for every person');
const C58 = o58.arms.classical58.balanced_accuracy, P58 = o58.permutation_control.balanced_accuracy;
need(C58.interval_95[0] > o58.arms.confound.balanced_accuracy.interval_95[1] && C58.interval_95[0] > P58.observed_range[1], 'the 58-channel baseline is above its controls too');
for (const m of ['balanced_accuracy', 'auroc', 'average_precision'] as const)
  need(same(oep.arms.classical58[m].mean, o58.arms.classical58[m].mean) && oep.arms.classical58[m].interval_95.every((x, i) => same(x, o58.arms.classical58[m].interval_95[i])), 'the comparison\'s classical rows are the 58-channel configuration\'s');
need(oep.classical_rows_same_as === o58.id && same(oep.permutation_control.classical58.balanced_accuracy_mean, P58.balanced_accuracy_mean), 'the same classical rows and permutations');
const EP = oep.arms.eegpt2048.balanced_accuracy, PD = oep.paired.balanced_accuracy_difference;
need(oep.paired.interval_excludes_zero === false && PD.interval_95[0] < 0 && PD.interval_95[1] > 0 && PD.mean < 0 && EP.mean < oep.arms.classical58.balanced_accuracy.mean, 'EEGPT is slightly below and the paired interval spans zero');
need(oep.paired.people === C.people && oep.encoder === 'frozen' && oep.fine_tuning === false && oep.lora === false, 'a frozen encoder on the same people');
says(oep.transfer, 'supervised', 'not zero-shot');
need(oep.pretraining_exposure.status === 'not established', 'pretraining overlap is not excluded');
says(oep.prior_exposure, '64-channel classical scores were seen before this comparison was frozen');
says(oep.reading, 'neither equivalence nor a general inferiority of EEG foundation models');
const M = oep.model;
need(M.name === 'EEGPT' && M.code_licence === 'Apache-2.0' && M.weights_licence === null && M.weights_distributed === false, 'EEGPT\'s code licence, its unresolved weights licence, no weights distributed');
says(M.code_licence_scope, 'source code only');
says(M.weights_licence_status, 'unresolved');
says(M.weights_note, 'no original or converted weights are distributed');
need(oep.encoder_input.channels === 58 && oep.encoder_input.sampling_hz === 256 && oep.signal.sampling_hz === 500, 'the encoder\'s native input');
says(oep.method.encoder, 'microvolts divided by 1000', 'the encoder frozen');
says(o64.method.filter, '1–30 Hz', 'uses no future samples');
says(o64.method.probe, 'C=1', 'no tuning');
says(oep.arms.eegpt2048.description, 'two temporal patches', 'no LoRA or fine-tuning');
says(o64.method.eligibility, 'does not depend on whether the person responded correctly');
const RC = o64.response_clean_subset;
need(RC.events === RC.error_events + RC.standard_events && RC.people_with_both_classes < C.people, 'the response-clean subset, counts only');
says(RC.status, 'counts only');
says(o64.limitations.join(' '), 'movement, muscle and device-injection artifacts may contribute', 'does not isolate a neural origin', 'not a reproduction of the authors’ competition score');
says(o64.uncertainty.kind, '10,000 person-level bootstrap draws');
says(oep.uncertainty.paired, 'matched per-person differences');
says(o64.independent_audit.not_checked, 'no model was refitted');
says(oep.independent_audit.not_checked, 'encoder features were not re-extracted');

// BINGO: four directions near the prior, the contrast spanning zero; the project's preprocessing as it states it.
const BC = bingo?.cohort, chance15 = bingo?.chance.balanced_accuracy, chance3 = bingo?.chance.top3_accuracy, dirs: any[] = bingo?.directions ?? [];
const C3 = bingo?.contrast, DS = bingo?.delivered_signal, PRJ = bingo?.project_reported, TL = bingo?.protocol.timeline_seconds;
if (bingoReleased) {
  need(bingo.classes === 15 && same(chance15, 1 / 15) && same(chance3, 3 / 15) && BC.trials === BC.source_fields * (BC.trials_per_held_out_field.greek + BC.trials_per_held_out_field.english), 'fifteen classes; the trials add up');
  need(BC.trials_per_held_out_field.greek === bingo.protocol.nouns * BC.trials_per_noun_and_language && BC.training_rows === (BC.source_fields - 1) * BC.trials_per_held_out_field.greek, 'trained on one language of the other fields');
  says(BC.counting_unit, 'source-defined subject fields', 'not independently certified');
  need(dirs.map(d => d.id).join() === 'train_gr_test_gr,train_gr_test_eng,train_eng_test_eng,train_eng_test_gr' && dirs.every(d => within(chance15, d.balanced_accuracy.interval_95)), 'four directions, every interval holding the prior');
  need(C3.interval_excludes_zero === false && C3.balanced_accuracy_difference.interval_95[0] < 0 && C3.balanced_accuracy_difference.interval_95[1] > 0
    && Object.values(C3.by_training_language).every(c => c.balanced_accuracy_difference.interval_95[0] < 0 && c.balanced_accuracy_difference.interval_95[1] > 0), 'the contrast spans zero, for either training language too');
  says(bingo.reading, 'does not show that inner speech cannot be decoded by other methods');
  says(bingo.uncertainty.kind, 'approximate descriptive', '10,000 field bootstrap draws');
  says(bingo.uncertainty.conditional_on, 'not calibrated population confidence intervals');
  need(DS.verified_against_file === false, 'the delivered preprocessing was not re-verified against the file');
  says(DS.statement, 'from 1 to 145 Hz', 'notch filtering at 50 Hz and its harmonics', 'Artifact Subspace Reconstruction (ASR)', 'FORCe removal of ocular and muscle artifacts', 'before any trial was cut');
  says(DS.source, 'D3.1, version 2.0', 'https://bingo-project.gr/download/397');
  says(PRJ.kind, 'reported by the BINGO project', 'not run here', 'not comparable');
  says(PRJ.source, 'D3.1, version 3.0', 'https://bingo-project.gr/download/402');
  says(PRJ.dataset, 'NATO-alphabet');
  says(PRJ.evaluation, 'EEGNet', 'leave-one-subject-out');
  need(PRJ.classes === 26 && same(PRJ.chance_level, 1 / PRJ.classes) && PRJ.mean_accuracy_percent.toFixed(2) === (PRJ.chance_level * 100).toFixed(2), 'the project reports chance, one in twenty-six');
  need(TL.fixation_inner_speech_onset === bingo.signal.window_seconds[0] && TL.end === bingo.signal.window_seconds[1] && bingo.protocol.repetitions_per_noun === BC.trials_per_noun_and_language, 'the inner-speech window is the protocol\'s');
  says(bingo.protocol.source, 'version 2.0');
  says(bingo.cohort.incomplete_field, 'one incomplete field excluded', 'no exclusion depended on a score');
  says(bingo.method.inputs, 'four relative bands partition 1–30 Hz', 'no guessed voltage calibration, montage interpolation or re-referencing');
  says(bingo.method.model, 'fixed alpha 1');
  says(bingo.limitations.join(' '), 'does not certify causal or online processing, brain-only signal origin');
  says(bingo.independent_audit.not_checked, 'raw file was not re-extracted');
}

// Handwriting: five people, four coded labels; relative EEG just above chance, above both mask controls, not separated
// from the clock; the mask-only interval withheld; the availability counts; the earlier analysis as context.
const HC = hw?.cohort, HA = hw?.arms, HK = hw?.contrasts, HV = hw?.availability, HE = hw?.earlier_analysis, HS = hw?.label_shuffle?.representations;
const HR = D['eeg-fnirs-handwriting'].consent_and_ethics;
if (handwritingReleased) {
  need(HC.people === 5 && HC.classes === 4 && HC.trials === HC.events - HC.quarantined_events && same(hw.chance_level, 1 / HC.classes), 'five people, four coded labels; the trials add up');
  says(hw.task, 'not handwriting recognition');
  says(HC.reuse, 'not a new or independent cohort');
  says(HC.official_test, 'were not used');
  need(HA.majority.balanced_accuracy.mean === hw.chance_level && HA.majority.balanced_accuracy.interval_95.every((x: number) => x === hw.chance_level), 'the majority control scores chance for every person');
  need(HA.mask_only.balanced_accuracy.interval_95 === null && /individual people’s scores/.test(HA.mask_only.interval_note), 'the mask-only interval is withheld, and why');
  need(['relative_eeg', 'time_only', 'mask_plus_time'].every(k => HA[k].balanced_accuracy.interval_95.length === 2), 'the other arms carry their intervals');
  need(HA.relative_eeg.balanced_accuracy.interval_95[0] > hw.chance_level, 'the relative-EEG interval lies above chance');
  const tk = HK.relative_eeg_minus_time_only.balanced_accuracy_difference.interval_95;
  need(HK.relative_eeg_minus_mask_only.interval_excludes_zero && HK.relative_eeg_minus_mask_plus_time.interval_excludes_zero && !HK.relative_eeg_minus_time_only.interval_excludes_zero && tk[0] < 0 && tk[1] > 0,
    'above both mask controls, and the elapsed-time contrast crosses zero');
  need(Object.keys(HS).join() === 'relative_eeg,mask_only,time_only,mask_plus_time' && Object.values(HS).every((x: any) => x.replicates === 5), 'five shuffles for each representation');
  says(hw.label_shuffle.design, 'not a full permutation significance test');
  const bins = HV.trials_by_available_channels as { channels: number; trials: number }[];
  need(bins.reduce((a, x) => a + x.trials, 0) === HC.trials && HV.available_channels_per_trial.fewest === bins[0].channels && HV.available_channels_per_trial.most === bins[bins.length - 1].channels
    && HV.channel_trials === HC.trials * HV.channels_recorded, 'the availability histogram covers every scored trial');
  need(HV.flags.upper_rail === 0 && HV.flags.nonfinite === 0 && HV.flags.invalid_denominator === 0, 'no upper-rail, non-finite or invalid-denominator flag');
  says(HV.flags_note, 'must not be summed');
  says(HV.available_means, 'not certified clean physiological EEG');
  says(HV.scope, 'selected cohort only');
  says(HE.relation, 'not a second cohort');
  says(HE.not_attributable, 'cannot be attributed to masking', 'no best model is selected');
  need(HE.quality_findings.windows_with_a_rail_sample === HE.quality_findings.windows && HE.quality_findings.windows === HC.trials, 'every earlier window had a rail sample');
  says(hw.uncertainty.kind, '10,000 fixed-seed person-bootstrap draws');
  says(hw.uncertainty.conditional_on, 'not calibrated population confidence intervals');
  need(hw.independent_audit.largest_refit_difference === 0 && hw.independent_audit.refitted_shuffle_models === 0, 'the audit refitted the true-label models exactly, and no shuffle model');
  says(hw.independent_audit.not_checked, 'raw samples were not reread');
  need(HR.ethics_approval.stated === false && HR.informed_consent.stated === false && /^owner decision/.test(HR.basis) && HR.searched.length === 3
    && HR.gap.startsWith('No ethics-approval or informed-consent statement was found.'), 'the handwriting rights: no statement found, where it was looked for, the owner\'s decision');
}

// REFED: EEG Ridge has the largest error in both conditions; the lookup lesson; two nominal folders, no interval.
const RF = refed.cohort, [shared, joint] = refed.conditions;
need(RF.nominal_folders === 2 && RF.clips === RF.nominal_folders * RF.videos && shared.id === 'shared_videos_held_folder' && joint.id === 'held_folder_and_videos', 'two folders, the same videos, two conditions');
for (const c of [shared, joint]) {
  const A = c.arms;
  need(A.eeg_ridge.equal_axis_mae > Math.max(A.source_global_mean.equal_axis_mae, A.source_video_lookup.equal_axis_mae, A.duration_video_id_ridge.equal_axis_mae) && c.clips_scored === RF.clips, `EEG Ridge has the largest error (${c.id})`);
}
need(shared.arms.source_video_lookup.equal_axis_mae < Math.min(shared.arms.source_global_mean.equal_axis_mae, shared.arms.duration_video_id_ridge.equal_axis_mae) && shared.lookup_matched_videos === RF.clips,
  'with shared videos the lookup has the smallest error');
need(joint.arms.source_video_lookup.equal_axis_mae === joint.arms.source_global_mean.equal_axis_mae && joint.lookup_matched_videos === 0, 'held out together, the lookup finds no video and equals the global mean');
need(refed.metric.lower_is_better && refed.uncertainty.kind.startsWith('none'), 'lower is better; no interval');
says(refed.target.scale, 'from 1 to 255');
says(refed.target.meaning, 'not SAM scores');
says(refed.controls_lesson, 'does not establish a mechanism');
says(refed.limitations.join(' '), 'exceed the stored arrays by two seconds', 'not untouched targets', 'key-index proxy, not established presentation order');
need(refed.quality.clips_or_channels_removed === 0 && refed.quality.channel_clip_rows === RF.clips * o64.signal.eeg_channels, 'every clip passed the numerical checks');
says(refed.quality.note, 'numerical eligibility only');
says(refed.method.inputs, '[1,4)', '[30,45) Hz', 'each divided by that channel’s [1,45) Hz total');
says(refed.method.model, 'Ridge with fixed alpha 1', 'unclipped');
says(refed.independent_audit.not_checked, 'no model was refitted');

// --- What the charts draw: every value and interval inside its axis. ----------------------------------------
const baDomain: [number, number] = [0.4, 0.8], ppDomain: [number, number] = [-0.1, 0.1];
const bDomain: [number, number] = [0.03, 0.11], cDomain: [number, number] = [-0.02, 0.02], mDomain: [number, number] = [0, 120];
const inside = (d: [number, number], ...xs: number[]) => xs.every(x => x > d[0] && x < d[1]);
need(inside(baDomain, E64.mean, ...E64.interval_95, CF64.mean, ...CF64.interval_95, P64.balanced_accuracy_mean, EP.mean, ...EP.interval_95, C58.mean, ...C58.interval_95,
  oep.permutation_control.eegpt2048.balanced_accuracy_mean), 'every Orthosis balanced accuracy fits its axis, 40% to 80%');
need(inside(ppDomain, PD.mean, ...PD.interval_95), 'the paired difference fits its axis, ±10 pp');
need(dirs.every(d => inside(bDomain, d.balanced_accuracy.mean, ...d.balanced_accuracy.interval_95)), 'every BINGO direction fits its axis, 3% to 11%');
if (bingoReleased) need(inside(cDomain, C3.balanced_accuracy_difference.mean, ...C3.balanced_accuracy_difference.interval_95,
  ...Object.values(C3.by_training_language).flatMap((c: any) => [c.balanced_accuracy_difference.mean, ...c.balanced_accuracy_difference.interval_95])), 'every BINGO contrast fits its axis, ±2 pp');
need([shared, joint].every(c => Object.values(c.arms).every(a => inside(mDomain, a.equal_axis_mae))), 'every REFED error fits its axis, 0 to 120');
const hDomain: [number, number] = [0.22, 0.3], hcDomain: [number, number] = [-0.04, 0.04];
const HARMS = ['relative_eeg', 'mask_only', 'time_only', 'mask_plus_time', 'majority'] as const;
const HCONTRASTS = ['relative_eeg_minus_mask_only', 'relative_eeg_minus_time_only', 'relative_eeg_minus_mask_plus_time'] as const;
if (handwritingReleased) {
  need(inside(hDomain, hw.chance_level, ...['relative_eeg', 'mask_only', 'time_only', 'mask_plus_time', 'majority'].map(k => HA[k].balanced_accuracy.mean),
    ...['relative_eeg', 'time_only', 'mask_plus_time'].flatMap(k => HA[k].balanced_accuracy.interval_95)), 'every handwriting balanced accuracy fits its axis, 22% to 30%');
  need(Object.values(HK).every((c: any) => inside(hcDomain, c.balanced_accuracy_difference.mean, ...c.balanced_accuracy_difference.interval_95)), 'every handwriting contrast fits its axis, ±4 pp');
}

// --- Names, in both languages. ------------------------------------------------------------------------------------
const arm = {
