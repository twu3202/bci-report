---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import EntityLayout from '../../../components/EntityLayout.astro';
import ResultGroups from '../../../components/ResultGroups.astro';
import profiles from '../../../data/entity-profiles.json';
import { bingoRights, datasets, handwritingRights, methodLabel, tr, type DatasetEntity } from '../../../data/entities';
import { entityCopy } from '../../../data/entity-copy';
import { directoryText, hrefFor, locales, defaultLocale, localeOf, registerCopy, topicCards, type Locale } from '../../../data/i18n';
import { elsewhere, site } from '../../../data/site';
import { openRegister, requestedCitations } from '../../../data/releases';
import { registerServed } from '../../../data/files';
import { topicPages } from '../../../data/topics';
import { protocolLinkLabel } from '../../../data/protocols';
import { creator } from '../../../data/structured';
import { boasConditions, boasStatements, srText } from '../../../data/shared-encoder';
import Fig from '../../../components/Fig.astro';
import { DQ_PATH, dcFig, dqText, kim } from '../../../data/data-quality';

// Every dataset page links its row in the open register (/datasets/register/#r-site-<slug>). The rows are read from the
// bytes the site serves, by the name releases.ts gives the newest register file, and only when that file is served
// (files.ts `registerServed`), so a build without it links nowhere that does not exist. With it, a page whose row is
// missing, or whose row names another page, refuses to build.
export const getStaticPaths = () => {
  type Row = { id: string; ladder: string; site?: { page?: string } };
  const rows = registerServed
    ? new Map((JSON.parse(readFileSync(resolve('public/data', openRegister.json), 'utf8')).entries as Row[]).map(r => [r.id, r]))
    : null;
  const rowOf = (slug: string) => {
    if (!rows) return null;
    const id = `r-site-${slug}`, row = rows.get(id);
    if (!row || row.ladder !== 'dataset' || row.site?.page !== `/datasets/${slug}/`)
      throw new Error(`datasets/[slug]: ${openRegister.json} has no dataset row ${id} for /datasets/${slug}/`);
    return id;
  };
  return locales.flatMap(code => datasets.map(d => ({
    params: { lang: code === defaultLocale ? undefined : code, slug: d.slug }, props: { dataset: d, registerRow: rowOf(d.slug) },
  })));
};
const { dataset: d, registerRow } = Astro.props as { dataset: DatasetEntity; registerRow: string | null };
const locale = localeOf(Astro.params.lang);
const c = entityCopy[locale];
const path = `/datasets/${d.slug}/`;
const profile = (profiles.datasets as Record<string, { aliases: string[]; summary_en: string; summary_zh: string; facts_sources: string[] }>)[d.slug];
const methodNames = [...new Set(d.groups.flatMap(g => g.rows.filter(r => !r.comparator).map(r => r.method)))];
// The page's own description names the methods as the page prints them.
const methodLabels = [...new Set(d.groups.flatMap(g => g.rows.filter(r => !r.comparator).map(r => methodLabel(r, locale))))];
const listed = (xs: string[]) => xs.length <= 5 ? xs.join(', ') : `${xs.slice(0, 5).join(', ')} …`;
const pages = d.groups.map(g => g.path).filter((p, i, all) => all.findIndex(q => q.split('#')[0] === p.split('#')[0]) === i);
const pageLabel = (p: string) => { const s = p.match(/^\/topics\/([^/]+)\//)?.[1]; return s ? topicCards[locale][s].question : (protocolLinkLabel(p, locale) ?? (locale === 'zh' ? '核心矩阵（首页）' : 'Core matrix (home page)')); };
const files = [...new Set(d.groups.flatMap(g => g.rows.map(r => r.value.src)))];
// Every file a printed figure is a leaf of, chance levels included; the cite block names their releases.
const figFiles = [...new Set(d.groups.flatMap(g => [...(g.chance ? [g.chance] : []),
  ...g.rows.flatMap(r => [r.value, ...(r.interval ?? []), ...(r.of ? [r.of] : [])])].map(f => f.src)))];
// A citation the source asks for that the released credit line does not carry (see releases.ts).
const requested = requestedCitations[d.slug];
// The licence note as the home page's register prints it (directory-zh.json).
const licence = directoryText(d.license, locale);
const abs = (p: string) => new URL(p, site.origin).href;
// BOAS (2026-10-07): its register entry prints the ethics committee and reference and the written consent as its
// rights record gives them; its three stated gaps travel with its figures, in the result group above.
const zh = locale === 'zh';
// BETA's link to route 3's follow-up tests, which read its held-out frequencies (owner decision D1): navigation, no
// figure, while topics.ts lists that question.
const ssvepFollowUps = d.slug === 'beta' && topicPages.some(t => t.slug === 'new-ssvep-frequencies')
  ? { lead: zh ? 'BETA 留出频率上的后续检验：' : 'Follow-up tests on BETA’s held-out frequencies: ', question: topicCards[locale]['new-ssvep-frequencies'].question }
  : null;
// A long-form write-up that reads this dataset (site.ts `elsewhere`; BETA's, owner decision D8): one low-key line at
// the end of the source section, as questions-in-language's #ql-article. It prints no figure.
const article = elsewhere.articles.find(a => a.page === path);
const articleCopy: Record<string, Record<Locale, [string, string]>> = {
  'cca-and-frozen-eeg-foundation-models-on-beta': {
    en: ['A longer write-up of the core-matrix results on BETA is on Hugging Face: ', 'CCA and frozen EEG foundation models on BETA ↗'],
    zh: ['', 'BETA 核心矩阵部分结果的长文解读（英文，Hugging Face）↗'],
  },
};
if (article && !articleCopy[article.id]) throw new Error(`datasets/[slug]: no article line for ${article.id} on ${path}`);
const rights = d.rightsNote === 'boas' ? { ...boasStatements(), conditions: boasConditions(locale) } : null;
// BINGO (owner decision 3, 2026-10-12): its rights exactly as they stand — no ethics-approval reference, and the
// project's consent statement, which is about its other dataset — beside its credit, read from the export.
const bingo = d.rightsNote === 'bingo' ? bingoRights() : null;
// The handwriting dataset (owner decision, 2026-10-12): published with its rights gap stated. The data-use page states
// it in full; here, beside the credit, a short pointer to it.
const handwriting = d.rightsNote === 'handwriting' ? handwritingRights() : null;
// A source that states no licence has none to link or to compute under.
const noLicence = d.license === 'No licence stated';
// Kim beta-range (owner decision D21, 2026-10-28): its facts and names, a pointer to its worked case on the data-quality
// page, and its ethics and consent as the data descriptor states them, read from dataset-checks-update.json (data-quality.ts
// holds them to the export's fields). The page links no method page. Its subtitle is its entity profile's summary; the
// facts block below stands in for the profile's own (names and sources), so the names print once.
const kimCase = d.slug === kim.id ? (() => {
  const said = (en: string) => dqText(en, locale);
  const KC = kim.consent_and_ethics;
  if (kim.dataset_page !== path || kim.method_link !== false || d.groups.some(g => g.rows.some(r => r.methodSlug)))
    throw new Error(`datasets/[slug]: ${path} is Kim beta-range's page, with no method link`);
  return {
    said, aliases: kim.aliases as string[], task: said(kim.rights.task), version: said(kim.rights.version), intake: said(kim.intake.text),
    cohort: [kim.cohort.participants, kim.cohort.blocks, kim.cohort.trials].map((x: number) => dcFig(x, 'count')),
    sources: [kim.rights.source, KC.read_from] as string[], question: said(kim.question).text, href: hrefFor(`${DQ_PATH}#${kim.section}`, locale),
    ethics: said(KC.ethics_approval.quote), consent: said(KC.informed_consent.quote), sharing: said(KC.informed_consent.data_sharing_quote),
    scope: said(KC.informed_consent.scope_note), cited: said(kim.rights.terms.paper_cited_version.note), readFrom: KC.read_from as string,
  };
})() : null;
// A dataset that is not EEG names its own signal in its title (2026-10-12).
const signal = d.signal ? tr(d.signal, locale) : undefined;
const structured = {
  '@context': 'https://schema.org', '@type': 'Dataset',
  name: `${site.name}: results on ${d.name}`,
  description: c.datasetDescription(d.name, d.task.en, listed(methodNames), d.signal?.en),
  url: abs(path), license: 'https://creativecommons.org/licenses/by/4.0/', isAccessibleForFree: true,
  creator,
  isBasedOn: d.sources, citation: requested ? [d.attribution, requested.text] : d.attribution, measurementTechnique: d.technique ?? 'Electroencephalography',
  keywords: [d.technique ?? 'EEG', 'brain-computer interface', d.name, ...(profile?.aliases ?? [])],
  variableMeasured: [...new Set(d.groups.flatMap(g => g.rows.map(r => r.metric.en)))],
  distribution: files.map(f => ({ '@type': 'DataDownload', encodingFormat: f.endsWith('.csv') ? 'text/csv' : 'application/json', contentUrl: abs(`/data/${f}`) })),
};
---
<EntityLayout
  locale={locale} path={path} active="datasets"
  documentTitle={c.datasetTitle(d.name, signal)}
  h1={c.datasetH1(d.name, signal)} name={d.name}
  description={c.datasetDescription(d.name, tr(d.task, locale), listed(methodLabels), signal)}
  eyebrow={tr(d.task, locale)}
  dek={profile ? (locale === 'zh' ? profile.summary_zh : profile.summary_en) : c.datasetsDek}
  crumbs={[{ label: c.home, href: hrefFor('/', locale) }, { label: c.datasetsTitle, href: hrefFor('/datasets/', locale) }, { label: d.name, en: true }]}
  structured={structured}
  cite={{ files: figFiles, upstream: 'dataset' }}
>
  {profile && !kimCase && <section class="entity-profile" aria-label={c.whatItIs}>
    {profile.aliases.length > 0 && <p class="entity-aliases"><strong>{c.alsoKnownAs}</strong> <span lang="en">{profile.aliases.join(' · ')}</span></p>}
    <p class="citation-note">{c.profileSource} {profile.facts_sources.map((u, i) => <>{i > 0 && ' · '}<a href={u} target="_blank" rel="noreferrer">{new URL(u).hostname}</a></>)}</p>
  </section>}
  {kimCase && <section class="entity-profile" aria-label={c.whatItIs} data-dataset-facts={d.slug}>
    <p class="entity-aliases"><strong>{c.alsoKnownAs}</strong> <span lang="en">{kimCase.aliases.join(' · ')}</span></p>
    <ul class="rd-rules" data-kim-facts="true">
      <li>{kimCase.task.text}</li>
      <li>{c.kimCohort[0]}<Fig f={kimCase.cohort[0]} cls="num"/>{c.kimCohort[1]}<Fig f={kimCase.cohort[1]} cls="num"/>{c.kimCohort[2]}<Fig f={kimCase.cohort[2]} cls="num"/>{c.kimCohort[3]}</li>
      <li>{kimCase.intake.text}</li>
      <li>{kimCase.version.text}{zh ? '。' : '.'}</li>
    </ul>
    <p class="citation-note">{c.profileSource} {kimCase.sources.map((u, i) => <>{i > 0 && ' · '}<a href={u} target="_blank" rel="noreferrer">{new URL(u).hostname}</a></>)}</p>
  </section>}
  <section class="topic-section" aria-labelledby="appears-heading">
    <h2 id="appears-heading">{c.appearsIn}</h2>
    <ul class="entity-links">{pages.map(p => <li><a href={hrefFor(p, locale)}>{pageLabel(p)}</a></li>)}</ul>
    {ssvepFollowUps && <p class="citation-note" id="ssvep-follow-ups">{ssvepFollowUps.lead}<a href={hrefFor('/topics/new-ssvep-frequencies/', locale)}>{ssvepFollowUps.question}</a></p>}
    {/* A dataset's figure-free line to topic sections that read it without a group here (entities.ts `related`). */}
    {d.related && <p class="citation-note" id="related-follow-ups">{tr(d.related.lead, locale)}{d.related.links.map((x, i) => <>{i > 0 && ' · '}<a href={hrefFor(x.href, locale)}>{tr(x.label, locale)}</a></>)}</p>}
    {kimCase && <p class="citation-note" id="cca-baseline">{c.kimCase}{zh ? '' : ' '}<a href={kimCase.href}>{kimCase.question} →</a></p>}
  </section>
  <section class="topic-section" aria-labelledby="results-heading">
    <div class="topic-heading"><div><h2 id="results-heading">{c.results}</h2></div><p>{c.resultsLede}</p></div>
    <ResultGroups locale={locale} groups={d.groups}/>
  </section>
  <section class="topic-section" id="methods-and-limits" aria-labelledby="source-heading">
    <h2 id="source-heading">{c.source}</h2>
    <div class="citation-list"><article>
      <h3 lang="en">{d.name}</h3>
      <p><strong>{c.attribution}</strong> <span lang="en">{d.attribution}</span></p>
      {requested && <p><strong>{c.requestedCitation}</strong> <span lang="en">{requested.text}</span> <a href={requested.url} target="_blank" rel="noreferrer">doi ↗</a> · <a href={requested.basis} target="_blank" rel="noreferrer">{c.requestedBasis}</a></p>}
      <p>{noLicence ? <span data-licence="none">{c.noLicence}</span> : d.licenseUrl ? <a href={d.licenseUrl} target="_blank" rel="noreferrer" lang={licence.lang}>{licence.text} ↗</a> : <span lang={licence.lang}>{licence.text}</span>}{!noLicence && licence.original && <> <span class="note-original-inline" lang="en">({licence.original})</span></>} · {d.sources.map((u, i) => <>{i > 0 && ' · '}<a href={u} target="_blank" rel="noreferrer">{i === 0 ? c.record : `${new URL(u).hostname} ↗`}</a></>)}</p>
      <p data-redistribution={noLicence ? 'no-licence' : 'licence'}>{noLicence ? c.notRedistributedNoLicence : c.notRedistributed}</p>
    </article>
    {rights && <article data-rights-note="boas">
      <h3>{zh ? '发布者陈述的伦理与知情同意' : 'Ethics and consent, as the publisher states them'}</h3>
      {[rights.ethics, rights.consent].map(en => { const t = srText(en, locale); return <p>{t.text}{t.original && <span class="note-original" lang="en">{t.original}</span>}</p>; })}
      <p>{zh ? `所有者于 ${rights.conditions.approvedOn} 批准以“说明缺口后发布”的方式发布 BOAS 的队列汇总结果。${rights.conditions.participants}`
             : `The owner approved publishing BOAS cohort aggregates with stated gaps on ${rights.conditions.approvedOn}. ${rights.conditions.participants}`}</p>
    </article>}
    {bingo && <article data-rights-note="bingo">
      <h3>{c.bingoRightsH}</h3>
      <p>{c.bingoEthics}{zh ? '' : ' '}{tr(bingo.ethics, locale)}{zh && <span class="note-original" lang="en">{bingo.ethics.en}</span>}</p>
      <p>{c.bingoConsent}{zh ? '' : ' '}{tr(bingo.consent, locale)}{zh && <span class="note-original" lang="en">{bingo.consent.en}</span>}</p>
      <p>{c.bingoBasis}{zh ? '' : ' '}{c.bingoReadFrom}{zh ? '' : ' '}<a href={bingo.readFrom} target="_blank" rel="noreferrer" lang="en">{bingo.readFromTitle} ↗</a>{zh ? '。' : '.'} <a href="/data-use/#bingo-rights">{c.bingoDataUse}</a></p>
    </article>}
    {kimCase && <article data-rights-note={d.slug}>
      <h3>{c.kimRightsH}</h3>
      <p><strong>{c.kimEthics}</strong>{zh ? '' : ' '}“{kimCase.ethics.text}”{kimCase.ethics.original && <span class="note-original" lang="en">“{kimCase.ethics.original}”</span>}</p>
      <p><strong>{c.kimConsent}</strong>{zh ? '' : ' '}“{kimCase.consent.text}”{kimCase.consent.original && <span class="note-original" lang="en">“{kimCase.consent.original}”</span>}</p>
      <p>{c.kimAlsoStates}{zh ? '' : ' '}“{kimCase.sharing.text}”{kimCase.sharing.original && <span class="note-original" lang="en">“{kimCase.sharing.original}”</span>}</p>
      <p>{kimCase.scope.text}</p>
      <p>{kimCase.cited.text}</p>
      <p><a href={kimCase.readFrom} target="_blank" rel="noreferrer">{c.kimDescriptor}</a></p>
    </article>}
    {handwriting && <article data-rights-note="handwriting">
      <h3>{c.handwritingRightsH}</h3>
      <p>{tr(handwriting.pointer, locale)}{zh && <span class="note-original" lang="en">{handwriting.pointer.en}</span>} <a href="/data-use/#handwriting-rights">{c.handwritingDataUse}</a></p>
    </article>}</div>
    {registerRow && <p class="citation-note" id="register-row" data-register-row={registerRow}><a href={hrefFor(`/datasets/register/#${registerRow}`, locale)}>{registerCopy[locale].rowLink}</a></p>}
    {article && <p class="citation-note" id="ds-article">{articleCopy[article.id][locale][0]}<a href={article.url} target="_blank" rel="noreferrer" hreflang="en">{articleCopy[article.id][locale][1]}</a></p>}
    <p class="citation-note"><a href={hrefFor('/datasets/', locale)}>{c.allDatasets}</a> · <a href={hrefFor('/methods/', locale)}>{c.allMethods}</a></p>
  </section>
</EntityLayout>
