---
import EntityLayout from '../../../components/EntityLayout.astro';
import data from '../../../data/mvp.json';
import { datasets, tr } from '../../../data/entities';
import { entityCopy } from '../../../data/entity-copy';
import { datasetStatus, datasetTask, directoryText, hrefFor, localeOf, localeParams } from '../../../data/i18n';
import { site } from '../../../data/site';
import DataRegister from '../../../components/DataRegister.astro';
import '../../../styles/directory.css';

export const getStaticPaths = localeParams;
const locale = localeOf(Astro.params.lang);
const c = entityCopy[locale];
const people = (d: typeof datasets[number]) => [...new Set(d.groups.flatMap(g => g.rows.map(r => r.people)).filter(Boolean))].sort((a, b) => a - b).join(' / ') || '—';
const notScored = data.datasets.filter(d => d.status !== 'Aggregate results');
const structured = {
  '@context': 'https://schema.org', '@type': 'DataCatalog', name: `${site.name}: datasets with published results`,
  url: new URL('/datasets/', site.origin).href, description: c.datasetsDescription,
  dataset: datasets.map(d => ({ '@type': 'Dataset', name: `${site.name}: results on ${d.name}`, url: new URL(`/datasets/${d.slug}/`, site.origin).href })),
};
---
<EntityLayout locale={locale} path="/datasets/" active="datasets"
  documentTitle={c.datasetsH1} h1={c.datasetsH1} description={c.datasetsDescription}
  eyebrow={c.datasetsTitle} dek={c.datasetsDek}
  crumbs={[{ label: c.home, href: hrefFor('/', locale) }, { label: c.datasetsTitle }]}
  structured={structured}>
  <section class="topic-section" aria-labelledby="with-results">
    <h2 id="with-results">{c.datasetsWithResults}</h2>
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={c.datasetsRegion}>
      <table>
        <thead><tr><th scope="col">{c.colDataset}</th><th scope="col">{c.colTask}</th><th scope="col">{c.colPeople}</th><th scope="col">{c.colAppears}</th><th scope="col">{c.colLicense}</th></tr></thead>
        <tbody>{datasets.map(d => <tr>
          <th scope="row"><a href={hrefFor(`/datasets/${d.slug}/`, locale)} lang="en">{d.name}</a></th>
          <td>{tr(d.task, locale)}</td>
          <td>{people(d)}</td>
          <td>{c.groupsCount(d.groups.length)}</td>
          <td lang={directoryText(d.license, locale).lang}>{directoryText(d.license, locale).text}{directoryText(d.license, locale).original && <span class="note-original" lang="en">{directoryText(d.license, locale).original}</span>}</td>
        </tr>)}</tbody>
      </table>
    </div>
    {datasets.some(d => d.rightsNote === 'boas') && <p class="protocol-note" data-boas-pointer="true">{locale === 'zh'
      ? <>BOAS 在说明三处缺口后发布：知情同意声明没有说明是否同意公开共享或二次使用；伦理与知情同意的陈述只来自发布者，没有同行评审论文描述它；伦理批件编号在 1.1.1 版才加入，没有写明批准日期。见<a href={hrefFor('/datasets/boas/', locale)}>它的页面</a>。</>
      : <>BOAS is published with three stated gaps: its consent statement does not say whether participants agreed to public sharing or secondary use; its ethics and consent statements come only from the publisher, and no peer-reviewed paper describes it; its ethics reference was added in version 1.1.1 with no approval date. See <a href={hrefFor('/datasets/boas/', locale)}>its page</a>.</>}</p>}
  </section>
  <section class="topic-section" aria-labelledby="not-scored">
    <div class="topic-heading"><div><h2 id="not-scored">{c.datasetsNotScored}</h2></div><p>{c.datasetsNotScoredLede}</p></div>
    <ul class="entity-links">{notScored.map(d => <li><a href={d.source} target="_blank" rel="noreferrer" lang="en">{d.name} ↗</a> · {datasetTask(d.task, locale)} · {datasetStatus(d.status, locale)}</li>)}</ul>
    <p class="citation-note"><a href={hrefFor('/methods/', locale)}>{c.allMethods}</a></p>
  </section>
  <DataRegister locale={locale} />
</EntityLayout>
