---
/**
 * /protocols/<id>/: one core-matrix protocol, whole, with every method's result.
 *
 * The home page shows the same protocol in a tab whose content JavaScript swaps
 * in; this page is the address for it. Everything printed comes from the track
 * as released (src/data/protocols.ts): figures carry data-fig and are re-read
 * from this protocol's own results CSV and protocol JSON by check-workbench.mjs;
 * prose is the payload's English text, verbatim — except the privacy review,
 * which the page summarises in one sentence, beside the register's reviewed
 * rights note and any consent caveat, and links (see protocols.ts), and a JSON
 * fragment in the version text, printed as its fields.
 */
import EntityLayout from '../../../components/EntityLayout.astro';
import Fig from '../../../components/Fig.astro';
import IntervalPlot from '../../../components/IntervalPlot.astro';
import data from '../../../data/mvp.json';
import { protocols, versionText, type Protocol } from '../../../data/protocols';
import { formatFig } from '../../../data/entities';
import { protocolCopy } from '../../../data/entity-copy';
import { defaultLocale, directoryText, familyLabel, hrefFor, localeOf, locales, metricLabel, trackShort, trackTitle } from '../../../data/i18n';
import { protocolDataset } from '../../../data/structured';
import { FM_ABLATION_ANCHOR, FM_ADAPTATION_ANCHOR, FM_ANCHOR, fmAdaptation, fmAdaptationMeta, fmExposure, fmNotAdapted, fmRelease,
         fmResearchUse, type FmRow } from '../../../data/foundation-models';
import { fmAdaptationContext } from '../../../data/foundation-models';
import { fmText, fmZh } from '../../../data/foundation-models-zh';
import FmRowView from '../../../components/FmRow.astro';
import FmLicences from '../../../components/FmLicences.astro';

export const getStaticPaths = () => locales.flatMap(code => protocols.map(p => ({
  params: { lang: code === defaultLocale ? undefined : code, id: p.id }, props: { protocol: p },
})));
const { protocol: p } = Astro.props as { protocol: Protocol };
const locale = localeOf(Astro.params.lang);
const c = protocolCopy[locale];
const path = `/protocols/${p.id}/`;
// Payload prose stays English on the Chinese page, marked so.
const payloadLang = locale === 'en' ? undefined : 'en';
const title = trackTitle(p.title, locale);
const sep = locale === 'zh' ? '、' : ', ';
// The idle protocol has no chance level; its description says what it has instead.
const hasChance = p.chance !== undefined;
const description = c.protocolDescription(title, p.dataset, p.subtitle, p.rows.map(r => r.name).join(sep), hasChance);
const track = data.tracks.find(t => t.id === p.id)!;
const structured = protocolDataset(track,
  protocolCopy.en.protocolDescription(p.title, p.dataset, p.subtitle, p.rows.map(r => r.name).join(', '), hasChance),
  p.requested?.text);
const plot = p.type === 'accuracy' ? p.rows.filter(r => r.interval) : [];
const notes = [...new Set(p.rows.map(r => r.note))];
const others = protocols.filter(x => x.id !== p.id);
const colon = locale === 'zh' ? '：' : ': ';
// The licence note as the register on the home page prints it (directory-zh.json),
// with the released English beside the Chinese.
const licence = directoryText(p.license, locale);
// The dataset's reviewed rights note, as the register prints it (Chinese with the English beside it).
const register = p.registerNote ? directoryText(p.registerNote, locale) : undefined;
const consentCaveat = c.consentCaveat[p.id];

// --- The v9 rows (2026-10-04) --------------------------------------------------
const tradeoff = p.type === 'tradeoff';
const fmAll = [...p.fm.matrix, ...p.fm.ablation];
// One footnote per distinct text, numbered in the order the rows meet them.
const footnotes = [...new Set(fmAll.map(r => r.model.footnote))];
const fnOf = (r: FmRow) => footnotes.indexOf(r.model.footnote) + 1;
const fnId = (n: number) => `fn-v9-${n}`;
// The released rows (grey), then the v9 matrix rows in family order (rust): the plot adds no figure.
const fmPlot = tradeoff ? [] : [
  ...plot.map(r => ({ label: r.name, labelLang: payloadLang, value: r.primary.raw, interval: [r.interval![0].raw, r.interval![1].raw] as [number, number],
                      text: `${formatFig(r.primary)} (${formatFig(r.interval![0])}–${formatFig(r.interval![1])})`, tone: 'muted' as const })),
  ...p.fm.matrix.filter(r => r.status === 'complete' && r.interval).map(r => ({ label: r.model.name, labelLang: payloadLang, value: r.primary!.raw,
      interval: [r.interval![0].raw, r.interval![1].raw] as [number, number],
      text: `${formatFig(r.primary!)} (${formatFig(r.interval![0])}–${formatFig(r.interval![1])})`, tone: 'rust' as const })),
];
const say = (en: string) => fmText(en, locale);
const exposureText = (statement: string) => locale === 'en' ? statement : fmZh[statement];
const fmNotes = fmAll.filter(r => r.notes);
const adaptation = p.id === 'arithmetic-rest' ? fmAdaptation : [];
const sgn = (f: { raw: number; fmt: string; src: string }) => ({ ...f, fmt: 'sgn1' as const });
// The files this page's figures are leaves of: the core results CSV and protocol JSON, the v9 CSV,
// and on arithmetic-rest the v9 JSON (the EEGMAT adaptation). The cite block names their releases.
const citeFiles = [p.files.results, p.files.protocol, p.files.fm, ...(adaptation.length ? ['foundation-models-update.json'] : [])];
---
<EntityLayout
  locale={locale} path={path} active="protocols"
  documentTitle={c.protocolDocTitle(title, p.dataset)}
  h1={c.protocolH1(title, p.dataset)}
  description={description}
  eyebrow={c.protocolEyebrow(trackShort(p.short, locale))}
  dek={c.protocolDek(hasChance)}
  crumbs={[{ label: c.home, href: hrefFor('/', locale) }, { label: c.protocolsTitle, href: hrefFor('/protocols/', locale) }, { label: title }]}
  structured={structured}
  cite={{ files: citeFiles, upstream: 'dataset' }}
>
  {c.payloadNote && <p class="payload-note protocol-payload-note">{c.payloadNote}</p>}
  <section class="topic-section" aria-labelledby="glance-heading">
    <h2 id="glance-heading">{c.atAGlance}</h2>
    <dl class="protocol-facts">
      <div><dt>{c.dtTask}</dt><dd lang={payloadLang}>{p.subtitle}</dd></div>
      <div><dt>{c.dtEvaluation}</dt><dd>{trackShort(p.short, locale)}</dd></div>
      <div><dt>{c.dtDataset}</dt><dd>{p.datasetSlug ? <a href={hrefFor(`/datasets/${p.datasetSlug}/`, locale)} lang="en">{p.dataset}</a> : <span lang="en">{p.dataset}</span>}</dd></div>
      <div><dt>{c.dtPeople}</dt><dd><Fig f={p.subjects} cls="fig"/></dd></div>
      <div><dt>{c.dtData}</dt><dd lang={payloadLang}>{p.observations}</dd></div>
      <div><dt>{c.dtInput}</dt><dd lang={payloadLang}>{p.exposure}</dd></div>
      <div><dt>{c.dtChance}</dt><dd>{p.chance ? <Fig f={p.chance} cls="fig"/> : c.chanceNone}</dd></div>
      <div><dt>{c.dtMetrics}</dt><dd>{c.metricPair(metricLabel(p.yLabel, locale), metricLabel(p.xLabel, locale))}</dd></div>
    </dl>
  </section>

  <section class="topic-section" id="results" aria-labelledby="results-heading">
    <div class="topic-heading"><div><h2 id="results-heading">{c.results}</h2></div><p>{c.resultsLede}</p></div>
    {plot.length > 0 && <IntervalPlot
      caption={c.plotCaption}
      legend={c.plotLegend}
      domain={[0, 100]}
      ticks={['0%', '25%', '50%', '75%', '100%']}
      reference={p.chance?.raw}
      rows={plot.map(r => ({ label: r.name, value: r.primary.raw, interval: [r.interval![0].raw, r.interval![1].raw] as [number, number],
                             text: `${formatFig(r.primary)} (${formatFig(r.interval![0])}–${formatFig(r.interval![1])})` }))}
    />}
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={c.resultsRegion}>
      <table class="protocol-results">
        <thead><tr><th scope="col">{c.colMethod}</th><th scope="col">{c.colTraining}</th><th scope="col">{metricLabel(p.yLabel, locale)}</th><th scope="col">{metricLabel(p.xLabel, locale)}</th><th scope="col">{c.colChannels}</th><th scope="col">{c.colPeople}</th><th scope="col">{c.colCompute}</th></tr></thead>
        <tbody>{p.rows.map(r => <tr data-row={r.id}>
          <th scope="row"><span lang="en">{r.methodSlug ? <a href={hrefFor(`/methods/${r.methodSlug}/`, locale)}>{r.name}</a> : r.name}</span><small>{familyLabel(r.family, locale)}</small></th>
          <td lang={payloadLang}>{r.mode}</td>
          <td><Fig f={r.primary} cls="metric"/>{r.interval && <span class="interval"><Fig f={r.interval[0]}/>–<Fig f={r.interval[1]}/></span>}{p.type === 'tradeoff' && <small lang={payloadLang}>{r.primaryDetail}</small>}{r.chanceFlag && <span class="flag">{r.chanceFlag === 'at-or-below' ? c.atOrBelow : c.intervalReaches}</span>}{r.seedRank && <span class="flag seed">{c.seedFlag(c.seedWord[r.seedRank])}</span>}</td>
          <td><Fig f={r.secondary} cls="metric"/><small lang={payloadLang}>{r.secondaryDetail}</small>{r.abstain && (r.abstain.raw > 0
            ? <span class="flag"><Fig f={r.abstain}/>{c.abstainedOf}<Fig f={r.people}/>{c.abstainedTail}</span>
            : <small><Fig f={r.abstain}/>{c.abstainedOf}<Fig f={r.people}/>{c.abstainedTail}</small>)}</td>
          <td><Fig f={r.channels}/></td>
          <td><Fig f={r.people}/></td>
          <td><Fig f={r.seconds}/></td>
        </tr>)}</tbody>
      </table>
    </div>
    <p class="citation-note">{c.computeNote}</p>
    {p.notRun.length > 0 && <p class="protocol-note not-run"><strong>{c.notRun}</strong> <span lang="en">{p.notRun.map((m, i) => <>{i > 0 && ', '}{m.methodSlug ? <a href={hrefFor(`/methods/${m.methodSlug}/`, locale)}>{m.name}</a> : m.name}</>)}</span>{locale === 'zh' ? '。' : '. '}{c.notRunCaveat}</p>}
  </section>

  <section class="topic-section fm-section" id={FM_ANCHOR} aria-labelledby="fm-heading" data-release={fmRelease.id}>
    <div class="topic-heading"><div><p class="eyebrow">{c.fmEyebrow}</p><h2 id="fm-heading">{c.fmH2}</h2></div><p>{c.fmLede(tradeoff)}</p></div>
    {fmPlot.length > 0 && <IntervalPlot
      caption={c.fmPlotCaption}
      legend={c.fmPlotLegend}
      domain={[0, 100]}
      ticks={['0%', '25%', '50%', '75%', '100%']}
      reference={p.chance?.raw}
      rows={fmPlot}
    />}
    <div class="topic-table scroll" tabindex="0" role="region" aria-label={c.fmRegion}>
      <table class="fm-results">
        <thead><tr><th scope="col">{c.colEncoder}</th><th scope="col">{c.colTraining}</th>
          {tradeoff
            ? <><th scope="col">{c.colDetected}</th><th scope="col">{c.colFalse}</th><th scope="col">{c.colWindow}</th></>
            : <><th scope="col">{metricLabel(p.yLabel, locale)}</th><th scope="col">{metricLabel(p.xLabel, locale)}</th></>}
          <th scope="col">{c.colChannels}</th><th scope="col">{c.colPeople}</th><th scope="col">{c.colExposure}</th></tr></thead>
        <tbody>{p.fm.matrix.map(r => <FmRowView r={r} locale={locale} fn={fnOf(r)} fnId={fnId(fnOf(r))}/>)}</tbody>
      </table>
    </div>
    <p class="citation-note fm-exposure-key">{c.exposureKey(fmExposure.checkedOn)}</p>
    <h3 class="roadmap-h3" id="v9-footnotes">{c.footnotesH3}</h3>
    <ol class="fm-footnotes">{footnotes.map((f, i) => {
      const t = say(f);
      return <li id={fnId(i + 1)}><span>{t.text}</span>{t.original && <span class="note-original" lang="en">{t.original}</span>}</li>;
    })}</ol>

    <details class="rd-panel fm-ablation" id={FM_ABLATION_ANCHOR}>
      <summary>{c.ablationSummary}</summary>
      <p class="roadmap-p">{c.ablationLede}</p>
      <div class="topic-table scroll" tabindex="0" role="region" aria-label={c.ablationSummary}>
        <table class="fm-results fm-ablation-table">
          <thead><tr><th scope="col">{c.colEncoder}</th><th scope="col">{c.colTraining}</th>
            {tradeoff
              ? <><th scope="col">{c.colDetected}</th><th scope="col">{c.colFalse}</th><th scope="col">{c.colWindow}</th></>
              : <><th scope="col">{metricLabel(p.yLabel, locale)}</th><th scope="col">{metricLabel(p.xLabel, locale)}</th></>}
            <th scope="col">{c.colChannels}</th><th scope="col">{c.colPeople}</th><th scope="col">{c.colExposure}</th></tr></thead>
          <tbody>
            {p.fm.matrix.filter(r => r.model.slug === 'eeg-fm-masking').map(r => <FmRowView r={r} locale={locale} fn={fnOf(r)} fnId={fnId(fnOf(r))} reference={true}/>)}
            {p.fm.ablation.map(r => <FmRowView r={r} locale={locale} fn={fnOf(r)} fnId={fnId(fnOf(r))}/>)}
          </tbody>
        </table>
      </div>
    </details>

    {adaptation.length > 0 && <>
      <h3 class="roadmap-h3" id={FM_ADAPTATION_ANCHOR}>{c.adaptH3}</h3>
      <p class="roadmap-p">{c.adaptLede} <Fig f={fmAdaptationMeta.people} cls="fig"/>{locale === 'zh' ? ' 名被试，' : ' people, '}<Fig f={fmAdaptationMeta.folds} cls="fig"/>{locale === 'zh' ? ' 折。LoRA 增加的可训练参数从 ' : ' folds. LoRA adds '}<Fig f={fmAdaptationMeta.loraRange[0]} cls="fig"/>{locale === 'zh' ? ' 到 ' : ' to '}<Fig f={fmAdaptationMeta.loraRange[1]} cls="fig"/>{locale === 'zh' ? ' 个不等，随模型而异。' : ' trainable parameters, depending on the model.'}</p>
      <div class="topic-table scroll" tabindex="0" role="region" aria-label={c.adaptRegion}>
        <table class="fm-adaptation">
          <thead><tr><th scope="col">{c.colEncoder}</th><th scope="col">{c.colFrozenHead}</th><th scope="col">{c.colLora}</th><th scope="col">{c.colChange}</th><th scope="col">{c.colTrainable}</th></tr></thead>
          <tbody>
            {[{ name: fmAdaptationContext.model, slug: 'labram', context: true, ...fmAdaptationContext },
              ...adaptation.map(a => ({ name: a.model.name, slug: a.model.slug, context: false, release: fmRelease.id, frozen: a.frozen, lora: a.lora, change: a.change, unknown: a.exposure.status === 'unknown', researchUse: fmResearchUse(a.model) }))].map(a => (
              <tr data-adapt-row={a.name}>
                <th scope="row"><span lang="en"><a href={hrefFor(`/methods/${a.slug}/`, locale)}>{a.name}</a></span>{a.context && <small>{c.labramContext}</small>}{'unknown' in a && a.unknown && <span class="flag fm-badge" data-exposure="unknown">{c.unknown}</span>}{'researchUse' in a && a.researchUse && <small class="fm-research-use">{c.researchUse}</small>}</th>
                <td><Fig f={a.frozen.ba} cls="metric"/><span class="interval"><Fig f={a.frozen.interval[0]}/>–<Fig f={a.frozen.interval[1]}/></span></td>
                <td><Fig f={a.lora.ba} cls="metric"/><span class="interval"><Fig f={a.lora.interval[0]}/>–<Fig f={a.lora.interval[1]}/></span></td>
                <td><Fig f={a.change.mean} cls="metric"/><span class="interval"><Fig f={sgn(a.change.interval[0])}/>{locale === 'zh' ? ' 至 ' : ' to '}<Fig f={a.change.interval[1]}/></span><small><Fig f={a.change.helped}/>{locale === 'zh' ? ' 人提升 · ' : ' improved · '}<Fig f={a.change.harmed}/>{locale === 'zh' ? ' 人变差 · ' : ' worse · '}<Fig f={a.change.tied}/>{locale === 'zh' ? ' 人不变' : ' unchanged'}</small><span class="verdict" data-resolved={a.change.excludesZero ? 'true' : 'false'}>{a.change.excludesZero ? c.excludesZero : c.includesZero}</span></td>
                <td><Fig f={a.frozen.trainable}/> · <Fig f={a.lora.trainable}/></td>
              </tr>))}
          </tbody>
        </table>
      </div>
      <p class="protocol-note"><strong>{c.notAdapted}</strong> {fmNotAdapted.map((m, i) => <>{i > 0 && (locale === 'zh' ? '；' : '; ')}<span lang="en">{m.name}</span>{colon}{say(m.adaptation).text}</>)}</p>
    </>}

    <h3 class="roadmap-h3" id="v9-licences">{c.licencesH3}</h3>
    <FmLicences models={fmAll.map(r => r.model)} locale={locale}/>
    <h3 class="roadmap-h3">{c.fmNotesH3}</h3>
    <ul class="entity-links protocol-prose fm-notes">{fmNotes.map(r => <li><strong lang="en">{r.model.name}</strong>{colon}{locale === 'en'
      ? <span>{r.notes}</span>
      : r.noteParts.map(n => { const t = say(n); return <><span>{t.text}</span>{t.original && <span class="note-original" lang="en">{t.original}</span>}</>; })}</li>)}</ul>
    <div class="topic-actions"><a class="button" href={`/data/${p.files.fm}`} download>{c.fmDownload}</a><a class="button fm-release" href={hrefFor(`/releases/#${fmRelease.id}`, locale)}>{c.fmRelease}{' '}<code>{fmRelease.id}</code></a></div>
  </section>

  <section class="topic-section" id="methods-and-limits" aria-labelledby="limits-heading">
    <h2 id="limits-heading">{c.limits}</h2>
    <p class="protocol-limitation" lang={payloadLang}>{p.limitation}</p>
    {/* The released limitation keeps its words; where it calls pretraining overlap unknown, a dated pointer sits beside it (review of 2026-10-05). */}
    {/pretraining overlap unknown/.test(p.limitation) && <p class="protocol-note fm-limitation-pointer">{c.overlapPointer(p.exposureChecked)} <a href="#pretraining-exposure">{c.exposure} ↓</a></p>}
    <h3 class="roadmap-h3" id="steps">{c.steps}</h3>
    <ol class="protocol-steps" lang={payloadLang}>{p.steps.map(s => <li>{s}</li>)}</ol>
    <h3 class="roadmap-h3" id="stability">{c.stability}</h3>
    <p class="roadmap-p" lang={payloadLang}>{p.selection}</p>
    {p.seed && <p class="roadmap-p">{c.seedLine(p.seed.model)} {p.seed.values.map((v, i) => <>{i > 0 && ' · '}<Fig f={v} cls="fig"/></>)}{locale === 'zh' ? '；' : '; '}{c.mean} <Fig f={p.seed.mean} cls="fig"/></p>}
    {p.seed && <p class="roadmap-p" lang={payloadLang}>{p.seed.scope}</p>}
    <h3 class="roadmap-h3" id="pretraining-exposure">{c.exposure}</h3>
    <p class="roadmap-p" lang={payloadLang}>{p.pretrainingOverlap}</p>
    {/* The owner's sourced statement (2026-10-04) beside the released sentence, which stays as released. */}
    <p class="roadmap-p fm-core-exposure"><strong>{c.exposureChecked(p.exposureChecked)}</strong> {p.coreExposure.map((x, i) => <>{i > 0 && (locale === 'zh' ? '；' : '; ')}<span lang="en">{x.model}</span>{colon}{exposureText(x.statement)} {x.urls.map(u => <a href={u} target="_blank" rel="noreferrer">{c.exposureSource}</a>)}</>)}{locale === 'zh' ? '。' : '.'} {c.coreExposureTail} <a href={`#${FM_ANCHOR}`}>{c.fmExposureLink}</a></p>
    <h3 class="roadmap-h3">{c.methodNotes}</h3>
    <ul class="entity-links protocol-prose" lang={payloadLang}>{notes.map(n => <li>{n}</li>)}</ul>
    <h3 class="roadmap-h3">{c.modelTerms}</h3>
    <ul class="entity-links protocol-prose">{p.rows.map(r => <li><strong lang="en">{r.name}</strong>{colon}<span lang={payloadLang}>{r.modelRights}</span></li>)}</ul>
  </section>

  <section class="topic-section" id="source" aria-labelledby="source-heading">
    <h2 id="source-heading">{c.source}</h2>
    <div class="citation-list">
      <article>
        <h3 lang="en">{p.dataset}</h3>
        <p><strong>{c.credit}</strong> <span lang="en">{p.attribution}</span></p>
        {p.requested && <p><strong>{c.requestedCitation}</strong> <span lang="en">{p.requested.text}</span> <a href={p.requested.url} target="_blank" rel="noreferrer">doi ↗</a> · <a href={p.requested.basis} target="_blank" rel="noreferrer">{c.requestedBasis}</a></p>}
        <p><strong>{c.licence}</strong> <a href={p.licenseUrl} target="_blank" rel="noreferrer" lang={licence.lang}>{licence.text} ↗</a>{licence.original && <span class="note-original" lang="en">{licence.original}</span>}</p>
        <p><a href={p.source} target="_blank" rel="noreferrer">{c.original}</a>{p.datasetSlug && <> · <a href={hrefFor(`/datasets/${p.datasetSlug}/`, locale)}>{c.datasetPage}</a></>}</p>
        <p>{c.notRedistributed}</p>
      </article>
      <article>
        <p><strong>{c.scope}</strong> <span lang="en">{p.rightsScope}</span></p>
        {/* The released privacy review reads as reviewer notes; the page states what is published, any consent caveat, and links the file that holds the full note. */}
        <p class="protocol-privacy"><strong>{c.privacy}</strong> {c.privacyNote}{consentCaveat && <> <span class="consent-caveat">{consentCaveat}</span></>} <a href={`/data/${p.files.protocol}`} download>{c.privacyLink}</a></p>
        {register && <p class="protocol-register"><strong>{c.register}</strong> <span lang={register.lang}>{register.text}</span>{register.original && <span class="note-original" lang="en">{register.original}</span>}</p>}
        <p><strong>{c.reviewed}</strong> <time datetime={p.reviewedAt}>{p.reviewedAt}</time> · {c.reviewBasis} {p.reviewBasis.map((u, i) => <>{i > 0 && ' · '}<a href={u} target="_blank" rel="noreferrer">{new URL(u).hostname} ↗</a></>)}</p>
      </article>
    </div>
    {p.corrections.map(x => <p class="protocol-note"><strong>{c.correction} · <time datetime={x.date}>{x.date}</time></strong>{colon}{x.what[locale]} <a href={hrefFor('/releases/#corrections', locale)}>{c.correctionLink}</a></p>)}
  </section>

  <section class="topic-section" id="record" aria-labelledby="record-heading">
    <h2 id="record-heading">{c.record}</h2>
    <dl class="protocol-facts">
      <div><dt>{c.dtProtocolId}</dt><dd><code>{p.protocolId}</code></dd></div>
      <div><dt>{c.dtVersion}</dt><dd lang={payloadLang}>{versionText(p.version)}</dd></div>
      <div><dt>{c.dtBackend}</dt><dd lang={payloadLang}>{p.backend}</dd></div>
      <div><dt>{c.dtElapsed}</dt><dd><Fig f={p.elapsed} cls="fig"/> · {c.elapsedNote}</dd></div>
      <div><dt>{c.dtAudit}</dt><dd><code class="hash">{p.auditSha}</code></dd></div>
      {p.summarySha && <div><dt>{c.dtSummary}</dt><dd><code class="hash">{p.summarySha}</code></dd></div>}
      {p.protocolSha && <div><dt>{c.dtProtocolSha}</dt><dd><code class="hash">{p.protocolSha}</code></dd></div>}
    </dl>
  </section>

  <section class="topic-section" id="downloads" aria-labelledby="downloads-heading">
    <h2 id="downloads-heading">{c.downloads}</h2>
    <div class="topic-actions"><a class="button primary" href={`/data/${p.files.results}`} download>{c.dlResults}</a><a class="button" href={`/data/${p.files.protocol}`} download>{c.dlProtocol}</a><a class="button" href="/data/experiments.json" download>{c.dlAll}</a></div>
    <h3 class="roadmap-h3">{c.otherProtocols}</h3>
    <ul class="entity-links">{others.map(o => <li><a href={hrefFor(`/protocols/${o.id}/`, locale)}>{c.protocolH1(trackTitle(o.title, locale), o.dataset)}</a></li>)}</ul>
    <p class="citation-note"><a href={hrefFor('/protocols/', locale)}>{c.allProtocols}</a> · <a href={hrefFor('/#overview', locale)}>{c.matrixLink}</a> · <a href={hrefFor('/datasets/', locale)}>{c.allDatasets}</a> · <a href={hrefFor('/methods/', locale)}>{c.allMethods}</a></p>
  </section>
</EntityLayout>
