---
import EntityLayout from '../../../components/EntityLayout.astro';
import ResultGroups from '../../../components/ResultGroups.astro';
import profiles from '../../../data/entity-profiles.json';
import Fig from '../../../components/Fig.astro';
import { isFmSlug, methods, type MethodEntity } from '../../../data/entities';
import { exposureTable, fmExposure, fmModels, fmResearchUse, type ExposureRow } from '../../../data/foundation-models';
import { fmText, fmZh } from '../../../data/foundation-models-zh';
import { protocolById } from '../../../data/protocols';
import { trackTitle } from '../../../data/i18n';
import { entityCopy } from '../../../data/entity-copy';
import { familyLabel, hrefFor, locales, defaultLocale, localeOf, modelStatus } from '../../../data/i18n';
import { site } from '../../../data/site';

export const getStaticPaths = () => locales.flatMap(code => methods.map(m => ({
  params: { lang: code === defaultLocale ? undefined : code, slug: m.slug }, props: { method: m },
})));
const { method: m } = Astro.props as { method: MethodEntity };
const locale = localeOf(Astro.params.lang);
const c = entityCopy[locale];
const path = `/methods/${m.slug}/`;
type Profile = { aliases: string[]; summary_en: string; summary_zh: string; facts_sources: string[]; reference?: string; reference_url?: string; code_url?: string };
const profile = (profiles.methods as Record<string, Profile>)[m.slug];
const datasetNames = [...new Set(m.groups.filter(g => g.rows.length).map(g => g.dataset.name))];
// The authors' repository where the profile found one; the implementation this
// site ran (the directory's link) is shown beside it when it differs.
const code = profile?.code_url ?? m.url;
const used = m.url && m.url !== code ? m.url : undefined;
// The served files this page's figures are leaves of; the cite block names their releases.
const files = [...new Set(m.groups.flatMap(g => [...(g.chance ? [g.chance] : []),
  ...g.rows.flatMap(r => [r.value, ...(r.interval ?? []), ...(r.of ? [r.of] : [])])].map(f => f.src)))];
// "Measured on … · Protocols …": the dataset pages and the protocol pages this page's
// groups are read on, in the order the groups meet them (since 2026-10-04).
// A group with no row (a checkpoint not run there) measured nothing, so it is not counted.
const measured = m.groups.filter(g => g.rows.length);
const measuredOn = [...new Map(measured.map(g => [g.dataset.slug, g.dataset])).values()];
const protocolsOn = [...new Set(measured.map(g => g.path.match(/^\/protocols\/([^/#]+)\//)?.[1]).filter((x): x is string => !!x))];
// v9 families: each checkpoint as the release records it, and the exposure table.
const checkpoints = isFmSlug(m.slug) ? fmModels.filter(x => x.slug === m.slug) : [];
const say = (en: string) => fmText(en, locale);
// Pretraining exposure, by dataset: the v9 families, and LaBraM and CBraMod (owner decision 2026-10-04).
// Checkpoints of a family share one table where every cell agrees.
const exposureKeys = checkpoints.length ? [...new Set(checkpoints.map(x => x.exposureKey))] : (['labram', 'cbramod'].includes(m.slug) ? [m.slug] : []);
const same = (a: ExposureRow[], b: ExposureRow[]) => JSON.stringify(a) === JSON.stringify(b);
const exposureTables: { names: string[]; rows: ExposureRow[] }[] = [];
for (const key of exposureKeys) {
  const rows = exposureTable(key), names = checkpoints.length ? checkpoints.filter(x => x.exposureKey === key).map(x => x.name) : [m.name];
  const match = exposureTables.find(t => same(t.rows, rows));
  if (match) match.names.push(...names); else exposureTables.push({ names, rows });
}
// The exposure table's caveats that name this model.
const caveats = exposureKeys.length ? fmExposure.caveats.filter(c => c.includes(m.name)) : [];
const statement = (r: ExposureRow) => locale === 'en' ? r.statement : fmZh[r.statement];
const structured = {
  '@context': 'https://schema.org', '@type': 'WebPage', url: new URL(path, site.origin).href,
  name: c.methodTitle(m.name), description: c.methodDescription(m.name, datasetNames.join(', ')),
  about: { '@type': 'SoftwareSourceCode', name: m.name, ...(code ? { codeRepository: code } : {}),
           ...(profile?.reference_url ? { citation: profile.reference_url } : {}), ...(profile?.aliases?.length ? { alternateName: profile.aliases } : {}) },
  mentions: measuredOn.map(d => ({ '@type': 'Dataset', name: d.name, url: new URL(`/datasets/${d.slug}/`, site.origin).href })),
};
---
<EntityLayout
  locale={locale} path={path} active="methods"
  documentTitle={c.methodTitle(m.name)}
  h1={c.methodH1(m.name)} name={m.name}
  description={c.methodDescription(m.name, datasetNames.join(locale === 'zh' ? '、' : ', '))}
  eyebrow={m.family ? familyLabel(m.family, locale) : c.methodsTitle}
  dek={profile ? (locale === 'zh' ? profile.summary_zh : profile.summary_en) : c.methodsDek}
  crumbs={[{ label: c.home, href: hrefFor('/', locale) }, { label: c.methodsTitle, href: hrefFor('/methods/', locale) }, { label: m.name, en: true }]}
  structured={structured}
  cite={{ files, upstream: 'datasets' }}
>
  {(measuredOn.length > 0 || protocolsOn.length > 0) && <p class="entity-measured">
    {measuredOn.length > 0 && <><span class="entity-measured-label">{c.measuredOn}</span>{locale === 'zh' ? '' : ' '}{measuredOn.map((d, i) => <>{i > 0 && (locale === 'zh' ? '、' : '; ')}<a href={hrefFor(`/datasets/${d.slug}/`, locale)} lang={locale === 'zh' ? 'en' : undefined}>{d.name}</a></>)}</>}
    {measuredOn.length > 0 && protocolsOn.length > 0 && ' · '}
    {protocolsOn.length > 0 && <><span class="entity-measured-label">{c.protocolsOn}</span>{locale === 'zh' ? '' : ' '}{protocolsOn.map((id, i) => <>{i > 0 && (locale === 'zh' ? '、' : '; ')}<a href={hrefFor(`/protocols/${id}/`, locale)}>{trackTitle(protocolById[id].title, locale)}</a></>)}</>}
  </p>}
  {profile && <section class="entity-profile" aria-label={c.whatItIs}>
    {profile.aliases.length > 0 && <p class="entity-aliases"><strong>{c.alsoKnownAs}</strong> <span lang="en">{profile.aliases.join(' · ')}</span></p>}
    {profile.reference && <p class="entity-aliases"><strong>{c.reference}</strong> <span lang="en">{profile.reference_url ? <a href={profile.reference_url} target="_blank" rel="noreferrer">{profile.reference} ↗</a> : profile.reference}</span></p>}
    <p class="citation-note">{m.status && <>{c.directoryStatus}{locale === 'zh' ? '：' : ': '}{modelStatus(m.status, locale)} · </>}{code && <><a href={code} target="_blank" rel="noreferrer">{profile?.code_url ? c.officialCode : c.implementationUsed}</a> · </>}{used && <><a href={used} target="_blank" rel="noreferrer">{c.implementationUsed}</a> · </>}{c.profileSource} {profile.facts_sources.map((u, i) => <>{i > 0 && ' · '}<a href={u} target="_blank" rel="noreferrer">{new URL(u).hostname}</a></>)}</p>
  </section>}
  <section class="topic-section" aria-labelledby="results-heading">
    <div class="topic-heading"><div><h2 id="results-heading">{c.results}</h2></div><p>{c.methodResultsLede}</p></div>
    <ResultGroups locale={locale} groups={m.groups} showMethod={true}/>
    <p class="citation-note"><a href={hrefFor('/methods/', locale)}>{c.allMethods}</a> · <a href={hrefFor('/datasets/', locale)}>{c.allDatasets}</a></p>
  </section>
  {checkpoints.length > 0 && <section class="topic-section" id="checkpoints" aria-labelledby="checkpoints-heading">
    <div class="topic-heading"><div><h2 id="checkpoints-heading">{c.checkpointsH2}</h2></div><p>{c.checkpointsLede}</p></div>
    {checkpoints.map(x => {
      // A licence note that only restates the licence's name ("MIT.") is not printed twice.
      const restates = x.licenceNote.replace(/\.$/, '') === x.weightsLicence;
      const terms = [[c.dtWeights, say(x.weightsLicence)], ...(restates ? [] : [[c.dtTerms, say(x.licenceNote)]]), [c.dtRights, say(x.rightsReview)], [c.dtFootnote, say(x.footnote)]] as [string, { text: string; original?: string }][];
      return <article class="fm-checkpoint" data-checkpoint={x.id}>
        <h3 lang="en">{x.name}</h3>
        {fmResearchUse(x) && <p class="protocol-note fm-research-use">{c.researchUse}</p>}
        <dl class="protocol-facts">
          <div><dt>{c.dtPanel}</dt><dd>{x.panel === 'matrix' ? c.panelMatrix : c.panelAblation}</dd></div>
          <div><dt>{c.dtParams}</dt><dd><Fig f={x.params} cls="fig"/></dd></div>
          <div><dt>{c.dtRevision}</dt><dd>{x.revision ? <code>{x.revision}</code> : c.notRecorded}</dd></div>
          <div><dt>{c.dtSha}</dt><dd>{x.checkpointSha ? <code class="hash">{x.checkpointSha}</code> : c.notRecorded}</dd></div>
          <div><dt>{c.dtPaper}</dt><dd><a href={x.paper} target="_blank" rel="noreferrer">{c.paperLink}</a></dd></div>
          {terms.map(([dt, t]) => <div><dt>{dt}</dt><dd>{t.text}{t.original && <span class="note-original" lang="en">{t.original}</span>}</dd></div>)}
          {x.notes.length > 0 && <div><dt>{c.dtNotes}</dt><dd>{x.notes.map(n => { const t = say(n); return <span class="fm-note">{t.text}{t.original && <span class="note-original" lang="en">{t.original}</span>}</span>; })}</dd></div>}
          <div><dt>{c.dtAdaptation}</dt><dd>{x.adaptation === 'run' ? c.adaptationRun : <>{say(x.adaptation).text}{say(x.adaptation).original && <span class="note-original" lang="en">{say(x.adaptation).original}</span>}</>}</dd></div>
        </dl>
      </article>;
    })}
  </section>}
  {exposureTables.length > 0 && <section class="topic-section" id="pretraining-exposure" aria-labelledby="exposure-heading">
    <div class="topic-heading"><div><h2 id="exposure-heading">{c.exposureH2}</h2></div><p>{c.exposureLede(fmExposure.checkedOn)}</p></div>
    {exposureTables.map(t => <>
      {(exposureTables.length > 1 || checkpoints.length > 1) && <h3 class="roadmap-h3" lang="en">{t.names.join(' · ')}</h3>}
      <div class="topic-table scroll" tabindex="0" role="region" aria-label={c.exposureRegion(t.names.join(' · '))}>
        <table class="fm-exposure-table">
          <thead><tr><th scope="col">{c.colDataset}</th><th scope="col">{c.colProtocols}</th><th scope="col">{c.colStatement}</th><th scope="col">{c.colSource}</th></tr></thead>
          <tbody>{t.rows.map(r => <tr data-exposure={r.status}>
            <th scope="row" lang="en"><a href={r.record} target="_blank" rel="noreferrer">{r.dataset}</a></th>
            <td>{r.protocols.map((id, i) => <>{i > 0 && ' · '}<a href={hrefFor(`/protocols/${id}/`, locale)}>{trackTitle(protocolById[id].title, locale)}</a></>)}</td>
            <td>{r.status === 'not_exposed' ? statement(r) : <span class="flag fm-badge" data-exposure={r.status}>{statement(r)}</span>}</td>
            <td>{r.urls.map((u, i) => <>{i > 0 && ' · '}<a href={u} target="_blank" rel="noreferrer">{c.sourceLink}</a></>)}</td>
          </tr>)}</tbody>
        </table>
      </div>
    </>)}
    {caveats.map(x => { const t = say(x); return <p class="citation-note"><strong>{c.exposureCaveat}</strong> {t.text}{t.original && <span class="note-original" lang="en">{t.original}</span>}</p>; })}
  </section>}
</EntityLayout>
