---
/**
 * /releases/: the release log's index (owner decision D17, 2026-10-28). The newest release days in full, each with one
 * to three short changes (releases.ts `highlights`) and its ids, which link their records in the archive; one visible
 * line for every earlier release, so every old /releases/#<id> link still lands on its release; the corrections; the
 * holds register, open holds first. Every record as released (summaries, notes, manifests, hashes) is on
 * /releases/archive/.
 */
import SiteHeader from '../../components/SiteHeader.astro';
import AgentLinks from '../../components/AgentLinks.astro';
import ShareImage from '../../components/ShareImage.astro';
import FooterElsewhere from '../../components/FooterElsewhere.astro';
import { site } from '../../data/site';
import { corrections, holds } from '../../data/releases';
import { changeParts, date, earlierReleases, latestDays, pageTitle } from '../../data/release-record';
import { alternates, chrome, hrefFor, htmlLang, localeOf, localeParams, localizePath, ogLocale, topicChrome } from '../../data/i18n';
import '../../styles/global.css';
import '../../styles/topics.css';
import '../../styles/releases.css';

export const getStaticPaths = localeParams;
const locale = localeOf(Astro.params.lang);
const t = chrome[locale];
const tc = topicChrome[locale];
const path = '/releases/';
const origin = Astro.site ?? site.origin;
const canonical = new URL(localizePath(path, locale), origin).href;
const archive = hrefFor('/releases/archive/', locale);

const copy = {
  en: {
    title: 'Releases',
    description: 'What the newest BCI Report releases changed, a line for every earlier release, the corrections and the holds register. Every release’s full record, with the SHA-256 of each file it ships, is in the archive.',
    eyebrow: 'Release log',
    dek: ['What the newest releases changed, with links to the pages and files. Every release’s full record, with its review manifest and the SHA-256 of each file it ships, is in ', 'the archive', '.'],
    home: 'Home',
    latestH2: 'Newest releases', ids: 'Release records and downloads',
    earlierH2: 'Earlier releases', earlierSep: ' — ',
    holdsH2: 'Holds register',
    holdsLede: 'Each item held back, with the date its hold was opened and, where it was, resolved.',
    colItem: 'Item', colOpened: 'Opened', colStatus: 'Status', colOutcome: 'Why',
    open: 'Open', resolved: (d: string) => `Resolved ${d}`,
    holdsRegion: 'Holds register, scrolls horizontally',
    resolvedSummary: (n: number) => `Resolved holds (${n})`, resolvedRegion: 'Resolved holds, scrolls horizontally',
    rights: 'Each batch’s source terms, consent and privacy review:',
    rightsLink: 'Data use & privacy',
    correctionsH2: 'Corrections',
    correctionsLede: ['Each correction to released wording is also made on the page that shows it; the released files keep their original bytes, whose SHA-256 values are in ', 'the release archive', '.'],
    colDate: 'Date', colFiles: 'Files', colCorrection: 'Correction', seePage: 'See the page →',
    correctionsRegion: 'Corrections, scrolls horizontally',
  },
  zh: {
    title: '发布记录',
    description: '最近几次 BCI Report 发布各改了什么，更早的每次发布各一行，以及更正与暂缓登记册。每次发布的完整记录，连同所附每个文件的 SHA-256，都在归档页。',
    eyebrow: '发布记录',
    dek: ['最近几次发布各改了什么，附页面与文件链接。每次发布的完整记录，连同审核清单与所附每个文件的 SHA-256，都在', '归档页', '。'],
    home: '首页',
    latestH2: '最近的发布', ids: '发布记录与下载',
    earlierH2: '更早的发布', earlierSep: '——',
    holdsH2: '暂缓登记册',
    holdsLede: '暂缓的每一项，附开始暂缓的日期；已解除的另附解除日期。',
    colItem: '项目', colOpened: '开始暂缓', colStatus: '状态', colOutcome: '原因',
    open: '暂缓中', resolved: (d: string) => `${d} 解除`,
    holdsRegion: '暂缓登记册，可横向滚动',
    resolvedSummary: (n: number) => `已解除的暂缓（${n}）`, resolvedRegion: '已解除的暂缓，可横向滚动',
    rights: '每一批的来源条款、同意书与隐私审查：',
    rightsLink: '数据使用与隐私（英文）',
    correctionsH2: '更正',
    correctionsLede: ['对已发布措辞的每项更正也改在展示它的页面上；已发布的文件保持原有字节，其 SHA-256 见', '发布归档', '。'],
    colDate: '日期', colFiles: '文件', colCorrection: '更正内容', seePage: '查看页面 →',
    correctionsRegion: '更正，可横向滚动',
  },
}[locale];
const pageTitleFull = `${copy.title} · ${site.name}`;
const days = latestDays();
const earlier = earlierReleases();
// Open holds first, newest first; the resolved ones keep their rows, collapsed below.
const openHolds = holds.filter(h => !h.closed).sort((a, b) => b.opened.localeCompare(a.opened));
const resolvedHolds = holds.filter(h => h.closed);
const holdRow = (h: typeof holds[number]) => ({ id: `hold-${h.id}`, cls: h.closed ? 'hold-resolved' : 'hold-open', h });
---
<!doctype html>
<html lang={htmlLang[locale]}>
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="description" content={copy.description}/>
  <meta name="theme-color" content="#b3450e"/>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
  <link rel="icon" href="/favicon.ico" sizes="32x32"/>
  <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
  <link rel="canonical" href={canonical}/>
  <AgentLinks href={localizePath(path, locale)}/>
  {alternates(path, String(origin)).map(l => <link rel="alternate" hreflang={l.hreflang} href={l.href}/>)}
  <title>{pageTitleFull}</title>
  <meta property="og:type" content="article"/>
  <meta property="og:site_name" content={site.name}/>
  <meta property="og:locale" content={ogLocale[locale]}/>
  <meta property="og:title" content={pageTitleFull}/>
  <meta property="og:description" content={copy.description}/>
  <meta property="og:url" content={canonical}/>
  <ShareImage locale={locale}/>
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content={pageTitleFull}/>
  <meta name="twitter:description" content={copy.description}/>
</head>
<body>
  <a class="skip" href="#release-content">{t.skipToEvidence}</a>
  <SiteHeader locale={locale} path={path} active="releases"/>
  <main class="topic-page" id="release-content">
    <nav class="breadcrumbs" aria-label={tc.breadcrumb}><ol><li><a href={hrefFor('/', locale)}>{copy.home}</a></li><li aria-current="page">{copy.title}</li></ol></nav>
    <section class="topic-hero">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.title}</h1>
      <p class="topic-dek">{copy.dek[0]}<a href={archive}>{copy.dek[1]}</a>{copy.dek[2]}</p>
    </section>

    <section class="topic-section" id="latest" aria-labelledby="latest-heading">
      <h2 id="latest-heading">{copy.latestH2}</h2>
      {days.map(d => (
        <article class="release-latest" aria-labelledby={`day-${d.date}`}>
          <h3 id={`day-${d.date}`}><time datetime={d.date}>{date(d.date, locale)}</time></h3>
          <ul class="release-changes">{d.changes.map(c => <li>{changeParts(c, locale).map(p => p.href ? <a href={hrefFor(p.href, locale)}>{p.text}</a> : p.text)}</li>)}</ul>
          <ul class="release-ids" aria-label={copy.ids}>{d.releases.map(r => (
            <li id={r.id}><a href={`${archive}#${r.id}`}><code>{r.id}</code></a>{r.files.map(f => <> · <a href={`/data/${f}`} download>{f}</a></>)}</li>
          ))}</ul>
        </article>
      ))}
    </section>

    <section class="topic-section" id="earlier" aria-labelledby="earlier-heading">
      <h2 id="earlier-heading">{copy.earlierH2}</h2>
      <ul class="release-earlier">{earlier.map(r => (
        <li id={r.id}><time datetime={r.date}>{date(r.date, locale)}</time> · <a href={`${archive}#${r.id}`}><code>{r.id}</code></a>{copy.earlierSep}{r.pages.map((p, i) => <>{i > 0 && ' · '}<a href={hrefFor(p, locale)}>{pageTitle(p, locale)}</a></>)}</li>
      ))}</ul>
    </section>

    <section class="topic-section" id="corrections" aria-labelledby="corrections-heading">
      <div class="topic-heading"><div><h2 id="corrections-heading">{copy.correctionsH2}</h2></div><p>{copy.correctionsLede[0]}<a href={archive}>{copy.correctionsLede[1]}</a>{copy.correctionsLede[2]}</p></div>
      <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.correctionsRegion}>
        <table>
          <thead><tr><th scope="col">{copy.colDate}</th><th scope="col">{copy.colFiles}</th><th scope="col">{copy.colCorrection}</th></tr></thead>
          <tbody>{corrections.map(c => <tr><th scope="row"><time datetime={c.date}>{date(c.date, locale)}</time></th><td>{c.files.map((f, i) => <>{i > 0 && ' · '}<code>{f}</code></>)}</td><td>{c.what[locale]}{c.href && <> <a href={hrefFor(c.href, locale)}>{copy.seePage}</a></>}</td></tr>)}</tbody>
        </table>
      </div>
    </section>

    <section class="topic-section" id="holds" aria-labelledby="holds-heading">
      <div class="topic-heading"><div><h2 id="holds-heading">{copy.holdsH2}</h2></div><p>{copy.holdsLede}</p></div>
      <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.holdsRegion}>
        <table>
          <thead><tr><th scope="col">{copy.colItem}</th><th scope="col">{copy.colOpened}</th><th scope="col">{copy.colStatus}</th><th scope="col">{copy.colOutcome}</th></tr></thead>
          <tbody>{openHolds.map(holdRow).map(({ id, cls, h }) => <tr id={id} class={cls}><th scope="row">{h.href ? <a href={hrefFor(h.href, locale)}>{h.item[locale]}</a> : h.item[locale]}</th><td><time datetime={h.opened}>{date(h.opened, locale)}</time></td><td>{copy.open}</td><td>{h.outcome[locale]}</td></tr>)}</tbody>
        </table>
      </div>
      {resolvedHolds.length > 0 && (
        <details class="holds-resolved">
          <summary>{copy.resolvedSummary(resolvedHolds.length)}</summary>
          <div class="topic-table scroll" tabindex="0" role="region" aria-label={copy.resolvedRegion}>
            <table>
              <thead><tr><th scope="col">{copy.colItem}</th><th scope="col">{copy.colOpened}</th><th scope="col">{copy.colStatus}</th><th scope="col">{copy.colOutcome}</th></tr></thead>
              <tbody>{resolvedHolds.map(holdRow).map(({ id, cls, h }) => <tr id={id} class={cls}><th scope="row">{h.href ? <a href={hrefFor(h.href, locale)}>{h.item[locale]}</a> : h.item[locale]}</th><td><time datetime={h.opened}>{date(h.opened, locale)}</time></td><td>{copy.resolved(date(h.closed!, locale))}</td><td>{h.outcome[locale]}</td></tr>)}</tbody>
            </table>
          </div>
        </details>
      )}
      <p class="citation-note">{copy.rights} <a href="/data-use/">{copy.rightsLink}</a></p>
    </section>
  </main>
  <footer><a class="brand" href={hrefFor('/', locale)}>{site.name}</a><p>{t.footerTagline}</p><a href="/data-use/">{t.footerDataUse}{t.englishMark}</a><a href="#release-content">{t.footerTop}</a><FooterElsewhere locale={locale}/></footer>
</body>
</html>
