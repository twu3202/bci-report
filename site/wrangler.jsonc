{
  // Cloudflare Workers Static Assets config for BCI Report (bci.report).
  //
  // Its main job is to pin the upload scope. `wrangler deploy` run from this
  // directory publishes exactly ./dist and nothing else — so a deploy can no
  // longer pick up site/.git (whose single commit still contains per-participant
  // rows from an earlier export), .astro/, .openai/ or .DS_Store by mistake.
  // Always deploy from here; never pass a directory argument by hand.
  //
  // ⚠ Confirm `name` against the actual Cloudflare account before first deploy;
  // it decides the workers.dev subdomain. Nothing here has been applied yet.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bci-report",
  "compatibility_date": "2026-09-20",
  // Off for the same reason `observability` below is off: wrangler otherwise
  // posts command telemetry (OS build, Node version, which command ran) to
  // Cloudflare on every invocation.
  //
  // ⚠ This key alone is not enough. Measured on 4.135.0: it suppresses 3 of the
  // 7 events; the other 4 fire before the config file is read (their payload
  // reports configFileType "none"). Only WRANGLER_SEND_METRICS=false, which is
  // set from process start, suppresses all 7 — which is why the `deploy` and
  // `cf` scripts in package.json exist. Use those rather than bare `wrangler`.
  // The alternative, `wrangler telemetry disable`, is deliberately not used: it
  // writes to ~/.config/.wrangler and would change every other project on this
  // machine.
  "send_metrics": false,
  // The real domain. `custom_domain: true` makes wrangler create and own the
  // DNS record for it, which needs more than the zone:read the OAuth login
  // grants — if the deploy is refused, add the record in the dashboard instead
  // and leave this here so the intent stays recorded.
  "routes": [
    { "pattern": "bci.report", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    // Serve /data-use/ for /data-use, and return the real 404 page for a missing
    // path. The handoff requires withdrawn CSV routes to 404 rather than answer
    // 200 with the homepage.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    // Off by default: request logs are a privacy surface the data-use page has
    // to describe accurately. Turn on deliberately, and update that page if so.
    "enabled": false
  }
}
