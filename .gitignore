# BCI Report — private research repository.
#
# The rule behind this file: the repository holds the code, the reviewed
# publication snapshot, and the written evidence trail. It never holds raw EEG,
# participant-level results, model weights, or private infrastructure. Anything
# that would be unsafe if this repository's visibility were ever flipped to
# public does not belong here in the first place.

# --- Raw research data, model weights, prepared arrays (7+ GB, and the exact
# --- material the data-use policy says is never redistributed).
experiments/

# --- Participant-level backups of earlier exports. The handoff is explicit:
# --- never publish this directory's private files.
research/**/*.private.json
research/**/*.private/
research/**/*.private

# --- Private network topology: Tailscale ACLs, tailnet addresses, SSH setup
# --- for the two machines. Not credentials, but not project material either.
ops/

# --- Internal planning, run records and interpretation notes. Written for the
# --- operator and a reviewer, not for readers: the handoff says so on its own
# --- first page. Kept local. What belongs to the public record is the site,
# --- the publication boundary in pipeline/, and the rights review in research/.
docs/

# --- Outreach drafts, publishing packs and their review records. They carry
# --- unpublished drafts and local paths. Articles go out on their platforms;
# --- this folder stays local, never on GitHub or the HF dataset.
outreach/

# --- Where this machine keeps the run outputs. One operator's mount points.
pipeline/publication/local_paths.json

# --- Scratch, build output and local state.
tmp/
output/
site/dist/
site/node_modules/
# Without the slash as well: in a git worktree site/node_modules is a symlink to
# the main checkout's, and a pattern ending in "/" matches directories only.
site/node_modules
site/.astro/
site/.wrangler/
site/.git.superseded-*/
.venv/
__pycache__/
*.pyc
data/news.db
*.log

# --- Editor / OS noise.
.DS_Store
.vscode/

# Local Claude Code permission state (machine-specific).
.claude/settings.local.json

# --- Research handoffs from execution sessions. They hold unapproved results
# --- (including sources under editorial hold) and private storage paths, and
# --- they are not product content. They stay local. What is public from a
# --- batch is its publication_review_* manifest and audit, and the export.
# --- Four of these were committed on 2026-09-21 by mistake and then purged.
research/cross_session_v3_20260920/
research/finetuning_v3_20260920/
research/model_expansion_v3_20260920/
research/topic_workflow_v3_20260920/
research/hf_expansion_v4_20260921/
research/peft_feasibility_20260922/
research/website_handoff_20260922/
research/hf_expansion_v5_20260922/
research/peft_v1_20260922/
research/screenshot_model_review_20260922/
research/hf_expansion_v6_20260926/
research/expansion_v7_20261001/
research/expansion_v8_20261001/
research/large_source_expansion_20261002/
research/decision_route1_20261004/
research/fm_eval_v9_20261004/
research/site_text_polish_20261006/
research/decision_route2_20261006/

# IndexNow submission state and the last deploy log (site/scripts/deploy.mjs). Local only.
site/.indexnow-state.json
site/.deploy.log
research/decision_route3_20261007/
