ue,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Yang, Liuyin"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Associatie KU Leuven"},"datasetContactEmail":{"typeName":"datasetContactEmail","multiple":false,"typeClass":"primitive","value":"liuyin.yang@kuleuven.be"}},{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"Van Hulle, Marc"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"Associatie KU Leuven"},"datasetContactEmail":{"typeName":"datasetContactEmail","multiple":false,"typeClass":"primitive","value":"marc.vanhulle@kuleuven.be"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"This dataset provides a large-scale collection of electroencephalography (EEG) recordings from 34 healthy participants, designed to advance research in multi-paradigm brain–computer interfaces (BCIs). Each subject completed a single recording session comprising steady-state visual evoked potentials (SSVEP), motor imagery (MI), and imagined speech (IS) tasks, alongside structured artifact recordings (eye blinks, jaw clenching, breath holding, and right-hand clenching). Sessions include both training blocks and randomly interleaved testing blocks, enabling realistic evaluation of asynchronous decoding. In addition, the dataset offers resting-state recordings, behavioral questionnaires, and comprehensive trial annotations. With its standardized preprocessing pipelines, the dataset supports benchmarking of machine learning methods, facilitates cross-paradigm transfer learning, and promotes reproducible research toward robust, multi-purpose BCI systems."},"dsDescriptionDate":{"ty